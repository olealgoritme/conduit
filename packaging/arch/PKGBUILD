# Maintainer: Ole Algoritme <olealgoritme@gmail.com>
#
# Split package built from source: `conduit` (host) and `conduit-guest-dkms`
# (guest module, DKMS). Release .pkg.tar.zst files come from nfpm in
# .github/workflows/release.yml; both run packaging/build.sh, so the layout
# matches. AUR publishing notes: docs/PACKAGING.md.
pkgbase=conduit
pkgname=(conduit conduit-guest-dkms)
pkgver=0.1.0
pkgrel=1
pkgdesc="Share your NVIDIA GPU with a virtual machine and see its desktop on yours"
arch=(x86_64)
url="https://github.com/olealgoritme/conduit"
license=('Apache-2.0' 'BSD-3-Clause' 'GPL-2.0-only' 'MIT')
makedepends=(git rustup base-devel python ninja meson flex bison file
             wayland wayland-protocols libxcb mesa openssl
             glib2 pixman libslirp libseccomp libcap-ng zstd libaio dtc
             libpulse pipewire
             vulkan-headers vulkan-icd-loader libdrm python-mako python-yaml)
options=(!lto !debug)
# The two submodules conduit-venus is built from (packaging/build.sh venus);
# prepare() points the checkout's submodules at these clones.
source=("$pkgbase::git+$url.git#tag=v$pkgver"
        "virglrenderer::git+https://gitlab.freedesktop.org/virgl/virglrenderer.git"
        "venus-protocol::git+https://github.com/winboat-org/venus-protocol.git")
sha256sums=('SKIP' 'SKIP' 'SKIP')

prepare() {
  cd "$pkgbase"
  local sub
  for sub in virglrenderer venus-protocol; do
    git submodule init "host/venus/third_party/$sub"
    git config "submodule.host/venus/third_party/$sub.url" "$srcdir/$sub"
    git -c protocol.file.allow=always submodule update "host/venus/third_party/$sub"
  done
  # rust-toolchain.toml pins the compiler; rustup fetches it here, before
  # build(), so a network-less build() still works.
  cargo --version
}

build() {
  cd "$pkgbase"
  export VERSION=$pkgver RUST_TARGET=host
  packaging/build.sh rust
  packaging/build.sh viewer
  packaging/build.sh stream
  packaging/build.sh venus
  packaging/build.sh qemu
}

package_conduit() {
  depends=(glibc gcc-libs wayland libxcb glib2 pixman libslirp libseccomp
           libcap-ng zstd libaio dtc vulkan-icd-loader)
  optdepends=('libvirt: virt-manager/virsh integration (conduit attach)')
  backup=(etc/apparmor.d/abstractions/conduit)
  install=conduit.install
  cd "$pkgbase"
  # stage also lays out the app icon set under usr/share/icons/hicolor
  # (packaging/common/icons.sh), so pacman owns the icons too.
  VERSION=$pkgver STAGE="$pkgdir" packaging/build.sh stage
}

package_conduit-guest-dkms() {
  pkgdesc="Conduit guest driver (conduit_gpu) for Linux VMs, DKMS source"
  arch=(any)
  license=('GPL-2.0-only')
  depends=(dkms python)
  optdepends=('wl-clipboard: clipboard on wlroots/KDE Wayland sessions'
              'libxfixes: clipboard on X11 sessions and GNOME (XWayland)')
  # conduit-guest: the same files, as nfpm builds them (`conduit attach`).
  provides=(conduit-guest)
  conflicts=(conduit-guest)
  backup=(etc/sysctl.d/60-conduit-userns.conf)
  # Arch's dkms pacman hooks build and remove the module; the install script
  # runs guest/system/conduit-guest-setup (old module name, locale, sysctl).
  install=conduit-guest.install
  cd "$pkgbase"
  VERSION=$pkgver packaging/build.sh guest-src "$pkgdir/usr/src/conduit-guest-$pkgver"
  # The clipboard agent (enable per user: systemctl --user enable
  # conduit-clipboard, or rely on the XDG autostart entry).
  install -Dm0755 guest/agent/conduit-clipboard-agent "$pkgdir/usr/bin/conduit-clipboard-agent"
  install -Dm0644 guest/agent/conduit-clipboard.service "$pkgdir/usr/lib/systemd/user/conduit-clipboard.service"
  install -Dm0644 guest/agent/conduit-clipboard.desktop "$pkgdir/etc/xdg/autostart/conduit-clipboard.desktop"
  install -Dm0644 guest/agent/70-conduit-clipboard.rules "$pkgdir/usr/lib/udev/rules.d/70-conduit-clipboard.rules"
  install -Dm0644 guest/power/50-conduit-powerkey.conf "$pkgdir/usr/lib/systemd/logind.conf.d/50-conduit-powerkey.conf"
  install -Dm0644 guest/system/modules-load.conf "$pkgdir/usr/lib/modules-load.d/conduit-gpu.conf"
  install -Dm0644 guest/system/modprobe.conf "$pkgdir/usr/lib/modprobe.d/conduit-gpu.conf"
  install -Dm0644 guest/system/60-conduit-userns.conf "$pkgdir/etc/sysctl.d/60-conduit-userns.conf"
  install -Dm0755 guest/system/conduit-guest-setup "$pkgdir/usr/lib/conduit-guest/setup"
}
