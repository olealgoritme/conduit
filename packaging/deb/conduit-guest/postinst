#!/bin/sh
# Post-install for `conduit-guest` (DKMS source package; shared by .deb and .rpm).
# Registers the module source with DKMS and builds it for the running kernel.
# A missing kernel header package is reported, not fatal: DKMS builds the
# module automatically once headers (and the kernel) are installed.
set -e
NAME=conduit-guest
VERSION=@VERSION@
done_k=

# Inside a chroot (`conduit create` building a disk) nothing touches the
# running system: udev, logind and the loaded modules there are the host's.
chroot=0
if command -v systemd-detect-virt >/dev/null 2>&1; then
    systemd-detect-virt -q --chroot && chroot=1
elif [ "$(stat -c %d:%i / 2>/dev/null)" != "$(stat -c %d:%i /proc/1/root/. 2>/dev/null)" ]; then
    chroot=1
fi

# Retire the driver's old name (virtio_gpu_nv), set a usable locale and apply
# the user-namespace setting (see the script). Never fails the install.
/usr/lib/conduit-guest/setup || true

# Clipboard: the device node's permissions (70-conduit-clipboard.rules) and the
# per-session agent. Best effort; none of it may fail the install.
if [ "$chroot" = 0 ] && command -v udevadm >/dev/null 2>&1; then
    udevadm control --reload-rules 2>/dev/null || true
    udevadm trigger --subsystem-match=misc --sysname-match=conduit-clipboard 2>/dev/null || true
fi
if command -v systemctl >/dev/null 2>&1; then
    systemctl --global enable conduit-clipboard.service 2>/dev/null || true
    # 50-conduit-powerkey.conf: logind rereads its settings on SIGHUP.
    [ "$chroot" = 1 ] || systemctl kill -s HUP systemd-logind 2>/dev/null || true
fi

command -v dkms >/dev/null 2>&1 || { echo "$NAME: dkms not installed" >&2; exit 0; }

if ! dkms status -m "$NAME" -v "$VERSION" 2>/dev/null | grep -q .; then
    dkms add -m "$NAME" -v "$VERSION" || true
fi

# Build for the running kernel and for every other installed kernel with
# headers: a VM image is often built in a chroot, where `uname -r` is the
# build host's kernel, and the kernel the VM boots is only installed.
built=0
for KVER in $(uname -r) $(ls /lib/modules 2>/dev/null); do
    case " $done_k " in *" $KVER "*) continue ;; esac
    done_k="$done_k $KVER"
    case "$KVER" in
        [0-5].*|6.[0-3].*|6.[0-3]-*)
            echo "$NAME: kernel $KVER is too old; the guest driver needs Linux 6.4 or newer." >&2
            continue ;;
    esac
    if [ -e "/lib/modules/$KVER/build" ]; then
        if dkms install -m "$NAME" -v "$VERSION" -k "$KVER"; then
            built=1
        else
            echo "$NAME: DKMS build for $KVER failed; see /var/lib/dkms/$NAME/$VERSION/build/make.log" >&2
        fi
    elif [ "$KVER" = "$(uname -r)" ] && [ -d "/lib/modules/$KVER/kernel" ]; then
        echo "$NAME: no headers for $KVER (install linux-headers-$KVER / kernel-devel), module will build on next kernel install." >&2
    fi
done
[ "$chroot" = 1 ] && exit 0
if grep -q '^virtio_gpu_nv ' /proc/modules 2>/dev/null; then
    # The old module holds the device until the VM restarts.
    echo "$NAME: reboot the VM to switch to the new guest driver (conduit_gpu)."
elif [ "$built" = 1 ] && ! grep -q '^conduit_gpu ' /proc/modules 2>/dev/null; then
    modprobe conduit_gpu 2>/dev/null || true
    echo "$NAME: reboot the VM to start the desktop on the new guest driver."
else
    echo "$NAME: reboot the VM to load the updated guest driver."
fi
exit 0
