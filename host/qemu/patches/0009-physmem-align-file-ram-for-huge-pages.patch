+    /*
+     * Place small-page file RAM (a shmem memfd, a tmpfs file) like anonymous
+     * RAM and like the memfd behind memory-backend-ram,share=on: on a
+     * QEMU_VMALLOC_ALIGN boundary. Otherwise the mapping lands on any page
+     * boundary, its addresses and file offsets disagree modulo the huge page
+     * size, and neither transparent huge pages nor KVM's huge mappings of the
+     * guest can ever be used for it. Only the address moves; the size is
+     * still rounded to the file's page size.
+     */
+    if (block->page_size < QEMU_VMALLOC_ALIGN && memory >= QEMU_VMALLOC_ALIGN) {
+        block->mr->align = MAX(block->mr->align, QEMU_VMALLOC_ALIGN);
+    }
 
