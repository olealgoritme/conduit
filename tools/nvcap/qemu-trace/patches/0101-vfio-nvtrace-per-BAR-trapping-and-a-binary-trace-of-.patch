+/* ------------------------------------------------------------------ */
+/* Public hooks                                                        */
+
+void nvtrace_mmio_pre_write(NvTraceDev *d, int bar, hwaddr off,
+                            unsigned size, uint64_t val)
+{
+    if (bar != 0 || !d->gsp_on || off != NV_PGSP_QUEUE_HEAD0) {
+        return;
+    }
+    qemu_mutex_lock(&d->g.lock);
+    gsp_drain_all(d);
+    qemu_mutex_unlock(&d->g.lock);
+}
+
+void nvtrace_mmio(NvTraceDev *d, int bar, hwaddr off, unsigned size,
+                  uint64_t val, bool write, int origin)
+{
+    NvtMmio m = {
+        .bar = bar, .size = size, .write = write, .origin = origin,
+        .off = off, .val = val,
+    };
+
+    nvt_emit(d, NVT_REC_MMIO, 0, &m, sizeof(m), NULL, 0);
+    if (bar == 0 && d->gsp_on && origin == NVT_ORIGIN_DIRECT) {
+        qemu_mutex_lock(&d->g.lock);
+        gsp_observe(d, off, size, val, write);
+        qemu_mutex_unlock(&d->g.lock);
+    }
+}
+
+void nvtrace_cfg(NvTraceDev *d, uint32_t off, unsigned len, uint32_t val,
+                 bool write)
+{
+    NvtCfg c = { .off = off, .len = len, .write = write, .val = val };
+
+    nvt_emit(d, NVT_REC_CFG, 0, &c, sizeof(c), NULL, 0);
+}
+
+void nvtrace_bar(NvTraceDev *d, int bar, uint64_t old_addr,
+                 uint64_t new_addr, uint64_t size)
+{
+    NvtBar b = { .bar = bar, .old_addr = old_addr, .new_addr = new_addr,
+                 .size = size };
+
+    nvt_emit(d, NVT_REC_BAR, 0, &b, sizeof(b), NULL, 0);
+}
+
+void nvtrace_irq(NvTraceDev *d, int kind, int vector, uint64_t addr,
+                 uint32_t data, bool masked)
+{
+    NvtIrq i = { .kind = kind, .masked = masked, .vector = vector,
+                 .data = data, .addr = addr };
+
+    nvt_emit(d, NVT_REC_IRQ, 0, &i, sizeof(i), NULL, 0);
+    if (d->gsp_on) {
+        qemu_mutex_lock(&d->g.lock);
+        gsp_drain_all(d);
+        qemu_mutex_unlock(&d->g.lock);
+    }
+}
+
+void nvtrace_vec(NvTraceDev *d, int event, int vector, uint64_t addr,
+                 uint32_t data)
+{
+    NvtIrq i = { .kind = event, .vector = vector, .data = data,
+                 .addr = addr };
+
+    nvt_emit(d, NVT_REC_VEC, 0, &i, sizeof(i), NULL, 0);
+}
+
+void nvtrace_reset(NvTraceDev *d, int kind)
+{
+    uint32_t body[2] = { kind, 0 };
+
+    nvt_emit(d, NVT_REC_RESET, 0, body, sizeof(body), NULL, 0);
+    if (d->gsp_on && (kind == NVT_RESET_BEGIN || kind == NVT_RESET_FLR_CFG)) {
+        qemu_mutex_lock(&d->g.lock);
+        gsp_drain_all(d);
+        gsp_snap_logs(d, true);
+        d->g.known = false;
+        d->g.ncand = 0;
+        memset(d->g.q, 0, sizeof(d->g.q));
+        g_byte_array_set_size(d->g.fsp_msg[0], 0);
+        g_byte_array_set_size(d->g.fsp_msg[1], 0);
+        qemu_mutex_unlock(&d->g.lock);
+    }
+}
+
+static void nvt_dev_record(NvTraceDev *d)
+{
+    NvtDevRec r = {
+        .vendor = d->vendor, .device = d->device,
+        .class_code = d->class_code, .trap_mask = d->trap_mask,
+        .flags = d->gsp_on,
+    };
+
+    nvt_emit(d, NVT_REC_DEV, 0, &r, sizeof(r), d->name, strlen(d->name));
+}
+
+void nvtrace_set_ids(NvTraceDev *d, uint16_t vendor, uint16_t device,
+                     uint32_t class_code)
+{
+    d->vendor = vendor;
+    d->device = device;
+    d->class_code = class_code;
+    if (d->gsp_wanted && vendor == 0x10de &&
+        ((class_code >> 16) == 0x03) && !d->gsp_on) {
+        d->gsp_on = true;
+        d->poll_started = true;
+        qemu_thread_create(&d->poll_thread, "nvtrace-gsp", nvt_poll_thread,
+                           d, QEMU_THREAD_JOINABLE);
+    }
+    nvt_dev_record(d);
+}
+
+static void nvt_shutdown(Notifier *n, void *data)
+{
+    NvtWriter *w = nvt_w;
+    NvTraceDev *d;
+
+    if (!w) {
+        return;
+    }
+    QLIST_FOREACH(d, &w->devs, next) {
+        qatomic_set(&d->stop, true);
+        if (d->poll_started) {
+            qemu_thread_join(&d->poll_thread);
+            d->poll_started = false;
+        }
+        if (d->gsp_on) {
+            qemu_mutex_lock(&d->g.lock);
+            gsp_drain_all(d);
+            gsp_snap_logs(d, true);
+            qemu_mutex_unlock(&d->g.lock);
+        }
+    }
+    nvtrace_note(NULL, "nvtrace: shutdown, %" PRIu64 " records",
+                 w->seq);
+    qemu_mutex_lock(&w->lock);
+    w->stop = true;
+    qemu_cond_signal(&w->data_cond);
+    qemu_mutex_unlock(&w->lock);
+    qemu_thread_join(&w->thread);
+    qemu_mutex_lock(&w->lock);
+    w->closed = true;
+    qemu_mutex_unlock(&w->lock);
+    nvt_close_output(w);
+}
+
+static NvtWriter *nvt_writer_get(const char *file)
+{
+    NvtWriter *w;
+
+    if (nvt_w) {
+        return nvt_w;
+    }
+    w = g_new0(NvtWriter, 1);
+    w->path = g_strdup(file);
+    w->size = MAX(nvt_env_u64("NVTRACE_BUF_MB", 64), 4) * 1024 * 1024;
+    w->ring = g_malloc(w->size);
+    w->rotate_bytes = nvt_env_u64("NVTRACE_ROTATE_MB", 0) * 1024 * 1024;
+    w->lossy = nvt_env_u64("NVTRACE_LOSSY", 0) != 0;
+    w->block_ns = nvt_env_u64("NVTRACE_BLOCK_MS", 5000) * 1000000ull;
+    w->min_free_bytes = nvt_env_u64("NVTRACE_MIN_FREE_GB", 20) << 30;
+    w->fd = -1;
+    qemu_mutex_init(&w->lock);
+    qemu_cond_init(&w->data_cond);
+    qemu_cond_init(&w->space_cond);
+    QLIST_INIT(&w->devs);
+    if (nvt_open_output(w) < 0) {
+        error_report("nvtrace: tracing disabled");
+        g_free(w->ring);
+        g_free(w->path);
+        g_free(w);
+        return NULL;
+    }
+    nvt_w = w;
+    qemu_thread_create(&w->thread, "nvtrace-wr", nvt_writer_thread, w,
+                       QEMU_THREAD_JOINABLE);
+    w->exit_notifier.notify = nvt_shutdown;
+    qemu_add_exit_notifier(&w->exit_notifier);
+    nvtrace_note(NULL, "nvtrace: file=%s buf=%" PRIu64 "MB rotate=%" PRIu64
+                 "MB lossy=%d block_ms=%" PRIu64 " min_free=%" PRIu64 "GB",
+                 w->path, w->size >> 20, w->rotate_bytes >> 20, w->lossy,
+                 w->block_ns / 1000000, w->min_free_bytes >> 30);
+    return w;
+}
+
+NvTraceDev *nvtrace_attach(const char *name, const char *file,
+                           AddressSpace *dma_as, bool gsp,
+                           uint32_t trap_mask)
+{
+    NvtWriter *w;
+    NvTraceDev *d;
+
+    if (!nvt_global_init) {
+        qemu_mutex_init(&nvt_global_lock);
+        nvt_global_init = true;
+    }
+    if (!file || !*file) {
+        file = getenv("NVTRACE_MMIO");
+    }
+    qemu_mutex_lock(&nvt_global_lock);
+    if (!nvt_w && (!file || !*file)) {
+        qemu_mutex_unlock(&nvt_global_lock);
+        error_report("nvtrace: no trace file (x-nvtrace-file or "
+                     "NVTRACE_MMIO)");
+        return NULL;
+    }
+    if (nvt_w && file && *file && strcmp(file, nvt_w->path)) {
+        warn_report("nvtrace: one trace file per process; %s goes to %s",
+                    name, nvt_w->path);
+    }
+    w = nvt_writer_get(file);
+    qemu_mutex_unlock(&nvt_global_lock);
+    if (!w) {
+        return NULL;
+    }
+
+    d = g_new0(NvTraceDev, 1);
+    d->index = w->ndevs++;
+    d->name = g_strdup(name);
+    d->as = dma_as ? dma_as : &address_space_memory;
+    d->gsp_wanted = gsp;
+    d->trap_mask = trap_mask;
+    d->poll_us = MAX(nvt_env_u64("NVTRACE_GSP_POLL_US", 100), 10);
+    d->log_ms = nvt_env_u64("NVTRACE_GSP_LOG_MS", 1000);
+    qemu_mutex_init(&d->g.lock);
+    d->g.fsp_msg[0] = g_byte_array_new();
+    d->g.fsp_msg[1] = g_byte_array_new();
+    d->g.snapped = g_hash_table_new_full(g_int64_hash, g_int64_equal,
+                                         g_free, NULL);
+    d->g.pair_budget = nvt_env_u64("NVTRACE_PAIR_BUDGET_MB", 256) << 20;
+    QLIST_INSERT_HEAD(&w->devs, d, next);
+    nvtrace_note(d, "nvtrace: attached %s as dev %d trap_mask=0x%x gsp=%d",
+                 name, d->index, trap_mask, gsp);
+    return d;
+}
+
+void nvtrace_detach(NvTraceDev *d)
+{
+    if (!d) {
+        return;
+    }
+    nvtrace_note(d, "nvtrace: detach %s", d->name);
+    qatomic_set(&d->stop, true);
+    if (d->poll_started) {
+        qemu_thread_join(&d->poll_thread);
+        d->poll_started = false;
+    }
+    d->gsp_on = false;
+    /* The record stays on the writer's list; the writer outlives devices. */
+}
diff --git a/hw/vfio/nvtrace.h b/hw/vfio/nvtrace.h
new file mode 100644
index 000000000..1e1cfb98d
--- /dev/null
+++ b/hw/vfio/nvtrace.h
@@ -0,0 +1,71 @@
+/*
+ * nvtrace: binary trace of every trapped access to an assigned PCI device,
+ * plus NVIDIA GSP/FSP message capture from guest memory.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef HW_VFIO_NVTRACE_H
+#define HW_VFIO_NVTRACE_H
+
+#include "exec/hwaddr.h"
+
+typedef struct NvTraceDev NvTraceDev;
+typedef struct AddressSpace AddressSpace;
+
+/* Where an MMIO record came from (the "origin" byte of a MMIO record). */
+enum {
+    NVT_ORIGIN_DIRECT        = 0, /* guest access forwarded to the device */
+    NVT_ORIGIN_MIRROR        = 1, /* guest access to a config-mirror quirk */
+    NVT_ORIGIN_QUIRK_INTERN  = 2, /* access QEMU made on behalf of a quirk */
+    NVT_ORIGIN_WINDOW        = 3, /* guest access to a window quirk */
+    NVT_ORIGIN_IOEVENTFD     = 4, /* ioeventfd userspace fallback */
+    NVT_ORIGIN_MSIX_TABLE    = 5, /* emulated MSI-X table (not forwarded) */
+    NVT_ORIGIN_MSIX_PBA      = 6, /* emulated MSI-X PBA (not forwarded) */
+    NVT_ORIGIN_ROM           = 7, /* expansion ROM, served from QEMU's copy */
+};
+
+/* Set around quirk-internal accesses so region hooks tag them. */
+extern __thread int nvtrace_origin;
+
+NvTraceDev *nvtrace_attach(const char *name, const char *file,
+                           AddressSpace *dma_as, bool gsp,
+                           uint32_t trap_mask);
+void nvtrace_detach(NvTraceDev *d);
+void nvtrace_set_ids(NvTraceDev *d, uint16_t vendor, uint16_t device,
+                     uint32_t class_code);
+
+void nvtrace_mmio_pre_write(NvTraceDev *d, int bar, hwaddr off,
+                            unsigned size, uint64_t val);
+void nvtrace_mmio(NvTraceDev *d, int bar, hwaddr off, unsigned size,
+                  uint64_t val, bool write, int origin);
+void nvtrace_cfg(NvTraceDev *d, uint32_t off, unsigned len, uint32_t val,
+                 bool write);
+void nvtrace_bar(NvTraceDev *d, int bar, uint64_t old_addr,
+                 uint64_t new_addr, uint64_t size);
+
+enum { NVT_IRQ_INTX = 0, NVT_IRQ_MSI = 1, NVT_IRQ_MSIX = 2 };
+void nvtrace_irq(NvTraceDev *d, int kind, int vector, uint64_t addr,
+                 uint32_t data, bool masked);
+
+enum {
+    NVT_VEC_USE = 0, NVT_VEC_RELEASE = 1,
+    NVT_VEC_MSI_ENABLE = 2, NVT_VEC_MSI_DISABLE = 3,
+    NVT_VEC_MSIX_ENABLE = 4, NVT_VEC_MSIX_DISABLE = 5,
+    NVT_VEC_INTX_ENABLE = 6,
+};
+void nvtrace_vec(NvTraceDev *d, int event, int vector, uint64_t addr,
+                 uint32_t data);
+
+enum {
+    NVT_RESET_BEGIN = 0,     /* QEMU device reset starts */
+    NVT_RESET_END = 1,       /* QEMU device reset done */
+    NVT_RESET_FLR_CFG = 2,   /* guest set PCIe DEVCTL.BCR_FLR */
+    NVT_RESET_SBR = 3,       /* reserved: secondary bus reset */
+};
+void nvtrace_reset(NvTraceDev *d, int kind);
+void G_GNUC_PRINTF(2, 3) nvtrace_note(NvTraceDev *d, const char *fmt, ...);
+/* A blob that is not guest memory (e.g. the ROM image): DMA_SNAP, flags 2 */
+void nvtrace_blob(NvTraceDev *d, const char *label, const void *data,
+                  size_t len);
+
+#endif
