diff --git a/hw/vfio/nvtrace.c b/hw/vfio/nvtrace.c
new file mode 100644
index 000000000..afb441eb2
--- /dev/null
+++ b/hw/vfio/nvtrace.c
@@ -0,0 +1,1874 @@
+/*
+ * nvtrace: binary trace of every trapped access to an assigned PCI device,
+ * plus NVIDIA GSP/FSP message capture from guest memory.
+ *
+ * Records go into one in-memory ring (one per QEMU process, shared by all
+ * traced devices). A writer thread drains the ring to a file, optionally
+ * through a zstd/lz4/gzip child process, optionally rotating files.
+ * Producers (vCPU threads, the main loop, the GSP poller) only take the ring
+ * mutex, which is a leaf lock: the writer never takes the BQL, so a producer
+ * that holds the BQL and waits for ring space cannot deadlock.
+ *
+ * For NVIDIA devices (vendor 0x10de) the BAR0 write stream is also watched:
+ *  - FSP EMEM writes/reads (NV_PFSP_EMEMC/EMEMD(0)) are mirrored, and every
+ *    packet sent to / received from FSP is logged (FSP_PKT). The COT boot
+ *    command (NVDM type 0x14) carries gspBootArgsSysmemOffset, the guest
+ *    physical address of GSP_FMC_BOOT_PARAMS.
+ *  - GSP_FMC_BOOT_PARAMS -> WPR meta + libos init args -> "RMARGS" region
+ *    (GSP_ARGUMENTS_CACHED) -> messageQueueInitArguments: the page table of
+ *    the shared command/status queue memory. All of these are snapshotted.
+ *  - Every write to NV_PGSP_QUEUE_HEAD(0) (the GSP command doorbell) drains
+ *    new command-queue elements; the status queue is drained on interrupts,
+ *    on doorbells and by a poller thread. Each RPC becomes a GSP_MSG record.
+ *  - Fallbacks: the GSP falcon mailbox pair (direct FMC boot), a generic
+ *    LO/HI register-pair heuristic that snapshots the guest page a written
+ *    address points to, and a one-off guest RAM scan for the queue page
+ *    table when a doorbell rings while the queues are still unknown.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/thread.h"
+#include "qemu/rcu.h"
+#include "qemu/notify.h"
+#include "qemu/error-report.h"
+#include "qemu/cutils.h"
+#include "qemu/int128.h"
+#include "system/system.h"
+#include "system/memory.h"
+#include "system/address-spaces.h"
+#include "hw/core/cpu.h"
+#include "nvtrace.h"
+
+#include <sys/wait.h>
+#include <sys/statvfs.h>
+#include <sched.h>
+
+__thread int nvtrace_origin;
+
+/* ------------------------------------------------------------------ */
+/* Trace format                                                        */
+
+#define NVT_MAGIC        "NVTRACE1"
+#define NVT_VERSION      1
+
+enum {
+    NVT_REC_MMIO       = 1,
+    NVT_REC_CFG        = 2,
+    NVT_REC_IRQ        = 3,
+    NVT_REC_VEC        = 4,
+    NVT_REC_RESET      = 5,
+    NVT_REC_BAR        = 6,
+    NVT_REC_GSP_MSG    = 7,
+    NVT_REC_DMA_SNAP   = 8,
+    NVT_REC_NOTE       = 9,
+    NVT_REC_GSP_QSTATE = 10,
+    NVT_REC_LOST       = 11,
+    NVT_REC_FSP_PKT    = 12,
+    NVT_REC_GSP_QINFO  = 13,
+    NVT_REC_DEV        = 14,
+};
+
+typedef struct QEMU_PACKED {
+    char     magic[8];
+    uint32_t version;
+    uint32_t hdr_size;
+    uint64_t realtime_ns;
+    uint64_t monotonic_ns;
+    uint32_t file_index;
+    uint32_t pid;
+    char     qemu[24];
+} NvtFileHdr;                                   /* 64 bytes */
+
+typedef struct QEMU_PACKED {
+    uint16_t type;
+    uint8_t  dev;
+    uint8_t  flags;
+    uint32_t len;          /* whole record incl. this header, 8-aligned */
+    uint64_t seq;
+    uint64_t ts;           /* CLOCK_MONOTONIC ns */
+    int16_t  vcpu;         /* -1: not a vCPU thread */
+    uint16_t rsvd;
+    uint32_t tid;
+} NvtRecHdr;                                    /* 32 bytes */
+
+typedef struct QEMU_PACKED {
+    uint8_t  bar, size, write, origin;
+    uint32_t rsvd;
+    uint64_t off;
+    uint64_t val;
+} NvtMmio;
+
+typedef struct QEMU_PACKED {
+    uint32_t off;
+    uint8_t  len, write;
+    uint16_t rsvd;
+    uint32_t val;
+    uint32_t rsvd2;
+} NvtCfg;
+
+typedef struct QEMU_PACKED {
+    uint8_t  kind, masked;
+    uint16_t vector;
+    uint32_t data;
+    uint64_t addr;
+} NvtIrq;
+
+typedef struct QEMU_PACKED {
+    uint8_t  bar, rsvd[7];
+    uint64_t old_addr, new_addr, size;
+} NvtBar;
+
+typedef struct QEMU_PACKED {
+    uint8_t  queue;        /* 0 = command (CPU->GSP), 1 = status (GSP->CPU) */
+    uint8_t  flags;
+    uint16_t nelem;
+    uint32_t slot;
+    uint32_t wp, rp;
+    uint32_t len;
+    uint32_t rpc_off;      /* offset of the RPC header inside the data */
+    uint64_t gpa;          /* guest physical address of the first element */
+} NvtGspMsg;
+
+#define NVT_GSP_F_TRUNC   0x01
+#define NVT_GSP_F_NOSIG   0x02
+#define NVT_GSP_F_SEQGAP  0x04
+
+typedef struct QEMU_PACKED {
+    uint64_t gpa;
+    uint32_t len;
+    uint32_t flags;
+    char     label[24];
+} NvtSnap;
+
+typedef struct QEMU_PACKED {
+    uint32_t cmd_wp, cmd_rp, stat_wp, stat_rp;
+} NvtQState;
+
+typedef struct QEMU_PACKED {
+    uint64_t records, bytes;
+} NvtLost;
+
+typedef struct QEMU_PACKED {
+    uint8_t  dir, rsvd[3];
+    uint32_t len;
+} NvtFsp;
+
+typedef struct QEMU_PACKED {
+    uint64_t shared_pa;
+    uint32_t npte;
+    uint32_t elem_hdr;
+    uint64_t cmd_off, stat_off;
+    uint32_t cmd_size, stat_size;
+    uint32_t source;       /* 1 = FSP COT, 2 = falcon mailbox, 3 = RAM scan */
+    uint32_t rsvd;
+} NvtQInfo;
+
+typedef struct QEMU_PACKED {
+    uint16_t vendor, device;
+    uint32_t class_code;
+    uint32_t trap_mask;
+    uint32_t flags;
+    uint64_t rsvd;
+} NvtDevRec;
+
+/* ------------------------------------------------------------------ */
+/* Ring + writer                                                       */
+
+typedef struct NvtWriter {
+    QemuMutex lock;
+    QemuCond data_cond, space_cond;
+    uint8_t *ring;
+    uint64_t size, head, tail;          /* head/tail are byte counters */
+    uint64_t seq;
+    bool stop, closed, failed;
+    QemuThread thread;
+
+    char *path;
+    int fd;
+    pid_t child;
+    int file_index;
+    uint64_t file_bytes, rotate_bytes, total_bytes;
+
+    uint64_t lost_records, lost_bytes;  /* not yet reported */
+    uint64_t min_free_bytes;
+    uint64_t last_df_ns;
+    bool lossy;
+    int64_t block_ns;
+
+    Notifier exit_notifier;
+    QLIST_HEAD(, NvTraceDev) devs;
+    int ndevs;
+} NvtWriter;
+
+static NvtWriter *nvt_w;
+static QemuMutex nvt_global_lock;
+static bool nvt_global_init;
+
+static __thread uint32_t nvt_tid_cache;
+
+static uint32_t nvt_tid(void)
+{
+    if (!nvt_tid_cache) {
+        nvt_tid_cache = qemu_get_thread_id();
+    }
+    return nvt_tid_cache;
+}
+
+static uint64_t nvt_now(void)
+{
+    struct timespec ts;
+
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return ts.tv_sec * 1000000000ULL + ts.tv_nsec;
+}
+
+static uint64_t nvt_env_u64(const char *name, uint64_t def)
+{
+    const char *s = getenv(name);
+    uint64_t v;
+
+    if (!s || !*s || qemu_strtou64(s, NULL, 0, &v) < 0) {
+        return def;
+    }
+    return v;
+}
+
+static void nvt_ring_put(NvtWriter *w, const void *src, size_t n)
+{
+    uint64_t pos = w->head % w->size;
+    size_t first = MIN(n, w->size - pos);
+
+    if (src) {
+        memcpy(w->ring + pos, src, first);
+        memcpy(w->ring, (const uint8_t *)src + first, n - first);
+    } else {
+        memset(w->ring + pos, 0, first);
+        memset(w->ring, 0, n - first);
+    }
+    w->head += n;
+}
+
+static void nvt_ring_get(NvtWriter *w, uint64_t at, void *dst, size_t n)
+{
+    uint64_t pos = at % w->size;
+    size_t first = MIN(n, w->size - pos);
+
+    memcpy(dst, w->ring + pos, first);
+    memcpy((uint8_t *)dst + first, w->ring, n - first);
+}
+
+/* Called with w->lock held. */
+static bool nvt_wait_space(NvtWriter *w, uint64_t len)
+{
+    uint64_t deadline = 0;
+
+    while (w->size - (w->head - w->tail) < len) {
+        if (w->lossy || w->failed || w->closed) {
+            return false;
+        }
+        qemu_cond_signal(&w->data_cond);
+        if (!deadline) {
+            deadline = nvt_now() + w->block_ns;
+        } else if (nvt_now() >= deadline) {
+            return false;
+        }
+        qemu_cond_timedwait(&w->space_cond, &w->lock, 10);
+    }
+    return true;
+}
+
+/* Called with w->lock held and space for the header + body reserved. */
+static void nvt_put_record(NvtWriter *w, uint8_t dev, uint16_t type,
+                           uint8_t flags, const void *body, size_t blen,
+                           const void *data, size_t dlen, uint64_t len)
+{
+    NvtRecHdr h = {
+        .type = type, .dev = dev, .flags = flags, .len = len,
+        .vcpu = current_cpu ? current_cpu->cpu_index : -1,
+        .tid = nvt_tid(),
+    };
+
+    h.seq = w->seq++;
+    h.ts = nvt_now();
+    nvt_ring_put(w, &h, sizeof(h));
+    if (blen) {
+        nvt_ring_put(w, body, blen);
+    }
+    if (dlen) {
+        nvt_ring_put(w, data, dlen);
+    }
+    if (len > sizeof(h) + blen + dlen) {
+        nvt_ring_put(w, NULL, len - sizeof(h) - blen - dlen);
+    }
+}
+
+static uint8_t nvt_dev_index(NvTraceDev *d);
+
+static void nvt_emit(NvTraceDev *d, uint16_t type, uint8_t flags,
+                     const void *body, size_t blen,
+                     const void *data, size_t dlen)
+{
+    NvtWriter *w = nvt_w;
+    uint64_t len;
+    uint8_t dev = d ? nvt_dev_index(d) : 0xff;
+
+    if (!w) {
+        return;
+    }
+    if (sizeof(NvtRecHdr) + blen + dlen > w->size / 4) {
+        dlen = w->size / 4 - sizeof(NvtRecHdr) - blen;
+        flags |= 0x80;                      /* record data truncated */
+    }
+    len = ROUND_UP(sizeof(NvtRecHdr) + blen + dlen, 8);
+
+    qemu_mutex_lock(&w->lock);
+    if (w->closed || w->failed) {
+        qemu_mutex_unlock(&w->lock);
+        return;
+    }
+    if (w->lost_records) {
+        NvtLost l = { w->lost_records, w->lost_bytes };
+        uint64_t llen = sizeof(NvtRecHdr) + sizeof(l);
+
+        if (w->size - (w->head - w->tail) >= llen + len) {
+            nvt_put_record(w, 0xff, NVT_REC_LOST, 0, &l, sizeof(l),
+                           NULL, 0, llen);
+            w->lost_records = w->lost_bytes = 0;
+        }
+    }
+    if (!nvt_wait_space(w, len)) {
+        w->lost_records++;
+        w->lost_bytes += len;
+        qemu_mutex_unlock(&w->lock);
+        return;
+    }
+    nvt_put_record(w, dev, type, flags, body, blen, data, dlen, len);
+    if (w->head - w->tail >= w->size / 8) {
+        qemu_cond_signal(&w->data_cond);
+    }
+    qemu_mutex_unlock(&w->lock);
+}
+
+static const char *nvt_ext(const char *path)
+{
+    if (g_str_has_suffix(path, ".zst")) {
+        return ".zst";
+    } else if (g_str_has_suffix(path, ".lz4")) {
+        return ".lz4";
+    } else if (g_str_has_suffix(path, ".gz")) {
+        return ".gz";
+    }
+    return "";
+}
+
+/* Restrict a compressor child to the CPUs QEMU is NOT pinned to, if any. */
+static void nvt_child_affinity(void)
+{
+    cpu_set_t mine, all;
+    long n = sysconf(_SC_NPROCESSORS_ONLN);
+    int i, cnt = 0;
+
+    if (sched_getaffinity(0, sizeof(mine), &mine) != 0) {
+        return;
+    }
+    CPU_ZERO(&all);
+    for (i = 0; i < n && i < CPU_SETSIZE; i++) {
+        if (!CPU_ISSET(i, &mine)) {
+            CPU_SET(i, &all);
+            cnt++;
+        }
+    }
+    if (cnt) {
+        sched_setaffinity(0, sizeof(all), &all);
+    }
+}
+
+static int nvt_open_output(NvtWriter *w)
+{
+    g_autofree char *name = NULL;
+    const char *ext = nvt_ext(w->path);
+    const char *prog = NULL;
+    g_autofree char *progpath = NULL;
+    NvtFileHdr fh = { .version = NVT_VERSION, .hdr_size = sizeof(fh) };
+    int ofd, pfd[2];
+    struct timespec rt;
+
+    if (w->rotate_bytes) {
+        size_t stem = strlen(w->path) - strlen(ext);
+        name = g_strdup_printf("%.*s.%03d%s", (int)stem, w->path,
+                               w->file_index, ext);
+    } else {
+        name = g_strdup(w->path);
+    }
+
+    ofd = open(name, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+    if (ofd < 0) {
+        error_report("nvtrace: cannot open %s: %s", name, strerror(errno));
+        return -1;
+    }
+
+    if (!strcmp(ext, ".zst")) {
+        prog = "zstd";
+    } else if (!strcmp(ext, ".lz4")) {
+        prog = "lz4";
+    } else if (!strcmp(ext, ".gz")) {
+        prog = "gzip";
+    }
+    w->child = 0;
+    if (prog) {
+        progpath = g_find_program_in_path(prog);
+        if (!progpath) {
+            error_report("nvtrace: %s not found, writing uncompressed", prog);
+        }
+    }
+    if (progpath) {
+        pid_t pid;
+
+        if (pipe2(pfd, O_CLOEXEC) < 0) {
+            close(ofd);
+            return -1;
+        }
+        pid = fork();
+        if (pid < 0) {
+            close(ofd);
+            close(pfd[0]);
+            close(pfd[1]);
+            return -1;
+        }
+        if (pid == 0) {
+            const char *argv_zstd[] = { progpath, "-q", "-3", "-T2", "-c",
+                                        NULL };
+            const char *argv_lz4[] = { progpath, "-q", "-1", "-c", NULL };
+            const char *argv_gz[] = { progpath, "-1", "-c", NULL };
+            const char *const *argv = !strcmp(prog, "zstd") ? argv_zstd :
+                                      !strcmp(prog, "lz4") ? argv_lz4 :
+                                      argv_gz;
+
+            dup2(pfd[0], 0);
+            dup2(ofd, 1);
+            nvt_child_affinity();
+            setpgid(0, 0);  /* do not get the terminal's SIGINT */
+            execv(progpath, (char *const *)argv);
+            _exit(127);
+        }
+        close(pfd[0]);
+        close(ofd);
+        w->fd = pfd[1];
+        w->child = pid;
+    } else {
+        w->fd = ofd;
+    }
+
+    memcpy(fh.magic, NVT_MAGIC, 8);
+    clock_gettime(CLOCK_REALTIME, &rt);
+    fh.realtime_ns = rt.tv_sec * 1000000000ULL + rt.tv_nsec;
+    fh.monotonic_ns = nvt_now();
+    fh.file_index = w->file_index;
+    fh.pid = getpid();
+    pstrcpy(fh.qemu, sizeof(fh.qemu), "qemu-" QEMU_VERSION);
+    if (qemu_write_full(w->fd, &fh, sizeof(fh)) != sizeof(fh)) {
+        return -1;
+    }
+    w->file_bytes = sizeof(fh);
+    return 0;
+}
+
+static void nvt_close_output(NvtWriter *w)
+{
+    if (w->fd >= 0) {
+        close(w->fd);
+        w->fd = -1;
+    }
+    if (w->child > 0) {
+        int st;
+
+        while (waitpid(w->child, &st, 0) < 0 && errno == EINTR) {
+            /* retry */
+        }
+        w->child = 0;
+    }
+}
+
+static void *nvt_writer_thread(void *opaque)
+{
+    NvtWriter *w = opaque;
+    size_t cap = 4 * 1024 * 1024;
+    uint8_t *buf = g_malloc(cap);
+
+    for (;;) {
+        uint64_t tail, avail, done = 0;
+        size_t out = 0;
+        bool stop;
+
+        qemu_mutex_lock(&w->lock);
+        while (w->head == w->tail && !w->stop) {
+            qemu_cond_timedwait(&w->data_cond, &w->lock, 50);
+        }
+        stop = w->stop;
+        tail = w->tail;
+        avail = w->head - w->tail;
+        qemu_mutex_unlock(&w->lock);
+
+        if (!avail && stop) {
+            break;
+        }
+
+        /* Copy whole records; producers never touch [tail, head). */
+        while (done < avail) {
+            uint32_t len;
+
+            nvt_ring_get(w, tail + done + 4, &len, 4);
+            if (len < sizeof(NvtRecHdr) || len > avail - done) {
+                error_report("nvtrace: corrupt ring (len %u)", len);
+                w->failed = true;
+                done = avail;
+                out = 0;
+                break;
+            }
+            if (out + len > cap) {
+                if (out) {
+                    break;
+                }
+                cap = len;
+                buf = g_realloc(buf, cap);
+            }
+            nvt_ring_get(w, tail + done, buf + out, len);
+            out += len;
+            done += len;
+        }
+
+        qemu_mutex_lock(&w->lock);
+        w->tail += done;
+        qemu_cond_broadcast(&w->space_cond);
+        qemu_mutex_unlock(&w->lock);
+
+        if (w->min_free_bytes && nvt_now() - w->last_df_ns > 2000000000ull) {
+            g_autofree char *dir = g_path_get_dirname(w->path);
+            struct statvfs sv;
+
+            w->last_df_ns = nvt_now();
+            if (statvfs(dir, &sv) == 0 &&
+                (uint64_t)sv.f_bavail * sv.f_frsize < w->min_free_bytes) {
+                error_report("nvtrace: less than %" PRIu64 " GB free in %s; "
+                             "tracing stops (the VM keeps running)",
+                             w->min_free_bytes >> 30, dir);
+                w->failed = true;
+            }
+        }
+        if (out && !w->failed && w->fd >= 0) {
+            if (qemu_write_full(w->fd, buf, out) != out) {
+                error_report("nvtrace: write failed: %s; tracing stops",
+                             strerror(errno));
+                w->failed = true;
+            } else {
+                w->file_bytes += out;
+                w->total_bytes += out;
+                if (w->rotate_bytes && w->file_bytes >= w->rotate_bytes) {
+                    nvt_close_output(w);
+                    w->file_index++;
+                    if (nvt_open_output(w) < 0) {
+                        w->failed = true;
+                    }
+                }
+            }
+        }
+    }
+    g_free(buf);
+    return NULL;
+}
+
+/* ------------------------------------------------------------------ */
+/* Guest memory access (RAM only, never MMIO, never takes the BQL)     */
+
+static bool nvt_gread(AddressSpace *as, uint64_t gpa, void *buf, size_t len)
+{
+    uint8_t *p = buf;
+
+    RCU_READ_LOCK_GUARD();
+    while (len) {
+        hwaddr xlat, l = len;
+        MemoryRegion *mr;
+
+        mr = address_space_translate(as, gpa, &xlat, &l, false,
+                                     MEMTXATTRS_UNSPECIFIED);
+        if (!mr || !memory_region_is_ram(mr) ||
+            memory_region_is_ram_device(mr) || l == 0) {
+            return false;
+        }
+        l = MIN(l, len);
+        memcpy(p, (uint8_t *)memory_region_get_ram_ptr(mr) + xlat, l);
+        p += l;
+        gpa += l;
+        len -= l;
+    }
+    return true;
+}
+
+static bool nvt_is_ram(AddressSpace *as, uint64_t gpa)
+{
+    uint8_t b;
+
+    return nvt_gread(as, gpa, &b, 1);
+}
+
+/* ------------------------------------------------------------------ */
+/* NVIDIA GSP / FSP tracking                                           */
+
+/* BAR0 offsets (GB20x; FSP regs from the GH100 headers RM uses on GB20x) */
+#define NV_PGSP_FALCON_MAILBOX0   0x110040
+#define NV_PGSP_FALCON_MAILBOX1   0x110044
+#define NV_PGSP_QUEUE_HEAD0       0x110c00
+#define NV_PFSP_EMEMC0            0x8f2ac0
+#define NV_PFSP_EMEMD0            0x8f2ac4
+#define NV_PFSP_QUEUE_HEAD0       0x8f2c00
+#define NV_PFSP_QUEUE_TAIL0       0x8f2c04
+#define NV_PFSP_MSGQ_HEAD0        0x8f2c80
+#define NV_PFSP_MSGQ_TAIL0        0x8f2c84
+
+#define NVDM_TYPE_COT             0x14
+#define VRPC_SIGNATURE            0x43505256u
+#define WPR_META_MAGIC            0xdc3aae21371a60b3ull
+
+#define NVT_PAGE                  4096
+#define NVT_MAX_ELEMS             16
+#define NVT_EMEM_DWORDS           1024
+#define NVT_MAX_LOGS              16
+#define NVT_PAIR_HIST             16
+
+typedef struct NvtQueue {
+    uint64_t off;              /* offset of the queue in the shared memory */
+    uint32_t size, msg_size, msg_count, entry_off, rxhdr_off;
+    uint32_t last;             /* next slot to log */
+    uint32_t last_seq;
+    bool valid, seq_valid;
+} NvtQueue;
+
+typedef struct NvtLog {
+    char id[9];
+    uint64_t pa, size, last_put;
+    uint64_t last_ns;
+} NvtLog;
+
+typedef struct NvtScanCand {
+    uint64_t pa;
+    uint32_t wp;
+} NvtScanCand;
+
+typedef struct NvtGsp {
+    QemuMutex lock;
+    bool known;
+    uint64_t shared_pa;
+    uint32_t npte;
+    uint64_t *pte;
+    uint32_t elem_hdr;         /* queueElementHdrSize (0 = autodetect) */
+    NvtQueue q[2];
+    NvtQState qs;
+    bool qs_valid;
+
+    /* FSP EMEM mirror (channel 0) */
+    uint32_t emem[NVT_EMEM_DWORDS];
+    uint32_t emem_ptr;
+    bool aincw, aincr;
+    uint32_t fsp_qtail;
+    uint32_t fsp_mhead, fsp_mtail;
+    bool fsp_mvalid;
+    GByteArray *fsp_msg[2];
+
+    /* falcon mailbox / generic LO/HI pair heuristic */
+    struct { uint32_t off, val; } hist[NVT_PAIR_HIST];
+    unsigned hist_pos;
+    GHashTable *snapped;
+    uint64_t pair_budget;
+
+    NvtLog logs[NVT_MAX_LOGS];
+    int nlogs;
+
+    bool need_scan;
+    int scans;
+    uint64_t last_scan_ns;
+    NvtScanCand cand[8];
+    int ncand;
+} NvtGsp;
+
+struct NvTraceDev {
+    QLIST_ENTRY(NvTraceDev) next;
+    int index;
+    char *name;
+    AddressSpace *as;
+    uint16_t vendor, device;
+    uint32_t class_code, trap_mask;
+    bool gsp_wanted, gsp_on;
+    NvtGsp g;
+    QemuThread poll_thread;
+    bool poll_started, stop;
+    uint64_t poll_us, log_ms;
+};
+
+static uint8_t nvt_dev_index(NvTraceDev *d)
+{
+    return d->index;
+}
+
+void nvtrace_note(NvTraceDev *d, const char *fmt, ...)
+{
+    va_list ap;
+    g_autofree char *s = NULL;
+
+    va_start(ap, fmt);
+    s = g_strdup_vprintf(fmt, ap);
+    va_end(ap);
+    nvt_emit(d, NVT_REC_NOTE, 0, NULL, 0, s, strlen(s));
+}
+
+static void nvt_snap(NvTraceDev *d, uint64_t gpa, uint32_t len,
+                     const char *label)
+{
+    g_autofree uint8_t *buf = g_malloc(len);
+    NvtSnap s = { .gpa = gpa, .len = len };
+
+    pstrcpy(s.label, sizeof(s.label), label);
+    if (!nvt_gread(d->as, gpa, buf, len)) {
+        s.flags = 1;                        /* not readable: no data */
+        nvt_emit(d, NVT_REC_DMA_SNAP, 0, &s, sizeof(s), NULL, 0);
+        return;
+    }
+    nvt_emit(d, NVT_REC_DMA_SNAP, 0, &s, sizeof(s), buf, len);
+}
+
+void nvtrace_blob(NvTraceDev *d, const char *label, const void *data,
+                  size_t len)
+{
+    NvtSnap s = { .gpa = ~0ull, .len = len, .flags = 2 };
+
+    pstrcpy(s.label, sizeof(s.label), label);
+    nvt_emit(d, NVT_REC_DMA_SNAP, 0, &s, sizeof(s), data, len);
+}
+
+/* Read from the queue shared memory (virtually contiguous, PTE mapped). */
+static bool gsp_shm_read(NvTraceDev *d, uint64_t off, void *buf, size_t len)
+{
+    NvtGsp *g = &d->g;
+    uint8_t *p = buf;
+
+    while (len) {
+        uint64_t pg = off / NVT_PAGE;
+        size_t n = MIN(len, NVT_PAGE - (off % NVT_PAGE));
+
+        if (pg >= g->npte ||
+            !nvt_gread(d->as, g->pte[pg] + (off % NVT_PAGE), p, n)) {
+            return false;
+        }
+        p += n;
+        off += n;
+        len -= n;
+    }
+    return true;
+}
+
+static uint64_t gsp_shm_gpa(NvTraceDev *d, uint64_t off)
+{
+    NvtGsp *g = &d->g;
+    uint64_t pg = off / NVT_PAGE;
+
+    return pg < g->npte ? g->pte[pg] + (off % NVT_PAGE) : 0;
+}
+
+typedef struct QEMU_PACKED {
+    uint32_t version, size, msg_size, msg_count, write_ptr, flags;
+    uint32_t rxhdr_off, entry_off;
+} MsgqTxHeader;
+
+static bool gsp_txhdr_ok(const MsgqTxHeader *h)
+{
+    return h->version == 0 && h->size >= 2 * NVT_PAGE &&
+           (h->size % NVT_PAGE) == 0 && h->size <= 64 * 1024 * 1024 &&
+           h->msg_size >= 16 && is_power_of_2(h->msg_size) &&
+           h->entry_off < h->size && h->rxhdr_off >= sizeof(MsgqTxHeader) &&
+           h->rxhdr_off < h->entry_off &&
+           h->msg_count == (h->size - h->entry_off) / h->msg_size &&
+           h->msg_count >= 2 && h->write_ptr < h->msg_count;
+}
+
+static bool gsp_q_header(NvTraceDev *d, NvtQueue *q, MsgqTxHeader *h)
+{
+    if (!gsp_shm_read(d, q->off, h, sizeof(*h)) || !gsp_txhdr_ok(h)) {
+        return false;
+    }
+    if (!q->valid) {
+        q->size = h->size;
+        q->msg_size = h->msg_size;
+        q->msg_count = h->msg_count;
+        q->entry_off = h->entry_off;
+        q->rxhdr_off = h->rxhdr_off;
+        q->last = 0;
+        q->seq_valid = false;
+        q->valid = true;
+    } else if (q->size != h->size || q->msg_size != h->msg_size ||
+               q->entry_off != h->entry_off) {
+        return false;
+    }
+    return true;
+}
+
+/* The consumer's read pointer lives in the *other* queue's rx header. */
+static uint32_t gsp_q_readptr(NvTraceDev *d, int qi)
+{
+    NvtQueue *o = &d->g.q[!qi];
+    uint32_t rp = ~0u;
+
+    if (o->valid) {
+        gsp_shm_read(d, o->off + o->rxhdr_off, &rp, 4);
+    }
+    return rp;
+}
+
+static int gsp_find_rpc(const uint8_t *buf, size_t len, uint32_t hint)
+{
+    uint32_t v;
+    size_t p;
+
+    if (hint && hint + 16 <= len) {
+        memcpy(&v, buf + hint + 4, 4);
+        if (v == VRPC_SIGNATURE) {
+            return hint;
+        }
+    }
+    for (p = 0; p + 16 <= len && p <= 128; p += 4) {
+        memcpy(&v, buf + p + 4, 4);
+        if (v == VRPC_SIGNATURE) {
+            return p;
+        }
+    }
+    return -1;
+}
+
+static void gsp_drain(NvTraceDev *d, int qi)
+{
+    NvtGsp *g = &d->g;
+    NvtQueue *q = &g->q[qi];
+    MsgqTxHeader h;
+    uint32_t wp, rp, n = 0;
+    g_autofree uint8_t *buf = NULL;
+
+    if (!g->known) {
+        return;
+    }
+    if (!gsp_q_header(d, q, &h)) {
+        if (q->valid) {
+            nvtrace_note(d, "gsp: queue %d header no longer valid; "
+                         "waiting for re-discovery", qi);
+            q->valid = false;
+            g->known = false;
+        }
+        return;
+    }
+    wp = h.write_ptr;
+    if (q->last == wp) {
+        return;
+    }
+    rp = gsp_q_readptr(d, qi);
+    buf = g_malloc(NVT_MAX_ELEMS * q->msg_size);
+
+    while (q->last != wp && n < q->msg_count) {
+        uint32_t avail = (wp + q->msg_count - q->last) % q->msg_count;
+        uint32_t nelem = 1, i, len;
+        int roff;
+        NvtGspMsg m = { .queue = qi, .slot = q->last, .wp = wp, .rp = rp };
+        uint64_t eoff = q->off + q->entry_off +
+                        (uint64_t)q->last * q->msg_size;
+
+        if (!gsp_shm_read(d, eoff, buf, q->msg_size)) {
+            break;
+        }
+        m.gpa = gsp_shm_gpa(d, eoff);
+        roff = gsp_find_rpc(buf, q->msg_size, g->elem_hdr);
+        if (roff >= 0) {
+            uint32_t rlen;
+
+            memcpy(&rlen, buf + roff + 8, 4);
+            len = roff + rlen;
+            nelem = DIV_ROUND_UP(len, q->msg_size);
+            if (nelem > NVT_MAX_ELEMS || nelem > avail || nelem == 0) {
+                m.flags |= NVT_GSP_F_TRUNC;
+                nelem = MAX(1, MIN(MIN(nelem, NVT_MAX_ELEMS), avail));
+                len = MIN(len, nelem * q->msg_size);
+            }
+            m.rpc_off = roff;
+        } else {
+            len = q->msg_size;
+            m.flags |= NVT_GSP_F_NOSIG;
+            m.rpc_off = ~0u;
+        }
+        for (i = 1; i < nelem; i++) {
+            uint32_t s = (q->last + i) % q->msg_count;
+
+            if (!gsp_shm_read(d, q->off + q->entry_off +
+                              (uint64_t)s * q->msg_size,
+                              buf + i * q->msg_size, q->msg_size)) {
+                break;
+            }
+        }
+        /* GSP_MSG_QUEUE_ELEMENT.seqNum is at +12 when the RPC is at +16 */
+        if (roff == 16) {
+            uint32_t seq;
+
+            memcpy(&seq, buf + 12, 4);
+            if (q->seq_valid && seq != q->last_seq + 1) {
+                m.flags |= NVT_GSP_F_SEQGAP;
+            }
+            q->last_seq = seq;
+            q->seq_valid = true;
+        }
+        m.nelem = nelem;
+        m.len = len;
+        nvt_emit(d, NVT_REC_GSP_MSG, 0, &m, sizeof(m), buf, len);
+        q->last = (q->last + nelem) % q->msg_count;
+        n += nelem;
+    }
+}
+
+static void gsp_qstate(NvTraceDev *d)
+{
+    NvtGsp *g = &d->g;
+    NvtQState s = { ~0u, ~0u, ~0u, ~0u };
+    MsgqTxHeader h;
+
+    if (!g->known) {
+        return;
+    }
+    if (g->q[0].valid && gsp_shm_read(d, g->q[0].off, &h, sizeof(h))) {
+        s.cmd_wp = h.write_ptr;
+    }
+    if (g->q[1].valid && gsp_shm_read(d, g->q[1].off, &h, sizeof(h))) {
+        s.stat_wp = h.write_ptr;
+    }
+    s.cmd_rp = gsp_q_readptr(d, 0);
+    s.stat_rp = gsp_q_readptr(d, 1);
+    if (!g->qs_valid || memcmp(&s, &g->qs, sizeof(s))) {
+        g->qs = s;
+        g->qs_valid = true;
+        nvt_emit(d, NVT_REC_GSP_QSTATE, 0, &s, sizeof(s), NULL, 0);
+    }
+}
+
+static void gsp_drain_all(NvTraceDev *d)
+{
+    gsp_drain(d, 0);
+    gsp_drain(d, 1);
+    gsp_qstate(d);
+}
+
+/* Set up queue tracking from MESSAGE_QUEUE_INIT_ARGUMENTS-like values. */
+static bool gsp_set_queues(NvTraceDev *d, uint64_t shared_pa, uint32_t npte,
+                           uint64_t cmd_off, uint64_t stat_off,
+                           uint32_t elem_hdr, uint32_t source)
+{
+    NvtGsp *g = &d->g;
+    NvtQInfo qi = { 0 };
+    uint32_t i;
+
+    if (!shared_pa || npte == 0 || npte > 16384 || cmd_off >= stat_off ||
+        stat_off >= (uint64_t)npte * NVT_PAGE) {
+        nvtrace_note(d, "gsp: implausible queue args pa=0x%" PRIx64
+                     " npte=%u cmd=0x%" PRIx64 " stat=0x%" PRIx64,
+                     shared_pa, npte, cmd_off, stat_off);
+        return false;
+    }
+    g_free(g->pte);
+    g->pte = g_new0(uint64_t, npte);
+    g->pte[0] = shared_pa;
+    g->npte = npte;
+    /*
+     * The page table maps itself: PTE[i] is at byte i*8 of the shared area,
+     * i.e. in page i*8/4096 <= i, whose PTE has already been read.
+     */
+    for (i = 0; i < npte; i++) {
+        if (!gsp_shm_read(d, (uint64_t)i * 8, &g->pte[i], 8) ||
+            (g->pte[i] & 0xfff) || !g->pte[i]) {
+            nvtrace_note(d, "gsp: bad/unreadable PTE %u (0x%" PRIx64 ")",
+                         i, g->pte[i]);
+            g->npte = 0;
+            g->known = false;
+            return false;
+        }
+    }
+    if (g->pte[0] != shared_pa) {
+        nvtrace_note(d, "gsp: PTE[0]=0x%" PRIx64 " != sharedMemPhysAddr "
+                     "0x%" PRIx64, g->pte[0], shared_pa);
+    }
+    {
+        NvtSnap sn = { .gpa = shared_pa, .len = npte * 8 };
+
+        pstrcpy(sn.label, sizeof(sn.label), "GSP_QUEUE_PTES");
+        nvt_emit(d, NVT_REC_DMA_SNAP, 0, &sn, sizeof(sn), g->pte, npte * 8);
+    }
+    memset(g->q, 0, sizeof(g->q));
+    g->q[0].off = cmd_off;
+    g->q[1].off = stat_off;
+    g->elem_hdr = elem_hdr <= 128 ? elem_hdr : 0;
+    g->known = true;
+    g->qs_valid = false;
+
+    qi.shared_pa = shared_pa;
+    qi.npte = npte;
+    qi.elem_hdr = elem_hdr;
+    qi.cmd_off = cmd_off;
+    qi.stat_off = stat_off;
+    qi.source = source;
+    {
+        MsgqTxHeader h;
+
+        if (gsp_shm_read(d, cmd_off, &h, sizeof(h))) {
+            qi.cmd_size = h.size;
+        }
+        if (gsp_shm_read(d, stat_off, &h, sizeof(h))) {
+            qi.stat_size = h.size;
+        }
+    }
+    nvt_emit(d, NVT_REC_GSP_QINFO, 0, &qi, sizeof(qi), NULL, 0);
+    nvtrace_note(d, "gsp: queues at sharedMemPhysAddr=0x%" PRIx64
+                 " npte=%u cmdq=+0x%" PRIx64 " statq=+0x%" PRIx64
+                 " elemHdr=%u (source %u)", shared_pa, npte, cmd_off,
+                 stat_off, elem_hdr, source);
+    gsp_drain_all(d);
+    return true;
+}
+
+static void gsp_add_log(NvTraceDev *d, const char *id, uint64_t pa,
+                        uint64_t size)
+{
+    NvtGsp *g = &d->g;
+    int i;
+
+    for (i = 0; i < g->nlogs; i++) {
+        if (!strcmp(g->logs[i].id, id)) {
+            break;
+        }
+    }
+    if (i == g->nlogs) {
+        if (g->nlogs == NVT_MAX_LOGS) {
+            return;
+        }
+        g->nlogs++;
+    }
+    pstrcpy(g->logs[i].id, sizeof(g->logs[i].id), id);
+    g->logs[i].pa = pa;
+    g->logs[i].size = MIN(size, 16 * 1024 * 1024);
+    g->logs[i].last_put = ~0ull;
+    g->logs[i].last_ns = 0;
+}
+
+/*
+ * Snapshot GSP log buffers whose put pointer moved. With 'unlocked' the
+ * caller does not hold g->lock: the list is copied under the lock and the
+ * (possibly large) copies are made without it.
+ */
+static void gsp_snap_logs_impl(NvTraceDev *d, bool force, bool unlocked)
+{
+    NvtGsp *g = &d->g;
+    NvtLog logs[NVT_MAX_LOGS];
+    uint64_t now = nvt_now();
+    int i, n;
+
+    if (unlocked) {
+        qemu_mutex_lock(&g->lock);
+    }
+    n = g->nlogs;
+    memcpy(logs, g->logs, sizeof(logs));
+    for (i = 0; i < n; i++) {
+        if (force || now - g->logs[i].last_ns >= d->log_ms * 1000000ull) {
+            g->logs[i].last_ns = now;
+        } else {
+            logs[i].pa = 0;
+        }
+    }
+    if (unlocked) {
+        qemu_mutex_unlock(&g->lock);
+    }
+
+    for (i = 0; i < n; i++) {
+        NvtLog *l = &logs[i];
+        uint64_t put;
+        g_autofree char *label = NULL;
+
+        if (!l->pa || !nvt_gread(d->as, l->pa, &put, 8) ||
+            put == l->last_put) {
+            continue;
+        }
+        label = g_strdup_printf("GSPLOG:%s", l->id);
+        nvt_snap(d, l->pa, l->size, label);
+        if (unlocked) {
+            qemu_mutex_lock(&g->lock);
+        }
+        if (i < g->nlogs && g->logs[i].pa == l->pa) {
+            g->logs[i].last_put = put;
+        }
+        if (unlocked) {
+            qemu_mutex_unlock(&g->lock);
+        }
+    }
+}
+
+static void gsp_snap_logs(NvTraceDev *d, bool force)
+{
+    gsp_snap_logs_impl(d, force, false);
+}
+
+static void id8_to_str(uint64_t id8, char out[9])
+{
+    int i, n = 0;
+
+    for (i = 7; i >= 0; i--) {
+        char c = (id8 >> (i * 8)) & 0xff;
+
+        if (c) {
+            out[n++] = g_ascii_isprint(c) ? c : '?';
+        }
+    }
+    out[n] = 0;
+}
+
+typedef struct QEMU_PACKED {
+    uint64_t id8, pa, size;
+    uint8_t kind, loc;
+    uint8_t pad[6];
+} LibosRegion;
+
+#define LIBOS_REGIONS_MAX_GUARD (NVT_PAGE / sizeof(LibosRegion))
+
+/* Follow GSP_FMC_BOOT_PARAMS -> WPR meta, libos args -> RMARGS -> queues */
+static bool gsp_discover_from_fmc(NvTraceDev *d, uint64_t fmc_pa,
+                                  uint32_t source)
+{
+    uint8_t fmc[88];
+    uint64_t wpr, libos;
+    LibosRegion r[LIBOS_REGIONS_MAX_GUARD];
+    bool found = false;
+    int i;
+
+    if (!nvt_gread(d->as, fmc_pa, fmc, sizeof(fmc))) {
+        nvtrace_note(d, "gsp: FMC boot params 0x%" PRIx64 " not in RAM",
+                     fmc_pa);
+        return false;
+    }
+    memcpy(&wpr, fmc + 16, 8);   /* bootGspRmParams.gspRmDescOffset */
+    memcpy(&libos, fmc + 48, 8); /* gspRmParams.bootArgsOffset */
+    if (!libos || !nvt_is_ram(d->as, libos)) {
+        nvtrace_note(d, "gsp: 0x%" PRIx64 " does not look like "
+                     "GSP_FMC_BOOT_PARAMS (bootArgsOffset 0x%" PRIx64 ")",
+                     fmc_pa, libos);
+        return false;
+    }
+    nvt_snap(d, fmc_pa, NVT_PAGE, "GSP_FMC_BOOT_PARAMS");
+    if (wpr && nvt_is_ram(d->as, wpr)) {
+        uint64_t magic = 0;
+
+        nvt_gread(d->as, wpr, &magic, 8);
+        nvt_snap(d, wpr, NVT_PAGE, "GSP_WPR_META");
+        if (magic != WPR_META_MAGIC) {
+            nvtrace_note(d, "gsp: WPR meta magic 0x%" PRIx64 " unexpected",
+                         magic);
+        }
+    }
+    nvt_snap(d, libos, NVT_PAGE, "LIBOS_INIT_ARGS");
+    if (!nvt_gread(d->as, libos, r, sizeof(r))) {
+        return false;
+    }
+    for (i = 0; i < LIBOS_REGIONS_MAX_GUARD && r[i].id8; i++) {
+        char id[9];
+
+        id8_to_str(r[i].id8, id);
+        nvtrace_note(d, "libos region %d: %s pa=0x%" PRIx64 " size=0x%"
+                     PRIx64 " kind=%u loc=%u", i, id, r[i].pa, r[i].size,
+                     r[i].kind, r[i].loc);
+        if (!strcmp(id, "RMARGS")) {
+            uint8_t a[64];
+            uint64_t shared, cmd, stat, hdr;
+            uint32_t npte;
+
+            nvt_snap(d, r[i].pa, MIN(r[i].size, 64 * 1024),
+                     "GSP_ARGUMENTS_CACHED");
+            if (!nvt_gread(d->as, r[i].pa, a, sizeof(a))) {
+                continue;
+            }
+            /* MESSAGE_QUEUE_INIT_ARGUMENTS */
+            memcpy(&shared, a + 0, 8);
+            memcpy(&npte, a + 8, 4);
+            memcpy(&cmd, a + 16, 8);
+            memcpy(&stat, a + 24, 8);
+            memcpy(&hdr, a + 32, 8);
+            found = gsp_set_queues(d, shared, npte, cmd, stat, hdr, source);
+        } else if (g_str_has_prefix(id, "LOG") && r[i].loc == 1) {
+            gsp_add_log(d, id, r[i].pa, r[i].size);
+        }
+    }
+    gsp_snap_logs(d, true);
+    return found;
+}
+
+/* ---- FSP ---- */
+
+static void fsp_message(NvTraceDev *d, int dir, const uint8_t *msg,
+                        size_t len)
+{
+    uint32_t nvdm;
+    uint8_t type;
+
+    if (len < 4) {
+        return;
+    }
+    memcpy(&nvdm, msg, 4);
+    type = nvdm >> 24;
+    if (dir == 0 && type == NVDM_TYPE_COT && len >= 4 + 860) {
+        const uint8_t *p = msg + 4;
+        uint64_t fmc, frts_sys, frts_vid, bootargs;
+        uint32_t frts_sys_size, frts_vid_size;
+        uint16_t ver, size;
+
+        memcpy(&ver, p + 0, 2);
+        memcpy(&size, p + 2, 2);
+        memcpy(&fmc, p + 4, 8);
+        memcpy(&frts_sys, p + 12, 8);
+        memcpy(&frts_sys_size, p + 20, 4);
+        memcpy(&frts_vid, p + 24, 8);
+        memcpy(&frts_vid_size, p + 32, 4);
+        memcpy(&bootargs, p + 852, 8);
+        nvtrace_note(d, "fsp: COT v%u size=%u gspFmcSysmemOffset=0x%" PRIx64
+                     " frtsSysmem=0x%" PRIx64 "+0x%x frtsVidmem=-0x%" PRIx64
+                     "+0x%x gspBootArgsSysmemOffset=0x%" PRIx64, ver, size,
+                     fmc, frts_sys, frts_sys_size, frts_vid, frts_vid_size,
+                     bootargs);
+        if (bootargs && bootargs != ~0ull) {
+            gsp_discover_from_fmc(d, bootargs, 1);
+        }
+    }
+}
+
+static void fsp_packet(NvTraceDev *d, int dir, uint32_t head, uint32_t tail)
+{
+    NvtGsp *g = &d->g;
+    NvtFsp f = { .dir = dir };
+    uint32_t first = head / 4, last = tail / 4, hdr;
+    const uint8_t *p;
+    size_t len;
+
+    if (first > last || last >= NVT_EMEM_DWORDS) {
+        nvtrace_note(d, "fsp: odd packet bounds dir=%d head=0x%x tail=0x%x",
+                     dir, head, tail);
+        return;
+    }
+    p = (const uint8_t *)&g->emem[first];
+    len = (last - first + 1) * 4;
+    f.len = len;
+    nvt_emit(d, NVT_REC_FSP_PKT, 0, &f, sizeof(f), p, len);
+
+    memcpy(&hdr, p, 4);
+    if (hdr & (1u << 31)) {                 /* SOM */
+        g_byte_array_set_size(g->fsp_msg[dir], 0);
+    }
+    g_byte_array_append(g->fsp_msg[dir], p + 4, len - 4);
+    if (hdr & (1u << 30)) {                 /* EOM */
+        fsp_message(d, dir, g->fsp_msg[dir]->data, g->fsp_msg[dir]->len);
+        g_byte_array_set_size(g->fsp_msg[dir], 0);
+    }
+}
+
+/* ---- generic LO/HI pair heuristic ---- */
+
+static void pair_candidate(NvTraceDev *d, uint32_t lo_off, uint64_t addr)
+{
+    NvtGsp *g = &d->g;
+    static const int shifts[] = { 0, 8, 12 };
+    int i;
+
+    for (i = 0; i < ARRAY_SIZE(shifts); i++) {
+        uint64_t a = addr << shifts[i];
+        uint64_t key;
+        g_autofree char *label = NULL;
+
+        if ((addr >> (64 - 12)) && shifts[i]) {
+            continue;
+        }
+        if (a < 0x100000 || (a & 0xff) || a >= (1ull << 52)) {
+            continue;
+        }
+        if (!nvt_is_ram(d->as, a)) {
+            continue;
+        }
+        key = (a & ~0xfffull) ^ ((uint64_t)lo_off << 40);
+        if (g_hash_table_contains(g->snapped, &key)) {
+            continue;
+        }
+        if (g->pair_budget < NVT_PAGE) {
+            return;
+        }
+        g->pair_budget -= NVT_PAGE;
+        g_hash_table_add(g->snapped, g_memdup2(&key, sizeof(key)));
+        label = g_strdup_printf("pair:%06x<<%d", lo_off, shifts[i]);
+        nvt_snap(d, a & ~0xfffull, NVT_PAGE, label);
+    }
+}
+
+/* Falcon IMEM/DMEM/EMEM data ports carry payload, not addresses. */
+static bool pair_is_data_port(uint32_t off)
+{
+    static const uint32_t bases[] = { 0x110000, 0x8f0000, 0x840000,
+                                      0x10a000 };
+    int i;
+
+    for (i = 0; i < ARRAY_SIZE(bases); i++) {
+        uint32_t rel = off - bases[i];
+
+        if (off >= bases[i] && rel < 0x1000 &&
+            ((rel >= 0x180 && rel < 0x200) || (rel >= 0xac0 && rel < 0xb00))) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void pair_observe(NvTraceDev *d, uint32_t off, uint64_t val,
+                         unsigned size)
+{
+    NvtGsp *g = &d->g;
+    unsigned i;
+    uint32_t base = off & ~7u, other = off ^ 4;
+
+    if (pair_is_data_port(off)) {
+        return;
+    }
+
+    if (size == 8 && !(off & 7)) {
+        pair_candidate(d, off, val);
+        return;
+    }
+    if (size != 4) {
+        return;
+    }
+    for (i = 0; i < NVT_PAIR_HIST; i++) {
+        unsigned j = (g->hist_pos + NVT_PAIR_HIST - 1 - i) % NVT_PAIR_HIST;
+
+        if (g->hist[j].off == other) {
+            uint64_t lo = off == base ? val : g->hist[j].val;
+            uint64_t hi = off == base ? g->hist[j].val : val;
+
+            if (hi || lo) {
+                pair_candidate(d, base, (hi << 32) | (uint32_t)lo);
+            }
+            break;
+        }
+        if (g->hist[j].off == off) {
+            break;
+        }
+    }
+    g->hist[g->hist_pos].off = off;
+    g->hist[g->hist_pos].val = val;
+    g->hist_pos = (g->hist_pos + 1) % NVT_PAIR_HIST;
+}
+
+/* ---- RAM scan fallback ---- */
+
+typedef struct {
+    NvTraceDev *d;
+    int found;
+    NvtScanCand cand[8];
+    int ncand;
+} ScanCtx;
+
+static bool scan_check_page(NvTraceDev *d, uint64_t pa, uint32_t *cmd_off,
+                            uint32_t *npte_out, uint32_t *wp)
+{
+    uint64_t ptes[8];
+    int k;
+
+    if (!nvt_gread(d->as, pa, ptes, sizeof(ptes))) {
+        return false;
+    }
+    if (ptes[0] != pa || !ptes[1] || (ptes[1] & 0xfff)) {
+        return false;
+    }
+    for (k = 1; k <= 4; k++) {
+        MsgqTxHeader h;
+
+        if ((ptes[k] & 0xfff) || !ptes[k] ||
+            !nvt_gread(d->as, ptes[k], &h, sizeof(h))) {
+            return false;
+        }
+        if (gsp_txhdr_ok(&h) && h.msg_size == NVT_PAGE) {
+            uint64_t all[512];
+            uint32_t n = 0;
+
+            *cmd_off = k * NVT_PAGE;
+            *wp = h.write_ptr;
+            if (!nvt_gread(d->as, pa, all, sizeof(all))) {
+                return false;
+            }
+            while (n < 512 && all[n] && !(all[n] & 0xfff)) {
+                n++;
+            }
+            *npte_out = n;
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool scan_cb(Int128 start, Int128 len, const MemoryRegion *mr,
+                    hwaddr off_in_mr, void *opaque)
+{
+    ScanCtx *c = opaque;
+    NvTraceDev *d = c->d;
+    uint64_t s = int128_get64(start), l = int128_get64(len), a;
+    uint8_t *host;
+
+    if (!memory_region_is_ram((MemoryRegion *)mr) ||
+        memory_region_is_ram_device((MemoryRegion *)mr)) {
+        return false;
+    }
+    host = (uint8_t *)memory_region_get_ram_ptr((MemoryRegion *)mr) +
+           off_in_mr;
+    for (a = ROUND_UP(s, NVT_PAGE); a + NVT_PAGE <= s + l; a += NVT_PAGE) {
+        uint64_t v;
+        uint32_t cmd_off, npte, wp;
+
+        memcpy(&v, host + (a - s), 8);
+        if (v != a) {
+            continue;
+        }
+        if (scan_check_page(d, a, &cmd_off, &npte, &wp)) {
+            if (c->ncand < ARRAY_SIZE(c->cand)) {
+                c->cand[c->ncand].pa = a;
+                c->cand[c->ncand].wp = wp;
+                c->ncand++;
+            }
+            c->found++;
+        }
+    }
+    return false;
+}
+
+static void gsp_pick_candidate(NvTraceDev *d, uint64_t pa)
+{
+    uint32_t cmd_off, npte, wp;
+    uint64_t pte;
+    MsgqTxHeader ch;
+
+    if (!scan_check_page(d, pa, &cmd_off, &npte, &wp) ||
+        !nvt_gread(d->as, pa + (cmd_off / NVT_PAGE) * 8, &pte, 8) ||
+        !nvt_gread(d->as, pte, &ch, sizeof(ch))) {
+        return;
+    }
+    gsp_set_queues(d, pa, npte, cmd_off, cmd_off + ch.size, 0, 3);
+}
+
+/* Called from the poller thread without g->lock held. */
+static void gsp_scan(NvTraceDev *d)
+{
+    ScanCtx c = { .d = d };
+    uint64_t t0 = nvt_now();
+
+    WITH_RCU_READ_LOCK_GUARD() {
+        flatview_for_each_range(address_space_to_flatview(d->as), scan_cb,
+                                &c);
+    }
+
+    qemu_mutex_lock(&d->g.lock);
+    nvtrace_note(d, "gsp: RAM scan found %d queue candidate(s) in %" PRIu64
+                 " ms", c.found, (nvt_now() - t0) / 1000000);
+    if (!d->g.known) {
+        memcpy(d->g.cand, c.cand, sizeof(c.cand));
+        d->g.ncand = c.ncand;
+        if (c.ncand == 1) {
+            gsp_pick_candidate(d, c.cand[0].pa);
+        }
+    }
+    qemu_mutex_unlock(&d->g.lock);
+}
+
+/* With several scan candidates, pick the one whose write pointer moved. */
+static void gsp_resolve_candidates(NvTraceDev *d)
+{
+    NvtGsp *g = &d->g;
+    int i;
+
+    for (i = 0; i < g->ncand && !g->known; i++) {
+        uint32_t cmd_off, npte, wp;
+
+        if (scan_check_page(d, g->cand[i].pa, &cmd_off, &npte, &wp) &&
+            wp != g->cand[i].wp) {
+            gsp_pick_candidate(d, g->cand[i].pa);
+        }
+    }
+}
+
+static void gsp_observe(NvTraceDev *d, uint32_t off, unsigned size,
+                        uint64_t val, bool write)
+{
+    NvtGsp *g = &d->g;
+
+    switch (off) {
+    case NV_PFSP_EMEMC0:
+        if (write) {
+            g->emem_ptr = ((val >> 8) & 0xff) * 64 + ((val >> 2) & 0x3f);
+            g->aincw = (val >> 24) & 1;
+            g->aincr = (val >> 25) & 1;
+        }
+        return;
+    case NV_PFSP_EMEMD0:
+        if (g->emem_ptr < NVT_EMEM_DWORDS) {
+            g->emem[g->emem_ptr] = val;
+        }
+        if ((write && g->aincw) || (!write && g->aincr)) {
+            g->emem_ptr++;
+        }
+        return;
+    case NV_PFSP_QUEUE_TAIL0:
+        if (write) {
+            g->fsp_qtail = val;
+        }
+        return;
+    case NV_PFSP_QUEUE_HEAD0:
+        if (write) {
+            fsp_packet(d, 0, val, g->fsp_qtail);
+        }
+        return;
+    case NV_PFSP_MSGQ_HEAD0:
+        if (!write) {
+            g->fsp_mhead = val;
+        } else if (g->fsp_mvalid && g->fsp_mtail >= g->fsp_mhead &&
+                   val == g->fsp_mhead) {
+            /* RM acks a response by setting head = tail = old head */
+            fsp_packet(d, 1, g->fsp_mhead, g->fsp_mtail);
+            g->fsp_mvalid = false;
+        }
+        return;
+    case NV_PFSP_MSGQ_TAIL0:
+        if (!write) {
+            g->fsp_mtail = val;
+            g->fsp_mvalid = true;
+        }
+        return;
+    }
+
+    if (!write) {
+        return;
+    }
+    if (off == NV_PGSP_QUEUE_HEAD0) {
+        if (!g->known) {
+            if (g->ncand > 1) {
+                gsp_resolve_candidates(d);
+            } else {
+                g->need_scan = true;
+            }
+        }
+        return;
+    }
+    if (off == NV_PGSP_FALCON_MAILBOX1 && !g->known) {
+        unsigned i;
+
+        for (i = 0; i < NVT_PAIR_HIST; i++) {
+            unsigned j = (g->hist_pos + NVT_PAIR_HIST - 1 - i) %
+                         NVT_PAIR_HIST;
+
+            if (g->hist[j].off == NV_PGSP_FALCON_MAILBOX0) {
+                uint64_t pa = (val << 32) | g->hist[j].val;
+
+                if (nvt_is_ram(d->as, pa)) {
+                    gsp_discover_from_fmc(d, pa, 2);
+                }
+                break;
+            }
+        }
+    }
+    pair_observe(d, off, val, size);
+}
+
+static void *nvt_poll_thread(void *opaque)
+{
+    NvTraceDev *d = opaque;
+    NvtGsp *g = &d->g;
+
+    rcu_register_thread();
+    while (!qatomic_read(&d->stop)) {
+        bool scan = false;
+
+        qemu_mutex_lock(&g->lock);
+        if (g->need_scan && !g->known && g->scans < 10 &&
+            nvt_now() - g->last_scan_ns > 5000000000ull) {
+            g->need_scan = false;
+            g->scans++;
+            g->last_scan_ns = nvt_now();
+            scan = true;
+        }
+        if (g->known) {
+            gsp_drain_all(d);
+        }
+        qemu_mutex_unlock(&g->lock);
+        if (d->log_ms) {
+            gsp_snap_logs_impl(d, false, true);
+        }
+
+        if (scan) {
+            gsp_scan(d);
+        }
+        g_usleep(g->known ? d->poll_us : 10000);
+    }
+    rcu_unregister_thread();
+    return NULL;
+}
