+/*
+ * Command-queue RPC logged: an RPC of exactly the maximum size is the first
+ * record of a large one (vgpu/rpc.c _issueRpcLarge); its CONTINUATION_RECORD
+ * payloads are appended before following it.
+ */
+static void gsp_follow_msg(NvTraceDev *d, const uint8_t *rpc, uint32_t len)
+{
+    NvtGsp *g = &d->g;
+    uint32_t rlen, fn, maxrpc;
+
+    if (len < 32) {
+        return;
+    }
+    rlen = MIN(ldl_le_p(rpc + 8), len);
+    fn = ldl_le_p(rpc + 12);
+    maxrpc = (g->elem_max ? g->elem_max : 65536) -
+             (g->elem_hdr ? g->elem_hdr : 16);
+    if (fn == RPC_FN_CONTINUATION) {
+        if (g->big->len && rlen > 32 && g->big->len < (64u << 20)) {
+            g_byte_array_append(g->big, rpc + 32, rlen - 32);
+            g->big_cont++;
+        }
+        return;
+    }
+    gsp_big_flush(d);
+    if (rlen == maxrpc) {
+        g_byte_array_append(g->big, rpc, rlen);
+        g->big_ns = nvt_now();
+        return;
+    }
+    gsp_follow(d, rpc, rlen);
