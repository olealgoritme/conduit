+    NVT_REC_GPU_PAGE   = 16,
+    NVT_REC_GPU_HASHES = 17,
+    NVT_REC_PUSHBUF    = 18,
 };
 
 typedef struct QEMU_PACKED {
@@ -187,10 +190,43 @@ typedef struct QEMU_PACKED {
     uint64_t hash;
 } NvtBarPage;
 
+/* GPU memory read from the host side (VRAM or sysmem), content changed. */
+typedef struct QEMU_PACKED {
+    uint8_t  aper;         /* 0 vidmem, 2 sysmem coherent, 3 non-coherent */
+    uint8_t  reason;       /* 0 event, 1 period, 2 sweep, 3 page table */
