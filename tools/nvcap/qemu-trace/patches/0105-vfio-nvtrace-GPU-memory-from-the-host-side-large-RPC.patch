+/* GSP-RM ELF in sysmem: 3-level page lists of 4 KiB pages (kgspCreateRadix3) */
+static bool radix3_read(NvTraceDev *d, uint64_t root, uint8_t *img,
+                        uint64_t size)
+{
+    uint64_t npages = DIV_ROUND_UP(size, NVT_PAGE);
+    uint64_t n2 = DIV_ROUND_UP(npages, 512), n1 = DIV_ROUND_UP(n2, 512);
+    uint64_t l0[512], l1[512], l2[512], i, j, k, p2 = 0, pg = 0;
+
+    if (n1 > 512 || !nvt_gread(d->as, root & ~0xfffull, l0, sizeof(l0))) {
+        return false;
+    }
+    for (i = 0; i < n1; i++) {
+        if (!l0[i] || !nvt_gread(d->as, l0[i] & ~0xfffull, l1, sizeof(l1))) {
+            return false;
+        }
+        for (j = 0; j < 512 && p2 < n2; j++, p2++) {
+            if (!l1[j] ||
+                !nvt_gread(d->as, l1[j] & ~0xfffull, l2, sizeof(l2))) {
+                return false;
+            }
+            for (k = 0; k < 512 && pg < npages; k++, pg++) {
+                uint64_t n = MIN(NVT_PAGE, size - pg * NVT_PAGE);
+
+                if (!l2[k] ||
+                    !nvt_gread(d->as, l2[k] & ~0xfffull, img + pg * NVT_PAGE,
+                               n)) {
+                    return false;
+                }
+            }
+        }
+    }
+    return true;
+}
