+static void gpu_stop(NvTraceDev *d)
+{
+    NvtGpu *u = d->gpu;
+
+    if (!u || !u->started) {
+        return;
+    }
+    qemu_mutex_lock(&u->lock);
+    u->stop = true;
+    qemu_cond_signal(&u->cond);
+    qemu_mutex_unlock(&u->lock);
+    qemu_thread_join(&u->thread);
+    u->started = false;
+}
