+/* A large RPC (and its CONTINUATION_RECORDs) is complete: follow it whole */
+static void gsp_big_flush(NvTraceDev *d)
+{
+    NvtGsp *g = &d->g;
+
+    if (!g->big->len) {
+        return;
+    }
+    stl_le_p(g->big->data + 8, g->big->len);       /* full length */
