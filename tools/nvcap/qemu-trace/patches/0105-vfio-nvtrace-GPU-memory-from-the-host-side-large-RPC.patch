+                     "records, %u bytes", ldl_le_p(g->big->data + 12),
+                     g->big_cont, g->big->len);
+    }
+    gsp_follow(d, g->big->data, g->big->len);
+    g_byte_array_set_size(g->big, 0);
+    g->big_cont = 0;
