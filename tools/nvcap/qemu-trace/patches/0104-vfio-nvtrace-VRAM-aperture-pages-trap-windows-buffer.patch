+/*
+ * x-trap-windows: remove [off, off+len) of BAR nr from its mmaps, so guest
+ * accesses there exit to QEMU (and are traced) while the rest of the BAR
+ * stays mmapped. Called before the BAR is mmapped.
+ */
+static void vfio_nvtrace_carve(VFIOPCIDevice *vdev, int nr)
+{
+    VFIORegion *r = &vdev->bars[nr].region;
+    int w, i;
+
+    for (w = 0; w < vdev->ntrapwin; w++) {
+        uint64_t ws, we;
+        GArray *out;
+
+        if (vdev->trapwin[w].bar != nr || !r->nr_mmaps) {
+            continue;
+        }
+        ws = vdev->trapwin[w].off & qemu_real_host_page_mask();
+        we = REAL_HOST_PAGE_ALIGN(vdev->trapwin[w].off + vdev->trapwin[w].len);
+        out = g_array_new(false, true, sizeof(VFIOMmap));
+        for (i = 0; i < r->nr_mmaps; i++) {
+            uint64_t ms = r->mmaps[i].offset, me = ms + r->mmaps[i].size;
+            VFIOMmap m = { 0 };
+
+            if (we <= ms || ws >= me) {
+                m.offset = ms;
+                m.size = me - ms;
+                g_array_append_val(out, m);
+                continue;
+            }
+            if (ws > ms) {
+                m.offset = ms;
+                m.size = ws - ms;
+                g_array_append_val(out, m);
+            }
+            if (we < me) {
+                m.offset = we;
+                m.size = me - we;
+                g_array_append_val(out, m);
+            }
+        }
+        g_free(r->mmaps);
+        r->nr_mmaps = out->len;
+        r->mmaps = (VFIOMmap *)g_array_free(out, false);
+        if (!r->nr_mmaps) {
+            g_free(r->mmaps);
+            r->mmaps = NULL;
+        }
+        if (vdev->vbasedev.nvtrace) {
+            nvtrace_note(vdev->vbasedev.nvtrace, "BAR%d window 0x%" PRIx64
+                         "+0x%" PRIx64 " trapped (%d mmaps left)", nr, ws,
+                         we - ws, r->nr_mmaps);
+        }
+    }
+}
