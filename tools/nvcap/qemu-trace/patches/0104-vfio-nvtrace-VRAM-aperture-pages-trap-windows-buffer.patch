+/* Side-effect free BAR read for the dirty page logger (any thread). */
+static bool vfio_nvtrace_bar_read(void *opaque, int bar, uint64_t off,
+                                  void *buf, size_t len)
+{
+    VFIOPCIDevice *vdev = opaque;
+    VFIORegion *r = &vdev->bars[bar].region;
+    int i;
+
+    if (!vdev->vbasedev.proxy) {
+        /* kernel vfio: -EIO instead of SIGBUS when memory decode is off */
+        int fd = vfio_device_get_region_fd(&vdev->vbasedev, r->nr);
+
+        return pread(fd, buf, len, r->fd_offset + off) == (ssize_t)len;
+    }
+    /* vfio-user: the server's memory is ordinary shared memory */
+    for (i = 0; i < r->nr_mmaps; i++) {
+        if (r->mmaps[i].mmap && off >= r->mmaps[i].offset &&
+            off + len <= r->mmaps[i].offset + r->mmaps[i].size) {
+            memcpy(buf, (uint8_t *)r->mmaps[i].mmap +
+                   (off - r->mmaps[i].offset), len);
+            return true;
+        }
+    }
+    return false;
+}
