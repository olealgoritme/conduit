+/* ------------------------------------------------------------------ */
+/* BAR pages written by the guest CPU (VRAM apertures)                 */
+/*
+ * The mmapped BAR ranges stay mmapped (no exits); QEMU turns on KVM dirty
+ * logging for them (DIRTY_MEMORY_VGA client). A timer on the main loop
+ * (BQL) collects the dirty pages every NVTRACE_DIRTY_MS; a worker thread
+ * re-reads each one through the device fd (pread: no SIGBUS while memory
+ * decode is off, -EIO instead), hashes it and logs it (BAR_PAGE) when the
+ * content differs from the last time. KVM write-protects the pages again
+ * after each collection, so each tracked page costs one write fault per
+ * period, not one per write.
+ */
+
+#define NVT_BT_CHUNK    (2 * 1024 * 1024)
+
+static void nvt_bt_queue(NvtBarTrack *t, const uint64_t *keys, size_t n)
+{
+    size_t i;
+
+    qemu_mutex_lock(&t->lock);
+    for (i = 0; i < n; i++) {
+        if (t->pending->len >= NVT_BT_PENDING_MAX) {
+            t->overflow += n - i;
+            break;
+        }
+        if (g_hash_table_add(t->pending_set, GSIZE_TO_POINTER(keys[i] + 1))) {
+            g_array_append_val(t->pending, keys[i]);
+        }
+    }
+    qemu_cond_signal(&t->cond);
+    qemu_mutex_unlock(&t->lock);
+}
+
+/*
+ * A new KVM memslot with dirty logging starts with every page dirty
+ * (KVM_DIRTY_LOG_INITIALLY_SET), and so does a new RAMBlock. Reading all
+ * of them would hit BAR1 pages the GPU has not mapped, so the first
+ * collection after the BAR range is (re)mapped is thrown away.
+ */
+static void nvt_bt_section(MemoryListener *l, MemoryRegionSection *sec)
+{
+    NvtBarTrack *t = container_of(l, NvtBarTrack, ml);
+    int m;
+
+    for (m = 0; m < t->nmaps; m++) {
+        if (sec->mr == t->map[m].mr) {
+            t->map[m].skip = 1;
+        }
+    }
+}
+
+static void nvt_bt_log_start(MemoryListener *l, MemoryRegionSection *sec,
+                             int old, int new)
+{
+    nvt_bt_section(l, sec);
+}
+
+static void nvt_bt_tick(void *opaque)
+{
+    NvTraceDev *d = opaque;
+    NvtBarTrack *t = d->bt;
+    g_autoptr(GArray) keys = g_array_new(false, false, sizeof(uint64_t));
+    int m;
+
+    t->ticks++;
+    for (m = 0; m < t->nmaps; m++) {
+        MemoryRegion *mr = t->map[m].mr;
+        uint64_t size = t->map[m].size, o, p;
+        guint before = keys->len;
+        DirtyBitmapSnapshot *snap;
+
+        snap = memory_region_snapshot_and_clear_dirty(mr, 0, size,
+                                                      DIRTY_MEMORY_VGA);
+        if (t->map[m].skip) {
+            t->map[m].skip--;
+            t->discarded++;
+            g_free(snap);
+            continue;
+        }
+        for (o = 0; o < size; o += NVT_BT_CHUNK) {
+            uint64_t l = MIN(NVT_BT_CHUNK, size - o);
+
+            if (!memory_region_snapshot_get_dirty(mr, snap, o, l)) {
+                continue;
+            }
+            for (p = o; p < o + l; p += NVT_PAGE) {
+                if (memory_region_snapshot_get_dirty(mr, snap, p, NVT_PAGE)) {
+                    uint64_t key = ((uint64_t)t->map[m].bar << 56) |
+                                   (t->map[m].off + p);
+
+                    g_array_append_val(keys, key);
+                }
+            }
+        }
+        g_free(snap);
+        /* everything dirty in a large range: not guest writes, drop it */
+        if (size >= (256 << 20) &&
+            (uint64_t)(keys->len - before) * NVT_PAGE > size / 2) {
+            g_array_set_size(keys, before);
+            t->discarded++;
+        }
+    }
+    if (keys->len) {
+        nvt_bt_queue(t, (uint64_t *)keys->data, keys->len);
+    }
+    timer_mod(t->timer, qemu_clock_get_ms(QEMU_CLOCK_REALTIME) +
+              t->period_ms);
+}
+
+static void *nvt_bt_thread(void *opaque)
+{
+    NvTraceDev *d = opaque;
+    NvtBarTrack *t = d->bt;
+    uint8_t *buf = g_malloc(NVT_PAGE);
+    uint64_t tokens = t->budget, last = nvt_now(), last_rescan = nvt_now();
+    uint64_t last_note = nvt_now(), noted = 0;
+
+    for (;;) {
+        g_autoptr(GArray) work = NULL;
+        uint64_t now;
+        guint i;
+        bool rescan;
+
+        qemu_mutex_lock(&t->lock);
+        while (!t->pending->len && !t->stop) {
+            qemu_cond_timedwait(&t->cond, &t->lock, 200);
+            if (t->rescan_ms &&
+                nvt_now() - last_rescan >= t->rescan_ms * 1000000) {
+                break;
+            }
+        }
+        if (t->stop) {
+            qemu_mutex_unlock(&t->lock);
+            break;
+        }
+        work = t->pending;
+        t->pending = g_array_new(false, false, sizeof(uint64_t));
+        g_hash_table_remove_all(t->pending_set);
+        qemu_mutex_unlock(&t->lock);
+
+        now = nvt_now();
+        rescan = t->rescan_ms && now - last_rescan >= t->rescan_ms * 1000000;
+        if (rescan) {
+            GHashTableIter it;
+            gpointer k, v;
+
+            last_rescan = now;
+            g_hash_table_iter_init(&it, t->hashes);
+            while (g_hash_table_iter_next(&it, &k, &v)) {
+                uint64_t key = GPOINTER_TO_SIZE(k) - 1;
+
+                key |= 1ull << 55;          /* marks "rescan" for reason */
+                g_array_append_val(work, key);
+            }
+        }
+
+        for (i = 0; i < work->len; i++) {
+            uint64_t key = g_array_index(work, uint64_t, i);
+            uint8_t reason = (key >> 55) & 1;
+            uint64_t h, hk;
+            int bar;
+            uint64_t off;
+            gpointer old;
+
+            key &= ~(1ull << 55);
+            bar = key >> 56;
+            off = key & ((1ull << 55) - 1);
+            hk = key + 1;
+            now = nvt_now();
+            tokens = MIN(t->budget, tokens + (now - last) * t->budget /
+                         1000000000ull);
+            last = now;
+            if (qatomic_read(&t->paused) || qatomic_read(&t->stop) ||
+                tokens < NVT_PAGE) {
+                t->dropped++;
+                continue;
+            }
+            tokens -= NVT_PAGE;
+            if (!t->read(t->opaque, bar, off, buf, NVT_PAGE)) {
+                t->readfail++;
+                continue;
+            }
+            h = nvt_hash(buf, NVT_PAGE) | 1;
+            old = g_hash_table_lookup(t->hashes, GSIZE_TO_POINTER(hk));
+            if (old && GPOINTER_TO_SIZE(old) == h) {
+                continue;
+            }
+            g_hash_table_insert(t->hashes, GSIZE_TO_POINTER(hk),
+                                GSIZE_TO_POINTER(h));
+            {
+                NvtBarPage bp = { .bar = bar, .reason = reason,
+                                  .len = NVT_PAGE, .off = off, .hash = h };
+
+                nvt_emit(d, NVT_REC_BAR_PAGE, 0, &bp, sizeof(bp), buf,
+                         NVT_PAGE);
+            }
+            t->emitted++;
+        }
+
+        now = nvt_now();
+        if (now - last_note > 5000000000ull &&
+            t->dropped + t->overflow + t->readfail != noted) {
+            noted = t->dropped + t->overflow + t->readfail;
+            last_note = now;
+            nvtrace_note(d, "bar pages: %" PRIu64 " logged, %" PRIu64
+                         " skipped (budget/reset), %" PRIu64 " overflow, %"
+                         PRIu64 " unreadable, %u known, %" PRIu64
+                         " collections discarded (remap)",
+                         t->emitted, t->dropped, t->overflow, t->readfail,
+                         g_hash_table_size(t->hashes), t->discarded);
+        }
+    }
+    g_free(buf);
+    return NULL;
+}
+
+void nvtrace_bar_track(NvTraceDev *d, int bar, MemoryRegion *mr,
+                       uint64_t bar_off, uint64_t size, NvtBarReadFn read,
+                       void *opaque)
+{
+    NvtBarTrack *t = d->bt;
+
+    if (!t) {
+        t = d->bt = g_new0(NvtBarTrack, 1);
+        t->read = read;
+        t->opaque = opaque;
+        t->period_ms = MAX(nvt_env_u64("NVTRACE_DIRTY_MS", 250), 10);
+        t->rescan_ms = nvt_env_u64("NVTRACE_DIRTY_RESCAN_MS", 0);
+        t->budget = MAX(nvt_env_u64("NVTRACE_DIRTY_BUDGET_MB", 16), 1) << 20;
+        qemu_mutex_init(&t->lock);
+        qemu_cond_init(&t->cond);
+        t->pending = g_array_new(false, false, sizeof(uint64_t));
+        t->pending_set = g_hash_table_new(NULL, NULL);
+        t->hashes = g_hash_table_new(NULL, NULL);
+        t->ml.name = "nvtrace-bar";
+        t->ml.region_add = nvt_bt_section;
+        t->ml.log_start = nvt_bt_log_start;
+        t->timer = timer_new_ms(QEMU_CLOCK_REALTIME, nvt_bt_tick, d);
+        timer_mod(t->timer, qemu_clock_get_ms(QEMU_CLOCK_REALTIME) +
+                  t->period_ms);
+        t->started = true;
+        qemu_thread_create(&t->thread, "nvtrace-bar", nvt_bt_thread, d,
+                           QEMU_THREAD_JOINABLE);
+        nvtrace_note(d, "bar pages: period %" PRIu64 " ms, budget %" PRIu64
+                     " MB/s, rescan %" PRIu64 " ms", t->period_ms,
+                     t->budget >> 20, t->rescan_ms);
+    }
+    if (t->nmaps == NVT_BT_MAPS || !size) {
+        return;
+    }
+    t->map[t->nmaps].bar = bar;
+    t->map[t->nmaps].mr = mr;
+    t->map[t->nmaps].off = bar_off;
+    t->map[t->nmaps].size = size;
+    t->map[t->nmaps].skip = 1;          /* RAMBlocks start all dirty */
+    t->nmaps++;
+    memory_region_set_log(mr, true, DIRTY_MEMORY_VGA);
+    if (!t->ml_on) {
+        memory_listener_register(&t->ml, &address_space_memory);
+        t->ml_on = true;
+    }
+    nvtrace_note(d, "bar pages: BAR%d +0x%" PRIx64 " size 0x%" PRIx64
+                 " dirty-tracked", bar, bar_off, size);
+}
+
+/* Stop the worker (any thread); the timer is removed with the BQL held. */
+static void nvt_bt_stop(NvTraceDev *d, bool bql)
+{
+    NvtBarTrack *t = d->bt;
+    int m;
+
+    if (!t || !t->started) {
+        return;
+    }
+    qemu_mutex_lock(&t->lock);
+    t->stop = true;
+    qemu_cond_signal(&t->cond);
+    qemu_mutex_unlock(&t->lock);
+    qemu_thread_join(&t->thread);
+    t->started = false;
+    if (bql) {
+        if (t->ml_on) {
+            memory_listener_unregister(&t->ml);
+            t->ml_on = false;
+        }
+        timer_free(t->timer);
+        t->timer = NULL;
+        for (m = 0; m < t->nmaps; m++) {
+            memory_region_set_log(t->map[m].mr, false, DIRTY_MEMORY_VGA);
+        }
+        t->nmaps = 0;
+    }
+}
