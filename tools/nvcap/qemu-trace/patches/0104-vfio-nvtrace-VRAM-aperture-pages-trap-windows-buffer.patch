From d1bdbf5898ed680279bdad7d0d4ace0c80e6a843 Mon Sep 17 00:00:00 2001
From: Ole Algoritme <olealgoritme@gmail.com>
Date: Sat, 31 Oct 2026 16:47:54 +0100
Subject: [PATCH 104/104] vfio: nvtrace - VRAM aperture pages, trap windows,
 buffers from GSP RPCs

New vfio-pci properties:
  x-nvtrace-dirty-bars=MASK  log the pages of these mmapped BARs that the
                             guest CPU writes: KVM dirty logging on the BAR
                             memslots, collected every NVTRACE_DIRTY_MS on
                             the main loop, re-read by a worker through
                             pread() on the device fd (no SIGBUS), logged as
                             BAR_PAGE records when the content changed
                             (budget NVTRACE_DIRTY_BUDGET_MB/s, optional
                             periodic re-read NVTRACE_DIRTY_RESCAN_MS). The
                             first collection after a BAR is (re)mapped is
                             dropped: new KVM slots start all dirty.
  x-trap-windows=B:OFF+LEN,...  keep only these ranges un-mmapped so they
                             trap and are traced; the rest stays mmapped.

Buffers named in GSP command RPCs (610.57.04 layouts) are captured:
ALLOC_MEMORY sysmem page lists, the sysmem memdescs of GPFIFO channel
allocations (instance, USERD, RAMFC, method buffer, error notifiers) and
display channel pushbuffers (NV2080_CTRL_CMD_INTERNAL_DISPLAY_CHANNEL_
PUSHBUFFER). They are snapshotted, re-read on usermode doorbell writes,
interrupts and periodically (changed pages only, in slices from the GSP
poller), dropped on FREE; every display PUT write logs the new pushbuffer
bytes.
---
 hw/vfio/nvtrace.c | 846 ++++++++++++++++++++++++++++++++++++++++++++++
 hw/vfio/nvtrace.h |  14 +
 hw/vfio/pci.c     | 129 +++++++
 hw/vfio/pci.h     |   7 +
 4 files changed, 996 insertions(+)

diff --git a/hw/vfio/nvtrace.c b/hw/vfio/nvtrace.c
index 60bf76468..dca0591fa 100644
--- a/hw/vfio/nvtrace.c
+++ b/hw/vfio/nvtrace.c
@@ -35,6 +35,9 @@
 #include "qemu/error-report.h"
 #include "qemu/cutils.h"
 #include "qemu/int128.h"
+#include "qemu/bswap.h"
+#include "qemu/timer.h"
+#include "qemu/main-loop.h"
 #include "system/system.h"
 #include "system/memory.h"
 #include "system/address-spaces.h"
@@ -68,6 +71,7 @@ enum {
     NVT_REC_FSP_PKT    = 12,
     NVT_REC_GSP_QINFO  = 13,
     NVT_REC_DEV        = 14,
+    NVT_REC_BAR_PAGE   = 15,
 };
 
 typedef struct QEMU_PACKED {
@@ -173,6 +177,21 @@ typedef struct QEMU_PACKED {
     uint64_t rsvd;
 } NvtDevRec;
 
+/* A 4 KiB page of a BAR (VRAM aperture) whose content changed. */
+typedef struct QEMU_PACKED {
+    uint8_t  bar;
+    uint8_t  reason;       /* 0 = guest CPU wrote it, 1 = periodic re-read */
+    uint16_t rsvd;
+    uint32_t len;
+    uint64_t off;          /* offset in the BAR */
+    uint64_t hash;
+} NvtBarPage;
+
+/* DMA_SNAP flags */
+#define NVT_SNAP_F_NODATA   0x01   /* not readable */
+#define NVT_SNAP_F_BLOB     0x02   /* not guest memory */
+#define NVT_SNAP_F_CHANGED  0x04   /* watched buffer re-read: content changed */
+
 /* ------------------------------------------------------------------ */
 /* Ring + writer                                                       */
 
@@ -640,6 +659,21 @@ static bool nvt_is_ram(AddressSpace *as, uint64_t gpa)
 #define NVT_MAX_LOGS              16
 #define NVT_PAIR_HIST             16
 
+/* RPC-driven DMA capture (610.57.04 layouts, see README "follow") */
+#define RPC_FN_ALLOC_MEMORY       4
+#define RPC_FN_FREE               10
+#define RPC_FN_GSP_RM_CONTROL     76
+#define RPC_FN_GSP_RM_ALLOC       103
+#define NV01_MEMORY_LIST_SYSTEM   0x81
+#define NV01_MEMORY_LIST_FBMEM    0x82
+#define NV_CTRL_DISP_CHN_PB       0x20800a58 /* ..._INTERNAL_DISPLAY_CHANNEL_PUSHBUFFER */
+#define NV_ADDR_SYSMEM            1
+#define NV_ADDR_FBMEM             2
+#define NV_UDISP_CORE             0x680000   /* NV_UDISP_FE_CHN_ASSY_BASEADR_CORE */
+#define NV_UDISP_WIN0             0x690000   /* ..._WIN(0); PUT at +0 */
+#define NVT_DISP_CHN              33         /* core + 32 windows */
+#define NV_USERMODE_DOORBELL      (0xb80000 + 0x30090) /* VF FULL_PHYS + DOORBELL */
+
 typedef struct NvtQueue {
     uint64_t off;              /* offset of the queue in the shared memory */
     uint32_t size, msg_size, msg_count, entry_off, rxhdr_off;
@@ -659,6 +693,62 @@ typedef struct NvtScanCand {
     uint32_t wp;
 } NvtScanCand;
 
+/* A guest-memory buffer the GPU reads or writes, learned from an RPC. */
+typedef struct NvtWatch {
+    uint32_t hclient, hobject;
+    char tag[22];              /* "w:" + tag fits a DMA_SNAP label */
+    bool hot;                  /* re-read on doorbells and interrupts */
+    uint32_t npages;
+    uint64_t first, len;       /* byte offset into the first page; size */
+    uint64_t *pages;           /* page-aligned guest physical addresses */
+    uint64_t *hash;            /* last content hash per page */
+} NvtWatch;
+
+typedef struct NvtWatchCursor {
+    guint k;                   /* entry */
+    uint32_t i;                /* page in the entry */
+} NvtWatchCursor;
+
+#define NVT_WATCH_SLICE           (256 * 1024)  /* bytes per poll, all */
+#define NVT_WATCH_HOT_SLICE       (1024 * 1024) /* bytes per hot pass */
+
+typedef struct NvtDispChn {
+    bool valid, sysmem;
+    uint32_t hclass, inst;
+    uint64_t pa, size;
+    uint32_t put;
+} NvtDispChn;
+
+/* BAR pages written by the guest CPU (KVM dirty log on the BAR mmaps) */
+#define NVT_BT_MAPS               32
+#define NVT_BT_PENDING_MAX        65536
+
+typedef struct NvtBarTrack {
+    struct {
+        int bar;
+        MemoryRegion *mr;
+        uint64_t off, size;
+        int skip;              /* ticks to discard (fresh KVM slot) */
+    } map[NVT_BT_MAPS];
+    int nmaps;
+    MemoryListener ml;
+    bool ml_on;
+    uint64_t discarded;
+    NvtBarReadFn read;
+    void *opaque;
+    QEMUTimer *timer;
+    uint64_t period_ms, rescan_ms, budget;     /* budget: bytes/s */
+    QemuMutex lock;
+    QemuCond cond;
+    GArray *pending;                           /* uint64 keys */
+    GHashTable *pending_set;
+    GHashTable *hashes;                        /* worker thread only */
+    QemuThread thread;
+    bool started, stop;
+    int paused;
+    uint64_t overflow, dropped, readfail, emitted, ticks;
+} NvtBarTrack;
+
 typedef struct NvtGsp {
     QemuMutex lock;
     bool known;
@@ -696,6 +786,14 @@ typedef struct NvtGsp {
     uint64_t last_scan_ns;
     NvtScanCand cand[8];
     int ncand;
+
+    /* RPC-driven capture */
+    GPtrArray *watch;          /* NvtWatch */
+    uint64_t watch_bytes;
+    bool watch_kick, watch_full_noted, watch_all_active;
+    uint64_t watch_hot_ns, watch_all_ns;
+    NvtWatchCursor watch_cur;
+    NvtDispChn disp[NVT_DISP_CHN];
 } NvtGsp;
 
 struct NvTraceDev {
@@ -710,6 +808,9 @@ struct NvTraceDev {
     QemuThread poll_thread;
     bool poll_started, stop;
     uint64_t poll_us, log_ms;
+    bool follow;
+    uint64_t watch_ms, watch_hot_us, watch_max, watch_obj_max;
+    NvtBarTrack *bt;
 };
 
 static uint8_t nvt_dev_index(NvTraceDev *d)
@@ -781,6 +882,403 @@ static uint64_t gsp_shm_gpa(NvTraceDev *d, uint64_t off)
     return pg < g->npte ? g->pte[pg] + (off % NVT_PAGE) : 0;
 }
 
+/* ---- content hash for change detection (not cryptographic) ---- */
+
+static uint64_t nvt_hash(const void *p, size_t len)
+{
+    const uint8_t *b = p;
+    uint64_t h = 0x9e3779b97f4a7c15ull ^ len;
+    size_t i;
+
+    for (i = 0; i + 8 <= len; i += 8) {
+        uint64_t v;
+
+        memcpy(&v, b + i, 8);
+        h ^= v * 0xbf58476d1ce4e5b9ull;
+        h = ((h << 27) | (h >> 37)) * 0x94d049bb133111ebull;
+    }
+    for (; i < len; i++) {
+        h = (h ^ b[i]) * 0x100000001b3ull;
+    }
+    return h ^ (h >> 31);
+}
+
+/* ---- watched guest buffers (learned from GSP RPCs) ---- */
+
+static void watch_free(gpointer p)
+{
+    NvtWatch *w = p;
+
+    g_free(w->pages);
+    g_free(w->hash);
+    g_free(w);
+}
+
+/* Byte range of page i of a watch entry: [*start, *start + *n) in the page */
+static void watch_page_range(const NvtWatch *w, uint32_t i, uint64_t *start,
+                             uint64_t *n)
+{
+    uint64_t lo = i ? 0 : w->first;
+    uint64_t end = w->first + w->len - (uint64_t)i * NVT_PAGE;
+
+    *start = lo;
+    *n = MIN(end, NVT_PAGE) - lo;
+}
+
+/* Read page i, return true and its hash when the content changed. */
+static bool watch_page_check(NvTraceDev *d, NvtWatch *w, uint32_t i,
+                             uint8_t *buf, uint64_t *start, uint64_t *n)
+{
+    uint64_t h;
+
+    watch_page_range(w, i, start, n);
+    if (!nvt_gread(d->as, w->pages[i] + *start, buf, *n)) {
+        return false;
+    }
+    h = nvt_hash(buf, *n) | 1;
+    if (h == w->hash[i]) {
+        return false;
+    }
+    w->hash[i] = h;
+    return true;
+}
+
+/* Called with g->lock held. */
+static void watch_add(NvTraceDev *d, uint32_t hclient, uint32_t hobject,
+                      const char *tag, bool hot, const uint64_t *pages,
+                      uint32_t npages, uint64_t first, uint64_t len)
+{
+    NvtGsp *g = &d->g;
+    NvtWatch *w;
+    uint8_t buf[NVT_PAGE];
+    uint32_t i;
+
+    len = MIN(len, d->watch_obj_max);
+    if (!len || !npages) {
+        return;
+    }
+    npages = MIN(npages, DIV_ROUND_UP(first + len, NVT_PAGE));
+    len = MIN(len, (uint64_t)npages * NVT_PAGE - first);
+    if (g->watch_bytes + len > d->watch_max) {
+        if (!g->watch_full_noted) {
+            nvtrace_note(d, "follow: watch budget (%" PRIu64 " MB) full, "
+                         "%s and later buffers not watched",
+                         d->watch_max >> 20, tag);
+            g->watch_full_noted = true;
+        }
+        return;
+    }
+    w = g_new0(NvtWatch, 1);
+    w->hclient = hclient;
+    w->hobject = hobject;
+    pstrcpy(w->tag, sizeof(w->tag), tag);
+    w->hot = hot;
+    w->npages = npages;
+    w->first = first;
+    w->len = len;
+    w->pages = g_memdup2(pages, npages * sizeof(uint64_t));
+    w->hash = g_new0(uint64_t, npages);
+    g_ptr_array_add(g->watch, w);
+    g->watch_bytes += len;
+
+    for (i = 0; i < npages; i++) {
+        uint64_t start, n;
+
+        watch_page_range(w, i, &start, &n);
+        if (!nvt_gread(d->as, pages[i] + start, buf, n)) {
+            NvtSnap sn = { .gpa = pages[i] + start, .len = n,
+                           .flags = NVT_SNAP_F_NODATA };
+
+            pstrcpy(sn.label, sizeof(sn.label), tag);
+            nvt_emit(d, NVT_REC_DMA_SNAP, 0, &sn, sizeof(sn), NULL, 0);
+            continue;
+        }
+        w->hash[i] = nvt_hash(buf, n) | 1;
+        {
+            NvtSnap sn = { .gpa = pages[i] + start, .len = n };
+
+            pstrcpy(sn.label, sizeof(sn.label), tag);
+            nvt_emit(d, NVT_REC_DMA_SNAP, 0, &sn, sizeof(sn), buf, n);
+        }
+    }
+}
+
+static void watch_add_contig(NvTraceDev *d, uint32_t hclient,
+                             uint32_t hobject, const char *tag, bool hot,
+                             uint64_t pa, uint64_t len)
+{
+    uint64_t first = pa & (NVT_PAGE - 1);
+    uint32_t i, n;
+    g_autofree uint64_t *pages = NULL;
+
+    len = MIN(len, d->watch_obj_max);
+    n = DIV_ROUND_UP(first + len, NVT_PAGE);
+    pages = g_new(uint64_t, n);
+    for (i = 0; i < n; i++) {
+        pages[i] = (pa & ~(uint64_t)(NVT_PAGE - 1)) + (uint64_t)i * NVT_PAGE;
+    }
+    watch_add(d, hclient, hobject, tag, hot, pages, n, first, len);
+}
+
+static void watch_remove(NvTraceDev *d, uint32_t hclient, uint32_t hobject)
+{
+    NvtGsp *g = &d->g;
+    guint i = 0;
+
+    while (i < g->watch->len) {
+        NvtWatch *w = g_ptr_array_index(g->watch, i);
+
+        if (w->hobject == hobject && (w->hclient == hclient || !hclient)) {
+            g->watch_bytes -= w->len;
+            g_ptr_array_remove_index_fast(g->watch, i);
+        } else {
+            i++;
+        }
+    }
+}
+
+/*
+ * Re-read watched buffers from *c on, at most 'budget' bytes (bounds the
+ * time g->lock is held); log the pages whose content changed. Returns true
+ * when the pass is complete (and resets the cursor).
+ */
+static bool watch_scan(NvTraceDev *d, bool hot_only, NvtWatchCursor *c,
+                       uint64_t budget)
+{
+    NvtGsp *g = &d->g;
+    uint8_t buf[NVT_PAGE];
+
+    for (; c->k < g->watch->len; c->k++, c->i = 0) {
+        NvtWatch *w = g_ptr_array_index(g->watch, c->k);
+
+        if (hot_only && !w->hot) {
+            continue;
+        }
+        for (; c->i < w->npages; c->i++) {
+            uint64_t start, n;
+            NvtSnap sn = { .flags = NVT_SNAP_F_CHANGED };
+
+            if (budget < NVT_PAGE) {
+                return false;
+            }
+            budget -= NVT_PAGE;
+            if (!watch_page_check(d, w, c->i, buf, &start, &n)) {
+                continue;
+            }
+            sn.gpa = w->pages[c->i] + start;
+            sn.len = n;
+            snprintf(sn.label, sizeof(sn.label), "w:%s", w->tag);
+            nvt_emit(d, NVT_REC_DMA_SNAP, 0, &sn, sizeof(sn), buf, n);
+        }
+    }
+    c->k = 0;
+    c->i = 0;
+    return true;
+}
+
+static void watch_clear(NvTraceDev *d)
+{
+    NvtGsp *g = &d->g;
+
+    g_ptr_array_set_size(g->watch, 0);
+    g->watch_bytes = 0;
+    g->watch_full_noted = false;
+    g->watch_all_active = false;
+    memset(&g->watch_cur, 0, sizeof(g->watch_cur));
+    memset(g->disp, 0, sizeof(g->disp));
+}
+
+/* ---- following addresses in GSP RPCs ---- */
+
+/* ALLOC_MEMORY (rpc_alloc_memory_v13_01): memory registered with GSP-RM */
+static void follow_alloc_memory(NvTraceDev *d, const uint8_t *p, uint32_t n)
+{
+    uint32_t hclient, hmem, cls, adj, count, i;
+    uint64_t length;
+    g_autofree uint64_t *pages = NULL;
+    g_autofree char *tag = NULL;
+
+    if (n < 56) {
+        return;
+    }
+    hclient = ldl_le_p(p);
+    hmem = ldl_le_p(p + 8);
+    cls = ldl_le_p(p + 12);
+    adj = ldl_le_p(p + 20);
+    length = ldq_le_p(p + 32);
+    count = MIN(ldl_le_p(p + 40), (n - 56) / 8);  /* pteDesc.pte_pde[] */
+    if (cls != NV01_MEMORY_LIST_SYSTEM || !count || !length) {
+        return;                     /* FBMEM: physical VRAM pages, no data */
+    }
+    tag = g_strdup_printf("mem%08x", hmem);
+    if (count == 1) {               /* contiguous: one PTE */
+        watch_add_contig(d, hclient, hmem, tag, false,
+                         (ldq_le_p(p + 56) << 12) + (adj & 0xfff), length);
+        return;
+    }
+    pages = g_new(uint64_t, count);
+    for (i = 0; i < count; i++) {
+        pages[i] = ldq_le_p(p + 56 + 8 * i) << 12;
+    }
+    watch_add(d, hclient, hmem, tag, false, pages, count, adj & 0xfff,
+              length);
+}
+
+/* GSP_RM_ALLOC of a GPFIFO channel: NV_CHANNEL_ALLOC_PARAMS memdescs */
+static void follow_channel(NvTraceDev *d, uint32_t hclient, uint32_t hobj,
+                           const uint8_t *a, uint32_t n)
+{
+    static const struct {
+        uint32_t off;
+        const char *name;
+        bool hot;
+    } md[] = {
+        { 152, "inst", false }, { 176, "userd", true },
+        { 200, "ramfc", false }, { 224, "mthdbuf", false },
+        { 256, "errnotif", true }, { 280, "eccnotif", false },
+    };
+    int i;
+
+    for (i = 0; i < ARRAY_SIZE(md); i++) {
+        uint64_t base, size;
+        uint32_t as;
+        g_autofree char *tag = NULL;
+
+        if (md[i].off + 24 > n) {
+            break;
+        }
+        base = ldq_le_p(a + md[i].off);
+        size = ldq_le_p(a + md[i].off + 8);
+        as = ldl_le_p(a + md[i].off + 16);
+        if (as != NV_ADDR_SYSMEM || !base || !size || size > (16 << 20)) {
+            continue;
+        }
+        tag = g_strdup_printf("ch%08x.%s", hobj, md[i].name);
+        watch_add_contig(d, hclient, hobj, tag, md[i].hot, base, size);
+    }
+}
+
+/* NV2080_CTRL_CMD_INTERNAL_DISPLAY_CHANNEL_PUSHBUFFER: display channel PB */
+static void follow_disp_pb(NvTraceDev *d, const uint8_t *c, uint32_t n)
+{
+    NvtGsp *g = &d->g;
+    uint32_t as, hclass, inst;
+    uint64_t pa, limit;
+    int chn;
+    NvtDispChn *dc;
+
+    if (n < 52) {
+        return;
+    }
+    as = ldl_le_p(c);
+    pa = ldq_le_p(c + 8);
+    limit = ldq_le_p(c + 16);
+    hclass = ldl_le_p(c + 28);
+    inst = ldl_le_p(c + 32);
+    if (!c[36]) {
+        return;                     /* PIO channel: no pushbuffer */
+    }
+    if ((hclass & 0xff) == 0x7d) {
+        chn = 0;
+    } else if ((hclass & 0xff) == 0x7e && inst < NVT_DISP_CHN - 1) {
+        chn = 1 + inst;
+    } else {
+        return;
+    }
+    if (limit >= (1ull << 32)) {
+        return;                     /* implausible; also avoids size 0 */
+    }
+    dc = &g->disp[chn];
+    dc->valid = true;
+    dc->sysmem = as == NV_ADDR_SYSMEM;
+    dc->hclass = hclass;
+    dc->inst = inst;
+    dc->pa = pa;
+    dc->size = MIN(limit + 1, 1 << 20);
+    dc->put = 0;
+    nvtrace_note(d, "disp: channel %d (class 0x%04x inst %u) pushbuffer %s "
+                 "0x%" PRIx64 " size 0x%" PRIx64, chn, hclass, inst,
+                 dc->sysmem ? "sysmem" : as == NV_ADDR_FBMEM ? "vidmem" : "?",
+                 pa, dc->size);
+    if (dc->sysmem) {
+        g_autofree char *label = g_strdup_printf("dispPB:%d", chn);
+
+        nvt_snap(d, pa, dc->size, label);
+    }
+}
+
+/* Guest wrote a display channel PUT: log the new pushbuffer bytes. */
+static void disp_put(NvTraceDev *d, int chn, uint32_t put)
+{
+    NvtDispChn *dc = &d->g.disp[chn];
+    g_autofree char *label = NULL;
+    uint32_t start = dc->put;
+
+    if (!dc->valid) {
+        return;
+    }
+    put %= dc->size;
+    dc->put = put;
+    if (!dc->sysmem || put == start) {
+        return;
+    }
+    label = g_strdup_printf("dispPB:%d@%x", chn, start);
+    if (put > start) {
+        nvt_snap(d, dc->pa + start, put - start, label);
+    } else {                        /* wrapped (JUMP back to 0) */
+        nvt_snap(d, dc->pa + start, dc->size - start, label);
+        if (put) {
+            g_free(label);
+            label = g_strdup_printf("dispPB:%d@0", chn);
+            nvt_snap(d, dc->pa, put, label);
+        }
+    }
+}
+
+/* Called with g->lock held for each logged command-queue RPC. */
+static void gsp_follow(NvTraceDev *d, const uint8_t *rpc, uint32_t len)
+{
+    uint32_t fn, rlen, n;
+    const uint8_t *p = rpc + 32;
+
+    if (!d->follow || len < 32) {
+        return;
+    }
+    rlen = ldl_le_p(rpc + 8);
+    fn = ldl_le_p(rpc + 12);
+    if (rlen < 32) {
+        return;
+    }
+    n = MIN(rlen, len) - 32;
+
+    switch (fn) {
+    case RPC_FN_ALLOC_MEMORY:
+        follow_alloc_memory(d, p, n);
+        break;
+    case RPC_FN_GSP_RM_ALLOC:
+        if (n >= 32) {
+            uint32_t cls = ldl_le_p(p + 12);
+            uint32_t psz = MIN(ldl_le_p(p + 20), n - 32);
+
+            /* Volta+ *_CHANNEL_GPFIFO_* */
+            if ((cls & 0xff) == 0x6f && cls >= 0xc36f && cls <= 0xcfff) {
+                follow_channel(d, ldl_le_p(p), ldl_le_p(p + 8), p + 32, psz);
+            }
+        }
+        break;
+    case RPC_FN_GSP_RM_CONTROL:
+        if (n >= 40 && ldl_le_p(p + 8) == NV_CTRL_DISP_CHN_PB) {
+            follow_disp_pb(d, p + 40, MIN(ldl_le_p(p + 16), n - 40));
+        }
+        break;
+    case RPC_FN_FREE:               /* NVOS00_PARAMETERS: hRoot, hParent, h */
+        if (n >= 12) {
+            watch_remove(d, ldl_le_p(p), ldl_le_p(p + 8));
+        }
+        break;
+    }
+}
+
 typedef struct QEMU_PACKED {
