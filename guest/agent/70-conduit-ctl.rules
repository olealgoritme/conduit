# /dev/virtio-ports/org.conduit.ctl.0: the host control channel, for the
# control agent in the user's desktop session. Group video for logins outside
# a seat, and uaccess so the active local session's user gets it without any
# group. The 70- prefix matters: uaccess must be tagged before 73-seat-late.rules.
SUBSYSTEM=="virtio-ports", ATTR{name}=="org.conduit.ctl.0", GROUP="video", MODE="0660", TAG+="uaccess"
