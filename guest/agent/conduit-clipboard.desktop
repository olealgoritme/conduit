[Desktop Entry]
Type=Application
Name=Conduit clipboard
Comment=Share the clipboard with the Conduit host
Exec=/usr/bin/conduit-clipboard-agent
TryExec=/usr/bin/conduit-clipboard-agent
NoDisplay=true
Terminal=false
X-GNOME-Autostart-Phase=Applications
X-GNOME-AutoRestart=true
X-KDE-autostart-phase=2
