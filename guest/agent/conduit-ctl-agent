# ------------------------------------------------------------------ steam

def parse_vdf(text):
    """Valve's KeyValues text format as nested dicts (quoted strings with
    escapes, braces, // comments)."""
    toks, i, n = [], 0, len(text)
    while i < n:
        c = text[i]
        if c in " \t\r\n":
            i += 1
        elif c == "/" and text[i:i + 2] == "//":
            while i < n and text[i] != "\n":
                i += 1
        elif c == '"':
            i += 1
            buf = []
            while i < n and text[i] != '"':
                if text[i] == "\\" and i + 1 < n:
                    d = text[i + 1]
                    buf.append({"n": "\n", "t": "\t", "\\": "\\", '"': '"'}.get(d, "\\" + d))
                    i += 2
                else:
                    buf.append(text[i])
                    i += 1
            i += 1
            toks.append(("s", "".join(buf)))
        elif c in "{}":
            toks.append((c, c))
            i += 1
        else:
            j = i
            while j < n and text[j] not in ' \t\r\n{}"':
                j += 1
            toks.append(("s", text[i:j]))
            i = j
    pos = 0

    def block():
        nonlocal pos
        d = {}
        while pos < len(toks):
            kind, val = toks[pos]
            if kind == "}":
                pos += 1
                return d
            if kind != "s":
                pos += 1
                continue
            pos += 1
            if pos < len(toks) and toks[pos][0] == "{":
                pos += 1
                d[val] = block()
            elif pos < len(toks) and toks[pos][0] == "s":
                d[val] = toks[pos][1]
                pos += 1
        return d

    return block()


