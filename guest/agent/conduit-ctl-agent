# ------------------------------------------------------------ line framing

class LineReader:
    """Splits a byte stream into lines. A line longer than max_line is dropped
    (reported once as ("oversize", head)) and the reader resyncs at the next
    newline. Lines come out as ("line", bytes)."""

    def __init__(self, max_line=MAX_LINE):
        self.max_line = max_line
        self.buf = bytearray()
        self.skipping = False

    def push(self, data):
        out = []
        while data:
            i = data.find(b"\n")
            if i < 0:
                chunk, data, end = data, b"", False
            else:
                chunk, data, end = data[:i], data[i + 1:], True
            if not self.skipping:
                self.buf += chunk
                if len(self.buf) > self.max_line:
                    out.append(("oversize", bytes(self.buf[:512])))
                    self.buf = bytearray()
                    self.skipping = True
            if end:
                if not self.skipping and self.buf:
                    out.append(("line", bytes(self.buf)))
                self.buf = bytearray()
                self.skipping = False
        return out

    def reset(self):
        self.buf = bytearray()
        self.skipping = False


