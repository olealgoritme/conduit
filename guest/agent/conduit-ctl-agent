def read_environ(path):
    """A /proc/PID/environ as a dict; {} when unreadable."""
    try:
        with open(path, "rb") as f:
            raw = f.read(1 << 20)
    except OSError:
        return {}
    env = {}
    for item in raw.split(b"\0"):
        if b"=" in item:
            k, _, v = item.partition(b"=")
            env[k.decode("utf-8", "replace")] = v.decode("utf-8", "surrogateescape")
    return env


def parse_show_environment(text):
    """`systemctl --user show-environment`: KEY=value lines ($'..' quoting for odd values)."""
    env = {}
    for line in (text or "").splitlines():
        k, sep, v = line.partition("=")
        if not sep or not re.match(r"^[A-Za-z_][A-Za-z0-9_]*$", k):
            continue
        if v.startswith("$'") and v.endswith("'"):
            try:
                v = v[2:-1].encode("latin-1", "backslashreplace").decode("unicode_escape")
            except Exception:
                continue
        env[k] = v
    return env


def parse_props(text):
    """`loginctl show-session -p ..` output: Key=Value lines."""
    props = {}
    for line in (text or "").splitlines():
        k, sep, v = line.partition("=")
        if sep:
            props[k.strip()] = v.strip()
    return props


def children_of(pid, proc="/proc"):
    """Direct children of a process (needs a kernel with task/N/children, else a scan)."""
    kids = []
    try:
        for tid in os.listdir("%s/%s/task" % (proc, pid)):
            try:
                with open("%s/%s/task/%s/children" % (proc, pid, tid)) as f:
                    kids += [int(x) for x in f.read().split()]
            except (OSError, ValueError):
                continue
    except OSError:
        pass
    if kids:
        return kids
    try:
        names = os.listdir(proc)
    except OSError:
        return []
    for n in names:
        if not n.isdigit():
            continue
        try:
            with open("%s/%s/stat" % (proc, n)) as f:
                st = f.read()
            rest = st[st.rindex(")") + 2:].split()
            if int(rest[1]) == int(pid):
                kids.append(int(n))
        except (OSError, ValueError, IndexError):
            continue
    return kids


def descendants(pid, proc="/proc", limit=64, depth=4):
    out, frontier = [], [int(pid)]
    for _ in range(depth):
        nxt = []
        for p in frontier:
            for k in children_of(p, proc):
                if k not in out and len(out) < limit:
                    out.append(k)
                    nxt.append(k)
        frontier = nxt
    return out


def wayland_valid(name, runtime_dir):
    if not name:
        return False
    path = name if os.path.isabs(name) else os.path.join(runtime_dir, name)
    return os.path.exists(path)


def display_valid(disp, x11_dir):
    if not disp:
        return False
    m = re.match(r"^(?P<host>[^:]*):(?P<n>\d+)", disp)
    if not m:
        return False
    if m.group("host") not in ("", "unix"):
        return True
    return os.path.exists(os.path.join(x11_dir, "X" + m.group("n")))


def _merge(env, src, runtime_dir, x11_dir):
    """Copy the keys env still lacks from src; a stale socket name is not taken."""
    for k in IMPORT_KEYS:
        v = src.get(k)
        if not v or env.get(k):
            continue
        if k == "WAYLAND_DISPLAY" and not wayland_valid(v, runtime_dir):
            continue
        if k == "DISPLAY" and not display_valid(v, x11_dir):
            continue
        env[k] = v


def scan_sockets(runtime_dir, x11_dir):
    """What sockets say about the display servers: (wayland name or None, DISPLAY or None)."""
    wl = disp = None
    try:
        names = sorted(n for n in os.listdir(runtime_dir)
                       if re.match(r"^wayland-\d+$", n))
        if names:
            wl = names[0]
    except OSError:
        pass
    try:
        nums = sorted(int(n[1:]) for n in os.listdir(x11_dir)
                      if re.match(r"^X\d+$", n))
        if nums:
            disp = ":%d" % nums[0]
    except OSError:
        pass
    return wl, disp


def discover_session(uid, user, environ=None, proc="/proc", runtime_root="/run/user",
                     x11_dir="/tmp/.X11-unix", run=run_text):
    """Find the user's graphical session. Returns a dict:
    env (session variables), found (a display server is there), user_manager
    (`systemctl --user` answers), source (what found it). `run(argv, env=)` runs
    systemctl/loginctl and returns text or None; the file system roots are
    parameters so tests can use fixtures."""
    environ = os.environ if environ is None else environ
    rt = environ.get("XDG_RUNTIME_DIR") or "%s/%s" % (runtime_root, uid)
    env = {}
    for k in IMPORT_KEYS:
        v = environ.get(k)
        if v:
            env[k] = v
    if env.get("WAYLAND_DISPLAY") and not wayland_valid(env["WAYLAND_DISPLAY"], rt):
        del env["WAYLAND_DISPLAY"]
    if env.get("DISPLAY") and not display_valid(env["DISPLAY"], x11_dir):
        del env["DISPLAY"]
    sources = []

    def graphical():
        return bool(env.get("WAYLAND_DISPLAY") or env.get("DISPLAY"))

    if graphical():
        sources.append("env")

    # The user's systemd manager: the compositor usually imports its environment there.
    sd_env = {"XDG_RUNTIME_DIR": rt}
    bus = environ.get("DBUS_SESSION_BUS_ADDRESS")
    sd_env["DBUS_SESSION_BUS_ADDRESS"] = bus or "unix:path=%s/bus" % rt
    sd_env["PATH"] = environ.get("PATH", "/usr/bin:/bin")
    out = run(["systemctl", "--user", "show-environment"], env=sd_env)
    user_manager = out is not None
    if out:
        had = graphical()
        _merge(env, parse_show_environment(out), rt, x11_dir)
        if graphical() and not had:
            sources.append("systemd")

    # logind: the user's sessions, their leader and the leader's children.
    if not graphical():
        listing = run(["loginctl", "list-sessions", "--no-legend"],
                      env=sd_env) or ""
        cands = []
        for line in listing.splitlines():
            parts = line.split()
            if len(parts) < 2 or parts[1] != str(uid):
                continue
            props = parse_props(run(
                ["loginctl", "show-session", parts[0], "-p", "Type", "-p", "Leader",
                 "-p", "Display", "-p", "State", "-p", "Active", "-p", "Class",
                 "-p", "Name"], env=sd_env))
            if props.get("Class") not in ("user", None, ""):
                continue
            if props.get("Type") not in ("wayland", "x11", "mir"):
                continue
            if props.get("Name") and props["Name"] != user:
                continue
            rank = (0 if props.get("Active") == "yes" else 1,
                    0 if props.get("State") == "active" else 1)
            cands.append((rank, parts[0], props))
        cands.sort(key=lambda c: c[0])
        for _, sid, props in cands:
            pids = []
            try:
                leader = int(props.get("Leader", "0"))
            except ValueError:
                leader = 0
            if leader > 1:
                pids = [leader] + descendants(leader, proc)
            for p in pids:
                _merge(env, read_environ("%s/%s/environ" % (proc, p)), rt, x11_dir)
            d = props.get("Display")
            if d and not env.get("DISPLAY") and display_valid(d, x11_dir):
                env["DISPLAY"] = d
            if props.get("Type") in ("wayland", "x11") and not env.get("XDG_SESSION_TYPE"):
                env["XDG_SESSION_TYPE"] = props["Type"]
            if graphical():
                sources.append("loginctl")
                break

    # A process of the user that looks like a compositor or desktop shell.
    if not graphical():
        try:
            pids = sorted(int(n) for n in os.listdir(proc) if n.isdigit())
        except OSError:
            pids = []
        mine = []
        for p in pids:
            try:
                if os.stat("%s/%d" % (proc, p)).st_uid != uid:
                    continue
            except OSError:
                continue
            mine.append(p)
        known, others = [], []
        for p in mine:
            try:
                with open("%s/%d/comm" % (proc, p)) as f:
                    comm = f.read().strip()
            except OSError:
                continue
            (known if comm in COMPOSITORS else others).append(p)
        for p in known + others[:300]:
            _merge(env, read_environ("%s/%d/environ" % (proc, p)), rt, x11_dir)
            if graphical():
                sources.append("proc")
                break

    # Sockets in the runtime dir and /tmp/.X11-unix.
    if not graphical():
        wl, disp = scan_sockets(rt, x11_dir)
        if wl:
            env["WAYLAND_DISPLAY"] = wl
        if disp:
            env["DISPLAY"] = disp
        if graphical():
            sources.append("sockets")

    env["XDG_RUNTIME_DIR"] = rt
    if not env.get("DBUS_SESSION_BUS_ADDRESS"):
        env["DBUS_SESSION_BUS_ADDRESS"] = "unix:path=%s/bus" % rt
    if env.get("XDG_SESSION_TYPE") is None:
        if env.get("WAYLAND_DISPLAY"):
            env["XDG_SESSION_TYPE"] = "wayland"
        elif env.get("DISPLAY"):
            env["XDG_SESSION_TYPE"] = "x11"
    return {"env": env, "found": graphical(), "user_manager": user_manager,
            "source": ",".join(sources)}


class SessionCache:
    """discover_session with a short TTL; invalidate() after a failure."""

    def __init__(self, discover, ttl_found=30.0, ttl_missing=2.0):
        self.discover = discover
        self.ttl_found = ttl_found
        self.ttl_missing = ttl_missing
        self.lock = threading.Lock()
        self.value = None
        self.at = 0.0

    def get(self, force=False):
        with self.lock:
            ttl = self.ttl_found if self.value and self.value["found"] else self.ttl_missing
            if force or self.value is None or time.monotonic() - self.at > ttl:
                try:
                    self.value = self.discover()
                except Exception:
                    log("session discovery failed:\n" + traceback.format_exc())
                    if self.value is None:
                        self.value = {"env": {}, "found": False,
                                      "user_manager": False, "source": ""}
                self.at = time.monotonic()
            return self.value

    def invalidate(self):
        with self.lock:
            self.at = 0.0
            self.value = None


# ------------------------------------------------------ .desktop entries

def unescape_value(s):
    out, i = [], 0
    while i < len(s):
        c = s[i]
        if c == "\\" and i + 1 < len(s):
            d = s[i + 1]
            m = {"s": " ", "n": "\n", "t": "\t", "r": "\r", "\\": "\\"}.get(d)
            if m is not None:
                out.append(m)
                i += 2
                continue
        out.append(c)
        i += 1
    return "".join(out)


def parse_desktop(text):
    """The [Desktop Entry] group of a .desktop file as {key: raw value}."""
    entry, inside = {}, False
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("["):
            if inside:
                break
            inside = line == "[Desktop Entry]"
            continue
        if inside and "=" in line:
            k, _, v = line.partition("=")
            entry[k.strip()] = v.strip()
    return entry


def read_desktop(path):
    try:
        with open(path, "rb") as f:
            return parse_desktop(f.read(1 << 20).decode("utf-8", "replace"))
    except OSError:
        return None


def locale_candidates(env):
    """The locale names to try for Name[xx], most specific first."""
    langs = []
    for v in (env.get("LANGUAGE", "").split(":") if env.get("LC_ALL") is None else []):
        if v:
            langs.append(v)
    for k in ("LC_ALL", "LC_MESSAGES", "LANG"):
        if env.get(k):
            langs.append(env[k])
            break
    out = []
    for l in langs:
        l, _, mod = l.partition("@")
        l = l.split(".")[0]
        mod = "@" + mod if mod else ""
        l += mod
        if l in ("C", "POSIX", ""):
            continue
        l, _, mod = l.partition("@")
        lang, _, country = l.partition("_")
        for c in ((lang + "_" + country + "@" + mod) if country and mod else None,
                  (lang + "_" + country) if country else None,
                  (lang + "@" + mod) if mod else None, lang):
            if c and c not in out:
                out.append(c)
    return out


def localized(entry, key, locales):
    for l in locales:
        v = entry.get("%s[%s]" % (key, l))
        if v:
            return unescape_value(v)
    v = entry.get(key)
    return unescape_value(v) if v else ""


def split_exec(s):
    """An Exec value split into arguments per the Desktop Entry spec (quotes,
    backslash escapes inside quotes); quotes inside a word are accepted too."""
    s = unescape_value(s)
    args, cur, in_arg, q, i = [], [], False, False, 0
    while i < len(s):
        c = s[i]
        if q:
            if c == "\\" and i + 1 < len(s) and s[i + 1] in '"`$\\':
                cur.append(s[i + 1])
                i += 2
                continue
            if c == '"':
                q = False
            else:
                cur.append(c)
        elif c == '"':
            q, in_arg = True, True
        elif c in " \t\n":
            if in_arg:
                args.append("".join(cur))
                cur, in_arg = [], False
        else:
            cur.append(c)
            in_arg = True
        i += 1
    if in_arg:
        args.append("".join(cur))
    return args


FILE_CODES = "fFuU"


def exec_takes_files(args):
    return any(re.search(r"%[fFuU]", a.replace("%%", "")) for a in args)


def expand_exec(args, name="", icon="", path="", files=()):
    """Field codes: %f %u (first file), %F %U (all files), %i (--icon X), %c
    (Name), %k (the .desktop path), %% ; deprecated %d %D %n %N %v %m vanish."""
    files = list(files)
    out = []
    for a in args:
        if a in ("%F", "%U"):
            out.extend(files)
            continue
        if a == "%i":
            if icon:
                out.extend(["--icon", icon])
            continue
        res, i, coded = [], 0, False
        while i < len(a):
            c = a[i]
            if c == "%" and i + 1 < len(a):
                d = a[i + 1]
                i += 2
                if d == "%":
                    res.append("%")
                    continue
                coded = True
                if d in "fu":
                    res.append(files[0] if files else "")
                elif d in "FU":
                    res.append(" ".join(files))
                elif d == "c":
                    res.append(name)
                elif d == "k":
                    res.append(path)
            else:
                res.append(c)
                i += 1
        s = "".join(res)
        if s or not coded:
            out.append(s)
    return out


