# Shared branding. Plain printable ASCII, no quotes or backslashes.
# After editing, run: python3 tools/sync-metadata.py
# Release version remains in kmd_render/driver-version.env.
HELIOS_PRODUCT=Conduit Helios
# The EDID monitor name has room for 12 bytes, which the product name no longer
# fits; this is what the virtual monitor calls itself.
HELIOS_MONITOR_NAME=Conduit GPU
HELIOS_PUBLISHER=WinBoat
HELIOS_KMD_ROLE=WDDM Render and Display Driver
HELIOS_UMD_ROLE=Direct3D 11 User-Mode Driver
HELIOS_UMD12_ROLE=Direct3D 12 User-Mode Driver
HELIOS_ADL_ROLE=ADL Compatibility Adapter
HELIOS_MONITOR_MODEL_YEAR=2026
