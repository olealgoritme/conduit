diff --git a/src/virtio/vulkan/test_helios_lost.c b/src/virtio/vulkan/test_helios_lost.c
new file mode 100644
index 00000000000..5d6378eb98a
--- /dev/null
+++ b/src/virtio/vulkan/test_helios_lost.c
@@ -0,0 +1,199 @@
+/* Unit test for vn_renderer_helios_lost.h (Windows, user mode only).
+ *
+ * A pagefile-backed section view stands in for a KMD MAP_BLOB view: it is
+ * unmapped under the process the way DxgkDdiDestroyDevice unmaps the KMD's
+ * views when the driver stops, while threads keep using it the way the ring
+ * writer does.
+ *
+ * Build: x86_64-w64-mingw32-gcc -O2 -o test_helios_lost.exe test_helios_lost.c
+ *        (or i686-w64-mingw32-gcc for the WoW64 ICD)
+ */
+#include <stdio.h>
+#include <string.h>
+#include <windows.h>
+
+static volatile LONG log_lines;
+#define HELIOS_LOST_LOG(...)                                                  \
+   do {                                                                       \
+      InterlockedIncrement(&log_lines);                                       \
+      fprintf(stderr, "  log: ");                                             \
+      fprintf(stderr, __VA_ARGS__);                                           \
+      fputc('\n', stderr);                                                    \
+   } while (0)
+#include "vn_renderer_helios_lost.h"
+
+static int failures;
+#define CHECK(cond)                                                           \
+   do {                                                                       \
+      if (!(cond)) {                                                          \
+         fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond);      \
+         failures++;                                                          \
+      }                                                                       \
+   } while (0)
+
+struct view {
+   HANDLE section;
+   volatile uint32_t *va;
+   size_t size;
+};
+
+static struct view
+view_map(size_t size)
+{
+   struct view v = { 0 };
+   v.size = size;
+   v.section = CreateFileMappingW(INVALID_HANDLE_VALUE, NULL, PAGE_READWRITE,
+                                  0, (DWORD)size, NULL);
+   v.va = MapViewOfFile(v.section, FILE_MAP_ALL_ACCESS, 0, 0, size);
+   return v;
+}
+
+static void
+view_unmap(struct view *v)
+{
+   UnmapViewOfFile((void *)v->va);
+   CloseHandle(v->section);
+}
+
+static DWORD
+state_of(const volatile void *p)
+{
+   MEMORY_BASIC_INFORMATION mbi;
+   if (!VirtualQuery((const void *)p, &mbi, sizeof(mbi)))
+      return 0;
+   return mbi.State == MEM_COMMIT ? (mbi.Type << 1 | 1) : mbi.State;
+}
+
+/* A ring writer: reads head, copies a packet into the buffer, stores tail,
+ * until the owner is lost. */
+struct writer {
+   volatile uint32_t *shared;
+   size_t size;
+   volatile LONG *owner;
+   volatile LONG running;
+   LONG iterations_after_loss;
+};
+
+static DWORD WINAPI
+writer_main(void *arg)
+{
+   struct writer *w = arg;
+   uint8_t packet[256];
+   memset(packet, 0xab, sizeof(packet));
+   uint32_t cur = 0;
+   InterlockedExchange(&w->running, 1);
+   for (;;) {
+      if (helios_lost_is_set(w->owner)) {
+         /* What the ICD does after the latch: no more real touches, but a
+          * straggler touch must still be safe. */
+         (void)w->shared[0];
+         w->iterations_after_loss++;
+         break;
+      }
+      const uint32_t head = w->shared[0];
+      const uint32_t off = 64 + (cur % (uint32_t)(w->size - 64 - sizeof(packet)));
+      memcpy((uint8_t *)w->shared + off, packet, sizeof(packet));
+      cur += sizeof(packet) + (head & 1);
+      w->shared[1] = cur;
+   }
+   return 0;
+}
+
+int
+main(void)
+{
+   CHECK(helios_lost_init());
+   volatile LONG lost_a = 0, lost_b = 0;
+
+   /* 1. A view unmapped under a thread that keeps writing to it. */
+   {
+      struct view ring = view_map(1 << 20);
+      struct view other = view_map(256 << 10); /* same owner, never touched */
+      struct view kept = view_map(64 << 10);   /* same owner, still mapped */
+      CHECK(ring.va && other.va && kept.va);
+      kept.va[0] = 0x1234;
+      helios_lost_register(&lost_a, (void *)ring.va, ring.size);
+      helios_lost_register(&lost_a, (void *)other.va, other.size);
+      helios_lost_register(&lost_a, (void *)kept.va, kept.size);
+
+      struct writer w = { ring.va, ring.size, &lost_a, 0, 0 };
+      HANDLE threads[4];
+      struct writer ws[4];
+      for (int i = 0; i < 4; i++) {
+         ws[i] = w;
+         threads[i] = CreateThread(NULL, 0, writer_main, &ws[i], 0, NULL);
+      }
+      for (int i = 0; i < 4; i++)
+         while (!ws[i].running)
+            Sleep(1);
+      Sleep(50);
+      view_unmap(&ring);  /* the KMD stop */
+      view_unmap(&other);
+      CHECK(WaitForMultipleObjects(4, threads, TRUE, 5000) == WAIT_OBJECT_0);
+      for (int i = 0; i < 4; i++) {
+         CHECK(ws[i].iterations_after_loss == 1);
+         CloseHandle(threads[i]);
+      }
+      CHECK(helios_lost_is_set(&lost_a));
+      CHECK(!helios_lost_is_set(&lost_b));
+      /* both freed ranges are ours now, the mapped one is untouched */
+      CHECK(state_of(ring.va) == (MEM_PRIVATE << 1 | 1));
+      CHECK(state_of(other.va) == (MEM_PRIVATE << 1 | 1));
+      CHECK(state_of(kept.va) == (MEM_MAPPED << 1 | 1));
+      CHECK(kept.va[0] == 0x1234);
+      CHECK(helios_lost.repairs == 2);
+
+      /* unregistering frees our backing */
+      helios_lost_unregister((void *)ring.va);
+      CHECK(state_of(ring.va) == MEM_FREE);
+      helios_lost_unregister_owner(&lost_a);
+      CHECK(state_of(other.va) == MEM_FREE);
+      CHECK(state_of(kept.va) == (MEM_MAPPED << 1 | 1));
+      CHECK(helios_lost.count == 0);
+      view_unmap(&kept);
+   }
+
+   /* 2. Faults outside registered ranges are left alone. */
+   {
+      CHECK(IsBadReadPtr((void *)(uintptr_t)0x10, 4));
+      CHECK(!helios_lost_is_set(&lost_b));
+   }
+
+   /* 3. A freed range something else took is not claimed. */
+   {
+      struct view v = view_map(64 << 10);
+      helios_lost_register(&lost_b, (void *)v.va, v.size);
+      void *base = (void *)v.va;
+      view_unmap(&v);
+      void *squat = VirtualAlloc(base, 64 << 10, MEM_RESERVE, PAGE_NOACCESS);
+      CHECK(squat == base);
+      CHECK(IsBadReadPtr(base, 4)); /* still faults, handler declined */
+      CHECK(!helios_lost_is_set(&lost_b));
+      VirtualFree(squat, 0, MEM_RELEASE);
+      helios_lost_unregister(base);
+   }
+
+   /* 4. A D3DKMT "device gone" latch backs freed ranges before any touch. */
+   {
+      struct view v = view_map(128 << 10);
+      helios_lost_register(&lost_b, (void *)v.va, v.size);
+      volatile uint32_t *p = v.va;
+      view_unmap(&v);
+      CHECK(helios_lost_status_is_device_gone((LONG)0xC00002B6));
+      CHECK(!helios_lost_status_is_device_gone((LONG)0xC0000002));
+      helios_lost_mark(&lost_b);
+      CHECK(helios_lost_is_set(&lost_b));
+      CHECK(state_of(p) == (MEM_PRIVATE << 1 | 1));
+      CHECK(p[7] == 0);
+      helios_lost_unregister_owner(&lost_b);
+      CHECK(state_of(p) == MEM_FREE);
+   }
+
+   helios_lost_fini();
+   CHECK(helios_lost.veh == NULL);
+
+   printf("%s (%d failures, %ld log lines, %ld repairs)\n",
+          failures ? "FAILED" : "PASSED", failures, log_lines,
+          helios_lost.repairs);
+   return failures ? 1 : 0;
+}
