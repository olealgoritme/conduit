+/* BEGIN helios-batch ------------------------------------------------------- */
+
+/* Process-wide counters (interlocked: the flusher thread and submitters race). */
+static volatile LONG helios_batch_flushes;  /* batch escapes issued */
+static volatile LONG helios_batch_entries;  /* entries they carried */
+static volatile LONG helios_batch_direct;   /* submits sent directly while batching is on */
+static volatile LONG helios_batch_max_seen; /* largest batch */
+
+static bool
+helios_batch_can_defer(const struct helios *helios,
+                       const struct vn_renderer_submit_batch *batch)
+{
+   return helios->batch_enabled && !helios->batch_lost && batch->cs_size > 0 &&
+          batch->cs_size <= HELIOS_BATCH_CS_MAX && batch->sync_count >= 1 &&
+          batch->sync_count <= HELIOS_BATCH_SYNCS_MAX &&
+          !batch->present_value32 && !batch->present_cookie;
+}
+
+/* Send the queue as one escape and resolve every deferred fence id. Caller holds
+ * dev_mutex. Returns false (and latches batch_lost) if the escape failed. */
+static bool
+helios_flush_locked(struct helios *helios)
+{
+   const uint32_t n = helios->batch_count;
+   if (!n)
+      return true;
+
+   const size_t head_size = sizeof(struct helios_escape_submit_venus_batch);
+   const size_t entry_size = sizeof(struct helios_submit_batch_entry);
+   const size_t table_size = (size_t)n * entry_size;
+   const size_t total = head_size + table_size + helios->batch_bytes;
+   uint8_t *buf = helios->batch_escape;
+
+   struct helios_escape_submit_venus_batch head = { 0 };
+   helios_hdr_init(&head.hdr, HELIOS_ESCAPE_SUBMIT_VENUS_BATCH,
+                   (uint32_t)(head_size + table_size));
+   head.count = n;
+   memcpy(buf, &head, head_size);
+   for (uint32_t i = 0; i < n; i++) {
+      struct helios_submit_batch_entry t = { 0 };
+      t.ctx_id = helios->ctx_id;
+      t.ring_idx = helios->batch_entries[i].ring_idx;
+      t.buffer_size = helios->batch_entries[i].size;
+      memcpy(buf + head_size + i * entry_size, &t, entry_size);
+   }
+   memcpy(buf + head_size + table_size, helios->batch_streams,
+          helios->batch_bytes);
+
+   const bool ok = helios_escape_raw(helios, buf, (uint32_t)total,
+                                     helios_escape_hw_forced());
+
+   /* Detach the queue BEFORE resolving it: resolution takes other locks and must
+    * never find a non-empty queue (it would flush again). The entries stay in
+    * the array until the next enqueue, which needs the dev_mutex we hold. */
+   helios->batch_count = 0;
+   helios->batch_bytes = 0;
+
+   for (uint32_t i = 0; i < n; i++) {
+      struct helios_submit_batch_entry t = { 0 };
+      if (ok)
+         memcpy(&t, buf + head_size + i * entry_size, entry_size);
+      const bool good = ok && t.out_status == 0 && t.fence_id != 0;
+      struct helios_batch_entry *e = &helios->batch_entries[i];
+
+      for (uint32_t s = 0; s < e->sync_count; s++) {
+         struct helios_sync *sync = e->syncs[s].sync;
+         for (uint32_t p = 0; p < sync->pending_count; p++) {
+            if (sync->pending[p].fence_id != e->placeholder)
+               continue;
+            if (good)
+               sync->pending[p].fence_id = t.fence_id;
+            else
+               sync->pending[p].complete = true; /* never strand a waiter */
+         }
+         if (good && sync->wddm_local)
+            (void)helios_retire_enqueue_locked(helios, sync, t.fence_id);
+         if (helios_sync_unref_locked(&helios->base, sync))
+            free(sync);
+      }
+      if (!good)
+         helios->batch_lost = true;
+   }
+
+   if (ok) {
+      const LONG flushes = InterlockedIncrement(&helios_batch_flushes);
+      InterlockedExchangeAdd(&helios_batch_entries, (LONG)n);
+      if ((LONG)n > helios_batch_max_seen)
+         helios_batch_max_seen = (LONG)n;
+      if ((flushes & 0x1FFF) == 0)
+         helios_diag("submit-batch: flushes=%ld entries=%ld direct=%ld max=%ld",
+                     (long)flushes, (long)helios_batch_entries,
+                     (long)helios_batch_direct, (long)helios_batch_max_seen);
+   } else {
+      helios_diag("submit-batch: flush of %u entries FAILED — renderer lost", n);
+   }
+   return ok && !helios->batch_lost;
+}
+
+/* Flush from a context that may or may not hold dev_mutex (the escape wrapper,
+ * the flusher thread). Unlocked fast path: nothing queued. */
+static void
+helios_flush_deferred(struct helios *helios)
+{
+   if (!helios->batch_count)
+      return;
+   if (helios_dev_owned(helios)) {
+      (void)helios_flush_locked(helios);
+      return;
+   }
+   helios_dev_lock(helios); /* flushes on acquire */
+   helios_dev_unlock(helios);
+}
+
+/* ops.submit, under dev_mutex: flush on the entry cap or the age bound (the
+ * flusher thread covers the case where no further submit arrives). */
+static void
+helios_batch_maybe_flush_locked(struct helios *helios)
+{
+   if (!helios->batch_count)
+      return;
+   if (helios->batch_count >= helios->batch_max_entries) {
+      (void)helios_flush_locked(helios);
+      return;
+   }
+   LARGE_INTEGER now;
+   QueryPerformanceCounter(&now);
+   if (now.QuadPart - helios->batch_first_qpc >= helios->batch_age_qpc)
+      (void)helios_flush_locked(helios);
+}
+
+/* Queue one deferrable submit; `*out_placeholder` receives the lazy fence id its
+ * syncs are appended with. Caller holds dev_mutex and has checked
+ * helios_batch_can_defer. */
+static bool
+helios_batch_queue_locked(struct helios *helios,
+                          const struct vn_renderer_submit_batch *batch,
+                          uint64_t *out_placeholder)
+{
+   if (helios->batch_count >= helios->batch_max_entries &&
+       !helios_flush_locked(helios))
+      return false;
+
+   struct helios_batch_entry *e = &helios->batch_entries[helios->batch_count];
+   memcpy(helios->batch_streams + helios->batch_bytes, batch->cs_data,
+          batch->cs_size);
+   e->ring_idx = batch->ring_idx;
+   e->size = (uint32_t)batch->cs_size;
+   e->placeholder = HELIOS_BATCH_LAZY_FENCE | ++helios->next_fence_id;
+   e->sync_count = 0;
+
+   if (!helios->batch_count) {
+      LARGE_INTEGER now;
+      QueryPerformanceCounter(&now);
+      helios->batch_first_qpc = now.QuadPart;
+      SetEvent(helios->batch_event); /* arm the flusher */
+   }
+   helios->batch_bytes += (uint32_t)batch->cs_size;
+   helios->batch_count++;
+   *out_placeholder = e->placeholder;
+   return true;
+}
+
+/* The entry owns a reference on each sync until flush resolves it. */
+static void
+helios_batch_record_sync(struct helios_batch_entry *e,
+                         struct helios_sync *sync,
+                         uint64_t value)
+{
+   assert(e->sync_count < HELIOS_BATCH_SYNCS_MAX);
+   e->syncs[e->sync_count].sync = sync;
+   e->syncs[e->sync_count].value = value;
+   e->sync_count++;
+   sync->refs++;
+}
+
+/* Flusher: HELIOS_SUBMIT_BATCH_US after the queue became non-empty, flush it.
+ * The queue is otherwise flushed by the next submit, wait, sync op or escape;
+ * this bounds how long a signal can sit when the app goes quiet. */
+static int
+helios_batch_flusher(void *arg)
+{
+   struct helios *helios = arg;
+   HANDLE armed[2] = { helios->batch_stop_event, helios->batch_event };
+   HANDLE aged[2] = { helios->batch_stop_event, helios->batch_timer };
+   for (;;) {
+      if (WaitForMultipleObjects(2, armed, FALSE, INFINITE) == WAIT_OBJECT_0)
+         break;
+      LARGE_INTEGER due;
+      due.QuadPart = -(LONGLONG)helios->batch_age_us * 10; /* 100 ns units */
+      if (SetWaitableTimer(helios->batch_timer, &due, 0, NULL, NULL, FALSE)) {
+         if (WaitForMultipleObjects(2, aged, FALSE, INFINITE) == WAIT_OBJECT_0)
+            break;
+      } else {
+         Sleep(1);
+      }
+      helios_flush_deferred(helios);
+   }
+   return 0;
+}
+
+static uint32_t
+helios_env_u32(const char *name, uint32_t def, uint32_t lo, uint32_t hi)
+{
+   char v[16];
+   if (!GetEnvironmentVariableA(name, v, sizeof(v)) || !v[0])
+      return def;
+   const unsigned long parsed = strtoul(v, NULL, 10);
+   return parsed < lo ? lo : parsed > hi ? hi : (uint32_t)parsed;
+}
+
+/* Capability probe (count == 0): an up-to-date KMD answers STATUS_SUCCESS, an
+ * older one rejects the unknown verb. Quiet, like helios_probe_fence_events. */
+static void
+helios_batch_init(struct helios *helios)
+{
+   char v[16];
+   if (!GetEnvironmentVariableA("HELIOS_SUBMIT_BATCH", v, sizeof(v)) || !v[0] ||
+       v[0] == '0')
+      return; /* default OFF: DWM and every other process keep today's path */
+
+   struct helios_escape_submit_venus_batch probe = { 0 };
+   helios_hdr_init(&probe.hdr, HELIOS_ESCAPE_SUBMIT_VENUS_BATCH, sizeof(probe));
+
+   D3DKMT_ESCAPE esc;
+   memset(&esc, 0, sizeof(esc));
