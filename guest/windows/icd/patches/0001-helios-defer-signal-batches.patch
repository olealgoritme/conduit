+   helios->batch_event = CreateEventW(NULL, FALSE, FALSE, NULL);
+   helios->batch_stop_event = CreateEventW(NULL, TRUE, FALSE, NULL);
+   /* High-resolution timer (Windows 10 1803+); the ordinary timer otherwise. */
+   helios->batch_timer =
+      CreateWaitableTimerExW(NULL, NULL, 0x00000002 /* HIGH_RESOLUTION */,
+                             TIMER_ALL_ACCESS);
+   if (!helios->batch_timer)
+      helios->batch_timer = CreateWaitableTimerW(NULL, FALSE, NULL);
+   if (!helios->batch_event || !helios->batch_stop_event || !helios->batch_timer ||
+       u_thread_create(&helios->batch_thread, helios_batch_flusher, helios) !=
+          thrd_success) {
+      helios_diag("submit-batch: flusher setup FAILED — off");
+      if (helios->batch_event) CloseHandle(helios->batch_event);
+      if (helios->batch_stop_event) CloseHandle(helios->batch_stop_event);
+      if (helios->batch_timer) CloseHandle(helios->batch_timer);
+      helios->batch_event = helios->batch_stop_event = helios->batch_timer = NULL;
+      return;
+   }
+   helios->batch_thread_live = true;
+   helios->batch_enabled = true;
+   helios_diag("submit-batch: ON max_entries=%u age=%uus (cs<=%u bytes, with syncs)",
+               helios->batch_max_entries, helios->batch_age_us,
+               HELIOS_BATCH_CS_MAX);
+}
