+static void
+helios_batch_fini(struct helios *helios)
+{
+   if (!helios->batch_enabled)
+      return;
+   helios_flush_deferred(helios); /* escapes still work here */
+   helios->batch_enabled = false;
+   SetEvent(helios->batch_stop_event);
+   if (helios->batch_thread_live)
+      thrd_join(helios->batch_thread, NULL);
+   helios->batch_thread_live = false;
+   CloseHandle(helios->batch_event);
+   CloseHandle(helios->batch_stop_event);
+   CloseHandle(helios->batch_timer);
+   helios->batch_event = helios->batch_stop_event = helios->batch_timer = NULL;
+   helios_diag("submit-batch: final flushes=%ld entries=%ld direct=%ld max=%ld",
+               (long)helios_batch_flushes, (long)helios_batch_entries,
+               (long)helios_batch_direct, (long)helios_batch_max_seen);
+}
