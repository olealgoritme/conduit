+/* ── Deferred SUBMIT_VENUS batching (HELIOS_SUBMIT_BATCH=1, default OFF) ────────
+ *
+ * What is deferred, and why that is safe: ONLY a small submit (cs <= 256 bytes)
+ * that carries at least one sync — in practice vn_signal_win32_external_semaphore
+ * and vn_create_sync_file, a `vkWaitRingSeqnoMESA` waiter plus a semaphore to
+ * signal. It carries no GPU work (that went through the shared ring) so delaying
+ * it cannot reorder execution; it can only delay WHEN a semaphore signals, by at
+ * most the flush bound. A submit without syncs (a ring notify — latency
+ * sensitive), a present-tagged submit, or anything larger goes out directly,
+ * after flushing the queue so submission order is the call order.
+ *
+ * The queue is flushed as ONE HELIOS_ESCAPE_SUBMIT_VENUS_BATCH: by every
+ * dev_mutex acquisition except ops.submit's own (see helios_dev_lock — this is
+ * the invariant that makes the rest safe: nobody but a submitter ever sees
+ * unflushed state), before any other escape, when the entry/byte cap is hit,
+ * and by a flusher thread HELIOS_SUBMIT_BATCH_US after the queue became
+ * non-empty.
+ *
+ * Fence ids: a deferred entry's syncs are appended to immediately with a
+ * LAZY placeholder fence id (high bit set); flush patches them to the KMD's wire
+ * fence id in place and hands shared (WDDM) syncs to the retire thread then.
+ * Everything below is protected by dev_mutex. */
+#define HELIOS_BATCH_SYNCS_MAX 4
+#define HELIOS_BATCH_CS_MAX 256u
+#define HELIOS_BATCH_LAZY_FENCE (1ull << 63)
+
+struct helios_batch_entry {
+   uint32_t ring_idx;
+   uint32_t size;
+   uint64_t placeholder;
+   uint32_t sync_count;
+   struct {
+      struct helios_sync *sync;
+      uint64_t value;
+   } syncs[HELIOS_BATCH_SYNCS_MAX];
+};
+
