 };
 
+/* dev_mutex with owner tracking. mtx_plain is not recursive, and the flush has
+ * to know whether its caller already holds the lock.
+ *
+ * helios_dev_lock FLUSHES any deferred batch on acquire. ops.submit alone takes
+ * helios_dev_lock_nf (no flush) — it is the only producer of deferred entries. */
+static bool helios_flush_locked(struct helios *helios);
+
+static inline void
+helios_dev_lock_nf(struct helios *helios)
+{
+   mtx_lock(&helios->dev_mutex);
+   helios->dev_owner = GetCurrentThreadId();
+}
+
+static inline void
+helios_dev_lock(struct helios *helios)
+{
+   helios_dev_lock_nf(helios);
+   if (helios->batch_count)
+      (void)helios_flush_locked(helios);
+}
+
+static inline void
+helios_dev_unlock(struct helios *helios)
+{
+   helios->dev_owner = 0;
+   mtx_unlock(&helios->dev_mutex);
+}
+
+static inline bool
+helios_dev_owned(const struct helios *helios)
+{
+   return helios->dev_owner == GetCurrentThreadId();
+}
