+   helios->batch_max_entries =
+      helios_env_u32("HELIOS_SUBMIT_BATCH_MAX", 16, 2, HELIOS_SUBMIT_BATCH_MAX_ENTRIES);
+   helios->batch_age_us = helios_env_u32("HELIOS_SUBMIT_BATCH_US", 300, 50, 5000);
