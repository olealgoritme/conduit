+/* HELIOS_ESCAPE_SUBMIT_VENUS_BATCH (KMD 22.22.300.0+, protocol/src/escape.rs):
+ * N submissions in one escape. Buffer = head | entry[count] | streams. Each
+ * entry is what one SUBMIT_VENUS would have carried; the KMD runs them in order
+ * as separate fenced SUBMIT_3Ds. count == 0 is a capability probe. */
+#define HELIOS_SUBMIT_BATCH_MAX_ENTRIES 64u
+struct helios_escape_submit_venus_batch {
+   struct helios_escape_header hdr;
+   uint32_t count;
+   uint32_t flags; /* zero */
+};
+
+struct helios_submit_batch_entry {
+   uint64_t fence_id; /* out: KMD wire fence id */
+   uint32_t ctx_id;
+   uint32_t ring_idx;
+   uint32_t buffer_size;
+   uint32_t present_value32; /* zero: never deferred */
+   int32_t out_status;       /* out: 0 or the entry's NTSTATUS */
+   uint32_t reserved;
+};
+
 struct helios_escape_present_stream {
    struct helios_escape_header hdr;
    uint64_t cookie; /* out on REGISTER; exact in on UNREGISTER */
