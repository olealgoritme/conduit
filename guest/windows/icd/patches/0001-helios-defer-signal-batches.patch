+   uint32_t batch_max_entries;
+   uint32_t batch_age_us;
+   int64_t batch_age_qpc;
+   volatile uint32_t batch_count; /* read unlocked as a fast path only */
+   uint32_t batch_bytes;
+   int64_t batch_first_qpc;
+   struct helios_batch_entry batch_entries[HELIOS_SUBMIT_BATCH_MAX_ENTRIES];
+   uint8_t batch_streams[HELIOS_SUBMIT_BATCH_MAX_ENTRIES * HELIOS_BATCH_CS_MAX];
+   uint8_t batch_escape[sizeof(struct helios_escape_submit_venus_batch) +
+                        HELIOS_SUBMIT_BATCH_MAX_ENTRIES *
+                           sizeof(struct helios_submit_batch_entry) +
+                        HELIOS_SUBMIT_BATCH_MAX_ENTRIES * HELIOS_BATCH_CS_MAX];
+   HANDLE batch_event;      /* auto-reset: queue became non-empty */
+   HANDLE batch_stop_event; /* manual-reset: flusher stop */
