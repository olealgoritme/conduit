index 790febcd6f6..00000000000
--- a/src/virtio/vulkan/vn_renderer_helios_lost.h
+++ /dev/null
@@ -1,304 +0,0 @@
-/* Helios device loss: KMD-mapped memory that vanishes under a live process.
- *
- * The ring, the cs/reply shmems, mapped bos and the producer status page are
- * user mappings the KMD makes itself (MAP_BLOB -> MmMapLockedPagesSpecifyCache
- * into this process). When the KMD stops under live processes (a live driver
- * update, a device reset), dxgkrnl destroys every device and the KMD's
- * DxgkDdiDestroyDevice unmaps those views in the owning process. The ICD does
- * not hear about it until its next escape fails, and the ring hot path makes no
- * escape at all: the next ring write reads ring->shared.head from a freed VA and
- * the process takes an access violation (dwm.exe, explorer.exe and
- * ApplicationFrameHost.exe at vulkan_virtio.dll+0x3858c4, vn_ring_submit_locked,
- * at every live driver swap).
- *
- * dxgkrnl itself keeps D3D CPU mappings valid across a device removal by
- * pointing them at a dummy page. This file does the same for the KMD's own
- * mappings, from user mode:
- *
- *  - every KMD-made mapping is registered here (base, size, owning renderer);
- *  - a vectored exception handler catches an access violation inside a
- *    registered range whose VA is now free, commits zeroed private memory at
- *    exactly that range, latches the owning renderer lost and resumes the
- *    faulting instruction, which now reads zeros;
- *  - the same latch also reserves every other registered range of that
- *    renderer that is already free, so nothing else in the process can be
- *    handed those addresses while the ICD still holds pointers into them;
- *  - a D3DKMT failure that says the device is gone latches the renderer lost
- *    the same way, before any mapped memory is touched again.
- *
- * Once lost, the ring reports FATAL without reading shared memory, waits and
- * submits return VK_ERROR_DEVICE_LOST, and the client takes its normal
- * device-lost path. Nothing here can make a mapping that is still present go
- * away, and nothing claims a range that is not free: an access violation in a
- * range that is still mapped (or that something else took) is left to the
- * next handler exactly as before.
- *
- * Self-contained (Win32 only) so the unit test can include it on its own.
- * Included by vn_renderer_helios.c.
- */
-#ifndef VN_RENDERER_HELIOS_LOST_H
-#define VN_RENDERER_HELIOS_LOST_H
-
-#include <stdbool.h>
-#include <stddef.h>
-#include <stdint.h>
-#include <stdlib.h>
-#include <windows.h>
-
-#ifndef HELIOS_LOST_LOG
-#define HELIOS_LOST_LOG(...) ((void)0)
-#endif
-
-struct helios_lost_map {
-   uintptr_t base;       /* address the ICD uses */
-   size_t size;
-   volatile LONG *owner; /* the owning renderer's lost latch */
-   uintptr_t repl_base;  /* != 0: our replacement allocation (VirtualFree) */
-};
-
-static struct {
-   SRWLOCK lock;
-   volatile DWORD lock_owner; /* thread holding `lock` exclusive, else 0 */
-   struct helios_lost_map *maps;
-   size_t count, capacity;
-   PVOID veh;
-   LONG users;
-   volatile LONG repairs; /* ranges replaced, for tests and diagnostics */
-} helios_lost = { SRWLOCK_INIT, 0, NULL, 0, 0, NULL, 0, 0 };
-
-static void
-helios_lost_lock(void)
-{
-   AcquireSRWLockExclusive(&helios_lost.lock);
-   helios_lost.lock_owner = GetCurrentThreadId();
-}
-
-static void
-helios_lost_unlock(void)
-{
-   helios_lost.lock_owner = 0;
-   ReleaseSRWLockExclusive(&helios_lost.lock);
-}
-
-static inline bool
-helios_lost_is_set(const volatile LONG *latch)
-{
-   return InterlockedCompareExchange((volatile LONG *)latch, 0, 0) != 0;
-}
-
-/* Replace one registered range whose VA is free with zeroed private memory.
- * Caller holds the lock. Returns whether the range is backed by our memory. */
-static bool
-helios_lost_replace_locked(struct helios_lost_map *m)
-{
-   if (m->repl_base)
-      return true;
-
-   MEMORY_BASIC_INFORMATION mbi;
-   if (!VirtualQuery((void *)m->base, &mbi, sizeof(mbi)) ||
-       mbi.State != MEM_FREE)
-      return false;
-
-   /* A reservation starts on the allocation granularity; the KMD's view did
-    * too, so the rounded range is the freed view itself. */
-   SYSTEM_INFO si;
-   GetSystemInfo(&si);
-   const uintptr_t gran = si.dwAllocationGranularity;
-   const uintptr_t start = m->base & ~(gran - 1);
-   const uintptr_t end = m->base + m->size;
-   void *p = VirtualAlloc((void *)start, end - start, MEM_RESERVE | MEM_COMMIT,
-                          PAGE_READWRITE);
-   if (p != (void *)start) {
-      if (p)
-         VirtualFree(p, 0, MEM_RELEASE);
-      HELIOS_LOST_LOG("device-lost: cannot back freed range %p+0x%llx (err=%lu)",
-                      (void *)m->base, (unsigned long long)m->size,
-                      GetLastError());
-      return false;
-   }
-   m->repl_base = start;
-   InterlockedIncrement(&helios_lost.repairs);
-   return true;
-}
-
-/* Latch `owner` lost and back every one of its ranges that is already free.
- * Caller holds the lock. */
-static void
-helios_lost_latch_locked(volatile LONG *owner)
-{
-   InterlockedExchange(owner, 1);
-   for (size_t i = 0; i < helios_lost.count; i++) {
-      if (helios_lost.maps[i].owner == owner)
-         helios_lost_replace_locked(&helios_lost.maps[i]);
-   }
-}
-
-static LONG CALLBACK
-helios_lost_veh(PEXCEPTION_POINTERS info)
-{
-   const EXCEPTION_RECORD *rec = info->ExceptionRecord;
-   if (rec->ExceptionCode != EXCEPTION_ACCESS_VIOLATION ||
-       rec->NumberParameters < 2)
-      return EXCEPTION_CONTINUE_SEARCH;
-   /* A fault while this thread holds the lock is not ours to handle. */
-   if (helios_lost.lock_owner == GetCurrentThreadId())
-      return EXCEPTION_CONTINUE_SEARCH;
-
-   const uintptr_t addr = (uintptr_t)rec->ExceptionInformation[1];
-   LONG verdict = EXCEPTION_CONTINUE_SEARCH;
-   bool first = false;
-   uintptr_t base = 0;
-   size_t size = 0;
-
-   helios_lost_lock();
-   for (size_t i = 0; i < helios_lost.count; i++) {
-      struct helios_lost_map *m = &helios_lost.maps[i];
-      if (addr - m->base >= m->size)
-         continue;
-      first = !helios_lost_is_set(m->owner);
-      if (m->repl_base) {
-         /* Another thread backed it first; resume unless it is not ours. */
-         MEMORY_BASIC_INFORMATION mbi;
-         if (VirtualQuery((void *)addr, &mbi, sizeof(mbi)) &&
-             mbi.State == MEM_COMMIT && mbi.Protect == PAGE_READWRITE)
-            verdict = EXCEPTION_CONTINUE_EXECUTION;
-      } else if (helios_lost_replace_locked(m)) {
-         verdict = EXCEPTION_CONTINUE_EXECUTION;
-      }
-      if (verdict == EXCEPTION_CONTINUE_EXECUTION)
-         helios_lost_latch_locked(m->owner);
-      base = m->base;
-      size = m->size;
-      break;
-   }
-   helios_lost_unlock();
-
-   if (base && (first || verdict != EXCEPTION_CONTINUE_EXECUTION)) {
-      HELIOS_LOST_LOG("device-lost: access violation at %p in KMD mapping "
-                      "%p+0x%llx (%s) -> %s",
-                      (void *)addr, (void *)base, (unsigned long long)size,
-                      rec->ExceptionInformation[0] ? "write" : "read",
-                      verdict == EXCEPTION_CONTINUE_EXECUTION
-                         ? "backed with zero pages, renderer lost"
-                         : "range not free, left to the next handler");
-   }
-   return verdict;
-}
-
-/* One per renderer; installs the handler for the first. */
-static bool
-helios_lost_init(void)
-{
-   bool ok = true;
-   helios_lost_lock();
-   if (helios_lost.users++ == 0) {
-      helios_lost.veh = AddVectoredExceptionHandler(1, helios_lost_veh);
-      ok = helios_lost.veh != NULL;
-   }
-   helios_lost_unlock();
-   return ok;
-}
-
-static void
-helios_lost_fini(void)
-{
-   helios_lost_lock();
