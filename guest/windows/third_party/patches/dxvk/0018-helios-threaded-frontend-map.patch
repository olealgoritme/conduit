+    /**
+     * \brief Helios threaded front end: pre-allocated discard slices
+     *
+     * The UMD's worker allocates the next slice for a small dynamic buffer
+     * after it replays a discard, so the app thread's next discard only takes
+     * it. One owned reference travels in \c m_heliosNext.
+     */
+    DxvkResourceAllocation* HeliosTakeNextSlice() {
+      return m_heliosNext.exchange(nullptr, std::memory_order_acquire);
+    }
+
+    bool HeliosWantsNextSlice() const {
+      return m_heliosNext.load(std::memory_order_relaxed) == nullptr;
+    }
+
+    void HeliosPutNextSlice(Rc<DxvkResourceAllocation>&& Slice) {
+      DxvkResourceAllocation* ptr = Slice.ptr();
+      ptr->incRef();
+      DxvkResourceAllocation* expected = nullptr;
+      if (!m_heliosNext.compare_exchange_strong(expected, ptr, std::memory_order_release))
+        ptr->decRef();
+    }
+
+    void HeliosSetMapPtr(void* pData) {
+      m_mapPtr = pData;
+    }
