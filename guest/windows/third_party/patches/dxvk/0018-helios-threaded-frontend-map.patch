diff --git a/src/d3d11/d3d11_context_imm.cpp b/src/d3d11/d3d11_context_imm.cpp
index 3a090686..602e44d1 100644
--- a/src/d3d11/d3d11_context_imm.cpp
+++ b/src/d3d11/d3d11_context_imm.cpp
@@ -583,6 +583,54 @@ namespace dxvk {
   }
   
   
+  DxvkResourceAllocation* D3D11ImmediateContext::HeliosFrontendDiscard(
+          D3D11Buffer*                pBuffer,
+          void**                      ppData) {
+    *ppData = nullptr;
+
+    if (unlikely(m_device->getDeviceStatus() != VK_SUCCESS))
+      return nullptr;
+
+    helios_feed::mapWriteDiscard();
+
+    // The common case takes the slice the worker parked, reference and all,
+    // without touching any reference count.
+    DxvkResourceAllocation* slice = pBuffer->HeliosTakeNextSlice();
+
+    if (likely(slice != nullptr)) {
+      pBuffer->HeliosSetMapPtr(slice->mapPtr());
+    } else {
+      Rc<DxvkResourceAllocation> fresh = pBuffer->DiscardSlice(&m_heliosFrontendCache);
+      slice = fresh.ptr();
+      slice->incRef();
+    }
+
+    *ppData = slice->mapPtr();
+    return slice;
+  }
+
+
+  void D3D11ImmediateContext::HeliosFrontendInvalidate(
+          D3D11Buffer*                pBuffer,
+          Rc<DxvkResourceAllocation>&& Slice) {
+    D3D10DeviceLock lock = LockContext();
+
+    VkDeviceSize bufferSize = pBuffer->Desc()->ByteWidth;
+
+    EmitCs([
+      cBuffer      = pBuffer->GetBuffer(),
+      cBufferSlice = std::move(Slice)
+    ] (DxvkContext* ctx) mutable {
+      ctx->invalidateBuffer(cBuffer, std::move(cBufferSlice));
+    });
+
+    if (unlikely(bufferSize > DxvkPageAllocator::PageSize))
+      ThrottleDiscard(bufferSize);
+    else if (pBuffer->HeliosWantsNextSlice())
+      pBuffer->HeliosPutNextSlice(pBuffer->AllocSlice(&m_allocationCache));
+  }
+
+
   HRESULT D3D11ImmediateContext::MapImage(
           D3D11CommonTexture*         pResource,
           UINT                        Subresource,
