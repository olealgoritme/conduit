+    /**
+     * \brief Helios: the KMD reads this image after a Present
+     *
+     * Set by the UMD when it presents the image through a composed
+     * (windowed Blt) Present on NVK: the KMD's copy of it may still be
+     * queued when Present returns (KMD BltAsync), and it claims the image's
+     * resource id in the read ledger for the life of the copy. Command lists
+     * that touch the image then wait for that claim to retire
+     * (DxvkContext::heliosEmitScanoutReuseWaits).
+     * \returns The ledger resource id, 0 when not a Blt source
+     */
+    uint32_t heliosBltSourceResid() const {
+      return m_heliosBltSourceResid.load(std::memory_order_relaxed);
+    }
+
+    void setHeliosBltSourceResid(uint32_t resid) {
+      m_heliosBltSourceResid.store(resid, std::memory_order_relaxed);
+    }
