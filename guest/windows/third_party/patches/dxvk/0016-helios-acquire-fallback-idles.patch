+
     startThreadLocked();
+    // An idle fallback signaler sleeps up to 10 ms; wake it so this gate is
+    // polled at 1 ms from the start. No waiter on the event path: a no-op.
+    m_cond.notify_all();
     return gate.fence;
   }
 
