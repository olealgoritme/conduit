+    // The caller sampled the ledger before taking this mutex. A read that
+    // retired since then has already been broadcast, possibly to a signaler
+    // pass that ran before this gate existed and found nothing to release; the
+    // next wake would then be the 10 ms timeout. Re-read this claim here, under
+    // the same mutex processRetirements holds, and signal what has retired
+    // now. A vanished claim (or one re-claimed under a new generation) means
+    // every read retired, exactly as in processRetirements.
+    uint64_t nowGeneration = 0u, nowIssued = 0u, nowRetired = 0u;
+    const uint64_t target = helios_acquire::ledgerLookupV2(resid, &nowGeneration, &nowIssued, &nowRetired)
+                         && nowGeneration == generation
+      ? nowRetired
+      : gate.highestArmed;
