+  DxvkResourceAllocation* DxvkSharedAllocationCache::takeRecent(
+          uint32_t                    poolIndex) {
+    auto& recent = m_recent[poolIndex];
+
+    if (!recent.head.load(std::memory_order_relaxed))
+      return nullptr;
+
+    DxvkResourceAllocation* head = recent.head.exchange(nullptr, std::memory_order_acquire);
+
+    // Frees that land between the exchange and this store are not counted,
+    // so the count can only read low; it is a soft bound, see pushRecent.
+    recent.count.store(0u, std::memory_order_relaxed);
+    recent.takeTime.store(recentTimeNow(), std::memory_order_relaxed);
+    return head;
+  }
+
+
+  bool DxvkSharedAllocationCache::pushRecent(
+          uint32_t                    poolIndex,
+          DxvkResourceAllocation*     allocation) {
+    auto& recent = m_recent[poolIndex];
+
+    // Bound what one size class keeps here when nothing takes it (a size a
+    // scene stopped using): beyond 16 free lists' worth, frees take the
+    // regular free-list path, which balances and frees memory.
+    uint32_t maxCount = uint32_t(16u * PoolCapacityInBytes / allocation->m_size);
+
+    if (recent.count.load(std::memory_order_relaxed) >= maxCount)
+      return false;
+
+    recent.count.fetch_add(1u, std::memory_order_relaxed);
+
+    DxvkResourceAllocation* head = recent.head.load(std::memory_order_relaxed);
+
+    do {
+      allocation->m_nextCached = head;
+    } while (!recent.head.compare_exchange_weak(head, allocation,
+      std::memory_order_release, std::memory_order_relaxed));
+
+    return true;
+  }
