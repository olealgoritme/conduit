+  uint64_t D3D11ImmediateContext::HeliosSignalHandoffPoint(
+    const Rc<DxvkFence>&        Fence,
+          uint64_t              Value) {
+    D3D10DeviceLock lock = LockContext();
+
+    EmitCs([
+      cFence  = Fence,
+      cValue  = Value,
+      cDevice = static_cast<const void*>(m_device.ptr())
+    ] (DxvkContext* ctx) {
+      ctx->signalFence(cFence, cValue);
+      // Work the CS thread records from here on was issued after this
+      // point was published (see HeliosHandoffHooks::sampleBefore).
+      if (const auto* hooks = heliosHandoffHooks()) {
+        if (hooks->csReached)
+          hooks->csReached(cDevice, cValue);
+      }
+    });
+    ExecuteFlush(GpuFlushType::ExplicitFlush, nullptr, false);
+    return GetCurrentSequenceNumber();
+  }
+
