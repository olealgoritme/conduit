Helios DXVK fork: an NVK device opens another NVK process's surface

Conduit guest/windows/docs/shared-surfaces.md, dxvk-on-nvk.md S6. Applied after
0001 by ci/windows/Build-Driver.ps1 (the fork is not ours to push to).

- An NVK device (HELIOS_DXVK_BACKEND=nvk) importing a shared texture that is a
  foreign resource (the KMD's layout trailer, D3D11_HELIOS_IMPORT_INFO::Foreign,
  with its resource id) builds the image as the creator did (OPTIMAL, the same
  description) and allocates dedicated memory with HeliosImportMemoryResourceInfo
  (sType 1000384004: resource id, object size, modifier, row pitch, offset).
  NVK maps the creator's memory by resource id and checks the image's layout
  against the trailer. Any other import on NVK still fails.

diff --git a/src/dxvk/dxvk_helios_backend.h b/src/dxvk/dxvk_helios_backend.h
index 653f208a..56224b43 100644
--- a/src/dxvk/dxvk_helios_backend.h
+++ b/src/dxvk/dxvk_helios_backend.h
@@ -54,4 +54,26 @@ namespace dxvk {
   constexpr VkStructureType VK_STRUCTURE_TYPE_EXPORT_MEMORY_RESOURCE_INFO_HELIOS =
     VkStructureType(1000384003);
 
+  /**
+   * \brief VkMemoryAllocateInfo pNext: map another NVK process's surface
+   *
+   * Mirrors helios_import_memory_resource_info in Conduit's
+   * guest/windows/protocol/include/helios_icd_interface.h. With a dedicated
+   * image laid out as the creator's (the KMD's layout trailer), NVK maps the
+   * memory behind the resource id instead of allocating.
+   */
+  struct HeliosImportMemoryResourceInfo {
+    VkStructureType sType;
+    const void*     pNext;
+    uint32_t        resourceId;
+    uint32_t        flags;
+    uint64_t        size;
+    uint64_t        modifier;
+    uint32_t        stride;
+    uint32_t        offset;
+  };
+
+  constexpr VkStructureType VK_STRUCTURE_TYPE_IMPORT_MEMORY_RESOURCE_INFO_HELIOS =
+    VkStructureType(1000384004);
+
 }
