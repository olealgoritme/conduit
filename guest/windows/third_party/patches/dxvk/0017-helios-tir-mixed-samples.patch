 namespace dxvk {
 
+  /**
+   * \brief Device capabilities that decide the rasterization sample count
+   */
+  struct DxvkRasterizationSampleCaps {
+    /// VK_NV_framebuffer_mixed_samples: more rasterization
+    /// samples than the color attachments have
+    bool               mixedSamples        = false;
+    /// framebufferNoAttachmentsSampleCounts
+    VkSampleCountFlags noAttachmentSamples = VK_SAMPLE_COUNT_1_BIT;
+  };
+
+  /**
+   * \brief Rasterization sample count
+   *
+   * The render targets' sample count, or the rasterizer state's sample
+   * count if no render target is bound (UAV-only rendering), limited to
+   * the largest count the device supports without attachments.
+   *
+   * With mixed samples, a rasterizer sample count above the color
+   * targets' is used as is when no depth-stencil target is bound: D3D11.1
+   * target-independent rasterization, e.g. Direct2D's anti-aliased fills
+   * with a forced sample count of 16 and a single-sample render target,
+   * whose pixel shaders derive coverage from SV_Coverage. D3D forbids a
+   * depth-stencil target with a forced sample count, and Vulkan would need
+   * it to have the rasterization sample count with depth tests on. Sample
+   * rate shading, which Vulkan does not allow with mixed samples either
+   * and D3D leaves undefined under a forced sample count, is turned off
+   * by the pipeline instead, so this does not depend on the shaders.
+   *
+   * The D3D11 rasterizer sample count specialization constant uses this
+   * too, so that shaders see the count the rasterizer runs at.
+   * \param [in] caps Device sample count capabilities
+   * \param [in] fbSamples Render target sample count, 0 if none
+   * \param [in] rsSamples Rasterizer state sample count, 0 if none
+   * \param [in] hasDepthStencil Whether a depth-stencil target is bound
+   * \returns Rasterization sample count
+   */
+  inline VkSampleCountFlagBits dxvkRasterizationSamples(
+    const DxvkRasterizationSampleCaps&    caps,
+          uint32_t                        fbSamples,
+          uint32_t                        rsSamples,
+          bool                            hasDepthStencil) {
+    if (!fbSamples) {
+      if (!rsSamples)
+        return VK_SAMPLE_COUNT_1_BIT;
+
+      // Largest supported count that does not exceed the requested one
+      VkSampleCountFlags supported = caps.noAttachmentSamples & ((rsSamples << 1) - 1u);
+
+      return supported
+        ? VkSampleCountFlagBits(1u << (31u - bit::lzcnt(supported)))
+        : VK_SAMPLE_COUNT_1_BIT;
+    }
+
+    if (caps.mixedSamples && rsSamples > fbSamples && !hasDepthStencil)
+      return VkSampleCountFlagBits(rsSamples);
+
+    return VkSampleCountFlagBits(fbSamples);
+  }
