+    /**
+     * \brief Rasterization sample count
+     *
+     * The render targets' sample count, or the rasterizer state's
+     * sample count if no render target is bound. With mixed samples
+     * (VK_NV_framebuffer_mixed_samples), a rasterizer sample count
+     * above the render targets' is used as is: D3D11.1 target-independent
+     * rasterization, e.g. Direct2D's anti-aliased fills with a forced
+     * sample count of 16 and a single-sample render target, whose pixel
+     * shaders derive coverage from SV_Coverage. Vulkan requires that no
+     * depth-stencil attachment and no sample rate shading are in use
+     * then, and D3D leaves both undefined with a forced sample count.
+     * \param [in] mixedSamples Whether mixed samples are supported
+     * \param [in] sampleRateShading Whether the fragment shader runs
+     *    at sample rate
+     * \returns Rasterization sample count
+     */
+    VkSampleCountFlagBits rasterizationSamples(
+            bool                            mixedSamples,
+            bool                            sampleRateShading) const {
+      VkSampleCountFlagBits fbSamples = VkSampleCountFlagBits(ms.sampleCount());
+      VkSampleCountFlagBits rsSamples = VkSampleCountFlagBits(rs.sampleCount());
+
+      if (!fbSamples)
+        return rsSamples ? rsSamples : VK_SAMPLE_COUNT_1_BIT;
+
+      if (mixedSamples && rsSamples > fbSamples && !sampleRateShading
+       && !rt.getDepthStencilFormat())
+        return rsSamples;
+
+      return fbSamples;
+    }
+
+    /**
+     * \brief Checks whether rasterization uses mixed samples
+     *
+     * \param [in] mixedSamples Whether mixed samples are supported
+     * \param [in] sampleRateShading Whether the fragment shader runs
+     *    at sample rate
+     * \returns \c true if more samples are rasterized than the
+     *    render targets have
+     */
+    bool useMixedSamples(
+            bool                            mixedSamples,
+            bool                            sampleRateShading) const {
+      return ms.sampleCount()
+          && rasterizationSamples(mixedSamples, sampleRateShading) > ms.sampleCount();
+    }
