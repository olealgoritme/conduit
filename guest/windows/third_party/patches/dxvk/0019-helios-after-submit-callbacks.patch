+    void heliosAfterSubmit(std::function<void ()>&& fn) {
+      m_heliosAfterSubmit.push_back(std::move(fn));
+    }
+
+    /**
+     * \brief Helios: runs the \ref heliosAfterSubmit callbacks once
+     *
+     * \param [in] success The submission succeeded; on failure the
+     *   callbacks are dropped without running (the device is lost).
+     */
+    void heliosRunAfterSubmit(bool success) {
+      if (success) {
+        for (auto& fn : m_heliosAfterSubmit)
+          fn();
+      }
+      m_heliosAfterSubmit.clear();
+    }
     
