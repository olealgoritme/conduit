+    if (!memoryTypeMask)
+      return nullptr;
+
+    std::lock_guard<dxvk::mutex> lock(m_mutex);
+
     // Ensure the allocation size is also aligned
     VkDeviceSize size = align(requirements.size, requirements.alignment);
 
