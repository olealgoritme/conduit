+
+  D3D11VideoDecoderOutputView::D3D11VideoDecoderOutputView(
+          D3D11Device*            pDevice,
+          ID3D11Resource*         pResource,
+    const D3D11_VIDEO_DECODER_OUTPUT_VIEW_DESC& Desc)
+  : D3D11DeviceChild<ID3D11VideoDecoderOutputView>(pDevice),
+    m_resource(pResource), m_desc(Desc), m_destructionNotifier(this) {
+    D3D11CommonTexture* texture = GetCommonTexture(pResource);
+
+    if (!texture || texture->GetDimension() != D3D11_RESOURCE_DIMENSION_TEXTURE2D)
+      throw DxvkError("D3D11VideoDecoderOutputView: Resource is not a 2D texture");
+
+    if (Desc.ViewDimension != D3D11_VDOV_DIMENSION_TEXTURE2D)
+      throw DxvkError("D3D11VideoDecoderOutputView: Unsupported view dimension");
+
+    Rc<DxvkImage> image = texture->GetImage();
+
+    if (!image || !image->info().videoDecode)
+      throw DxvkError("D3D11VideoDecoderOutputView: Texture is not a decoder surface");
+
+    if (Desc.Texture2D.ArraySlice >= image->info().numLayers)
+      throw DxvkError("D3D11VideoDecoderOutputView: Invalid array slice");
+
+    m_picture = new D3D11VideoPicture(pDevice->GetDXVKDevice(), image, Desc.Texture2D.ArraySlice);
+  }
