diff --git a/src/d3d11/d3d11_video_decoder.cpp b/src/d3d11/d3d11_video_decoder.cpp
new file mode 100644
index 00000000..32805922
--- /dev/null
+++ b/src/d3d11/d3d11_video_decoder.cpp
@@ -0,0 +1,1153 @@
+#include <algorithm>
+#include <cstddef>
+#include <cstring>
+
+#include "d3d11_context_imm.h"
+#include "d3d11_texture.h"
+#include "d3d11_video_decoder.h"
+
+/*
+ * Helios: D3D11 video decoder (D3D11VA / DXVA) on Vulkan Video.
+ *
+ * The app parses the bitstream and hands us DXVA structures: picture
+ * parameters (DXVA_PicParams_H264), the inverse quantization matrices
+ * (DXVA_Qmatrix_H264), slice control (DXVA_Slice_H264_Short or _Long) and
+ * the bitstream itself, with start codes. Vulkan Video wants the same
+ * information as StdVideo SPS/PPS in session parameters, a picture info with
+ * slice offsets, and explicit DPB slots. The DXVA picture parameters carry
+ * every SPS/PPS field the hardware needs (the hardware parses the slice
+ * headers itself), so SPS and PPS are rebuilt from them, with ids 0, and a
+ * new session parameters object is made whenever they change.
+ *
+ * DXVA names pictures by surface index (the decoder output view's array
+ * slice). Each surface that is in the DPB holds a Vulkan DPB slot; a slot
+ * is freed as soon as the surface leaves RefFrameList. Output and DPB
+ * coincide: the decoded picture is written to the app's NV12 texture layer,
+ * which is also the reference picture later on, so no copies happen.
+ *
+ * Decode runs on the device's video decode queue. Each frame: the CS thread
+ * brings the touched images into their default layout, signals a fence and
+ * flushes the graphics command list, submits the decode (waiting for that
+ * fence, signalling the decode fence), and makes the next graphics
+ * submission wait for the decode fence. Images are concurrent between the
+ * graphics and decode families, so no ownership transfers are needed.
+ */
+
+namespace dxvk {
+
+  // DXVA H.264 structures (dxva.h). Defined here rather than included: the
+  // Windows SDK's dxva.h does not compile as C++17 under clang-cl (its color
+  // mask enums shift negative values), and only these few are needed. Same
+  // byte layout as the SDK's (#pragma pack 1), checked below.
+#pragma pack(push, 1)
+  struct DXVA_PicEntry_H264 {
+    union {
+      struct {
+        uint8_t Index7Bits     : 7;
+        uint8_t AssociatedFlag : 1;
+      };
+      uint8_t bPicEntry;
+    };
+  };
+
+  struct DXVA_PicParams_H264 {
+    uint16_t wFrameWidthInMbsMinus1;
+    uint16_t wFrameHeightInMbsMinus1;
+    DXVA_PicEntry_H264 CurrPic;
+    uint8_t num_ref_frames;
+    union {
+      struct {
+        uint16_t field_pic_flag                 : 1;
+        uint16_t MbaffFrameFlag                 : 1;
+        uint16_t residual_colour_transform_flag : 1;
+        uint16_t sp_for_switch_flag             : 1;
+        uint16_t chroma_format_idc              : 2;
+        uint16_t RefPicFlag                     : 1;
+        uint16_t constrained_intra_pred_flag    : 1;
+        uint16_t weighted_pred_flag             : 1;
+        uint16_t weighted_bipred_idc            : 2;
+        uint16_t MbsConsecutiveFlag             : 1;
+        uint16_t frame_mbs_only_flag            : 1;
+        uint16_t transform_8x8_mode_flag        : 1;
+        uint16_t MinLumaBipredSize8x8Flag       : 1;
+        uint16_t IntraPicFlag                   : 1;
+      };
+      uint16_t wBitFields;
+    };
+    uint8_t bit_depth_luma_minus8;
+    uint8_t bit_depth_chroma_minus8;
+    uint16_t Reserved16Bits;
+    uint32_t StatusReportFeedbackNumber;
+    DXVA_PicEntry_H264 RefFrameList[16];
+    int32_t CurrFieldOrderCnt[2];
+    int32_t FieldOrderCntList[16][2];
+    int8_t pic_init_qs_minus26;
+    int8_t chroma_qp_index_offset;
+    int8_t second_chroma_qp_index_offset;
+    uint8_t ContinuationFlag;
+    int8_t pic_init_qp_minus26;
+    uint8_t num_ref_idx_l0_active_minus1;
+    uint8_t num_ref_idx_l1_active_minus1;
+    uint8_t Reserved8BitsA;
+    uint16_t FrameNumList[16];
+    uint32_t UsedForReferenceFlags;
+    uint16_t NonExistingFrameFlags;
+    uint16_t frame_num;
+    uint8_t log2_max_frame_num_minus4;
+    uint8_t pic_order_cnt_type;
+    uint8_t log2_max_pic_order_cnt_lsb_minus4;
+    uint8_t delta_pic_order_always_zero_flag;
+    uint8_t direct_8x8_inference_flag;
+    uint8_t entropy_coding_mode_flag;
+    uint8_t pic_order_present_flag;
+    uint8_t num_slice_groups_minus1;
+    uint8_t slice_group_map_type;
+    uint8_t deblocking_filter_control_present_flag;
+    uint8_t redundant_pic_cnt_present_flag;
+    uint8_t Reserved8BitsB;
+    uint16_t slice_group_change_rate_minus1;
+    uint8_t SliceGroupMap[810];
+  };
+
+  struct DXVA_Qmatrix_H264 {
+    uint8_t bScalingLists4x4[6][16];
+    uint8_t bScalingLists8x8[2][64];
+  };
+
+  struct DXVA_Slice_H264_Short {
+    uint32_t BSNALunitDataLocation;
+    uint32_t SliceBytesInBuffer;
+    uint16_t wBadSliceChopping;
+  };
+#pragma pack(pop)
+
+  // The long slice format starts with the short one; only its size matters.
+  constexpr size_t DXVA_Slice_H264_Long_Size = 864u;
+
+  static_assert(sizeof(DXVA_PicEntry_H264) == 1u);
+  static_assert(sizeof(DXVA_PicParams_H264) == 1040u);
+  static_assert(offsetof(DXVA_PicParams_H264, RefFrameList) == 16u);
+  static_assert(offsetof(DXVA_PicParams_H264, CurrFieldOrderCnt) == 32u);
+  static_assert(offsetof(DXVA_PicParams_H264, FrameNumList) == 176u);
+  static_assert(sizeof(DXVA_Qmatrix_H264) == 224u);
+  static_assert(sizeof(DXVA_Slice_H264_Short) == 10u);
+
+  const GUID D3D11_VK_DECODER_PROFILE_H264_VLD_NOFGT =
+    { 0x1b81be68, 0xa0c7, 0x11d3, { 0xb9, 0x84, 0x00, 0xc0, 0x4f, 0x2e, 0x73, 0xc5 } };
+
+  const GUID D3D11_VK_DXVA_NO_ENCRYPT =
+    { 0x1b81bed0, 0xa0c7, 0x11d3, { 0xb9, 0x84, 0x00, 0xc0, 0x4f, 0x2e, 0x73, 0xc5 } };
+
+
+  struct D3D11VideoDecodeFrame {
+    uint32_t                          slotIndex = 0u;
+    uint64_t                          fenceValue = 0u;
+    VkVideoSessionParametersKHR       params = VK_NULL_HANDLE;
+    VkDeviceSize                      srcOffset = 0u;
+    VkDeviceSize                      srcRange = 0u;
+
+    // Index 0 is the current picture, then the references
+    uint32_t                          pictureCount = 0u;
+    std::array<Rc<D3D11VideoPicture>, 17> pictures;
+    std::array<int32_t, 17>           slots = { };
+    std::array<VkExtent2D, 17>        extents = { };
+    std::array<StdVideoDecodeH264ReferenceInfo, 17> refInfo = { };
+
+    StdVideoDecodeH264PictureInfo     picInfo = { };
+    uint32_t                          sliceCount = 0u;
+    std::array<uint32_t, D3D11VideoDecoderCore::MaxSlices> sliceOffsets = { };
+  };
+
+
+  D3D11VideoPicture::D3D11VideoPicture(
+    const Rc<DxvkDevice>&           device,
+    const Rc<DxvkImage>&            image,
+          uint32_t                  layer)
+  : m_device(device), m_image(image), m_layer(layer) {
+    auto vk = m_device->vkd();
+
+    VkImageViewUsageCreateInfo usageInfo = { VK_STRUCTURE_TYPE_IMAGE_VIEW_USAGE_CREATE_INFO };
+    usageInfo.usage = VK_IMAGE_USAGE_VIDEO_DECODE_DST_BIT_KHR
+                    | VK_IMAGE_USAGE_VIDEO_DECODE_DPB_BIT_KHR;
+
+    VkImageViewCreateInfo viewInfo = { VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO, &usageInfo };
+    viewInfo.image = m_image->handle();
+    viewInfo.viewType = VK_IMAGE_VIEW_TYPE_2D;
+    viewInfo.format = m_image->info().format;
+    viewInfo.subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0u, 1u, layer, 1u };
+
+    VkResult vr = vk->vkCreateImageView(vk->device(), &viewInfo, nullptr, &m_view);
+
+    if (vr != VK_SUCCESS)
+      throw DxvkError(str::format("D3D11VideoPicture: Failed to create image view: ", vr));
+  }
+
+
+  D3D11VideoPicture::~D3D11VideoPicture() {
+    auto vk = m_device->vkd();
+    vk->vkDestroyImageView(vk->device(), m_view, nullptr);
+  }
