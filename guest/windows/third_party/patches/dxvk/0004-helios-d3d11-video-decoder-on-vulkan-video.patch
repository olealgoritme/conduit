+  D3D11VideoDecoderCore::D3D11VideoDecoderCore(
+    const Rc<DxvkDevice>&           device,
+          VkExtent2D                codedExtent)
+  : m_device(device), m_vkd(device->vkd()) {
+    auto vk = m_vkd;
+    auto vki = m_device->adapter()->vki();
+
+    const VkVideoProfileInfoKHR* profile = m_device->getVideoDecodeProfileList()->pProfiles;
+    uint32_t queueFamily = m_device->queues().videoDecode.queueFamily;
+
+    VkVideoDecodeH264CapabilitiesKHR h264Caps = { VK_STRUCTURE_TYPE_VIDEO_DECODE_H264_CAPABILITIES_KHR };
+    VkVideoDecodeCapabilitiesKHR decodeCaps = { VK_STRUCTURE_TYPE_VIDEO_DECODE_CAPABILITIES_KHR, &h264Caps };
+    VkVideoCapabilitiesKHR caps = { VK_STRUCTURE_TYPE_VIDEO_CAPABILITIES_KHR, &decodeCaps };
+
+    VkResult vr = vki->vkGetPhysicalDeviceVideoCapabilitiesKHR(m_device->adapter()->handle(), profile, &caps);
+
+    if (vr != VK_SUCCESS)
+      throw DxvkError(str::format("D3D11VideoDecoder: Failed to query video capabilities: ", vr));
+
+    if (!(decodeCaps.flags & VK_VIDEO_DECODE_CAPABILITY_DPB_AND_OUTPUT_COINCIDE_BIT_KHR))
+      throw DxvkError("D3D11VideoDecoder: Device cannot decode into DPB pictures");
+
+    if (codedExtent.width > caps.maxCodedExtent.width || codedExtent.height > caps.maxCodedExtent.height
+     || codedExtent.width < caps.minCodedExtent.width || codedExtent.height < caps.minCodedExtent.height)
+      throw DxvkError(str::format("D3D11VideoDecoder: Unsupported size ", codedExtent.width, "x", codedExtent.height));
+
+    m_maxDpbSlots = std::min(caps.maxDpbSlots, 17u);
+    m_maxActiveRefs = std::min(caps.maxActiveReferencePictures, 16u);
+    m_bitstreamOffsetAlignment = std::max<VkDeviceSize>(caps.minBitstreamBufferOffsetAlignment, 1u);
+    m_bitstreamSizeAlignment = std::max<VkDeviceSize>(caps.minBitstreamBufferSizeAlignment, 1u);
+
+    VkVideoSessionCreateInfoKHR sessionInfo = { VK_STRUCTURE_TYPE_VIDEO_SESSION_CREATE_INFO_KHR };
+    sessionInfo.queueFamilyIndex = queueFamily;
+    sessionInfo.pVideoProfile = profile;
+    sessionInfo.pictureFormat = VK_FORMAT_G8_B8R8_2PLANE_420_UNORM;
+    sessionInfo.maxCodedExtent = codedExtent;
+    sessionInfo.referencePictureFormat = VK_FORMAT_G8_B8R8_2PLANE_420_UNORM;
+    sessionInfo.maxDpbSlots = m_maxDpbSlots;
+    sessionInfo.maxActiveReferencePictures = m_maxActiveRefs;
+    sessionInfo.pStdHeaderVersion = &caps.stdHeaderVersion;
+
+    if ((vr = vk->vkCreateVideoSessionKHR(vk->device(), &sessionInfo, nullptr, &m_session)))
+      throw DxvkError(str::format("D3D11VideoDecoder: Failed to create video session: ", vr));
+
+    // Bind session memory
+    uint32_t reqCount = 0u;
+    vk->vkGetVideoSessionMemoryRequirementsKHR(vk->device(), m_session, &reqCount, nullptr);
+
+    std::vector<VkVideoSessionMemoryRequirementsKHR> reqs(reqCount,
+      { VK_STRUCTURE_TYPE_VIDEO_SESSION_MEMORY_REQUIREMENTS_KHR });
+    vk->vkGetVideoSessionMemoryRequirementsKHR(vk->device(), m_session, &reqCount, reqs.data());
+
+    std::vector<VkBindVideoSessionMemoryInfoKHR> binds;
+
+    for (const auto& req : reqs) {
+      VkMemoryAllocateInfo allocInfo = { VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO };
+      allocInfo.allocationSize = req.memoryRequirements.size;
+      allocInfo.memoryTypeIndex = findMemoryType(req.memoryRequirements.memoryTypeBits,
+        0u, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+
+      VkDeviceMemory memory = VK_NULL_HANDLE;
+
+      if ((vr = vk->vkAllocateMemory(vk->device(), &allocInfo, nullptr, &memory)))
+        throw DxvkError(str::format("D3D11VideoDecoder: Failed to allocate session memory: ", vr));
+
+      m_sessionMemory.push_back(memory);
+
+      VkBindVideoSessionMemoryInfoKHR bind = { VK_STRUCTURE_TYPE_BIND_VIDEO_SESSION_MEMORY_INFO_KHR };
+      bind.memoryBindIndex = req.memoryBindIndex;
+      bind.memory = memory;
+      bind.memoryOffset = 0u;
+      bind.memorySize = req.memoryRequirements.size;
+      binds.push_back(bind);
+    }
+
+    if (!binds.empty() && (vr = vk->vkBindVideoSessionMemoryKHR(vk->device(), m_session, binds.size(), binds.data())))
+      throw DxvkError(str::format("D3D11VideoDecoder: Failed to bind session memory: ", vr));
+
+    // Bitstream ring: one host-visible buffer, one region per slot. A frame
+    // rarely gets close to the size of a raw 8-bit 4:2:0 picture.
+    VkDeviceSize pixels = VkDeviceSize(codedExtent.width) * codedExtent.height;
+    VkDeviceSize alignment = std::max(m_bitstreamOffsetAlignment, m_bitstreamSizeAlignment);
+    m_bitstreamSlotSize = align(std::max<VkDeviceSize>(pixels, 2u << 20), alignment);
+
+    VkBufferCreateInfo bufferInfo = { VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO };
+    bufferInfo.pNext = m_device->getVideoDecodeProfileList();
+    bufferInfo.size = m_bitstreamSlotSize * SlotCount;
+    bufferInfo.usage = VK_BUFFER_USAGE_VIDEO_DECODE_SRC_BIT_KHR;
+    bufferInfo.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+
+    if ((vr = vk->vkCreateBuffer(vk->device(), &bufferInfo, nullptr, &m_bitstreamBuffer)))
+      throw DxvkError(str::format("D3D11VideoDecoder: Failed to create bitstream buffer: ", vr));
+
+    VkMemoryRequirements memReqs = { };
+    vk->vkGetBufferMemoryRequirements(vk->device(), m_bitstreamBuffer, &memReqs);
+
+    VkMemoryAllocateInfo allocInfo = { VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO };
+    allocInfo.allocationSize = memReqs.size;
+    allocInfo.memoryTypeIndex = findMemoryType(memReqs.memoryTypeBits,
+      VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT, 0u);
+
+    if ((vr = vk->vkAllocateMemory(vk->device(), &allocInfo, nullptr, &m_bitstreamMemory)))
+      throw DxvkError(str::format("D3D11VideoDecoder: Failed to allocate bitstream memory: ", vr));
+
+    if ((vr = vk->vkBindBufferMemory(vk->device(), m_bitstreamBuffer, m_bitstreamMemory, 0u)))
+      throw DxvkError(str::format("D3D11VideoDecoder: Failed to bind bitstream memory: ", vr));
+
+    void* map = nullptr;
+
+    if ((vr = vk->vkMapMemory(vk->device(), m_bitstreamMemory, 0u, VK_WHOLE_SIZE, 0u, &map)))
+      throw DxvkError(str::format("D3D11VideoDecoder: Failed to map bitstream memory: ", vr));
+
+    m_bitstreamMap = reinterpret_cast<uint8_t*>(map);
+
+    // Command buffers, one per slot
+    VkCommandPoolCreateInfo poolInfo = { VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO };
+    poolInfo.flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
+    poolInfo.queueFamilyIndex = queueFamily;
+
+    if ((vr = vk->vkCreateCommandPool(vk->device(), &poolInfo, nullptr, &m_commandPool)))
+      throw DxvkError(str::format("D3D11VideoDecoder: Failed to create command pool: ", vr));
+
+    std::array<VkCommandBuffer, SlotCount> cmds = { };
+
+    VkCommandBufferAllocateInfo cmdInfo = { VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO };
+    cmdInfo.commandPool = m_commandPool;
+    cmdInfo.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+    cmdInfo.commandBufferCount = SlotCount;
+
+    if ((vr = vk->vkAllocateCommandBuffers(vk->device(), &cmdInfo, cmds.data())))
+      throw DxvkError(str::format("D3D11VideoDecoder: Failed to allocate command buffers: ", vr));
+
+    for (uint32_t i = 0u; i < SlotCount; i++) {
+      m_slots[i].cmd = cmds[i];
+      m_slots[i].bitstreamOffset = m_bitstreamSlotSize * i;
+    }
+
+    DxvkFenceCreateInfo fenceInfo = { };
+    fenceInfo.initialValue = 0u;
+
+    m_decodeFence = m_device->createFence(fenceInfo);
+    m_graphicsFence = m_device->createFence(fenceInfo);
+
+    Logger::info(str::format("D3D11VideoDecoder: H.264 session ", codedExtent.width, "x", codedExtent.height,
+      ", ", m_maxDpbSlots, " DPB slots, bitstream ", SlotCount, "x", m_bitstreamSlotSize >> 10, " KiB"));
+  }
+
+
+  D3D11VideoDecoderCore::~D3D11VideoDecoderCore() {
+    auto vk = m_vkd;
+
+    // Every queued decode holds a reference to us, so all of
+    // them have been submitted by now. Wait for the last one.
+    if (m_decodeFence && m_fenceValue)
+      m_decodeFence->wait(m_fenceValue);
+
+    for (auto& slot : m_slots) {
+      slot.pictures.clear();
+
+      for (auto params : slot.retiredParams)
+        vk->vkDestroyVideoSessionParametersKHR(vk->device(), params, nullptr);
+
+      slot.retiredParams.clear();
+    }
+
+    vk->vkDestroyCommandPool(vk->device(), m_commandPool, nullptr);
+    vk->vkDestroyBuffer(vk->device(), m_bitstreamBuffer, nullptr);
+    vk->vkFreeMemory(vk->device(), m_bitstreamMemory, nullptr);
+    vk->vkDestroyVideoSessionKHR(vk->device(), m_session, nullptr);
+
+    for (auto memory : m_sessionMemory)
+      vk->vkFreeMemory(vk->device(), memory, nullptr);
+  }
+
+
+  void D3D11VideoDecoderCore::waitSlot(
+          D3D11ImmediateContext*    context,
+          uint32_t                  index) {
+    auto& slot = m_slots[index];
+
+    if (!slot.fenceValue)
+      return;
+
+    // The decode for this slot may still sit in the CS queue,
+    // in which case its fence value has not been submitted yet.
+    if (m_submittedValue.load(std::memory_order_acquire) < slot.fenceValue)
+      context->SynchronizeCsThread(DxvkCsThread::SynchronizeAll);
+
+    m_decodeFence->wait(slot.fenceValue);
+
+    auto vk = m_vkd;
+    slot.pictures.clear();
+
+    for (auto params : slot.retiredParams)
+      vk->vkDestroyVideoSessionParametersKHR(vk->device(), params, nullptr);
+
+    slot.retiredParams.clear();
+    slot.fenceValue = 0u;
+  }
+
+
+  VkVideoSessionParametersKHR D3D11VideoDecoderCore::createParameters(
+    const StdVideoH264SequenceParameterSet& sps,
+    const StdVideoH264PictureParameterSet&  pps) {
+    auto vk = m_vkd;
+
+    VkVideoDecodeH264SessionParametersAddInfoKHR addInfo = { VK_STRUCTURE_TYPE_VIDEO_DECODE_H264_SESSION_PARAMETERS_ADD_INFO_KHR };
+    addInfo.stdSPSCount = 1u;
+    addInfo.pStdSPSs = &sps;
+    addInfo.stdPPSCount = 1u;
+    addInfo.pStdPPSs = &pps;
+
+    VkVideoDecodeH264SessionParametersCreateInfoKHR h264Info = { VK_STRUCTURE_TYPE_VIDEO_DECODE_H264_SESSION_PARAMETERS_CREATE_INFO_KHR };
+    h264Info.maxStdSPSCount = 1u;
+    h264Info.maxStdPPSCount = 1u;
+    h264Info.pParametersAddInfo = &addInfo;
+
+    VkVideoSessionParametersCreateInfoKHR info = { VK_STRUCTURE_TYPE_VIDEO_SESSION_PARAMETERS_CREATE_INFO_KHR, &h264Info };
+    info.videoSession = m_session;
+
+    VkVideoSessionParametersKHR params = VK_NULL_HANDLE;
+    VkResult vr = vk->vkCreateVideoSessionParametersKHR(vk->device(), &info, nullptr, &params);
+
+    if (vr != VK_SUCCESS) {
+      Logger::err(str::format("D3D11VideoDecoder: Failed to create session parameters: ", vr));
+      return VK_NULL_HANDLE;
+    }
+
+    return params;
+  }
+
+
+  void D3D11VideoDecoderCore::destroyParameters(
+          VkVideoSessionParametersKHR params) {
+    auto vk = m_vkd;
+    vk->vkDestroyVideoSessionParametersKHR(vk->device(), params, nullptr);
+  }
+
+
+  uint32_t D3D11VideoDecoderCore::findMemoryType(
+          uint32_t                  typeBits,
+          VkMemoryPropertyFlags     required,
+          VkMemoryPropertyFlags     preferred) const {
+    const auto& props = m_device->adapter()->memoryProperties();
+
+    for (uint32_t pass = 0u; pass < 2u; pass++) {
+      VkMemoryPropertyFlags flags = required | (pass ? 0u : preferred);
+
+      for (uint32_t i = 0u; i < props.memoryTypeCount; i++) {
+        if ((typeBits & (1u << i)) && (props.memoryTypes[i].propertyFlags & flags) == flags)
+          return i;
+      }
+    }
+
+    throw DxvkError("D3D11VideoDecoder: No suitable memory type");
+  }
+
+
+  void D3D11VideoDecoderCore::submit(
+          DxvkContext*              ctx,
+    const D3D11VideoDecodeFrame&    frame) {
+    auto vk = m_vkd;
+    auto& slot = m_slots[frame.slotIndex];
+
+    // Order the decode after all graphics work recorded so far on the
+    // images it touches, and bring them into their default layout.
+    for (uint32_t i = 0u; i < frame.pictureCount; i++) {
+      const auto& picture = frame.pictures[i];
+      ctx->prepareImageForExternalQueue(picture->image(),
+        VkImageSubresourceRange { VK_IMAGE_ASPECT_COLOR_BIT, 0u, 1u, picture->layer(), 1u });
+    }
+
+    ctx->signalFence(m_graphicsFence, ++m_graphicsValue);
+
+    // The submission thread stores the result into `status`, and
+    // waitForSubmission only waits while it reads VK_NOT_READY. Left at
+    // its default (VK_SUCCESS) the wait returns at once and the late store
+    // lands in this frame after it is gone, on the CS thread's stack.
+    DxvkSubmitStatus status;
+    status.result = VK_NOT_READY;
+    ctx->flushCommandList(nullptr, &status);
+
+    // The graphics signal must have reached vkQueueSubmit before the decode
+    // queue waits for it; do not rely on wait-before-signal.
+    VkResult vr = m_device->waitForSubmission(&status);
+
+    if (vr != VK_SUCCESS)
+      Logger::err(str::format("D3D11VideoDecoder: Graphics submission failed: ", vr));
+
+    // Record the decode
+    std::array<VkVideoPictureResourceInfoKHR, 17> resources = { };
+    std::array<VkVideoDecodeH264DpbSlotInfoKHR, 17> dpbInfos = { };
+    std::array<VkVideoReferenceSlotInfoKHR, 17> beginSlots = { };
+    std::array<VkVideoReferenceSlotInfoKHR, 17> refSlots = { };
+    std::array<VkImageMemoryBarrier2, 17> acquire = { };
+    std::array<VkImageMemoryBarrier2, 17> release = { };
+
+    for (uint32_t i = 0u; i < frame.pictureCount; i++) {
+      const auto& picture = frame.pictures[i];
+
+      resources[i] = { VK_STRUCTURE_TYPE_VIDEO_PICTURE_RESOURCE_INFO_KHR };
+      resources[i].codedOffset = { 0, 0 };
+      resources[i].codedExtent = frame.extents[i];
+      resources[i].baseArrayLayer = 0u;
+      resources[i].imageViewBinding = picture->view();
+
+      dpbInfos[i] = { VK_STRUCTURE_TYPE_VIDEO_DECODE_H264_DPB_SLOT_INFO_KHR };
+      dpbInfos[i].pStdReferenceInfo = &frame.refInfo[i];
+
+      beginSlots[i] = { VK_STRUCTURE_TYPE_VIDEO_REFERENCE_SLOT_INFO_KHR };
+      beginSlots[i].slotIndex = i ? frame.slots[i] : -1;
+      beginSlots[i].pPictureResource = &resources[i];
+
+      refSlots[i] = { VK_STRUCTURE_TYPE_VIDEO_REFERENCE_SLOT_INFO_KHR, &dpbInfos[i] };
+      refSlots[i].slotIndex = frame.slots[i];
+      refSlots[i].pPictureResource = &resources[i];
+
+      VkImageLayout defaultLayout = picture->image()->info().layout;
+
+      acquire[i] = { VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER_2 };
+      acquire[i].srcStageMask = VK_PIPELINE_STAGE_2_NONE;
+      acquire[i].srcAccessMask = VK_ACCESS_2_NONE;
+      acquire[i].dstStageMask = VK_PIPELINE_STAGE_2_VIDEO_DECODE_BIT_KHR;
+      acquire[i].dstAccessMask = VK_ACCESS_2_VIDEO_DECODE_READ_BIT_KHR | VK_ACCESS_2_VIDEO_DECODE_WRITE_BIT_KHR;
+      acquire[i].oldLayout = defaultLayout;
+      acquire[i].newLayout = VK_IMAGE_LAYOUT_VIDEO_DECODE_DPB_KHR;
+      acquire[i].srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+      acquire[i].dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+      acquire[i].image = picture->image()->handle();
+      acquire[i].subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0u, 1u, picture->layer(), 1u };
+
+      release[i] = acquire[i];
+      release[i].srcStageMask = VK_PIPELINE_STAGE_2_VIDEO_DECODE_BIT_KHR;
+      release[i].srcAccessMask = VK_ACCESS_2_VIDEO_DECODE_WRITE_BIT_KHR;
+      release[i].dstStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+      release[i].dstAccessMask = VK_ACCESS_2_NONE;
+      release[i].oldLayout = VK_IMAGE_LAYOUT_VIDEO_DECODE_DPB_KHR;
+      release[i].newLayout = defaultLayout;
+    }
+
+    VkVideoDecodeH264PictureInfoKHR h264Info = { VK_STRUCTURE_TYPE_VIDEO_DECODE_H264_PICTURE_INFO_KHR };
+    h264Info.pStdPictureInfo = &frame.picInfo;
+    h264Info.sliceCount = frame.sliceCount;
+    h264Info.pSliceOffsets = frame.sliceOffsets.data();
+
+    VkVideoDecodeInfoKHR decodeInfo = { VK_STRUCTURE_TYPE_VIDEO_DECODE_INFO_KHR, &h264Info };
+    decodeInfo.srcBuffer = m_bitstreamBuffer;
+    decodeInfo.srcBufferOffset = frame.srcOffset;
+    decodeInfo.srcBufferRange = frame.srcRange;
+    decodeInfo.dstPictureResource = resources[0];
+    decodeInfo.pSetupReferenceSlot = &refSlots[0];
+    decodeInfo.referenceSlotCount = frame.pictureCount - 1u;
+    decodeInfo.pReferenceSlots = &refSlots[1];
+
+    VkCommandBufferBeginInfo cmdBegin = { VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO };
+    cmdBegin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+
+    vk->vkResetCommandBuffer(slot.cmd, 0u);
+    vk->vkBeginCommandBuffer(slot.cmd, &cmdBegin);
+
+    VkDependencyInfo depInfo = { VK_STRUCTURE_TYPE_DEPENDENCY_INFO };
+    depInfo.imageMemoryBarrierCount = frame.pictureCount;
+    depInfo.pImageMemoryBarriers = acquire.data();
+    vk->vkCmdPipelineBarrier2(slot.cmd, &depInfo);
+
+    VkVideoBeginCodingInfoKHR beginInfo = { VK_STRUCTURE_TYPE_VIDEO_BEGIN_CODING_INFO_KHR };
+    beginInfo.videoSession = m_session;
+    beginInfo.videoSessionParameters = frame.params;
+    beginInfo.referenceSlotCount = frame.pictureCount;
+    beginInfo.pReferenceSlots = beginSlots.data();
+
+    vk->vkCmdBeginVideoCodingKHR(slot.cmd, &beginInfo);
+
+    if (std::exchange(m_needsReset, false)) {
+      VkVideoCodingControlInfoKHR control = { VK_STRUCTURE_TYPE_VIDEO_CODING_CONTROL_INFO_KHR };
+      control.flags = VK_VIDEO_CODING_CONTROL_RESET_BIT_KHR;
+      vk->vkCmdControlVideoCodingKHR(slot.cmd, &control);
+    }
+
+    vk->vkCmdDecodeVideoKHR(slot.cmd, &decodeInfo);
+
+    VkVideoEndCodingInfoKHR endInfo = { VK_STRUCTURE_TYPE_VIDEO_END_CODING_INFO_KHR };
+    vk->vkCmdEndVideoCodingKHR(slot.cmd, &endInfo);
+
+    depInfo.pImageMemoryBarriers = release.data();
+    vk->vkCmdPipelineBarrier2(slot.cmd, &depInfo);
+
+    vk->vkEndCommandBuffer(slot.cmd);
+
+    // Submit: wait for the graphics work, signal the decode fence
+    VkSemaphoreSubmitInfo waitInfo = { VK_STRUCTURE_TYPE_SEMAPHORE_SUBMIT_INFO };
+    waitInfo.semaphore = m_graphicsFence->handle();
+    waitInfo.value = m_graphicsValue;
+    waitInfo.stageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+
+    VkSemaphoreSubmitInfo signalInfo = { VK_STRUCTURE_TYPE_SEMAPHORE_SUBMIT_INFO };
+    signalInfo.semaphore = m_decodeFence->handle();
+    signalInfo.value = frame.fenceValue;
+    signalInfo.stageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+
+    VkCommandBufferSubmitInfo cmdInfo = { VK_STRUCTURE_TYPE_COMMAND_BUFFER_SUBMIT_INFO };
+    cmdInfo.commandBuffer = slot.cmd;
+
+    VkSubmitInfo2 submitInfo = { VK_STRUCTURE_TYPE_SUBMIT_INFO_2 };
+    submitInfo.waitSemaphoreInfoCount = 1u;
+    submitInfo.pWaitSemaphoreInfos = &waitInfo;
+    submitInfo.commandBufferInfoCount = 1u;
+    submitInfo.pCommandBufferInfos = &cmdInfo;
+    submitInfo.signalSemaphoreInfoCount = 1u;
+    submitInfo.pSignalSemaphoreInfos = &signalInfo;
+
+    vr = vk->vkQueueSubmit2(m_device->queues().videoDecode.queueHandle, 1u, &submitInfo, VK_NULL_HANDLE);
+
+    if (vr != VK_SUCCESS)
+      Logger::err(str::format("D3D11VideoDecoder: Decode submission failed: ", vr));
+
+    m_submittedValue.store(frame.fenceValue, std::memory_order_release);
+
+    // Subsequent graphics work sees the decoded picture
+    ctx->waitFence(m_decodeFence, frame.fenceValue);
+  }
+
+
+  D3D11VideoDecoder::D3D11VideoDecoder(
+          D3D11Device*                    pDevice,
+    const D3D11_VIDEO_DECODER_DESC&       Desc,
+    const D3D11_VIDEO_DECODER_CONFIG&     Config)
+  : D3D11DeviceChild<ID3D11VideoDecoder>(pDevice),
+    m_desc(Desc), m_config(Config) {
+    if (!IsSupported(pDevice, Desc))
+      throw DxvkError("D3D11VideoDecoder: Unsupported decoder description");
+
+    if (Config.ConfigBitstreamRaw != 1u && Config.ConfigBitstreamRaw != 2u)
+      throw DxvkError("D3D11VideoDecoder: Unsupported bitstream configuration");
+
+    VkExtent2D codedExtent = { align(Desc.SampleWidth, 16u), align(Desc.SampleHeight, 16u) };
+    m_core = new D3D11VideoDecoderCore(pDevice->GetDXVKDevice(), codedExtent);
+
+    m_picParams.resize(sizeof(DXVA_PicParams_H264));
+    m_qmatrix.resize(sizeof(DXVA_Qmatrix_H264));
+    m_sliceControl.resize(D3D11VideoDecoderCore::MaxSlices * DXVA_Slice_H264_Long_Size);
+  }
+
+
+  D3D11VideoDecoder::~D3D11VideoDecoder() {
+    // The core outlives queued decodes and destroys retired
+    // parameters once the last decode has completed.
+    uint32_t lastSlot = (m_slotIndex + D3D11VideoDecoderCore::SlotCount - 1u) % D3D11VideoDecoderCore::SlotCount;
+
+    if (m_params)
+      m_core->slot(lastSlot).retiredParams.push_back(m_params);
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D11VideoDecoder::QueryInterface(
+          REFIID                  riid,
+          void**                  ppvObject) {
+    if (riid == __uuidof(IUnknown)
+     || riid == __uuidof(ID3D11DeviceChild)
+     || riid == __uuidof(ID3D11VideoDecoder)) {
+      *ppvObject = ref(this);
+      return S_OK;
+    }
+
+    if (logQueryInterfaceError(__uuidof(ID3D11VideoDecoder), riid)) {
+      Logger::warn("D3D11VideoDecoder::QueryInterface: Unknown interface query");
+      Logger::warn(str::format(riid));
+    }
+
+    return E_NOINTERFACE;
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D11VideoDecoder::GetCreationParameters(
+          D3D11_VIDEO_DECODER_DESC*   pVideoDesc,
+          D3D11_VIDEO_DECODER_CONFIG* pConfig) {
+    if (pVideoDesc)
+      *pVideoDesc = m_desc;
+
+    if (pConfig)
+      *pConfig = m_config;
+
+    return S_OK;
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D11VideoDecoder::GetDriverHandle(
+          HANDLE*                 pDriverHandle) {
+    if (!pDriverHandle)
+      return E_INVALIDARG;
+
+    *pDriverHandle = reinterpret_cast<HANDLE>(this);
+    return S_OK;
+  }
+
+
+  HRESULT D3D11VideoDecoder::GetBuffer(
+          D3D11ImmediateContext*          pContext,
+          D3D11_VIDEO_DECODER_BUFFER_TYPE Type,
+          UINT*                           pBufferSize,
+          void**                          ppBuffer) {
+    if (!pBufferSize || !ppBuffer)
+      return E_INVALIDARG;
+
+    switch (Type) {
+      case D3D11_VIDEO_DECODER_BUFFER_PICTURE_PARAMETERS:
+        *ppBuffer = m_picParams.data();
+        *pBufferSize = m_picParams.size();
+        return S_OK;
+
+      case D3D11_VIDEO_DECODER_BUFFER_INVERSE_QUANTIZATION_MATRIX:
+        *ppBuffer = m_qmatrix.data();
+        *pBufferSize = m_qmatrix.size();
+        return S_OK;
+
+      case D3D11_VIDEO_DECODER_BUFFER_SLICE_CONTROL:
+        *ppBuffer = m_sliceControl.data();
+        *pBufferSize = m_sliceControl.size();
+        return S_OK;
+
+      case D3D11_VIDEO_DECODER_BUFFER_BITSTREAM: {
+        m_core->waitSlot(pContext, m_slotIndex);
+
+        // A frame may come in several submits (Chromium submits when its
+        // buffer fills up): hand out the rest of the slot after what earlier
+        // submits of this frame used.
+        VkDeviceSize used = std::min<VkDeviceSize>(m_bitstreamUsed, m_core->bitstreamSlotSize());
+        *ppBuffer = m_core->bitstreamPtr(m_core->slot(m_slotIndex)) + used;
+        *pBufferSize = UINT(m_core->bitstreamSlotSize() - used);
+        return S_OK;
+      }
+
+      default:
+        return E_INVALIDARG;
+    }
+  }
+
+
+  HRESULT D3D11VideoDecoder::ReleaseBuffer(
+          D3D11_VIDEO_DECODER_BUFFER_TYPE Type) {
+    return S_OK;
+  }
+
+
+  HRESULT D3D11VideoDecoder::BeginFrame(
+          D3D11ImmediateContext*          pContext,
+          ID3D11VideoDecoderOutputView*   pView) {
+    if (!pView)
+      return E_INVALIDARG;
+
+    m_core->waitSlot(pContext, m_slotIndex);
+
+    m_current = static_cast<D3D11VideoDecoderOutputView*>(pView)->GetPicture();
+    m_inFrame = true;
+
+    m_hasPicParams = false;
+    m_hasQmatrix = false;
+    m_bitstreamUsed = 0u;
+    m_sliceOffsets.clear();
+    return S_OK;
+  }
+
+
+  HRESULT D3D11VideoDecoder::SubmitBuffers(
+          UINT                            NumBuffers,
+    const D3D11_VIDEO_DECODER_BUFFER_DESC* pBufferDescs) {
+    if (!m_inFrame)
+      return E_FAIL;
+
+    // Slice locations are relative to this submit's bitstream buffer, which
+    // starts where the previous submits of the frame ended.
+    VkDeviceSize bitstreamBase = m_bitstreamUsed;
+    const D3D11_VIDEO_DECODER_BUFFER_DESC* sliceDesc = nullptr;
+
+    for (uint32_t i = 0u; i < NumBuffers; i++) {
+      const auto& desc = pBufferDescs[i];
+
+      switch (desc.BufferType) {
+        case D3D11_VIDEO_DECODER_BUFFER_PICTURE_PARAMETERS:
+          m_hasPicParams = desc.DataSize >= sizeof(DXVA_PicParams_H264);
+          break;
+
+        case D3D11_VIDEO_DECODER_BUFFER_INVERSE_QUANTIZATION_MATRIX:
+          m_hasQmatrix = desc.DataSize >= sizeof(DXVA_Qmatrix_H264);
+          break;
+
+        case D3D11_VIDEO_DECODER_BUFFER_SLICE_CONTROL:
+          sliceDesc = &desc;
+          break;
+
+        case D3D11_VIDEO_DECODER_BUFFER_BITSTREAM:
+          m_bitstreamUsed = std::min<VkDeviceSize>(bitstreamBase + desc.DataOffset + desc.DataSize,
+            m_core->bitstreamSlotSize());
+          break;
+
+        default:
+          break;
+      }
+    }
+
+    if (sliceDesc) {
+      // The short and long slice formats start alike.
+      size_t stride = m_config.ConfigBitstreamRaw == 1u
+        ? DXVA_Slice_H264_Long_Size
+        : sizeof(DXVA_Slice_H264_Short);
+
+      size_t end = std::min<size_t>(size_t(sliceDesc->DataOffset) + sliceDesc->DataSize, m_sliceControl.size());
+
+      for (size_t offset = sliceDesc->DataOffset; offset + stride <= end; offset += stride) {
+        if (m_sliceOffsets.size() >= D3D11VideoDecoderCore::MaxSlices) {
+          Logger::warn("D3D11VideoDecoder: Too many slices, dropping the rest");
+          break;
+        }
+
+        const auto* slice = reinterpret_cast<const DXVA_Slice_H264_Short*>(&m_sliceControl[offset]);
+        m_sliceOffsets.push_back(uint32_t(bitstreamBase + slice->BSNALunitDataLocation));
+      }
+    }
+
+    return S_OK;
+  }
+
+
+  HRESULT D3D11VideoDecoder::EndFrame(
+          D3D11ImmediateContext*          pContext) {
+    if (!m_inFrame)
+      return E_FAIL;
+
+    m_inFrame = false;
+
+    HRESULT hr = EndFrameH264(pContext);
+    m_current = nullptr;
+    return hr;
+  }
+
+
+  HRESULT D3D11VideoDecoder::EndFrameH264(
+          D3D11ImmediateContext*          pContext) {
+    uint32_t sliceCount = uint32_t(m_sliceOffsets.size());
+
+    if (!m_hasPicParams || !sliceCount || !m_bitstreamUsed || !m_current) {
+      Logger::err("D3D11VideoDecoder: Frame is missing picture parameters, slices or bitstream");
+      return E_INVALIDARG;
+    }
+
+    const auto* pp = reinterpret_cast<const DXVA_PicParams_H264*>(m_picParams.data());
+
+    auto& slot = m_core->slot(m_slotIndex);
+    uint8_t* bitstream = m_core->bitstreamPtr(slot);
+
+    // Pad to the size alignment with zeros (trailing zero bytes are legal
+    // between NAL units).
+    VkDeviceSize dataSize = m_bitstreamUsed;
+    VkDeviceSize srcRange = std::min(align(dataSize, m_core->bitstreamSizeAlignment()), m_core->bitstreamSlotSize());
+    std::memset(bitstream + dataSize, 0, srcRange - dataSize);
+
+    D3D11VideoDecodeFrame frame;
+    frame.sliceCount = sliceCount;
+
+    for (uint32_t i = 0u; i < sliceCount; i++)
+      frame.sliceOffsets[i] = m_sliceOffsets[i];
+
+    // IDR pictures are not flagged in DXVA; look at the first NAL header.
+    bool idr = false;
+
+    for (VkDeviceSize i = frame.sliceOffsets[0]; i + 3u < dataSize && i < frame.sliceOffsets[0] + 8u; i++) {
+      if (bitstream[i] == 0u && bitstream[i + 1u] == 0u && bitstream[i + 2u] == 1u) {
+        idr = (bitstream[i + 3u] & 0x1fu) == 5u;
+        break;
+      }
+    }
+
+    // Sequence and picture parameter sets
+    StdVideoH264SequenceParameterSet sps = { };
+    sps.flags.direct_8x8_inference_flag = pp->direct_8x8_inference_flag;
+    sps.flags.mb_adaptive_frame_field_flag = pp->MbaffFrameFlag;
+    sps.flags.frame_mbs_only_flag = pp->frame_mbs_only_flag;
+    sps.flags.delta_pic_order_always_zero_flag = pp->delta_pic_order_always_zero_flag;
+    sps.profile_idc = STD_VIDEO_H264_PROFILE_IDC_HIGH;
+    sps.level_idc = STD_VIDEO_H264_LEVEL_IDC_5_2;
+    sps.chroma_format_idc = StdVideoH264ChromaFormatIdc(pp->chroma_format_idc);
+    sps.seq_parameter_set_id = 0u;
+    sps.bit_depth_luma_minus8 = pp->bit_depth_luma_minus8;
+    sps.bit_depth_chroma_minus8 = pp->bit_depth_chroma_minus8;
+    sps.log2_max_frame_num_minus4 = pp->log2_max_frame_num_minus4;
+    sps.pic_order_cnt_type = StdVideoH264PocType(pp->pic_order_cnt_type);
+    sps.log2_max_pic_order_cnt_lsb_minus4 = pp->log2_max_pic_order_cnt_lsb_minus4;
+    sps.max_num_ref_frames = std::max<uint8_t>(pp->num_ref_frames, 1u);
+    sps.pic_width_in_mbs_minus1 = pp->wFrameWidthInMbsMinus1;
+    sps.pic_height_in_map_units_minus1 = pp->frame_mbs_only_flag
+      ? pp->wFrameHeightInMbsMinus1
+      : (pp->wFrameHeightInMbsMinus1 + 1u) / 2u - 1u;
+
+    StdVideoH264ScalingLists scaling = { };
+    bool hasScaling = m_hasQmatrix;
+
+    if (hasScaling) {
+      const auto* qm = reinterpret_cast<const DXVA_Qmatrix_H264*>(m_qmatrix.data());
+
+      // DXVA and Vulkan both store the lists in bitstream (zigzag) order;
+      // DXVA has the two luma 8x8 lists of 4:2:0, intra then inter.
+      scaling.scaling_list_present_mask = 0xffu;
+      scaling.use_default_scaling_matrix_mask = 0u;
+      std::memcpy(scaling.ScalingList4x4, qm->bScalingLists4x4, sizeof(qm->bScalingLists4x4));
+      std::memcpy(scaling.ScalingList8x8[0], qm->bScalingLists8x8[0], 64u);
+      std::memcpy(scaling.ScalingList8x8[1], qm->bScalingLists8x8[1], 64u);
+    }
+
+    StdVideoH264PictureParameterSet pps = { };
+    pps.flags.transform_8x8_mode_flag = pp->transform_8x8_mode_flag;
+    pps.flags.redundant_pic_cnt_present_flag = pp->redundant_pic_cnt_present_flag;
+    pps.flags.constrained_intra_pred_flag = pp->constrained_intra_pred_flag;
+    pps.flags.deblocking_filter_control_present_flag = pp->deblocking_filter_control_present_flag;
+    pps.flags.weighted_pred_flag = pp->weighted_pred_flag;
+    pps.flags.bottom_field_pic_order_in_frame_present_flag = pp->pic_order_present_flag;
+    pps.flags.entropy_coding_mode_flag = pp->entropy_coding_mode_flag;
+    pps.flags.pic_scaling_matrix_present_flag = hasScaling;
+    pps.seq_parameter_set_id = 0u;
+    pps.pic_parameter_set_id = 0u;
+    pps.num_ref_idx_l0_default_active_minus1 = pp->num_ref_idx_l0_active_minus1;
+    pps.num_ref_idx_l1_default_active_minus1 = pp->num_ref_idx_l1_active_minus1;
+    pps.weighted_bipred_idc = StdVideoH264WeightedBipredIdc(pp->weighted_bipred_idc);
+    pps.pic_init_qp_minus26 = pp->pic_init_qp_minus26;
+    pps.pic_init_qs_minus26 = pp->pic_init_qs_minus26;
+    pps.chroma_qp_index_offset = pp->chroma_qp_index_offset;
+    pps.second_chroma_qp_index_offset = pp->second_chroma_qp_index_offset;
+
+    if (!m_params || std::memcmp(&sps, &m_sps, sizeof(sps))
+     || std::memcmp(&pps, &m_pps, sizeof(pps))
+     || std::memcmp(&scaling, &m_scaling, sizeof(scaling))) {
+      m_sps = sps;
+      m_pps = pps;
+      m_scaling = scaling;
+
+      StdVideoH264PictureParameterSet ppsWithLists = pps;
+      ppsWithLists.pScalingLists = &m_scaling;
+
+      VkVideoSessionParametersKHR params = m_core->createParameters(m_sps, ppsWithLists);
+
+      if (!params)
+        return E_FAIL;
+
+      // Earlier frames may still use the old parameters; this slot's
+      // decode completes after theirs, so retire them with it.
+      if (m_params)
+        slot.retiredParams.push_back(m_params);
+
+      m_params = params;
+    }
+
+    // DPB: references first, then a slot for the current picture
+    uint32_t curIndex = pp->CurrPic.Index7Bits;
+    bool fieldPic = pp->field_pic_flag;
+
+    m_surfaces[curIndex].picture = m_current;
+
+    frame.pictures[0] = m_current;
+    frame.pictureCount = 1u;
+
+    uint32_t usedSlots = 0u;
+    std::array<bool, 128> referenced = { };
+
+    for (uint32_t i = 0u; i < 16u; i++) {
+      const auto& entry = pp->RefFrameList[i];
+
+      if (entry.bPicEntry == 0xffu)
+        continue;
+
+      uint32_t fieldFlags = (pp->UsedForReferenceFlags >> (2u * i)) & 3u;
+      uint32_t index = entry.Index7Bits;
+
+      if (!fieldFlags || index == curIndex)
+        continue;
+
+      const auto& surface = m_surfaces[index];
+
+      if (surface.picture == nullptr || surface.slot < 0 || (usedSlots & (1u << surface.slot)))
+        continue;
+
+      referenced[index] = true;
+      usedSlots |= 1u << surface.slot;
+
+      uint32_t n = frame.pictureCount++;
+      frame.pictures[n] = surface.picture;
+      frame.slots[n] = surface.slot;
+
+      auto& ref = frame.refInfo[n];
+      ref.flags.top_field_flag = fieldPic && (fieldFlags & 1u);
+      ref.flags.bottom_field_flag = fieldPic && (fieldFlags & 2u);
+      ref.flags.used_for_long_term_reference = entry.AssociatedFlag;
+      ref.flags.is_non_existing = (pp->NonExistingFrameFlags >> i) & 1u;
+      ref.FrameNum = pp->FrameNumList[i];
+      ref.PicOrderCnt[0] = pp->FieldOrderCntList[i][0];
+      ref.PicOrderCnt[1] = pp->FieldOrderCntList[i][1];
+    }
+
+    // Surfaces that left the DPB give up their slot
+    for (uint32_t i = 0u; i < m_surfaces.size(); i++) {
+      if (!referenced[i] && i != curIndex)
+        m_surfaces[i].slot = -1;
+    }
+
+    int32_t curSlot = m_surfaces[curIndex].slot;
+
+    if (curSlot < 0 || (usedSlots & (1u << curSlot))) {
+      curSlot = -1;
+
+      for (uint32_t i = 0u; i < m_core->maxDpbSlots() && curSlot < 0; i++) {
+        if (!(usedSlots & (1u << i)))
+          curSlot = int32_t(i);
+      }
+
+      if (curSlot < 0) {
+        Logger::err("D3D11VideoDecoder: Out of DPB slots");
+        return E_FAIL;
+      }
+    }
+
+    m_surfaces[curIndex].slot = curSlot;
+    frame.slots[0] = curSlot;
+
+    auto& cur = frame.refInfo[0];
+    cur.flags.top_field_flag = fieldPic && !pp->CurrPic.AssociatedFlag;
+    cur.flags.bottom_field_flag = fieldPic && pp->CurrPic.AssociatedFlag;
+    cur.FrameNum = pp->frame_num;
+    cur.PicOrderCnt[0] = pp->CurrFieldOrderCnt[0];
+    cur.PicOrderCnt[1] = pp->CurrFieldOrderCnt[1];
+
+    VkExtent2D coded = { (pp->wFrameWidthInMbsMinus1 + 1u) * 16u, (pp->wFrameHeightInMbsMinus1 + 1u) * 16u };
+
+    for (uint32_t i = 0u; i < frame.pictureCount; i++) {
+      VkExtent2D extent = frame.pictures[i]->extent();
+      frame.extents[i] = { std::min(coded.width, extent.width), std::min(coded.height, extent.height) };
+    }
+
+    // Picture info
+    frame.picInfo.flags.field_pic_flag = fieldPic;
+    frame.picInfo.flags.is_intra = pp->IntraPicFlag;
+    frame.picInfo.flags.IdrPicFlag = idr;
+    frame.picInfo.flags.bottom_field_flag = fieldPic && pp->CurrPic.AssociatedFlag;
+    frame.picInfo.flags.is_reference = pp->RefPicFlag;
+    frame.picInfo.flags.complementary_field_pair = 0u;
+    frame.picInfo.seq_parameter_set_id = 0u;
+    frame.picInfo.pic_parameter_set_id = 0u;
+    frame.picInfo.frame_num = pp->frame_num;
+    frame.picInfo.idr_pic_id = 0u;
+    frame.picInfo.PicOrderCnt[0] = pp->CurrFieldOrderCnt[0];
+    frame.picInfo.PicOrderCnt[1] = pp->CurrFieldOrderCnt[1];
+
+    // Hand everything to the CS thread
+    frame.slotIndex = m_slotIndex;
+    frame.fenceValue = m_core->allocFenceValue();
+    frame.params = m_params;
+    frame.srcOffset = slot.bitstreamOffset;
+    frame.srcRange = srcRange;
+
+    slot.fenceValue = frame.fenceValue;
+    slot.pictures.assign(frame.pictures.begin(), frame.pictures.begin() + frame.pictureCount);
+
+    pContext->EmitCs([
+      cCore   = m_core,
+      cFrame  = std::move(frame)
+    ] (DxvkContext* ctx) {
+      cCore->submit(ctx, cFrame);
+    });
+
+    // Hand the decode to the CS thread right away. A decoder does not
+    // present, so nothing else would dispatch the chunk until it fills up,
+    // and the GPU would only see decodes in bursts.
+    pContext->FlushCsChunk();
+
+    m_slotIndex = (m_slotIndex + 1u) % D3D11VideoDecoderCore::SlotCount;
+    m_frameCount += 1u;
+    return S_OK;
+  }
+
+
+  bool D3D11VideoDecoder::IsSupported(
+          D3D11Device*                    pDevice,
+    const D3D11_VIDEO_DECODER_DESC&       Desc) {
+    if (!pDevice->GetDXVKDevice()->canUseVideoDecode())
+      return false;
+
+    if (Desc.Guid != D3D11_VK_DECODER_PROFILE_H264_VLD_NOFGT)
+      return false;
+
+    if (Desc.OutputFormat != DXGI_FORMAT_NV12)
+      return false;
+
+    return Desc.SampleWidth && Desc.SampleHeight
+        && Desc.SampleWidth <= 4096u && Desc.SampleHeight <= 4096u;
+  }
+
+}
