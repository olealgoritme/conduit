diff --git a/src/dxvk/dxvk_helios_spin.h b/src/dxvk/dxvk_helios_spin.h
new file mode 100644
index 00000000..4936574f
--- /dev/null
+++ b/src/dxvk/dxvk_helios_spin.h
@@ -0,0 +1,68 @@
+#pragma once
+
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+
+#if defined(_MSC_VER) || defined(__x86_64__) || defined(__i386__)
+#include <immintrin.h>
+#endif
+
+#include "../util/util_env.h"
+
+namespace dxvk::helios_spin {
+
+  /**
+   * \brief Spin budget before a DXVK worker or waiter blocks, in microseconds
+   *
+   * HELIOS_DXVK_SPIN_US (process environment): the time a thread polls its
+   * queue or counter before it waits on the condition variable. Under a
+   * hypervisor, waking a thread that sleeps on another vCPU costs an IPI and
+   * a VM exit on the waking thread (Conduit 382.1 Heaven profile:
+   * HalpInterruptSendIpi 2.7% of the app process, ~17 CS chunk dispatches per
+   * frame into a CS thread that is 78% idle). A short poll catches the next
+   * chunk of a burst without that wake. 0 (the default) disables it; at most
+   * 1000.
+   */
+  inline uint32_t budgetUs() {
+    static const uint32_t us = [] {
+      const std::string v = env::getEnvVar("HELIOS_DXVK_SPIN_US");
+      if (v.empty())
+        return 0u;
+      const unsigned long n = std::strtoul(v.c_str(), nullptr, 10);
+      return uint32_t(n > 1000ul ? 1000ul : n);
+    }();
+    return us;
+  }
+
+  inline void pause() {
+#if defined(_MSC_VER) || defined(__x86_64__) || defined(__i386__)
+    _mm_pause();
+#endif
+  }
+
+  /**
+   * \brief Polls \c done for up to \ref budgetUs microseconds
+   *
+   * Call with no lock held. \c done must be cheap and lock-free (atomic
+   * loads). Returns whether it became true; a false return means the caller
+   * waits on its condition variable as before, so the spin never changes
+   * what is waited for, only how long the thread stays awake first.
+   */
+  template<typename Pred>
+  bool until(Pred&& done) {
+    const uint32_t us = budgetUs();
+    if (!us)
+      return done();
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::microseconds(us);
+    for (uint32_t i = 0u; ; i++) {
+      if (done())
+        return true;
+      // The clock read costs more than a poll: every 32 polls.
+      if ((i & 31u) == 31u && std::chrono::steady_clock::now() >= deadline)
+        return done();
+      pause();
+    }
+  }
+
+}
