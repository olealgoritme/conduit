+++ b/src/dxvk/dxvk_image.h
@@ -1100,6 +1100,9 @@ namespace dxvk {
 
     bool                        m_unifiedLayoutEnabled = false;
     bool                        m_unifiedLayoutAvailable = false;
+    // Helios NVK: the device enabled VK_EXT_image_drm_format_modifier, so a
+    // LINEAR foreign surface imports with the recorded layout (patch 0010)
+    bool                        m_heliosDrmModifiers = false;
 
     Rc<DxvkKeyedMutex>          m_mutex       = nullptr;
 
