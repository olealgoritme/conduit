diff --git a/src/dxvk/dxvk_context.h b/src/dxvk/dxvk_context.h
index 5fb677e5..9f525221 100644
--- a/src/dxvk/dxvk_context.h
+++ b/src/dxvk/dxvk_context.h
@@ -1849,6 +1849,30 @@ namespace dxvk {
 
     DxvkDescriptorCopyWorker m_descriptorWorker;
 
+    /**
+     * \brief Helios: what the last write of a descriptor set held
+     *
+     * HELIOS_DXVK_DESCRIPTOR_REUSE=1 (default off). A dirty set is written
+     * whole into new descriptor memory, but only the bindings whose stage
+     * and class (buffer or view) are dirty changed since its last write.
+     * The others take the descriptor pointer or the uniform buffer range
+     * stored here, without looking up the resource and tracking it again.
+     * Valid for the layout and the submission (tracking ID) it was written
+     * in; every new command list, render pass and pipeline dirties all
+     * graphics stages, so the first write after one is a full write.
+     */
+    struct HeliosDescriptorReuse {
+      const DxvkPipelineBindings*           layout      = nullptr;
+      const DxvkDescriptorSetLayout*        setLayout   = nullptr;
+      uint64_t                              trackingId  = 0u;
+      std::vector<const DxvkDescriptor*>    descriptors;
+      std::vector<DxvkDescriptorCopyBuffer> buffers;
+      std::vector<uint8_t>                  reusable;
+    };
+
+    std::array<std::array<HeliosDescriptorReuse, DxvkDescriptorSets::SetCount>, 3u> m_heliosDescriptorReuse;
+    bool                    m_heliosDescriptorReuseOn = false;
+
     Rc<DxvkLatencyTracker>  m_latencyTracker;
     uint64_t                m_latencyFrameId = 0u;
     bool                    m_endLatencyTracking = false;
