diff --git a/src/dxvk/dxvk_helios_backend.h b/src/dxvk/dxvk_helios_backend.h
new file mode 100644
index 00000000..653f208a
--- /dev/null
+++ b/src/dxvk/dxvk_helios_backend.h
@@ -0,0 +1,57 @@
+#pragma once
+
+#include <cstdlib>
+#include <cstring>
+
+#include "../vulkan/vulkan_loader.h"
+
+namespace dxvk {
+
+  /**
+   * \brief Helios: the Vulkan ICD under this engine is NVK on RM
+   *
+   * Set by the Helios UMD (HELIOS_DXVK_BACKEND=nvk) before it creates an
+   * instance on NVK (Conduit guest/windows/docs/dxvk-on-nvk.md, stage S3).
+   * The Venus-only paths then stay off: shared images are not exported as
+   * OPAQUE_FD/DMA_BUF (NVK has no external memory on Windows) but allocated
+   * dedicated with the Helios export request, from which NVK makes a KMD
+   * resource id; nothing is imported by Venus resource id.
+   *
+   * Read on every call, not cached: a process whose NVK device failed falls
+   * back to Venus and clears the variable.
+   */
+  inline bool heliosBackendNvk() {
+    const char* value = std::getenv("HELIOS_DXVK_BACKEND");
+    return value && !std::strcmp(value, "nvk");
+  }
+
+  /**
+   * \brief Helios: Venus devices may import NVK-made (foreign) resources
+   *
+   * Importing an RM-exported resource id needs an explicit DRM-modifier image
+   * (VK_EXT_image_drm_format_modifier), which the Venus paths otherwise never
+   * enable on DXVK devices. HELIOS_DXVK_FOREIGN_IMPORT=1, set by the UMD from
+   * its ForeignImport knob before the device is created.
+   */
+  inline bool heliosForeignImport() {
+    const char* value = std::getenv("HELIOS_DXVK_FOREIGN_IMPORT");
+    return value && value[0] == '1';
+  }
+
+  /**
+   * \brief VkMemoryAllocateInfo pNext: this memory will need a resource id
+   *
+   * Mirrors helios_export_memory_resource_info in Conduit's
+   * guest/windows/protocol/include/helios_icd_interface.h.
+   */
+  struct HeliosExportMemoryResourceInfo {
+    VkStructureType sType;
+    const void*     pNext;
+    uint32_t        flags;
+    uint32_t        reserved;
+  };
+
+  constexpr VkStructureType VK_STRUCTURE_TYPE_EXPORT_MEMORY_RESOURCE_INFO_HELIOS =
+    VkStructureType(1000384003);
+
+}
diff --git a/src/dxvk/dxvk_image.cpp b/src/dxvk/dxvk_image.cpp
index f656626c..7ce24a2e 100644
--- a/src/dxvk/dxvk_image.cpp
+++ b/src/dxvk/dxvk_image.cpp
@@ -2,6 +2,7 @@
 
 #include "dxvk_buffer.h"
