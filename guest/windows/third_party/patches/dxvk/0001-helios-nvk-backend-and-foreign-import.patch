      && !m_info.heliosDirectImportAlias
      && !m_info.heliosLinearScanoutTarget
      && !m_info.heliosCrossContextOptimal
@@ -625,6 +662,7 @@ namespace dxvk {
     // pixels). If still black, dwm samples a different surface. Device-local imports only
