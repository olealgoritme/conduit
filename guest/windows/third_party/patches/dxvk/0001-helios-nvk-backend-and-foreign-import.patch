 #include <cstdlib>
 
@@ -450,6 +451,41 @@ namespace dxvk {
     const bool heliosKmtShared = heliosKmtOnlySharedResources();
     bool useVulkanExternalMemory = m_shared && !heliosKmtShared;
     bool useHeliosRendererExternalMemory = m_shared && heliosKmtShared;
+
+    // Helios on NVK: no Venus external memory. An exported image gets dedicated
+    // memory with the Helios export request (NVK mints the KMD resource id from
+    // it); an NVK device cannot import a resource made by another device.
+    const bool heliosNvk = m_shared && heliosBackendNvk();
+    if (heliosNvk) {
+      if (m_info.sharing.mode == DxvkSharedHandleMode::Import)
+        throw DxvkError("DxvkImage: NVK cannot import a shared resource");
+      useVulkanExternalMemory = false;
+      useHeliosRendererExternalMemory = false;
+    }
+
+    // Helios on Venus, importing a resource NVK made (an RM-exported dma-buf):
+    // only an explicit DRM-modifier image with the creator's layout reads it.
+    const bool heliosForeign = useHeliosRendererExternalMemory
+      && m_info.sharing.mode == DxvkSharedHandleMode::Import
+      && m_info.sharing.heliosForeign;
+    VkImageDrmFormatModifierExplicitCreateInfoEXT heliosForeignModifier = {
+      VK_STRUCTURE_TYPE_IMAGE_DRM_FORMAT_MODIFIER_EXPLICIT_CREATE_INFO_EXT };
+    VkSubresourceLayout heliosForeignPlane = { };
+    if (heliosForeign) {
+      if (!heliosForeignImport())
+        throw DxvkError("DxvkImage: foreign (NVK) resource import is disabled (ForeignImport knob)");
+      heliosForeignPlane.offset   = m_info.sharing.heliosForeignOffset;
+      heliosForeignPlane.rowPitch = m_info.sharing.heliosForeignStride;
+      heliosForeignModifier.drmFormatModifier = m_info.sharing.heliosForeignModifier;
+      heliosForeignModifier.drmFormatModifierPlaneCount = 1u;
+      heliosForeignModifier.pPlaneLayouts = &heliosForeignPlane;
+      heliosForeignModifier.pNext = std::exchange(imageInfo.pNext, &heliosForeignModifier);
+      imageInfo.tiling = VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT;
+      Logger::info(str::format("DxvkImage: foreign import resid ", m_info.sharing.heliosResourceId,
+        " ", m_info.extent.width, "x", m_info.extent.height, " modifier 0x", std::hex,
+        m_info.sharing.heliosForeignModifier, std::dec, " pitch ",
+        m_info.sharing.heliosForeignStride, " offset ", m_info.sharing.heliosForeignOffset));
+    }
     // Scan-out surfaces and exact WSI aliases use DMA_BUF, matching their
     // resource-id imports; ordinary shared surfaces retain the
     // renderer opaque-fd handle. Both externalInfo.handleTypes and
@@ -457,7 +493,7 @@ namespace dxvk {
