   }
   
   
+  bool D3D11Query::HeliosEventTraceEnabled() {
+    static const bool enabled = env::getEnvVar("HELIOS_DXVK_EVENT_TRACE") == "1";
+    return enabled;
+  }
+
+
+  void D3D11Query::HeliosTraceEnd() {
+    if (m_desc.Query != D3D11_QUERY_EVENT)
+      return;
+
+    m_heliosCs.store(0, std::memory_order_relaxed);
+    m_heliosSubmit.store(0, std::memory_order_relaxed);
+    m_heliosPolls = 0u;
+    m_heliosEnd.store(heliosEventTraceNow(), std::memory_order_relaxed);
+  }
+
+
+  void D3D11Query::HeliosTraceGetData(HRESULT hr) {
+    if (m_desc.Query != D3D11_QUERY_EVENT)
+      return;
+
+    const int64_t end = m_heliosEnd.load(std::memory_order_relaxed);
+
+    if (!end)
+      return;
+
+    m_heliosPolls += 1u;
+
+    if (hr != S_OK)
+      return;
+
+    const int64_t now = heliosEventTraceNow();
+    const int64_t cs = m_heliosCs.load(std::memory_order_relaxed);
+    const int64_t submit = m_heliosSubmit.load(std::memory_order_relaxed);
+    m_heliosEnd.store(0, std::memory_order_relaxed);
+
+    auto& st = heliosEventTraceStats();
+    std::lock_guard lock(st.mutex);
+
+    if (!st.freq) {
+      LARGE_INTEGER f;
+      QueryPerformanceFrequency(&f);
+      st.freq = f.QuadPart;
+      st.lastPrint = now;
+    }
+
+    st.waits += 1u;
+    st.polls += m_heliosPolls;
+    st.endToReady += now - end;
+    st.endToReadyMax = std::max(st.endToReadyMax, now - end);
+
+    if (cs >= end && submit >= cs && now >= submit) {
+      st.withStages += 1u;
+      st.endToCs += cs - end;
+      st.csToSubmit += submit - cs;
+      st.submitToReady += now - submit;
+    }
+
+    if (now - st.lastPrint >= 2 * st.freq) {
+      auto us = [&] (int64_t ticks, uint64_t n) {
+        return n ? double(ticks) * 1e6 / double(st.freq) / double(n) : 0.0;
+      };
+
+      Logger::info(str::format("Helios event trace: ", st.waits, " waits, end->ready ",
+        us(st.endToReady, st.waits), " us (max ", us(st.endToReadyMax, 1), "), ",
+        st.withStages, " staged: end->cs ", us(st.endToCs, st.withStages),
+        " us, cs->submit ", us(st.csToSubmit, st.withStages),
+        " us, submit->ready ", us(st.submitToReady, st.withStages),
+        " us; GetData calls per wait ", st.waits ? double(st.polls) / double(st.waits) : 0.0));
+
+      uint64_t keepFreq = st.freq;
+      st.waits = st.withStages = st.polls = 0u;
+      st.endToCs = st.csToSubmit = st.submitToReady = st.endToReady = st.endToReadyMax = 0;
+      st.freq = keepFreq;
+      st.lastPrint = now;
+    }
+  }
+
+
   UINT64 D3D11Query::GetTimestampQueryFrequency() const {
     const auto& limits = m_parent->GetDXVKDevice()->properties().core.properties.limits;
     return uint64_t(1'000'000'000.0f / limits.timestampPeriod);
