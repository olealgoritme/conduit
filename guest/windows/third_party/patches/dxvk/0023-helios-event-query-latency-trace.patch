 namespace dxvk {
+
+  namespace {
+
+    int64_t heliosEventTraceNow() {
+      LARGE_INTEGER t;
+      QueryPerformanceCounter(&t);
+      return t.QuadPart;
+    }
+
+    /**
+     * Process-wide sums of the traced event waits, logged and reset every
+     * two seconds. Waits complete on the immediate context's GetData under
+     * the device's single-threaded use; the mutex keeps the sums whole if
+     * two contexts' queries complete at once.
+     */
+    struct HeliosEventTraceStats {
+      dxvk::mutex mutex;
+      int64_t  freq      = 0;
+      int64_t  lastPrint = 0;
+      uint64_t waits     = 0;
+      uint64_t withStages = 0;
+      int64_t  endToCs   = 0;
+      int64_t  csToSubmit = 0;
+      int64_t  submitToReady = 0;
+      int64_t  endToReady = 0;
+      int64_t  endToReadyMax = 0;
+      uint64_t polls     = 0;
+    };
+
+    HeliosEventTraceStats& heliosEventTraceStats() {
+      static HeliosEventTraceStats stats;
+      return stats;
+    }
+
+  }
