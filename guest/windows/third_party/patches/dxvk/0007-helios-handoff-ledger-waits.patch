diff --git a/src/dxvk/dxvk_helios_backend.h b/src/dxvk/dxvk_helios_backend.h
index 56224b43..b61fbcbf 100644
--- a/src/dxvk/dxvk_helios_backend.h
+++ b/src/dxvk/dxvk_helios_backend.h
@@ -1,5 +1,7 @@
 #pragma once
 
+#include <atomic>
+#include <cstdint>
 #include <cstdlib>
 #include <cstring>
 
@@ -51,6 +53,33 @@ namespace dxvk {
     uint32_t        reserved;
   };
 
+  /**
+   * \brief Helios: cross-process hand-off ledger hooks
+   *
+   * Installed once by the Helios UMD (Conduit docs/shared-surfaces.md section
+   * 4). `sample` answers the latest hand-off point another process published
+   * for a shared resource (by its KMD resource id), 0 when none; `wait` blocks
+   * until that point's GPU work is done, false on timeout. A read of a shared
+   * image samples at recording time and the submission worker waits before
+   * submitting, so the acquirer of a keyed mutex (or any reader after a
+   * cross-process flush) is ordered behind the releaser's GPU work on any
+   * backend, and nothing blocks the releaser or the adapter's queue.
+   */
+  struct HeliosHandoffHooks {
+    uint64_t (*sample)(uint32_t key);
+    bool (*wait)(uint32_t key, uint64_t point, uint64_t timeoutNs);
+  };
+
+  inline std::atomic<const HeliosHandoffHooks*> g_heliosHandoffHooks = { nullptr };
+
+  inline void heliosSetHandoffHooks(const HeliosHandoffHooks* hooks) {
+    g_heliosHandoffHooks.store(hooks, std::memory_order_release);
+  }
+
+  inline const HeliosHandoffHooks* heliosHandoffHooks() {
+    return g_heliosHandoffHooks.load(std::memory_order_acquire);
+  }
+
   constexpr VkStructureType VK_STRUCTURE_TYPE_EXPORT_MEMORY_RESOURCE_INFO_HELIOS =
     VkStructureType(1000384003);
 
