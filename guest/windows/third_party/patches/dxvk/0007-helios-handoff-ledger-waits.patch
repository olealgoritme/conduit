+      if (const auto* hooks = heliosHandoffHooks()) {
+        for (const auto& wait : m_handoffWaits) {
+          // Bounded: a publisher that died or a lost point costs this list
+          // at most two seconds, never the device.
+          for (uint32_t i = 0; i < 40 && !stopped.load(std::memory_order_acquire); i++) {
