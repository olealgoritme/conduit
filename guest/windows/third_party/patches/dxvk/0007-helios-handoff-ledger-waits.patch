--- a/src/dxvk/dxvk_cmdlist.h
+++ b/src/dxvk/dxvk_cmdlist.h
@@ -417,6 +417,22 @@ namespace dxvk {
 
     VkResult waitProducers(const std::atomic<bool>& stopped);
 
+    /**
+     * \brief Helios: wait for another process's hand-off point
+     *
+     * The submission worker waits (dxvk_helios_backend.h hand-off hooks)
+     * before this list's first submission, beside the producer waits.
+     */
+    void waitHandoff(uint32_t key, uint64_t point) {
+      for (auto& known : m_handoffWaits) {
+        if (known.first == key) {
+          if (point > known.second) known.second = point;
+          return;
+        }
+      }
+      m_handoffWaits.push_back({ key, point });
+    }
+
     void trackProducer(const Rc<HeliosProducerOperation>& operation) {
       m_producerSignals.push_back(operation);
