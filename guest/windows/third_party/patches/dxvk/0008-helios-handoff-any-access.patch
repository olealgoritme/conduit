+  void DxvkCommandList::heliosHandoffSampleImage(DxvkImage* image) {
+    if (!image->info().shared)
+      return;
+    const auto* hooks = heliosHandoffHooks();
+    if (!hooks)
+      return;
+    if (const uint32_t key = image->heliosHandoffKey()) {
+      if (const uint64_t point = hooks->sample(key))
+        waitHandoff(key, point);
+    }
+  }
