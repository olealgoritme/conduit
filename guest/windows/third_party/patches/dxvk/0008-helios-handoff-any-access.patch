+  void DxvkCommandList::heliosHandoffSampleImage(DxvkImage* image) {
+    if (!image->info().shared)
+      return;
+    const auto* hooks = heliosHandoffHooks();
+    if (!hooks)
+      return;
+    const uint32_t key = image->heliosHandoffKey();
+    if (!key)
+      return;
+    if (hooks->sampleAll) {
+      uint64_t points[4];
+      const uint32_t n = hooks->sampleAll(key, points, 4u);
+      for (uint32_t i = 0; i < n && i < 4u; i++)
+        waitHandoff(key, points[i]);
+    } else if (const uint64_t point = hooks->sample(key)) {
+      waitHandoff(key, point);
+    }
+  }
