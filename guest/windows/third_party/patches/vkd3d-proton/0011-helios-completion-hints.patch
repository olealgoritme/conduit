+#ifdef _WIN32
+/* The admission of `op` was seen: note it, and with hints on the time since
+ * the worker last saw batches finish (what the KMD, dxgkrnl's scheduler and
+ * the event took after the hint). */
+static void vkd3d_helios_note_admitted_hinted(struct d3d12_command_queue *queue,
+        struct vkd3d_helios_execution *op)
+{
+    vkd3d_helios_note_admitted(op);
+    if (queue->helios_hint_done_qpc)
+    {
+        InterlockedExchangeAdd64((LONG64 *)&vkd3d_helios_ecl_stats.done_to_admit_sum_us,
+                (LONG64)vkd3d_helios_qpc_us(queue->helios_hint_done_qpc, op->admit_qpc));
+        InterlockedIncrement64((LONG64 *)&vkd3d_helios_ecl_stats.done_to_admit_n);
+        queue->helios_hint_done_qpc = 0;
+    }
+}
+#endif
