+/* Completion hints (patch 0011, Conduit Nvk12CompletionHint). An HE12 v4
+ * packet completes when its batch's ECL fence fires, and that fire travels
+ * from the host (nvidia-drm, the backend's event thread, the virtio event
+ * queue, the KMD's DPC). The worker can see the batch finish sooner: the
+ * producer timeline the batch signals is CPU-visible memory. While a worker
+ * waits for an admission it polls that timeline, and for every batch it saw
+ * finish it hands the batch's ECL fence to `cb` (the UMD), which names it to
+ * the KMD (HELIOS_ESCAPE_ECL_DONE); the KMD then completes the packet without
+ * the host round trip, which is what admits the batch two packets later.
+ * `spin_us` bounds the poll per admission wait; 0 or no callback: off. */
+typedef void (*helios_vkd3d_completion_hint_fn)(const uint32_t *fences, uint32_t count);
+#ifdef _WIN32
+static helios_vkd3d_completion_hint_fn vkd3d_helios_hint_cb;
+static uint32_t vkd3d_helios_hint_spin_us;
+
+void helios_vkd3d_set_completion_hint(helios_vkd3d_completion_hint_fn cb, uint32_t spin_us)
+{
+    if (spin_us > 20000) spin_us = 20000;
+    vkd3d_helios_hint_spin_us = cb ? spin_us : 0;
+    vkd3d_helios_hint_cb = spin_us ? cb : NULL;
+    if (vkd3d_helios_hint_cb)
+        INFO("Helios: completion hints on, admission waits poll for %u us.\n", spin_us);
+}
+
+static bool vkd3d_helios_hints_on(void)
+{
+    return vkd3d_helios_hint_cb != NULL;
+}
+
+/* Caller holds queue_lock: remember batch `value`'s ECL fence (0 = not made
+ * yet; vkd3d_helios_hint_set_fence fills it in). A full ring overwrites its
+ * oldest entry (the worker had no admission to wait for since it was made):
+ * that batch's packet waits for the host's EventReady. */
+static void vkd3d_helios_hint_push_locked(struct d3d12_command_queue *queue, uint64_t value, uint32_t fence)
+{
+    uint32_t n = ARRAY_SIZE(queue->helios_hint.value);
+    if (queue->helios_hint.head - queue->helios_hint.tail >= n)
+    {
+        queue->helios_hint.tail++;
+        InterlockedIncrement64((LONG64 *)&vkd3d_helios_ecl_stats.hint_dropped);
+    }
+    queue->helios_hint.value[queue->helios_hint.head % n] = value;
+    queue->helios_hint.fence[queue->helios_hint.head % n] = fence;
+    queue->helios_hint.head++;
+}
+
+/* The fence of batch `value`, made after its commit. */
+static void vkd3d_helios_hint_set_fence(struct d3d12_command_queue *queue, uint64_t value, uint32_t fence)
+{
+    uint32_t n = ARRAY_SIZE(queue->helios_hint.value), i;
+    pthread_mutex_lock(&queue->queue_lock);
+    for (i = queue->helios_hint.head; i != queue->helios_hint.tail; i--)
+    {
+        if (queue->helios_hint.value[(i - 1) % n] == value)
+        {
+            queue->helios_hint.fence[(i - 1) % n] = fence;
+            break;
+        }
+    }
+    pthread_mutex_unlock(&queue->queue_lock);
+}
+
+/* The worker: name the fences of every batch the producer timeline passed.
+ * One semaphore read when nothing finished since the last call. */
+static void vkd3d_helios_hint_poll(struct d3d12_command_queue *queue)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &queue->device->vk_procs;
+    uint32_t fences[16], n = 0, size = ARRAY_SIZE(queue->helios_hint.value);
+    LARGE_INTEGER qpc;
+    uint64_t done = 0;
+    if (!queue->helios_producer || VK_CALL(vkGetSemaphoreCounterValue(queue->device->vk_device,
+            queue->helios_producer->semaphore, &done)) != VK_SUCCESS || done <= queue->helios_hint_seen)
+        return;
+    queue->helios_hint_seen = done;
+    QueryPerformanceCounter(&qpc);
+    queue->helios_hint_done_qpc = qpc.QuadPart;
+    for (;;)
+    {
+        n = 0;
+        pthread_mutex_lock(&queue->queue_lock);
+        while (queue->helios_hint.tail != queue->helios_hint.head && n < ARRAY_SIZE(fences) &&
+                queue->helios_hint.value[queue->helios_hint.tail % size] <= done)
+        {
+            uint32_t fence = queue->helios_hint.fence[queue->helios_hint.tail % size];
+            if (fence)
+                fences[n++] = fence;
+            queue->helios_hint.tail++;
+        }
+        pthread_mutex_unlock(&queue->queue_lock);
+        if (!n)
+            return;
+        vkd3d_helios_hint_cb(fences, n);
+        InterlockedIncrement64((LONG64 *)&vkd3d_helios_ecl_stats.hint_calls);
+        InterlockedExchangeAdd64((LONG64 *)&vkd3d_helios_ecl_stats.hint_fences, (LONG64)n);
+        if (n < ARRAY_SIZE(fences))
+            return;
+    }
+}
+#else
+void helios_vkd3d_set_completion_hint(helios_vkd3d_completion_hint_fn cb, uint32_t spin_us)
+{
+    (void)cb; (void)spin_us;
+}
+#endif
