+
+static void vkd3d_helios_ts_submit(struct d3d12_command_queue *queue, VkCommandBuffer cmd)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &queue->device->vk_procs;
+    VkCommandBufferSubmitInfo cmd_info = {0};
+    VkSubmitInfo2 submit = {0};
+    VkQueue vk_queue;
+    cmd_info.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_SUBMIT_INFO;
+    cmd_info.commandBuffer = cmd;
+    submit.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO_2;
+    submit.commandBufferInfoCount = 1;
+    submit.pCommandBufferInfos = &cmd_info;
+    if ((vk_queue = vkd3d_queue_acquire(queue->vkd3d_queue)))
+    {
+        VK_CALL(vkQueueSubmit2(vk_queue, 1, &submit, VK_NULL_HANDLE));
+        vkd3d_queue_release(queue->vkd3d_queue);
+    }
+}
+
+/* Worker thread only (the ring and its command pool are the worker's). */
+static void vkd3d_helios_ts_begin(struct d3d12_command_queue *queue, struct vkd3d_helios_execution *op)
+{
+    struct vkd3d_helios_ts *ts;
+    uint32_t i;
+    if (!op || !vkd3d_helios_ts_enabled())
+        return;
+    if (!queue->helios_ts && !(queue->helios_ts = vkd3d_helios_ts_create(queue)))
+        return;
+    ts = queue->helios_ts;
+    i = ts->next;
+    ts->next = (ts->next + 1) % VKD3D_HELIOS_TS_SLOTS;
+    vkd3d_helios_ts_harvest(queue, ts, i);
+    vkd3d_helios_ts_submit(queue, ts->begin[i]);
+    op->ts_slot = i + 1;
+}
+
+static void vkd3d_helios_ts_end(struct d3d12_command_queue *queue, struct vkd3d_helios_execution *op)
+{
+    struct vkd3d_helios_ts *ts = queue->helios_ts;
+    if (!op || !op->ts_slot || !ts)
+        return;
+    vkd3d_helios_ts_submit(queue, ts->end[op->ts_slot - 1]);
+    ts->used[op->ts_slot - 1] = true;
+}
