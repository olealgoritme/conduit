+/* Read slot `i`'s previous pair, if any, into the stats. In ring order, which
+ * is submission order on this queue. */
+static void vkd3d_helios_ts_harvest(struct d3d12_command_queue *queue, struct vkd3d_helios_ts *ts, uint32_t i)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &queue->device->vk_procs;
+    uint64_t data[4], begin, end, busy, gap, start;
+    if (!ts->used[i])
+        return;
+    ts->used[i] = false;
+    if (VK_CALL(vkGetQueryPoolResults(queue->device->vk_device, ts->pool, 2 * i, 2, sizeof(data), data,
+            2 * sizeof(uint64_t), VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WITH_AVAILABILITY_BIT)) < 0 ||
+            !data[1] || !data[3])
+    {
+        vkd3d_helios_ts_stats.unavailable++;
+        ts->last_end = 0;
+        return;
+    }
+    begin = data[0] & ts->mask;
+    end = data[2] & ts->mask;
+    if (end < begin)
+    {
+        vkd3d_helios_ts_stats.unavailable++;
+        ts->last_end = 0;
+        return;
+    }
+    start = ts->last_end && ts->last_end > begin ? ts->last_end : begin;
+    busy = end > start ? (uint64_t)((double)(end - start) * ts->period_ns) : 0;
