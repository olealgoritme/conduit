+/* GPU timestamp counters (HELIOS_VKD3D_GPU_TIMESTAMPS=1): batches, busy sum
+ * (ns), idle-gap sum (ns), busy max (ns), pairs not available, then the busy
+ * and gap histograms (7 buckets each: <50 us, <200 us, <1 ms, <2 ms, <5 ms,
+ * <20 ms, >= 20 ms). Read without a lock (worker-written plain counters).
+ * Returns how many values it wrote. */
+uint32_t helios_vkd3d_gpu_time_stats(uint64_t *out, uint32_t count)
+{
+    uint64_t all[5 + 2 * VKD3D_HELIOS_ECL_BUCKETS];
+    uint32_t i, n = 0;
+    all[n++] = vkd3d_helios_ts_stats.batches;
+    all[n++] = vkd3d_helios_ts_stats.busy_sum_ns;
+    all[n++] = vkd3d_helios_ts_stats.gap_sum_ns;
+    all[n++] = vkd3d_helios_ts_stats.busy_max_ns;
+    all[n++] = vkd3d_helios_ts_stats.unavailable;
+    for (i = 0; i < VKD3D_HELIOS_ECL_BUCKETS; i++)
+        all[n++] = vkd3d_helios_ts_stats.busy_buckets[i];
+    for (i = 0; i < VKD3D_HELIOS_ECL_BUCKETS; i++)
+        all[n++] = vkd3d_helios_ts_stats.gap_buckets[i];
+    n = count < n ? count : n;
+    if (out)
+        memcpy(out, all, n * sizeof(*out));
+    return n;
+}
