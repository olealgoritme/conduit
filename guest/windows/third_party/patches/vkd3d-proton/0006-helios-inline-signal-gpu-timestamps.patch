+#ifdef _WIN32
+/* Fold the producer signal into the batch's last submit (patch 0006): one
+ * NVK submit (a semaphore release with a wait-for-idle and a non-stall
+ * interrupt each) less per ExecuteCommandLists. Only when that submit goes to
+ * this queue (not a fallback queue, whose join still needs the separate
+ * submit's waiter flush). HELIOS_VKD3D_INLINE_SIGNAL=0 turns it off. */
+static bool vkd3d_helios_inline_signal_enabled(void)
+{
+    static int enabled = -1;
+    char env[8];
+    if (enabled < 0)
+        enabled = !(vkd3d_get_env_var("HELIOS_VKD3D_INLINE_SIGNAL", env, sizeof(env)) && env[0] == '0');
+    return enabled;
+}
+
+static bool vkd3d_helios_inline_signal_info(struct d3d12_command_queue *queue,
+        struct vkd3d_helios_execution *op, VkSemaphoreSubmitInfo *info)
+{
+    if (!op || !queue->helios_producer || !vkd3d_helios_inline_signal_enabled())
+        return false;
+    memset(info, 0, sizeof(*info));
+    info->sType = VK_STRUCTURE_TYPE_SEMAPHORE_SUBMIT_INFO;
+    info->semaphore = queue->helios_producer->semaphore;
+    info->value = op->value;
+    info->stageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+    return true;
+}
+
+static void vkd3d_helios_mark_inline_signalled(struct vkd3d_helios_execution *op)
+{
+    if (op)
+        op->signalled_inline = true;
+}
+
+/* GPU execution time per batch (HELIOS_VKD3D_GPU_TIMESTAMPS=1, off by
+ * default): a TOP_OF_PIPE timestamp in a submit right before each Helios
+ * execution and an ALL_COMMANDS timestamp in a submit right after it, in a
+ * per-queue ring of query pairs, read back (never waited for) when the ring
+ * slot comes round again. busy = end - max(begin, previous end), gap =
+ * begin - previous end (the queue idle before the batch). Costs two extra
+ * submits per batch while on. */
+#define VKD3D_HELIOS_TS_SLOTS 64u
+
+struct vkd3d_helios_ts
+{
+    VkQueryPool pool;
+    VkCommandPool cmd_pool;
+    VkCommandBuffer begin[VKD3D_HELIOS_TS_SLOTS];
+    VkCommandBuffer end[VKD3D_HELIOS_TS_SLOTS];
+    bool used[VKD3D_HELIOS_TS_SLOTS];
+    uint32_t next;
+    uint64_t last_end;
+    uint64_t mask;
+    double period_ns;
+};
+
+static struct
+{
+    uint64_t batches, busy_sum_ns, gap_sum_ns, busy_max_ns, unavailable;
+    uint64_t busy_buckets[VKD3D_HELIOS_ECL_BUCKETS];
+    uint64_t gap_buckets[VKD3D_HELIOS_ECL_BUCKETS];
+} vkd3d_helios_ts_stats;
+
+static bool vkd3d_helios_ts_enabled(void)
+{
+    static int enabled = -1;
+    char env[8];
+    if (enabled < 0)
+        enabled = vkd3d_get_env_var("HELIOS_VKD3D_GPU_TIMESTAMPS", env, sizeof(env)) && env[0] == '1';
+    return enabled;
+}
+
+static struct vkd3d_helios_ts *vkd3d_helios_ts_create(struct d3d12_command_queue *queue)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &queue->device->vk_procs;
+    VkDevice vk_device = queue->device->vk_device;
+    VkCommandBufferAllocateInfo alloc = {0};
+    VkCommandBufferBeginInfo begin_info = {0};
+    VkCommandPoolCreateInfo pool_info = {0};
+    VkQueryPoolCreateInfo query_info = {0};
+    VkCommandBuffer buffers[2 * VKD3D_HELIOS_TS_SLOTS];
+    struct vkd3d_helios_ts *ts;
+    uint32_t i;
+
+    if (!queue->vkd3d_queue->timestamp_bits)
+        return NULL;
+    if (!(ts = vkd3d_calloc(1, sizeof(*ts))))
+        return NULL;
+    ts->mask = queue->vkd3d_queue->timestamp_bits >= 64 ? ~0ull :
+            (1ull << queue->vkd3d_queue->timestamp_bits) - 1;
+    ts->period_ns = queue->device->vk_info.device_limits.timestampPeriod;
+    query_info.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+    query_info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+    query_info.queryCount = 2 * VKD3D_HELIOS_TS_SLOTS;
+    pool_info.sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO;
+    pool_info.queueFamilyIndex = queue->vkd3d_queue->vk_family_index;
+    if (VK_CALL(vkCreateQueryPool(vk_device, &query_info, NULL, &ts->pool)) != VK_SUCCESS ||
+            VK_CALL(vkCreateCommandPool(vk_device, &pool_info, NULL, &ts->cmd_pool)) != VK_SUCCESS)
+        goto fail;
+    alloc.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO;
+    alloc.commandPool = ts->cmd_pool;
+    alloc.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+    alloc.commandBufferCount = 2 * VKD3D_HELIOS_TS_SLOTS;
+    if (VK_CALL(vkAllocateCommandBuffers(vk_device, &alloc, buffers)) != VK_SUCCESS)
+        goto fail;
+    begin_info.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO;
+    begin_info.flags = VK_COMMAND_BUFFER_USAGE_SIMULTANEOUS_USE_BIT;
+    for (i = 0; i < VKD3D_HELIOS_TS_SLOTS; i++)
+    {
+        ts->begin[i] = buffers[2 * i];
+        ts->end[i] = buffers[2 * i + 1];
+        if (VK_CALL(vkBeginCommandBuffer(ts->begin[i], &begin_info)) != VK_SUCCESS)
+            goto fail;
+        VK_CALL(vkCmdResetQueryPool(ts->begin[i], ts->pool, 2 * i, 2));
+        VK_CALL(vkCmdWriteTimestamp2(ts->begin[i], VK_PIPELINE_STAGE_2_TOP_OF_PIPE_BIT, ts->pool, 2 * i));
+        if (VK_CALL(vkEndCommandBuffer(ts->begin[i])) != VK_SUCCESS ||
+                VK_CALL(vkBeginCommandBuffer(ts->end[i], &begin_info)) != VK_SUCCESS)
+            goto fail;
+        VK_CALL(vkCmdWriteTimestamp2(ts->end[i], VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT, ts->pool, 2 * i + 1));
+        if (VK_CALL(vkEndCommandBuffer(ts->end[i])) != VK_SUCCESS)
+            goto fail;
+    }
+    INFO("Helios: GPU timestamps on for queue %p (period %.3f ns, %u bits).\n",
+            queue, ts->period_ns, queue->vkd3d_queue->timestamp_bits);
+    return ts;
+
+fail:
+    ERR("Helios: GPU timestamps unavailable for queue %p.\n", queue);
+    if (ts->cmd_pool)
+        VK_CALL(vkDestroyCommandPool(vk_device, ts->cmd_pool, NULL));
+    if (ts->pool)
+        VK_CALL(vkDestroyQueryPool(vk_device, ts->pool, NULL));
+    vkd3d_free(ts);
+    return NULL;
+}
+
+static void vkd3d_helios_ts_destroy(struct d3d12_command_queue *queue)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &queue->device->vk_procs;
+    struct vkd3d_helios_ts *ts = queue->helios_ts;
+    if (!ts)
+        return;
+    VK_CALL(vkDestroyCommandPool(queue->device->vk_device, ts->cmd_pool, NULL));
+    VK_CALL(vkDestroyQueryPool(queue->device->vk_device, ts->pool, NULL));
+    vkd3d_free(ts);
+    queue->helios_ts = NULL;
+}
