+    vkd3d_helios_ts_stats.busy_buckets[vkd3d_helios_ecl_bucket(busy / 1000)]++;
+    vkd3d_helios_ts_stats.gap_buckets[vkd3d_helios_ecl_bucket(gap / 1000)]++;
