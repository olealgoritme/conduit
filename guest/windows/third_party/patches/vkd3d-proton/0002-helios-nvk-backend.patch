+/* NVK on RM: wait until this queue's execution stream reaches `value` (an ECL
+ * or tile-mapping boundary helios_vkd3d_execute_command_lists() returned).
+ * S_OK when reached, S_FALSE on timeout, a failure HRESULT on device loss or
+ * when the queue has no stream yet. Thread-safe: the stream lives as long as
+ * the queue. */
+HRESULT helios_vkd3d_wait_execution(ID3D12CommandQueue *iface, uint64_t value, uint64_t timeout_ns)
+{
+    struct d3d12_command_queue *queue;
+    const struct vkd3d_vk_device_procs *vk_procs;
+    struct vkd3d_helios_stream *stream;
+    VkSemaphoreWaitInfo wait;
+    VkResult vr;
+
+    if (!iface)
+        return E_INVALIDARG;
+    queue = impl_from_ID3D12CommandQueue(iface);
+    vk_procs = &queue->device->vk_procs;
+    pthread_mutex_lock(&queue->queue_lock);
+    stream = queue->helios_producer;
+    pthread_mutex_unlock(&queue->queue_lock);
+    if (!stream)
+        return value ? E_FAIL : S_OK;
+    memset(&wait, 0, sizeof(wait));
+    wait.sType = VK_STRUCTURE_TYPE_SEMAPHORE_WAIT_INFO;
+    wait.semaphoreCount = 1;
+    wait.pSemaphores = &stream->semaphore;
+    wait.pValues = &value;
+    vr = VK_CALL(vkWaitSemaphores(queue->device->vk_device, &wait, timeout_ns));
+    if (vr == VK_SUCCESS)
+        return S_OK;
+    if (vr == VK_TIMEOUT)
+        return FAILED(d3d12_device_removed_reason(queue->device)) ?
+                d3d12_device_removed_reason(queue->device) : S_FALSE;
+    return hresult_from_vk_result(vr);
+}
