+/* Helios: the export request chained into a VKD3D_HEAP_FLAG_HELIOS_VENUS_EXPORT
+ * allocation. Venus: an OPAQUE_FD export (the virtio resource identity). NVK on RM:
+ * Conduit's helios_export_memory_resource_info (sType 1000384003,
+ * protocol/include/helios_icd_interface.h), whose layout is VkExportMemoryAllocateInfo's
+ * with handleTypes read as `flags` = 0; NVK then allocates the memory standalone and
+ * uncompressed and records the dedicated image's layout, and the UMD later asks NVK for
+ * a KMD resource id of it (IMPORT_RM). */
+#define VKD3D_HELIOS_STRUCTURE_TYPE_EXPORT_MEMORY_RESOURCE_INFO ((VkStructureType)1000384003)
+static inline void vkd3d_helios_export_info(const struct d3d12_device *device,
+        VkExportMemoryAllocateInfo *info)
+{
+    if (device->helios_nvk)
+    {
+        info->sType = VKD3D_HELIOS_STRUCTURE_TYPE_EXPORT_MEMORY_RESOURCE_INFO;
+        info->handleTypes = 0;
+    }
+    else
+    {
+        info->sType = VK_STRUCTURE_TYPE_EXPORT_MEMORY_ALLOCATE_INFO;
+        info->handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT;
+    }
+}
