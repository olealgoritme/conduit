+DLLEXPORT HRESULT helios_vkd3d_create_device(LUID adapter_luid, REFIID iid, void **device)
+{
+    TRACE("adapter_luid %08x:%08x, iid %s, device %p.\n",
+            (unsigned int)adapter_luid.HighPart, (unsigned int)adapter_luid.LowPart,
+            debugstr_guid(iid), device);
+
+    pthread_once(&helios_vulkan_once, helios_load_vulkan_once);
+    if (!helios_vk_gipa)
+    {
+        ERR("Failed to load Vulkan library.\n");
+        return E_FAIL;
+    }
+    return helios_create_device_with(adapter_luid, helios_vk_gipa, iid, device);
+}
+
+void vkd3d_helios_device_set_nvk(ID3D12Device *iface);
+
+/* An ICD's vk_icdGetInstanceProcAddr serves no layer queries (the loader does),
+ * and vkd3d's global procs include vkEnumerateInstanceLayerProperties: answer it
+ * with "no layers" and forward everything else. One ICD per process. */
+static PFN_vkGetInstanceProcAddr helios_icd_gipa;
+
+static VkResult VKAPI_PTR helios_icd_enumerate_instance_layers(uint32_t *count, VkLayerProperties *layers)
+{
+    (void)layers;
+    *count = 0;
+    return VK_SUCCESS;
+}
+
+static PFN_vkVoidFunction VKAPI_PTR helios_icd_get_instance_proc_addr(VkInstance instance, const char *name)
+{
+    if (!instance && name && !strcmp(name, "vkEnumerateInstanceLayerProperties"))
+        return (PFN_vkVoidFunction)helios_icd_enumerate_instance_layers;
+    return helios_icd_gipa(instance, name);
+}
+
+/* Helios (Conduit dxvk-on-nvk S5): the same device, created directly on an ICD
+ * the UMD loaded itself -- `icd_gipa` is NVK's vk_icdGetInstanceProcAddr, after
+ * the loader-interface negotiation -- with no Vulkan loader, no registry ICD
+ * list and no Venus ICD in the instance. The device is marked as running on NVK
+ * on RM (export requests and execution streams, see vkd3d_private.h). */
+DLLEXPORT HRESULT helios_vkd3d_create_device_icd(LUID adapter_luid, PFN_vkGetInstanceProcAddr icd_gipa,
+        REFIID iid, void **device)
+{
+    ID3D12Device *d3d12 = NULL;
+    HRESULT hr;
+
+    TRACE("adapter_luid %08x:%08x, icd_gipa %p, iid %s, device %p.\n",
+            (unsigned int)adapter_luid.HighPart, (unsigned int)adapter_luid.LowPart,
+            (void *)icd_gipa, debugstr_guid(iid), device);
+
+    if (!device)
+        return E_INVALIDARG;
+    *device = NULL;
+    if (!icd_gipa)
+        return E_INVALIDARG;
+    helios_icd_gipa = icd_gipa;
+    if (FAILED(hr = helios_create_device_with(adapter_luid, helios_icd_get_instance_proc_addr,
+            &IID_ID3D12Device, (void **)&d3d12)))
+        return hr;
+    vkd3d_helios_device_set_nvk(d3d12);
+    hr = d3d12->lpVtbl->QueryInterface(d3d12, iid, device);
+    d3d12->lpVtbl->Release(d3d12);
+    return hr;
+}
