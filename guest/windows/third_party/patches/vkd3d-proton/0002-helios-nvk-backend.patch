+/* Helios (Conduit dxvk-on-nvk S5): mark a device created on NVK on RM. Called by
+ * helios_vkd3d_create_device_icd() before the device is handed out. */
+void vkd3d_helios_device_set_nvk(ID3D12Device *iface)
+{
+    struct d3d12_device *device = impl_from_ID3D12Device((d3d12_device_iface *)iface);
+    device->helios_nvk = true;
+    INFO("Helios: device on NVK on RM (driver %s).\n", device->device_info.vulkan_1_2_properties.driverName);
+}
