+/* Helios: where vkd3d's VkDeviceMemory lands, per Vulkan memory type, and
+ * what each allocation asked for (the request class: DEFAULT-like
+ * DEVICE_LOCAL, UPLOAD-like HOST_VISIBLE|HOST_COHERENT, READBACK-like
+ * HOST_CACHED, HVV DEVICE_LOCAL|HOST_VISIBLE for descriptor heaps and
+ * GPU_UPLOAD, anything else). Exported by helios_vkd3d_memory_stats for the
+ * Conduit UMD's log. Process-wide: one NVK device per process in practice. */
+#ifdef _WIN32
+#define VKD3D_HELIOS_MEM_TYPES 32
+#define VKD3D_HELIOS_MEM_CLASSES 5
+static struct
+{
+    LONG64 live_bytes[VKD3D_HELIOS_MEM_TYPES];
+    LONG64 class_bytes[VKD3D_HELIOS_MEM_CLASSES][VKD3D_HELIOS_MEM_TYPES];
+    LONG64 class_count[VKD3D_HELIOS_MEM_CLASSES][VKD3D_HELIOS_MEM_TYPES];
+    LONG64 type_info[VKD3D_HELIOS_MEM_TYPES];
+    LONG64 fallbacks;
+} vkd3d_helios_mem;
+
+static unsigned int vkd3d_helios_mem_class(VkMemoryPropertyFlags type_flags)
+{
+    const VkMemoryPropertyFlags dl = VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT;
+    const VkMemoryPropertyFlags hv = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT;
+    if ((type_flags & (dl | hv)) == dl)
+        return 0;
+    if ((type_flags & (dl | hv)) == (dl | hv))
+        return 3;
+    if ((type_flags & hv) && (type_flags & VK_MEMORY_PROPERTY_HOST_CACHED_BIT))
+        return 2;
+    if (type_flags & hv)
+        return 1;
+    return 4;
+}
+
+static void vkd3d_helios_mem_note_alloc(struct d3d12_device *device, VkMemoryPropertyFlags type_flags,
+        uint32_t type_index, VkDeviceSize size)
+{
+    const VkMemoryType *type;
+    unsigned int c;
+    if (type_index >= VKD3D_HELIOS_MEM_TYPES)
+        return;
+    type = &device->memory_properties.memoryTypes[type_index];
+    c = vkd3d_helios_mem_class(type_flags);
+    InterlockedExchange64(&vkd3d_helios_mem.type_info[type_index],
+            (LONG64)((uint64_t)type->propertyFlags | ((uint64_t)type->heapIndex << 32) | (1ull << 63)));
+    InterlockedExchangeAdd64(&vkd3d_helios_mem.live_bytes[type_index], (LONG64)size);
+    InterlockedExchangeAdd64(&vkd3d_helios_mem.class_bytes[c][type_index], (LONG64)size);
+    InterlockedIncrement64(&vkd3d_helios_mem.class_count[c][type_index]);
+    /* The request wanted device-local memory and got a type without it. */
+    if ((type_flags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT) &&
+            !(type->propertyFlags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT))
+        InterlockedIncrement64(&vkd3d_helios_mem.fallbacks);
+}
+
+static void vkd3d_helios_mem_note_free(uint32_t type_index, VkDeviceSize size)
+{
+    if (type_index < VKD3D_HELIOS_MEM_TYPES)
+        InterlockedExchangeAdd64(&vkd3d_helios_mem.live_bytes[type_index], -(LONG64)size);
+}
+#else
+static void vkd3d_helios_mem_note_alloc(struct d3d12_device *device, VkMemoryPropertyFlags type_flags,
+        uint32_t type_index, VkDeviceSize size)
+{
+    (void)device; (void)type_flags; (void)type_index; (void)size;
+}
+
+static void vkd3d_helios_mem_note_free(uint32_t type_index, VkDeviceSize size)
+{
+    (void)type_index; (void)size;
+}
+#endif
+
+/* helios_vkd3d_memory_stats(out, count) layout, u64 each:
+ *   [0, 32)     live bytes per memory type
+ *   [32, 192)   bytes allocated per (class, type), class-major
+ *   [192, 352)  allocations per (class, type), class-major
+ *   [352, 384)  per type: propertyFlags | heapIndex << 32 | bit 63 (seen)
+ *   [384]       allocations that asked for DEVICE_LOCAL and got a type without it
+ * Classes: 0 DEVICE_LOCAL (DEFAULT), 1 HOST_VISIBLE (UPLOAD), 2 HOST_CACHED
+ * (READBACK), 3 DEVICE_LOCAL|HOST_VISIBLE (descriptor heaps, GPU_UPLOAD),
+ * 4 other. Returns how many values it wrote. */
+uint32_t helios_vkd3d_memory_stats(uint64_t *out, uint32_t count)
+{
+#ifdef _WIN32
+    uint64_t all[385];
+    uint32_t i, c, n = 0;
+    for (i = 0; i < VKD3D_HELIOS_MEM_TYPES; i++)
+        all[n++] = (uint64_t)vkd3d_helios_mem.live_bytes[i];
+    for (c = 0; c < VKD3D_HELIOS_MEM_CLASSES; c++)
+        for (i = 0; i < VKD3D_HELIOS_MEM_TYPES; i++)
+            all[n++] = (uint64_t)vkd3d_helios_mem.class_bytes[c][i];
+    for (c = 0; c < VKD3D_HELIOS_MEM_CLASSES; c++)
+        for (i = 0; i < VKD3D_HELIOS_MEM_TYPES; i++)
+            all[n++] = (uint64_t)vkd3d_helios_mem.class_count[c][i];
+    for (i = 0; i < VKD3D_HELIOS_MEM_TYPES; i++)
+        all[n++] = (uint64_t)vkd3d_helios_mem.type_info[i];
+    all[n++] = (uint64_t)vkd3d_helios_mem.fallbacks;
+    n = count < n ? count : n;
+    if (out)
+        memcpy(out, all, n * sizeof(*out));
+    return n;
+#else
+    (void)out; (void)count;
+    return 0;
+#endif
+}
