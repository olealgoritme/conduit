+static void helios_pass_barrier_note(bool ended_active, unsigned int barriers,
+        unsigned int vk_images, bool vk_memory)
+{
+    pthread_mutex_lock(&helios_pass_ends.lock);
+    helios_pass_ends.rb_calls++;
+    helios_pass_ends.rb_barriers += barriers;
+    helios_pass_ends.rb_vk_images += vk_images;
+    helios_pass_ends.rb_vk_memory += vk_memory;
+    if (ended_active)
+    {
+        helios_pass_ends.rb_ended++;
+        if (!vk_images && !vk_memory)
+            helios_pass_ends.rb_ended_noop++;
+    }
+    pthread_mutex_unlock(&helios_pass_ends.lock);
+}
