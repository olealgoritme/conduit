+#ifdef _WIN32
+/* HELIOS_VKD3D_ADMISSION_SPIN_US (default 0): poll the admission event for
+ * this long before blocking on it. The worker is idle while it waits, and a
+ * blocked thread wakes a scheduler hop later than a polling one notices; the
+ * admission chain is per batch, ~20 a frame. */
+static uint32_t vkd3d_helios_admission_spin_us(void)
+{
+    static int spin = -1;
+    char env[16];
+    if (spin < 0)
+    {
+        spin = vkd3d_get_env_var("HELIOS_VKD3D_ADMISSION_SPIN_US", env, sizeof(env)) ? atoi(env) : 0;
+        if (spin < 0) spin = 0;
+        if (spin > 20000) spin = 20000;
+        if (spin)
+            INFO("Helios: admission waits poll for %d us before blocking.\n", spin);
+    }
+    return (uint32_t)spin;
+}
+#endif
