From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ole Algoritme <olealgoritme@gmail.com>
Date: Sat, 24 Oct 2026 15:51:23 +0200
Subject: [PATCH] wsi/win32: Anime4K CNN upscalers in the composed present
 (a4k-3d, a4k, a4k-vl)

A learned upscaler tier: enhance/adapt.py turns each Anime4K mpv user
shader into compute passes (one SPIR-V each, A4K_PASS) and a pass table at
build time.  The passes run at the image's size into RGBA16F
intermediates, the last one doubles the image; EASU (up) or bilinear
(down) takes it to the picture's size.  Their own descriptor layout (16
sampled images, the output at binding 16); pipelines and images are made
when the variant is first used.

  a4k-3d  Anime4K's network for 3D graphics, 4 passes (light)
  a4k     CNN x2 M, 9 passes
  a4k-vl  CNN x2 VL, 18 passes (strong GPUs)

Against a truth at the output size (Conduit tools/enhance-eval), 1280x720
to 2560x1440: FSR 1 29.5 dB, a4k-3d 29.5, a4k 30.6, a4k-vl 31.0.
---
 src/vulkan/wsi/enhance/adapt.py           |  85 ++++++++
 src/vulkan/wsi/meson.build                |  25 +++
 src/vulkan/wsi/wsi_common_win32_enhance.c | 229 ++++++++++++++++++++++
 src/vulkan/wsi/wsi_common_win32_enhance.h |   3 +
 4 files changed, 342 insertions(+)

diff --git a/src/vulkan/wsi/enhance/adapt.py b/src/vulkan/wsi/enhance/adapt.py
index 5342d9e..a78210e 100644
--- a/src/vulkan/wsi/enhance/adapt.py
+++ b/src/vulkan/wsi/enhance/adapt.py
@@ -8,6 +8,9 @@
   adapt.py xbr   IN OUT   xBR-lv2 slang (fragment stage) -> xbr_main()
   adapt.py nis-coef IN OUT  NIS_Config.h coef_scale / coef_usm -> GLSL
                             constant arrays (2 x 64 vec4 each)
+  adapt.py a4k NAME IN GLSL HDR  an Anime4K mpv user shader -> one GLSL
+                            file of compute passes (A4K_PASS selects one)
+                            and a C header with the pass table
 
 The vendored files are not changed; OUT is generated in the build tree.
 """
@@ -76,7 +79,89 @@ def nis_coef(text):
             glsl('nis_coef_usm', table('coef_usm')))
 
 
+def a4k(name, text):
+    """mpv user shader passes (//!DESC ... hook()) as compute passes"""
+    passes = []
+    cur = None
+    for line in text.splitlines():
+        if line.startswith('//!DESC'):
+            cur = {'desc': line[8:].strip(), 'bind': [], 'save': None, 'scale': 1, 'body': []}
+            passes.append(cur)
+        elif cur is None:
+            continue
+        elif line.startswith('//!BIND'):
+            cur['bind'].append(line.split()[1])
+        elif line.startswith('//!SAVE'):
+            cur['save'] = line.split()[1]
+        elif line.startswith('//!WIDTH'):
+            w = line.split()[1:]
+            cur['scale'] = int(w[1]) if len(w) == 3 and w[2] == '*' else 1
+        elif line.startswith('//!'):
+            continue
+        else:
+            cur['body'].append(line)
+    textures = ['MAIN']
+    for p in passes:
+        if p['save'] != 'MAIN' and p['save'] not in textures:
+            textures.append(p['save'])
+    out = ['#version 450',
+           '#extension GL_GOOGLE_include_directive : require',
+           '/* Generated by adapt.py from %s (Anime4K, MIT); do not edit. */' % name,
+           'layout(local_size_x = 8, local_size_y = 8) in;',
+           'layout(set = 0, binding = 16) writeonly uniform image2D a4k_dst;',
+           'layout(push_constant) uniform a4k_push { ivec2 dst_size; ivec2 dst_off; uint flags; } pc;',
+           'vec2 a4k_pos;',
+           'vec3 a4k_srgb(vec3 c) { c = clamp(c, 0.0, 1.0); return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c)); }']
+    for i, p in enumerate(passes):
+        out.append('#if A4K_PASS == %d' % i)
+        out.append('/* %s */' % p['desc'])
+        for b, t in enumerate(p['bind']):
+            out.append('layout(set = 0, binding = %d) uniform sampler2D %s_raw;' % (b, t))
+            if t == 'MAIN':
+                # the application's image: sRGB values when its view is sRGB
+                out.append('vec4 %s_fetch(vec2 q) { vec4 c = textureLod(%s_raw, q, 0.0); '
+                           'return (pc.flags & 1u) != 0u ? vec4(a4k_srgb(c.rgb), c.a) : c; }' % (t, t))
+            else:
+                out.append('vec4 %s_fetch(vec2 q) { return textureLod(%s_raw, q, 0.0); }' % (t, t))
+            out.append('#define %s_pos a4k_pos' % t)
+            out.append('#define %s_size vec2(textureSize(%s_raw, 0))' % (t, t))
+            out.append('#define %s_pt (1.0 / %s_size)' % (t, t))
+            out.append('#define %s_tex(q) %s_fetch(q)' % (t, t))
+            out.append('#define %s_texOff(off) %s_fetch(%s_pos + (off) * %s_pt)' % (t, t, t, t))
+        out.extend(p['body'])
+        out.append('#endif')
+    out += ['void main()',
+            '{',
+            '   ivec2 p = ivec2(gl_GlobalInvocationID.xy);',
+            '   if (p.x >= pc.dst_size.x || p.y >= pc.dst_size.y)',
+            '      return;',
+            '   a4k_pos = (vec2(p) + 0.5) / vec2(pc.dst_size);',
+            '   imageStore(a4k_dst, p + pc.dst_off, hook());',
+            '}']
+    hdr = ['/* Generated by adapt.py from %s (Anime4K, MIT); do not edit. */' % name] + \
+          ['#include "a4k_%s_%d_spv.h"' % (name, i) for i in range(len(passes))] + [
+           '/* textures: 0 the source, 1..%d intermediates at its size; out = -1 */' % (len(textures) - 1),
+           '#define A4K_%s_TEXTURES %d' % (name.upper(), len(textures) - 1),
+           '#define A4K_%s_PASSES %d' % (name.upper(), len(passes)),
+           'static const struct a4k_pass a4k_%s_passes[%d] = {' % (name, len(passes))]
+    for i, p in enumerate(passes):
+        binds = ', '.join(str(textures.index(b)) for b in p['bind'])
+        save = -1 if p['save'] == 'MAIN' else textures.index(p['save'])
+        hdr.append('   { %d, { %s }, %d, %d, a4k_%s_%d_spv, sizeof(a4k_%s_%d_spv) },'
+                   % (len(p['bind']), binds, save, p['scale'], name, i, name, i))
+    hdr.append('};')
+    return '\n'.join(out) + '\n', '\n'.join(hdr) + '\n', len(passes)
+
+
 def main():
+    if sys.argv[1] == 'a4k':
+        name, src, glsl, hdr = sys.argv[2:6]
+        g, h, n = a4k(name, open(src, encoding='utf-8').read())
+        if len(sys.argv) > 6 and int(sys.argv[6]) != n:
+            raise SystemExit('a4k %s: %d passes, the build expects %s' % (name, n, sys.argv[6]))
+        open(glsl, 'w', encoding='utf-8').write(g)
+        open(hdr, 'w', encoding='utf-8').write(h)
+        return
     mode, src, dst = sys.argv[1:4]
     text = open(src, encoding='utf-8').read()
     out = {'sgsr': sgsr, 'xbr': xbr, 'nis-coef': nis_coef}[mode](text)
diff --git a/src/vulkan/wsi/meson.build b/src/vulkan/wsi/meson.build
index 5cadd4a..fe3c795 100644
--- a/src/vulkan/wsi/meson.build
+++ b/src/vulkan/wsi/meson.build
@@ -51,6 +51,31 @@ if with_platform_windows
       command : [prog_python, '@INPUT0@', a[0], '@INPUT1@', '@OUTPUT@'],
     )
   endforeach
+  # Anime4K's CNN upscalers (MIT): mpv user shaders made compute passes
+  # and a pass table by adapt.py; one SPIR-V per pass
+  foreach v : [['3d', 'Anime4K_3DGraphics_Upscale_x2_US.glsl', 4],
+               ['m', 'Anime4K_Upscale_CNN_x2_M.glsl', 9],
+               ['vl', 'Anime4K_Upscale_CNN_x2_VL.glsl', 18]]
+    a4k_gen = custom_target(
+      'a4k_' + v[0],
+      input : ['enhance/adapt.py', 'enhance/third_party/anime4k' / v[1]],
+      output : ['a4k_' + v[0] + '.glsl', 'a4k_' + v[0] + '_passes.h'],
+      command : [prog_python, '@INPUT0@', 'a4k', v[0], '@INPUT1@', '@OUTPUT0@', '@OUTPUT1@',
+                 v[2].to_string()],
+    )
+    files_vulkan_wsi += a4k_gen[1]
+    foreach i : range(v[2])
+      files_vulkan_wsi += custom_target(
+        'a4k_' + v[0] + '_' + i.to_string() + '_spv.h',
+        input : a4k_gen[0],
+        output : 'a4k_' + v[0] + '_' + i.to_string() + '_spv.h',
+        command : [prog_glslang, '-V', '--target-env', 'vulkan1.1', '-S', 'comp',
+                   '-DA4K_PASS=' + i.to_string(),
+                   '--vn', 'a4k_' + v[0] + '_' + i.to_string() + '_spv',
+                   '-o', '@OUTPUT@', '@INPUT@', glslang_quiet],
+      )
+    endforeach
+  endforeach
   enh_third_party = meson.current_source_dir() / 'enhance' / 'third_party'
   foreach s : ['enh_scale', 'enh_easu', 'enh_rcas', 'enh_nis', 'enh_cas', 'enh_sgsr',
                'enh_xbr', 'fg_down', 'fg_flow', 'fg_interp']
diff --git a/src/vulkan/wsi/wsi_common_win32_enhance.c b/src/vulkan/wsi/wsi_common_win32_enhance.c
index 99cf668..d26b662 100644
--- a/src/vulkan/wsi/wsi_common_win32_enhance.c
+++ b/src/vulkan/wsi/wsi_common_win32_enhance.c
@@ -56,6 +56,31 @@
 #include "enh_sgsr_spv.h"
 #include "enh_xbr_spv.h"
 
+/* Anime4K's CNN x2 upscalers (enhance/third_party/anime4k, MIT): passes
+ * and tables generated by enhance/adapt.py.  Texture 0 is the source,
+ * 1..n intermediates at its size; save -1 is the 2x output. */
+struct a4k_pass {
+   uint32_t nbind;
+   int bind[16];
+   int save;
+   uint32_t scale;
+   const uint32_t *code;
+   size_t size;
+};
+#include "a4k_3d_passes.h"
+#include "a4k_m_passes.h"
+#include "a4k_vl_passes.h"
+static const struct {
+   const struct a4k_pass *passes;
+   unsigned count, textures;
+} a4k_variants[3] = {
+   { a4k_3d_passes, A4K_3D_PASSES, A4K_3D_TEXTURES },
+   { a4k_m_passes, A4K_M_PASSES, A4K_M_TEXTURES },
+   { a4k_vl_passes, A4K_VL_PASSES, A4K_VL_TEXTURES },
+};
+#define A4K_MAX_PASSES 32
+#define A4K_MAX_TEXTURES 24
+
 #define LOGI(...) wsi_win32_compose_log(false, "enhance: " __VA_ARGS__)
 #define LOGE(...) wsi_win32_compose_log(true, "enhance: " __VA_ARGS__)
 
@@ -72,6 +97,9 @@ static const char *const scaler_names[WSI_ENH_SCALER_COUNT] = {
    [WSI_ENH_SCALER_CAS] = "cas",
    [WSI_ENH_SCALER_SGSR] = "sgsr",
    [WSI_ENH_SCALER_XBR] = "xbr",
+   [WSI_ENH_SCALER_A4K_3D] = "a4k-3d",
+   [WSI_ENH_SCALER_A4K] = "a4k",
+   [WSI_ENH_SCALER_A4K_VL] = "a4k-vl",
 };
 
 const char *
@@ -447,6 +475,15 @@ struct wsi_enh {
    bool *slot_ready;
 
    VkSampler linear, nearest;
+   /* Anime4K: its own layout (16 sampled images, the output at 16), the
+    * pipelines and images of the variant in use (-1: none yet) */
+   VkDescriptorSetLayout a4k_dsl;
+   VkPipelineLayout a4k_layout;
+   int a4k_variant;
+   VkPipeline a4k_pipe[A4K_MAX_PASSES];
+   struct enh_img a4k_tex[A4K_MAX_TEXTURES];
+   struct enh_img a4k_out;
+   bool a4k_init_layouts;
    VkDescriptorSetLayout dsl;
    VkPipelineLayout layout;
    VkPipeline pipe[P_COUNT];
@@ -749,6 +786,7 @@ wsi_enh_create(const struct wsi_enh_create_info *info, struct wsi_enh **out)
    e->src_count = info->src_count;
    e->slot_count = info->slot_count;
    e->cur = 0;
+   e->a4k_variant = -1;
    InitializeSRWLock(&e->stat_lock);
    e->stat_t0 = os_time_get_nano();
    enh_compute_rect(e);
@@ -879,6 +917,17 @@ wsi_enh_destroy(struct wsi_enh *e)
       if (e->pipe[p])
          wsi->DestroyPipeline(e->dev, e->pipe[p], &e->alloc);
    }
+   for (unsigned p = 0; p < A4K_MAX_PASSES; p++) {
+      if (e->a4k_pipe[p])
+         wsi->DestroyPipeline(e->dev, e->a4k_pipe[p], &e->alloc);
+   }
+   for (unsigned t = 0; t < A4K_MAX_TEXTURES; t++)
+      enh_image_destroy(e, &e->a4k_tex[t]);
+   enh_image_destroy(e, &e->a4k_out);
+   if (e->a4k_layout)
+      wsi->DestroyPipelineLayout(e->dev, e->a4k_layout, &e->alloc);
+   if (e->a4k_dsl)
+      wsi->DestroyDescriptorSetLayout(e->dev, e->a4k_dsl, &e->alloc);
    if (e->layout)
       wsi->DestroyPipelineLayout(e->dev, e->layout, &e->alloc);
    if (e->dsl)
@@ -1135,6 +1184,164 @@ push_sizes(struct enh_push *p, VkExtent2D src, VkExtent2D dst, VkOffset2D off)
    p->dst_off[1] = off.y;
 }
 
+/* The pipelines and images of Anime4K variant v (made on first use, and
+ * again when the variant changes) */
+static bool
+a4k_prepare(struct wsi_enh *e, int v)
+{
+   const struct wsi_device *wsi = e->wsi;
+   if (e->a4k_variant == v)
+      return true;
+   VkResult r = VK_SUCCESS;
+   if (!e->a4k_dsl) {
+      VkDescriptorSetLayoutBinding b[17];
+      for (unsigned i = 0; i < 17; i++) {
+         b[i] = (VkDescriptorSetLayoutBinding) {
+            .binding = i,
+            .descriptorType = i < 16 ? VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER
+                                     : VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,
+            .descriptorCount = 1,
+            .stageFlags = VK_SHADER_STAGE_COMPUTE_BIT,
+         };
+      }
+      const VkDescriptorSetLayoutCreateInfo dci = {
+         .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+         .flags = VK_DESCRIPTOR_SET_LAYOUT_CREATE_PUSH_DESCRIPTOR_BIT_KHR,
+         .bindingCount = 17,
+         .pBindings = b,
+      };
+      r = wsi->CreateDescriptorSetLayout(e->dev, &dci, &e->alloc, &e->a4k_dsl);
+      if (r != VK_SUCCESS)
+         return false;
+      const VkPushConstantRange pcr = { VK_SHADER_STAGE_COMPUTE_BIT, 0, ENH_PUSH_SIZE };
+      const VkPipelineLayoutCreateInfo lci = {
+         .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+         .setLayoutCount = 1,
+         .pSetLayouts = &e->a4k_dsl,
+         .pushConstantRangeCount = 1,
+         .pPushConstantRanges = &pcr,
+      };
+      r = wsi->CreatePipelineLayout(e->dev, &lci, &e->alloc, &e->a4k_layout);
+      if (r != VK_SUCCESS)
+         return false;
+   }
+   for (unsigned p = 0; p < A4K_MAX_PASSES; p++) {
+      if (e->a4k_pipe[p])
+         wsi->DestroyPipeline(e->dev, e->a4k_pipe[p], &e->alloc);
+      e->a4k_pipe[p] = VK_NULL_HANDLE;
+   }
+   for (unsigned t = 0; t < A4K_MAX_TEXTURES; t++)
+      enh_image_destroy(e, &e->a4k_tex[t]);
+   enh_image_destroy(e, &e->a4k_out);
+   e->a4k_variant = -1;
+
+   const struct a4k_pass *passes = a4k_variants[v].passes;
+   for (unsigned p = 0; p < a4k_variants[v].count && r == VK_SUCCESS; p++) {
+      const VkShaderModuleCreateInfo sci = {
+         .sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO,
+         .codeSize = passes[p].size,
+         .pCode = passes[p].code,
+      };
+      VkShaderModule mod;
+      r = wsi->CreateShaderModule(e->dev, &sci, &e->alloc, &mod);
+      if (r != VK_SUCCESS)
+         break;
+      const VkComputePipelineCreateInfo pci = {
+         .sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO,
+         .stage = {
+            .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+            .stage = VK_SHADER_STAGE_COMPUTE_BIT,
+            .module = mod,
+            .pName = "main",
+         },
+         .layout = e->a4k_layout,
+      };
+      r = wsi->CreateComputePipelines(e->dev, VK_NULL_HANDLE, 1, &pci, &e->alloc,
+                                      &e->a4k_pipe[p]);
+      wsi->DestroyShaderModule(e->dev, mod, &e->alloc);
+   }
+   for (unsigned t = 0; t < a4k_variants[v].textures && r == VK_SUCCESS; t++)
+      r = enh_image(e, &e->a4k_tex[t], VK_FORMAT_R16G16B16A16_SFLOAT,
+                    e->src.width, e->src.height);
+   if (r == VK_SUCCESS)
+      r = enh_image(e, &e->a4k_out, VK_FORMAT_R8G8B8A8_UNORM,
+                    2 * e->src.width, 2 * e->src.height);
+   if (r != VK_SUCCESS) {
+      LOGE("Anime4K %s: set-up failed (%d), FSR 1 instead",
+           wsi_enh_scaler_name((enum wsi_enh_scaler)(WSI_ENH_SCALER_A4K_3D + v)), (int)r);
+      return false;
+   }
+   e->a4k_variant = v;
+   e->a4k_init_layouts = true;
+   LOGI("Anime4K %s: %u passes, %u images of %ux%u",
+        wsi_enh_scaler_name((enum wsi_enh_scaler)(WSI_ENH_SCALER_A4K_3D + v)),
+        a4k_variants[v].count, a4k_variants[v].textures, e->src.width, e->src.height);
+   return true;
+}
+
+/* Anime4K x2 of the application's image into a4k_out */
+static void
+record_a4k(struct wsi_enh *e, VkCommandBuffer cmd, VkImageView src)
+{
+   const struct wsi_device *wsi = e->wsi;
+   const int v = e->a4k_variant;
+   if (e->a4k_init_layouts) {
+      for (unsigned t = 0; t <= a4k_variants[v].textures; t++) {
+         struct enh_img *img = t < a4k_variants[v].textures ? &e->a4k_tex[t] : &e->a4k_out;
+         image_barrier(wsi, cmd, img->image, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_GENERAL,
+                       VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, 0,
+                       VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                       VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT);
+      }
+      e->a4k_init_layouts = false;
+   }
+   const struct a4k_pass *passes = a4k_variants[v].passes;
+   for (unsigned p = 0; p < a4k_variants[v].count; p++) {
+      const struct a4k_pass *ap = &passes[p];
+      VkDescriptorImageInfo ii[17];
+      VkWriteDescriptorSet w[17];
+      uint32_t n = 0;
+      bool reads_src = false;
+      for (uint32_t b = 0; b < ap->nbind; b++) {
+         reads_src |= ap->bind[b] == 0;
+         ii[n] = (VkDescriptorImageInfo) {
+            e->linear, ap->bind[b] == 0 ? src : e->a4k_tex[ap->bind[b] - 1].view,
+            VK_IMAGE_LAYOUT_GENERAL,
+         };
+         w[n] = (VkWriteDescriptorSet) {
+            .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET,
+            .dstBinding = b,
+            .descriptorCount = 1,
+            .descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER,
+            .pImageInfo = &ii[n],
+         };
+         n++;
+      }
+      const struct enh_img *dst = ap->save < 0 ? &e->a4k_out : &e->a4k_tex[ap->save - 1];
+      ii[n] = (VkDescriptorImageInfo) { VK_NULL_HANDLE, dst->view, VK_IMAGE_LAYOUT_GENERAL };
+      w[n] = (VkWriteDescriptorSet) {
+         .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET,
+         .dstBinding = 16,
+         .descriptorCount = 1,
+         .descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,
+         .pImageInfo = &ii[n],
+      };
+      n++;
+      const struct { int32_t size[2], off[2]; uint32_t flags; } push = {
+         { (int32_t)(e->src.width * ap->scale), (int32_t)(e->src.height * ap->scale) },
+         { 0, 0 },
+         reads_src && e->src_srgb ? ENH_FLAG_SRGB_ENCODE : 0,
+      };
+      wsi->CmdBindPipeline(cmd, VK_PIPELINE_BIND_POINT_COMPUTE, e->a4k_pipe[p]);
+      wsi->CmdPushDescriptorSetKHR(cmd, VK_PIPELINE_BIND_POINT_COMPUTE, e->a4k_layout,
+                                   0, n, w);
+      wsi->CmdPushConstants(cmd, e->a4k_layout, VK_SHADER_STAGE_COMPUTE_BIT, 0,
+                            sizeof(push), &push);
+      wsi->CmdDispatch(cmd, DIV_ROUND_UP(push.size[0], 8), DIV_ROUND_UP(push.size[1], 8), 1);
+      compute_barrier(wsi, cmd);
+   }
+}
+
 /* The scaler: the application's image into `dst` (rect size at `off`) */
 static void
 record_scale(struct wsi_enh *e, VkCommandBuffer cmd, VkImageView src,
@@ -1152,6 +1359,28 @@ record_scale(struct wsi_enh *e, VkCommandBuffer cmd, VkImageView src,
        (e->src_srgb || !nis_config(&nis, (float)e->cfg.sharpness / 100.0f, e->src, out,
                                    off, dst_w, dst_h)))
       s = WSI_ENH_SCALER_FSR;
+   /* Anime4K doubles the image, then EASU (up) or bilinear (down) to the
+    * picture's size; smaller than the image, bilinear */
+   if (s >= WSI_ENH_SCALER_A4K_3D && s <= WSI_ENH_SCALER_A4K_VL) {
+      if (!upscale)
+         s = WSI_ENH_SCALER_BILINEAR;
