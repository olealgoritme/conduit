@@ -669,6 +722,94 @@ wsi_win32_compose_image_create(struct wsi_win32_compose *c, uint32_t width,
    return VK_SUCCESS;
 }
 
+/* Another device's D3D11 texture (created with D3D11_RESOURCE_MISC_SHARED on
+ * the Helios adapter): its record, for an import into a Vulkan device, and a
+ * reference to it.  No copy query (the caller synchronises). */
+VkResult
+wsi_win32_compose_wrap_texture(struct wsi_win32_compose *c, void *texture,
+                               struct wsi_win32_compose_image *img,
+                               struct wsi_win32_compose_import *imp)
+{
+   memset(img, 0, sizeof(*img));
+   ID3D11Texture2D *tex = (ID3D11Texture2D *)texture;
+   IDXGIResource *res = NULL;
+   HANDLE share = NULL;
+   HRESULT hr = tex->QueryInterface(__uuidof(IDXGIResource), (void **)&res);
+   if (SUCCEEDED(hr)) {
+      hr = res->GetSharedHandle(&share);
+      res->Release();
+   }
+   if (FAILED(hr) || share == NULL) {
+      LOGE("no shared handle for an application texture: 0x%08lx", (unsigned long)hr);
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+   tex->AddRef();
+   img->texture = tex;
+   VkResult result = compose_read_record(c, share, img, imp);
+   if (result != VK_SUCCESS)
+      wsi_win32_compose_image_destroy(c, img);
+   return result;
+}
+
+/* The same for a resource shared by an NT handle (D3D12) */
+VkResult
+wsi_win32_compose_wrap_nt_handle(struct wsi_win32_compose *c, void *nt_handle,
+                                 struct wsi_win32_compose_image *img,
+                                 struct wsi_win32_compose_import *imp)
+{
+   memset(img, 0, sizeof(*img));
+   if (!fn.query_from_nt || !fn.open_from_nt) {
+      LOGE("no D3DKMTOpenResourceFromNtHandle");
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+   struct wsi_kmt_query_resource_info_nt q = {};
+   q.hDevice = c->kmt_device;
+   q.hNtHandle = nt_handle;
+   WSI_NTSTATUS st = fn.query_from_nt(&q);
+   if (st < 0 || q.NumAllocations == 0) {
+      LOGE("D3DKMTQueryResourceInfoFromNtHandle failed: 0x%08lx, %u allocations",
+           (unsigned long)st, q.NumAllocations);
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+   void *runtime = calloc(1, q.PrivateRuntimeDataSize ? q.PrivateRuntimeDataSize : 1);
+   void *total = calloc(1, q.TotalPrivateDriverDataSize ? q.TotalPrivateDriverDataSize : 1);
+   void *resdata = calloc(1, q.ResourcePrivateDriverDataSize ? q.ResourcePrivateDriverDataSize : 1);
+   struct wsi_kmt_open_allocation_info2 *allocs =
+      (struct wsi_kmt_open_allocation_info2 *)calloc(q.NumAllocations, sizeof(*allocs));
+   VkResult result = VK_ERROR_INITIALIZATION_FAILED;
+   if (runtime && total && resdata && allocs) {
+      struct wsi_kmt_open_resource_nt o = {};
+      o.hDevice = c->kmt_device;
+      o.hNtHandle = nt_handle;
+      o.NumAllocations = q.NumAllocations;
+      o.pOpenAllocationInfo = allocs;
+      o.pPrivateRuntimeData = runtime;
+      o.PrivateRuntimeDataSize = q.PrivateRuntimeDataSize;
+      o.pResourcePrivateDriverData = resdata;
+      o.ResourcePrivateDriverDataSize = q.ResourcePrivateDriverDataSize;
+      o.pTotalPrivateDriverDataBuffer = total;
+      o.TotalPrivateDriverDataBufferSize = q.TotalPrivateDriverDataSize;
+      st = fn.open_from_nt(&o);
+      if (st < 0) {
+         LOGE("D3DKMTOpenResourceFromNtHandle failed: 0x%08lx", (unsigned long)st);
+      } else {
+         img->kmt_resource = o.hResource;
+         struct wsi_kmt_open_allocation_info a = {};
+         a.hAllocation = allocs[0].hAllocation;
+         a.pPrivateDriverData = allocs[0].pPrivateDriverData;
+         a.PrivateDriverDataSize = allocs[0].PrivateDriverDataSize;
+         result = compose_parse_record(&a, imp);
+      }
+   }
+   free(runtime);
+   free(total);
+   free(resdata);
+   free(allocs);
+   if (result != VK_SUCCESS)
+      wsi_win32_compose_image_destroy(c, img);
+   return result;
+}
+
 void
 wsi_win32_compose_image_destroy(struct wsi_win32_compose *c,
                                 struct wsi_win32_compose_image *img)
diff --git a/src/vulkan/wsi/wsi_common_win32_dxgi.cpp b/src/vulkan/wsi/wsi_common_win32_dxgi.cpp
new file mode 100644
index 0000000..3b74cb2
--- /dev/null
+++ b/src/vulkan/wsi/wsi_common_win32_dxgi.cpp
@@ -0,0 +1,1440 @@
+/*
+ * Copyright © 2026 Ole Algoritme
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * Upscaling and frame generation for D3D11 and D3D12 applications (Conduit
+ * Helios).
+ *
+ * Their presents never reach a Vulkan swapchain: DXGI hands the back buffer
+ * to the Helios UMD, the KMD and DWM.  So, in processes whose D3D driver
+ * runs on NVK and where the settings are on, NVK hooks DXGI's swap chain
+ * creation (IDXGIFactory::CreateSwapChain, IDXGIFactory2::
+ * CreateSwapChainForHwnd; after the UMD's own FlipUpgrade hooks, which a
+ * chain not taken here still goes through) and gives the application a
+ * swap chain of its own:
+ *
+ *   - the application's back buffers are ordinary textures of its own size
+ *     on its own device; Present copies the current one into a ring of
+ *     shared textures (on the application's device, its queue) and returns;
+ *   - a thread per swap chain waits for that copy, runs the enhancement
+ *     passes (wsi_common_win32_enhance.c) on NVK's own Vulkan device in this
+ *     process, into output slots of the window's size, and presents them,
+ *     paced, through the composed present's D3D11 device and DXGI flip swap
+ *     chain on the window (wsi_common_win32_compose.cpp), as a Vulkan
+ *     swapchain with enhancement does.
+ *
+ * The application's thread never waits for a picture's time; it waits only
+ * when every ring texture is still being read (the passes take well under a
+ * frame).  Exclusive fullscreen is not entered: the window stays as it is
+ * (borderless at the desktop's mode), as for any frame-generation layer.
+ */
+
+#include "wsi_common_private.h"
+#include "wsi_common_win32_enhance.h"
+
+#include <windows.h>
+#include <d3d11_4.h>
+#include <dxgi1_6.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "util/os_misc.h"
+#include "util/os_time.h"
+#include "util/u_debug.h"
+#include "util/u_thread.h"
+#include "util/u_atomic.h"
+#include "vk_alloc.h"
+#include "vk_physical_device.h"
+
+#include "wsi_common_win32_dxgi.h"
+
+#define LOGI(...) wsi_win32_compose_log(false, "dxgi: " __VA_ARGS__)
+#define LOGE(...) wsi_win32_compose_log(true, "dxgi: " __VA_ARGS__)
+
+#define RING 3
+#define MAX_SLOTS (WSI_ENH_MAX_PICS + 3)
+
+/* ---- NVK's own Vulkan device in this process --------------------------- */
+
+static struct {
+   INIT_ONCE once;
+   bool ok;
+   VkInstance instance;
+   VkPhysicalDevice pdev;
+   VkDevice device;
+   VkQueue queue;
+   uint32_t qfi;
+   const struct wsi_device *wsi;
+   SRWLOCK queue_lock;
+   PFN_vkDestroyDevice destroy_device;
+} pvk = { INIT_ONCE_STATIC_INIT, false, NULL, NULL, NULL, NULL, 0, NULL, SRWLOCK_INIT, NULL };
+
+static BOOL CALLBACK
+pvk_init(PINIT_ONCE once, PVOID param, PVOID *ctx)
+{
+   (void)once; (void)param; (void)ctx;
+   HMODULE self = NULL;
+   if (!GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                           GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                           (LPCSTR)(void *)&pvk_init, &self))
+      return TRUE;
+   PFN_vkGetInstanceProcAddr gipa = (PFN_vkGetInstanceProcAddr)(void *)
+      GetProcAddress(self, "vk_icdGetInstanceProcAddr");
+   if (!gipa) {
+      LOGE("this driver exports no vk_icdGetInstanceProcAddr");
+      return TRUE;
+   }
+#define I(name) PFN_vk##name name = (PFN_vk##name)(void *)gipa(pvk.instance, "vk" #name)
+   PFN_vkCreateInstance CreateInstance =
+      (PFN_vkCreateInstance)(void *)gipa(NULL, "vkCreateInstance");
+   VkApplicationInfo app = {};
+   app.sType = VK_STRUCTURE_TYPE_APPLICATION_INFO;
+   app.pApplicationName = "helios-dxgi-enhance";
+   app.apiVersion = VK_API_VERSION_1_3;
+   VkInstanceCreateInfo ici = {};
+   ici.sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO;
+   ici.pApplicationInfo = &app;
+   VkResult r = CreateInstance ? CreateInstance(&ici, NULL, &pvk.instance) :
+                                 VK_ERROR_INITIALIZATION_FAILED;
+   if (r != VK_SUCCESS) {
+      LOGE("vkCreateInstance: %d", (int)r);
+      return TRUE;
+   }
+   I(EnumeratePhysicalDevices);
+   I(GetPhysicalDeviceQueueFamilyProperties);
+   I(EnumerateDeviceExtensionProperties);
+   I(CreateDevice);
+   I(GetDeviceQueue);
+   pvk.destroy_device = (PFN_vkDestroyDevice)(void *)gipa(pvk.instance, "vkDestroyDevice");
+   uint32_t n = 1;
+   r = EnumeratePhysicalDevices(pvk.instance, &n, &pvk.pdev);
+   if ((r != VK_SUCCESS && r != VK_INCOMPLETE) || n == 0) {
+      LOGE("no physical device: %d", (int)r);
+      return TRUE;
+   }
+   VkQueueFamilyProperties qf[8];
+   uint32_t nqf = 8;
+   GetPhysicalDeviceQueueFamilyProperties(pvk.pdev, &nqf, qf);
+   pvk.qfi = UINT32_MAX;
+   for (uint32_t i = 0; i < nqf; i++) {
+      if ((qf[i].queueFlags & (VK_QUEUE_GRAPHICS_BIT | VK_QUEUE_COMPUTE_BIT)) ==
+          (VK_QUEUE_GRAPHICS_BIT | VK_QUEUE_COMPUTE_BIT)) {
+         pvk.qfi = i;
+         break;
+      }
+   }
+   if (pvk.qfi == UINT32_MAX)
+      return TRUE;
+   const char *exts[1];
+   uint32_t next = 0;
+   VkExtensionProperties ep[512];
+   uint32_t nep = 512;
+   if (EnumerateDeviceExtensionProperties(pvk.pdev, NULL, &nep, ep) >= 0) {
+      for (uint32_t i = 0; i < nep; i++) {
+         if (!strcmp(ep[i].extensionName, VK_KHR_PUSH_DESCRIPTOR_EXTENSION_NAME))
+            exts[next++] = VK_KHR_PUSH_DESCRIPTOR_EXTENSION_NAME;
+      }
+   }
+   const float prio = 1.0f;
+   VkDeviceQueueCreateInfo qci = {};
+   qci.sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO;
+   qci.queueFamilyIndex = pvk.qfi;
+   qci.queueCount = 1;
+   qci.pQueuePriorities = &prio;
+   VkDeviceCreateInfo dci = {};
+   dci.sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO;
+   dci.queueCreateInfoCount = 1;
+   dci.pQueueCreateInfos = &qci;
+   dci.enabledExtensionCount = next;
+   dci.ppEnabledExtensionNames = exts;
+   r = CreateDevice(pvk.pdev, &dci, NULL, &pvk.device);
+   if (r != VK_SUCCESS) {
+      LOGE("vkCreateDevice: %d", (int)r);
+      return TRUE;
+   }
+   GetDeviceQueue(pvk.device, pvk.qfi, 0, &pvk.queue);
+#undef I
+   VK_FROM_HANDLE(vk_physical_device, vpdev, pvk.pdev);
+   pvk.wsi = vpdev->wsi_device;
+   pvk.ok = pvk.wsi != NULL && pvk.wsi->win32.compose_import != NULL;
+   if (!pvk.ok)
+      LOGE("the driver's composed-present import is not available here");
+   return TRUE;
+}
+
+static bool
+pvk_get(void)
+{
+   InitOnceExecuteOnce(&pvk.once, pvk_init, NULL, NULL);
+   return pvk.ok;
+}
+
+/* A shared D3D11 texture (its record in `imp`) as a VkImage of NVK's device */
+static VkResult
+pvk_import(const struct wsi_win32_compose_import *imp, VkFormat format,
+           uint32_t w, uint32_t h, VkImageUsageFlags usage,
+           VkImage *image, VkDeviceMemory *mem)
+{
+   const struct wsi_device *wsi = pvk.wsi;
+   struct wsi_image_create_info wci = {};
+   wci.sType = VK_STRUCTURE_TYPE_WSI_IMAGE_CREATE_INFO_MESA;
+   VkImageCreateInfo ici = {};
+   ici.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
+   ici.pNext = &wci;
+   ici.imageType = VK_IMAGE_TYPE_2D;
+   ici.format = format;
+   ici.extent = { w, h, 1 };
+   ici.mipLevels = 1;
+   ici.arrayLayers = 1;
+   ici.samples = VK_SAMPLE_COUNT_1_BIT;
+   ici.tiling = VK_IMAGE_TILING_OPTIMAL;
+   ici.usage = usage;
+   ici.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+   ici.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+   VkResult r = wsi->CreateImage(pvk.device, &ici, NULL, image);
+   if (r != VK_SUCCESS)
+      return r;
+   r = wsi->win32.compose_import(pvk.device, *image, imp, mem);
+   if (r == VK_SUCCESS)
+      r = wsi->BindImageMemory(pvk.device, *image, *mem, 0);
+   if (r != VK_SUCCESS) {
+      if (*mem)
+         wsi->FreeMemory(pvk.device, *mem, NULL);
+      wsi->DestroyImage(pvk.device, *image, NULL);
+      *image = VK_NULL_HANDLE;
+      *mem = VK_NULL_HANDLE;
+   }
+   return r;
+}
+
+/* ---- the application's API ---------------------------------------------- */
+
+/* One ring texture: written by the application's queue, read by the passes */
+enum ring_state { RING_FREE, RING_COPYING, RING_PASSES };
+
+struct ring_entry {
+   struct wsi_win32_compose_image wrap;  /* the texture (record, reference) */
+   VkImage image;
+   VkDeviceMemory mem;
+   ID3D11Query *query;                   /* D3D11: the copy's completion */
+   void *d3d12;                          /* D3D12: wsi_dxgi12 ring entry */
+   enum ring_state state;
+};
+
+struct slot_entry {
+   struct wsi_win32_compose_image wrap;
+   VkImage image;
+   VkDeviceMemory mem;
+};
+
+struct frame_req {
+   uint32_t ring;
+   uint64_t present_ns;
+   uint64_t value;         /* D3D12: the fence value of the copy */
+   UINT sync_interval;
+};
+
+static bool
+vk_format_of(DXGI_FORMAT f, VkFormat *out, DXGI_FORMAT *copy_fmt)
+{
+   switch (f) {
+   case DXGI_FORMAT_B8G8R8A8_UNORM:
+   case DXGI_FORMAT_B8G8R8A8_UNORM_SRGB:
+      *out = VK_FORMAT_B8G8R8A8_UNORM;
+      *copy_fmt = DXGI_FORMAT_B8G8R8A8_UNORM;
+      return true;
+   case DXGI_FORMAT_R8G8B8A8_UNORM:
+   case DXGI_FORMAT_R8G8B8A8_UNORM_SRGB:
+      *out = VK_FORMAT_R8G8B8A8_UNORM;
+      *copy_fmt = DXGI_FORMAT_R8G8B8A8_UNORM;
+      return true;
+   default:
+      return false;
+   }
+}
