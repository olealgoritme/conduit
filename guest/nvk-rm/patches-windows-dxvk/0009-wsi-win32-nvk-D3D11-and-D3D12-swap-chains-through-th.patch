+/*
+ * Copyright © 2026 Ole Algoritme
+ * SPDX-License-Identifier: MIT
+ */
+
+/* The D3D swap chain proxy (wsi_common_win32_dxgi.cpp) and its D3D12 half
+ * (wsi_common_win32_dxgi12.cpp, which d3d11.h must not meet). */
+#ifndef WSI_COMMON_WIN32_DXGI_H
+#define WSI_COMMON_WIN32_DXGI_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Hooks DXGI's swap chain creation, once per process, where a Helios D3D
+ * driver runs on this NVK and the enhancement settings are on */
+void wsi_win32_dxgi_install(void);
+
+struct wsi_dxgi12;
+/* NULL when `queue` is not an ID3D12CommandQueue */
+struct wsi_dxgi12 *wsi_dxgi12_create(void *queue);
+void wsi_dxgi12_destroy(struct wsi_dxgi12 *d);
+bool wsi_dxgi12_buffers_create(struct wsi_dxgi12 *d, uint32_t count, uint32_t w,
+                               uint32_t h, uint32_t format, uint32_t usage);
+/* Ring texture k (shared): an NT handle the caller closes */
+bool wsi_dxgi12_ring_create(struct wsi_dxgi12 *d, uint32_t k, uint32_t w,
+                            uint32_t h, uint32_t format, void **nt_handle);
+void wsi_dxgi12_release_buffers(struct wsi_dxgi12 *d);
+bool wsi_dxgi12_get_buffer(struct wsi_dxgi12 *d, uint32_t i, const void *riid,
+                           void **out);
+/* On the application's queue: back buffer `index` into ring texture k;
+ * *value is the fence value that says it is done */
+bool wsi_dxgi12_copy(struct wsi_dxgi12 *d, uint32_t index, uint32_t k,
+                     uint64_t *value);
+bool wsi_dxgi12_copy_done(struct wsi_dxgi12 *d, uint64_t value, uint32_t timeout_ms);
+void wsi_dxgi12_idle(struct wsi_dxgi12 *d);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/src/vulkan/wsi/wsi_common_win32_dxgi12.cpp b/src/vulkan/wsi/wsi_common_win32_dxgi12.cpp
new file mode 100644
index 0000000..c7bd523
--- /dev/null
+++ b/src/vulkan/wsi/wsi_common_win32_dxgi12.cpp
@@ -0,0 +1,252 @@
+/*
+ * Copyright © 2026 Ole Algoritme
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * The D3D12 half of the D3D swap chain proxy (wsi_common_win32_dxgi.cpp):
+ * the application's back buffers, the shared ring textures, and the copy
+ * from one into the other on the application's own queue, with a fence the
+ * proxy's present thread waits for.
+ */
+
+#include <windows.h>
+#include <directx/d3d12.h>
+#include <dxguids/dxguids.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "wsi_common_win32_dxgi.h"
+
+#define RING 3
+
+struct wsi_dxgi12 {
+   ID3D12CommandQueue *queue;
+   ID3D12Device *device;
+   D3D12_COMMAND_LIST_TYPE type;
+   ID3D12Fence *fence;
+   HANDLE event;
+   uint64_t value;
+   uint32_t count;
+   ID3D12Resource *buffers[16];
+   ID3D12Resource *ring[RING];
+   ID3D12CommandAllocator *alloc[RING];
+   ID3D12GraphicsCommandList *list[RING];
+   SRWLOCK lock;
+};
+
+struct wsi_dxgi12 *
+wsi_dxgi12_create(void *unk)
+{
+   IUnknown *u = (IUnknown *)unk;
+   ID3D12CommandQueue *q = NULL;
+   if (FAILED(u->QueryInterface(__uuidof(ID3D12CommandQueue), (void **)&q)))
+      return NULL;
+   struct wsi_dxgi12 *d = (struct wsi_dxgi12 *)calloc(1, sizeof(*d));
+   if (!d) {
+      q->Release();
+      return NULL;
+   }
+   InitializeSRWLock(&d->lock);
+   d->queue = q;
+   D3D12_COMMAND_QUEUE_DESC qd;
+#if defined(_MSC_VER) || !defined(_WIN32)
+   qd = q->GetDesc();
+#else
+   q->GetDesc(&qd);
+#endif
+   d->type = qd.Type;
+   if (FAILED(q->GetDevice(__uuidof(ID3D12Device), (void **)&d->device)) ||
+       FAILED(d->device->CreateFence(0, D3D12_FENCE_FLAG_NONE, __uuidof(ID3D12Fence),
+                                     (void **)&d->fence)) ||
+       !(d->event = CreateEventA(NULL, FALSE, FALSE, NULL))) {
+      wsi_dxgi12_destroy(d);
+      return NULL;
+   }
+   for (uint32_t k = 0; k < RING; k++) {
+      if (FAILED(d->device->CreateCommandAllocator(d->type, __uuidof(ID3D12CommandAllocator),
+                                                   (void **)&d->alloc[k])) ||
+          FAILED(d->device->CreateCommandList(0, d->type, d->alloc[k], NULL,
+                                              __uuidof(ID3D12GraphicsCommandList),
+                                              (void **)&d->list[k]))) {
+         wsi_dxgi12_destroy(d);
+         return NULL;
+      }
+      d->list[k]->Close();
+   }
+   return d;
+}
+
+void
+wsi_dxgi12_idle(struct wsi_dxgi12 *d)
+{
+   if (!d->fence)
+      return;
+   AcquireSRWLockExclusive(&d->lock);
+   const uint64_t v = ++d->value;
+   d->queue->Signal(d->fence, v);
+   ReleaseSRWLockExclusive(&d->lock);
+   wsi_dxgi12_copy_done(d, v, 2000);
+}
+
+void
+wsi_dxgi12_release_buffers(struct wsi_dxgi12 *d)
+{
+   wsi_dxgi12_idle(d);
+   for (uint32_t i = 0; i < 16; i++) {
+      if (d->buffers[i])
+         d->buffers[i]->Release();
+      d->buffers[i] = NULL;
+   }
+   for (uint32_t k = 0; k < RING; k++) {
+      if (d->ring[k])
+         d->ring[k]->Release();
+      d->ring[k] = NULL;
+   }
+   d->count = 0;
+}
+
+void
+wsi_dxgi12_destroy(struct wsi_dxgi12 *d)
+{
+   if (!d)
+      return;
+   if (d->queue)
+      wsi_dxgi12_release_buffers(d);
+   for (uint32_t k = 0; k < RING; k++) {
+      if (d->list[k])
+         d->list[k]->Release();
+      if (d->alloc[k])
+         d->alloc[k]->Release();
+   }
+   if (d->fence)
+      d->fence->Release();
+   if (d->event)
+      CloseHandle(d->event);
+   if (d->device)
+      d->device->Release();
+   if (d->queue)
+      d->queue->Release();
+   free(d);
+}
+
+static ID3D12Resource *
+texture(struct wsi_dxgi12 *d, uint32_t w, uint32_t h, DXGI_FORMAT f,
+        D3D12_RESOURCE_FLAGS flags, D3D12_HEAP_FLAGS heap_flags)
+{
+   D3D12_HEAP_PROPERTIES hp = {};
+   hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+   D3D12_RESOURCE_DESC rd = {};
+   rd.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+   rd.Width = w;
+   rd.Height = h;
+   rd.DepthOrArraySize = 1;
+   rd.MipLevels = 1;
+   rd.Format = f;
+   rd.SampleDesc.Count = 1;
+   rd.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+   rd.Flags = flags;
+   ID3D12Resource *r = NULL;
+   if (FAILED(d->device->CreateCommittedResource(&hp, heap_flags, &rd,
+                                                 D3D12_RESOURCE_STATE_COMMON, NULL,
+                                                 __uuidof(ID3D12Resource), (void **)&r)))
+      return NULL;
+   return r;
+}
+
+bool
+wsi_dxgi12_buffers_create(struct wsi_dxgi12 *d, uint32_t count, uint32_t w,
+                          uint32_t h, uint32_t format, uint32_t usage)
+{
+   D3D12_RESOURCE_FLAGS flags = D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
+   if (usage & 0x400 /* DXGI_USAGE_UNORDERED_ACCESS */)
+      flags |= D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+   d->count = count;
+   for (uint32_t i = 0; i < count && i < 16; i++) {
+      d->buffers[i] = texture(d, w, h, (DXGI_FORMAT)format, flags, D3D12_HEAP_FLAG_NONE);
+      if (!d->buffers[i])
+         return false;
+   }
+   return true;
+}
+
+bool
+wsi_dxgi12_ring_create(struct wsi_dxgi12 *d, uint32_t k, uint32_t w, uint32_t h,
+                       uint32_t format, void **nt_handle)
+{
+   d->ring[k] = texture(d, w, h, (DXGI_FORMAT)format,
+                        D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET |
+                        D3D12_RESOURCE_FLAG_ALLOW_SIMULTANEOUS_ACCESS,
+                        D3D12_HEAP_FLAG_SHARED);
+   if (!d->ring[k])
+      return false;
+   HANDLE h_ = NULL;
+   if (FAILED(d->device->CreateSharedHandle(d->ring[k], NULL, GENERIC_ALL, NULL, &h_)))
+      return false;
+   *nt_handle = h_;
+   return true;
+}
+
+bool
+wsi_dxgi12_get_buffer(struct wsi_dxgi12 *d, uint32_t i, const void *riid, void **out)
+{
+   if (i >= d->count || !d->buffers[i])
+      return false;
+   return SUCCEEDED(d->buffers[i]->QueryInterface(*(const IID *)riid, out));
+}
+
+static D3D12_RESOURCE_BARRIER
+transition(ID3D12Resource *r, D3D12_RESOURCE_STATES from, D3D12_RESOURCE_STATES to)
+{
+   D3D12_RESOURCE_BARRIER b = {};
+   b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+   b.Transition.pResource = r;
+   b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+   b.Transition.StateBefore = from;
+   b.Transition.StateAfter = to;
+   return b;
+}
+
+bool
+wsi_dxgi12_copy(struct wsi_dxgi12 *d, uint32_t index, uint32_t k, uint64_t *value)
+{
+   if (index >= d->count || !d->buffers[index] || !d->ring[k])
+      return false;
+   ID3D12GraphicsCommandList *l = d->list[k];
+   /* ring k is free: its last copy and the passes over it are done */
+   if (FAILED(d->alloc[k]->Reset()) || FAILED(l->Reset(d->alloc[k], NULL)))
+      return false;
+   /* The back buffer is in PRESENT (COMMON) as DXGI hands it over; the ring
+    * texture allows simultaneous access and stays COMMON */
+   D3D12_RESOURCE_BARRIER b = transition(d->buffers[index], D3D12_RESOURCE_STATE_PRESENT,
+                                         D3D12_RESOURCE_STATE_COPY_SOURCE);
+   l->ResourceBarrier(1, &b);
+   l->CopyResource(d->ring[k], d->buffers[index]);
+   b = transition(d->buffers[index], D3D12_RESOURCE_STATE_COPY_SOURCE,
+                  D3D12_RESOURCE_STATE_PRESENT);
+   l->ResourceBarrier(1, &b);
+   if (FAILED(l->Close()))
+      return false;
+   ID3D12CommandList *lists[1] = { l };
+   AcquireSRWLockExclusive(&d->lock);
+   d->queue->ExecuteCommandLists(1, lists);
+   *value = ++d->value;
+   d->queue->Signal(d->fence, *value);
+   ReleaseSRWLockExclusive(&d->lock);
+   return true;
+}
+
+bool
+wsi_dxgi12_copy_done(struct wsi_dxgi12 *d, uint64_t value, uint32_t timeout_ms)
+{
+   if (d->fence->GetCompletedValue() >= value)
+      return true;
+   /* one waiter at a time per event (the present thread, or an idle wait
+    * while it is stopped) */
+   if (FAILED(d->fence->SetEventOnCompletion(value, d->event)))
+      return false;
+   if (d->fence->GetCompletedValue() >= value)
+      return true;
+   return WaitForSingleObject(d->event, timeout_ms) == WAIT_OBJECT_0 ||
+          d->fence->GetCompletedValue() >= value;
+}
