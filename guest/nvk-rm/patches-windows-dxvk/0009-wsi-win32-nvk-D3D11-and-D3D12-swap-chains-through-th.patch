+
+/* ---- set-up -------------------------------------------------------------- */
+
+static thread_local bool internal_create;
+
+VkResult
+wsi_dxgi_proxy::build()
+{
+   const struct wsi_device *wsi = pvk.wsi;
+   VkResult r;
+
+   /* The output: the window's size with a scaler, else the buffers' */
+   out = { desc.Width, desc.Height };
+   if (cfg.scaler != WSI_ENH_SCALER_OFF) {
+      const VkExtent2D client = wsi_win32_client_extent(hwnd);
+      if (client.width && client.height)
+         out = client;
+   }
+   internal_create = true;
+   r = wsi_win32_compose_open(&compose, hwnd, out.width, out.height, vk_format, 3);
+   internal_create = false;
+   if (r != VK_SUCCESS)
+      return r;
+
+   /* The ring, on the application's device */
+   for (uint32_t k = 0; k < RING; k++) {
+      struct ring_entry *e = &ring[k];
+      struct wsi_win32_compose_import imp = {};
+      if (d3d11) {
+         D3D11_TEXTURE2D_DESC td = {};
+         td.Width = desc.Width;
+         td.Height = desc.Height;
+         td.MipLevels = 1;
+         td.ArraySize = 1;
+         td.Format = copy_format;
+         td.SampleDesc.Count = 1;
+         td.Usage = D3D11_USAGE_DEFAULT;
+         td.BindFlags = D3D11_BIND_RENDER_TARGET | D3D11_BIND_SHADER_RESOURCE;
+         td.MiscFlags = D3D11_RESOURCE_MISC_SHARED;
+         ID3D11Texture2D *tex = NULL;
+         HRESULT hr = d3d11->CreateTexture2D(&td, NULL, &tex);
+         if (FAILED(hr)) {
+            LOGE("ring texture %ux%u: 0x%08lx", desc.Width, desc.Height, (unsigned long)hr);
+            return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+         }
+         r = wsi_win32_compose_wrap_texture(compose, tex, &e->wrap, &imp);
+         tex->Release();
+         if (r != VK_SUCCESS)
+            return r;
+         D3D11_QUERY_DESC qd = { D3D11_QUERY_EVENT, 0 };
+         if (FAILED(d3d11->CreateQuery(&qd, &e->query)))
+            return VK_ERROR_INITIALIZATION_FAILED;
+      } else {
+         void *nt = NULL;
+         if (!wsi_dxgi12_ring_create(d12, k, desc.Width, desc.Height, copy_format, &nt))
+            return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+         r = wsi_win32_compose_wrap_nt_handle(compose, nt, &e->wrap, &imp);
+         CloseHandle((HANDLE)nt);
+         if (r != VK_SUCCESS)
+            return r;
+      }
+      r = pvk_import(&imp, vk_format, desc.Width, desc.Height,
+                     VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT |
+                     VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT,
+                     &e->image, &e->mem);
+      if (r != VK_SUCCESS) {
+         LOGE("ring texture %u: import into NVK failed: %d", k, (int)r);
+         return r;
+      }
+      e->state = RING_FREE;
+   }
+
+   /* The output slots, on the composed present's device */
+   nslots = !wsi_enh_config_fg(&cfg) ? 3 :
+            (cfg.fg_adaptive ? WSI_ENH_MAX_PICS : MAX2(cfg.fg_mult, 2u)) + 3;
+   for (uint32_t i = 0; i < nslots; i++) {
+      struct wsi_win32_compose_import imp = {};
+      r = wsi_win32_compose_image_create(compose, out.width, out.height,
+                                         &slots[i].wrap, &imp);
+      if (r != VK_SUCCESS)
+         return r;
+      r = pvk_import(&imp, vk_format, out.width, out.height,
+                     VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_SAMPLED_BIT |
+                     VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT |
+                     VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT,
+                     &slots[i].image, &slots[i].mem);
+      if (r != VK_SUCCESS) {
+         LOGE("output slot %u: import into NVK failed: %d", i, (int)r);
+         return r;
+      }
+   }
+
+   VkImage src[RING], dst[MAX_SLOTS];
+   for (uint32_t k = 0; k < RING; k++)
+      src[k] = ring[k].image;
+   for (uint32_t i = 0; i < nslots; i++)
+      dst[i] = slots[i].image;
+   struct wsi_enh_create_info ci = {};
+   ci.device = pvk.device;
+   ci.wsi = wsi;
+   ci.alloc = vk_default_allocator();
+   ci.config = cfg;
+   ci.src_format = vk_format;
+   ci.src_extent = { desc.Width, desc.Height };
+   ci.src_count = RING;
+   ci.src_images = src;
+   ci.dst_format = vk_format;
+   ci.dst_extent = out;
+   ci.slot_count = nslots;
+   ci.slot_images = dst;
+   r = wsi_enh_create(&ci, &enh);
+   if (r != VK_SUCCESS)
+      return r;
+   wsi_enh_set_refresh(enh, wsi_win32_refresh_ns(hwnd));
+   VkFenceCreateInfo fci = {};
+   fci.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO;
+   r = wsi->CreateFence(pvk.device, &fci, NULL, &fence);
+   if (r != VK_SUCCESS)
+      return r;
+
+   /* The application's back buffers */
+   if (d3d11) {
+      D3D11_TEXTURE2D_DESC td = {};
+      td.Width = desc.Width;
+      td.Height = desc.Height;
+      td.MipLevels = 1;
+      td.ArraySize = 1;
+      td.Format = desc.Format;
+      td.SampleDesc.Count = 1;
+      td.Usage = D3D11_USAGE_DEFAULT;
+      td.BindFlags = D3D11_BIND_RENDER_TARGET;
+      if (desc.BufferUsage & DXGI_USAGE_SHADER_INPUT)
+         td.BindFlags |= D3D11_BIND_SHADER_RESOURCE;
+      if (desc.BufferUsage & DXGI_USAGE_UNORDERED_ACCESS)
+         td.BindFlags |= D3D11_BIND_UNORDERED_ACCESS;
+      HRESULT hr = d3d11->CreateTexture2D(&td, NULL, &bb);
+      if (FAILED(hr)) {
+         LOGE("back buffer %ux%u format %d: 0x%08lx", desc.Width, desc.Height,
+              (int)desc.Format, (unsigned long)hr);
+         return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+      }
+   } else if (!wsi_dxgi12_buffers_create(d12, desc.BufferCount, desc.Width,
+                                         desc.Height, desc.Format, desc.BufferUsage)) {
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   }
+   LOGI("%s swap chain %ux%u (format %d, %u buffers) on window %p: presented "
+        "through NVK at %ux%u, scaler %s, frame generation %s%ux",
+        d3d11 ? "D3D11" : "D3D12", desc.Width, desc.Height, (int)desc.Format,
+        desc.BufferCount, (void *)hwnd, out.width, out.height,
+        wsi_enh_scaler_name(cfg.scaler), cfg.fg_adaptive ? "adaptive " : "",
+        cfg.fg_mult);
+   return VK_SUCCESS;
+}
+
+void
+wsi_dxgi_proxy::teardown()
+{
+   const struct wsi_device *wsi = pvk.wsi;
+   if (fence) {
+      wsi->DestroyFence(pvk.device, fence, NULL);
+      fence = VK_NULL_HANDLE;
+   }
+   if (enh) {
+      wsi_enh_destroy(enh);
+      enh = NULL;
+   }
+   for (uint32_t i = 0; i < MAX_SLOTS; i++) {
+      if (slots[i].image)
+         wsi->DestroyImage(pvk.device, slots[i].image, NULL);
+      if (slots[i].mem)
+         wsi->FreeMemory(pvk.device, slots[i].mem, NULL);
+      if (slots[i].wrap.texture || slots[i].wrap.kmt_resource)
+         wsi_win32_compose_image_destroy(compose, &slots[i].wrap);
+      memset(&slots[i], 0, sizeof(slots[i]));
+   }
+   nslots = 0;
+   for (uint32_t k = 0; k < RING; k++) {
+      struct ring_entry *e = &ring[k];
+      if (e->image)
+         wsi->DestroyImage(pvk.device, e->image, NULL);
+      if (e->mem)
+         wsi->FreeMemory(pvk.device, e->mem, NULL);
+      if (e->query)
+         e->query->Release();
+      if (e->wrap.texture || e->wrap.kmt_resource)
+         wsi_win32_compose_image_destroy(compose, &e->wrap);
+      memset(e, 0, sizeof(*e));
+   }
+   if (d12)
+      wsi_dxgi12_release_buffers(d12);
+   if (bb) {
+      bb->Release();
+      bb = NULL;
+   }
+}
+
+static struct wsi_dxgi_proxy *
+proxy_create(IDXGIFactory2 *factory, IUnknown *dev, HWND hwnd,
+             const DXGI_SWAP_CHAIN_DESC1 *d, const DXGI_SWAP_CHAIN_FULLSCREEN_DESC *fs)
+{
+   if (!hwnd || !d || d->SampleDesc.Count > 1 ||
+       (d->SwapEffect != DXGI_SWAP_EFFECT_FLIP_DISCARD &&
+        d->SwapEffect != DXGI_SWAP_EFFECT_FLIP_SEQUENTIAL &&
+        d->SwapEffect != DXGI_SWAP_EFFECT_DISCARD &&
+        d->SwapEffect != DXGI_SWAP_EFFECT_SEQUENTIAL))
+      return NULL;
+   struct wsi_enh_config cfg;
+   wsi_enh_config_get(&cfg);
+   if (!cfg.d3d || !wsi_enh_config_applies(&cfg, hwnd))
+      return NULL;
+   VkFormat vkf;
+   DXGI_FORMAT copy_fmt;
+   if (!vk_format_of(d->Format, &vkf, &copy_fmt)) {
+      LOGI("format %d is not enhanced", (int)d->Format);
+      return NULL;
+   }
+   if (!pvk_get())
+      return NULL;
+
+   ID3D11Device *d3d11 = NULL;
+   struct wsi_dxgi12 *d12 = NULL;
+   if (FAILED(dev->QueryInterface(__uuidof(ID3D11Device), (void **)&d3d11))) {
+      d3d11 = NULL;
+      d12 = wsi_dxgi12_create(dev);
+      if (!d12)
+         return NULL;
+   }
+
+   wsi_dxgi_proxy *p = new wsi_dxgi_proxy();
+   p->factory = factory;
+   factory->AddRef();
+   p->device = dev;
+   dev->AddRef();
+   p->hwnd = hwnd;
+   p->desc = *d;
+   if (p->desc.Width == 0 || p->desc.Height == 0) {
+      const VkExtent2D c = wsi_win32_client_extent(hwnd);
+      p->desc.Width = MAX2(c.width, 1u);
+      p->desc.Height = MAX2(c.height, 1u);
+   }
+   p->desc.BufferCount = CLAMP(p->desc.BufferCount, 1u, 16u);
+   if (fs)
+      p->fs = *fs;
+   else
+      p->fs.Windowed = TRUE;
+   p->vk_format = vkf;
+   p->copy_format = copy_fmt;
+   p->cfg = cfg;
+   p->d3d11 = d3d11;
+   p->d12 = d12;
+   if (d3d11) {
+      d3d11->GetImmediateContext(&p->ctx);
+      /* The present thread asks the immediate context whether a copy is
+       * done: the runtime then serialises it with the application's calls */
+      ID3D11Multithread *mt = NULL;
+      if (SUCCEEDED(p->ctx->QueryInterface(__uuidof(ID3D11Multithread), (void **)&mt))) {
+         mt->SetMultithreadProtected(TRUE);
+         mt->Release();
+      }
+   }
+   if (d->Flags & DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT)
+      p->latency_sem = CreateSemaphoreA(NULL, 1, 16, NULL);
+   p->wake = CreateEventA(NULL, FALSE, FALSE, NULL);
+   p->timer = CreateWaitableTimerExW(NULL, NULL, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION,
+                                     TIMER_ALL_ACCESS);
+
+   VkResult r = p->build();
+   if (r != VK_SUCCESS) {
+      LOGE("swap chain on window %p not enhanced (%d): DXGI's own instead",
+           (void *)hwnd, (int)r);
+      p->Release();
+      return NULL;
+   }
+   p->start_thread();
+   return p;
+}
+
+/* ---- COM ------------------------------------------------------------------ */
+
+HRESULT STDMETHODCALLTYPE
+wsi_dxgi_proxy::QueryInterface(REFIID riid, void **out)
+{
+   if (!out)
+      return E_POINTER;
+   if (riid == __uuidof(IUnknown) || riid == __uuidof(IDXGIObject) ||
+       riid == __uuidof(IDXGIDeviceSubObject) || riid == __uuidof(IDXGISwapChain) ||
+       riid == __uuidof(IDXGISwapChain1) || riid == __uuidof(IDXGISwapChain2) ||
+       riid == __uuidof(IDXGISwapChain3) || riid == __uuidof(IDXGISwapChain4)) {
+      *out = static_cast<IDXGISwapChain4 *>(this);
+      AddRef();
+      return S_OK;
+   }
+   *out = NULL;
+   return E_NOINTERFACE;
+}
+
+ULONG STDMETHODCALLTYPE
+wsi_dxgi_proxy::Release()
+{
+   const LONG n = InterlockedDecrement(&refs);
+   if (n != 0)
+      return n;
+   stop_thread();
+   if (pvk.ok) {
+      AcquireSRWLockExclusive(&pvk.queue_lock);
+      pvk.wsi->WaitForFences(pvk.device, 1, &fence, true, 2000ull * 1000 * 1000);
+      ReleaseSRWLockExclusive(&pvk.queue_lock);
+   }
+   teardown();
+   for (UINT i = 0; i < npriv; i++) {
+      free(priv[i].data);
+      if (priv[i].iface)
+         priv[i].iface->Release();
+   }
+   if (compose)
+      wsi_win32_compose_destroy(compose);
+   if (d12)
+      wsi_dxgi12_destroy(d12);
+   if (ctx)
+      ctx->Release();
+   if (d3d11)
+      d3d11->Release();
+   if (device)
+      device->Release();
+   if (factory)
+      factory->Release();
+   if (latency_sem)
+      CloseHandle(latency_sem);
+   if (wake)
+      CloseHandle(wake);
+   if (timer)
+      CloseHandle(timer);
+   delete this;
+   return 0;
+}
+
+HRESULT STDMETHODCALLTYPE
+wsi_dxgi_proxy::SetPrivateData(REFGUID g, UINT size, const void *data)
+{
+   for (UINT i = 0; i < npriv; i++) {
+      if (priv[i].guid == g) {
+         free(priv[i].data);
+         if (priv[i].iface)
+            priv[i].iface->Release();
+         priv[i] = priv[--npriv];
+         break;
+      }
+   }
+   if (!data || !size)
+      return S_OK;
+   if (npriv == ARRAY_SIZE(priv))
+      return E_OUTOFMEMORY;
+   priv[npriv].guid = g;
+   priv[npriv].size = size;
+   priv[npriv].data = malloc(size);
+   priv[npriv].iface = NULL;
+   memcpy(priv[npriv].data, data, size);
+   npriv++;
+   return S_OK;
+}
+
+HRESULT STDMETHODCALLTYPE
+wsi_dxgi_proxy::SetPrivateDataInterface(REFGUID g, const IUnknown *u)
+{
+   SetPrivateData(g, 0, NULL);
+   if (!u)
+      return S_OK;
+   if (npriv == ARRAY_SIZE(priv))
+      return E_OUTOFMEMORY;
+   IUnknown *iu = const_cast<IUnknown *>(u);
+   iu->AddRef();
+   priv[npriv].guid = g;
+   priv[npriv].size = sizeof(IUnknown *);
+   priv[npriv].data = NULL;
+   priv[npriv].iface = iu;
+   npriv++;
+   return S_OK;
+}
+
+HRESULT STDMETHODCALLTYPE
+wsi_dxgi_proxy::GetPrivateData(REFGUID g, UINT *size, void *data)
+{
+   for (UINT i = 0; i < npriv; i++) {
+      if (priv[i].guid != g)
+         continue;
+      if (!data) {
+         *size = priv[i].size;
+         return S_OK;
+      }
+      if (*size < priv[i].size)
+         return DXGI_ERROR_MORE_DATA;
+      *size = priv[i].size;
+      if (priv[i].iface) {
+         priv[i].iface->AddRef();
+         memcpy(data, &priv[i].iface, sizeof(IUnknown *));
+      } else {
+         memcpy(data, priv[i].data, priv[i].size);
+      }
+      return S_OK;
+   }
+   *size = 0;
+   return DXGI_ERROR_NOT_FOUND;
+}
+
+HRESULT STDMETHODCALLTYPE
+wsi_dxgi_proxy::GetBuffer(UINT i, REFIID riid, void **out)
+{
+   if (d3d11) {
+      /* Flip-model D3D11 chains expose buffer 0, always the one to draw */
+      if (i != 0 || !bb)
+         return DXGI_ERROR_INVALID_CALL;
+      return bb->QueryInterface(riid, out);
+   }
+   return wsi_dxgi12_get_buffer(d12, i, &riid, out) ? S_OK : DXGI_ERROR_INVALID_CALL;
+}
+
+UINT STDMETHODCALLTYPE
+wsi_dxgi_proxy::GetCurrentBackBufferIndex()
+{
+   return d3d11 ? 0 : present_count % desc.BufferCount;
+}
+
+HRESULT STDMETHODCALLTYPE
+wsi_dxgi_proxy::GetDesc(DXGI_SWAP_CHAIN_DESC *d)
+{
+   memset(d, 0, sizeof(*d));
+   d->BufferDesc.Width = desc.Width;
+   d->BufferDesc.Height = desc.Height;
+   d->BufferDesc.RefreshRate = fs.RefreshRate;
+   d->BufferDesc.Format = desc.Format;
+   d->BufferDesc.ScanlineOrdering = fs.ScanlineOrdering;
+   d->BufferDesc.Scaling = fs.Scaling;
+   d->SampleDesc = desc.SampleDesc;
+   d->BufferUsage = desc.BufferUsage;
+   d->BufferCount = desc.BufferCount;
+   d->OutputWindow = hwnd;
+   d->Windowed = !fullscreen;
+   d->SwapEffect = desc.SwapEffect;
+   d->Flags = desc.Flags;
+   return S_OK;
+}
+
+HRESULT STDMETHODCALLTYPE
+wsi_dxgi_proxy::ResizeBuffers(UINT n, UINT w, UINT h, DXGI_FORMAT f, UINT flags)
+{
+   (void)flags;
+   stop_thread();
+   AcquireSRWLockExclusive(&pvk.queue_lock);
+   pvk.wsi->WaitForFences(pvk.device, 1, &fence, true, 2000ull * 1000 * 1000);
+   ReleaseSRWLockExclusive(&pvk.queue_lock);
+   if (ctx)
+      ctx->Flush();
+   if (d12)
+      wsi_dxgi12_idle(d12);
+   teardown();
+   if (n)
+      desc.BufferCount = CLAMP(n, 1u, 16u);
+   if (f != DXGI_FORMAT_UNKNOWN) {
+      if (!vk_format_of(f, &vk_format, &copy_format))
+         return DXGI_ERROR_INVALID_CALL;
+      desc.Format = f;
+   }
+   if (w == 0 || h == 0) {
+      const VkExtent2D c = wsi_win32_client_extent(hwnd);
+      w = MAX2(c.width, 1u);
+      h = MAX2(c.height, 1u);
+   }
+   desc.Width = w;
+   desc.Height = h;
+   present_count = 0;
+   wsi_enh_config_get(&cfg);
+   const VkResult r = build();
+   if (r != VK_SUCCESS) {
+      LOGE("ResizeBuffers(%u, %ux%u): %d", n, w, h, (int)r);
+      teardown();
+      return DXGI_ERROR_DEVICE_REMOVED;
+   }
+   start_thread();
+   return S_OK;
+}
+
+HRESULT STDMETHODCALLTYPE
+wsi_dxgi_proxy::ResizeTarget(const DXGI_MODE_DESC *m)
+{
+   if (!m || fullscreen || !m->Width || !m->Height)
+      return S_OK;
+   RECT r = { 0, 0, (LONG)m->Width, (LONG)m->Height };
+   AdjustWindowRectEx(&r, (DWORD)GetWindowLongW(hwnd, GWL_STYLE), FALSE,
+                      (DWORD)GetWindowLongW(hwnd, GWL_EXSTYLE));
+   SetWindowPos(hwnd, NULL, 0, 0, r.right - r.left, r.bottom - r.top,
+                SWP_NOMOVE | SWP_NOZORDER | SWP_NOACTIVATE);
+   return S_OK;
+}
+
+HRESULT STDMETHODCALLTYPE
+wsi_dxgi_proxy::GetContainingOutput(IDXGIOutput **o)
+{
+   *o = NULL;
+   HMONITOR mon = MonitorFromWindow(hwnd, MONITOR_DEFAULTTONEAREST);
+   IDXGIAdapter1 *a = NULL;
+   IDXGIFactory1 *f1 = NULL;
+   if (FAILED(factory->QueryInterface(__uuidof(IDXGIFactory1), (void **)&f1)))
+      return DXGI_ERROR_NOT_FOUND;
+   HRESULT result = DXGI_ERROR_NOT_FOUND;
+   for (UINT i = 0; result != S_OK && f1->EnumAdapters1(i, &a) != DXGI_ERROR_NOT_FOUND; i++) {
+      IDXGIOutput *out_ = NULL;
+      for (UINT j = 0; a->EnumOutputs(j, &out_) != DXGI_ERROR_NOT_FOUND; j++) {
+         DXGI_OUTPUT_DESC od;
+         if (SUCCEEDED(out_->GetDesc(&od)) && od.Monitor == mon) {
+            *o = out_;
+            result = S_OK;
+            break;
+         }
+         out_->Release();
+      }
+      a->Release();
+   }
+   f1->Release();
+   return result;
+}
+
+/* ---- present ------------------------------------------------------------- */
+
+HRESULT STDMETHODCALLTYPE
+wsi_dxgi_proxy::Present(UINT sync, UINT flags)
+{
+   if (flags & DXGI_PRESENT_TEST)
+      return IsIconic(hwnd) ? DXGI_STATUS_OCCLUDED : S_OK;
+   if (!enh)
+      return DXGI_ERROR_DEVICE_REMOVED;
+
+   /* A free ring texture: the passes of an earlier frame may still read
+    * it, never for long */
+   const uint64_t start = os_time_get_nano();
+   uint32_t k = UINT32_MAX;
+   AcquireSRWLockExclusive(&lock);
+   for (;;) {
+      for (uint32_t i = 0; i < RING; i++) {
+         const uint32_t c = (present_count + i) % RING;
+         if (ring[c].state == RING_FREE) {
+            k = c;
+            break;
+         }
+      }
+      if (k != UINT32_MAX || os_time_get_nano() - start > 100ull * 1000 * 1000)
+         break;
+      SleepConditionVariableSRW(&cond, &lock, 1, 0);
+   }
+   if (k != UINT32_MAX)
+      ring[k].state = RING_COPYING;
+   ReleaseSRWLockExclusive(&lock);
+
+   const UINT index = GetCurrentBackBufferIndex();
+   present_count++;
+   if (k == UINT32_MAX) {
+      dropped++;
+      return S_OK;
+   }
+
+   uint64_t value = 0;
+   if (d3d11) {
+      ctx->CopyResource((ID3D11Resource *)ring[k].wrap.texture, bb);
+      ctx->End(ring[k].query);
+      ctx->Flush();
+   } else if (!wsi_dxgi12_copy(d12, index, k, &value)) {
+      AcquireSRWLockExclusive(&lock);
+      ring[k].state = RING_FREE;
+      ReleaseSRWLockExclusive(&lock);
+      return DXGI_ERROR_DEVICE_REMOVED;
+   }
+
+   AcquireSRWLockExclusive(&lock);
+   /* Newest first; an older frame still waiting goes when the thread sees
+    * this one (as MAILBOX) */
+   if (qn == RING) {
+      ring[q[0].ring].state = RING_FREE;
+      memmove(q, q + 1, sizeof(q[0]) * (RING - 1));
+      qn--;
+      dropped++;
+   }
+   q[qn].ring = k;
+   q[qn].present_ns = start;
+   q[qn].value = value;
+   q[qn].sync_interval = sync;
+   qn++;
+   ReleaseSRWLockExclusive(&lock);
+   WakeAllConditionVariable(&cond);
+   SetEvent(wake);
+   return IsIconic(hwnd) ? DXGI_STATUS_OCCLUDED : S_OK;
+}
+
+/* ---- the present thread -------------------------------------------------- */
+
+void
+wsi_dxgi_proxy::start_thread()
+{
+   stop = false;
+   qn = 0;
+   thread = CreateThread(NULL, 0, proxy_thread, this, 0, NULL);
+}
+
+void
+wsi_dxgi_proxy::stop_thread()
+{
+   if (!thread)
+      return;
+   AcquireSRWLockExclusive(&lock);
+   stop = true;
+   ReleaseSRWLockExclusive(&lock);
+   WakeAllConditionVariable(&cond);
+   SetEvent(wake);
+   if (WaitForSingleObject(thread, 5000) != WAIT_OBJECT_0)
+      LOGE("the present thread did not stop in 5 s");
+   CloseHandle(thread);
+   thread = NULL;
+   for (uint32_t k = 0; k < RING; k++)
+      ring[k].state = RING_FREE;
+   qn = 0;
+}
+
+static DWORD WINAPI
+proxy_thread(LPVOID param)
+{
+   wsi_dxgi_proxy *p = (wsi_dxgi_proxy *)param;
+   /* No reference of its own: the last Release stops and joins it */
+   p->run();
+   return 0;
+}
+
+bool
+wsi_dxgi_proxy::copy_done(uint32_t k, uint64_t value)
+{
+   if (d12)
+      return wsi_dxgi12_copy_done(d12, value, 2000);
+   const uint64_t start = os_time_get_nano();
+   for (;;) {
+      BOOL done = FALSE;
+      HRESULT hr = ctx->GetData(ring[k].query, &done, sizeof(done),
+                                D3D11_ASYNC_GETDATA_DONOTFLUSH);
+      if (hr == S_OK && done)
+         return true;
+      if (FAILED(hr))
+         return false;
+      const uint64_t spent = os_time_get_nano() - start;
+      if (spent > 2000ull * 1000 * 1000)
+         return false;
+      if (spent > 2ull * 1000 * 1000)
+         Sleep(1);
+      else
+         SwitchToThread();
+   }
+}
+
+/* Until `due`; true when a newer frame (or the end) came first */
+static bool
+pace_wait(wsi_dxgi_proxy *p, uint64_t due)
+{
+   for (;;) {
+      if (p_atomic_read(&p->qn) > 0 || p_atomic_read(&p->stop))
+         return true;
+      const uint64_t now = os_time_get_nano();
+      if (now >= due)
+         return false;
+      const uint64_t left = due - now;
+      if (left > 1500 * 1000 && p->timer) {
+         LARGE_INTEGER t;
+         t.QuadPart = -(LONGLONG)((left - 700 * 1000) / 100);
+         HANDLE h[2] = { p->timer, p->wake };
+         if (SetWaitableTimer(p->timer, &t, 0, NULL, NULL, FALSE))
+            WaitForMultipleObjects(2, h, FALSE, INFINITE);
+         else
+            Sleep(1);
+      } else {
+         SwitchToThread();
+      }
+   }
+}
+
+void
+wsi_dxgi_proxy::run()
+{
+   const struct wsi_device *wsi = pvk.wsi;
+   u_thread_setname("wsi-dxgi-enh");
+   uint64_t next_check = 0;
+   for (;;) {
+      AcquireSRWLockExclusive(&lock);
+      while (!stop && qn == 0)
+         SleepConditionVariableSRW(&cond, &lock, INFINITE, 0);
+      if (stop) {
+         ReleaseSRWLockExclusive(&lock);
+         break;
+      }
+      /* the newest frame; older ones are dropped unshown */
+      while (qn > 1) {
+         ring[q[0].ring].state = RING_FREE;
+         memmove(q, q + 1, sizeof(q[0]) * (qn - 1));
+         qn--;
+         dropped++;
+      }
+      const struct frame_req f = q[0];
+      qn = 0;
+      ReleaseSRWLockExclusive(&lock);
+      WakeAllConditionVariable(&cond);
+
+      const uint64_t now = os_time_get_nano();
+      if (now > next_check) {
+         next_check = now + 250ull * 1000 * 1000;
+         struct wsi_enh_config c;
+         wsi_enh_config_get(&c);
+         wsi_enh_update_config(enh, &c);
+         wsi_enh_set_refresh(enh, wsi_win32_refresh_ns(hwnd));
+      }
+
+      bool ok = copy_done(f.ring, f.value);
+      struct wsi_enh_plan plan = {};
+      if (ok) {
+         const uint32_t want = wsi_enh_pictures(enh, f.present_ns);
+         /* slots whose copy into the DXGI back buffer is done */
+         for (uint32_t i = 0; i < nslots && plan.count < want; i++) {
+            const uint32_t s = (slot_next + i) % nslots;
+            if (wsi_win32_compose_image_wait(compose, &slots[s].wrap, 0) == VK_SUCCESS)
+               plan.slot[plan.count++] = s;
+         }
+         if (plan.count == 0) {
+            /* all being copied: wait for the oldest */
+            wsi_win32_compose_image_wait(compose, &slots[slot_next].wrap, 100ull * 1000 * 1000);
+            plan.slot[plan.count++] = slot_next;
+         }
+         slot_next = (plan.slot[plan.count - 1] + 1) % nslots;
+         VkCommandBuffer cmd = wsi_enh_record(enh, pvk.qfi, f.ring, &plan);
+         ok = cmd != VK_NULL_HANDLE;
+         if (ok) {
+            VkCommandBufferSubmitInfo cbi = {};
+            cbi.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_SUBMIT_INFO;
+            cbi.commandBuffer = cmd;
+            VkSubmitInfo2 si = {};
+            si.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO_2;
+            si.commandBufferInfoCount = 1;
+            si.pCommandBufferInfos = &cbi;
+            AcquireSRWLockExclusive(&pvk.queue_lock);
+            wsi->ResetFences(pvk.device, 1, &fence);
+            ok = wsi->QueueSubmit2(pvk.queue, 1, &si, fence) == VK_SUCCESS;
+            ReleaseSRWLockExclusive(&pvk.queue_lock);
+            ok = ok && wsi->WaitForFences(pvk.device, 1, &fence, true,
+                                          2000ull * 1000 * 1000) == VK_SUCCESS;
+         }
+      }
+      /* the ring texture has been read */
+      AcquireSRWLockExclusive(&lock);
+      ring[f.ring].state = RING_FREE;
+      ReleaseSRWLockExclusive(&lock);
+      WakeAllConditionVariable(&cond);
+      if (latency_sem)
+         ReleaseSemaphore(latency_sem, 1, NULL);
+      if (!ok) {
+         if (dropped++ < 4)
+            LOGE("frame dropped: the copy or the passes did not finish");
+         continue;
+      }
+
+      const uint64_t t0 = os_time_get_nano();
+      uint32_t generated = 0, skipped = 0;
+      for (uint32_t k = 0; k < plan.count; k++) {
+         const bool real = k + 1 == plan.count;
+         if (k > 0 && pace_wait(this, t0 + k * plan.spacing_ns) && !real) {
+            skipped = plan.count - 1 - k;
+            k = plan.count - 1;
+         }
+         if (wsi_win32_compose_present(compose, &slots[plan.slot[k]].wrap,
+                                       MIN2(f.sync_interval, 1u)) == VK_SUCCESS &&
+             k + 1 < plan.count)
+            generated++;
+      }
+      wsi_enh_note_shown(enh, 1, generated, skipped);
+   }
+}
+
+/* ---- the hooks ------------------------------------------------------------ */
+
+typedef HRESULT (STDMETHODCALLTYPE *PFN_create_sc)(IDXGIFactory *, IUnknown *,
+                                                   DXGI_SWAP_CHAIN_DESC *,
+                                                   IDXGISwapChain **);
+typedef HRESULT (STDMETHODCALLTYPE *PFN_create_hwnd)(IDXGIFactory2 *, IUnknown *, HWND,
+                                                     const DXGI_SWAP_CHAIN_DESC1 *,
+                                                     const DXGI_SWAP_CHAIN_FULLSCREEN_DESC *,
+                                                     IDXGIOutput *, IDXGISwapChain1 **);
+static PFN_create_sc orig_create_sc;
+static PFN_create_hwnd orig_create_hwnd;
+static uint64_t proxied, passed;
+
+static HRESULT STDMETHODCALLTYPE
+hook_create_hwnd(IDXGIFactory2 *f, IUnknown *dev, HWND hwnd,
+                 const DXGI_SWAP_CHAIN_DESC1 *d,
+                 const DXGI_SWAP_CHAIN_FULLSCREEN_DESC *fs, IDXGIOutput *o,
+                 IDXGISwapChain1 **sc)
+{
+   if (!internal_create && dev && d && sc) {
+      wsi_dxgi_proxy *p = proxy_create(f, dev, hwnd, d, fs);
+      if (p) {
+         proxied++;
+         *sc = p;
+         return S_OK;
+      }
+   }
+   passed++;
+   const bool was = internal_create;
+   internal_create = true;
+   HRESULT hr = orig_create_hwnd(f, dev, hwnd, d, fs, o, sc);
+   internal_create = was;
+   return hr;
+}
+
+static HRESULT STDMETHODCALLTYPE
+hook_create_sc(IDXGIFactory *f, IUnknown *dev, DXGI_SWAP_CHAIN_DESC *d,
+               IDXGISwapChain **sc)
+{
+   if (!internal_create && dev && d && sc) {
+      IDXGIFactory2 *f2 = NULL;
+      if (SUCCEEDED(f->QueryInterface(__uuidof(IDXGIFactory2), (void **)&f2))) {
+         DXGI_SWAP_CHAIN_DESC1 d1 = {};
+         d1.Width = d->BufferDesc.Width;
+         d1.Height = d->BufferDesc.Height;
+         d1.Format = d->BufferDesc.Format;
+         d1.SampleDesc = d->SampleDesc;
+         d1.BufferUsage = d->BufferUsage;
+         d1.BufferCount = d->BufferCount;
+         d1.Scaling = DXGI_SCALING_STRETCH;
+         d1.SwapEffect = d->SwapEffect;
+         d1.AlphaMode = DXGI_ALPHA_MODE_UNSPECIFIED;
+         d1.Flags = d->Flags;
+         DXGI_SWAP_CHAIN_FULLSCREEN_DESC fs = {};
+         fs.RefreshRate = d->BufferDesc.RefreshRate;
+         fs.ScanlineOrdering = d->BufferDesc.ScanlineOrdering;
+         fs.Scaling = d->BufferDesc.Scaling;
+         fs.Windowed = d->Windowed;
+         wsi_dxgi_proxy *p = proxy_create(f2, dev, d->OutputWindow, &d1, &fs);
+         f2->Release();
+         if (p) {
+            proxied++;
+            p->fullscreen = !d->Windowed;
+            *sc = p;
+            return S_OK;
+         }
+      }
+   }
+   passed++;
+   const bool was = internal_create;
+   internal_create = true;
+   HRESULT hr = orig_create_sc(f, dev, d, sc);
+   internal_create = was;
+   return hr;
+}
+
+static bool
+patch(void *obj, unsigned index, void *hook, void **orig)
+{
+   void **vtbl = *(void ***)obj;
+   void **entry = &vtbl[index];
+   if (*entry == hook)
+      return true;
+   DWORD old;
+   if (!VirtualProtect(entry, sizeof(void *), PAGE_READWRITE, &old))
+      return false;
+   *orig = *entry;
+   *entry = hook;
+   DWORD ignored;
+   VirtualProtect(entry, sizeof(void *), old, &ignored);
+   FlushInstructionCache(GetCurrentProcess(), entry, sizeof(void *));
+   return true;
+}
+
+static DWORD WINAPI
+install_thread(LPVOID param)
+{
+   (void)param;
+   HMODULE me = NULL;
+   GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_PIN | GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS,
+                      (LPCSTR)(void *)&install_thread, &me);
+   HMODULE dxgi = LoadLibraryA("dxgi.dll");
+   typedef HRESULT (WINAPI *PFN_create_factory)(REFIID, void **);
+   PFN_create_factory create = dxgi ? (PFN_create_factory)(void *)
+      GetProcAddress(dxgi, "CreateDXGIFactory1") : NULL;
+   IDXGIFactory1 *f1 = NULL;
+   if (!create || FAILED(create(__uuidof(IDXGIFactory1), (void **)&f1))) {
+      LOGE("no DXGI factory: swap chains are not enhanced");
+      return 1;
+   }
+   IDXGIFactory2 *f2 = NULL;
+   f1->QueryInterface(__uuidof(IDXGIFactory2), (void **)&f2);
+   const bool a = patch(f1, 10, (void *)hook_create_sc, (void **)&orig_create_sc);
+   const bool b = f2 && patch(f2, 15, (void *)hook_create_hwnd, (void **)&orig_create_hwnd);
+   if (f2)
+      f2->Release();
+   f1->Release();
+   if (a && b)
+      LOGI("D3D swap chains of this process are presented through NVK with "
+           "upscaling and frame generation (where the settings apply)");
+   else
+      LOGE("DXGI could not be hooked (CreateSwapChain %d, CreateSwapChainForHwnd %d)",
+           a, b);
+   return 0;
+}
+
+static INIT_ONCE install_once = INIT_ONCE_STATIC_INIT;
+
+static BOOL CALLBACK
+install_init(PINIT_ONCE once, PVOID param, PVOID *ctx)
+{
+   (void)once; (void)param; (void)ctx;
+   /* Only where a Helios D3D driver runs on this NVK, never in DWM */
+   const bool d3d = GetModuleHandleA("helios_umd.dll") || GetModuleHandleA("helios_umd12.dll") ||
+                    GetModuleHandleA("helios_umd32.dll") || GetModuleHandleA("helios_umd12_32.dll");
+   char exe[MAX_PATH] = "";
+   GetModuleFileNameA(NULL, exe, sizeof(exe));
+   const char *base = strrchr(exe, '\\');
+   base = base ? base + 1 : exe;
+   if (!d3d || !_stricmp(base, "dwm.exe"))
+      return TRUE;
+   /* Off for this process: nothing is hooked */
+   struct wsi_enh_config c;
+   wsi_enh_config_get(&c);
+   if (!wsi_enh_config_on(&c) || !c.d3d)
+      return TRUE;
+   /* DXGI is not called from the driver's own initialisation: a helper
+    * thread, awaited (as the UMD's FlipUpgrade does) */
+   HANDLE t = CreateThread(NULL, 0, install_thread, NULL, 0, NULL);
+   if (t) {
+      if (WaitForSingleObject(t, 500) != WAIT_OBJECT_0)
+         LOGE("the DXGI hooks are still being installed after 500 ms");
+      CloseHandle(t);
+   }
+   return TRUE;
+}
+
+void
+wsi_win32_dxgi_install(void)
+{
+   InitOnceExecuteOnce(&install_once, install_init, NULL, NULL);
+}
