+/*
+ * Upscaling and frame generation (wsi_common_win32_enhance.c)
+ *
+ * The present's own submission runs the passes (wsi_win32_present_cmd);
+ * the present thread waits for its fence, gives the application's image
+ * back at once, and presents the plan's slots: the generated pictures
+ * spacing_ns apart, the real frame last.  A newer frame cuts a cycle short
+ * (its real frame is shown at once).  Only this thread ever waits for a
+ * picture's time; the application's thread never does.
+ */
+static uint64_t
+wsi_win32_refresh_ns(HWND hwnd)
+{
+   MONITORINFOEXA mi = {};
+   mi.cbSize = sizeof(mi);
+   if (!GetMonitorInfoA(MonitorFromWindow(hwnd, MONITOR_DEFAULTTONEAREST), &mi))
+      return 0;
+   DEVMODEA dm = {};
+   dm.dmSize = sizeof(dm);
+   if (!EnumDisplaySettingsA(mi.szDevice, ENUM_CURRENT_SETTINGS, &dm) ||
+       dm.dmDisplayFrequency <= 1)
+      return 0;
+   return 1000000000ull / dm.dmDisplayFrequency;
+}
+
+static VkExtent2D
+wsi_win32_client_extent(HWND hwnd)
+{
+   RECT r;
+   if (!GetClientRect(hwnd, &r))
+      return { 0, 0 };
+   return { (uint32_t)(r.right - r.left), (uint32_t)(r.bottom - r.top) };
+}
+
+/* Output slots a configuration needs: the pictures of one cycle, the real
+ * frame of the cycle before (still to be shown) and two in copy */
+static uint32_t
+wsi_win32_enh_slots_for(const struct wsi_enh_config *c)
+{
+   if (!wsi_enh_config_fg(c))
+      return 3;
+   const uint32_t pics = c->fg_adaptive ? WSI_ENH_MAX_PICS : MAX2(c->fg_mult, 2u);
+   return pics + 3;
+}
+
+/* A settings change the swapchain cannot follow: the application makes a
+ * new one (VK_SUBOPTIMAL_KHR) */
+static bool
+wsi_win32_enh_needs_new_chain(const struct wsi_enh_config *old,
+                              const struct wsi_enh_config *c,
+                              uint32_t slot_count)
+{
+   return (old->scaler != WSI_ENH_SCALER_OFF) != (c->scaler != WSI_ENH_SCALER_OFF) ||
+          (old->scaler == WSI_ENH_SCALER_INTEGER) != (c->scaler == WSI_ENH_SCALER_INTEGER) ||
+          wsi_enh_config_fg(old) != wsi_enh_config_fg(c) ||
+          old->fit != c->fit ||
+          wsi_win32_enh_slots_for(c) > slot_count;
+}
+
+/* Every 250 ms: the settings, the window's size and the refresh rate */
+static void
+wsi_win32_enh_check(struct wsi_win32_swapchain *chain)
+{
+   const uint64_t now = os_time_get_nano();
+   if (now < chain->compose.next_check_ns)
+      return;
+   chain->compose.next_check_ns = now + 250ull * 1000 * 1000;
+
+   struct wsi_enh_config c;
+   wsi_enh_config_get(&c);
+   const bool applies = wsi_enh_config_applies(&c, chain->surface->base.hwnd);
+   if (!chain->compose.enh) {
+      /* Turned on for this window since the swapchain was made */
+      if (applies && !chain->compose.suboptimal) {
+         chain->compose.suboptimal = true;
+         wsi_win32_compose_log(false, "enhance: turned on; the application "
+                               "makes a new swapchain");
+      }
+      return;
+   }
+   wsi_enh_set_refresh(chain->compose.enh,
+                       wsi_win32_refresh_ns(chain->surface->base.hwnd));
+   if (!applies || wsi_win32_enh_needs_new_chain(&chain->compose.enh_cfg, &c,
+                                                 chain->compose.slot_count)) {
+      if (!chain->compose.suboptimal)
+         wsi_win32_compose_log(false, "enhance: settings changed; the "
+                               "application makes a new swapchain");
+      chain->compose.suboptimal = true;
+      return;
+   }
+   wsi_enh_update_config(chain->compose.enh, &c);
+   if (c.scaler != WSI_ENH_SCALER_OFF) {
+      const VkExtent2D e = wsi_win32_client_extent(chain->surface->base.hwnd);
+      if (e.width && e.height &&
+          (e.width != chain->compose.out_extent.width ||
+           e.height != chain->compose.out_extent.height))
+         chain->compose.suboptimal = true;
+   }
+}
+
+/* `want` output slots for a plan, in order; fewer when the present thread
+ * holds the rest longer than a moment (at least one, unless 2 s pass) */
+static uint32_t
+wsi_win32_enh_take_slots(struct wsi_win32_swapchain *chain, uint32_t want,
+                         uint32_t *out)
+{
+   const uint64_t start = os_time_get_nano();
+   uint32_t got = 0;
+   for (;;) {
+      uint32_t cand[WSI_ENH_MAX_PICS];
+      uint32_t nc = 0;
+      mtx_lock(&chain->acquire_mutex);
+      for (uint32_t k = 0; k < chain->compose.slot_count && got + nc < want; k++) {
+         const uint32_t i = (chain->compose.slot_next + k) % chain->compose.slot_count;
+         if (chain->compose.slots[i].state == WSI_IMAGE_IDLE) {
+            chain->compose.slots[i].state = WSI_IMAGE_DRAWING;
+            cand[nc++] = i;
+         }
+      }
+      mtx_unlock(&chain->acquire_mutex);
+      /* The D3D11 copy out of a slot shown before must be done */
+      for (uint32_t c = 0; c < nc; c++) {
+         struct wsi_win32_image *slot = &chain->compose.slots[cand[c]];
+         if (wsi_win32_compose_image_wait(chain->surface->compose,
+                                          &slot->compose, 0) == VK_SUCCESS) {
+            out[got++] = cand[c];
+            chain->compose.slot_next = (cand[c] + 1) % chain->compose.slot_count;
+         } else {
+            mtx_lock(&chain->acquire_mutex);
+            slot->state = WSI_IMAGE_IDLE;
+            mtx_unlock(&chain->acquire_mutex);
+         }
+      }
+      if (got == want)
+         return got;
+      const uint64_t spent = os_time_get_nano() - start;
+      if ((got > 0 && spent > 2ull * 1000 * 1000) || spent > 2000ull * 1000 * 1000)
+         return got;
+      mtx_lock(&chain->acquire_mutex);
+      struct timespec ts;
+      timespec_from_nsec(&ts, os_time_get_absolute_timeout(1000 * 1000));
+      u_cnd_monotonic_timedwait(&chain->acquire_cond, &chain->acquire_mutex, &ts);
+      mtx_unlock(&chain->acquire_mutex);
+   }
+}
+
+static void
+wsi_win32_enh_release_slots(struct wsi_win32_swapchain *chain,
+                            const struct wsi_enh_plan *plan, uint32_t from)
+{
+   mtx_lock(&chain->acquire_mutex);
+   for (uint32_t k = from; k < plan->count; k++)
+      chain->compose.slots[plan->slot[k]].state = WSI_IMAGE_IDLE;
+   u_cnd_monotonic_broadcast(&chain->acquire_cond);
+   mtx_unlock(&chain->acquire_mutex);
+}
+
+/* wsi_swapchain::present_cmd: the passes of this present */
+static VkCommandBuffer
+wsi_win32_present_cmd(struct wsi_swapchain *drv_chain, uint32_t index,
+                      uint32_t queue_family_index)
+{
+   struct wsi_win32_swapchain *chain = (struct wsi_win32_swapchain *)drv_chain;
+   struct wsi_enh_plan *plan = &chain->compose.plans[index];
+   plan->count = 0;
+   if (!chain->compose.enh || !chain->compose.threaded ||
+       chain->status != VK_SUCCESS || chain->surface->compose == NULL)
+      return VK_NULL_HANDLE;
+
+   wsi_win32_enh_check(chain);
+   const uint32_t want = wsi_enh_pictures(chain->compose.enh, os_time_get_nano());
+   struct wsi_enh_plan p = {};
+   p.count = wsi_win32_enh_take_slots(chain, want, p.slot);
+   if (p.count == 0) {
+      wsi_win32_compose_log(true, "enhance: no output slot came back in 2 s; "
+                            "frame dropped");
+      return VK_NULL_HANDLE;
+   }
+   VkCommandBuffer cmd = wsi_enh_record(chain->compose.enh, queue_family_index,
+                                        index, &p);
+   if (cmd == VK_NULL_HANDLE) {
+      wsi_win32_enh_release_slots(chain, &p, 0);
+      return VK_NULL_HANDLE;
+   }
+   mtx_lock(&chain->acquire_mutex);
+   for (uint32_t k = 0; k < p.count; k++)
+      chain->compose.slots[p.slot[k]].state = WSI_IMAGE_QUEUED;
+   mtx_unlock(&chain->acquire_mutex);
+   *plan = p;
+   return cmd;
+}
+
+/* Until `due`; true when a newer frame (or the end) came first */
+static bool
+wsi_win32_pace_wait(struct wsi_win32_swapchain *chain, uint64_t due)
+{
+   for (;;) {
+      if (p_atomic_read(&chain->compose.q_count) > 0 ||
+          p_atomic_read(&chain->compose.stop))
+         return true;
+      const uint64_t now = os_time_get_nano();
+      if (now >= due)
+         return false;
+      const uint64_t left = due - now;
+      if (left > 1500 * 1000 && chain->compose.pace_timer) {
+         /* the high-resolution timer to just before, then a short spin */
+         LARGE_INTEGER t;
+         t.QuadPart = -(LONGLONG)((left - 700 * 1000) / 100);
+         HANDLE h[2] = { chain->compose.pace_timer, chain->compose.wake };
+         if (SetWaitableTimer(chain->compose.pace_timer, &t, 0, NULL, NULL, FALSE))
+            WaitForMultipleObjects(chain->compose.wake ? 2 : 1, h, FALSE, INFINITE);
+         else
+            Sleep(1);
+      } else {
+         SwitchToThread();
+      }
+   }
+}
+
+static void
+wsi_win32_compose_enh_frame(struct wsi_win32_swapchain *chain, uint32_t index)
+{
+   const struct wsi_device *wsi = chain->wsi->wsi;
+   wsi->WaitForFences(chain->base.device, 1, &chain->base.fences[index],
+                      true, ~0ull);
+   const struct wsi_enh_plan plan = chain->compose.plans[index];
+
+   /* The passes have read the image: the application's again */
+   mtx_lock(&chain->acquire_mutex);
+   chain->images[index].state = WSI_IMAGE_IDLE;
+   chain->compose.plans[index].count = 0;
+   u_cnd_monotonic_broadcast(&chain->acquire_cond);
+   mtx_unlock(&chain->acquire_mutex);
+   if (plan.count == 0)
+      return;
+
+   const uint64_t t0 = os_time_get_nano();
+   uint32_t generated = 0, skipped = 0;
+   /* MESA_WSI_ENHANCE_SHOW=generated: only the generated pictures, to look
+    * at them (a debug view: the real frames are never shown) */
+   static int show_generated = -1;
+   if (show_generated < 0) {
+      const char *v = os_get_option("MESA_WSI_ENHANCE_SHOW");
+      show_generated = v && !strcmp(v, "generated");
+   }
+   for (uint32_t k = 0; k < plan.count; k++) {
+      const bool real = k + 1 == plan.count;
+      if (real && show_generated && plan.count > 1) {
+         wsi_win32_enh_release_slots(chain, &plan, k);
+         break;
+      }
+      if (k > 0 && wsi_win32_pace_wait(chain, t0 + k * plan.spacing_ns) && !real) {
+         /* A newer frame is here: the rest of the cycle goes, the real
+          * frame is shown now */
+         skipped = plan.count - 1 - k;
+         wsi_win32_enh_release_slots(chain, &plan, k);
+         mtx_lock(&chain->acquire_mutex);
+         chain->compose.slots[plan.slot[plan.count - 1]].state = WSI_IMAGE_QUEUED;
+         mtx_unlock(&chain->acquire_mutex);
+         k = plan.count - 1;
+      }
+      struct wsi_win32_image *slot = &chain->compose.slots[plan.slot[k]];
+      VkResult r = chain->surface->compose == NULL ? VK_ERROR_OUT_OF_DATE_KHR :
+         wsi_win32_compose_present(chain->surface->compose, &slot->compose,
+                                   chain->compose.sync_interval);
+      if (r != VK_SUCCESS) {
+         chain->status = r;
+         wsi_win32_compose_log(true, "enhance: present of slot %u: %d",
+                               plan.slot[k], (int)r);
+      } else if (k + 1 < plan.count) {
+         generated++;
+      }
+      mtx_lock(&chain->acquire_mutex);
+      slot->state = WSI_IMAGE_IDLE;
+      u_cnd_monotonic_broadcast(&chain->acquire_cond);
+      mtx_unlock(&chain->acquire_mutex);
+      if (r != VK_SUCCESS)
+         break;
+   }
+   chain->compose.presented = true;
+   wsi_enh_note_shown(chain->compose.enh, 1, generated, skipped);
+}
