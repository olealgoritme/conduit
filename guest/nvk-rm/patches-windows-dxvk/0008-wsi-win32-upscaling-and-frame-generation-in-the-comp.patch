+/*
+ * Copyright © 2026 Ole Algoritme
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * Upscaling and frame generation in the composed present (Conduit Helios).
+ *
+ * With either on, a composed swapchain's DXGI flip swap chain is the
+ * window's size while the application's swapchain keeps its own, and every
+ * present records a command buffer on the application's queue (submitted by
+ * wsi_common_queue_present after the application's semaphores, before the
+ * present's fence) that turns the presented image into one or more output
+ * slots: D3D11 shared textures of the window's size, which the present
+ * thread copies into the DXGI back buffer and presents, paced.
+ *
+ *   scale      the image into the picture region of the output (FSR 1 EASU
+ *              then RCAS, or nearest / bilinear / bicubic / integer), into
+ *              the slot itself, or with frame generation into a history
+ *              image of the region's size
+ *   pyramid    frame generation: luma of the image at 1/2 .. 1/32
+ *   flow       block-matching optical flow between the last two frames,
+ *              coarse to fine, symmetric about the generated moment
+ *   interp     each generated picture at phase k/n, at output resolution,
+ *              straight into its slot
+ *   copy       the newest history image into the real frame's slot
+ *
+ * All passes are compute shaders compiled to SPIR-V at build time
+ * (enhance/), with push descriptors and push constants, so nothing here
+ * allocates per frame.  The frame-generation passes are a Vulkan port of
+ * Conduit's host viewer (docs/VIEWER-ENHANCE.md there); FSR 1 is AMD's
+ * FidelityFX header, unmodified (enhance/third_party, MIT).
+ */
+
+#include "wsi_common_private.h"
+#include "wsi_common_win32_enhance.h"
+
+#include <windows.h>
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "util/os_misc.h"
+#include "util/os_time.h"
+#include "util/u_math.h"
+
+#include "enh_scale_spv.h"
+#include "enh_easu_spv.h"
+#include "enh_rcas_spv.h"
+#include "fg_down_spv.h"
+#include "fg_flow_spv.h"
+#include "fg_interp_spv.h"
+
+#define LOGI(...) wsi_win32_compose_log(false, "enhance: " __VA_ARGS__)
+#define LOGE(...) wsi_win32_compose_log(true, "enhance: " __VA_ARGS__)
+
+/* ---- settings ---------------------------------------------------------- */
+
+static const char *const scaler_names[WSI_ENH_SCALER_COUNT] = {
+   [WSI_ENH_SCALER_OFF] = "off",
+   [WSI_ENH_SCALER_NEAREST] = "nearest",
+   [WSI_ENH_SCALER_BILINEAR] = "bilinear",
+   [WSI_ENH_SCALER_BICUBIC] = "bicubic",
+   [WSI_ENH_SCALER_INTEGER] = "integer",
+   [WSI_ENH_SCALER_FSR] = "fsr",
+};
+
+const char *
+wsi_enh_scaler_name(enum wsi_enh_scaler s)
+{
+   return s < WSI_ENH_SCALER_COUNT ? scaler_names[s] : "?";
+}
+
+static bool
+word_is(const char *a, const char *b)
+{
+   return a && _stricmp(a, b) == 0;
+}
+
+static void
+parse_scaler(struct wsi_enh_config *c, const char *v)
+{
+   if (!v || !*v)
+      return;
+   for (unsigned i = 0; i < WSI_ENH_SCALER_COUNT; i++) {
+      if (word_is(v, scaler_names[i])) {
+         c->scaler = (enum wsi_enh_scaler)i;
+         return;
+      }
+   }
+   if (word_is(v, "fsr1"))
+      c->scaler = WSI_ENH_SCALER_FSR;
+}
+
+static void
+parse_fg(struct wsi_enh_config *c, const char *v)
+{
+   if (!v || !*v)
+      return;
+   if (word_is(v, "adaptive")) {
+      c->fg_adaptive = true;
+      c->fg_mult = 1;
+   } else if (word_is(v, "2x") || word_is(v, "3x") || word_is(v, "4x")) {
+      c->fg_adaptive = false;
+      c->fg_mult = (uint32_t)(v[0] - '0');
+   } else if (word_is(v, "off") || word_is(v, "0") || word_is(v, "1x")) {
+      c->fg_adaptive = false;
+      c->fg_mult = 1;
+   }
+}
+
+static void
+parse_quality(struct wsi_enh_config *c, const char *v)
+{
+   if (word_is(v, "fast"))
+      c->fg_quality = WSI_ENH_FG_FAST;
+   else if (word_is(v, "quality"))
+      c->fg_quality = WSI_ENH_FG_QUALITY;
+}
+
+static void
+parse_fit(struct wsi_enh_config *c, const char *v)
+{
+   if (word_is(v, "aspect"))
+      c->fit = WSI_ENH_FIT_ASPECT;
+   else if (word_is(v, "stretch"))
+      c->fit = WSI_ENH_FIT_STRETCH;
+}
+
+static bool
+reg_sz(const char *sub, const char *name, char *buf, DWORD size)
+{
+   return RegGetValueA(HKEY_LOCAL_MACHINE, sub, name, RRF_RT_REG_SZ, NULL,
+                       buf, &size) == ERROR_SUCCESS;
+}
+
+static bool
+reg_dw(const char *sub, const char *name, DWORD *out)
+{
+   DWORD size = sizeof(*out);
+   return RegGetValueA(HKEY_LOCAL_MACHINE, sub, name, RRF_RT_REG_DWORD, NULL,
+                       out, &size) == ERROR_SUCCESS;
+}
+
+/* The global values, HKLM\SOFTWARE\Helios Enhance* */
+static void
+read_global(struct wsi_enh_config *c)
+{
+   char s[64];
+   DWORD d, size;
+
+   size = sizeof(s);
+   if (RegGetValueA(HKEY_LOCAL_MACHINE, "SOFTWARE\\Helios", "EnhanceScaler", RRF_RT_REG_SZ, NULL, s, &size) == ERROR_SUCCESS)
+      parse_scaler(c, s);
+   size = sizeof(d);
+   if (RegGetValueA(HKEY_LOCAL_MACHINE, "SOFTWARE\\Helios", "EnhanceSharpness", RRF_RT_REG_DWORD, NULL, &d, &size) == ERROR_SUCCESS)
+      c->sharpness = MIN2(d, 100);
+   size = sizeof(s);
+   if (RegGetValueA(HKEY_LOCAL_MACHINE, "SOFTWARE\\Helios", "EnhanceFrameGen", RRF_RT_REG_SZ, NULL, s, &size) == ERROR_SUCCESS)
+      parse_fg(c, s);
+   size = sizeof(d);
+   if (RegGetValueA(HKEY_LOCAL_MACHINE, "SOFTWARE\\Helios", "EnhanceFgTarget", RRF_RT_REG_DWORD, NULL, &d, &size) == ERROR_SUCCESS)
+      c->fg_target_fps = MIN2(d, 1000);
+   size = sizeof(s);
+   if (RegGetValueA(HKEY_LOCAL_MACHINE, "SOFTWARE\\Helios", "EnhanceFgQuality", RRF_RT_REG_SZ, NULL, s, &size) == ERROR_SUCCESS)
+      parse_quality(c, s);
+   size = sizeof(d);
+   if (RegGetValueA(HKEY_LOCAL_MACHINE, "SOFTWARE\\Helios", "EnhanceLowLatency", RRF_RT_REG_DWORD, NULL, &d, &size) == ERROR_SUCCESS)
+      c->low_latency = d != 0;
+   size = sizeof(s);
+   if (RegGetValueA(HKEY_LOCAL_MACHINE, "SOFTWARE\\Helios", "EnhanceFit", RRF_RT_REG_SZ, NULL, s, &size) == ERROR_SUCCESS)
+      parse_fit(c, s);
+   size = sizeof(s);
+   if (RegGetValueA(HKEY_LOCAL_MACHINE, "SOFTWARE\\Helios", "EnhanceWindows", RRF_RT_REG_SZ, NULL, s, &size) == ERROR_SUCCESS)
