+   base = base ? base + 1 : exe;
+   char sub[MAX_PATH + 32];
+   snprintf(sub, sizeof(sub), "SOFTWARE\\Helios\\Enhance\\%s", base);
+   HKEY k;
+   if (RegOpenKeyExA(HKEY_LOCAL_MACHINE, sub, 0, KEY_READ, &k) != ERROR_SUCCESS)
+      return;
+   RegCloseKey(k);
+   c->from_profile = true;
+
+   char s[64];
+   DWORD d;
+   if (reg_sz(sub, "Scaler", s, sizeof(s)))
+      parse_scaler(c, s);
+   if (reg_dw(sub, "Sharpness", &d))
+      c->sharpness = MIN2(d, 100);
+   if (reg_sz(sub, "FrameGen", s, sizeof(s)))
+      parse_fg(c, s);
+   if (reg_dw(sub, "FgTarget", &d))
+      c->fg_target_fps = MIN2(d, 1000);
+   if (reg_sz(sub, "FgQuality", s, sizeof(s)))
+      parse_quality(c, s);
+   if (reg_dw(sub, "LowLatency", &d))
+      c->low_latency = d != 0;
+   if (reg_sz(sub, "Fit", s, sizeof(s)))
+      parse_fit(c, s);
+}
+
+static void
+read_env(struct wsi_enh_config *c)
+{
+   const char *v;
+   bool any = false;
+   if ((v = os_get_option("MESA_WSI_ENHANCE_SCALER"))) {
+      parse_scaler(c, v);
+      any = true;
+   }
+   if ((v = os_get_option("MESA_WSI_ENHANCE_SHARPNESS"))) {
+      c->sharpness = MIN2((uint32_t)atoi(v), 100);
+      any = true;
+   }
+   if ((v = os_get_option("MESA_WSI_ENHANCE_FG"))) {
+      parse_fg(c, v);
+      any = true;
+   }
+   if ((v = os_get_option("MESA_WSI_ENHANCE_FG_TARGET")))
+      c->fg_target_fps = MIN2((uint32_t)atoi(v), 1000);
+   if ((v = os_get_option("MESA_WSI_ENHANCE_FG_QUALITY")))
+      parse_quality(c, v);
+   if ((v = os_get_option("MESA_WSI_ENHANCE_LOW_LATENCY")))
+      c->low_latency = atoi(v) != 0;
+   if ((v = os_get_option("MESA_WSI_ENHANCE_FIT")))
+      parse_fit(c, v);
+   if ((v = os_get_option("MESA_WSI_ENHANCE_WINDOWS")))
+      c->all_windows = word_is(v, "all");
+   if ((v = os_get_option("MESA_WSI_ENHANCE_STATS")))
+      c->stats = atoi(v) != 0;
+   /* Set for this process: every window of it */
+   if (any)
+      c->from_profile = true;
+}
+
+static struct {
+   SRWLOCK lock;
+   bool loaded;
+   HKEY key;
+   HANDLE event;
+   struct wsi_enh_config cfg;
+} conf = { SRWLOCK_INIT };
+
+static void
+conf_arm(void)
+{
+   if (!conf.key) {
+      if (RegOpenKeyExA(HKEY_LOCAL_MACHINE, "SOFTWARE\\Helios", 0,
+                        KEY_NOTIFY | KEY_READ, &conf.key) != ERROR_SUCCESS) {
+         conf.key = NULL;
+         return;
+      }
+      conf.event = CreateEventA(NULL, FALSE, FALSE, NULL);
+   }
+   if (conf.event)
+      RegNotifyChangeKeyValue(conf.key, TRUE,
+                              REG_NOTIFY_CHANGE_NAME | REG_NOTIFY_CHANGE_LAST_SET,
+                              conf.event, TRUE);
+}
+
+void
+wsi_enh_config_get(struct wsi_enh_config *out)
+{
+   AcquireSRWLockExclusive(&conf.lock);
+   bool reload = !conf.loaded;
+   if (!reload && conf.event &&
+       WaitForSingleObject(conf.event, 0) == WAIT_OBJECT_0)
+      reload = true;
+   if (reload) {
+      conf_arm();
+      struct wsi_enh_config c = {
+         .scaler = WSI_ENH_SCALER_OFF,
+         .sharpness = 50,
+         .fg_mult = 1,
+         .fg_quality = WSI_ENH_FG_FAST,
+         .fit = WSI_ENH_FIT_ASPECT,
+      };
+      read_global(&c);
+      read_profile(&c);
+      read_env(&c);
+      if (conf.loaded && memcmp(&c, &conf.cfg, sizeof(c)) != 0)
+         LOGI("settings changed: scaler %s, sharpness %u, frame generation %s%ux, "
+              "%s windows", wsi_enh_scaler_name(c.scaler), c.sharpness,
+              c.fg_adaptive ? "adaptive " : "", c.fg_mult,
+              c.from_profile || c.all_windows ? "all" : "fullscreen");
+      conf.cfg = c;
+      conf.loaded = true;
+   }
+   *out = conf.cfg;
+   ReleaseSRWLockExclusive(&conf.lock);
+}
+
+bool
+wsi_enh_config_applies(const struct wsi_enh_config *c, void *window)
+{
+   if (!wsi_enh_config_on(c))
+      return false;
+   if (c->from_profile || c->all_windows)
+      return true;
+   /* Borderless or fullscreen: the client area covers its monitor */
+   HWND hwnd = (HWND)window;
+   RECT cr;
+   if (!GetClientRect(hwnd, &cr))
+      return false;
+   POINT tl = { cr.left, cr.top }, br = { cr.right, cr.bottom };
+   ClientToScreen(hwnd, &tl);
+   ClientToScreen(hwnd, &br);
+   MONITORINFO mi = { .cbSize = sizeof(mi) };
+   if (!GetMonitorInfoA(MonitorFromWindow(hwnd, MONITOR_DEFAULTTONEAREST), &mi))
+      return false;
+   return tl.x <= mi.rcMonitor.left && tl.y <= mi.rcMonitor.top &&
+          br.x >= mi.rcMonitor.right && br.y >= mi.rcMonitor.bottom;
+}
+
+/* ---- GPU objects -------------------------------------------------------- */
+
+enum enh_pipe {
+   P_SCALE,
+   P_EASU,
+   P_RCAS,
+   P_DOWN,
+   P_FLOW,
+   P_INTERP,
+   P_COUNT,
+};
+
+static const struct {
+   const uint32_t *code;
+   size_t size;
+   const char *name;
+} enh_spv[P_COUNT] = {
+#define SPV(p, n) [p] = { n##_spv, sizeof(n##_spv), #n }
+   SPV(P_SCALE, enh_scale),
+   SPV(P_EASU, enh_easu),
+   SPV(P_RCAS, enh_rcas),
+   SPV(P_DOWN, fg_down),
+   SPV(P_FLOW, fg_flow),
+   SPV(P_INTERP, fg_interp),
+#undef SPV
+};
+
+struct enh_push {
+   int32_t src_size[2];
+   int32_t dst_size[2];
+   int32_t dst_off[2];
+   int32_t aux_size[2];
+   float p0[4];
+   float p1[4];
+   uint32_t mode;
+   uint32_t flags;
+};
+#define ENH_FLAG_SRGB_ENCODE 1u
+
+#define ENH_LEVELS 6     /* pyramid levels 1..5 (1/2 .. 1/32) */
+#define ENH_FAMILIES 8
+
+/* Timestamps per frame: start, scale, pyramid, flow, interp, copy */
+enum { TS_START, TS_SCALE, TS_PYR, TS_FLOW, TS_INTERP, TS_COPY, TS_COUNT };
+
+struct enh_img {
+   VkImage image;
+   VkDeviceMemory mem;
+   VkImageView view;
+   VkExtent2D extent;
+};
+
+struct enh_frame {
+   VkCommandBuffer cmd;
+   uint32_t qfi;
+   bool ts_pending;
+   uint64_t frame;
+   uint32_t pictures;
+   uint32_t passes;       /* bit i: timestamp i was written */
+};
+
+struct wsi_enh {
+   VkDevice dev;
+   const struct wsi_device *wsi;
+   VkAllocationCallbacks alloc;
+   struct wsi_enh_config cfg;
+
+   VkFormat src_format;
+   bool src_srgb;
+   VkExtent2D src, dst;
+   VkRect2D rect;
+   uint32_t src_count, slot_count;
+   VkImage *src_images;
+   VkImageView *src_views;
+   VkImage *slot_images;
+   VkImageView *slot_views;
+   bool *slot_ready;
+
+   VkSampler linear, nearest;
+   VkDescriptorSetLayout dsl;
+   VkPipelineLayout layout;
+   VkPipeline pipe[P_COUNT];
+
+   struct enh_img tmp;                    /* EASU's output, rect size */
+   bool fg_ready;                         /* the resources below exist */
+   struct enh_img hist[2];                /* rect size, after the scaler */
+   struct enh_img pyr[2][ENH_LEVELS];
+   struct enh_img flow[ENH_LEVELS];
+   bool init_layouts;                     /* internal images still UNDEFINED */
+   int cur;
+   bool have_prev;
+
+   VkCommandPool pools[ENH_FAMILIES];
+   struct enh_frame *frames;
+   VkQueryPool queries;
+   bool ts_ok;
+
+   /* pacing */
+   uint64_t last_ns;
+   uint64_t interval_ns;
+   uint64_t refresh_ns;
+   uint64_t frame;
+
+   /* statistics */
+   SRWLOCK stat_lock;
+   uint64_t stat_t0;
+   uint64_t stat_frames, stat_real, stat_gen, stat_skipped, stat_pics;
+   uint64_t stat_gpu_frames;
+   double stat_gpu_us[TS_COUNT];
+   FILE *csv;
+};
+
+static VkResult
+enh_image(struct wsi_enh *e, struct enh_img *img, VkFormat format,
+          uint32_t w, uint32_t h)
+{
+   const struct wsi_device *wsi = e->wsi;
+   img->extent = (VkExtent2D){ MAX2(w, 1), MAX2(h, 1) };
+   const VkImageCreateInfo ici = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+      .imageType = VK_IMAGE_TYPE_2D,
+      .format = format,
+      .extent = { img->extent.width, img->extent.height, 1 },
+      .mipLevels = 1,
+      .arrayLayers = 1,
+      .samples = VK_SAMPLE_COUNT_1_BIT,
+      .tiling = VK_IMAGE_TILING_OPTIMAL,
+      .usage = VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_SAMPLED_BIT,
+      .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+      .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+   };
+   VkResult r = wsi->CreateImage(e->dev, &ici, &e->alloc, &img->image);
+   if (r != VK_SUCCESS)
+      return r;
+   VkMemoryRequirements req;
+   wsi->GetImageMemoryRequirements(e->dev, img->image, &req);
+   const VkMemoryAllocateInfo mai = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .allocationSize = req.size,
+      .memoryTypeIndex = wsi_select_device_memory_type(wsi, req.memoryTypeBits),
+   };
+   r = wsi->AllocateMemory(e->dev, &mai, &e->alloc, &img->mem);
+   if (r != VK_SUCCESS)
+      return r;
+   r = wsi->BindImageMemory(e->dev, img->image, img->mem, 0);
+   if (r != VK_SUCCESS)
+      return r;
+   const VkImageViewCreateInfo vci = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO,
+      .image = img->image,
+      .viewType = VK_IMAGE_VIEW_TYPE_2D,
+      .format = format,
+      .subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 },
+   };
+   return wsi->CreateImageView(e->dev, &vci, &e->alloc, &img->view);
+}
+
+static void
+enh_image_destroy(struct wsi_enh *e, struct enh_img *img)
+{
+   const struct wsi_device *wsi = e->wsi;
+   if (img->view)
+      wsi->DestroyImageView(e->dev, img->view, &e->alloc);
+   if (img->image)
+      wsi->DestroyImage(e->dev, img->image, &e->alloc);
+   if (img->mem)
+      wsi->FreeMemory(e->dev, img->mem, &e->alloc);
+   memset(img, 0, sizeof(*img));
+}
+
+static VkResult
+enh_view(struct wsi_enh *e, VkImage image, VkFormat format, VkImageView *view)
+{
+   const VkImageViewCreateInfo vci = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO,
+      .image = image,
+      .viewType = VK_IMAGE_VIEW_TYPE_2D,
+      .format = format,
+      .subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 },
+   };
+   return e->wsi->CreateImageView(e->dev, &vci, &e->alloc, view);
+}
+
+static uint32_t
+level_dim(uint32_t d, unsigned level)
+{
+   return MAX2((d + (1u << level) - 1) >> level, 1u);
+}
+
+static VkResult
+enh_fg_resources(struct wsi_enh *e)
+{
+   if (e->fg_ready)
+      return VK_SUCCESS;
+   VkResult r = VK_SUCCESS;
+   for (unsigned h = 0; h < 2 && r == VK_SUCCESS; h++) {
+      r = enh_image(e, &e->hist[h], VK_FORMAT_R8G8B8A8_UNORM,
+                    e->rect.extent.width, e->rect.extent.height);
+      for (unsigned l = 1; l < ENH_LEVELS && r == VK_SUCCESS; l++)
+         r = enh_image(e, &e->pyr[h][l], VK_FORMAT_R16_SFLOAT,
+                       level_dim(e->src.width, l), level_dim(e->src.height, l));
+   }
+   for (unsigned l = 1; l < ENH_LEVELS && r == VK_SUCCESS; l++)
+      r = enh_image(e, &e->flow[l], VK_FORMAT_R16G16B16A16_SFLOAT,
+                    level_dim(e->src.width, l), level_dim(e->src.height, l));
+   if (r != VK_SUCCESS) {
+      LOGE("frame-generation images (%ux%u) could not be made: %d",
+           e->rect.extent.width, e->rect.extent.height, (int)r);
+      return r;
+   }
+   e->fg_ready = true;
+   e->init_layouts = true;
+   e->have_prev = false;
+   return VK_SUCCESS;
+}
+
+static VkResult
+enh_pipelines(struct wsi_enh *e)
+{
+   const struct wsi_device *wsi = e->wsi;
+   VkResult r;
+
+   const VkSamplerCreateInfo lin = {
+      .sType = VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO,
+      .magFilter = VK_FILTER_LINEAR,
+      .minFilter = VK_FILTER_LINEAR,
+      .mipmapMode = VK_SAMPLER_MIPMAP_MODE_NEAREST,
+      .addressModeU = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+      .addressModeV = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+      .addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+   };
+   r = wsi->CreateSampler(e->dev, &lin, &e->alloc, &e->linear);
+   if (r != VK_SUCCESS)
+      return r;
+   VkSamplerCreateInfo nst = lin;
+   nst.magFilter = nst.minFilter = VK_FILTER_NEAREST;
+   r = wsi->CreateSampler(e->dev, &nst, &e->alloc, &e->nearest);
+   if (r != VK_SUCCESS)
+      return r;
+
+   const VkDescriptorSetLayoutBinding b[4] = {
+      { 0, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 1, VK_SHADER_STAGE_COMPUTE_BIT },
+      { 1, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 1, VK_SHADER_STAGE_COMPUTE_BIT },
+      { 2, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 1, VK_SHADER_STAGE_COMPUTE_BIT },
+      { 3, VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, 1, VK_SHADER_STAGE_COMPUTE_BIT },
+   };
+   const VkDescriptorSetLayoutCreateInfo dci = {
+      .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+      .flags = VK_DESCRIPTOR_SET_LAYOUT_CREATE_PUSH_DESCRIPTOR_BIT_KHR,
+      .bindingCount = 4,
+      .pBindings = b,
+   };
+   r = wsi->CreateDescriptorSetLayout(e->dev, &dci, &e->alloc, &e->dsl);
+   if (r != VK_SUCCESS)
+      return r;
+   const VkPushConstantRange pcr = {
+      VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(struct enh_push)
+   };
+   const VkPipelineLayoutCreateInfo lci = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+      .setLayoutCount = 1,
+      .pSetLayouts = &e->dsl,
+      .pushConstantRangeCount = 1,
+      .pPushConstantRanges = &pcr,
+   };
+   r = wsi->CreatePipelineLayout(e->dev, &lci, &e->alloc, &e->layout);
+   if (r != VK_SUCCESS)
+      return r;
+
+   for (unsigned p = 0; p < P_COUNT; p++) {
+      const VkShaderModuleCreateInfo sci = {
+         .sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO,
+         .codeSize = enh_spv[p].size,
+         .pCode = enh_spv[p].code,
+      };
+      VkShaderModule mod;
+      r = wsi->CreateShaderModule(e->dev, &sci, &e->alloc, &mod);
+      if (r != VK_SUCCESS)
+         return r;
+      const VkComputePipelineCreateInfo pci = {
+         .sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO,
+         .stage = {
+            .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+            .stage = VK_SHADER_STAGE_COMPUTE_BIT,
+            .module = mod,
+            .pName = "main",
+         },
+         .layout = e->layout,
+      };
+      r = wsi->CreateComputePipelines(e->dev, VK_NULL_HANDLE, 1, &pci,
+                                      &e->alloc, &e->pipe[p]);
+      wsi->DestroyShaderModule(e->dev, mod, &e->alloc);
+      if (r != VK_SUCCESS) {
+         LOGE("pipeline %s: %d", enh_spv[p].name, (int)r);
+         return r;
+      }
+   }
+   return VK_SUCCESS;
+}
+
+static void
+enh_compute_rect(struct wsi_enh *e)
+{
+   const uint32_t sw = e->src.width, sh = e->src.height;
+   const uint32_t dw = e->dst.width, dh = e->dst.height;
+   uint32_t w = dw, h = dh;
+   if (e->cfg.scaler == WSI_ENH_SCALER_INTEGER) {
+      const uint32_t f = MAX2(MIN2(dw / sw, dh / sh), 1u);
+      w = MIN2(sw * f, dw);
+      h = MIN2(sh * f, dh);
+   } else if (e->cfg.fit == WSI_ENH_FIT_ASPECT) {
+      /* the largest sw:sh rectangle that fits */
+      if ((uint64_t)dw * sh > (uint64_t)dh * sw) {
+         h = dh;
+         w = (uint32_t)(((uint64_t)dh * sw + sh / 2) / sh);
+      } else {
+         w = dw;
+         h = (uint32_t)(((uint64_t)dw * sh + sw / 2) / sw);
+      }
+      w = CLAMP(w, 1u, dw);
+      h = CLAMP(h, 1u, dh);
+   }
+   e->rect.extent = (VkExtent2D){ w, h };
+   e->rect.offset = (VkOffset2D){ (int32_t)((dw - w) / 2), (int32_t)((dh - h) / 2) };
+}
+
+static bool
+is_srgb(VkFormat f)
+{
+   return f == VK_FORMAT_B8G8R8A8_SRGB || f == VK_FORMAT_R8G8B8A8_SRGB;
+}
+
+static void
+stats_open_csv(struct wsi_enh *e)
+{
+   if (!e->cfg.stats || e->csv)
+      return;
+   char dir[MAX_PATH], path[MAX_PATH + 64];
+   DWORD n = GetEnvironmentVariableA("HELIOS_VK_FRAMETIME_DIR", dir, sizeof(dir));
+   if (n == 0 || n >= sizeof(dir)) {
+      char pd[MAX_PATH];
+      n = GetEnvironmentVariableA("ProgramData", pd, sizeof(pd));
+      snprintf(dir, sizeof(dir), "%s\\Helios",
+               n > 0 && n < sizeof(pd) ? pd : "C:\\ProgramData");
+   }
+   snprintf(path, sizeof(path), "%s\\enhance-%lu-%p.csv", dir,
+            (unsigned long)GetCurrentProcessId(), (void *)e);
+   e->csv = fopen(path, "w");
+   if (e->csv) {
+      fprintf(e->csv, "frame,pictures,interval_us,scale_us,pyramid_us,flow_us,"
+                      "interp_us,copy_us,gpu_total_us\n");
+      LOGI("per-frame statistics in %s", path);
+   }
+}
+
+VkResult
+wsi_enh_create(const struct wsi_enh_create_info *info, struct wsi_enh **out)
+{
+   const struct wsi_device *wsi = info->wsi;
+   struct wsi_enh *e = vk_zalloc(info->alloc, sizeof(*e), 8,
+                                 VK_SYSTEM_ALLOCATION_SCOPE_OBJECT);
+   if (!e)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   e->dev = info->device;
+   e->wsi = wsi;
+   e->alloc = *info->alloc;
+   e->cfg = info->config;
+   e->src_format = info->src_format;
+   e->src_srgb = is_srgb(info->src_format);
+   e->src = info->src_extent;
+   e->dst = info->dst_extent;
+   e->src_count = info->src_count;
+   e->slot_count = info->slot_count;
+   e->cur = 0;
+   InitializeSRWLock(&e->stat_lock);
+   e->stat_t0 = os_time_get_nano();
+   enh_compute_rect(e);
+
+   VkResult r = VK_ERROR_OUT_OF_HOST_MEMORY;
+   e->src_images = vk_zalloc(&e->alloc, sizeof(VkImage) * e->src_count, 8,
+                             VK_SYSTEM_ALLOCATION_SCOPE_OBJECT);
+   e->src_views = vk_zalloc(&e->alloc, sizeof(VkImageView) * e->src_count, 8,
+                            VK_SYSTEM_ALLOCATION_SCOPE_OBJECT);
+   e->frames = vk_zalloc(&e->alloc, sizeof(struct enh_frame) * e->src_count, 8,
+                         VK_SYSTEM_ALLOCATION_SCOPE_OBJECT);
+   e->slot_images = vk_zalloc(&e->alloc, sizeof(VkImage) * e->slot_count, 8,
+                              VK_SYSTEM_ALLOCATION_SCOPE_OBJECT);
+   e->slot_views = vk_zalloc(&e->alloc, sizeof(VkImageView) * e->slot_count, 8,
+                             VK_SYSTEM_ALLOCATION_SCOPE_OBJECT);
+   e->slot_ready = vk_zalloc(&e->alloc, sizeof(bool) * e->slot_count, 8,
+                             VK_SYSTEM_ALLOCATION_SCOPE_OBJECT);
+   if (!e->src_images || !e->src_views || !e->frames || !e->slot_images ||
+       !e->slot_views || !e->slot_ready)
+      goto fail;
+
+   for (uint32_t i = 0; i < e->src_count; i++) {
+      e->src_images[i] = info->src_images[i];
+      r = enh_view(e, info->src_images[i], info->src_format, &e->src_views[i]);
+      if (r != VK_SUCCESS)
+         goto fail;
+   }
+   for (uint32_t i = 0; i < e->slot_count; i++) {
+      e->slot_images[i] = info->slot_images[i];
+      r = enh_view(e, info->slot_images[i], info->dst_format, &e->slot_views[i]);
+      if (r != VK_SUCCESS)
+         goto fail;
+   }
+   r = enh_pipelines(e);
+   if (r != VK_SUCCESS)
+      goto fail;
+   r = enh_image(e, &e->tmp, VK_FORMAT_R8G8B8A8_UNORM,
+                 e->rect.extent.width, e->rect.extent.height);
+   if (r != VK_SUCCESS)
+      goto fail;
+   e->init_layouts = true;
+   if (wsi_enh_config_fg(&e->cfg)) {
+      r = enh_fg_resources(e);
+      if (r != VK_SUCCESS)
+         goto fail;
+   }
+
+   const VkQueryPoolCreateInfo qci = {
+      .sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO,
+      .queryType = VK_QUERY_TYPE_TIMESTAMP,
+      .queryCount = e->src_count * TS_COUNT,
+   };
+   e->ts_ok = wsi->timestamp_period > 0.0f &&
+              wsi->CreateQueryPool(e->dev, &qci, &e->alloc, &e->queries) == VK_SUCCESS;
+
+   stats_open_csv(e);
+   LOGI("%ux%u -> %ux%u (picture %ux%u at %d,%d), scaler %s, sharpness %u, "
+        "frame generation %s%ux (%s), %u output slots",
+        e->src.width, e->src.height, e->dst.width, e->dst.height,
+        e->rect.extent.width, e->rect.extent.height, e->rect.offset.x,
+        e->rect.offset.y, wsi_enh_scaler_name(e->cfg.scaler), e->cfg.sharpness,
+        e->cfg.fg_adaptive ? "adaptive " : "", e->cfg.fg_mult,
+        e->cfg.fg_quality == WSI_ENH_FG_QUALITY ? "quality" : "fast",
+        e->slot_count);
+   *out = e;
+   return VK_SUCCESS;
+
+fail:
+   LOGE("set-up failed: %d", (int)r);
+   wsi_enh_destroy(e);
+   return r == VK_SUCCESS ? VK_ERROR_INITIALIZATION_FAILED : r;
+}
+
+static void
+stats_flush(struct wsi_enh *e, bool final)
+{
+   const uint64_t now = os_time_get_nano();
+   const double secs = (now - e->stat_t0) / 1e9;
+   if (!final && secs < 5.0)
+      return;
+   /* The last part-interval only when it says something */
+   if (e->stat_frames && secs >= 1.0) {
+      const double g = e->stat_gpu_frames ? 1.0 / e->stat_gpu_frames : 0.0;
+      LOGI("%.1f real + %.1f generated pictures/s shown (%" PRIu64 " generated "
+           "skipped), %.1f frames/s in, interval %.2f ms, refresh %.2f ms; GPU us "
+           "per frame: scale %.0f, pyramid %.0f, flow %.0f, interp %.0f, copy %.0f, "
+           "total %.0f",
+           e->stat_real / secs, e->stat_gen / secs, e->stat_skipped,
+           e->stat_frames / secs, e->interval_ns / 1e6, e->refresh_ns / 1e6,
+           e->stat_gpu_us[TS_SCALE] * g, e->stat_gpu_us[TS_PYR] * g,
+           e->stat_gpu_us[TS_FLOW] * g, e->stat_gpu_us[TS_INTERP] * g,
+           e->stat_gpu_us[TS_COPY] * g, e->stat_gpu_us[TS_START] * g);
+   }
+   e->stat_t0 = now;
+   e->stat_frames = e->stat_real = e->stat_gen = e->stat_skipped = 0;
+   e->stat_gpu_frames = 0;
+   memset(e->stat_gpu_us, 0, sizeof(e->stat_gpu_us));
+}
+
+void
+wsi_enh_destroy(struct wsi_enh *e)
+{
+   if (!e)
+      return;
+   const struct wsi_device *wsi = e->wsi;
+   AcquireSRWLockExclusive(&e->stat_lock);
+   stats_flush(e, true);
+   ReleaseSRWLockExclusive(&e->stat_lock);
+   if (e->csv)
+      fclose(e->csv);
+   if (e->queries)
+      wsi->DestroyQueryPool(e->dev, e->queries, &e->alloc);
+   for (unsigned f = 0; f < ENH_FAMILIES; f++) {
+      if (e->pools[f])
+         wsi->DestroyCommandPool(e->dev, e->pools[f], &e->alloc);
+   }
+   enh_image_destroy(e, &e->tmp);
+   for (unsigned h = 0; h < 2; h++) {
+      enh_image_destroy(e, &e->hist[h]);
+      for (unsigned l = 0; l < ENH_LEVELS; l++)
+         enh_image_destroy(e, &e->pyr[h][l]);
+   }
+   for (unsigned l = 0; l < ENH_LEVELS; l++)
+      enh_image_destroy(e, &e->flow[l]);
+   for (unsigned p = 0; p < P_COUNT; p++) {
+      if (e->pipe[p])
+         wsi->DestroyPipeline(e->dev, e->pipe[p], &e->alloc);
+   }
+   if (e->layout)
+      wsi->DestroyPipelineLayout(e->dev, e->layout, &e->alloc);
+   if (e->dsl)
+      wsi->DestroyDescriptorSetLayout(e->dev, e->dsl, &e->alloc);
+   if (e->linear)
+      wsi->DestroySampler(e->dev, e->linear, &e->alloc);
+   if (e->nearest)
+      wsi->DestroySampler(e->dev, e->nearest, &e->alloc);
+   for (uint32_t i = 0; e->src_views && i < e->src_count; i++) {
+      if (e->src_views[i])
+         wsi->DestroyImageView(e->dev, e->src_views[i], &e->alloc);
+   }
+   for (uint32_t i = 0; e->slot_views && i < e->slot_count; i++) {
+      if (e->slot_views[i])
+         wsi->DestroyImageView(e->dev, e->slot_views[i], &e->alloc);
+   }
+   vk_free(&e->alloc, e->src_images);
+   vk_free(&e->alloc, e->src_views);
+   vk_free(&e->alloc, e->frames);
+   vk_free(&e->alloc, e->slot_images);
+   vk_free(&e->alloc, e->slot_views);
+   vk_free(&e->alloc, e->slot_ready);
+   VkAllocationCallbacks alloc = e->alloc;
+   vk_free(&alloc, e);
+}
+
+void
+wsi_enh_update_config(struct wsi_enh *e, const struct wsi_enh_config *c)
+{
+   /* The region and the output size stay as they were made */
+   const bool fit_changed = c->fit != e->cfg.fit ||
+      (c->scaler == WSI_ENH_SCALER_INTEGER) != (e->cfg.scaler == WSI_ENH_SCALER_INTEGER);
+   struct wsi_enh_config keep = e->cfg;
+   e->cfg = *c;
+   if (fit_changed) {
+      e->cfg.fit = keep.fit;
+      if ((c->scaler == WSI_ENH_SCALER_INTEGER) != (keep.scaler == WSI_ENH_SCALER_INTEGER))
+         e->cfg.scaler = keep.scaler;
+   }
+   if (!wsi_enh_config_fg(&e->cfg))
+      e->have_prev = false;
+   stats_open_csv(e);
+}
+
+void
+wsi_enh_set_refresh(struct wsi_enh *e, uint64_t period_ns)
+{
+   e->refresh_ns = period_ns;
+}
+
+void
+wsi_enh_rect(const struct wsi_enh *e, VkRect2D *rect)
+{
+   *rect = e->rect;
+}
+
+#define ENH_GAP_NS (100ull * 1000 * 1000)   /* longer: a pause */
+#define ENH_MIN_NS (1ull * 1000 * 1000)     /* shorter: not a frame rate */
+
+uint32_t
+wsi_enh_pictures(struct wsi_enh *e, uint64_t now)
+{
+   const uint64_t d = e->last_ns && now > e->last_ns ? now - e->last_ns : 0;
+   const bool gap = !e->last_ns || d > ENH_GAP_NS ||
+                    (e->interval_ns && d > 4 * e->interval_ns);
+   if (d >= ENH_MIN_NS && d <= ENH_GAP_NS) {
+      /* an eighth of each new delta: steady in a few frames, and a single
+       * long frame (a hitch) moves it little */
+      e->interval_ns = e->interval_ns ? (e->interval_ns * 7 + d) / 8 : d;
+   }
+   e->last_ns = now;
+
+   if (!wsi_enh_config_fg(&e->cfg))
+      return 1;
+   if (gap) {
+      /* After a pause nothing slides from a stale frame */
+      e->have_prev = false;
+      return 1;
+   }
+   if (!e->have_prev || !e->interval_ns)
+      return 1;
+
+   const uint64_t refresh = e->refresh_ns;
+   uint32_t n;
+   if (e->cfg.fg_adaptive) {
+      /* Fill to the target (the refresh by default) */
+      uint64_t period = e->cfg.fg_target_fps ? 1000000000ull / e->cfg.fg_target_fps
+                                             : refresh;
+      if (!period)
+         period = 1000000000ull / 60;
+      if (refresh && period < refresh)
+         period = refresh;
+      n = (uint32_t)((e->interval_ns + period / 2) / period);
+      n = CLAMP(n, 1u, (uint32_t)WSI_ENH_MAX_PICS);
+   } else {
+      n = e->cfg.fg_mult;
+      if (refresh) {
+         /* Each picture about one refresh after the last at least: 120 fps
+          * on 240 Hz still makes 2x, 200 fps nothing */
+         const uint64_t fit = (e->interval_ns + refresh / 2) / refresh;
+         if (fit < n)
+            n = MAX2((uint32_t)fit, 1u);
+      }
+      if (e->cfg.low_latency && e->cfg.fg_target_fps &&
+          e->interval_ns * e->cfg.fg_target_fps <= 1100000000ull)
+         n = 1; /* the game reaches the target itself */
+   }
+   return MIN2(n, e->slot_count > 2 ? e->slot_count - 2 : 1);
+}
+
+/* ---- recording ---------------------------------------------------------- */
+
+static void
+barrier_global(const struct wsi_device *wsi, VkCommandBuffer cmd,
+               VkPipelineStageFlags src, VkAccessFlags src_access,
+               VkPipelineStageFlags dst, VkAccessFlags dst_access)
+{
+   const VkMemoryBarrier mb = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+      .srcAccessMask = src_access,
+      .dstAccessMask = dst_access,
+   };
+   wsi->CmdPipelineBarrier(cmd, src, dst, 0, 1, &mb, 0, NULL, 0, NULL);
+}
+
+static void
+compute_barrier(const struct wsi_device *wsi, VkCommandBuffer cmd)
+{
+   barrier_global(wsi, cmd, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                  VK_ACCESS_SHADER_WRITE_BIT,
+                  VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                  VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT);
+}
+
+static void
+image_barrier(const struct wsi_device *wsi, VkCommandBuffer cmd, VkImage image,
+              VkImageLayout from, VkImageLayout to,
+              VkPipelineStageFlags src, VkAccessFlags src_access,
+              VkPipelineStageFlags dst, VkAccessFlags dst_access)
+{
+   const VkImageMemoryBarrier ib = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+      .srcAccessMask = src_access,
+      .dstAccessMask = dst_access,
+      .oldLayout = from,
+      .newLayout = to,
+      .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+      .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+      .image = image,
+      .subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 },
+   };
+   wsi->CmdPipelineBarrier(cmd, src, dst, 0, 0, NULL, 0, NULL, 1, &ib);
+}
+
+/* One dispatch: samplers 0..2 (view, sampler), storage 3, constants */
+static void
+dispatch(struct wsi_enh *e, VkCommandBuffer cmd, enum enh_pipe p,
+         VkImageView s0, VkSampler sm0, VkImageView s1, VkImageView s2,
+         VkImageView dst, const struct enh_push *push)
+{
+   const struct wsi_device *wsi = e->wsi;
+   const VkDescriptorImageInfo ii[4] = {
+      { sm0, s0, VK_IMAGE_LAYOUT_GENERAL },
+      { e->linear, s1 ? s1 : s0, VK_IMAGE_LAYOUT_GENERAL },
+      { e->nearest, s2 ? s2 : s0, VK_IMAGE_LAYOUT_GENERAL },
+      { VK_NULL_HANDLE, dst, VK_IMAGE_LAYOUT_GENERAL },
+   };
+   VkWriteDescriptorSet w[4];
+   for (unsigned i = 0; i < 4; i++) {
+      w[i] = (VkWriteDescriptorSet) {
+         .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET,
+         .dstBinding = i,
+         .descriptorCount = 1,
+         .descriptorType = i < 3 ? VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER
+                                 : VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,
+         .pImageInfo = &ii[i],
+      };
+   }
+   wsi->CmdBindPipeline(cmd, VK_PIPELINE_BIND_POINT_COMPUTE, e->pipe[p]);
+   wsi->CmdPushDescriptorSetKHR(cmd, VK_PIPELINE_BIND_POINT_COMPUTE, e->layout,
+                                0, 4, w);
+   wsi->CmdPushConstants(cmd, e->layout, VK_SHADER_STAGE_COMPUTE_BIT, 0,
+                         sizeof(*push), push);
+   wsi->CmdDispatch(cmd, DIV_ROUND_UP(push->dst_size[0], 8),
+                    DIV_ROUND_UP(push->dst_size[1], 8), 1);
+}
+
+static void
+push_sizes(struct enh_push *p, VkExtent2D src, VkExtent2D dst, VkOffset2D off)
+{
+   memset(p, 0, sizeof(*p));
+   p->src_size[0] = (int32_t)src.width;
+   p->src_size[1] = (int32_t)src.height;
+   p->dst_size[0] = (int32_t)dst.width;
+   p->dst_size[1] = (int32_t)dst.height;
+   p->dst_off[0] = off.x;
+   p->dst_off[1] = off.y;
+}
+
+/* The scaler: the application's image into `dst` (rect size at `off`) */
+static void
+record_scale(struct wsi_enh *e, VkCommandBuffer cmd, VkImageView src,
+             VkImageView dst, VkOffset2D off)
+{
+   struct enh_push p;
+   const VkExtent2D out = e->rect.extent;
+   const uint32_t srgb = e->src_srgb ? ENH_FLAG_SRGB_ENCODE : 0;
+   enum wsi_enh_scaler s = e->cfg.scaler;
+   const bool upscale = out.width >= e->src.width && out.height >= e->src.height;
+   /* EASU only enlarges */
+   if (s == WSI_ENH_SCALER_FSR && !upscale)
+      s = WSI_ENH_SCALER_BILINEAR;
+   if (s == WSI_ENH_SCALER_FSR) {
+      const bool rcas = e->cfg.sharpness > 0;
+      push_sizes(&p, e->src, out, rcas ? (VkOffset2D){ 0, 0 } : off);
+      p.flags = srgb;
+      dispatch(e, cmd, P_EASU, src, e->linear, NULL, NULL,
+               rcas ? e->tmp.view : dst, &p);
+      if (rcas) {
+         compute_barrier(e->wsi, cmd);
+         push_sizes(&p, out, out, off);
+         /* RCAS: 0 stops is the sharpest; 100 -> 0, 50 -> 1, 1 -> ~2 */
+         p.p0[0] = 2.0f * (1.0f - (float)e->cfg.sharpness / 100.0f);
+         dispatch(e, cmd, P_RCAS, e->tmp.view, e->nearest, NULL, NULL, dst, &p);
+      }
+      return;
+   }
+   push_sizes(&p, e->src, out, off);
+   p.flags = srgb;
+   switch (s) {
+   case WSI_ENH_SCALER_BILINEAR:
+      p.mode = 1;
+      break;
+   case WSI_ENH_SCALER_BICUBIC:
+      p.mode = 2;
+      break;
+   default: /* nearest, integer, and the 1:1 copy of frame generation alone */
+      p.mode = out.width == e->src.width && out.height == e->src.height ? 0 :
+               (s == WSI_ENH_SCALER_OFF ? 1 : 0);
+      break;
+   }
+   dispatch(e, cmd, P_SCALE, src, e->linear, NULL, NULL, dst, &p);
+}
+
+static void
+timestamp(struct wsi_enh *e, VkCommandBuffer cmd, struct enh_frame *f,
+          uint32_t index, unsigned which)
+{
+   if (!e->ts_ok)
+      return;
+   e->wsi->CmdWriteTimestamp(cmd, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT,
+                             e->queries, index * TS_COUNT + which);
+   f->passes |= 1u << which;
+}
+
+/* The previous use of this frame slot's timestamps, now complete (the
+ * present's throttle waited for its fence) */
+static void
+collect_timestamps(struct wsi_enh *e, uint32_t index)
+{
+   struct enh_frame *f = &e->frames[index];
+   if (!f->ts_pending)
+      return;
+   f->ts_pending = false;
+   uint64_t ts[TS_COUNT];
+   if (e->wsi->GetQueryPoolResults(e->dev, e->queries, index * TS_COUNT,
+                                   TS_COUNT, sizeof(ts), ts, sizeof(uint64_t),
+                                   VK_QUERY_RESULT_64_BIT) != VK_SUCCESS)
+      return;
+   const double us = e->wsi->timestamp_period / 1000.0;
+   double d[TS_COUNT] = { 0 };
+   uint64_t last = ts[TS_START];
+   for (unsigned i = 1; i < TS_COUNT; i++) {
+      if (!(f->passes & (1u << i)))
+         continue;
+      d[i] = (double)(ts[i] - last) * us;
+      last = ts[i];
+   }
+   d[TS_START] = (double)(last - ts[TS_START]) * us;   /* total */
+   AcquireSRWLockExclusive(&e->stat_lock);
+   e->stat_gpu_frames++;
+   for (unsigned i = 0; i < TS_COUNT; i++)
+      e->stat_gpu_us[i] += d[i];
+   if (e->csv) {
+      fprintf(e->csv, "%" PRIu64 ",%u,%.1f,%.1f,%.1f,%.1f,%.1f,%.1f,%.1f\n",
+              f->frame, f->pictures, e->interval_ns / 1000.0, d[TS_SCALE],
+              d[TS_PYR], d[TS_FLOW], d[TS_INTERP], d[TS_COPY], d[TS_START]);
+   }
+   ReleaseSRWLockExclusive(&e->stat_lock);
+}
+
+static VkCommandBuffer
+frame_cmd(struct wsi_enh *e, uint32_t qfi, struct enh_frame *f)
+{
+   const struct wsi_device *wsi = e->wsi;
+   if (qfi >= ENH_FAMILIES)
+      return VK_NULL_HANDLE;
+   if (f->cmd && f->qfi == qfi) {
+      wsi->ResetCommandBuffer(f->cmd, 0);
+      return f->cmd;
+   }
+   if (f->cmd) {
+      wsi->FreeCommandBuffers(e->dev, e->pools[f->qfi], 1, &f->cmd);
+      f->cmd = VK_NULL_HANDLE;
+   }
+   if (!e->pools[qfi]) {
+      const VkCommandPoolCreateInfo pci = {
+         .sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+         .flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT,
+         .queueFamilyIndex = qfi,
+      };
+      if (wsi->CreateCommandPool(e->dev, &pci, &e->alloc, &e->pools[qfi]) != VK_SUCCESS)
+         return VK_NULL_HANDLE;
+   }
+   const VkCommandBufferAllocateInfo cai = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+      .commandPool = e->pools[qfi],
+      .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY,
+      .commandBufferCount = 1,
+   };
+   if (wsi->AllocateCommandBuffers(e->dev, &cai, &f->cmd) != VK_SUCCESS) {
+      f->cmd = VK_NULL_HANDLE;
+      return VK_NULL_HANDLE;
+   }
+   f->qfi = qfi;
+   return f->cmd;
+}
+
+VkCommandBuffer
+wsi_enh_record(struct wsi_enh *e, uint32_t qfi, uint32_t src_index,
+               struct wsi_enh_plan *plan)
+{
+   const struct wsi_device *wsi = e->wsi;
+   if (src_index >= e->src_count || plan->count == 0)
+      return VK_NULL_HANDLE;
+   const bool fg = wsi_enh_config_fg(&e->cfg);
+   if (fg && enh_fg_resources(e) != VK_SUCCESS)
+      return VK_NULL_HANDLE;
+
+   struct enh_frame *f = &e->frames[src_index];
+   if (e->ts_ok)
+      collect_timestamps(e, src_index);
+   VkCommandBuffer cmd = frame_cmd(e, qfi, f);
+   if (!cmd) {
+      LOGE("no command buffer for queue family %u", qfi);
+      return VK_NULL_HANDLE;
+   }
+   const VkCommandBufferBeginInfo bi = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+      .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT,
+   };
+   if (wsi->BeginCommandBuffer(cmd, &bi) != VK_SUCCESS)
+      return VK_NULL_HANDLE;
+
+   plan->frame = ++e->frame;
+   /* The pictures of a cycle a frame interval apart in all; low latency
+    * shows them one refresh apart, so the real frame is held less */
+   plan->spacing_ns = plan->count < 2 ? 0 : e->interval_ns / plan->count;
+   if (plan->count > 1 && e->cfg.low_latency && e->refresh_ns)
+      plan->spacing_ns = MIN2(plan->spacing_ns, e->refresh_ns);
+   f->frame = plan->frame;
+   f->pictures = plan->count;
+   f->passes = 0;
+   if (e->ts_ok) {
+      wsi->CmdResetQueryPool(cmd, e->queries, src_index * TS_COUNT, TS_COUNT);
+      timestamp(e, cmd, f, src_index, TS_START);
+   }
+
+   /* Everything before: the application's rendering of the image, and our
+    * own earlier passes (history, slots) */
+   barrier_global(wsi, cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                  VK_ACCESS_MEMORY_WRITE_BIT,
+                  VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT,
+                  VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT |
+                  VK_ACCESS_TRANSFER_WRITE_BIT);
+   image_barrier(wsi, cmd, e->src_images[src_index],
+                 VK_IMAGE_LAYOUT_PRESENT_SRC_KHR, VK_IMAGE_LAYOUT_GENERAL,
+                 VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_ACCESS_MEMORY_WRITE_BIT,
+                 VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_READ_BIT);
+   if (e->init_layouts) {
+      struct enh_img *imgs[2 + 2 * ENH_LEVELS + ENH_LEVELS];
+      unsigned n = 0;
+      imgs[n++] = &e->tmp;
+      if (e->fg_ready) {
+         for (unsigned h = 0; h < 2; h++) {
+            imgs[n++] = &e->hist[h];
+            for (unsigned l = 1; l < ENH_LEVELS; l++)
+               imgs[n++] = &e->pyr[h][l];
+         }
+         for (unsigned l = 1; l < ENH_LEVELS; l++)
+            imgs[n++] = &e->flow[l];
+      }
+      for (unsigned i = 0; i < n; i++) {
+         if (imgs[i]->image)
+            image_barrier(wsi, cmd, imgs[i]->image, VK_IMAGE_LAYOUT_UNDEFINED,
+                          VK_IMAGE_LAYOUT_GENERAL, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, 0,
+                          VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                          VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT);
+      }
+      e->init_layouts = false;
+   }
+   /* A slot's first use: GENERAL, and black where the picture does not
+    * cover it (the bars stay black from then on) */
+   const bool bars = e->rect.extent.width != e->dst.width ||
+                     e->rect.extent.height != e->dst.height;
+   bool cleared = false;
+   for (uint32_t k = 0; k < plan->count; k++) {
+      const uint32_t s = plan->slot[k];
+      if (e->slot_ready[s])
+         continue;
+      image_barrier(wsi, cmd, e->slot_images[s], VK_IMAGE_LAYOUT_UNDEFINED,
+                    VK_IMAGE_LAYOUT_GENERAL, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, 0,
+                    VK_PIPELINE_STAGE_TRANSFER_BIT | VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                    VK_ACCESS_TRANSFER_WRITE_BIT | VK_ACCESS_SHADER_WRITE_BIT);
+      if (bars) {
+         const VkClearColorValue black = { .float32 = { 0, 0, 0, 1 } };
+         const VkImageSubresourceRange range = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+         wsi->CmdClearColorImage(cmd, e->slot_images[s], VK_IMAGE_LAYOUT_GENERAL,
+                                 &black, 1, &range);
+         cleared = true;
+      }
+      e->slot_ready[s] = true;
+   }
+   if (cleared)
+      barrier_global(wsi, cmd, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                     VK_ACCESS_TRANSFER_WRITE_BIT,
+                     VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                     VK_ACCESS_SHADER_WRITE_BIT);
+
+   const VkImageView src = e->src_views[src_index];
+   const VkOffset2D zero = { 0, 0 };
+   const uint32_t real_slot = plan->slot[plan->count - 1];
+
+   if (!fg) {
+      record_scale(e, cmd, src, e->slot_views[real_slot], e->rect.offset);
+      timestamp(e, cmd, f, src_index, TS_SCALE);
+   } else {
+      const int cur = e->cur, prev = cur ^ 1;
+      record_scale(e, cmd, src, e->hist[cur].view, zero);
+      timestamp(e, cmd, f, src_index, TS_SCALE);
+
+      /* the luma pyramid of this frame, from the application's image */
+      struct enh_push p;
+      for (unsigned l = 1; l < ENH_LEVELS; l++) {
+         const struct enh_img *from = l == 1 ? NULL : &e->pyr[cur][l - 1];
+         push_sizes(&p, from ? from->extent : e->src, e->pyr[cur][l].extent, zero);
+         p.mode = l == 1 ? 1 : 0;
+         dispatch(e, cmd, P_DOWN, from ? from->view : src, e->linear, NULL, NULL,
+                  e->pyr[cur][l].view, &p);
+         compute_barrier(wsi, cmd);
+      }
+      timestamp(e, cmd, f, src_index, TS_PYR);
+
+      if (plan->count > 1 && e->have_prev) {
+         const bool hq = e->cfg.fg_quality == WSI_ENH_FG_QUALITY;
+         const unsigned finest = hq ? 1 : 2;
+         const unsigned coarsest = hq ? 5 : 4;
+         for (unsigned l = coarsest; l >= finest; l--) {
+            push_sizes(&p, e->pyr[cur][l].extent, e->flow[l].extent, zero);
+            p.p0[0] = (float)(1u << l);
+            p.p0[1] = 4.0f;               /* search radius, texels */
+            p.mode = l == coarsest ? 0 : 1;
+            if (l < coarsest) {
+               p.aux_size[0] = (int32_t)e->flow[l + 1].extent.width;
+               p.aux_size[1] = (int32_t)e->flow[l + 1].extent.height;
+            }
+            dispatch(e, cmd, P_FLOW, e->pyr[prev][l].view, e->linear,
+                     e->pyr[cur][l].view,
+                     l < coarsest ? e->flow[l + 1].view : e->pyr[cur][l].view,
+                     e->flow[l].view, &p);
+            compute_barrier(wsi, cmd);
+         }
+         timestamp(e, cmd, f, src_index, TS_FLOW);
+
+         for (uint32_t k = 0; k + 1 < plan->count; k++) {
+            push_sizes(&p, e->rect.extent, e->rect.extent, e->rect.offset);
+            p.aux_size[0] = (int32_t)e->flow[finest].extent.width;
+            p.aux_size[1] = (int32_t)e->flow[finest].extent.height;
+            p.p0[0] = (float)(k + 1) / (float)plan->count;
+            p.p0[1] = (float)(1u << finest);
+            p.p1[0] = (float)e->rect.extent.width / (float)e->src.width;
+            p.p1[1] = (float)e->rect.extent.height / (float)e->src.height;
+            dispatch(e, cmd, P_INTERP, e->hist[prev].view, e->linear,
+                     e->hist[cur].view, e->flow[finest].view,
+                     e->slot_views[plan->slot[k]], &p);
+         }
+         timestamp(e, cmd, f, src_index, TS_INTERP);
+      }
+
+      /* the real frame from the history image */
+      push_sizes(&p, e->rect.extent, e->rect.extent, e->rect.offset);
+      p.mode = 0;
+      dispatch(e, cmd, P_SCALE, e->hist[cur].view, e->nearest, NULL, NULL,
+               e->slot_views[real_slot], &p);
+      timestamp(e, cmd, f, src_index, TS_COPY);
+      e->cur = prev;
+      e->have_prev = true;
+   }
+
+   /* Every query of the range is written (the results come back only when
+    * all of them are available); the stages that did not run are not
+    * counted (f->passes) */
+   if (e->ts_ok) {
+      for (unsigned i = 1; i < TS_COUNT; i++) {
+         if (!(f->passes & (1u << i)))
+            wsi->CmdWriteTimestamp(cmd, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT,
+                                   e->queries, src_index * TS_COUNT + i);
+      }
+   }
+   image_barrier(wsi, cmd, e->src_images[src_index], VK_IMAGE_LAYOUT_GENERAL,
+                 VK_IMAGE_LAYOUT_PRESENT_SRC_KHR,
+                 VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_READ_BIT,
+                 VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, 0);
+   /* The slots go to the D3D11 device once the fence has signalled */
+   barrier_global(wsi, cmd, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                  VK_ACCESS_SHADER_WRITE_BIT,
+                  VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT | VK_PIPELINE_STAGE_HOST_BIT,
+                  VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_HOST_READ_BIT);
+   if (wsi->EndCommandBuffer(cmd) != VK_SUCCESS)
+      return VK_NULL_HANDLE;
+   f->ts_pending = e->ts_ok;
+
+   AcquireSRWLockExclusive(&e->stat_lock);
+   e->stat_frames++;
+   e->stat_pics += plan->count;
+   stats_flush(e, false);
+   ReleaseSRWLockExclusive(&e->stat_lock);
+   return cmd;
+}
+
+void
+wsi_enh_note_shown(struct wsi_enh *e, uint32_t real, uint32_t generated,
+                   uint32_t skipped)
+{
+   AcquireSRWLockExclusive(&e->stat_lock);
+   e->stat_real += real;
+   e->stat_gen += generated;
+   e->stat_skipped += skipped;
+   ReleaseSRWLockExclusive(&e->stat_lock);
+}
diff --git a/src/vulkan/wsi/wsi_common_win32_enhance.h b/src/vulkan/wsi/wsi_common_win32_enhance.h
new file mode 100644
index 0000000..5af1c0b
--- /dev/null
+++ b/src/vulkan/wsi/wsi_common_win32_enhance.h
@@ -0,0 +1,157 @@
+/*
+ * Copyright © 2026 Ole Algoritme
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * Upscaling and frame generation in the composed present (Conduit Helios,
+ * wsi_common_win32_enhance.c): after the application, from its presented
+ * images only, on the application's own queue, for every Vulkan swapchain
+ * that presents through the window's D3D11 flip swap chain (native Vulkan,
+ * D3D11 on DXVK, D3D12 on vkd3d-proton).
+ *
+ * Off by default.  Off, nothing here runs and nothing changes: the
+ * composed present copies the application's images as before.
+ */
+#ifndef WSI_COMMON_WIN32_ENHANCE_H
+#define WSI_COMMON_WIN32_ENHANCE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <vulkan/vulkan_core.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct wsi_device;
+
+enum wsi_enh_scaler {
+   WSI_ENH_SCALER_OFF = 0,
+   WSI_ENH_SCALER_NEAREST,
+   WSI_ENH_SCALER_BILINEAR,
+   WSI_ENH_SCALER_BICUBIC,
+   WSI_ENH_SCALER_INTEGER,     /* largest whole factor that fits, nearest */
+   WSI_ENH_SCALER_FSR,         /* FSR 1: EASU, then RCAS */
+   WSI_ENH_SCALER_COUNT,
+};
+
+enum wsi_enh_fit {
+   WSI_ENH_FIT_ASPECT = 0,     /* keep the aspect ratio, black bars */
+   WSI_ENH_FIT_STRETCH,
+};
+
+enum wsi_enh_fg_quality {
+   WSI_ENH_FG_FAST = 0,        /* flow down to 1/4 of the frame */
+   WSI_ENH_FG_QUALITY,         /* flow down to 1/2, one more coarse level */
+};
+
+#define WSI_ENH_MAX_MULT    4  /* fixed multipliers: 2x, 3x, 4x */
+#define WSI_ENH_MAX_PICS    8  /* adaptive: up to 8 pictures per real frame */
+
+struct wsi_enh_config {
+   enum wsi_enh_scaler scaler;
+   uint32_t sharpness;         /* 0..100 */
+   uint32_t fg_mult;           /* 1 = off, 2..4 */
+   bool fg_adaptive;           /* fill to fg_target (or the refresh) */
+   uint32_t fg_target_fps;     /* 0: the display's refresh */
+   enum wsi_enh_fg_quality fg_quality;
+   bool low_latency;
+   enum wsi_enh_fit fit;
+   bool all_windows;           /* false: borderless/fullscreen windows only */
+   bool stats;                 /* per-present CSV */
+   bool from_profile;          /* a per-exe profile set it */
+};
+
+static inline bool
+wsi_enh_config_fg(const struct wsi_enh_config *c)
+{
+   return c->fg_mult > 1 || c->fg_adaptive;
+}
+
+static inline bool
+wsi_enh_config_on(const struct wsi_enh_config *c)
+{
+   return c->scaler != WSI_ENH_SCALER_OFF || wsi_enh_config_fg(c);
+}
+
+/* The settings for this process (env > per-exe profile > global), read
+ * again only after the registry key changed.  Cheap: one non-blocking
+ * event check per call. */
+void wsi_enh_config_get(struct wsi_enh_config *config);
+
+/* Whether the settings apply to this window: per-exe profiles and
+ * EnhanceWindows=all apply to every window, the global settings otherwise
+ * only to windows that cover their monitor. */
+bool wsi_enh_config_applies(const struct wsi_enh_config *config, void *hwnd);
+
+const char *wsi_enh_scaler_name(enum wsi_enh_scaler s);
+
+/* ---- per swapchain ---------------------------------------------------- */
+
+struct wsi_enh;
+
+struct wsi_enh_create_info {
+   VkDevice device;
+   const struct wsi_device *wsi;
+   const VkAllocationCallbacks *alloc;
+   struct wsi_enh_config config;
+
+   /* The application's swapchain images (sampled) */
+   VkFormat src_format;
+   VkExtent2D src_extent;
+   uint32_t src_count;
+   const VkImage *src_images;
+
+   /* The output slots: D3D11 shared textures of the window's size,
+    * presented through the DXGI swap chain (storage, transfer dst) */
+   VkFormat dst_format;
+   VkExtent2D dst_extent;
+   uint32_t slot_count;
+   const VkImage *slot_images;
+};
+
+VkResult wsi_enh_create(const struct wsi_enh_create_info *info,
+                        struct wsi_enh **out);
+void wsi_enh_destroy(struct wsi_enh *e);
+
+/* Settings that change without new resources (scaler filter, sharpness,
+ * frame-generation mode, pacing); the rest waits for a new swapchain. */
+void wsi_enh_update_config(struct wsi_enh *e, const struct wsi_enh_config *c);
+
+/* The display's refresh period (0: unknown) */
+void wsi_enh_set_refresh(struct wsi_enh *e, uint64_t period_ns);
+
+/* What a real frame turns into: `count` pictures, generated ones first and
+ * the real frame last, `spacing_ns` apart. */
+struct wsi_enh_plan {
+   uint32_t count;
+   uint32_t slot[WSI_ENH_MAX_PICS];
+   uint64_t spacing_ns;
+   uint64_t frame;             /* real frame number */
+};
+
+/* How many pictures the frame presented now should make (1: the real one
+ * only).  Updates the frame-interval estimate; called once per present. */
+uint32_t wsi_enh_pictures(struct wsi_enh *e, uint64_t now_ns);
+
+/* Records the frame's passes from application image `src_index` into the
+ * plan's slots; plan->count and plan->slot[] are filled in by the caller
+ * (slots it owns until they are presented).  Returns the command buffer to
+ * submit on queue family `qfi`, VK_NULL_HANDLE on failure (logged). */
+VkCommandBuffer wsi_enh_record(struct wsi_enh *e, uint32_t qfi,
+                               uint32_t src_index,
+                               struct wsi_enh_plan *plan);
+
+/* From the present thread: what was shown (for the statistics) */
+void wsi_enh_note_shown(struct wsi_enh *e, uint32_t real, uint32_t generated,
+                        uint32_t skipped);
+
+/* The output region (the picture inside the bars) */
+void wsi_enh_rect(const struct wsi_enh *e, VkRect2D *rect);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* WSI_COMMON_WIN32_ENHANCE_H */
