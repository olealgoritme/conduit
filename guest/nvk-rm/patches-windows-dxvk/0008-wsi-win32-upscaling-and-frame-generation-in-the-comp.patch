diff --git a/src/vulkan/wsi/enhance/enh_common.glsl b/src/vulkan/wsi/enhance/enh_common.glsl
new file mode 100644
index 0000000..90c8570
--- /dev/null
+++ b/src/vulkan/wsi/enhance/enh_common.glsl
@@ -0,0 +1,41 @@
+/*
+ * Copyright © 2026 Ole Algoritme
+ * SPDX-License-Identifier: MIT
+ *
+ * Head of every enhancement pass of the composed present
+ * (wsi_common_win32_enhance.c).  One descriptor layout for all of them:
+ * three sampled images (linear or nearest samplers as the pass needs) and
+ * one storage image written without a format, so the same pass writes an
+ * internal RGBA8/RGBA16F image or the window's B8G8R8A8 shared texture.
+ */
+layout(local_size_x = 8, local_size_y = 8) in;
+
+layout(set = 0, binding = 0) uniform sampler2D s_src;
+layout(set = 0, binding = 1) uniform sampler2D s_src2;
+layout(set = 0, binding = 2) uniform sampler2D s_aux;
+layout(set = 0, binding = 3) writeonly uniform image2D o_dst;
+
+layout(push_constant) uniform enh_push {
+   ivec2 src_size;   /* what s_src holds */
+   ivec2 dst_size;   /* the region written */
+   ivec2 dst_off;    /* its origin in o_dst */
+   ivec2 aux_size;   /* what s_aux holds */
+   vec4  p0;         /* per pass */
+   vec4  p1;
+   uint  mode;
+   uint  flags;
+} pc;
+
+#define ENH_FLAG_SRGB_ENCODE 1u   /* s_src is an sRGB view: write sRGB values */
+
+vec3 enh_srgb_encode(vec3 c)
+{
+   c = clamp(c, 0.0, 1.0);
+   return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055,
+              step(vec3(0.0031308), c));
+}
+
+vec3 enh_out(vec3 c)
+{
+   return (pc.flags & ENH_FLAG_SRGB_ENCODE) != 0u ? enh_srgb_encode(c) : c;
+}
diff --git a/src/vulkan/wsi/enhance/enh_easu.comp b/src/vulkan/wsi/enhance/enh_easu.comp
new file mode 100644
index 0000000..b644138
--- /dev/null
+++ b/src/vulkan/wsi/enhance/enh_easu.comp
@@ -0,0 +1,34 @@
+#version 450
+#extension GL_GOOGLE_include_directive : require
+/*
+ * Copyright © 2026 Ole Algoritme
+ * SPDX-License-Identifier: MIT
+ *
+ * FSR 1 EASU (third_party/fsr1, MIT, unmodified): the whole of s_src
+ * upscaled into the dst_size region, one pixel per invocation.  s_src is
+ * sampled through a linear sampler (textureGather).
+ */
+#include "enh_common.glsl"
+
+#define A_GPU 1
+#define A_GLSL 1
+#include "ffx_a.h"
+#define FSR_EASU_F 1
+AF4 FsrEasuRF(AF2 p) { return textureGather(s_src, p, 0); }
+AF4 FsrEasuGF(AF2 p) { return textureGather(s_src, p, 1); }
+AF4 FsrEasuBF(AF2 p) { return textureGather(s_src, p, 2); }
+#include "ffx_fsr1.h"
+
+void main()
+{
+   ivec2 p = ivec2(gl_GlobalInvocationID.xy);
+   if (p.x >= pc.dst_size.x || p.y >= pc.dst_size.y)
+      return;
+   AU4 c0, c1, c2, c3;
+   FsrEasuCon(c0, c1, c2, c3, AF1(pc.src_size.x), AF1(pc.src_size.y),
+              AF1(pc.src_size.x), AF1(pc.src_size.y),
+              AF1(pc.dst_size.x), AF1(pc.dst_size.y));
+   AF3 c;
+   FsrEasuF(c, AU2(p), c0, c1, c2, c3);
+   imageStore(o_dst, p + pc.dst_off, vec4(enh_out(c), 1.0));
+}
diff --git a/src/vulkan/wsi/enhance/enh_rcas.comp b/src/vulkan/wsi/enhance/enh_rcas.comp
new file mode 100644
index 0000000..d129beb
--- /dev/null
+++ b/src/vulkan/wsi/enhance/enh_rcas.comp
@@ -0,0 +1,30 @@
+#version 450
+#extension GL_GOOGLE_include_directive : require
+/*
+ * Copyright © 2026 Ole Algoritme
+ * SPDX-License-Identifier: MIT
+ *
+ * FSR 1 RCAS (third_party/fsr1, MIT, unmodified): sharpens s_src 1:1 into
+ * the dst_size region.  p0.x: sharpness in stops (0 = sharpest).
+ */
+#include "enh_common.glsl"
+
+#define A_GPU 1
+#define A_GLSL 1
+#include "ffx_a.h"
+#define FSR_RCAS_F 1
+AF4 FsrRcasLoadF(ASU2 p) { return texelFetch(s_src, clamp(p, ASU2(0), pc.src_size - 1), 0); }
+void FsrRcasInputF(inout AF1 r, inout AF1 g, inout AF1 b) {}
+#include "ffx_fsr1.h"
+
+void main()
+{
+   ivec2 p = ivec2(gl_GlobalInvocationID.xy);
+   if (p.x >= pc.dst_size.x || p.y >= pc.dst_size.y)
+      return;
+   AU4 con;
+   FsrRcasCon(con, pc.p0.x);
+   AF1 r, g, b;
+   FsrRcasF(r, g, b, AU2(p), con);
+   imageStore(o_dst, p + pc.dst_off, vec4(enh_out(vec3(r, g, b)), 1.0));
+}
diff --git a/src/vulkan/wsi/enhance/enh_scale.comp b/src/vulkan/wsi/enhance/enh_scale.comp
new file mode 100644
index 0000000..39ee641
--- /dev/null
+++ b/src/vulkan/wsi/enhance/enh_scale.comp
@@ -0,0 +1,60 @@
+#version 450
+#extension GL_GOOGLE_include_directive : require
+/*
+ * Copyright © 2026 Ole Algoritme
+ * SPDX-License-Identifier: MIT
+ *
+ * The plain scalers: the whole of s_src drawn into the dst_size region.
+ *   mode 0  nearest (also the 1:1 copy, and integer scaling)
+ *   mode 1  bilinear
+ *   mode 2  bicubic (Catmull-Rom, 4x4 taps through 9 bilinear fetches)
+ * s_src is sampled through a linear sampler.
+ */
+#include "enh_common.glsl"
+
+vec3 catmull_rom(vec2 uv, vec2 size)
+{
+   /* Catmull-Rom with bilinear taps (the usual 9-tap form) */
+   vec2 pos = uv * size;
+   vec2 tc1 = floor(pos - 0.5) + 0.5;
+   vec2 f = pos - tc1;
+   vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
+   vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
+   vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
+   vec2 w3 = f * f * (-0.5 + 0.5 * f);
+   vec2 w12 = w1 + w2;
+   vec2 off12 = w2 / w12;
+   vec2 inv = 1.0 / size;
+   vec2 t0 = (tc1 - 1.0) * inv;
+   vec2 t3 = (tc1 + 2.0) * inv;
+   vec2 t12 = (tc1 + off12) * inv;
+   vec3 c = vec3(0.0);
+   c += textureLod(s_src, vec2(t0.x,  t0.y), 0.0).rgb  * w0.x  * w0.y;
+   c += textureLod(s_src, vec2(t12.x, t0.y), 0.0).rgb  * w12.x * w0.y;
+   c += textureLod(s_src, vec2(t3.x,  t0.y), 0.0).rgb  * w3.x  * w0.y;
+   c += textureLod(s_src, vec2(t0.x,  t12.y), 0.0).rgb * w0.x  * w12.y;
+   c += textureLod(s_src, vec2(t12.x, t12.y), 0.0).rgb * w12.x * w12.y;
+   c += textureLod(s_src, vec2(t3.x,  t12.y), 0.0).rgb * w3.x  * w12.y;
+   c += textureLod(s_src, vec2(t0.x,  t3.y), 0.0).rgb  * w0.x  * w3.y;
+   c += textureLod(s_src, vec2(t12.x, t3.y), 0.0).rgb  * w12.x * w3.y;
+   c += textureLod(s_src, vec2(t3.x,  t3.y), 0.0).rgb  * w3.x  * w3.y;
+   return max(c, vec3(0.0));
+}
+
+void main()
+{
+   ivec2 p = ivec2(gl_GlobalInvocationID.xy);
+   if (p.x >= pc.dst_size.x || p.y >= pc.dst_size.y)
+      return;
+   vec2 uv = (vec2(p) + 0.5) / vec2(pc.dst_size);
+   vec3 c;
+   if (pc.mode == 0u) {
+      ivec2 s = min(ivec2(uv * vec2(pc.src_size)), pc.src_size - 1);
+      c = texelFetch(s_src, s, 0).rgb;
+   } else if (pc.mode == 1u) {
+      c = textureLod(s_src, uv, 0.0).rgb;
+   } else {
+      c = catmull_rom(uv, vec2(pc.src_size));
+   }
+   imageStore(o_dst, p + pc.dst_off, vec4(enh_out(c), 1.0));
+}
diff --git a/src/vulkan/wsi/enhance/fg_down.comp b/src/vulkan/wsi/enhance/fg_down.comp
new file mode 100644
index 0000000..292acdf
--- /dev/null
+++ b/src/vulkan/wsi/enhance/fg_down.comp
@@ -0,0 +1,22 @@
+#version 450
+#extension GL_GOOGLE_include_directive : require
+/*
+ * Copyright © 2026 Ole Algoritme
+ * SPDX-License-Identifier: MIT
+ *
+ * One level of the frame-generation luma pyramid: each texel the average of
+ * a 2x2 block of the level below, one bilinear tap at the block's centre.
+ * mode 1: s_src is the colour frame and luma is taken here (Rec. 601; the
+ * flow only needs a stable brightness).  Written into o_dst (R16F).
+ */
+#include "enh_common.glsl"
+
+void main()
+{
+   ivec2 p = ivec2(gl_GlobalInvocationID.xy);
+   if (p.x >= pc.dst_size.x || p.y >= pc.dst_size.y)
+      return;
+   vec4 c = textureLod(s_src, (vec2(p) * 2.0 + 1.0) / vec2(pc.src_size), 0.0);
+   float y = pc.mode != 0u ? dot(c.rgb, vec3(0.299, 0.587, 0.114)) : c.r;
+   imageStore(o_dst, p, vec4(y, 0.0, 0.0, 1.0));
+}
diff --git a/src/vulkan/wsi/enhance/fg_flow.comp b/src/vulkan/wsi/enhance/fg_flow.comp
new file mode 100644
index 0000000..a6c1d64
--- /dev/null
+++ b/src/vulkan/wsi/enhance/fg_flow.comp
@@ -0,0 +1,95 @@
+#version 450
+#extension GL_GOOGLE_include_directive : require
+/*
+ * Copyright © 2026 Ole Algoritme
+ * SPDX-License-Identifier: MIT
+ *
+ * Block-matching optical flow for frame generation, one pyramid level per
+ * dispatch, coarse to fine.  The match is symmetric about the generated
+ * moment: for a texel p of the in-between picture and a candidate motion v
+ * (previous -> newest frame) the previous frame is read at p - v/2 and the
+ * newest at p + v/2, scored by how alike the two 3x3 neighbourhoods are.
+ * Every texel of the picture to be made gets a vector: no holes.
+ *
+ *   coarsest level   exhaustive search, |v| <= radius texels (p0.y)
+ *   finer levels     the coarser vector here and at its four neighbours,
+ *                    and zero motion; the best refined by one texel
+ *
+ * s_src: previous frame's luma at this level, s_src2: newest, s_aux: the
+ * coarser level's flow (aux_size).  p0.x: frame pixels per texel of this
+ * level; mode 1 refines s_aux, 0 searches.  Output RGBA16F: rg the motion
+ * in frame pixels, b the match cost (mean absolute luma difference).
+ */
+#include "enh_common.glsl"
+
+const float LAMBDA = 0.002;   /* cost per texel of motion */
+
+float match(vec2 c, vec2 v, vec2 inv)
+{
+   vec2 a = c - 0.5 * v;
+   vec2 b = c + 0.5 * v;
+   float s = 0.0;
+   for (int dy = -1; dy <= 1; dy++) {
+      for (int dx = -1; dx <= 1; dx++) {
+         vec2 d = vec2(float(dx), float(dy));
+         float pa = textureLod(s_src, (a + d) * inv, 0.0).r;
+         float pb = textureLod(s_src2, (b + d) * inv, 0.0).r;
+         s += abs(pa - pb);
+      }
+   }
+   return s * (1.0 / 9.0) + LAMBDA * (abs(v.x) + abs(v.y));
+}
+
+void main()
+{
+   ivec2 p = ivec2(gl_GlobalInvocationID.xy);
+   if (p.x >= pc.dst_size.x || p.y >= pc.dst_size.y)
+      return;
+   vec2 inv = 1.0 / vec2(pc.dst_size);
+   float scale = pc.p0.x;
+   vec2 c = vec2(p) + 0.5;
+   vec2 best = vec2(0.0);
+   float bc = match(c, best, inv);
+
+   if (pc.mode == 0u) {
+      int r = int(pc.p0.y);
+      for (int y = -r; y <= r; y++) {
+         for (int x = -r; x <= r; x++) {
+            vec2 v = vec2(float(x), float(y));
+            float k = match(c, v, inv);
+            if (k < bc) {
+               bc = k;
+               best = v;
+            }
+         }
+      }
+   } else {
+      ivec2 q = p / 2;
+      const ivec2 off[5] = ivec2[5](ivec2(0, 0), ivec2(-1, 0), ivec2(1, 0),
+                                    ivec2(0, -1), ivec2(0, 1));
+      for (int i = 0; i < 5; i++) {
+         ivec2 t = clamp(q + off[i], ivec2(0), pc.aux_size - 1);
+         vec2 v = texelFetch(s_aux, t, 0).rg / scale;
+         float k = match(c, v, inv);
+         if (k < bc) {
+            bc = k;
+            best = v;
+         }
+      }
+      vec2 seed = best;
+      for (int y = -1; y <= 1; y++) {
+         for (int x = -1; x <= 1; x++) {
+            if (x == 0 && y == 0)
+               continue;
+            vec2 v = seed + vec2(float(x), float(y));
+            float k = match(c, v, inv);
+            if (k < bc) {
+               bc = k;
+               best = v;
+            }
+         }
+      }
+   }
+   float raw = bc - LAMBDA * (abs(best.x) + abs(best.y));
+   imageStore(o_dst, p, vec4(best * scale, raw, 1.0));
+}
diff --git a/src/vulkan/wsi/enhance/fg_interp.comp b/src/vulkan/wsi/enhance/fg_interp.comp
new file mode 100644
index 0000000..0cb40f1
--- /dev/null
+++ b/src/vulkan/wsi/enhance/fg_interp.comp
@@ -0,0 +1,67 @@
+#version 450
+#extension GL_GOOGLE_include_directive : require
+/*
+ * Copyright © 2026 Ole Algoritme
+ * SPDX-License-Identifier: MIT
+ *
+ * The generated picture at phase p0.x between the previous (0) and the
+ * newest (1) frame, at the output's resolution, into the dst_size region of
+ * o_dst at dst_off.  s_src / s_src2: the two frames after the upscaler
+ * (dst_size, linear sampler); s_aux: the finest flow level (aux_size), in
+ * input pixels, p0.y input pixels per flow texel; p1.xy output pixels per
+ * input pixel.
+ *
+ *   candidates   the four flow vectors around the pixel and zero motion,
+ *                chosen per pixel by how well the frames agree along each
+ *                (object edges where the colour puts them; a static HUD
+ *                picks zero motion under a moving background)
+ *   motion       prev(x - t v) and cur(x + (1 - t) v), mixed by t
+ *   occlusion    when even the best candidate disagrees, the sample from
+ *                the frame nearer in time
+ *   low trust    where the flow match itself was poor (motion beyond the
+ *                search, a scene cut), a plain cross-fade
+ */
+#include "enh_common.glsl"
+
+void main()
+{
+   ivec2 p = ivec2(gl_GlobalInvocationID.xy);
+   if (p.x >= pc.dst_size.x || p.y >= pc.dst_size.y)
+      return;
+   vec2 inv = 1.0 / vec2(pc.dst_size);
+   vec2 k = pc.p1.xy;
+   vec2 c = vec2(p) + 0.5;
+   float t = pc.p0.x;
+   vec2 fc = (c / k) / pc.p0.y - 0.5;
+   ivec2 f0 = ivec2(floor(fc));
+   vec3 a_best = vec3(0.0), b_best = vec3(0.0);
+   float e_best = 1e9, k_best = 0.0;
+
+   for (int i = 0; i < 5; i++) {
+      vec2 v = vec2(0.0);
+      float cost = 0.0;
+      if (i < 4) {
+         ivec2 q = clamp(f0 + ivec2(i & 1, i >> 1), ivec2(0), pc.aux_size - 1);
+         vec4 f = texelFetch(s_aux, q, 0);
+         v = f.rg * k;
+         cost = f.b;
+      }
+      vec3 a = textureLod(s_src, (c - t * v) * inv, 0.0).rgb;
+      vec3 b = textureLod(s_src2, (c + (1.0 - t) * v) * inv, 0.0).rgb;
+      float e = dot(abs(a - b), vec3(1.0 / 3.0));
+      if (e < e_best) {
+         e_best = e;
+         a_best = a;
+         b_best = b;
+         k_best = i < 4 ? cost : e;
+      }
+   }
+   vec3 both = mix(a_best, b_best, t);
+   vec3 near = t < 0.5 ? a_best : t > 0.5 ? b_best : 0.5 * (a_best + b_best);
+   float conf_px = 1.0 - smoothstep(0.03, 0.12, e_best);
+   vec3 moved = mix(near, both, conf_px);
+   vec3 fade = mix(textureLod(s_src, c * inv, 0.0).rgb,
+                   textureLod(s_src2, c * inv, 0.0).rgb, t);
+   float conf_flow = 1.0 - smoothstep(0.05, 0.16, k_best);
+   imageStore(o_dst, p + pc.dst_off, vec4(mix(fade, moved, conf_flow), 1.0));
+}
diff --git a/src/vulkan/wsi/meson.build b/src/vulkan/wsi/meson.build
index d5201a2..8259a40 100644
--- a/src/vulkan/wsi/meson.build
+++ b/src/vulkan/wsi/meson.build
@@ -28,8 +28,30 @@ if with_platform_wayland
 endif
 
 if with_platform_windows
-  files_vulkan_wsi += files('wsi_common_win32.cpp', 'wsi_common_win32_frametime.c', 'wsi_common_win32_compose.cpp')
+  files_vulkan_wsi += files('wsi_common_win32.cpp', 'wsi_common_win32_frametime.c', 'wsi_common_win32_compose.cpp',
+                            'wsi_common_win32_enhance.c')
   platform_deps += dep_dxheaders
+  # The composed present's upscaling and frame-generation passes, compiled
+  # to SPIR-V here and embedded (enhance/; FidelityFX FSR 1 in
+  # enhance/third_party, MIT)
+  if not prog_glslang.found()
+    error('glslangValidator is needed for the Win32 WSI enhancement shaders')
+  endif
+  foreach s : ['enh_scale', 'enh_easu', 'enh_rcas', 'fg_down', 'fg_flow', 'fg_interp']
+    files_vulkan_wsi += custom_target(
+      s + '_spv.h',
+      input : 'enhance' / s + '.comp',
+      output : s + '_spv.h',
+      command : [
+        prog_glslang, '-V', '--target-env', 'vulkan1.1', '-S', 'comp',
