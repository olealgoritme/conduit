diff --git a/src/vulkan/wsi/enhance/adapt.py b/src/vulkan/wsi/enhance/adapt.py
new file mode 100644
index 0000000..5342d9e
--- /dev/null
+++ b/src/vulkan/wsi/enhance/adapt.py
@@ -0,0 +1,88 @@
+#!/usr/bin/env python3
+# Copyright © 2026 Ole Algoritme
+# SPDX-License-Identifier: MIT
+"""Build-time adaptation of vendored shaders for the enhancement passes.
+
+  adapt.py sgsr  IN OUT   SGSR 1 fragment shader -> sgsr_main() for compute
+                          (also without GLSL ES precision qualifiers)
+  adapt.py xbr   IN OUT   xBR-lv2 slang (fragment stage) -> xbr_main()
+  adapt.py nis-coef IN OUT  NIS_Config.h coef_scale / coef_usm -> GLSL
+                            constant arrays (2 x 64 vec4 each)
+
+The vendored files are not changed; OUT is generated in the build tree.
+"""
+import re
+import sys
+
+
+def sgsr(text):
+    out = []
+    for line in text.splitlines():
+        s = line.strip()
+        if s.startswith('#version') or s.startswith('precision ') or \
+           s.startswith('layout(location') or \
+           re.match(r'uniform\s+(highp\s+)?vec4\s+ViewportInfo', s) or \
+           re.match(r'uniform\s+(mediump\s+)?sampler2D\s+ps0', s):
+            continue
+        # precision qualifiers in expressions are GLSL ES only
+        line = re.sub(r'\b(highp|mediump|lowp)\s+', '', line)
+        out.append(line.replace('void main()', 'void sgsr_main()'))
+    return '\n'.join(out) + '\n'
+
+
+def xbr(text):
+    head, _, rest = text.partition('#pragma stage vertex')
+    _, _, frag = rest.partition('#pragma stage fragment')
+    if not frag:
+        raise SystemExit('xbr: no fragment stage')
+    # the prefix: helpers and #defines, without the version, the push and
+    # uniform blocks and the parameter pragmas
+    head = re.sub(r'#version[^\n]*\n', '', head)
+    head = re.sub(r'layout\(push_constant\)\s*uniform\s+Push\s*\{.*?\}\s*params;', '', head,
+                  flags=re.S)
+    head = re.sub(r'layout\(std140[^)]*\)\s*uniform\s+UBO\s*\{.*?\}\s*global;', '', head,
+                  flags=re.S)
+    head = re.sub(r'#pragma parameter[^\n]*\n', '', head)
+    lines = []
+    for line in frag.splitlines():
+        s = line.strip()
+        if s.startswith('layout('):
+            continue
+        lines.append(line.replace('void main()', 'void xbr_main()'))
+    return head + '\n' + '\n'.join(lines) + '\n'
+
+
+def nis_coef(text):
+    def table(name):
+        m = re.search(r'\b' + name + r'\s*\[kPhaseCount\]\s*\[kFilterSize\]\s*=\s*\{(.*?)\};', text, re.S)
+        if not m:
+            raise SystemExit('nis-coef: no ' + name)
+        vals = [float(v.rstrip('f')) for v in re.findall(r'-?\d+\.\d*(?:e-?\d+)?f?', m.group(1))]
+        if len(vals) != 64 * 8:
+            raise SystemExit('nis-coef: %s has %d values' % (name, len(vals)))
+        return vals
+
+    def glsl(name, vals):
+        # texel (x, phase) of the SDK's 2 x 64 RGBA texture: vals[phase][4x .. 4x+3]
+        vecs = []
+        for phase in range(64):
+            for x in range(2):
+                v = vals[phase * 8 + x * 4: phase * 8 + x * 4 + 4]
+                vecs.append('vec4(%s)' % ', '.join('%.9g' % f for f in v))
+        return 'const vec4 %s[128] = vec4[128](\n   %s);\n' % (name, ',\n   '.join(vecs))
+
+    return ('/* Generated by adapt.py from NIS_Config.h; do not edit. */\n' +
+            glsl('nis_coef_scaler', table('coef_scale')) +
+            glsl('nis_coef_usm', table('coef_usm')))
+
+
+def main():
+    mode, src, dst = sys.argv[1:4]
+    text = open(src, encoding='utf-8').read()
+    out = {'sgsr': sgsr, 'xbr': xbr, 'nis-coef': nis_coef}[mode](text)
+    with open(dst, 'w', encoding='utf-8') as f:
+        f.write(out)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/src/vulkan/wsi/enhance/enh_cas.comp b/src/vulkan/wsi/enhance/enh_cas.comp
new file mode 100644
index 0000000..44336ff
--- /dev/null
+++ b/src/vulkan/wsi/enhance/enh_cas.comp
@@ -0,0 +1,31 @@
+#version 450
+#extension GL_GOOGLE_include_directive : require
+/*
+ * Copyright © 2026 Ole Algoritme
+ * SPDX-License-Identifier: MIT
+ *
+ * AMD FidelityFX CAS (third_party/cas, MIT, unmodified): sharpening, and
+ * scaling up to 4x the area in the same pass, of s_src into the dst_size
+ * region.  p0.x: sharpness 0..1.
+ */
+#include "enh_common.glsl"
+
+#define A_GPU 1
+#define A_GLSL 1
+#include "ffx_a.h"
+AF3 CasLoad(ASU2 p) { return texelFetch(s_src, clamp(p, ASU2(0), pc.src_size - 1), 0).rgb; }
+void CasInput(inout AF1 r, inout AF1 g, inout AF1 b) {}
+#include "ffx_cas.h"
+
+void main()
+{
+   ivec2 p = ivec2(gl_GlobalInvocationID.xy);
+   if (p.x >= pc.dst_size.x || p.y >= pc.dst_size.y)
+      return;
+   AU4 c0, c1;
+   CasSetup(c0, c1, pc.p0.x, AF1(pc.src_size.x), AF1(pc.src_size.y),
+            AF1(pc.dst_size.x), AF1(pc.dst_size.y));
+   AF1 r, g, b;
+   CasFilter(r, g, b, AU2(p), c0, c1, pc.src_size == pc.dst_size);
+   imageStore(o_dst, p + pc.dst_off, vec4(enh_out(vec3(r, g, b)), 1.0));
+}
diff --git a/src/vulkan/wsi/enhance/enh_nis.comp b/src/vulkan/wsi/enhance/enh_nis.comp
new file mode 100644
index 0000000..b316d56
--- /dev/null
+++ b/src/vulkan/wsi/enhance/enh_nis.comp
@@ -0,0 +1,104 @@
+#version 450
+#extension GL_GOOGLE_include_directive : require
+/*
+ * Copyright © 2026 Ole Algoritme
+ * SPDX-License-Identifier: MIT
+ *
+ * NVIDIA Image Scaling (third_party/nis, MIT, unmodified): the whole of
+ * in_texture scaled into the output viewport of out_texture, one 32x24
+ * block per work group.  NISConfig in push constants
+ * (wsi_common_win32_enhance.c nis_config); the coefficient textures are
+ * constant arrays generated from NIS_Config.h (adapt.py nis-coef).  The
+ * descriptor layout is the other passes': binding 0 the source (linear),
+ * binding 3 the destination.
+ */
+layout(set = 0, binding = 0) uniform sampler2D in_texture;
+layout(set = 0, binding = 3) writeonly uniform image2D out_texture;
+
+layout(push_constant) uniform nis_push {
+   float kDetectRatio;
+   float kDetectThres;
+   float kMinContrastRatio;
+   float kRatioNorm;
+   float kContrastBoost;
+   float kEps;
+   float kSharpStartY;
+   float kSharpScaleY;
+   float kSharpStrengthMin;
+   float kSharpStrengthScale;
+   float kSharpLimitMin;
+   float kSharpLimitScale;
+   float kScaleX;
+   float kScaleY;
+   float kDstNormX;
+   float kDstNormY;
+   float kSrcNormX;
+   float kSrcNormY;
+   uint kInputViewportOriginX;
+   uint kInputViewportOriginY;
+   uint kInputViewportWidth;
+   uint kInputViewportHeight;
+   uint kOutputViewportOriginX;
+   uint kOutputViewportOriginY;
+   uint kOutputViewportWidth;
+   uint kOutputViewportHeight;
+} nis;
+#define kDetectRatio nis.kDetectRatio
+#define kDetectThres nis.kDetectThres
+#define kMinContrastRatio nis.kMinContrastRatio
+#define kRatioNorm nis.kRatioNorm
+#define kContrastBoost nis.kContrastBoost
+#define kEps nis.kEps
+#define kSharpStartY nis.kSharpStartY
+#define kSharpScaleY nis.kSharpScaleY
+#define kSharpStrengthMin nis.kSharpStrengthMin
+#define kSharpStrengthScale nis.kSharpStrengthScale
+#define kSharpLimitMin nis.kSharpLimitMin
+#define kSharpLimitScale nis.kSharpLimitScale
+#define kScaleX nis.kScaleX
+#define kScaleY nis.kScaleY
+#define kDstNormX nis.kDstNormX
+#define kDstNormY nis.kDstNormY
+#define kSrcNormX nis.kSrcNormX
+#define kSrcNormY nis.kSrcNormY
+#define kInputViewportOriginX nis.kInputViewportOriginX
+#define kInputViewportOriginY nis.kInputViewportOriginY
+#define kInputViewportWidth nis.kInputViewportWidth
+#define kInputViewportHeight nis.kInputViewportHeight
+#define kOutputViewportOriginX nis.kOutputViewportOriginX
+#define kOutputViewportOriginY nis.kOutputViewportOriginY
+#define kOutputViewportWidth nis.kOutputViewportWidth
+#define kOutputViewportHeight nis.kOutputViewportHeight
+
+#define NIS_GLSL 1
+#define NIS_HLSL 0
+#define NIS_HLSL_6_2 0
+#define NIS_SCALER 1
+#define NIS_USE_HALF_PRECISION 0
+#define NIS_CLAMP_OUTPUT 1
+#define NIS_NV12_SUPPORT 0
+#define NIS_VIEWPORT_SUPPORT 1
+#define NIS_TEXTURE_GATHER 0
+#define NIS_BLOCK_WIDTH 32
+#define NIS_BLOCK_HEIGHT 24
+#define NIS_THREAD_GROUP_SIZE 128   /* the SDK's choice for NVIDIA (NISOptimizer) */
+
+#include "nis_coef.glsl"
+const int coef_scaler = 0;
+const int coef_usm = 1;
+vec4 nis_coef(int which, ivec2 p)
+{
+   return which == coef_scaler ? nis_coef_scaler[p.y * 2 + p.x] : nis_coef_usm[p.y * 2 + p.x];
+}
+/* The SDK's GLSL reads textures as sampler2D(texture, sampler): here the
+ * source is a combined sampler, and the coefficients (the only texelFetch)
+ * are the arrays above */
+#define sampler2D(x, s) x
+#define texelFetch(t, p, l) nis_coef(t, p)
+#include "NIS_Scaler.h"
+
+layout(local_size_x = NIS_THREAD_GROUP_SIZE) in;
+void main()
+{
+   NVScaler(gl_WorkGroupID.xy, gl_LocalInvocationID.x);
+}
diff --git a/src/vulkan/wsi/enhance/enh_sgsr.comp b/src/vulkan/wsi/enhance/enh_sgsr.comp
new file mode 100644
index 0000000..c10b57f
--- /dev/null
+++ b/src/vulkan/wsi/enhance/enh_sgsr.comp
@@ -0,0 +1,30 @@
+#version 450
+#extension GL_GOOGLE_include_directive : require
+/*
+ * Copyright © 2026 Ole Algoritme
+ * SPDX-License-Identifier: MIT
+ *
+ * Snapdragon Game Super Resolution 1 (third_party/sgsr, BSD-3-Clause; the
+ * fragment shader made a function by adapt.py at build time), edge
+ * direction on: s_src upscaled into the dst_size region, one pixel per
+ * invocation.  s_src is sampled through a linear sampler.
+ */
+#include "enh_common.glsl"
+
+#define UseEdgeDirection
+vec4 ViewportInfo[1];
+vec4 in_TEXCOORD0;
+vec4 out_Target0;
+#define ps0 s_src
+#include "sgsr1_adapted.glsl"
+
+void main()
+{
+   ivec2 p = ivec2(gl_GlobalInvocationID.xy);
+   if (p.x >= pc.dst_size.x || p.y >= pc.dst_size.y)
+      return;
+   ViewportInfo[0] = vec4(1.0 / vec2(pc.src_size), vec2(pc.src_size));
+   in_TEXCOORD0 = vec4((vec2(p) + 0.5) / vec2(pc.dst_size), 0.0, 0.0);
+   sgsr_main();
+   imageStore(o_dst, p + pc.dst_off, vec4(enh_out(out_Target0.rgb), 1.0));
+}
diff --git a/src/vulkan/wsi/enhance/enh_xbr.comp b/src/vulkan/wsi/enhance/enh_xbr.comp
new file mode 100644
index 0000000..ce02c76
--- /dev/null
+++ b/src/vulkan/wsi/enhance/enh_xbr.comp
@@ -0,0 +1,59 @@
+#version 450
+#extension GL_GOOGLE_include_directive : require
+/*
+ * Copyright © 2026 Ole Algoritme
+ * SPDX-License-Identifier: MIT
+ *
+ * Hyllian's xBR-lv2 (third_party/xbr, MIT; the fragment stage made a
+ * function by adapt.py at build time, its vertex stage's taps computed
+ * here): edge-directed scaling for pixel art, s_src into the dst_size
+ * region at any factor.  s_src is sampled through a nearest sampler.
+ */
+#include "enh_common.glsl"
+
+struct xbr_params {
+   vec4 SourceSize;
+   vec4 OriginalSize;
+   vec4 OutputSize;
+   uint FrameCount;
+   float XBR_EQ_THRESHOLD;
+   float XBR_LV2_COEFFICIENT;
+   float XBR_BLENDING;
+};
+xbr_params params;
+vec2 texCoord;
+vec4 t1, t2, t3, t4, t5, t6, t7;
+float aa_factor;
+vec4 FragColor;
+#define Source s_src
+#include "xbr_lv2_adapted.glsl"
+
+void main()
+{
+   ivec2 p = ivec2(gl_GlobalInvocationID.xy);
+   if (p.x >= pc.dst_size.x || p.y >= pc.dst_size.y)
+      return;
+   const vec2 src = vec2(pc.src_size), dst = vec2(pc.dst_size);
+   params.SourceSize = vec4(src, 1.0 / src);
+   params.OriginalSize = params.SourceSize;
+   params.OutputSize = vec4(dst, 1.0 / dst);
+   params.FrameCount = 0u;
+   /* the upstream preset's defaults */
+   XBR_EQ_THRESHOLD = 0.32;      /* params.XBR_EQ_THRESHOLD, by the file's macros */
+   XBR_LV2_COEFFICIENT = 0.30;
+   XBR_BLENDING = 1.0;
+
+   /* the vertex stage, per pixel */
+   texCoord = (vec2(p) + 0.5) / dst * 1.0001;
+   aa_factor = 2.0 * params.OutputSize.z * params.SourceSize.x;
+   const float dx = params.SourceSize.z, dy = params.SourceSize.w;
+   t1 = texCoord.xxxy + vec4(-dx, 0, dx, -2.0 * dy);
+   t2 = texCoord.xxxy + vec4(-dx, 0, dx, -dy);
+   t3 = texCoord.xxxy + vec4(-dx, 0, dx, 0);
+   t4 = texCoord.xxxy + vec4(-dx, 0, dx, dy);
+   t5 = texCoord.xxxy + vec4(-dx, 0, dx, 2.0 * dy);
+   t6 = texCoord.xyyy + vec4(-2.0 * dx, -dy, 0, dy);
+   t7 = texCoord.xyyy + vec4(2.0 * dx, -dy, 0, dy);
+   xbr_main();
+   imageStore(o_dst, p + pc.dst_off, vec4(enh_out(FragColor.rgb), 1.0));
+}
