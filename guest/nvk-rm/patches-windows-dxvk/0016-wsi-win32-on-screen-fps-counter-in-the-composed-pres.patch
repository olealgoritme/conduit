From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ole Algoritme <ole@solgt.no>
Date: Sat, 24 Oct 2026 16:18:54 +0200
Subject: [PATCH] wsi/win32: on-screen fps counter in the composed present

EnhanceOverlay (DWORD, HKLM\SOFTWARE\Helios), Overlay in a per-exe
profile (it overrides the global value) or MESA_WSI_ENHANCE_OVERLAY=1
draw a counter at the top left of every presented picture:

  80 / 160  FG 2x  FSR

the application's frames per second, the pictures shown per second
(real and generated), the frame generation mode and the scaler.  The
line is rebuilt every half second.  enh_text.comp draws it with a 5x7
font of its own (space, / . - :, digits, capitals and a small x) on a
dark box, one dispatch per output slot over the box only; the glyph
size is the picture's height / 360 (at least 2), so it reads the same
at 1080p and 1440p.

The overlay alone turns the enhancement path on: scaler off and frame
generation off are a 1:1 copy into the output slot with the counter.
Default off.
---
 src/vulkan/wsi/enhance/enh_text.comp      |  87 +++++++++++++++++++
 src/vulkan/wsi/meson.build                |   2 +-
 src/vulkan/wsi/wsi_common_win32_enhance.c | 101 +++++++++++++++++++++-
 src/vulkan/wsi/wsi_common_win32_enhance.h |   4 +-
 4 files changed, 188 insertions(+), 6 deletions(-)
 create mode 100644 src/vulkan/wsi/enhance/enh_text.comp

diff --git a/src/vulkan/wsi/enhance/enh_text.comp b/src/vulkan/wsi/enhance/enh_text.comp
new file mode 100644
index 0000000..6287340
--- /dev/null
+++ b/src/vulkan/wsi/enhance/enh_text.comp
@@ -0,0 +1,87 @@
+#version 450
+/*
+ * Copyright © 2026 Ole Algoritme
+ * SPDX-License-Identifier: MIT
+ *
+ * The on-screen counter (EnhanceOverlay): a line of text in a dark box
+ * drawn into an output slot, one invocation per pixel of the box.  A 5x7
+ * font of its own, each font pixel `scale` pixels wide; glyph codes four
+ * per uint in `text` (wsi_common_win32_enhance.c enh_overlay_text).
+ */
+layout(local_size_x = 8, local_size_y = 8) in;
+layout(set = 0, binding = 3) writeonly uniform image2D o_dst;
+
+layout(push_constant) uniform text_push {
+   ivec2 origin;     /* the box's top left in o_dst */
+   int scale;
+   int count;        /* glyphs */
+   uint text[12];    /* up to 48 glyph codes, 8 bits each */
+} pc;
+
+/* 5x7 glyphs, bit r * 5 + c (row r from the top, column c from the left)
+ * in .x (bits 0..31) and .y (32..34); codes: " /.-:0-9A-Zx" in that order */
+const uvec2 font5x7[42] = uvec2[42](
+   uvec2(0x00000000u, 0x0u),
+   uvec2(0x42222210u, 0x0u),
+   uvec2(0x8c000000u, 0x1u),
+   uvec2(0x000f8000u, 0x0u),
+   uvec2(0x0c6018c0u, 0x0u),
+   uvec2(0xa33ae62eu, 0x3u),
+   uvec2(0x884210c4u, 0x3u),
+   uvec2(0xc444422eu, 0x7u),
+   uvec2(0xa304111fu, 0x3u),
+   uvec2(0x11f4a988u, 0x2u),
+   uvec2(0xa3083c3fu, 0x3u),
+   uvec2(0xa317844cu, 0x3u),
+   uvec2(0x8422221fu, 0x0u),
+   uvec2(0xa317462eu, 0x3u),
+   uvec2(0x910f462eu, 0x1u),
+   uvec2(0x631fc62eu, 0x4u),
+   uvec2(0xe317c62fu, 0x3u),
+   uvec2(0xa210862eu, 0x3u),
+   uvec2(0xe318c62fu, 0x3u),
+   uvec2(0xc217843fu, 0x7u),
+   uvec2(0x4217843fu, 0x0u),
+   uvec2(0xa31e862eu, 0x7u),
+   uvec2(0x631fc631u, 0x4u),
+   uvec2(0x8842108eu, 0x3u),
+   uvec2(0x9284211cu, 0x1u),
+   uvec2(0x52519531u, 0x4u),
+   uvec2(0xc2108421u, 0x7u),
+   uvec2(0x631ad771u, 0x4u),
+   uvec2(0x639ace31u, 0x4u),
+   uvec2(0xa318c62eu, 0x3u),
+   uvec2(0x4217c62fu, 0x0u),
+   uvec2(0x9358c62eu, 0x5u),
+   uvec2(0x5257c62fu, 0x4u),
+   uvec2(0xe107043eu, 0x3u),
+   uvec2(0x0842109fu, 0x1u),
+   uvec2(0xa318c631u, 0x3u),
+   uvec2(0x1518c631u, 0x1u),
+   uvec2(0xab5ac631u, 0x2u),
+   uvec2(0x62a22a31u, 0x4u),
+   uvec2(0x08422a31u, 0x1u),
+   uvec2(0xc222221fu, 0x7u),
+   uvec2(0x54454400u, 0x4u)
+);
+
+void main()
+{
+   ivec2 p = ivec2(gl_GlobalInvocationID.xy);
+   /* one font pixel of margin, 6 per glyph, 9 rows */
+   const ivec2 box = ivec2(pc.count * 6 + 1, 9) * pc.scale;
+   if (p.x >= box.x || p.y >= box.y)
+      return;
+   ivec2 f = p / pc.scale - ivec2(1, 1);
+   bool on = false;
+   if (f.x >= 0 && f.y >= 0 && f.y < 7) {
+      const int g = f.x / 6, c = f.x % 6;
+      if (g < pc.count && c < 5) {
+         const uint code = (pc.text[g / 4] >> (8u * uint(g % 4))) & 0xffu;
+         const uvec2 bits = font5x7[min(code, 41u)];
+         const int bit = f.y * 5 + c;
+         on = ((bit < 32 ? bits.x >> uint(bit) : bits.y >> uint(bit - 32)) & 1u) != 0u;
+      }
+   }
+   imageStore(o_dst, pc.origin + p, on ? vec4(1.0, 0.95, 0.55, 1.0) : vec4(0.02, 0.02, 0.03, 1.0));
+}
