+
+   /* the on-screen counter: frames in and pictures shown since ov_t0,
+    * its line every half second (glyph codes, enh_text.comp) */
+   uint64_t ov_t0, ov_frames, ov_shown;
+   uint32_t ov_text[12];
+   int ov_count;
 };
 
 static bool a4k_prepare(struct wsi_enh *e, int v);
@@ -851,13 +870,13 @@ wsi_enh_create(const struct wsi_enh_create_info *info, struct wsi_enh **out)
 
    stats_open_csv(e);
    LOGI("%ux%u -> %ux%u (picture %ux%u at %d,%d), scaler %s, sharpness %u, "
-        "frame generation %s%ux (%s), %u output slots",
+        "frame generation %s%ux (%s), %u output slots%s",
         e->src.width, e->src.height, e->dst.width, e->dst.height,
