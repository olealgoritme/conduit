    return f->cmd;
 }
 
+/* The counter's line, "base / shown  FG 2x  FSR", as enh_text.comp's
+ * glyph codes (its font: " /.-:0-9A-Z" and a small x) */
+static void
+enh_overlay_text(struct wsi_enh *e, uint64_t now)
+{
+   static const char glyphs[] = " /.-:0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZx";
+   AcquireSRWLockExclusive(&e->stat_lock);
+   const double secs = (now - e->ov_t0) / 1e9;
+   if (e->ov_count && secs < 0.5) {
+      ReleaseSRWLockExclusive(&e->stat_lock);
+      return;
+   }
+   const unsigned base = secs > 0.0 ? (unsigned)(e->ov_frames / secs + 0.5) : 0;
+   const unsigned shown = secs > 0.0 ? (unsigned)(e->ov_shown / secs + 0.5) : 0;
+   e->ov_t0 = now;
+   e->ov_frames = e->ov_shown = 0;
+   ReleaseSRWLockExclusive(&e->stat_lock);
+
+   char line[64], fg[16] = "";
+   if (e->cfg.fg_adaptive)
+      snprintf(fg, sizeof(fg), "  FG AUTO");
+   else if (e->cfg.fg_mult > 1)
+      snprintf(fg, sizeof(fg), "  FG %ux", e->cfg.fg_mult);
+   char sc[16] = "";
+   if (e->cfg.scaler != WSI_ENH_SCALER_OFF) {
+      snprintf(sc, sizeof(sc), "  %s", wsi_enh_scaler_name(e->cfg.scaler));
+      for (char *q = sc; *q; q++)
+         *q = (char)toupper((unsigned char)*q);
+   }
+   snprintf(line, sizeof(line), "%u / %u%s%s", base, shown, fg, sc);
+   memset(e->ov_text, 0, sizeof(e->ov_text));
+   int n = 0;
+   for (const char *q = line; *q && n < 48; q++, n++) {
+      const char *g = strchr(glyphs, *q);
+      const uint32_t code = g && *q ? (uint32_t)(g - glyphs) : 0;
+      e->ov_text[n / 4] |= code << (8 * (n % 4));
+   }
+   e->ov_count = n;
+}
+
+/* The counter into every slot of the plan, top left of the picture */
+static void
+record_overlay(struct wsi_enh *e, VkCommandBuffer cmd, const struct wsi_enh_plan *plan)
+{
+   enh_overlay_text(e, os_time_get_nano());
+   if (!e->ov_count)
+      return;
+   struct {
+      int32_t origin[2];
+      int32_t scale;
+      int32_t count;
+      uint32_t text[12];
+   } push;
+   push.scale = (int32_t)MAX2(2u, e->rect.extent.height / 360);
+   push.origin[0] = e->rect.offset.x + 4 * push.scale;
+   push.origin[1] = e->rect.offset.y + 4 * push.scale;
+   push.count = e->ov_count;
+   memcpy(push.text, e->ov_text, sizeof(push.text));
+   const uint32_t w = (uint32_t)(push.count * 6 + 1) * (uint32_t)push.scale;
+   const uint32_t h = 9u * (uint32_t)push.scale;
+   if (push.origin[0] + w > e->dst.width || push.origin[1] + h > e->dst.height)
+      return;
+   compute_barrier(e->wsi, cmd);
+   for (uint32_t k = 0; k < plan->count; k++)
+      dispatch_raw(e, cmd, P_TEXT, e->tmp.view, e->linear, VK_NULL_HANDLE, VK_NULL_HANDLE,
+                   e->slot_views[plan->slot[k]], &push, sizeof(push),
+                   DIV_ROUND_UP(w, 8), DIV_ROUND_UP(h, 8));
+}
+
 VkCommandBuffer
 wsi_enh_record(struct wsi_enh *e, uint32_t qfi, uint32_t src_index,
                struct wsi_enh_plan *plan)
@@ -1718,6 +1806,9 @@ wsi_enh_record(struct wsi_enh *e, uint32_t qfi, uint32_t src_index,
       e->have_prev = true;
    }
 
+   if (e->cfg.overlay)
+      record_overlay(e, cmd, plan);
+
    /* Every query of the range is written (the results come back only when
     * all of them are available); the stages that did not run are not
     * counted (f->passes) */
@@ -1757,5 +1848,7 @@ wsi_enh_note_shown(struct wsi_enh *e, uint32_t real, uint32_t generated,
    e->stat_real += real;
    e->stat_gen += generated;
    e->stat_skipped += skipped;
+   e->ov_frames += real;
+   e->ov_shown += real + generated;
    ReleaseSRWLockExclusive(&e->stat_lock);
 }
