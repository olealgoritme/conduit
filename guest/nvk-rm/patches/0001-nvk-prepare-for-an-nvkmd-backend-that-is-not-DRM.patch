          pdev->mem_types[pdev->mem_type_count++] = (VkMemoryType) {
             .propertyFlags = VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT |
                              VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
@@ -1748,6 +1745,69 @@ fail_nvkmd:
    return result;
 }
 
+VkResult
+nvk_create_drm_physical_device(struct vk_instance *_instance,
+                               struct _drmDevice *drm_device,
+                               struct vk_physical_device **pdev_out)
+{
+   struct nvk_instance *instance = (struct nvk_instance *)_instance;
+   VkResult result;
+
+   struct nvkmd_pdev *nvkmd;
+   result = nvkmd_try_create_pdev_for_drm(drm_device, &instance->vk.base,
+                                          instance->debug_flags, &nvkmd);
+   if (result != VK_SUCCESS)
+      return result;
+
+   return nvk_create_physical_device_for_nvkmd(instance, nvkmd, pdev_out);
+}
+
+/* Enumerates GPUs which are driven by something other than a DRM driver
+ * (see nvkmd_enumerate_non_drm_pdevs()).  Returns
+ * VK_ERROR_INCOMPATIBLE_DRIVER if there are none, in which case the common
+ * code falls back to enumerating DRM devices.
+ */
+VkResult
+nvk_enumerate_physical_devices(struct vk_instance *_instance)
+{
+   struct nvk_instance *instance = (struct nvk_instance *)_instance;
+   struct nvkmd_pdev *nvkmds[NVKMD_MAX_NON_DRM_PDEVS];
+   uint32_t nvkmd_count = ARRAY_SIZE(nvkmds);
+   VkResult result;
+
+   result = nvkmd_enumerate_non_drm_pdevs(&instance->vk.base,
+                                          instance->debug_flags,
+                                          &nvkmd_count, nvkmds);
+   if (result != VK_SUCCESS)
+      return result;
+
+   uint32_t pdev_count = 0;
+   for (uint32_t i = 0; i < nvkmd_count; i++) {
+      if (result != VK_SUCCESS) {
+         nvkmd_pdev_destroy(nvkmds[i]);
+         continue;
+      }
+
+      struct vk_physical_device *pdev;
+      result = nvk_create_physical_device_for_nvkmd(instance, nvkmds[i],
+                                                    &pdev);
+      if (result == VK_ERROR_INCOMPATIBLE_DRIVER) {
+         result = VK_SUCCESS;
+         continue;
+      }
+
+      if (result == VK_SUCCESS) {
+         list_addtail(&pdev->link, &instance->vk.physical_devices.list);
+         pdev_count++;
+      }
+   }
+
+   if (result != VK_SUCCESS)
+      return result;
+
+   return pdev_count > 0 ? VK_SUCCESS : VK_ERROR_INCOMPATIBLE_DRIVER;
+}
