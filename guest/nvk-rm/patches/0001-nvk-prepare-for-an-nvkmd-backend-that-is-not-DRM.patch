+#define NVKMD_MAX_NON_DRM_PDEVS 16
+
+/** Enumerates GPUs driven by a kernel interface other than DRM
+ *
+ * On input, *pdev_count is the size of pdevs_out.  On success, *pdev_count
+ * is set to the number of nvkmd_pdev objects written to pdevs_out, which the
+ * caller owns.  Returns VK_ERROR_INCOMPATIBLE_DRIVER if no such interface is
+ * built in, enabled or present, in which case the caller should fall back to
+ * enumerating DRM devices.
+ */
+VkResult MUST_CHECK
+nvkmd_enumerate_non_drm_pdevs(struct vk_object_base *log_obj,
+                              enum nvk_debug debug_flags,
+                              uint32_t *pdev_count,
+                              struct nvkmd_pdev **pdevs_out);
