-static VkResult
-nvkmd_rm_create_ctx_stub(struct nvkmd_dev *dev,
-                         struct vk_object_base *log_obj,
-                         enum nvkmd_engines engines,
-                         struct nvkmd_ctx **ctx_out)
+/*
+ * CPU waits
+ *
+ * Spin briefly, then block in poll() on the non-stall interrupt event (the
+ * pushbuffer raises one after each semaphore release), or sleep with
+ * backoff if there is no event.  The value in memory is always what
+ * decides; the event is only a wakeup, so a missed or spurious one costs at
+ * most one poll timeout.
+ */
+#define NVKMD_RM_WAIT_SPIN_ITERS 64
+#define NVKMD_RM_WAIT_POLL_MS    10
+
+VkResult
+nvkmd_rm_wait_step(struct nvkmd_rm_dev *dev, uint32_t *iter,
+                   uint64_t abs_timeout_ns)
 {
-   return vk_errorf(log_obj, VK_ERROR_FEATURE_NOT_PRESENT,
-                    "NVK on RM: contexts are not implemented yet");
+   const uint64_t now = os_time_get_nano();
+   if (now >= abs_timeout_ns)
+      return VK_TIMEOUT;
+
+   const uint64_t remaining_ns = abs_timeout_ns - now;
+
+   if (*iter < NVKMD_RM_WAIT_SPIN_ITERS) {
+      sched_yield();
+   } else if (dev != NULL && dev->nonstall_fd >= 0) {
+      const int ms = MIN2(remaining_ns / 1000000 + 1, NVKMD_RM_WAIT_POLL_MS);
+      struct pollfd pfd = {
+         .fd = dev->nonstall_fd,
+         .events = POLLIN,
+      };
+      if (poll(&pfd, 1, ms) > 0 && dev->lib->event_drain != NULL) {
+         /* Best effort: event data may not be readable (Conduit guests) */
+         struct crm_event_data data[8];
+         dev->lib->event_drain(dev->client, dev->nonstall_fd,
+                               data, ARRAY_SIZE(data));
+      }
+   } else {
+      const uint64_t us = *iter < 4 * NVKMD_RM_WAIT_SPIN_ITERS ? 10 : 200;
+      os_time_sleep(MIN2(us, remaining_ns / 1000 + 1));
+   }
+
+   (*iter)++;
+
+   return VK_SUCCESS;
+}
+
+VkResult
+nvkmd_rm_wait_value(struct nvkmd_rm_dev *dev,
+                    volatile uint64_t *value, uint64_t wait_value,
+                    uint64_t abs_timeout_ns)
+{
+   uint32_t iter = 0;
+   while (true) {
+      if (p_atomic_read(value) >= wait_value)
+         return VK_SUCCESS;
+
+      VkResult result = nvkmd_rm_wait_step(dev, &iter, abs_timeout_ns);
+      if (result != VK_SUCCESS)
+         return result;
+   }
 }
 
