 src/nouveau/vulkan/nvkmd/rm/nvrm/nvrm_api.h   | 547 ++++++++++++++++++
 .../nvkmd/rm/rmclient-fallback/rmclient.h     | 138 +++++
 6 files changed, 1128 insertions(+)
 create mode 100644 src/nouveau/vulkan/nvkmd/rm/nvkmd_rm.h
 create mode 100644 src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_lib.c
 create mode 100644 src/nouveau/vulkan/nvkmd/rm/nvrm/nvrm_api.h
 create mode 100644 src/nouveau/vulkan/nvkmd/rm/rmclient-fallback/rmclient.h

