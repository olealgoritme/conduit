diff --git a/src/nouveau/vulkan/meson.build b/src/nouveau/vulkan/meson.build
index 029ecbd..0920a68 100644
--- a/src/nouveau/vulkan/meson.build
+++ b/src/nouveau/vulkan/meson.build
@@ -276,6 +276,26 @@ if with_platform_android
   nvk_files += files('nvk_android.c')
 endif
 
+# The RM backend talks to NVIDIA's Resource Manager through librmclient.  It
+# is dlopen()ed at runtime, so only its header is needed to build.
+if not get_option('nvk-rm').disabled()
+  dep_rmclient = dependency('rmclient', required : false)
+  if dep_rmclient.found()
+    nvk_deps += dep_rmclient.partial_dependency(compile_args : true,
+                                                includes : true)
+  else
+    nvk_include_directories += include_directories('nvkmd/rm/rmclient-fallback')
+  endif
+  nvk_include_directories += include_directories('nvkmd/rm')
+  nvk_deps += dep_dl
+  nvk_flags += '-DNVK_WITH_RM=1'
+  nvk_files += files(
+    'nvkmd/rm/nvkmd_rm.h',
+    'nvkmd/rm/nvkmd_rm_lib.c',
+    'nvkmd/rm/nvrm/nvrm_api.h',
+  )
+endif
+
 libnvk = static_library(
   'nvk',
   [
diff --git a/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm.h b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm.h
new file mode 100644
index 0000000..1775869
--- /dev/null
+++ b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm.h
@@ -0,0 +1,295 @@
+/*
+ * Copyright © 2026 Conduit contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * nvkmd backend on top of the NVIDIA Resource Manager (RM), reached through
+ * librmclient (Conduit's guest/rmclient: NVIDIA's open kernel modules'
+ * /dev/nvidiactl escape interface, possibly forwarded over virtio).
+ */
+#ifndef NVKMD_RM_H
+#define NVKMD_RM_H 1
+
+#include "nvkmd/nvkmd.h"
+#include "util/u_dynarray.h"
+#include "util/vma.h"
+#include "vk_sync.h"
+#include "vk_sync_binary.h"
+
+#include "rmclient.h"
+#include "nvrm/nvrm_api.h"
+
+/*
+ * librmclient, loaded at runtime
+ */
+
+struct nvkmd_rm_lib {
+   void *handle;
+
+   int (*open)(crm_client **out, const struct crm_transport *transport);
+   void (*close)(crm_client *c);
+   uint32_t (*root)(const crm_client *c);
+   int (*alloc)(crm_client *c, uint32_t parent, uint32_t *object,
+                uint32_t hclass, void *params, uint32_t params_size);
+   int (*control)(crm_client *c, uint32_t object, uint32_t cmd,
+                  void *params, uint32_t params_size);
+   int (*free)(crm_client *c, uint32_t parent, uint32_t object);
+   int (*map_memory)(crm_client *c, uint32_t device, uint32_t memory,
+                     uint64_t offset, uint64_t length, uint32_t flags,
+                     void **cpu_ptr);
+   int (*unmap_memory)(crm_client *c, uint32_t device, uint32_t memory,
+                       void *cpu_ptr, uint64_t length, uint32_t flags);
+   int (*map_dma)(crm_client *c, uint32_t device, uint32_t dma,
+                  uint32_t memory, uint64_t offset, uint64_t length,
+                  uint32_t flags, uint64_t *gpu_va);
+   int (*unmap_dma)(crm_client *c, uint32_t device, uint32_t dma,
+                    uint32_t memory, uint32_t flags, uint64_t gpu_va);
+   int (*gpu_count)(crm_client *c);
+   int (*gpu_info)(crm_client *c, int index, uint32_t *gpu_id,
+                   uint32_t *minor, uint32_t *pci_device_id);
+   const char *(*status_name)(int status);
+
+   /* Entry points beyond the base contract (librmclient "additions").
+    * NULL if the library does not export them; the backend then falls back
+    * to something slower or less complete.
+    */
+   int (*map_dma2)(crm_client *c, uint32_t device, uint32_t dma,
+                   uint32_t memory, uint64_t offset, uint64_t length,
+                   uint32_t flags, uint32_t flags2, uint32_t kind_override,
+                   uint64_t *gpu_va);
+   int (*free_quiet)(crm_client *c, uint32_t parent, uint32_t object);
+   int (*event_open)(crm_client *c, uint32_t parent, uint32_t notify_index,
+                     uint32_t *event_handle, int *event_fd);
+   int (*event_close)(crm_client *c, uint32_t event_handle, int event_fd);
+   int (*event_drain)(crm_client *c, int event_fd,
+                      struct crm_event_data *out, int max);
+};
+
+/* Returns NULL if librmclient cannot be loaded */
+const struct nvkmd_rm_lib *nvkmd_rm_lib_get(void);
+
+/* Turns a librmclient return value into a VkResult, logging failures */
+VkResult nvkmd_rm_result(const struct nvkmd_rm_lib *lib,
+                         struct vk_object_base *log_obj,
+                         VkResult default_error, int ret,
+                         const char *what);
+
+#define NVKMD_RM_CHECK(lib, log_obj, err, call, what) \
+   nvkmd_rm_result((lib), (log_obj), (err), (call), (what))
+
+/*
+ * Physical device
+ */
+
+struct nvkmd_rm_pdev {
+   struct nvkmd_pdev base;
+
+   const struct nvkmd_rm_lib *lib;
+
+   /* Client used for queries (VRAM usage) */
+   crm_client *client;
+   uint32_t h_device;
+   uint32_t h_subdevice;
+
+   uint32_t gpu_id;
+   uint32_t device_instance;
+   uint32_t subdevice_instance;
+
+   uint32_t cls_usermode;
+
+   struct vk_sync_type sync_type;
+   struct vk_sync_binary_type binary_sync_type;
+   const struct vk_sync_type *sync_types[3];
+};
+
+NVKMD_DECL_SUBCLASS(pdev, rm);
+
+VkResult nvkmd_rm_enumerate_pdevs(struct vk_object_base *log_obj,
+                                  enum nvk_debug debug_flags,
+                                  uint32_t *pdev_count,
+                                  struct nvkmd_pdev **pdevs_out);
+
+/*
+ * Logical device
+ */
+
+/* GPU VA layout.  Everything NVK places is chosen here and handed to RM as
+ * a fixed address.  RM's own mappings (GR context buffers and the like) are
+ * confined to [INTERNAL_START, INTERNAL_END) with VA_INTERNAL_LIMIT, and the
+ * heap skips that range.  Pushbuffers must stay below 2^40 (GP_ENTRY1_GET_HI
+ * is 8 bits).
+ */
+#define NVKMD_RM_HEAP_START            ((uint64_t)1 << 21)
+#define NVKMD_RM_INTERNAL_START        ((uint64_t)1 << 32)
+#define NVKMD_RM_INTERNAL_END          (NVKMD_RM_INTERNAL_START + (512ull << 20))
+#define NVKMD_RM_HEAP_END              ((uint64_t)1 << 38)
+#define NVKMD_RM_REPLAY_HEAP_START     NVKMD_RM_HEAP_END
+#define NVKMD_RM_REPLAY_HEAP_END       ((uint64_t)1 << 39)
+
+/* Big page size we ask RM for (FERMI_VASPACE_A bigPageSize) */
+#define NVKMD_RM_BIG_PAGE_SIZE         (64u << 10)
+
+struct nvkmd_rm_sema_pool {
+   simple_mtx_t mutex;
+   struct util_dynarray chunks;     /* struct nvkmd_mem * */
+   struct util_dynarray free_slots; /* uint32_t */
+};
+
+struct nvkmd_rm_dev {
+   struct nvkmd_dev base;
+
+   const struct nvkmd_rm_lib *lib;
+   crm_client *client;
+
+   uint32_t h_device;
+   uint32_t h_subdevice;
+   uint32_t h_vaspace;
+   uint32_t h_usermode;
+   void *usermode_map;
+
+   /* Non-stall interrupt event, for CPU waits.  fd < 0 if unavailable. */
+   uint32_t h_nonstall_event;
+   int nonstall_fd;
+
+   simple_mtx_t heap_mutex;
+   struct util_vma_heap heap;
+   struct util_vma_heap replay_heap;
+
+   struct nvkmd_rm_sema_pool sema_pool;
+};
+
+NVKMD_DECL_SUBCLASS(dev, rm);
+
+VkResult nvkmd_rm_create_dev(struct nvkmd_pdev *pdev,
+                             struct vk_object_base *log_obj,
+                             struct nvkmd_dev **dev_out);
+
+/*
+ * Memory
+ */
+
+struct nvkmd_rm_mem {
+   struct nvkmd_mem base;
+
+   uint32_t h_memory;
+
+   /* Placement actually used */
+   bool vram;
+
+   /* For memory backed by our own pages (NV01_MEMORY_SYSTEM_OS_DESCRIPTOR),
+    * the CPU mapping is the allocation itself.
+    */
+   void *os_pages;
+};
+
+NVKMD_DECL_SUBCLASS(mem, rm);
+
+VkResult nvkmd_rm_alloc_mem(struct nvkmd_dev *dev,
+                            struct vk_object_base *log_obj,
+                            uint64_t size_B, uint64_t align_B,
+                            enum nvkmd_mem_flags flags,
+                            struct nvkmd_mem **mem_out);
+
+VkResult nvkmd_rm_alloc_tiled_mem(struct nvkmd_dev *dev,
+                                  struct vk_object_base *log_obj,
+                                  uint64_t size_B, uint64_t align_B,
+                                  uint8_t pte_kind, uint16_t tile_mode,
+                                  enum nvkmd_mem_flags flags,
+                                  struct nvkmd_mem **mem_out);
+
+VkResult nvkmd_rm_import_dma_buf(struct nvkmd_dev *dev,
+                                 struct vk_object_base *log_obj,
+                                 int fd, struct nvkmd_mem **mem_out);
+
+/*
+ * GPU virtual address ranges
+ */
+
+/* One RM DMA mapping inside an nvkmd_rm_va */
+struct nvkmd_rm_mapping {
+   uint64_t va_offset_B;
+   uint64_t range_B;
+   uint32_t h_memory;
+   uint64_t mem_offset_B;
+};
+
+struct nvkmd_rm_va {
+   struct nvkmd_va base;
+
+   /* NV50_MEMORY_VIRTUAL reserving [addr, addr + size_B) in RM */
+   uint32_t h_virtual;
+
+   simple_mtx_t mutex;
+   struct util_dynarray mappings; /* struct nvkmd_rm_mapping */
+};
+
+NVKMD_DECL_SUBCLASS(va, rm);
+
+VkResult nvkmd_rm_alloc_va(struct nvkmd_dev *dev,
+                           struct vk_object_base *log_obj,
+                           enum nvkmd_va_flags flags, uint8_t pte_kind,
+                           uint64_t size_B, uint64_t align_B,
+                           uint64_t fixed_addr, struct nvkmd_va **va_out);
+
+/*
+ * Contexts
+ */
+
+VkResult nvkmd_rm_create_ctx(struct nvkmd_dev *dev,
+                             struct vk_object_base *log_obj,
+                             enum nvkmd_engines engines,
+                             struct nvkmd_ctx **ctx_out);
+
+/*
+ * Syncs: 64-bit timeline values in GPU-visible system memory
+ */
+
+struct nvkmd_rm_sync {
+   struct vk_sync base;
+
+   struct nvkmd_rm_dev *dev;   /* NULL for CPU-only syncs */
+   uint32_t slot;
+
+   volatile uint64_t *value;   /* CPU pointer to the semaphore */
+   uint64_t gpu_va;            /* 0 for CPU-only syncs */
+
+   /* Highest value a signal operation has been submitted for */
+   uint64_t pending;
+
+   uint64_t cpu_only_value;
+};
+
+struct vk_sync_type nvkmd_rm_sync_get_type(void);
+
+static inline bool
+nvkmd_rm_sync_type_is(const struct vk_sync_type *type)
+{
+   extern VkResult nvkmd_rm_sync_init(struct vk_device *device,
+                                      struct vk_sync *sync,
+                                      uint64_t initial_value);
+   return type->init == nvkmd_rm_sync_init;
+}
+
+static inline struct nvkmd_rm_sync *
+nvkmd_rm_sync(struct vk_sync *sync)
+{
+   assert(nvkmd_rm_sync_type_is(sync->type));
+   return container_of(sync, struct nvkmd_rm_sync, base);
+}
+
+/* Records that a signal of at least value has been submitted */
+void nvkmd_rm_sync_mark_pending(struct nvkmd_rm_sync *sync, uint64_t value);
+
+/* Waits on the CPU until *value >= wait_value or the timeout expires */
+VkResult nvkmd_rm_wait_value(struct nvkmd_rm_dev *dev,
+                             volatile uint64_t *value, uint64_t wait_value,
+                             uint64_t abs_timeout_ns);
+
+VkResult nvkmd_rm_sema_pool_alloc(struct nvkmd_rm_dev *dev,
+                                  struct vk_object_base *log_obj,
+                                  uint32_t *slot_out,
+                                  volatile uint64_t **cpu_out,
+                                  uint64_t *gpu_va_out);
+void nvkmd_rm_sema_pool_free(struct nvkmd_rm_dev *dev, uint32_t slot);
+void nvkmd_rm_sema_pool_finish(struct nvkmd_rm_dev *dev);
+
+#endif /* NVKMD_RM_H */
diff --git a/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_lib.c b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_lib.c
new file mode 100644
index 0000000..bcd3736
--- /dev/null
+++ b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_lib.c
@@ -0,0 +1,119 @@
+/*
+ * Copyright © 2026 Conduit contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "nvkmd_rm.h"
+
+#include "util/log.h"
+#include "util/os_misc.h"
+#include "util/u_call_once.h"
+#include "vk_log.h"
+
+#include <dlfcn.h>
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+
+/* NVK does not link against librmclient.  It is loaded the first time an RM
+ * device is enumerated so that a Mesa built with -Dnvk-rm=enabled still
+ * works (with nouveau only) on systems without it.
+ */
+static struct nvkmd_rm_lib rm_lib;
+static bool rm_lib_ok;
+static util_once_flag rm_lib_once = UTIL_ONCE_FLAG_INIT;
+
+#define LOAD(field, name, required)                                  \
+   do {                                                              \
+      *(void **)&rm_lib.field = dlsym(rm_lib.handle, name);          \
+      if ((required) && rm_lib.field == NULL) {                      \
+         mesa_logw("NVK: %s does not export %s", path, name);        \
+         goto fail;                                                  \
+      }                                                              \
+   } while (0)
+
+static void
+nvkmd_rm_lib_load(void)
+{
+   static const char *const default_paths[] = {
+      "librmclient.so.0",
+      "librmclient.so",
+   };
+   const char *path = os_get_option("NVK_RMCLIENT_LIB");
+
+   if (path != NULL) {
+      rm_lib.handle = dlopen(path, RTLD_NOW | RTLD_LOCAL);
+   } else {
+      for (unsigned i = 0; i < ARRAY_SIZE(default_paths); i++) {
+         path = default_paths[i];
+         rm_lib.handle = dlopen(path, RTLD_NOW | RTLD_LOCAL);
+         if (rm_lib.handle != NULL)
+            break;
+      }
+   }
+
+   if (rm_lib.handle == NULL) {
+      mesa_logd("NVK: failed to load librmclient: %s", dlerror());
+      return;
+   }
+
+   LOAD(open,         "crm_open",         true);
+   LOAD(close,        "crm_close",        true);
+   LOAD(root,         "crm_root",         true);
+   LOAD(alloc,        "crm_alloc",        true);
+   LOAD(control,      "crm_control",      true);
+   LOAD(free,         "crm_free",         true);
+   LOAD(map_memory,   "crm_map_memory",   true);
+   LOAD(unmap_memory, "crm_unmap_memory", true);
+   LOAD(map_dma,      "crm_map_dma",      true);
+   LOAD(unmap_dma,    "crm_unmap_dma",    true);
+   LOAD(gpu_count,    "crm_gpu_count",    true);
+   LOAD(gpu_info,     "crm_gpu_info",     true);
+   LOAD(status_name,  "crm_status_name",  true);
+
+   LOAD(map_dma2,     "crm_map_dma2",     false);
+   LOAD(free_quiet,   "crm_free_quiet",   false);
+   LOAD(event_open,   "crm_event_open",   false);
+   LOAD(event_close,  "crm_event_close",  false);
+   LOAD(event_drain,  "crm_event_drain",  false);
+
+   rm_lib_ok = true;
+   return;
+
+fail:
+   dlclose(rm_lib.handle);
+   memset(&rm_lib, 0, sizeof(rm_lib));
+}
+
+const struct nvkmd_rm_lib *
+nvkmd_rm_lib_get(void)
+{
+   util_call_once(&rm_lib_once, nvkmd_rm_lib_load);
+   return rm_lib_ok ? &rm_lib : NULL;
+}
+
+VkResult
+nvkmd_rm_result(const struct nvkmd_rm_lib *lib,
+                struct vk_object_base *log_obj,
+                VkResult default_error, int ret,
+                const char *what)
+{
+   if (ret == 0)
+      return VK_SUCCESS;
+
+   VkResult result = default_error;
+   if (ret == NV_ERR_NO_MEMORY || ret == NV_ERR_INSUFFICIENT_RESOURCES)
+      result = VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   else if (ret == -ENOMEM)
+      result = VK_ERROR_OUT_OF_HOST_MEMORY;
+   else if (ret == -ENODEV || ret == -EIO)
+      result = VK_ERROR_DEVICE_LOST;
+
+   if (ret < 0) {
+      return vk_errorf(log_obj, result, "RM %s failed: %s", what,
+                       strerror(-ret));
+   } else {
+      return vk_errorf(log_obj, result, "RM %s failed: 0x%x (%s)", what,
+                       ret, lib->status_name ? lib->status_name(ret) : "?");
+   }
+}
