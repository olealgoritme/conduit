+/*
+ * Minimal subset of the NVIDIA Resource Manager (RM) API used by the NVK
+ * nvkmd "rm" backend.
+ *
+ * Every definition below is copied verbatim (names, values, field order)
+ * from NVIDIA's open-gpu-kernel-modules, tag 610.57.04
+ * (https://github.com/NVIDIA/open-gpu-kernel-modules), files under
+ * src/common/sdk/nvidia/inc/: nvos.h, alloc/alloc_channel.h, class/cl*.h,
+ * ctrl/ctrl0000/ctrl0000gpu.h, ctrl/ctrl0080/ctrl0080gpu.h,
+ * ctrl/ctrl0080/ctrl0080gr.h, ctrl/ctrl2080/ctrl2080{mc,fb,bus,gr,gpu,tmr,
+ * event}.h, ctrl/ctrla06c.h, ctrl/ctrla06f/ctrla06fgpfifo.h,
+ * ctrl/ctrlc36f.h and class/cl2080_notification.h.  Only the integer types
+ * were mapped onto Mesa's nvtypes.h.  Struct sizes are checked against the
+ * sizes RM expects with STATIC_ASSERTs at the end of this file.
+ *
+ * The RM ABI changes between driver releases; this subset matches 610.57.04
+ * (and, for these particular structs, every release since 535).
+ */
+#ifndef NVRM_API_H
+#define NVRM_API_H
+
+#include "nvtypes.h"
+#include "drf.h"
+
+#include <assert.h>
+
+typedef NvU32 NvHandle;
+
+#define NVRM_ALIGN8 __attribute__((aligned(8)))
+
+/* DRF helpers in the style of NVIDIA's nvmisc.h, on top of Mesa's drf.h */
+#define NVRM_DEF(d, r, f, c) \
