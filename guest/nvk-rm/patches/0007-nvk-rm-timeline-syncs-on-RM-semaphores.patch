diff --git a/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_sync.c b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_sync.c
new file mode 100644
index 0000000..e995548
--- /dev/null
+++ b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_sync.c
@@ -0,0 +1,254 @@
+/*
+ * Copyright © 2026 Conduit contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "nvkmd_rm.h"
+
+#include "../../nvk_device.h"
+
+#include "util/os_time.h"
+#include "vk_log.h"
+
+/*
+ * Timeline syncs
+ *
+ * A sync is a 64-bit value in GPU-visible, CPU-cached system memory (a slot
+ * in the device's semaphore pool).  The GPU signals it with a host
+ * semaphore release and waits on it with a semaphore acquire
+ * (nvkmd_rm_ctx.c); the CPU reads and writes it directly.  Binary
+ * semaphores and fences use Mesa's vk_sync_binary on top.
+ *
+ * CPU waits poll the value, blocking on the RM non-stall interrupt event
+ * when there is one (nvkmd_rm_wait_step()).
+ *
+ * Not done yet (see the README): exporting/importing (sync_file, opaque
+ * fd), which needs an RM semaphore surface (NV_SEMAPHORE_SURFACE) bridged
+ * to DRM syncobjs through nvidia-drm, and WAIT_BEFORE_SIGNAL (GPU acquires
+ * on values nobody has submitted yet are avoided until the channel's
+ * acquire timeout behaviour is known; the runtime's submit thread holds
+ * such submits back instead).
+ */
+
+#define NVKMD_RM_SEMA_CHUNK_SIZE  (64u << 10)
+#define NVKMD_RM_SEMA_SLOT_SIZE   8u
+#define NVKMD_RM_SEMA_PER_CHUNK   (NVKMD_RM_SEMA_CHUNK_SIZE / \
+                                   NVKMD_RM_SEMA_SLOT_SIZE)
+
+VkResult
+nvkmd_rm_sema_pool_alloc(struct nvkmd_rm_dev *dev,
+                         struct vk_object_base *log_obj,
+                         uint32_t *slot_out,
+                         volatile uint64_t **cpu_out,
+                         uint64_t *gpu_va_out)
+{
+   struct nvkmd_rm_sema_pool *pool = &dev->sema_pool;
+   VkResult result = VK_SUCCESS;
+
+   simple_mtx_lock(&pool->mutex);
+
+   if (util_dynarray_num_elements(&pool->free_slots, uint32_t) == 0) {
+      struct nvkmd_mem *chunk;
+      result = nvkmd_dev_alloc_mapped_mem(&dev->base, log_obj,
+                                          NVKMD_RM_SEMA_CHUNK_SIZE, 0,
+                                          NVKMD_MEM_GART,
+                                          NVKMD_MEM_MAP_RDWR, &chunk);
+      if (result != VK_SUCCESS)
+         goto out;
+
+      memset(chunk->map, 0, NVKMD_RM_SEMA_CHUNK_SIZE);
+
+      const uint32_t chunk_idx =
+         util_dynarray_num_elements(&pool->chunks, struct nvkmd_mem *);
+      util_dynarray_append(&pool->chunks, chunk);
+
+      /* Push in reverse so slots are handed out in address order */
+      for (uint32_t i = NVKMD_RM_SEMA_PER_CHUNK; i-- > 0;) {
+         const uint32_t slot = chunk_idx * NVKMD_RM_SEMA_PER_CHUNK + i;
+         util_dynarray_append(&pool->free_slots, slot);
+      }
+   }
+
+   const uint32_t slot = util_dynarray_pop(&pool->free_slots, uint32_t);
+   struct nvkmd_mem *chunk =
+      *util_dynarray_element(&pool->chunks, struct nvkmd_mem *,
+                             slot / NVKMD_RM_SEMA_PER_CHUNK);
+   const uint32_t offset_B =
+      (slot % NVKMD_RM_SEMA_PER_CHUNK) * NVKMD_RM_SEMA_SLOT_SIZE;
+
+   *slot_out = slot;
+   *cpu_out = (volatile uint64_t *)((uint8_t *)chunk->map + offset_B);
+   *gpu_va_out = chunk->va->addr + offset_B;
+
+out:
+   simple_mtx_unlock(&pool->mutex);
+   return result;
+}
+
+void
+nvkmd_rm_sema_pool_free(struct nvkmd_rm_dev *dev, uint32_t slot)
+{
+   struct nvkmd_rm_sema_pool *pool = &dev->sema_pool;
+
+   simple_mtx_lock(&pool->mutex);
+   util_dynarray_append(&pool->free_slots, slot);
+   simple_mtx_unlock(&pool->mutex);
+}
+
+void
+nvkmd_rm_sema_pool_finish(struct nvkmd_rm_dev *dev)
+{
+   struct nvkmd_rm_sema_pool *pool = &dev->sema_pool;
+
+   util_dynarray_foreach(&pool->chunks, struct nvkmd_mem *, chunk)
+      nvkmd_mem_unref(*chunk);
+   util_dynarray_fini(&pool->chunks);
+   util_dynarray_fini(&pool->free_slots);
+   simple_mtx_destroy(&pool->mutex);
+}
+
+void
+nvkmd_rm_sync_mark_pending(struct nvkmd_rm_sync *sync, uint64_t value)
+{
+   uint64_t old = p_atomic_read(&sync->pending);
+   while (old < value) {
+      const uint64_t prev = p_atomic_cmpxchg(&sync->pending, old, value);
+      if (prev == old)
+         break;
+      old = prev;
+   }
+}
+
+/* The nvkmd device behind a vk_device, if it has one (devices created
+ * without queues have none).
+ */
+static struct nvkmd_rm_dev *
+vk_device_to_rm_dev(struct vk_device *vk_dev)
+{
+   struct nvk_device *dev = container_of(vk_dev, struct nvk_device, vk);
+   return dev->nvkmd != NULL ? nvkmd_rm_dev(dev->nvkmd) : NULL;
+}
+
+VkResult
+nvkmd_rm_sync_init(struct vk_device *device,
+                   struct vk_sync *_sync,
+                   uint64_t initial_value)
+{
+   struct nvkmd_rm_sync *sync = nvkmd_rm_sync(_sync);
+   struct nvkmd_rm_dev *dev = vk_device_to_rm_dev(device);
+
+   if (dev != NULL) {
+      VkResult result = nvkmd_rm_sema_pool_alloc(dev, &device->base,
+                                                 &sync->slot, &sync->value,
+                                                 &sync->gpu_va);
+      if (result != VK_SUCCESS)
+         return result;
+      sync->dev = dev;
+   } else {
+      /* No GPU can signal or wait on it; CPU-only */
+      sync->dev = NULL;
+      sync->value = &sync->cpu_only_value;
+      sync->gpu_va = 0;
+   }
+
+   *sync->value = initial_value;
+   sync->pending = initial_value;
+
+   return VK_SUCCESS;
+}
+
+static void
+nvkmd_rm_sync_finish(struct vk_device *device, struct vk_sync *_sync)
+{
+   struct nvkmd_rm_sync *sync = nvkmd_rm_sync(_sync);
+
+   if (sync->dev != NULL)
+      nvkmd_rm_sema_pool_free(sync->dev, sync->slot);
+}
+
+static VkResult
+nvkmd_rm_sync_signal(struct vk_device *device, struct vk_sync *_sync,
+                     uint64_t value)
+{
+   struct nvkmd_rm_sync *sync = nvkmd_rm_sync(_sync);
+
+   nvkmd_rm_sync_mark_pending(sync, value);
+   __atomic_thread_fence(__ATOMIC_SEQ_CST);
+   *sync->value = value;
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+nvkmd_rm_sync_get_value(struct vk_device *device, struct vk_sync *_sync,
+                        uint64_t *value)
+{
+   struct nvkmd_rm_sync *sync = nvkmd_rm_sync(_sync);
+
+   *value = p_atomic_read(sync->value);
+
+   return VK_SUCCESS;
+}
+
+static bool
+wait_satisfied(const struct vk_sync_wait *wait,
+               enum vk_sync_wait_flags wait_flags)
+{
+   struct nvkmd_rm_sync *sync = nvkmd_rm_sync(wait->sync);
+
+   if (wait_flags & VK_SYNC_WAIT_PENDING)
+      return p_atomic_read(&sync->pending) >= wait->wait_value;
+   else
+      return p_atomic_read(sync->value) >= wait->wait_value;
+}
+
+static VkResult
+nvkmd_rm_sync_wait_many(struct vk_device *device,
+                        uint32_t wait_count,
+                        const struct vk_sync_wait *waits,
+                        enum vk_sync_wait_flags wait_flags,
+                        uint64_t abs_timeout_ns)
+{
+   struct nvkmd_rm_dev *dev = vk_device_to_rm_dev(device);
+   uint32_t iter = 0;
+
+   while (true) {
+      bool all = true, any = false;
+      for (uint32_t i = 0; i < wait_count; i++) {
+         if (wait_satisfied(&waits[i], wait_flags))
+            any = true;
+         else
+            all = false;
+      }
+
+      if ((wait_flags & VK_SYNC_WAIT_ANY) ? any : all)
+         return VK_SUCCESS;
+
+      VkResult result = nvkmd_rm_wait_step(dev, &iter, abs_timeout_ns);
+      if (result != VK_SUCCESS)
+         return result;
+
+      if (vk_device_is_lost(device))
+         return VK_ERROR_DEVICE_LOST;
+   }
+}
+
+struct vk_sync_type
+nvkmd_rm_sync_get_type(void)
+{
+   return (struct vk_sync_type) {
+      .size = sizeof(struct nvkmd_rm_sync),
+      .features = VK_SYNC_FEATURE_TIMELINE |
+                  VK_SYNC_FEATURE_GPU_WAIT |
+                  VK_SYNC_FEATURE_GPU_MULTI_WAIT |
+                  VK_SYNC_FEATURE_CPU_WAIT |
+                  VK_SYNC_FEATURE_CPU_SIGNAL |
+                  VK_SYNC_FEATURE_WAIT_ANY |
+                  VK_SYNC_FEATURE_WAIT_PENDING,
+      .init = nvkmd_rm_sync_init,
+      .finish = nvkmd_rm_sync_finish,
+      .signal = nvkmd_rm_sync_signal,
+      .get_value = nvkmd_rm_sync_get_value,
+      .wait_many = nvkmd_rm_sync_wait_many,
+   };
+}
-- 
