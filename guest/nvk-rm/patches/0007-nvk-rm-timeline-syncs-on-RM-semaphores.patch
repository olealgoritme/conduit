diff --git a/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_ctx.c b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_ctx.c
index 86c0c05..2cb85f5 100644
--- a/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_ctx.c
+++ b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_ctx.c
@@ -320,11 +320,42 @@ nvkmd_rm_exec_ctx_wait(struct nvkmd_ctx *_ctx,
                        uint32_t wait_count,
                        const struct vk_sync_wait *waits)
 {
-   if (wait_count == 0)
-      return VK_SUCCESS;
+   struct nvkmd_rm_exec_ctx *ctx = nvkmd_rm_exec_ctx(_ctx);
+
+   for (uint32_t i = 0; i < wait_count; i++) {
+      struct nvkmd_rm_sync *sync = nvkmd_rm_sync(waits[i].sync);
+      const uint64_t value = waits[i].wait_value;
+
+      if (sync->dev == NULL) {
+         /* CPU-only sync (created before any queue existed): the GPU can't
+          * see it, so wait for it here.
+          */
+         VkResult result =
+            nvkmd_rm_wait_value(nvkmd_rm_dev(ctx->base.dev), sync->value,
+                                value, UINT64_MAX);
+         if (result != VK_SUCCESS)
+            return result;
+         continue;
+      }
+
+      /* Already signaled: nothing to do */
+      if (*sync->value >= value)
+         continue;
 
-   return vk_errorf(log_obj, VK_ERROR_FEATURE_NOT_PRESENT,
-                    "NVK on RM: syncs are not implemented yet");
+      if (ctx->pending_op_count >= NVKMD_RM_MAX_PENDING_OPS) {
+         VkResult result = emit_pending_waits(ctx, log_obj);
+         if (result != VK_SUCCESS)
+            return result;
+      }
+
+      ctx->pending_ops[ctx->pending_op_count++] = (struct nvkmd_rm_sem_op) {
+         .gpu_va = sync->gpu_va,
+         .value = value,
+         .release = false,
+      };
+   }
+
+   return VK_SUCCESS;
 }
 
 static VkResult
@@ -333,12 +364,45 @@ nvkmd_rm_exec_ctx_signal(struct nvkmd_ctx *_ctx,
                          uint32_t signal_count,
                          const struct vk_sync_signal *signals)
 {
-   if (signal_count > 0) {
-      return vk_errorf(log_obj, VK_ERROR_FEATURE_NOT_PRESENT,
-                       "NVK on RM: syncs are not implemented yet");
+   struct nvkmd_rm_exec_ctx *ctx = nvkmd_rm_exec_ctx(_ctx);
+   VkResult result;
+
+   result = emit_pending_waits(ctx, log_obj);
+   if (result != VK_SUCCESS)
+      return result;
+
+   for (uint32_t i = 0; i < signal_count;) {
+      struct nvkmd_rm_sem_op ops[16];
+      uint32_t op_count = 0;
+      for (; i < signal_count && op_count < ARRAY_SIZE(ops); i++) {
+         struct nvkmd_rm_sync *sync = nvkmd_rm_sync(signals[i].sync);
+         if (sync->dev == NULL) {
+            return vk_errorf(log_obj, VK_ERROR_UNKNOWN,
+                             "GPU signal of a CPU-only sync");
+         }
+
+         ops[op_count++] = (struct nvkmd_rm_sem_op) {
+            .gpu_va = sync->gpu_va,
+            .value = signals[i].signal_value,
+            .release = true,
+         };
+      }
+
+      result = emit_sem_ops(ctx, log_obj, op_count, ops);
+      if (result != VK_SUCCESS)
+         return result;
+   }
+
+   result = nvkmd_rm_exec_ctx_flush(&ctx->base, log_obj);
+   if (result != VK_SUCCESS)
+      return result;
+
+   for (uint32_t i = 0; i < signal_count; i++) {
+      nvkmd_rm_sync_mark_pending(nvkmd_rm_sync(signals[i].sync),
+                                 signals[i].signal_value);
    }
 
-   return nvkmd_rm_exec_ctx_flush(_ctx, log_obj);
+   return VK_SUCCESS;
 }
 
 static VkResult
@@ -614,11 +678,17 @@ nvkmd_rm_bind_ctx_wait(struct nvkmd_ctx *_ctx,
                        uint32_t wait_count,
                        const struct vk_sync_wait *waits)
 {
-   if (wait_count == 0)
-      return VK_SUCCESS;
+   struct nvkmd_rm_dev *dev = nvkmd_rm_dev(_ctx->dev);
+
+   for (uint32_t i = 0; i < wait_count; i++) {
+      struct nvkmd_rm_sync *sync = nvkmd_rm_sync(waits[i].sync);
+      VkResult result = nvkmd_rm_wait_value(dev, sync->value,
+                                            waits[i].wait_value, UINT64_MAX);
+      if (result != VK_SUCCESS)
+         return result;
+   }
 
-   return vk_errorf(log_obj, VK_ERROR_FEATURE_NOT_PRESENT,
-                    "NVK on RM: syncs are not implemented yet");
+   return VK_SUCCESS;
 }
 
 static VkResult
@@ -653,11 +723,14 @@ nvkmd_rm_bind_ctx_signal(struct nvkmd_ctx *_ctx,
                          uint32_t signal_count,
                          const struct vk_sync_signal *signals)
 {
-   if (signal_count == 0)
-      return VK_SUCCESS;
+   for (uint32_t i = 0; i < signal_count; i++) {
+      struct nvkmd_rm_sync *sync = nvkmd_rm_sync(signals[i].sync);
+      nvkmd_rm_sync_mark_pending(sync, signals[i].signal_value);
+      __atomic_thread_fence(__ATOMIC_SEQ_CST);
+      *sync->value = signals[i].signal_value;
+   }
 
-   return vk_errorf(log_obj, VK_ERROR_FEATURE_NOT_PRESENT,
-                    "NVK on RM: syncs are not implemented yet");
+   return VK_SUCCESS;
 }
 
 static VkResult
