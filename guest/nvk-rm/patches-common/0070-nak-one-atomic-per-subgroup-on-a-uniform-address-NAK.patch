From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ole Algoritme <olealgoritme@gmail.com>
Date: Sat, 17 Oct 2026 22:22:50 +0200
Subject: [PATCH] nak: one atomic per subgroup on a uniform address
 (NAK_UNIFORM_ATOMICS)

Run nir_opt_uniform_atomics before subgroup lowering, as the AMD, Intel
and Asahi compilers do.  An atomic whose address is the same in every
active lane of a subgroup is done once by one lane, with a subgroup
reduction of the value (a popcount for a uniform value) and an exclusive
scan to give each lane its own result.

With per-lane atomics, a million lanes decrementing one counter
serialize in L2: two Steel Nomad compute shaders (a counter decrement and
a max on the same address per lane) took 1.8-1.9 ms per dispatch against
54-108 us with the reference compiler, which combines these per warp.

NAK_UNIFORM_ATOMICS=0 turns it off; it is part of nak_knobs_key() (bit 14)
and so of the shader cache keys.
---
 src/nouveau/compiler/nak/knobs.rs  | 18 ++++++++++++++++++
 src/nouveau/compiler/nak_nir.c     |  6 ++++++
 src/nouveau/compiler/nak_private.h |  1 +
 3 files changed, 25 insertions(+)

diff --git a/src/nouveau/compiler/nak/knobs.rs b/src/nouveau/compiler/nak/knobs.rs
index 2475aac..4fbe138 100644
--- a/src/nouveau/compiler/nak/knobs.rs
+++ b/src/nouveau/compiler/nak/knobs.rs
@@ -37,6 +37,10 @@
 //!   that are not coherent, volatile or atomic use the weak memory order
 //!   (L1-cacheable, as in the reference compiler's code) instead of
 //!   .STRONG.GPU (from_nir.rs)
+//! - NAK_UNIFORM_ATOMICS (default on): atomics on an address that is the
+//!   same in every lane of a subgroup are done once per subgroup, with a
+//!   subgroup reduction or scan for the value and the results
+//!   (nir_opt_uniform_atomics, in nak_postprocess_nir)
 //! - NAK_UNROLL_MAX (default 32): most iterations NIR fully unrolls a loop
 //!   with a known trip count; lower values keep more loops rolled, as the
 //!   reference compiler does
@@ -79,6 +83,7 @@ static LAT_MASK: OnceLock<u32> = OnceLock::new();
 static UNROLL_MAX: OnceLock<u32> = OnceLock::new();
 static VEC_CSE: OnceLock<bool> = OnceLock::new();
 static WEAK_MEM: OnceLock<bool> = OnceLock::new();
+static UNIFORM_ATOMICS: OnceLock<bool> = OnceLock::new();
 
 /// NAK_IMM_CSE for a shader: compute shaders unless set
 pub fn imm_cse(compute: bool) -> bool {
@@ -168,6 +173,13 @@ pub fn weak_mem() -> bool {
     *v
 }
 
+pub fn uniform_atomics() -> bool {
+    let v = UNIFORM_ATOMICS.get_or_init(|| {
+        parse("NAK_UNIFORM_ATOMICS", env::var("NAK_UNIFORM_ATOMICS"), true)
+    });
+    *v
+}
+
 pub fn vec_cse() -> bool {
     let v = VEC_CSE
         .get_or_init(|| parse("NAK_VEC_CSE", env::var("NAK_VEC_CSE"), true));
@@ -213,6 +225,11 @@ pub extern "C" fn nak_knob_nir_flatten() -> bool {
     nir_flatten()
 }
 
+#[unsafe(no_mangle)]
+pub extern "C" fn nak_knob_uniform_atomics() -> bool {
+    uniform_atomics()
+}
+
 /// The knobs that do not fit in nak_gpr_cap_key(), for the low 12 bits of
 /// NVK's compiler flags
 #[unsafe(no_mangle)]
@@ -233,4 +250,5 @@ pub extern "C" fn nak_knobs_key() -> u32 {
         | (unroll << 9)
         | (u32::from(vec_cse()) << 12)
         | (u32::from(weak_mem()) << 13)
+        | (u32::from(uniform_atomics()) << 14)
 }
diff --git a/src/nouveau/compiler/nak_nir.c b/src/nouveau/compiler/nak_nir.c
index ef67ac5..1a35137 100644
--- a/src/nouveau/compiler/nak_nir.c
+++ b/src/nouveau/compiler/nak_nir.c
@@ -1661,6 +1661,12 @@ nak_postprocess_nir(nir_shader *nir,
       .lower_inverse_ballot = true,
       .lower_rotate_to_shuffle = true
    };
+   /* One atomic per subgroup for atomics on a subgroup-uniform address, as
+    * the other Mesa compilers do: with a million lanes adding to the same
+    * counter, per-lane atomics serialize in L2 (NAK_UNIFORM_ATOMICS).
+    */
+   if (nak_knob_uniform_atomics())
+      OPT(nir, nir_opt_uniform_atomics, false);
    OPT(nir, nir_opt_uniform_subgroup, &subgroups_options);
    OPT(nir, nir_lower_subgroups, &subgroups_options);
    OPT(nir, nak_nir_lower_f16vec4_atomics, nak);
diff --git a/src/nouveau/compiler/nak_private.h b/src/nouveau/compiler/nak_private.h
index 1be8c64..82b7618 100644
--- a/src/nouveau/compiler/nak_private.h
+++ b/src/nouveau/compiler/nak_private.h
@@ -18,6 +18,7 @@ bool nak_should_print_nir(void);
 bool nak_debug_no_ugpr(void);
 bool nak_knob_uaddr_pin(void);
 bool nak_knob_nir_flatten(void);
+bool nak_knob_uniform_atomics(void);
 
 struct nak_compiler {
    uint8_t sm;
-- 
2.43.0

