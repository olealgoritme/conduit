+++ b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm.h
@@ -324,7 +324,8 @@ struct nvkmd_rm_dev {
     */
    bool sysmem_cached_desc;
    bool sysmem_cached_app;
-   /* NVK_RM_DESC_TABLE_VRAM / NVK_RM_UPLOAD_VRAM (default on): descriptor
+   /* NVK_RM_DESC_TABLE_VRAM=1 / NVK_RM_UPLOAD_VRAM=1 (default off: in CS2
