+#endif
 
 #include "cla097.h"
 #include "clb097.h"
@@ -683,9 +692,110 @@ nvk_shader_get_shader_size(struct nvk_device *dev, struct nvk_shader *shader,
    return total_size;
 }
 
+/* NVK_SHADER_STATS=1: one line per shader uploaded (compiled or loaded
+ * from the cache) with NAK's statistics, to NVK_SHADER_STATS_FILE, else on
+ * Windows %ProgramData%\Helios\nvk-shaders-<pid>.txt (then %TEMP%), else
+ * stderr.  The hash is of the shader code, so the same shader is the same
+ * line across runs.  Diagnostics only; off by default.
+ */
+static FILE *
+nvk_shader_stats_file(void)
+{
+   static simple_mtx_t init_mtx = SIMPLE_MTX_INITIALIZER;
+   static FILE *file;
+   static bool done;
+
+   simple_mtx_lock(&init_mtx);
+   if (!done) {
+      done = true;
+      if (debug_get_bool_option("NVK_SHADER_STATS", false)) {
+         const char *path = os_get_option("NVK_SHADER_STATS_FILE");
+         if (path != NULL && path[0] != 0)
+            file = fopen(path, "a");
+#ifdef _WIN32
+         char buf[MAX_PATH];
+         if (file == NULL) {
+            char pd[MAX_PATH];
+            DWORD n = GetEnvironmentVariableA("ProgramData", pd, sizeof(pd));
+            snprintf(buf, sizeof(buf), "%s\\Helios",
+                     n > 0 && n < sizeof(pd) ? pd : "C:\\ProgramData");
+            CreateDirectoryA(buf, NULL);
+            snprintf(buf + strlen(buf), sizeof(buf) - strlen(buf),
+                     "\\nvk-shaders-%lu.txt",
+                     (unsigned long)GetCurrentProcessId());
+            file = fopen(buf, "a");
+         }
+         if (file == NULL) {
+            char tmp[MAX_PATH];
+            DWORD n = GetTempPathA(sizeof(tmp), tmp);
+            if (n > 0 && n < sizeof(tmp)) {
+               snprintf(buf, sizeof(buf), "%snvk-shaders-%lu.txt", tmp,
+                        (unsigned long)GetCurrentProcessId());
+               file = fopen(buf, "a");
+            }
+         }
+#endif
+         if (file == NULL)
+            file = stderr;
+         fprintf(file, "NVK shader stats: stage hash code_B instrs gprs "
+                 "max_warps static_cycles spills_mem fills_mem spills_reg "
+                 "fills_reg slm_B crs_B [stage details]\n");
+         fflush(file);
+      }
+   }
+   simple_mtx_unlock(&init_mtx);
+   return file;
+}
+
+static void
+nvk_shader_log_stats(const struct nvk_shader *shader)
+{
+   FILE *f = nvk_shader_stats_file();
+   if (likely(f == NULL))
+      return;
+
+   const struct nak_shader_info *i = &shader->info;
+   char extra[128] = "";
+   switch (i->stage) {
+   case MESA_SHADER_VERTEX:
+   case MESA_SHADER_TESS_EVAL:
+   case MESA_SHADER_GEOMETRY:
+      snprintf(extra, sizeof(extra), " clip 0x%x cull 0x%x layer %d",
+               i->vtg.clip_enable, i->vtg.cull_enable, i->vtg.writes_layer);
+      break;
+   case MESA_SHADER_FRAGMENT:
+      snprintf(extra, sizeof(extra), " writes_depth %d early_z %d "
+               "sample_shading %d", i->fs.writes_depth,
+               i->fs.early_fragment_tests, i->fs.uses_sample_shading);
+      break;
+   case MESA_SHADER_COMPUTE:
+      snprintf(extra, sizeof(extra), " local %ux%ux%u smem %u",
+               i->cs.local_size[0], i->cs.local_size[1], i->cs.local_size[2],
+               i->cs.smem_size);
+      break;
+   default:
+      break;
+   }
+
+   const uint32_t hash = shader->code_size > 0 ?
+      _mesa_hash_data(shader->code_ptr, shader->code_size) : 0;
+   static simple_mtx_t mtx = SIMPLE_MTX_INITIALIZER;
+   simple_mtx_lock(&mtx);
+   fprintf(f, "NVK shader stats: %s %08x %u %u %u %u %" PRIu64 " %u %u %u "
+           "%u %u %u%s\n", mesa_shader_stage_name(i->stage), hash,
+           shader->code_size, i->num_instrs, i->num_gprs, i->max_warps_per_sm,
+           i->num_static_cycles, i->num_spills_to_mem, i->num_fills_from_mem,
+           i->num_spills_to_reg, i->num_fills_from_reg, i->slm_size,
+           i->crs_size, extra);
+   fflush(f);
+   simple_mtx_unlock(&mtx);
+}
+
 static VkResult
 nvk_shader_upload(struct nvk_device *dev, struct nvk_shader *shader)
 {
+   nvk_shader_log_stats(shader);
+
    const struct nvk_physical_device *pdev = nvk_device_physical(dev);
 
    const bool has_mesh_gs_sph = shader->info.stage == MESA_SHADER_MESH &&
diff --git a/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm.h b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm.h
