          l += snprintf(line + l, sizeof(line) - l, " %s %.0f",
                        prof_stats[i].name, s->stats[i] / sn);
       prof_log(prof, "NVK pass profile:            per pass:%s", line);
@@ -918,9 +960,18 @@ prof_harvest_and_log(struct nvk_pass_profile *prof, bool final)
       ps->ind_draws += m->counts.ind_draws;
       ps->queries += m->counts.queries;
       ps->barriers += m->counts.barriers;
+      ps->fs_calls += m->counts.fs_calls;
+      ps->tess_gs_calls += m->counts.tess_gs_calls;
+      ps->vs_gprs = MAX2(ps->vs_gprs, m->counts.vs_gprs);
+      ps->vs_instrs = MAX2(ps->vs_instrs, m->counts.vs_instrs);
+      ps->vs_cycles = MAX2(ps->vs_cycles, m->counts.vs_cycles);
+      ps->fs_gprs = MAX2(ps->fs_gprs, m->counts.fs_gprs);
+      ps->fs_instrs = MAX2(ps->fs_instrs, m->counts.fs_instrs);
+      ps->spills = MAX2(ps->spills, m->counts.spills);
+      ps->slm = MAX2(ps->slm, m->counts.slm);
       if (m->stat != 0 && prof->stat_gpu != NULL) {
          volatile struct prof_stat_gpu *st = &prof->stat_gpu[m->stat - 1];
-         for (unsigned k = 0; k < PROF_STATS; k++) {
+         for (unsigned k = 0; k < prof_stat_count(prof->level); k++) {
             uint64_t b, e;
             if (prof_stats[k].counter32) {
                b = st->begin[k].payload;
@@ -1010,6 +1061,9 @@ prof_harvest_and_log(struct nvk_pass_profile *prof, bool final)
          s->count = 0;
          s->calls = s->draws = s->ind_calls = s->ind_draws = 0;
          s->queries = s->barriers = 0;
