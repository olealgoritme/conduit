    cmd->pass_profile_op_slot = -1;
@@ -821,6 +846,15 @@ prof_counts_add(struct nvk_pass_profile_counts *dst,
    dst->ind_draws += src->ind_draws;
    dst->queries += src->queries;
    dst->barriers += src->barriers;
+   dst->vs_gprs = MAX2(dst->vs_gprs, src->vs_gprs);
+   dst->vs_instrs = MAX2(dst->vs_instrs, src->vs_instrs);
+   dst->vs_cycles = MAX2(dst->vs_cycles, src->vs_cycles);
+   dst->fs_gprs = MAX2(dst->fs_gprs, src->fs_gprs);
+   dst->fs_instrs = MAX2(dst->fs_instrs, src->fs_instrs);
+   dst->spills = MAX2(dst->spills, src->spills);
