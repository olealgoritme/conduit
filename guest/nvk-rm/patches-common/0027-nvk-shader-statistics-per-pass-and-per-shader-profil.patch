+ * rejects the report (405.8: Xid 69, SET_REPORT_SEMAPHORE_D data
+ * 0x0280f002).  The ZCULL counters only with NVK_PASS_PROFILE=3.
+ */
+#define PROF_STATS_BASIC 4
 static const struct {
    uint32_t report;
+   uint32_t loc;
    const char *name;
    bool counter32;
 } prof_stats[PROF_STATS] = {
-   { NV9097_SET_REPORT_SEMAPHORE_D_REPORT_VS_INVOCATIONS, "vs", false },
-   { NV9097_SET_REPORT_SEMAPHORE_D_REPORT_CLIPPER_INVOCATIONS, "prims-in", false },
-   { NV9097_SET_REPORT_SEMAPHORE_D_REPORT_CLIPPER_PRIMITIVES_GENERATED, "prims-out", false },
-   { NV9097_SET_REPORT_SEMAPHORE_D_REPORT_PS_INVOCATIONS, "ps", false },
-   { NV9097_SET_REPORT_SEMAPHORE_D_REPORT_ZCULL_STATS0, "zc0", true },
-   { NV9097_SET_REPORT_SEMAPHORE_D_REPORT_ZCULL_STATS1, "zc1", true },
-   { NV9097_SET_REPORT_SEMAPHORE_D_REPORT_ZCULL_STATS2, "zc2", true },
