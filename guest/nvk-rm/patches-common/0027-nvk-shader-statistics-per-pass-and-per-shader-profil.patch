+     NV9097_SET_REPORT_SEMAPHORE_D_PIPELINE_LOCATION_ZCULL, "zc2", true },
+   { NV9097_SET_REPORT_SEMAPHORE_D_REPORT_ZCULL_STATS3,
+     NV9097_SET_REPORT_SEMAPHORE_D_PIPELINE_LOCATION_ZCULL, "zc3", true },
 };
 
+static unsigned
+prof_stat_count(unsigned level)
+{
+   return level >= 3 ? PROF_STATS : PROF_STATS_BASIC;
+}
+
 struct prof_stat_gpu {
    struct prof_report begin[PROF_STATS];
    struct prof_report end[PROF_STATS];
@@ -151,6 +172,8 @@ struct prof_sig {
    uint64_t gpu_ns;
    uint64_t count;
    uint64_t calls, draws, ind_calls, ind_draws, queries, barriers;
+   uint64_t fs_calls, tess_gs_calls;
+   uint32_t vs_gprs, vs_instrs, vs_cycles, fs_gprs, fs_instrs, spills, slm;
    uint64_t stat_count;
    uint64_t stats[PROF_STATS];
 };
@@ -570,9 +593,9 @@ prof_emit_stats(struct nvk_cmd_buffer *cmd, uint32_t stat, bool end)
                          stat * sizeof(struct prof_stat_gpu) +
                          (end ? offsetof(struct prof_stat_gpu, end) : 0);
 
-   struct nv_push *p = nvk_cmd_buffer_push(cmd, 2 + PROF_STATS * 5);
-   P_IMMD(p, NV9097, FLUSH_PENDING_WRITES, 0);
-   for (unsigned i = 0; i < PROF_STATS; i++) {
+   const unsigned n = prof_stat_count(prof->level);
+   struct nv_push *p = nvk_cmd_buffer_push(cmd, n * 5);
+   for (unsigned i = 0; i < n; i++) {
       const uint64_t addr = base + i * sizeof(struct prof_report);
       P_MTHD(p, NV9097, SET_REPORT_SEMAPHORE_A);
       P_NV9097_SET_REPORT_SEMAPHORE_A(p, addr >> 32);
@@ -580,9 +603,10 @@ prof_emit_stats(struct nvk_cmd_buffer *cmd, uint32_t stat, bool end)
       P_NV9097_SET_REPORT_SEMAPHORE_C(p, 0);
       P_NV9097_SET_REPORT_SEMAPHORE_D(p, {
          .operation = OPERATION_REPORT_ONLY,
-         .pipeline_location = PIPELINE_LOCATION_ALL,
+         .pipeline_location = prof_stats[i].loc,
          .report = prof_stats[i].report,
          .structure_size = STRUCTURE_SIZE_FOUR_WORDS,
