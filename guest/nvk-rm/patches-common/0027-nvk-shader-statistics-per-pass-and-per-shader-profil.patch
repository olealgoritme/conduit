@@ -882,11 +916,19 @@ prof_log_sig(struct nvk_pass_profile *prof, const struct prof_sig *s,
    prof_log(prof, "NVK pass profile: %8.2f GPU ms/s %8.1f us each %6" PRIu64
             "x%s  %s", s->gpu_ns / 1e6 / window_s, s->gpu_ns / 1e3 / n,
             s->count, extra, s->name);
+   if (s->kind == PROF_KIND_PASS && s->calls > 0) {
+      prof_log(prof, "NVK pass profile:            shaders: vs<=%u gprs "
+               "%u instrs %u cycles, fs<=%u gprs %u instrs in %.1f calls, "
+               "%.1f calls with tess/gs, spills+fills<=%u, slm<=%u B",
