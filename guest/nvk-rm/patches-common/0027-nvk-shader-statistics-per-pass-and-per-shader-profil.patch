+   { NV9097_SET_REPORT_SEMAPHORE_D_REPORT_VS_INVOCATIONS,
+     NV9097_SET_REPORT_SEMAPHORE_D_PIPELINE_LOCATION_VERTEX_SHADER, "vs", false },
+   { NV9097_SET_REPORT_SEMAPHORE_D_REPORT_CLIPPER_INVOCATIONS,
+     NV9097_SET_REPORT_SEMAPHORE_D_PIPELINE_LOCATION_VPC, "prims-in", false },
+   { NV9097_SET_REPORT_SEMAPHORE_D_REPORT_CLIPPER_PRIMITIVES_GENERATED,
+     NV9097_SET_REPORT_SEMAPHORE_D_PIPELINE_LOCATION_VPC, "prims-out", false },
+   { NV9097_SET_REPORT_SEMAPHORE_D_REPORT_PS_INVOCATIONS,
