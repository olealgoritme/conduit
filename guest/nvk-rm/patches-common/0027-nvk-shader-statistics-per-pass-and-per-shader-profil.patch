+     NV9097_SET_REPORT_SEMAPHORE_D_PIPELINE_LOCATION_ZCULL, "zc0", true },
+   { NV9097_SET_REPORT_SEMAPHORE_D_REPORT_ZCULL_STATS1,
+     NV9097_SET_REPORT_SEMAPHORE_D_PIPELINE_LOCATION_ZCULL, "zc1", true },
