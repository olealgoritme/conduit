From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ole Algoritme <olealgoritme@gmail.com>
Date: Fri, 9 Oct 2026 01:54:07 +0200
Subject: [PATCH] nvk: shader statistics per pass and per shader, profile
 counters fixed

Diagnostics for CS2's depth prepass (4.6-8.6 ms) and shadow pass (~3 ms)
on GB20x, plus one default change.  No MME macro is added or changed:
the macros still take 2976 dwords on BLACKWELL_A, as in 405.8 (405.9's
3303 overflowed the MME instruction RAM).

- NVK_PASS_PROFILE: each render pass line is followed by the shaders its
  draws used: the largest vertex shader's GPRs, instructions and static
  cycles, the largest fragment shader's GPRs and instructions, draw calls
  with a fragment shader and with tessellation or a geometry shader, and
  the most spills plus fills to memory and local memory (SLM) of any
  stage.  Counted only when the profile is on.
- NVK_PASS_PROFILE=2: the vertex shader, clipper and fragment shader
  invocation counters per pass are reported at their own pipeline
  locations, as NVK's pipeline statistics queries do.  At location ALL
  the 3D class rejected them (405.8: Xid 69, SET_REPORT_SEMAPHORE_D data
  0x0280f002).  The ZCULL counters only with NVK_PASS_PROFILE=3.
- NVK_SHADER_STATS=1: one line per shader uploaded (compiled or from the
  disk cache): stage, code hash, size, instructions, GPRs, max warps per
  SM, static cycles, spills and fills to memory and between register
  files, SLM and CRS size, and per stage clip/cull/layer, depth writes,
  early-Z and sample shading, or the workgroup.  To
  NVK_SHADER_STATS_FILE, else %ProgramData%\Helios\nvk-shaders-<pid>.txt
  on Windows.
- NVK_RM_DESC_TABLE_VRAM and NVK_RM_UPLOAD_VRAM default to 0: in CS2 on
  405.11 descriptor and upload memory in BAR VRAM ran about 10 fps slower
  than in GPU-cached system memory (32.7/37.6 against 43.8/47.8 fps).
  =1 keeps them for A/B.
---
 src/nouveau/vulkan/nvk_cmd_buffer.h        |  39 ++++++++
 src/nouveau/vulkan/nvk_pass_profile.c      |  82 ++++++++++++---
 src/nouveau/vulkan/nvk_pass_profile.h      |  14 +++
 src/nouveau/vulkan/nvk_shader.c            | 110 +++++++++++++++++++++
 src/nouveau/vulkan/nvkmd/rm/nvkmd_rm.h     |   3 +-
 src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_dev.c |   4 +-
 6 files changed, 235 insertions(+), 17 deletions(-)

diff --git a/src/nouveau/vulkan/nvk_cmd_buffer.h b/src/nouveau/vulkan/nvk_cmd_buffer.h
index cb8d6f65..0387c4f9 100644
--- a/src/nouveau/vulkan/nvk_cmd_buffer.h
+++ b/src/nouveau/vulkan/nvk_cmd_buffer.h
@@ -352,6 +352,7 @@ struct nvk_cmd_buffer {
    uint64_t pass_profile_op_groups;
    uint32_t pass_profile_internal;
    bool pass_profile_in_pass;
+   bool pass_profile_on;
    struct nvk_pass_profile_counts pass_profile_pass_counts;
    struct nvk_pass_profile_counts pass_profile_op_counts;
    struct nvk_pass_profile_counts pass_profile_cmd_counts;
@@ -527,6 +528,44 @@ nvk_cmd_profile_count_draws(struct nvk_cmd_buffer *cmd, uint32_t draws,
          c[i]->ind_draws += draws;
       }
    }
+
+   if (likely(!cmd->pass_profile_on))
+      return;
+
+   uint32_t vs_gprs = 0, vs_instrs = 0, vs_cycles = 0, fs_gprs = 0;
+   uint32_t fs_instrs = 0, spills = 0, slm = 0;
+   bool fs = false, tess_gs = false;
+   for (unsigned s = 0; s < ARRAY_SIZE(cmd->state.gfx.shaders); s++) {
+      const struct nvk_shader *sh = cmd->state.gfx.shaders[s];
+      if (sh == NULL)
+         continue;
+      const struct nak_shader_info *info = &sh->info;
+      spills = MAX2(spills, info->num_spills_to_mem + info->num_fills_from_mem);
+      slm = MAX2(slm, info->slm_size);
+      if (s == MESA_SHADER_VERTEX) {
+         vs_gprs = info->num_gprs;
+         vs_instrs = info->num_instrs;
+         vs_cycles = MIN2(info->num_static_cycles, UINT32_MAX);
+      } else if (s == MESA_SHADER_FRAGMENT) {
+         fs = true;
+         fs_gprs = info->num_gprs;
+         fs_instrs = info->num_instrs;
+      } else if (s == MESA_SHADER_TESS_CTRL || s == MESA_SHADER_TESS_EVAL ||
+                 s == MESA_SHADER_GEOMETRY) {
+         tess_gs = true;
+      }
+   }
+   for (unsigned i = 0; i < 3; i++) {
+      c[i]->vs_gprs = MAX2(c[i]->vs_gprs, vs_gprs);
+      c[i]->vs_instrs = MAX2(c[i]->vs_instrs, vs_instrs);
+      c[i]->vs_cycles = MAX2(c[i]->vs_cycles, vs_cycles);
+      c[i]->fs_gprs = MAX2(c[i]->fs_gprs, fs_gprs);
+      c[i]->fs_instrs = MAX2(c[i]->fs_instrs, fs_instrs);
+      c[i]->spills = MAX2(c[i]->spills, spills);
+      c[i]->slm = MAX2(c[i]->slm, slm);
+      c[i]->fs_calls += fs;
+      c[i]->tess_gs_calls += tess_gs;
+   }
 }
 
 static inline void
diff --git a/src/nouveau/vulkan/nvk_pass_profile.c b/src/nouveau/vulkan/nvk_pass_profile.c
