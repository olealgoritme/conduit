+
+/// NAK_UNROLL_DYN (0 or 2-8, default 0): innermost loops whose trip count
+/// is only known at run time run that many iterations per pass of the loop
+/// (a guarded straight-line copy of the body; nak_nir_unroll_dyn.c).  A
+/// shader it changed is also compiled without it, and the unrolled variant
+/// is kept unless it has fewer warps per SM (api.rs)
+pub fn unroll_dyn() -> u32 {
+    *UNROLL_DYN.get_or_init(|| {
+        let v = parse_u32("NAK_UNROLL_DYN", 0, 8);
+        if v == 1 { 0 } else { v }
+    })
+}
+
+pub fn set_unroll_dyn_active(on: bool) {
+    UNROLL_ACTIVE.with(|c| c.set(on));
+    UNROLL_PROGRESS.with(|c| c.set(false));
+}
+
+pub fn unroll_dyn_progress() -> bool {
+    UNROLL_PROGRESS.with(|c| c.get())
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn nak_unroll_dyn_active() -> u32 {
+    if UNROLL_ACTIVE.with(|c| c.get()) { unroll_dyn() } else { 0 }
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn nak_unroll_dyn_note_progress() {
+    UNROLL_PROGRESS.with(|c| c.set(true));
+}
+
 pub fn set_uniform_hoist_active(on: bool) {
