diff --git a/src/nouveau/compiler/nak_nir_unroll_dyn.c b/src/nouveau/compiler/nak_nir_unroll_dyn.c
new file mode 100644
index 0000000..317d5e6
--- /dev/null
+++ b/src/nouveau/compiler/nak_nir_unroll_dyn.c
@@ -0,0 +1,373 @@
+/*
+ * Copyright © 2026 Conduit contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "nak_private.h"
+#include "nir_builder.h"
+#include "util/hash_table.h"
+
+/*
+ * NAK_UNROLL_DYN=N: unroll innermost loops whose trip count is only known at
+ * run time N times, as the reference compiler does (88825d04's lighting
+ * loop: 8 iterations per pass of the loop, a remainder after).  A loop of
+ * the shape
+ *
+ *    loop {
+ *       i = phi(i0, i + 1), ...
+ *       body                       (one block, straight-line)
+ *       if (i + off == n)  break;  (or i + off >= n, signed or unsigned)
+ *    }
+ *
+ * with n defined before the loop becomes
+ *
+ *    loop {
+ *       i = phi(...), ...
+ *       if (none of the next N - 1 iterations ends the loop) {
+ *          body (i); body (i + 1); ... body (i + N - 1)
+ *       } else {
+ *          body (i)
+ *       }
+ *       if (the last body's exit test)  break;
+ *    }
+ *
+ * Every iteration runs exactly as before and in the same order; the N
+ * copies are one block, so the schedulers can interleave their dependency
+ * chains (MUFU, texture and memory latencies), and the loop branch is taken
+ * once per N iterations.  Bodies are limited to ALU instructions and loads
+ * that can be reordered: no stores, barriers, subgroup operations or
+ * derivatives, whose behaviour could depend on how iterations are grouped
+ * when the guard is divergent.
+ */
+
+#define MAX_BODY_INSTRS 64
+
+
+static bool
+instr_ok(nir_instr *instr)
+{
+   switch (instr->type) {
+   case nir_instr_type_alu:
+   case nir_instr_type_load_const:
+   case nir_instr_type_undef:
+      return true;
+   case nir_instr_type_intrinsic: {
+      nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+      const nir_intrinsic_info *info = &nir_intrinsic_infos[intr->intrinsic];
+      if (!(info->flags & NIR_INTRINSIC_CAN_REORDER) ||
+          !(info->flags & NIR_INTRINSIC_CAN_ELIMINATE))
+         return false;
+      /* No subgroup or derivative operations */
+      switch (intr->intrinsic) {
+      case nir_intrinsic_ldc_nv:
+      case nir_intrinsic_ldcx_nv:
+      case nir_intrinsic_load_ubo:
+      case nir_intrinsic_load_global_nv:
+      case nir_intrinsic_load_global_constant:
+         return true;
+      default:
+         return false;
+      }
+   }
+   default:
+      return false;
+   }
+}
+
+/* i + off, with off 0 or 1, where i is a header phi stepping by 1 */
+static bool
+match_induction(nir_block *header, nir_def *a, nir_phi_instr **phi_out,
+                unsigned *off_out)
+{
+   unsigned off = 0;
+   nir_def *i = a;
+   if (nir_def_instr_type(a) == nir_instr_type_alu) {
+      nir_alu_instr *alu = nir_def_as_alu(a);
+      if (alu->op == nir_op_iadd && alu->def.num_components == 1) {
+         for (unsigned s = 0; s < 2; s++) {
+            if (nir_src_is_const(alu->src[1 - s].src) &&
+                nir_alu_src_as_uint(alu->src[1 - s]) == 1 &&
+                alu->src[s].swizzle[0] == 0 &&
+                nir_def_instr_type(alu->src[s].src.ssa) == nir_instr_type_phi) {
+               i = alu->src[s].src.ssa;
+               off = 1;
+               break;
+            }
+         }
+      }
+   }
+   if (nir_def_instr_type(i) != nir_instr_type_phi ||
+       nir_def_block(i) != header || i->bit_size != 32)
+      return false;
+
+   nir_phi_instr *phi = nir_instr_as_phi(nir_def_instr(i));
+   /* The backedge source is i + 1 */
+   bool step_ok = false;
+   nir_foreach_phi_src(src, phi) {
+      if (src->pred->cf_node.parent == header->cf_node.parent) {
+         nir_def *s = src->src.ssa;
+         if (nir_def_instr_type(s) != nir_instr_type_alu)
+            return false;
+         nir_alu_instr *alu = nir_def_as_alu(s);
+         if (alu->op != nir_op_iadd)
+            return false;
+         for (unsigned k = 0; k < 2; k++) {
+            if (alu->src[k].src.ssa == i && alu->src[k].swizzle[0] == 0 &&
+                nir_src_is_const(alu->src[1 - k].src) &&
+                nir_alu_src_as_uint(alu->src[1 - k]) == 1)
+               step_ok = true;
+         }
+      }
+   }
+   if (!step_ok)
+      return false;
+   *phi_out = phi;
+   *off_out = off;
+   return true;
+}
+
+static bool
+def_outside_loop(nir_def *def, nir_loop *loop)
+{
+   nir_block *b = nir_def_block(def);
+   for (nir_cf_node *n = &b->cf_node; n != NULL; n = n->parent) {
+      if (n == &loop->cf_node)
+         return false;
+   }
+   return true;
+}
+
+struct use_rewrite {
+   nir_src *src;
+   nir_def *orig;
+};
+
+static bool
+unroll_loop(nir_builder *b, nir_loop *loop, unsigned N)
+{
+   if (nir_loop_has_continue_construct(loop))
+      return false;
+
+   /* body: [block H] [if X { break } else { }] [empty block C] */
+   nir_cf_node *n0 = exec_node_data(nir_cf_node,
+                                    exec_list_get_head(&loop->body), node);
+   if (n0->type != nir_cf_node_block)
+      return false;
+   nir_block *H = nir_cf_node_as_block(n0);
+   nir_cf_node *n1 = nir_cf_node_next(n0);
+   if (n1 == NULL || n1->type != nir_cf_node_if)
+      return false;
+   nir_if *X = nir_cf_node_as_if(n1);
+   nir_cf_node *n2 = nir_cf_node_next(n1);
+   if (n2 == NULL || n2->type != nir_cf_node_block ||
+       nir_cf_node_next(n2) != NULL)
+      return false;
+   nir_block *C = nir_cf_node_as_block(n2);
+   if (!exec_list_is_empty(&C->instr_list))
+      return false;
+   if (!exec_list_is_singular(&X->then_list) ||
+       !exec_list_is_singular(&X->else_list))
+      return false;
+   nir_block *T = nir_if_first_then_block(X);
+   nir_block *E = nir_if_first_else_block(X);
+   if (!nir_block_ends_in_break(T) || exec_list_length(&T->instr_list) != 1 ||
+       !exec_list_is_empty(&E->instr_list))
+      return false;
+
+   /* The exit test */
+   nir_def *c = X->condition.ssa;
+   if (nir_def_block(c) != H ||
+       nir_def_instr_type(c) != nir_instr_type_alu)
+      return false;
+   nir_alu_instr *cmp = nir_def_as_alu(c);
+   if (cmp->def.num_components != 1)
+      return false;
+   nir_op op = cmp->op;
+   unsigned ai = 0, ni = 1;
+   if (op == nir_op_ieq) {
+      if (def_outside_loop(cmp->src[0].src.ssa, loop)) {
+         ai = 1;
+         ni = 0;
+      }
+   } else if (op != nir_op_ige && op != nir_op_uge) {
+      return false;
+   }
+   nir_def *a = cmp->src[ai].src.ssa;
+   nir_def *n = cmp->src[ni].src.ssa;
+   const unsigned n_comp = cmp->src[ni].swizzle[0];
+   if (cmp->src[ai].swizzle[0] != 0 || a->num_components != 1 ||
+       a->bit_size != 32 || n->bit_size != 32 || !def_outside_loop(n, loop))
+      return false;
+
+   nir_phi_instr *iphi;
+   unsigned off;
+   if (!match_induction(H, a, &iphi, &off))
+      return false;
+
+   /* The body: everything in H but the phis */
+   nir_instr *body[MAX_BODY_INSTRS];
+   unsigned nbody = 0;
+   nir_foreach_instr(instr, H) {
+      if (instr->type == nir_instr_type_phi)
+         continue;
+      if (nbody == MAX_BODY_INSTRS || !instr_ok(instr))
+         return false;
+      body[nbody++] = instr;
+   }
+   if (nbody == 0)
+      return false;
+
+   /* Uses of body values outside the body (the exit test, the backedge
+    * phi sources, code after the loop) are rewritten to phis after the new
+    * if; collect them before the copies exist
+    */
+   struct set *body_set = _mesa_pointer_set_create(NULL);
+   for (unsigned k = 0; k < nbody; k++)
+      _mesa_set_add(body_set, body[k]);
+   struct use_rewrite *rw = NULL;
+   unsigned nrw = 0, rw_cap = 0;
+   for (unsigned k = 0; k < nbody; k++) {
+      nir_def *def = nir_instr_def(body[k]);
+      if (def == NULL)
+         continue;
+      nir_foreach_use_including_if(src, def) {
+         if (!nir_src_is_if(src) &&
+             _mesa_set_search(body_set, nir_src_use_instr(src)))
+            continue;
+         if (nrw == rw_cap) {
+            rw_cap = MAX2(16, rw_cap * 2);
+            rw = realloc(rw, rw_cap * sizeof(*rw));
+         }
+         rw[nrw++] = (struct use_rewrite){ src, def };
+      }
+   }
+
+   /* The guard: none of the first N - 1 iterations of this pass ends the
+    * loop
+    */
+   b->cursor = nir_after_block(H);
+   nir_def *base = off ? nir_iadd_imm(b, &iphi->def, 1) : &iphi->def;
+   n = nir_channel(b, n, n_comp);
+   nir_def *dist = nir_isub(b, n, base);
+   nir_def *guard;
+   if (op == nir_op_ieq) {
+      guard = nir_uge_imm(b, dist, N - 1);
+   } else if (op == nir_op_ige) {
+      guard = nir_iand(b, nir_ilt(b, base, n),
+                       nir_igt_imm(b, dist, N - 2));
+   } else {
+      guard = nir_iand(b, nir_ult(b, base, n),
+                       nir_ugt_imm(b, dist, N - 2));
+   }
+
+   /* The backedge source of every header phi */
+   struct hash_table *backedge = _mesa_pointer_hash_table_create(NULL);
+   nir_foreach_phi(phi, H) {
+      nir_foreach_phi_src(src, phi) {
+         if (src->pred == C)
+            _mesa_hash_table_insert(backedge, phi, src->src.ssa);
+      }
+   }
+
+   nir_if *nif = nir_push_if(b, guard);
+
+   /* N copies: copy k + 1 starts from copy k's backedge values */
+   struct hash_table *remap = _mesa_pointer_hash_table_create(NULL);
+   for (unsigned copy = 0; copy < N; copy++) {
+      struct hash_table *next = _mesa_pointer_hash_table_create(NULL);
+      if (copy > 0) {
+         nir_foreach_phi(phi, H) {
+            struct hash_entry *be = _mesa_hash_table_search(backedge, phi);
+            if (be == NULL)
+               continue;
+            nir_def *v = be->data;
+            struct hash_entry *m = _mesa_hash_table_search(remap, v);
+            _mesa_hash_table_insert(next, &phi->def, m ? m->data : v);
+         }
+      }
+      _mesa_hash_table_clear(remap, NULL);
+      hash_table_foreach(next, e)
+         _mesa_hash_table_insert(remap, e->key, e->data);
+      _mesa_hash_table_destroy(next, NULL);
+
+      for (unsigned k = 0; k < nbody; k++) {
+         nir_instr *clone = nir_instr_clone_deep(b->shader, body[k], remap);
+         nir_builder_instr_insert(b, clone);
+      }
+   }
+
+   nir_push_else(b, nif);
+   for (unsigned k = 0; k < nbody; k++) {
+      nir_instr_move(b->cursor, body[k]);
+      b->cursor = nir_after_instr(body[k]);
+   }
+   nir_pop_if(b, nif);
+
+   /* Phis for the body values used outside it */
+   struct hash_table *merged = _mesa_pointer_hash_table_create(NULL);
+   for (unsigned r = 0; r < nrw; r++) {
+      nir_def *orig = rw[r].orig;
+      struct hash_entry *m = _mesa_hash_table_search(merged, orig);
+      nir_def *phi_def;
+      if (m) {
+         phi_def = m->data;
+      } else {
+         struct hash_entry *cm = _mesa_hash_table_search(remap, orig);
+         assert(cm != NULL);
+         phi_def = nir_if_phi(b, cm->data, orig);
+         _mesa_hash_table_insert(merged, orig, phi_def);
+      }
+      nir_src_rewrite(rw[r].src, phi_def);
+   }
+
+   free(rw);
+   _mesa_set_destroy(body_set, NULL);
+   _mesa_hash_table_destroy(backedge, NULL);
+   _mesa_hash_table_destroy(remap, NULL);
+   _mesa_hash_table_destroy(merged, NULL);
+   return true;
+}
+
+static bool
+unroll_cf_list(nir_builder *b, struct exec_list *list, unsigned N)
+{
+   bool progress = false;
+   foreach_list_typed_safe(nir_cf_node, node, node, list) {
+      switch (node->type) {
+      case nir_cf_node_block:
+         break;
+      case nir_cf_node_if: {
+         nir_if *nif = nir_cf_node_as_if(node);
+         progress |= unroll_cf_list(b, &nif->then_list, N);
+         progress |= unroll_cf_list(b, &nif->else_list, N);
+         break;
+      }
+      case nir_cf_node_loop: {
+         nir_loop *loop = nir_cf_node_as_loop(node);
+         bool inner = unroll_cf_list(b, &loop->body, N);
+         progress |= inner;
+         if (!inner && unroll_loop(b, loop, N))
+            progress = true;
+         break;
+      }
+      default:
+         UNREACHABLE("Unknown CF node type");
+      }
+   }
+   return progress;
+}
+
+bool
+nak_nir_unroll_dyn(nir_shader *nir, unsigned N)
+{
+   if (N < 2)
+      return false;
+
+   bool progress = false;
+   nir_foreach_function_impl(impl, nir) {
+      nir_builder b = nir_builder_create(impl);
+      bool p = unroll_cf_list(&b, &impl->body, N);
+      progress |= nir_progress(p, impl, nir_metadata_none);
+   }
+   return progress;
+}
