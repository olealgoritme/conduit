@@ -5658,7 +5815,8 @@ nvk_cmd_draw_indirect_batched(struct nvk_cmd_buffer *cmd, bool indexed,
                               uint64_t stride)
 {
    const uint32_t batch = nvk_mdi_batch();
-   if (batch < 2 || draw_count < 2 || nvk_cmd_buffer_3d_cls(cmd) < TURING_A)
+   if (!nvk_mdi_batch_active() || draw_count < 2 ||
+       nvk_cmd_buffer_3d_cls(cmd) < TURING_A)
       return false;
 
    const uint32_t rec_dw = indexed ? 5 : 4;
@@ -5720,7 +5878,10 @@ nvk_CmdDrawIndirect2KHR(VkCommandBuffer commandBuffer,
    nvk_cmd_profile_count_draws(cmd, pInfo->drawCount, true);
    nvk_cmd_draw_params_unknown(cmd);
 
-   if (nvk_cmd_draw_indirect_batched(cmd, false, pInfo->addressRange.address,
+   if (nvk_cmd_draw_indirect_pushed(cmd, false, pInfo->addressRange.address,
+                                    pInfo->drawCount, stride)) {
+      /* NVK_INDIRECT_PUSH */
+   } else if (nvk_cmd_draw_indirect_batched(cmd, false, pInfo->addressRange.address,
                                      pInfo->drawCount, stride)) {
       /* NVK_MDI_BATCH */
    } else if (nvk_cmd_buffer_3d_cls(cmd) >= TURING_A) {
@@ -5768,6 +5929,10 @@ nvk_CmdDrawIndirect2KHR(VkCommandBuffer commandBuffer,
 void
 nvk_mme_draw_indexed_indirect(struct mme_builder *b)
 {
+   /* Unused with NVK_INDIRECT_PUSH (see nvk_mme_draw_indirect()) */
+   if (b->devinfo->cls_eng3d >= TURING_A && nvk_indirect_push())
+      return;
+
    if (b->devinfo->cls_eng3d >= TURING_A) {
       struct mme_value64 draw_addr = mme_load_addr64(b);
       struct mme_value draw_count = mme_load(b);
@@ -5833,7 +5998,10 @@ nvk_CmdDrawIndexedIndirect2KHR(VkCommandBuffer commandBuffer,
    nvk_cmd_profile_count_draws(cmd, pInfo->drawCount, true);
    nvk_cmd_draw_params_unknown(cmd);
 
-   if (nvk_cmd_draw_indirect_batched(cmd, true, pInfo->addressRange.address,
+   if (nvk_cmd_draw_indirect_pushed(cmd, true, pInfo->addressRange.address,
+                                    pInfo->drawCount, stride)) {
+      /* NVK_INDIRECT_PUSH */
+   } else if (nvk_cmd_draw_indirect_batched(cmd, true, pInfo->addressRange.address,
                                      pInfo->drawCount, stride)) {
       /* NVK_MDI_BATCH */
    } else if (nvk_cmd_buffer_3d_cls(cmd) >= TURING_A) {
