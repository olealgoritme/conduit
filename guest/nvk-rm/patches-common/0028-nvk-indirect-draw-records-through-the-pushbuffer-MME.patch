                             uint32_t size, uint32_t alignment,
@@ -363,6 +371,7 @@ nvk_BeginCommandBuffer(VkCommandBuffer commandBuffer,
 
    nvk_reset_cmd_buffer(&cmd->vk, 0);
    nvk_pass_profile_reset_cmd(cmd);
+   cmd->indirect_push_synced = false;
 
    if (cmd->vk.level == VK_COMMAND_BUFFER_LEVEL_SECONDARY)
       cmd->state.inherited_pipeline_statistics =
@@ -453,6 +462,8 @@ nvk_CmdExecuteCommands(VkCommandBuffer commandBuffer,
       util_dynarray_append_dynarray(&cmd->pushes, &other->pushes);
 
       cmd->prev_subc = nvk_cmd_buffer_last_subchannel(other);
+      /* The secondary may hold barriers */
+      cmd->indirect_push_synced = false;
 
       if (prof_slot >= 0) {
          nvk_pass_profile_end_secondary(cmd, other, prof_slot);
@@ -937,6 +948,7 @@ nvk_CmdPipelineBarrier2(VkCommandBuffer commandBuffer,
    VK_FROM_HANDLE(nvk_cmd_buffer, cmd, commandBuffer);
 
    nvk_cmd_profile_count_barrier(cmd);
+   cmd->indirect_push_synced = false;
    nvk_cmd_flush_wait_dep(cmd, pDependencyInfo, true);
    nvk_cmd_image_layout_transition(cmd, pDependencyInfo);
    nvk_cmd_invalidate_deps(cmd, 1, pDependencyInfo);
diff --git a/src/nouveau/vulkan/nvk_cmd_buffer.h b/src/nouveau/vulkan/nvk_cmd_buffer.h
