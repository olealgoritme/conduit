diff --git a/src/nouveau/vulkan/nvk_cmd_draw.c b/src/nouveau/vulkan/nvk_cmd_draw.c
index 97abdf2c..f9c6f536 100644
--- a/src/nouveau/vulkan/nvk_cmd_draw.c
+++ b/src/nouveau/vulkan/nvk_cmd_draw.c
@@ -44,6 +44,30 @@
  * buffers bound through NVK_MME_BIND_VB/IB (0006).  An A/B lever for
  * rendering bugs; on by default.
  */
+/* Size of the Turing+ MME instruction RAM in dwords (the unit
+ * LOAD_MME_INSTRUCTION_RAM_POINTER counts in).  Not documented; 0xc00 like
+ * the MME data RAM (MME_TU104_DRAM_COUNT), and consistent with GB20x
+ * running 2976 dwords of macros and faulting on 3303.
+ */
+#define NVK_MME_RAM_DW 0xc00u
+
+static uint32_t nvk_mdi_batch(void);
+
+/* NVK_INDIRECT_PUSH (Turing+, default on; =0 is upstream's per-record MME
+ * DMA reads): see nvk_cmd_draw_indirect_pushed().
+ */
+static bool
+nvk_indirect_push(void)
+{
+   static uint32_t state;
+   uint32_t s = p_atomic_read(&state);
+   if (unlikely(s == 0)) {
+      s = debug_get_bool_option("NVK_INDIRECT_PUSH", true) ? 2 : 1;
+      p_atomic_set(&state, s);
+   }
+   return s == 2;
+}
+
 static bool
 debug_get_option_nvk_cpu_state_tracking(void)
 {
@@ -181,7 +205,8 @@ nvk_push_draw_state_init(struct nvk_queue *queue, struct nv_push *p)
       .engine_id = 0,
    });
 
-   for (uint32_t mme = 0, mme_pos = 0; mme < NVK_MME_COUNT; mme++) {
+   uint32_t mme_pos = 0;
+   for (uint32_t mme = 0; mme < NVK_MME_COUNT; mme++) {
       size_t size;
       uint32_t *dw = nvk_build_mme(&pdev->info, mme, &size);
       if (dw == NULL)
@@ -201,6 +226,31 @@ nvk_push_draw_state_init(struct nvk_queue *queue, struct nv_push *p)
       mme_pos += num_dw;
 
       free(dw);
+
+      /* The MME instruction RAM holds NVK_MME_RAM_DW dwords: past it,
+       * macros are corrupt and every call faults (405.9).  Never upload
+       * more; fail the queue instead.
+       */
+      if (pdev->info.cls_eng3d >= TURING_A && mme_pos > NVK_MME_RAM_DW) {
+         return vk_errorf(dev, VK_ERROR_INITIALIZATION_FAILED,
+                          "NVK: MME macros need %u dwords, more than the "
+                          "%u of the MME instruction RAM (NVK_MDI_BATCH / "
+                          "NVK_INDIRECT_PUSH macro sets)", mme_pos,
+                          NVK_MME_RAM_DW);
+      }
+   }
+
+   {
+      static bool logged;
+      if (!logged) {
+         logged = true;
+         mesa_logi("NVK: MME macros take %u of %u dwords", mme_pos,
+                   NVK_MME_RAM_DW);
+         nvk_shader_stats_note("NVK: MME macros take %u of %u dwords "
+                               "(NVK_INDIRECT_PUSH %d, NVK_MDI_BATCH %u)",
+                               mme_pos, NVK_MME_RAM_DW, nvk_indirect_push(),
+                               nvk_mdi_batch());
+      }
    }
 
    if (pdev->info.cls_eng3d >= TURING_A && pdev->info.cls_eng3d < BLACKWELL_A)
@@ -5528,6 +5578,12 @@ nvk_CmdDrawMultiIndexedEXT(VkCommandBuffer commandBuffer,
 void
 nvk_mme_draw_indirect(struct mme_builder *b)
 {
+   /* Unused with NVK_INDIRECT_PUSH: left empty to keep the MME RAM within
+    * its size (nvk_mme_draw_indirect_batch())
+    */
+   if (b->devinfo->cls_eng3d >= TURING_A && nvk_indirect_push())
+      return;
+
    if (b->devinfo->cls_eng3d >= TURING_A) {
       struct mme_value64 draw_addr = mme_load_addr64(b);
       struct mme_value draw_count = mme_load(b);
@@ -5599,22 +5655,34 @@ nvk_mdi_batch(void)
    return s - 1;
 }
 
+/* dma: the records come from one MME_DMA_READ_FIFOED (NVK_MDI_BATCH);
+ * else they follow the three parameters as inline macro data
+ * (NVK_INDIRECT_PUSH).
+ */
 static void
-nvk_mme_build_draw_indirect_batch(struct mme_builder *b, bool indexed)
+nvk_mme_build_draw_indirect_batch(struct mme_builder *b, bool indexed,
+                                  bool dma)
 {
-   /* Only called on Turing+ (nvk_cmd_draw_indirect_batched()) */
+   /* Only called on Turing+ */
    if (b->devinfo->cls_eng3d < TURING_A)
       return;
 
-   struct mme_value64 draw_addr = mme_load_addr64(b);
-   struct mme_value read_dw = mme_load(b);
-   struct mme_value pad_dw = mme_load(b);
-   struct mme_value draw = mme_load(b);
-   struct mme_value draw_end = mme_load(b);
-
-   mme_tu104_read_fifoed(b, draw_addr, read_dw);
-   mme_free_reg64(b, draw_addr);
-   mme_free_reg(b, read_dw);
+   struct mme_value pad_dw, draw, draw_end;
+   if (dma) {
+      struct mme_value64 draw_addr = mme_load_addr64(b);
+      struct mme_value read_dw = mme_load(b);
+      pad_dw = mme_load(b);
+      draw = mme_load(b);
+      draw_end = mme_load(b);
+
+      mme_tu104_read_fifoed(b, draw_addr, read_dw);
+      mme_free_reg64(b, draw_addr);
+      mme_free_reg(b, read_dw);
+   } else {
+      pad_dw = mme_load(b);
+      draw = mme_load(b);
+      draw_end = mme_load(b);
+   }
 
    struct mme_value first = mme_mov(b, draw);
    mme_while(b, ult, draw, draw_end) {
@@ -5637,16 +5705,105 @@ nvk_mme_build_draw_indirect_batch(struct mme_builder *b, bool indexed)
    }
 }
 
+/* Every macro is uploaded into the MME instruction RAM at queue creation
+ * (nvk_push_draw_state_init()), and the RAM is nearly full: 405.8's macros
+ * take 2976 dwords and were fine, 405.9's 3303 overflowed it on GB20x and
+ * every macro call faulted (Xid 13, ESR 0x404490 = 0x80000080).  So macros
+ * a knob leaves unused are the builder's empty macro (two instructions):
+ * the batch macros unless NVK_MDI_BATCH is on and NVK_INDIRECT_PUSH off,
+ * the inline ones unless NVK_INDIRECT_PUSH is on, and the per-record DMA
+ * macros (NVK_MME_DRAW[_INDEXED]_INDIRECT) on Turing+ when it is on.
+ */
+static bool
+nvk_mdi_batch_active(void)
+{
+   return nvk_mdi_batch() >= 2 && !nvk_indirect_push();
+}
+
 void
 nvk_mme_draw_indirect_batch(struct mme_builder *b)
 {
-   nvk_mme_build_draw_indirect_batch(b, false);
+   if (nvk_mdi_batch_active())
+      nvk_mme_build_draw_indirect_batch(b, false, true);
 }
 
 void
 nvk_mme_draw_indexed_indirect_batch(struct mme_builder *b)
 {
-   nvk_mme_build_draw_indirect_batch(b, true);
+   if (nvk_mdi_batch_active())
+      nvk_mme_build_draw_indirect_batch(b, true, true);
+}
+
+void
+nvk_mme_draw_indirect_inline(struct mme_builder *b)
+{
+   if (nvk_indirect_push())
+      nvk_mme_build_draw_indirect_batch(b, false, false);
+}
+
+void
+nvk_mme_draw_indexed_indirect_inline(struct mme_builder *b)
+{
+   if (nvk_indirect_push())
+      nvk_mme_build_draw_indirect_batch(b, true, false);
+}
+
+/* NVK_INDIRECT_PUSH (Turing+, default on): the draw records of
+ * vkCmdDraw[Indexed]Indirect reach the MME as inline macro data that the
+ * host fetches from the indirect buffer itself (a pushbuffer segment
+ * pointing at the records, as NVK does before Turing), instead of an
+ * MME_DMA_READ_FIFOED per draw that the front end waits for: in CS2 that
+ * cost ~28 us per indirect draw in a depth prepass of ~115 indirect calls.
+ *
+ * The first record segment after a barrier (or the start of the command
+ * buffer, or a secondary) is a no-prefetch GPFIFO entry (SYNC_WAIT), so the
+ * host fetches it only after the work before it, which may have written the
+ * records, is done.  Later segments until the next barrier may be
+ * prefetched: Vulkan requires the records an indirect draw reads to be
+ * written before a barrier the draw comes after, and the host fetches
+ * GPFIFO entries in order.  One wait per barrier instead of one memory round
+ * trip per draw.  Segments hold at most NVK_INDIRECT_PUSH_MAX_DW record
+ * dwords; padding of larger strides is dropped and gl_DrawID continues.
+ */
+#define NVK_INDIRECT_PUSH_MAX_DW 1024u
+
+static bool
+nvk_cmd_draw_indirect_pushed(struct nvk_cmd_buffer *cmd, bool indexed,
+                             uint64_t draw_addr, uint32_t draw_count,
+                             uint64_t stride)
+{
+   if (nvk_cmd_buffer_3d_cls(cmd) < TURING_A || !nvk_indirect_push())
+      return false;
+
+   const uint32_t rec_dw = indexed ? 5 : 4;
+   assert(stride % 4 == 0 && stride / 4 >= rec_dw);
+   const uint64_t stride_dw = stride / 4;
+   /* A stride larger than a segment: one record per segment */
+   const uint32_t max_n = stride_dw > NVK_INDIRECT_PUSH_MAX_DW - rec_dw ? 1 :
+      (NVK_INDIRECT_PUSH_MAX_DW - rec_dw) / stride_dw + 1;
+   const uint32_t pad_dw = stride_dw - rec_dw;
+
+   for (uint32_t first = 0; first < draw_count;) {
+      const uint32_t n = MIN2(max_n, draw_count - first);
+      const uint64_t addr = draw_addr + (uint64_t)first * stride;
+      const uint32_t rec_total_dw = n == 1 ? rec_dw :
+                                    (n - 1) * stride_dw + rec_dw;
+
+      struct nv_push *p = nvk_cmd_buffer_push(cmd, 4);
+      P_1INC(p, NV9097, CALL_MME_MACRO(indexed ?
+                                       NVK_MME_DRAW_INDEXED_INDIRECT_INLINE :
+                                       NVK_MME_DRAW_INDIRECT_INLINE));
+      P_INLINE_DATA(p, n > 1 ? pad_dw : 0);
+      P_INLINE_DATA(p, first);
+      P_INLINE_DATA(p, first + n);
+      nv_push_update_count(p, rec_total_dw);
+      nvk_cmd_buffer_push_indirect_ext(cmd, addr, rec_total_dw * 4,
+                                       !cmd->indirect_push_synced);
+      cmd->indirect_push_synced = true;
+
+      first += n;
+   }
+   return true;
 }
 
