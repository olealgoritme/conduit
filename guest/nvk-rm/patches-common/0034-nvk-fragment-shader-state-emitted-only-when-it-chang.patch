 src/nouveau/vulkan/nvk_cmd_buffer.h   | 29 +++++++++
 src/nouveau/vulkan/nvk_cmd_draw.c     | 54 ++++++++++++++++
 src/nouveau/vulkan/nvk_pass_profile.c | 89 ++++++++++++++++++++++++++-
 src/nouveau/vulkan/nvk_pass_profile.h | 25 ++++++++
 src/nouveau/vulkan/nvk_shader.c       |  1 +
 src/nouveau/vulkan/nvk_shader.h       |  6 ++
 7 files changed, 205 insertions(+), 4 deletions(-)

diff --git a/src/nouveau/vulkan/nvk_cmd_buffer.c b/src/nouveau/vulkan/nvk_cmd_buffer.c
index 0d6e2456..dd7ae0f4 100644
--- a/src/nouveau/vulkan/nvk_cmd_buffer.c
+++ b/src/nouveau/vulkan/nvk_cmd_buffer.c
@@ -462,8 +462,9 @@ nvk_CmdExecuteCommands(VkCommandBuffer commandBuffer,
       util_dynarray_append_dynarray(&cmd->pushes, &other->pushes);
 
       cmd->prev_subc = nvk_cmd_buffer_last_subchannel(other);
-      /* The secondary may hold barriers */
+      /* The secondary may hold barriers and set any 3D state */
       cmd->indirect_push_synced = false;
+      cmd->state.gfx.fs_tail_dw_count = 0;
 
       if (prof_slot >= 0) {
          nvk_pass_profile_end_secondary(cmd, other, prof_slot);
@@ -1146,6 +1147,7 @@ nvk_CmdBindDescriptorSets2KHR(VkCommandBuffer commandBuffer,
    VK_FROM_HANDLE(nvk_cmd_buffer, cmd, commandBuffer);
 
    if (pBindDescriptorSetsInfo->stageFlags & NVK_VK_GRAPHICS_STAGE_BITS) {
+      nvk_cmd_profile_count_desc_bind(cmd);
       nvk_bind_descriptor_sets(cmd, &cmd->state.gfx.descriptors,
                                pBindDescriptorSetsInfo);
    }
@@ -1212,6 +1214,7 @@ nvk_CmdSetDescriptorBufferOffsets2EXT(VkCommandBuffer commandBuffer,
    VK_FROM_HANDLE(nvk_cmd_buffer, cmd, commandBuffer);
 
    if (pInfo->stageFlags & NVK_VK_GRAPHICS_STAGE_BITS) {
+      nvk_cmd_profile_count_desc_bind(cmd);
       nvk_set_descriptor_buffer_offsets(cmd, &cmd->state.gfx.descriptors,
                                         pInfo);
    }
diff --git a/src/nouveau/vulkan/nvk_cmd_buffer.h b/src/nouveau/vulkan/nvk_cmd_buffer.h
index ffb26ab6..a50f8bc4 100644
--- a/src/nouveau/vulkan/nvk_cmd_buffer.h
+++ b/src/nouveau/vulkan/nvk_cmd_buffer.h
@@ -281,6 +281,11 @@ struct nvk_graphics_state {
     * is skipped.  vb_known has a bit per vertex stream.
     */
