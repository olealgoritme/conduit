+   uint32_t fs_tail_dw[24];
    struct {
       uint64_t addr;
       uint32_t size;
@@ -353,6 +358,7 @@ struct nvk_cmd_buffer {
    uint32_t pass_profile_internal;
    bool pass_profile_in_pass;
    bool pass_profile_on;
+   bool pass_profile_buffers;
