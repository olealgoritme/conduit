From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ole Algoritme <olealgoritme@gmail.com>
Date: Sat, 24 Oct 2026 09:36:54 +0200
Subject: [PATCH] nak: NAK_LAT_NV, SM120 RAW latencies as in the reference
 compiler's code

The SM120 latency table adds one cycle to every SM100 RAW latency.  The
reference compiler's SM120 code (stall counts in the control bits of what
NVIDIA's driver makes of the same shaders) waits the SM100 latency for
almost every pair: 4 cycles FMA -> FMA, ALU -> ALU, IMAD, HFMA2 and the
uniform datapath, 5 for FMA <-> ALU, 13 for an execution guard.  It keeps
one more only between two ALU-pipe instructions when either is a
dual-issue op (MOV, SEL, ISETP, FSETP, FMNMX: 5), for predicate readers
other than guards, and for memory instructions reading a uniform register.

NAK_LAT_NV does the same.  Over 93 compute shaders no producer/reader
pair is then closer than in the reference compiler's code.  On by default
on Windows; it overrides NAK_LAT.
---
 src/nouveau/compiler/nak/knobs.rs             | 18 ++++++++++-
 .../compiler/nak/sm120_instr_latencies.rs     | 32 +++++++++++++++++--
 2 files changed, 46 insertions(+), 4 deletions(-)

diff --git a/src/nouveau/compiler/nak/knobs.rs b/src/nouveau/compiler/nak/knobs.rs
index 64fbf28..1562e47 100644
--- a/src/nouveau/compiler/nak/knobs.rs
+++ b/src/nouveau/compiler/nak/knobs.rs
@@ -115,6 +115,7 @@ static F16_CVT: OnceLock<bool> = OnceLock::new();
 static LOOP_CONT_SYNC: OnceLock<bool> = OnceLock::new();
 static EARLY_EXIT: OnceLock<bool> = OnceLock::new();
 static SCHED_MLP: OnceLock<u32> = OnceLock::new();
+static LAT_NV: OnceLock<bool> = OnceLock::new();
 
 /// NAK_TEX_UHANDLE (0-2, default 2 on Windows, 0 elsewhere, SM100+): a
 /// bindless texture handle that
@@ -154,6 +155,20 @@ fn parse_u32(name: &str, default: u32, max: u32) -> u32 {
     }
 }
 
+/// NAK_LAT_NV (default on on Windows, off elsewhere): SM120 RAW latencies as the reference
+/// compiler's SM120 code has them, instead of the SM100 latency plus one
+/// everywhere: plus one only between two ALU-pipe instructions when either
+/// is a dual-issue ALU op, for predicate readers other than execution
+/// guards and for memory instructions reading a uniform register
+/// (sm120_instr_latencies.rs).  Overrides NAK_LAT
+pub fn lat_nv() -> bool {
+    // 405.143: NAK_LAT=95 (the same distances but the fp16 and ALU-ALU
+    // pairs) passed naktest and every replay, -1% to -1.7% on the hot
+    // Steel Nomad shaders; NAK_LAT=128 (no padding at all) faults
+    let dflt = cfg!(target_os = "windows");
+    *LAT_NV.get_or_init(|| parse("NAK_LAT_NV", env::var("NAK_LAT_NV"), dflt))
+}
+
 /// NAK_F16_PAIR (default off): independent scalar 32-to-16-bit float
 /// conversions in a block are paired into one 2-wide conversion (one
 /// F2FP.PACK_AB), so the 16-bit math that follows reads the lanes of one
@@ -212,7 +227,7 @@ pub fn occ_gprs() -> u32 {
 
 /// The knobs that do not fit in nak_knobs_key(), for a second word of
 /// NVK's cache keys: NAK_TEX_UHANDLE, NAK_REMAT_LD_COST, NAK_OCC_GPRS,
-/// NAK_F16_PAIR, NAK_TEMP_IF_ELSE, NAK_OCC_FS
+/// NAK_F16_PAIR, NAK_TEMP_IF_ELSE, NAK_OCC_FS, NAK_LAT_NV
 #[unsafe(no_mangle)]
 pub extern "C" fn nak_knobs_key2() -> u32 {
     tex_uhandle()
@@ -222,6 +237,7 @@ pub extern "C" fn nak_knobs_key2() -> u32 {
         // 0, 2..64 as 0, 1..6 in three bits
         | ((if temp_if_else() == 0 { 0 } else { temp_if_else().trailing_zeros() }) << 17)
         | (u32::from(occ_fs()) << 20)
+        | (u32::from(lat_nv()) << 21)
 }
 
 
diff --git a/src/nouveau/compiler/nak/sm120_instr_latencies.rs b/src/nouveau/compiler/nak/sm120_instr_latencies.rs
index 0a17f57..fbf5857 100644
--- a/src/nouveau/compiler/nak/sm120_instr_latencies.rs
+++ b/src/nouveau/compiler/nak/sm120_instr_latencies.rs
@@ -473,6 +473,19 @@ impl SM120Latency {
                     || read_latency == RegLatencySM100::Imma
                 {
                     RegLatencySM100::raw(write_latency, read_latency, false) + 5
+                } else if crate::knobs::lat_nv() {
+                    // NAK_LAT_NV: the distances in the reference compiler's
+                    // SM120 code: the SM100 latency, plus one only between
+                    // two ALU-pipe instructions when either is a dual-issue
+                    // ALU op (MOV, SEL, ISETP, FSETP, FMNMX, ...)
+                    let pad = u32::from(
+                        is_alu(&write_latency)
+                            && is_alu(&read_latency)
+                            && (write_latency == RegLatencySM100::Dualalu
+                                || read_latency == RegLatencySM100::Dualalu),
+                    );
+                    RegLatencySM100::raw(write_latency, read_latency, false)
+                        + pad
                 } else {
                     let m = lat_mode();
                     let mut pad = 1;
@@ -506,7 +519,15 @@ impl SM120Latency {
                     None => UregLatencySM100::Uldc,
                 };
                 let m = lat_mode();
-                let pad = if m & 128 != 0
+                let pad = if crate::knobs::lat_nv() {
+                    // plus one only for memory instructions reading the
+                    // uniform register (UMOV -> LDG: 3)
+                    u32::from(matches!(
+                        read_latency,
+                        UregLatencySM100::Decoupled
+                            | UregLatencySM100::DecoupledBindless
+                    ))
+                } else if m & 128 != 0
                     || (m & 16 != 0
                         && write_latency == UregLatencySM100::Udp
                         && matches!(
@@ -527,7 +548,11 @@ impl SM120Latency {
                     None => PredLatencySM100::RedirectedFp64,
                 };
                 let m = lat_mode();
-                let pad = if m & 128 != 0
+                let pad = if crate::knobs::lat_nv() {
+                    // execution guards take the SM100 latency, other
+                    // predicate readers one more
+                    u32::from(!guard)
+                } else if m & 128 != 0
                     || (m & 4 != 0 && guard)
                     || (m & 8 != 0
                         && write_latency == PredLatencySM100::Coupled
@@ -545,7 +570,8 @@ impl SM120Latency {
                     Some(op) => op_upred_latency(op),
                     None => UpredLatencySM100::UGuard,
                 };
-                UpredLatencySM100::raw(write_latency, read_latency, false) + 1
+                UpredLatencySM100::raw(write_latency, read_latency, false)
+                    + u32::from(!crate::knobs::lat_nv())
             }
             RegFile::Bar => 0, // Barriers have a HW scoreboard
             _ => panic!("Not a register"),
-- 
