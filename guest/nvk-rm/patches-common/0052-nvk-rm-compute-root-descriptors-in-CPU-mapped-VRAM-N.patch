+++ b/src/nouveau/vulkan/nvk_cmd_pool.h
@@ -37,6 +37,7 @@ struct nvk_cmd_pool {
    /** List of nvk_cmd_mem */
    struct list_head free_mem;
    struct list_head free_gart_mem;
+   struct list_head free_lat_mem;
    struct list_head free_qmd;
 };
 
@@ -52,6 +53,8 @@ nvk_cmd_pool_device(struct nvk_cmd_pool *pool)
 VkResult nvk_cmd_pool_alloc_mem(struct nvk_cmd_pool *pool,
                                 bool force_gart,
                                 struct nvk_cmd_mem **mem_out);
+VkResult nvk_cmd_pool_alloc_lat_mem(struct nvk_cmd_pool *pool,
+                                    struct nvk_cmd_mem **mem_out);
 VkResult nvk_cmd_pool_alloc_qmd(struct nvk_cmd_pool *pool,
                                 struct nvk_cmd_qmd **qmd_out);
 
@@ -59,6 +62,8 @@ void nvk_cmd_pool_free_mem_list(struct nvk_cmd_pool *pool,
                                 struct list_head *mem_list);
 void nvk_cmd_pool_free_gart_mem_list(struct nvk_cmd_pool *pool,
                                      struct list_head *mem_list);
+void nvk_cmd_pool_free_lat_mem_list(struct nvk_cmd_pool *pool,
+                                    struct list_head *mem_list);
 void nvk_cmd_pool_free_qmd_list(struct nvk_cmd_pool *pool,
                                 struct list_head *mem_list);
 #endif /* NVK_CMD_POOL_H */
diff --git a/src/nouveau/vulkan/nvkmd/nvkmd.h b/src/nouveau/vulkan/nvkmd/nvkmd.h
index 2ea9077..ae87421 100644
--- a/src/nouveau/vulkan/nvkmd/nvkmd.h
+++ b/src/nouveau/vulkan/nvkmd/nvkmd.h
@@ -78,6 +78,15 @@ enum nvkmd_mem_flags {
     *  place it in CPU-mapped VRAM instead.  Ignored elsewhere.
     */
    NVKMD_MEM_CPU_WRITE_ONLY = 1 << 8,
+
+   /** Small CPU-written data the GPU reads at a dependent point of every
+    *  operation that uses it, with the engine waiting on the read (a compute
+    *  dispatch's root descriptor table): read latency matters more than the
+    *  CPU's write bandwidth.  Implies NVKMD_MEM_CPU_WRITE_ONLY.  A backend
+    *  which places mappable memory in system memory may place it in
+    *  CPU-mapped VRAM.  Ignored elsewhere.
+    */
+   NVKMD_MEM_GPU_LATENCY = 1 << 9,
 };
 
 #define NVKMD_MEM_PLACEMENT_FLAGS \
diff --git a/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm.h b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm.h
index 195e67a..9f3e596 100644
--- a/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm.h
+++ b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm.h
@@ -337,7 +337,15 @@ struct nvkmd_rm_dev {
     * instead of system memory the GPU reads across PCIe.
     */
    bool desc_vram;
-   bool upload_vram;
+   /* NVK_RM_UPLOAD_VRAM: which command buffer upload memory is CPU-mapped
+    * VRAM.  NVKMD_RM_UPLOAD_VRAM_COMPUTE (the default, "compute"): only
+    * latency-bound upload memory (NVKMD_MEM_GPU_LATENCY, a compute
+    * dispatch's root descriptor table, which the dispatch waits for: from
+    * system memory each serial dispatch costs a few us more, 9.6 against
+    * 1.1 us per dependent dispatch pair on an RTX 5090).  _ALL (1): all of
+    * it.  _NONE (0): none.
+    */
+   uint8_t upload_vram;
    uint32_t desc_vram_fallbacks;
 
    /* lib->win_loss_epoch() when the device was created; see
@@ -394,6 +402,13 @@ struct nvkmd_rm_dev {
     */
    uint64_t bar_used_B;
 
+   /* NVK's own CPU-mapped VRAM (descriptor tables, upload memory: the
+    * NVK_RM_DESC_TABLE_VRAM / NVK_RM_UPLOAD_VRAM placements), not charged to
+    * the application's BAR heap, which may not be advertised at all
+    * (NVK_RM_BAR_MB=0, the default).  At most NVKMD_RM_INTERNAL_BAR_B.
+    */
+   uint64_t bar_internal_used_B;
+
    /* Allocations from the BAR heap whose CPU map failed and which were
     * given system memory instead (nvkmd_rm_mem.c).
     */
@@ -496,6 +511,8 @@ struct nvkmd_rm_mem {
     * map of the VRAM failed.
     */
    bool bar_charged;
+   /* Charged to dev->bar_internal_used_B instead (NVK's own placements) */
+   bool bar_internal;
 
    /* Imported from a dma-buf: h_memory came from
     * NV0000_CTRL_CMD_OS_UNIX_IMPORT_OBJECT_FROM_FD and its handle was
@@ -543,6 +560,11 @@ NVKMD_DECL_SUBCLASS(mem, rm);
  * NV01_MEMORY_SYSTEM instead of our own pages (for memory RM itself writes
  * through a kernel mapping, like channel error notifiers).
  */
+#define NVKMD_RM_UPLOAD_VRAM_NONE    0
+#define NVKMD_RM_UPLOAD_VRAM_COMPUTE 1
+#define NVKMD_RM_UPLOAD_VRAM_ALL     2
+#define NVKMD_RM_INTERNAL_BAR_B      (256ull << 20)
+
 #define NVKMD_RM_MEM_RM_SYSMEM ((enum nvkmd_mem_flags)(1u << 30))
 
 VkResult nvkmd_rm_alloc_mem(struct nvkmd_dev *dev,
diff --git a/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_dev.c b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_dev.c
index 20857ec..4d837b6 100644
--- a/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_dev.c
+++ b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_dev.c
@@ -166,7 +166,16 @@ nvkmd_rm_create_dev(struct nvkmd_pdev *_pdev,
       dev->sysmem_cached = dev->sysmem_cached_desc || dev->sysmem_cached_app;
    }
    dev->desc_vram = debug_get_bool_option("NVK_RM_DESC_TABLE_VRAM", false);
-   dev->upload_vram = debug_get_bool_option("NVK_RM_UPLOAD_VRAM", false);
+   {
+      /* NVK_RM_UPLOAD_VRAM=compute (default) / 1 (all) / 0 (none) */
+      const char *u = os_get_option("NVK_RM_UPLOAD_VRAM");
+      if (u == NULL || strcmp(u, "compute") == 0)
+         dev->upload_vram = NVKMD_RM_UPLOAD_VRAM_COMPUTE;
+      else if (debug_get_bool_option("NVK_RM_UPLOAD_VRAM", false))
+         dev->upload_vram = NVKMD_RM_UPLOAD_VRAM_ALL;
+      else
+         dev->upload_vram = NVKMD_RM_UPLOAD_VRAM_NONE;
+   }
 
    list_inithead(&dev->base.mems);
    simple_mtx_init(&dev->base.mems_mutex, mtx_plain);
diff --git a/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_mem.c b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_mem.c
index 0cecdda..a6eb2ff 100644
--- a/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_mem.c
+++ b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_mem.c
@@ -92,6 +92,29 @@ bar_release(struct nvkmd_rm_dev *dev, uint64_t size_B)
    p_atomic_add(&dev->bar_used_B, -(int64_t)size_B);
 }
 
+/* NVK's own CPU-mapped VRAM, against its own budget */
+static bool
+bar_internal_reserve(struct nvkmd_rm_dev *dev, uint64_t size_B)
+{
+   uint64_t used = p_atomic_read(&dev->bar_internal_used_B);
+   for (;;) {
+      if (size_B > NVKMD_RM_INTERNAL_BAR_B ||
+          used > NVKMD_RM_INTERNAL_BAR_B - size_B)
+         return false;
+      const uint64_t seen =
+         p_atomic_cmpxchg(&dev->bar_internal_used_B, used, used + size_B);
+      if (seen == used)
+         return true;
+      used = seen;
+   }
+}
+
+static void
+bar_internal_release(struct nvkmd_rm_dev *dev, uint64_t size_B)
+{
+   p_atomic_add(&dev->bar_internal_used_B, -(int64_t)size_B);
+}
+
 /* The CPU map of host-visible VRAM failed: say so once per device (and
  * every time with NVK_DEBUG=vm).  The allocation goes on in system memory.
  */
@@ -515,13 +538,19 @@ nvkmd_rm_alloc_tiled_mem(struct nvkmd_dev *_dev,
     * a PCIe read through the guest's IOMMU.  If the heap is full or the map
     * is refused, they stay in system memory as before (logged).
     */
+   /* These do not need the application's BAR heap to be advertised: they
+    * have a budget of their own (bar_internal_reserve).
+    */
    const bool want_bar_internal =
       (flags & NVKMD_MEM_LOCAL) && (flags & NVKMD_MEM_CAN_MAP) &&
       !(flags & NVKMD_MEM_SHARED) && !force_rm_sysmem &&
-      dev_info->bar_size_B > 0 && dev_info->vram_size_B > 0 &&
+      dev_info->vram_size_B > 0 &&
       !(dev->base.pdev->debug_flags & NVK_DEBUG_FORCE_GART) &&
       (((flags & NVKMD_MEM_GPU_READ_ONLY) && dev->desc_vram) ||
-       ((flags & NVKMD_MEM_CPU_WRITE_ONLY) && dev->upload_vram));
+       ((flags & NVKMD_MEM_GPU_LATENCY) &&
+        dev->upload_vram >= NVKMD_RM_UPLOAD_VRAM_COMPUTE) ||
+       ((flags & NVKMD_MEM_CPU_WRITE_ONLY) &&
+        dev->upload_vram == NVKMD_RM_UPLOAD_VRAM_ALL));
    if (want_bar_internal)
       flags = (flags & ~NVKMD_MEM_LOCAL) | NVKMD_MEM_VRAM;
 
@@ -532,7 +561,8 @@ nvkmd_rm_alloc_tiled_mem(struct nvkmd_dev *_dev,
         !(flags & NVKMD_MEM_GPU_READ_ONLY)) ||
        (dev->sysmem_cached_desc && (flags & NVKMD_MEM_GPU_READ_ONLY))) &&
       !force_rm_sysmem;
-   flags &= ~(NVKMD_RM_MEM_RM_SYSMEM | NVKMD_MEM_CPU_WRITE_ONLY);
+   flags &= ~(NVKMD_RM_MEM_RM_SYSMEM | NVKMD_MEM_CPU_WRITE_ONLY |
+              NVKMD_MEM_GPU_LATENCY);
 
    /* Kinds are applied per mapping (the image's own VA).  The layout is only
     * remembered, for NVKMS if the memory is exported.
@@ -565,7 +595,13 @@ nvkmd_rm_alloc_tiled_mem(struct nvkmd_dev *_dev,
    /* The BAR heap: VRAM the CPU maps (see the placement policy) */
    bool bar = vram && (flags & NVKMD_MEM_VRAM) &&
               (flags & NVKMD_MEM_CAN_MAP);
-   if (bar && !bar_reserve(dev, size_B)) {
+   if (bar && want_bar_internal) {
+      if (!bar_internal_reserve(dev, size_B)) {
+         /* NVK's own budget is spent: system memory, as before */
+         bar = false;
+         vram = false;
+      }
