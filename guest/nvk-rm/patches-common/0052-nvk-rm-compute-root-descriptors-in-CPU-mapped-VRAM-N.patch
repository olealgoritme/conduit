@@ -410,6 +410,11 @@ struct nvk_cmd_buffer {
    struct nvk_cmd_mem *upload_mem;
    uint32_t upload_offset;
 
+   /* Latency-bound upload memory (NVKMD_MEM_GPU_LATENCY), its own list */
+   struct list_head owned_lat_mem;
+   struct nvk_cmd_mem *lat_upload_mem;
+   uint32_t lat_upload_offset;
+
    struct nvk_cmd_mem *cond_render_mem;
    /** Array of struct nvk_cmd_mem* */
    struct util_dynarray copy_memory_indirect_temps;
@@ -677,6 +682,10 @@ VkResult nvk_cmd_buffer_upload_alloc(struct nvk_cmd_buffer *cmd,
                                      uint32_t size, uint32_t alignment,
                                      uint64_t *addr, void **ptr);
 
+VkResult nvk_cmd_buffer_upload_alloc_lat(struct nvk_cmd_buffer *cmd,
+                                         uint32_t size, uint32_t alignment,
+                                         uint64_t *addr, void **ptr);
+
 VkResult nvk_cmd_buffer_upload_data(struct nvk_cmd_buffer *cmd,
                                     const void *data, uint32_t size,
                                     uint32_t alignment, uint64_t *addr);
diff --git a/src/nouveau/vulkan/nvk_cmd_dispatch.c b/src/nouveau/vulkan/nvk_cmd_dispatch.c
index e49b14b..6f2874c 100644
--- a/src/nouveau/vulkan/nvk_cmd_dispatch.c
+++ b/src/nouveau/vulkan/nvk_cmd_dispatch.c
@@ -179,8 +179,9 @@ nvk_cmd_upload_qmd(struct nvk_cmd_buffer *cmd,
 
    void *root_desc_map;
    uint64_t root_desc_addr;
-   result = nvk_cmd_buffer_upload_alloc(cmd, root_size, min_cbuf_alignment,
-                                        &root_desc_addr, &root_desc_map);
+   result = nvk_cmd_buffer_upload_alloc_lat(cmd, root_size,
