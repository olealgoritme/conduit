diff --git a/src/nouveau/vulkan/nvk_cmd_pool.c b/src/nouveau/vulkan/nvk_cmd_pool.c
index 6c3f04f..9da1a41 100644
--- a/src/nouveau/vulkan/nvk_cmd_pool.c
+++ b/src/nouveau/vulkan/nvk_cmd_pool.c
@@ -10,7 +10,8 @@
 #include "nvkmd/nvkmd.h"
 
 static VkResult
-nvk_cmd_mem_create(struct nvk_cmd_pool *pool, bool force_gart, struct nvk_cmd_mem **mem_out)
+nvk_cmd_mem_create(struct nvk_cmd_pool *pool, bool force_gart, bool latency,
+                   struct nvk_cmd_mem **mem_out)
 {
    struct nvk_device *dev = nvk_cmd_pool_device(pool);
    struct nvk_cmd_mem *mem;
@@ -24,8 +25,13 @@ nvk_cmd_mem_create(struct nvk_cmd_pool *pool, bool force_gart, struct nvk_cmd_me
    /* Upload memory is only written by the CPU; on RM it may go to VRAM
     * through BAR1 (NVK_RM_UPLOAD_VRAM).  Pushbuffers (force_gart) stay.
     */
-   const uint32_t flags = force_gart ? NVKMD_MEM_GART
-                                     : NVKMD_MEM_LOCAL | NVKMD_MEM_CPU_WRITE_ONLY;
+   uint32_t flags = force_gart ? NVKMD_MEM_GART
+                               : NVKMD_MEM_LOCAL | NVKMD_MEM_CPU_WRITE_ONLY;
+   /* Latency-bound upload memory (compute root descriptors): on RM it goes
+    * to VRAM through BAR1 by default (NVK_RM_UPLOAD_VRAM=compute).
+    */
+   if (latency)
+      flags |= NVKMD_MEM_GPU_LATENCY;
 
    result = nvkmd_dev_alloc_mapped_mem(dev->nvkmd, &pool->vk.base,
                                        NVK_CMD_MEM_SIZE, 0,
@@ -103,6 +109,7 @@ nvk_CreateCommandPool(VkDevice _device,
 
    list_inithead(&pool->free_mem);
    list_inithead(&pool->free_gart_mem);
+   list_inithead(&pool->free_lat_mem);
    list_inithead(&pool->free_qmd);
 
    *pCmdPool = nvk_cmd_pool_to_handle(pool);
@@ -123,6 +130,11 @@ nvk_cmd_pool_destroy_mem(struct nvk_cmd_pool *pool)
 
    list_inithead(&pool->free_gart_mem);
 
+   list_for_each_entry_safe(struct nvk_cmd_mem, mem, &pool->free_lat_mem, link)
+      nvk_cmd_mem_destroy(pool, mem);
+
+   list_inithead(&pool->free_lat_mem);
+
    list_for_each_entry_safe(struct nvk_cmd_qmd, qmd, &pool->free_qmd, link)
       nvk_cmd_qmd_destroy(pool, qmd);
    list_inithead(&pool->free_qmd);
@@ -147,7 +159,7 @@ nvk_cmd_pool_alloc_mem(struct nvk_cmd_pool *pool, bool force_gart,
    if (mem) {
       list_del(&mem->link);
    } else {
-      VkResult result = nvk_cmd_mem_create(pool, force_gart, &mem);
+      VkResult result = nvk_cmd_mem_create(pool, force_gart, false, &mem);
       if (result != VK_SUCCESS)
          return result;
    }
@@ -160,6 +172,25 @@ nvk_cmd_pool_alloc_mem(struct nvk_cmd_pool *pool, bool force_gart,
    return VK_SUCCESS;
 }
 
+VkResult
+nvk_cmd_pool_alloc_lat_mem(struct nvk_cmd_pool *pool,
+                           struct nvk_cmd_mem **mem_out)
+{
+   struct nvk_cmd_mem *mem = NULL;
+
+   if (!list_is_empty(&pool->free_lat_mem)) {
+      mem = list_first_entry(&pool->free_lat_mem, struct nvk_cmd_mem, link);
+      list_del(&mem->link);
+   } else {
+      VkResult result = nvk_cmd_mem_create(pool, false, true, &mem);
+      if (result != VK_SUCCESS)
+         return result;
+   }
+
+   *mem_out = mem;
+   return VK_SUCCESS;
+}
+
 VkResult
 nvk_cmd_pool_alloc_qmd(struct nvk_cmd_pool *pool,
                        struct nvk_cmd_qmd **qmd_out)
@@ -191,6 +222,14 @@ nvk_cmd_pool_free_gart_mem_list(struct nvk_cmd_pool *pool,
    list_inithead(mem_list);
 }
 
+void
+nvk_cmd_pool_free_lat_mem_list(struct nvk_cmd_pool *pool,
+                               struct list_head *mem_list)
+{
+   list_splicetail(mem_list, &pool->free_lat_mem);
+   list_inithead(mem_list);
+}
+
 void
 nvk_cmd_pool_free_qmd_list(struct nvk_cmd_pool *pool,
                            struct list_head *qmd_list)
