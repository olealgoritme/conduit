From 97d100ef179865896acfc913c5a37ab33c9d828b Mon Sep 17 00:00:00 2001
From: Ole Algoritme <olealgoritme@gmail.com>
Date: Mon, 12 Oct 2026 20:24:19 +0200
Subject: [PATCH] nvk/rm: compute root descriptors in CPU-mapped VRAM
 (NVK_RM_UPLOAD_VRAM=compute)

A compute dispatch's root descriptor table is command buffer upload
memory, which the RM backend places in system memory the GPU reads
uncached across PCIe, and the dispatch waits for it. On an RTX 5090 in a
Windows guest (vk_gpu_bound, 256 dependent 4 MiB copies) a barrier plus
dispatch cost 9.6 us more than a dispatch alone; with the table in VRAM
1.1 us (NVIDIA: 0.83 us), and 256 independent dispatches took 0.36 ms
instead of 1.1 ms (NVIDIA: 0.37 ms).

- NVKMD_MEM_GPU_LATENCY: small CPU-written data the GPU reads at a
  dependent point of every use. Command buffers keep a separate upload
  stream for it (nvk_cmd_buffer_upload_alloc_lat), used for the compute
  root descriptor table.
- RM: NVK_RM_UPLOAD_VRAM=compute (the default) puts that stream in
  CPU-mapped VRAM; 1 puts all upload memory there, 0 none. NVK's own
  CPU-mapped VRAM (these and NVK_RM_DESC_TABLE_VRAM) has a budget of its
  own (256 MiB) and no longer needs the application's BAR heap
  (NVK_RM_BAR_MB) to be advertised; past the budget, or if the map is
  refused, it stays in system memory as before.
- nouveau ignores the flag.
---
 src/nouveau/vulkan/nvk_cmd_buffer.c        | 40 +++++++++++++++
 src/nouveau/vulkan/nvk_cmd_buffer.h        |  9 ++++
 src/nouveau/vulkan/nvk_cmd_dispatch.c      |  5 +-
 src/nouveau/vulkan/nvk_cmd_pool.c          | 47 ++++++++++++++++--
 src/nouveau/vulkan/nvk_cmd_pool.h          |  5 ++
 src/nouveau/vulkan/nvkmd/nvkmd.h           |  9 ++++
 src/nouveau/vulkan/nvkmd/rm/nvkmd_rm.h     | 24 ++++++++-
 src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_dev.c | 11 +++-
 src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_mem.c | 58 +++++++++++++++++++---
 9 files changed, 193 insertions(+), 15 deletions(-)

diff --git a/src/nouveau/vulkan/nvk_cmd_buffer.c b/src/nouveau/vulkan/nvk_cmd_buffer.c
index 05d7bf3..b749e64 100644
--- a/src/nouveau/vulkan/nvk_cmd_buffer.c
+++ b/src/nouveau/vulkan/nvk_cmd_buffer.c
@@ -63,6 +63,7 @@ nvk_destroy_cmd_buffer(struct vk_command_buffer *vk_cmd_buffer)
 
    nvk_cmd_pool_free_mem_list(pool, &cmd->owned_mem);
    nvk_cmd_pool_free_gart_mem_list(pool, &cmd->owned_gart_mem);
+   nvk_cmd_pool_free_lat_mem_list(pool, &cmd->owned_lat_mem);
    nvk_cmd_pool_free_qmd_list(pool, &cmd->owned_qmd);
    util_dynarray_fini(&cmd->pushes);
    util_dynarray_fini(&cmd->copy_memory_indirect_temps);
@@ -98,6 +99,7 @@ nvk_create_cmd_buffer(struct vk_command_pool *vk_pool,
 
    list_inithead(&cmd->owned_mem);
    list_inithead(&cmd->owned_gart_mem);
+   list_inithead(&cmd->owned_lat_mem);
    list_inithead(&cmd->owned_qmd);
    cmd->pushes = UTIL_DYNARRAY_INIT;
    cmd->copy_memory_indirect_temps = UTIL_DYNARRAY_INIT;
@@ -124,8 +126,10 @@ nvk_reset_cmd_buffer(struct vk_command_buffer *vk_cmd_buffer,
 
    nvk_cmd_pool_free_mem_list(pool, &cmd->owned_mem);
    nvk_cmd_pool_free_gart_mem_list(pool, &cmd->owned_gart_mem);
+   nvk_cmd_pool_free_lat_mem_list(pool, &cmd->owned_lat_mem);
    nvk_cmd_pool_free_qmd_list(pool, &cmd->owned_qmd);
    cmd->upload_mem = NULL;
+   cmd->lat_upload_mem = NULL;
    cmd->push_mem = NULL;
    cmd->push_mem_limit = NULL;
    cmd->push = (struct nv_push) {0};
@@ -299,6 +303,41 @@ nvk_cmd_buffer_upload_alloc(struct nvk_cmd_buffer *cmd,
    return VK_SUCCESS;
 }
 
+/* nvk_cmd_buffer_upload_alloc() in latency-bound upload memory
+ * (NVKMD_MEM_GPU_LATENCY): data the GPU reads at a dependent point of every
+ * use, such as a compute dispatch's root descriptor table.  Allocations come
+ * from their own 64 KiB blocks, filled in order.
+ */
+VkResult
+nvk_cmd_buffer_upload_alloc_lat(struct nvk_cmd_buffer *cmd,
+                                uint32_t size, uint32_t alignment,
+                                uint64_t *addr, void **ptr)
+{
+   assert(size % 4 == 0);
+   assert(size <= NVK_CMD_MEM_SIZE);
+
+   uint32_t offset = cmd->lat_upload_offset;
+   if (alignment > 0)
+      offset = align(offset, alignment);
+
+   if (cmd->lat_upload_mem == NULL || size > NVK_CMD_MEM_SIZE - offset) {
+      struct nvk_cmd_mem *mem;
+      VkResult result = nvk_cmd_pool_alloc_lat_mem(nvk_cmd_buffer_pool(cmd),
+                                                   &mem);
+      if (unlikely(result != VK_SUCCESS))
+         return result;
+      list_addtail(&mem->link, &cmd->owned_lat_mem);
+      cmd->lat_upload_mem = mem;
+      offset = 0;
+   }
+
+   *addr = cmd->lat_upload_mem->mem->va->addr + offset;
+   *ptr = (char *)cmd->lat_upload_mem->mem->map + offset;
+   cmd->lat_upload_offset = offset + size;
+
+   return VK_SUCCESS;
+}
+
 VkResult
 nvk_cmd_buffer_upload_data(struct nvk_cmd_buffer *cmd,
                            const void *data, uint32_t size,
@@ -420,6 +459,7 @@ nvk_EndCommandBuffer(VkCommandBuffer commandBuffer)
     */
    flush_mem_list(cmd, &cmd->owned_mem);
    flush_mem_list(cmd, &cmd->owned_gart_mem);
+   flush_mem_list(cmd, &cmd->owned_lat_mem);
 
    return vk_command_buffer_get_record_result(&cmd->vk);
 }
