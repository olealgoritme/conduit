From 462740b5e4848f235fe7169dbcf0c2e31ac07b68 Mon Sep 17 00:00:00 2001
From: Ole Algoritme <olealgoritme@gmail.com>
Date: Sat, 17 Oct 2026 16:00:29 +0200
Subject: [PATCH] nak: NAK_UNROLL_MAX, how far NIR unrolls loops with a known
 trip count

NIR fully unrolls loops with a known trip count of up to
max_unroll_iterations (32 for NAK) iterations and a body cost of up to 32 *
26.  The reference compiler keeps such loops: in CS2's heaviest fragment
shaders (0x39204a7e and its group) its code is 2283 instructions with 15
backward branches, NAK's 5409 with 5, and the unrolled bodies also push
register counts over a warp cliff (104 GPRs instead of 96).

NAK_UNROLL_MAX sets max_unroll_iterations: 0, 1, 2, 4, 8, 16, 32 (the
default, unchanged) or 64; other values round down.  Part of
nak_knobs_key().

Offline, GB202, CS2 corpus, 8 vs 32: fragment -8.0% instructions, 41
shaders gain warps and none lose; compute -2.3%; 0x39204a7e 5387 -> 1710
instructions, 104 -> 96 GPRs.  Static counts favour rolled loops; an fps
A/B decides the default.
---
 src/nouveau/compiler/nak/api.rs   |  2 +-
 src/nouveau/compiler/nak/knobs.rs | 35 ++++++++++++++++++++++++++++++-
 2 files changed, 35 insertions(+), 2 deletions(-)

diff --git a/src/nouveau/compiler/nak/api.rs b/src/nouveau/compiler/nak/api.rs
index 3297110..2b1e57e 100644
--- a/src/nouveau/compiler/nak/api.rs
+++ b/src/nouveau/compiler/nak/api.rs
@@ -198,7 +198,7 @@ fn nir_options(dev: &nv_device_info) -> nir_shader_compiler_options {
         has_load_global_bounded: dev.sm >= 73,
         vectorize_vec2_16bit: true,
 
-        max_unroll_iterations: 32,
+        max_unroll_iterations: crate::knobs::unroll_max(),
         max_samples: 8,
         scalarize_ddx: true,
         ..Default::default()
diff --git a/src/nouveau/compiler/nak/knobs.rs b/src/nouveau/compiler/nak/knobs.rs
index 8c8d775..c824e7e 100644
--- a/src/nouveau/compiler/nak/knobs.rs
+++ b/src/nouveau/compiler/nak/knobs.rs
@@ -30,6 +30,9 @@
 //! - NAK_LAT (bitmask, default 0): SM120 RAW latency pairs that leave out
 //!   the blanket +1 (sm120_instr_latencies.rs); 128 leaves it out
 //!   everywhere, which is unsafe.  For hardware validation
+//! - NAK_UNROLL_MAX (default 32): most iterations NIR fully unrolls a loop
+//!   with a known trip count; lower values keep more loops rolled, as the
+//!   reference compiler does
 //! - NAK_BSSY_RECONVERGENT (default off): on SM100+, the BSSY/BSYNC pairs of
 //!   if/else regions (barriers no BREAK uses) use the .RECONVERGENT mode,
 //!   as the reference compiler's SM120 code does, without the BMOV.CLEAR
@@ -66,6 +69,7 @@ static BSSY_RECONVERGENT: OnceLock<bool> = OnceLock::new();
 static PHI_AVOID: OnceLock<bool> = OnceLock::new();
 static BAR_SHARE: OnceLock<bool> = OnceLock::new();
 static LAT_MASK: OnceLock<u32> = OnceLock::new();
+static UNROLL_MAX: OnceLock<u32> = OnceLock::new();
 
 /// NAK_IMM_CSE for a shader: compute shaders unless set
 pub fn imm_cse(compute: bool) -> bool {
@@ -149,6 +153,25 @@ pub fn lat_mask() -> u32 {
     *v
 }
 
+/// NAK_UNROLL_MAX: most iterations NIR unrolls a loop with a known trip
+/// count (and at most that times 26 instructions of loop body cost): 0, 1,
+/// 2, 4, 8, 16, 32 (the default) or 64; other values round down to one of
+/// these
+pub fn unroll_max() -> u32 {
+    let v = UNROLL_MAX.get_or_init(|| match env::var("NAK_UNROLL_MAX") {
+        Ok(s) => match s.trim().parse::<u32>() {
+            Ok(0) => 0,
+            Ok(v) => 1 << v.ilog2().min(6),
+            _ => {
+                eprintln!("NAK: ignoring NAK_UNROLL_MAX=\"{}\"", s);
+                32
+            }
+        },
+        Err(_) => 32,
+    });
+    *v
+}
+
 /// The knobs packed for nak_gpr_cap_key(), bits 25 and up
 pub fn cache_key_bits() -> u32 {
     (imm_cse_key() << 30)
@@ -176,5 +199,15 @@ pub extern "C" fn nak_knobs_key() -> u32 {
     // NAK_LAT's bits 0-4, 6 and 7 go to bits 2-8
     let lat = lat_mask();
     let lat = (lat & 0x1f) | ((lat >> 1) & 0x60);
-    u32::from(phi_avoid()) | (u32::from(bar_share()) << 1) | (lat << 2)
+    // NAK_UNROLL_MAX: 0 the default 32, 1 none, 2-6 for 1-16, 7 for 64
+    let unroll = match unroll_max() {
+        32 => 0,
+        0 => 1,
+        64 => 7,
+        v => 2 + v.ilog2(),
+    };
+    u32::from(phi_avoid())
+        | (u32::from(bar_share()) << 1)
+        | (lat << 2)
+        | (unroll << 9)
 }
-- 
