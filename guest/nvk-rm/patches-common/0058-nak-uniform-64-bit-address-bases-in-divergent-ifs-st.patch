+/// The first components of the UGPR pairs that OpPin pins.  RA keeps a
+/// pinned pair in its registers for the rest of its live range (OpUnpin,
+/// when there still is one, only ends that early), so a pair that is also
+/// live wherever a value is (see covers) can feed its reloads anywhere.
+fn pinned_pairs(func: &Function) -> FxHashSet<SSAValue> {
+    let mut pairs = FxHashSet::default();
+    for b in func.blocks.iter() {
+        for instr in &b.instrs {
+            if let Op::Pin(op) = &instr.op {
+                if let Some(vec) = op.dst.as_ssa() {
+                    if vec.file() == RegFile::UGPR && vec.comps() == 2 {
+                        pairs.insert(vec[0]);
+                    }
+                }
+            }
+        }
+    }
+    pairs
+}
+
 /// Returns true if UGPR `u` is live wherever GPR `v` is
