+
+/*
+ * Uniform 64-bit address bases in divergent control flow
+ *
+ * In uniform control flow, nak_nir_opt_uniform_address moves the uniform
+ * part of a global memory address into the instruction's UGPR address
+ * source: LDG [Rx.U32 + URy] or LDG [RZ + URy].  In divergent control flow
+ * it cannot, because NAK cannot write UGPRs there and the legalizer copies
+ * every uniform vector that is not pinned to GPRs.  vkd3d-proton shaders do
+ * most of their work under a divergent branch, so every descriptor heap and
+ * root constant buffer access there computed its 64-bit address in GPRs
+ * (MOV R, UR; IADD3; IADD3.X) or reloaded it from the constant buffer (two
+ * LDCs) right before the load.
+ *
+ * For each top-level divergent if, this pass takes the uniform
+ * 64-bit bases of the global loads, stores and atomics inside it that can be
+ * computed before it (ALU, constant buffer loads and immediates; see
+ * can_hoist_def), computes them at the end of the block before it, where
+ * they land in UGPRs, and pins them for the region like the ldcx handles
+ * above.  The memory access then takes the base as its uniform address and
+ * at most a 32-bit GPR offset.  The bases with the most uses go first, up to
+ * a few UGPR pairs per region.
+ */
+
+/* UGPR pairs this pass pins per region, and pinned pairs in total
+ * (including the ldcx handles pinned above).
+ */
+#define UADDR_MAX_PINS 4
+#define UADDR_MAX_TOTAL_PINS 8
+
+static bool
+defs_equal(nir_def *a, nir_def *b, unsigned depth)
+{
+   if (a == b)
+      return true;
+   if (depth == 0 || a->bit_size != b->bit_size ||
+       a->num_components != b->num_components)
+      return false;
+
+   nir_instr *ia = nir_def_instr(a), *ib = nir_def_instr(b);
+   if (ia->type != ib->type)
+      return false;
+
+   switch (ia->type) {
+   case nir_instr_type_load_const:
+      return nir_instrs_equal(ia, ib);
+
+   case nir_instr_type_alu: {
+      nir_alu_instr *x = nir_instr_as_alu(ia), *y = nir_instr_as_alu(ib);
+      if (x->op != y->op)
+         return false;
+      for (unsigned i = 0; i < nir_op_infos[x->op].num_inputs; i++) {
+         unsigned n = nir_ssa_alu_instr_src_components(x, i);
+         if (memcmp(x->src[i].swizzle, y->src[i].swizzle, n) != 0 ||
+             !defs_equal(x->src[i].src.ssa, y->src[i].src.ssa, depth - 1))
+            return false;
+      }
+      return true;
+   }
+
+   case nir_instr_type_intrinsic: {
+      nir_intrinsic_instr *x = nir_instr_as_intrinsic(ia);
+      nir_intrinsic_instr *y = nir_instr_as_intrinsic(ib);
+      if (x->intrinsic != y->intrinsic ||
+          (x->intrinsic != nir_intrinsic_ldc_nv &&
+           x->intrinsic != nir_intrinsic_ldcx_nv))
+         return false;
+      const unsigned num_indices =
+         nir_intrinsic_infos[x->intrinsic].num_indices;
+      if (memcmp(x->const_index, y->const_index,
+                 num_indices * sizeof(x->const_index[0])) != 0)
+         return false;
+      for (unsigned i = 0; i < 2; i++) {
+         if (!defs_equal(x->src[i].ssa, y->src[i].ssa, depth - 1))
+            return false;
+      }
+      return true;
+   }
+
+   default:
+      return false;
+   }
+}
+
+struct uaddr_base {
+   nir_def *def;
+   unsigned uses;
+};
+
+struct uaddr_section {
+   nir_block *pred;
+   struct uaddr_base bases[64];
+   unsigned num_bases;
+};
+
+static nir_src *
+uaddr_offset_src(nir_intrinsic_instr *intr)
+{
+   switch (intr->intrinsic) {
+   case nir_intrinsic_load_global_nv:
+   case nir_intrinsic_store_global_nv:
+   case nir_intrinsic_global_atomic_nv:
+      return nir_get_io_offset_src(intr);
+   default:
+      return NULL;
+   }
+}
+
+static bool
+is_uaddr_base(nir_def *def, nir_block *pred)
+{
+   return def->bit_size == 64 && def->num_components == 1 &&
+          !def->divergent && nir_def_instr(def)->type != nir_instr_type_load_const &&
+          can_hoist_def(def, pred);
+}
+
+/* The uniform base and the GPR offset of an access, if it has them */
+static bool
+uaddr_split(nir_intrinsic_instr *intr, nir_block *pred,
+            nir_def **base_out, nir_def **offset_out)
+{
+   nir_src *offset_src = uaddr_offset_src(intr);
+   if (offset_src == NULL)
+      return false;
+
+   nir_src *uniform_src = nir_get_io_uniform_offset_src(intr);
+   if (!nir_src_is_const(*uniform_src) ||
+       nir_src_as_uint(*uniform_src) != 0)
+      return false;
+
+   nir_def *addr = offset_src->ssa;
+   if (addr->bit_size != 64 || nir_src_is_const(*offset_src))
+      return false;
+
+   if (is_uaddr_base(addr, pred)) {
+      *base_out = addr;
+      *offset_out = NULL;
+      return true;
+   }
+
+   nir_alu_instr *iadd = nir_def_as_alu_or_null(addr);
+   if (iadd == NULL || iadd->op != nir_op_iadd)
+      return false;
+
+   for (unsigned i = 0; i < 2; i++) {
+      nir_def *u = iadd->src[i].src.ssa;
+      nir_def *x = iadd->src[1 - i].src.ssa;
+      if (iadd->src[i].swizzle[0] != 0 || iadd->src[1 - i].swizzle[0] != 0)
+         continue;
+      if (!is_uaddr_base(u, pred))
+         continue;
+
+      /* A zero-extended 32-bit offset is what the .U32 form takes */
+      nir_alu_instr *u2u64 = nir_def_as_alu_or_null(x);
+      if (u2u64 && u2u64->op == nir_op_u2u64 &&
+          u2u64->src[0].src.ssa->num_components == 1)
+         x = u2u64->src[0].src.ssa;
+      if (x->bit_size != 32)
+         continue;
+
+      *base_out = u;
+      *offset_out = x;
+      return true;
+   }
+
+   return false;
+}
+
+static struct uaddr_base *
+uaddr_find_base(struct uaddr_section *s, nir_def *def)
+{
+   for (unsigned i = 0; i < s->num_bases; i++) {
+      if (defs_equal(s->bases[i].def, def, 8))
+         return &s->bases[i];
+   }
+   return NULL;
+}
+
+static void
+uaddr_collect(nir_cf_node *node, struct uaddr_section *s)
+{
+   nir_foreach_block_in_cf_node(block, node) {
+      nir_foreach_instr(instr, block) {
+         if (instr->type != nir_instr_type_intrinsic)
+            continue;
+
+         nir_def *base, *offset;
+         if (!uaddr_split(nir_instr_as_intrinsic(instr), s->pred,
+                          &base, &offset))
+            continue;
+
+         struct uaddr_base *b = uaddr_find_base(s, base);
+         if (b != NULL) {
+            b->uses++;
+         } else if (s->num_bases < ARRAY_SIZE(s->bases)) {
+            s->bases[s->num_bases++] = (struct uaddr_base) {
+               .def = base,
+               .uses = 1,
+            };
+         }
+      }
+   }
+}
+
+static int
+cmp_uaddr_bases(const void *_a, const void *_b)
+{
+   const struct uaddr_base *a = _a, *b = _b;
+   if (a->uses != b->uses)
+      return a->uses > b->uses ? -1 : 1;
+   return a->def->index < b->def->index ? -1 : (a->def->index > b->def->index);
+}
+
+static unsigned
+count_pins_at_end(nir_block *block)
+{
+   unsigned n = 0;
+   nir_foreach_instr(instr, block) {
+      if (instr->type == nir_instr_type_intrinsic &&
+          nir_instr_as_intrinsic(instr)->intrinsic ==
+             nir_intrinsic_pin_cx_handle_nv)
+         n++;
+   }
+   return n;
+}
+
+static bool
+pin_uniform_addresses_region(nir_builder *b, nir_cf_node *node,
+                             nir_block *pred, nir_block *succ)
+{
+   struct uaddr_section s = { .pred = pred };
+   uaddr_collect(node, &s);
+   if (s.num_bases == 0)
+      return false;
+
+   const unsigned pinned = count_pins_at_end(pred);
+   if (pinned >= UADDR_MAX_TOTAL_PINS)
+      return false;
+   unsigned max_pins = MIN2(UADDR_MAX_PINS, UADDR_MAX_TOTAL_PINS - pinned);
+
+   qsort(s.bases, s.num_bases, sizeof(s.bases[0]), cmp_uaddr_bases);
+   s.num_bases = MIN2(s.num_bases, max_pins);
+
+   /* Compute the chosen bases before the region and pin them there */
+   for (unsigned i = 0; i < s.num_bases; i++)
+      hoist_def(s.bases[i].def, pred);
+
+   b->cursor = nir_after_block(pred);
+   for (unsigned i = 0; i < s.num_bases; i++)
+      nir_pin_cx_handle_nv(b, s.bases[i].def);
+
+   b->cursor = nir_before_block_after_phis(succ);
+   for (unsigned i = 0; i < s.num_bases; i++)
+      nir_unpin_cx_handle_nv(b, s.bases[i].def);
+
+   /* Rewrite the accesses that use one of them */
+   nir_foreach_block_in_cf_node(block, node) {
+      nir_foreach_instr(instr, block) {
+         if (instr->type != nir_instr_type_intrinsic)
+            continue;
+
+         nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+         nir_def *base, *offset;
+         if (!uaddr_split(intr, pred, &base, &offset))
+            continue;
+
+         struct uaddr_base *ub = NULL;
+         for (unsigned i = 0; i < s.num_bases; i++) {
+            if (defs_equal(s.bases[i].def, base, 8)) {
+               ub = &s.bases[i];
+               break;
+            }
+         }
+         if (ub == NULL)
+            continue;
+
+         b->cursor = nir_before_instr(instr);
+         if (offset == NULL)
+            offset = nir_imm_int64(b, 0);
+         nir_src_rewrite(uaddr_offset_src(intr), offset);
+         nir_src_rewrite(nir_get_io_uniform_offset_src(intr), ub->def);
+      }
+   }
+
+   return true;
+}
+
+static bool
+pin_uniform_addresses_cf_list(nir_builder *b, struct exec_list *cf_list)
+{
+   bool progress = false;
+
+   nir_block *block = NULL;
+   foreach_list_typed_safe(nir_cf_node, node, node, cf_list) {
+      switch (node->type) {
+      case nir_cf_node_block:
+         block = nir_cf_node_as_block(node);
+         continue;
+
+      case nir_cf_node_if: {
+         nir_if *nif = nir_cf_node_as_if(node);
+         if (nir_src_is_divergent(&nif->condition)) {
+            nir_block *succ = nir_cf_node_as_block(nir_cf_node_next(node));
+            progress |= pin_uniform_addresses_region(b, node, block, succ);
+         } else {
+            progress |= pin_uniform_addresses_cf_list(b, &nif->then_list);
+            progress |= pin_uniform_addresses_cf_list(b, &nif->else_list);
+         }
+         break;
+      }
+
+      case nir_cf_node_loop: {
+         nir_loop *loop = nir_cf_node_as_loop(node);
+         if (nir_loop_is_divergent(loop)) {
+            /* Not for divergent loops: there the pinned bases change what
+             * the occupancy target (NAK_OCC_TARGET) expects spilling to
+             * cost, and on the two big Steel Nomad compute shaders it then
+             * keeps 8 warps instead of 12.
+             */
+         } else {
+            progress |= pin_uniform_addresses_cf_list(b, &loop->body);
+            progress |= pin_uniform_addresses_cf_list(b, &loop->continue_list);
+         }
+         break;
+      }
+
+      default:
+         UNREACHABLE("Unknown CF node type");
+      }
+   }
+
+   return progress;
+}
+
+bool
+nak_nir_pin_uniform_addresses(nir_shader *nir)
+{
+   if (nak_debug_no_ugpr() || !nak_knob_uaddr_pin())
+      return false;
+
+   nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+   nir_builder b = nir_builder_create(impl);
+
+   nir_metadata_require(impl, nir_metadata_block_index |
+                              nir_metadata_divergence);
+
+   bool progress = pin_uniform_addresses_cf_list(&b, &impl->body);
+   return nir_progress(progress, impl, nir_metadata_none);
+}
