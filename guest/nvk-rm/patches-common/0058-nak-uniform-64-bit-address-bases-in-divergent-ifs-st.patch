+++ b/src/nouveau/compiler/nak/knobs.rs
@@ -10,11 +10,33 @@
 //! - NAK_IMM_CSE: a register copy of an immediate serves the next uses in
 //!   its block (legalizer).  Default: compute shaders only, where it never
 //!   cost occupancy in the corpora tried; 1: every stage
+//! - NAK_UADDR_PIN (default on): 64-bit uniform address bases of global
+//!   memory accesses in divergent ifs stay in pinned UGPRs (nak_nir.c)
 
 use std::env;
 use std::sync::OnceLock;
 
+fn parse(
+    name: &str,
+    var: Result<String, env::VarError>,
+    default: bool,
+) -> bool {
+    match var {
+        Ok(s) => match s.trim() {
+            "" => default,
+            "1" => true,
+            "0" => false,
+            other => {
+                eprintln!("NAK: ignoring {}=\"{}\" (not 0 or 1)", name, other);
+                default
+            }
+        },
+        Err(_) => default,
+    }
+}
+
 static IMM_CSE: OnceLock<Option<bool>> = OnceLock::new();
+static UADDR_PIN: OnceLock<bool> = OnceLock::new();
 
 /// NAK_IMM_CSE for a shader: compute shaders unless set
 pub fn imm_cse(compute: bool) -> bool {
@@ -38,7 +60,17 @@ fn imm_cse_key() -> u32 {
     }
 }
 
+pub fn uaddr_pin() -> bool {
+    *UADDR_PIN
+        .get_or_init(|| parse("NAK_UADDR_PIN", env::var("NAK_UADDR_PIN"), true))
+}
+
 /// The knobs packed for nak_gpr_cap_key(), bits 25 and up
 pub fn cache_key_bits() -> u32 {
-    imm_cse_key() << 30
+    (imm_cse_key() << 30) | (u32::from(uaddr_pin()) << 26)
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn nak_knob_uaddr_pin() -> bool {
+    uaddr_pin()
 }
