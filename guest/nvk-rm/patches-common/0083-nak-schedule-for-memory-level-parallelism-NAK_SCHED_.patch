 use std::env;
 use std::sync::OnceLock;
@@ -103,6 +107,31 @@ static UNIFORM_ATOMICS: OnceLock<bool> = OnceLock::new();
 static F16_CVT: OnceLock<bool> = OnceLock::new();
 static LOOP_CONT_SYNC: OnceLock<bool> = OnceLock::new();
 static EARLY_EXIT: OnceLock<bool> = OnceLock::new();
+static SCHED_MLP: OnceLock<u32> = OnceLock::new();
+
+/// NAK_SCHED_MLP (0-3, default 0): memory-level parallelism in the
+/// instruction schedulers.  The schedulers model a global, local or
+/// texture access as 32 cycles, so a load is placed about ten instructions
+/// before its use, and a warp whose loads do not depend on each other still
+/// waits for them one at a time.  With 1, 2 or 3 they are modeled as
+/// 160/120, 320/240 or 640/480 cycles (global and local memory/texture and
+/// surface), so independent loads are issued as early as their operands and
+/// the register target allow, and a variable-latency instruction that finds
+/// all six scoreboards busy shares one (as NAK_BAR_SHARE) instead of waiting
+/// for the oldest
+pub fn sched_mlp() -> u32 {
+    let v = SCHED_MLP.get_or_init(|| match env::var("NAK_SCHED_MLP") {
+        Ok(s) => match s.trim().parse::<u32>() {
+            Ok(v) if v <= 3 => v,
+            _ => {
+                eprintln!("NAK: ignoring NAK_SCHED_MLP=\"{}\" (not 0-3)", s);
+                0
+            }
+        },
+        Err(_) => 0,
+    });
+    *v
+}
 
 /// NAK_IMM_CSE for a shader: compute shaders unless set
 pub fn imm_cse(compute: bool) -> bool {
@@ -303,4 +332,5 @@ pub extern "C" fn nak_knobs_key() -> u32 {
         | (u32::from(f16_cvt()) << 15)
         | (u32::from(!loop_cont_sync()) << 16)
         | (u32::from(early_exit()) << 17)
+        | (sched_mlp() << 18)
 }
