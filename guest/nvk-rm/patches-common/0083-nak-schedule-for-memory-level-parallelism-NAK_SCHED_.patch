@@ -255,11 +255,78 @@ pub fn estimate_block_weight(cfg: &CFG<BasicBlock>, block_idx: usize) -> u64 {
 /// Memory instructions were copied from L1 data cache latencies.
 /// For instructions not mentioned in the paper, I made up numbers.
 /// This could probably be improved.
+/// NAK_SCHED_MLP: what a global, local, texture or surface access costs
+/// once it misses L1 (an L2 round trip and more), not the 32 cycles of an
+/// L1 hit, so the schedulers put independent loads far enough ahead of
+/// their uses to have several in flight.  1: 320 cycles (memory) / 240
+/// (texture, surface); 2 and 3: 640 / 480
+fn mlp_latency(op: &Op, level: u32) -> Option<u32> {
+    if level == 0 {
+        return None;
+    }
+    let (mem, tex) = match level {
+        1 => (320, 240),
+        _ => (640, 480),
+    };
+    if is_mlp_mem(op) {
+        Some(if matches!(op, Op::Ld(_) | Op::Atom(_)) { mem } else { tex })
+    } else {
+        None
+    }
+}
+
+/// NAK_SCHED_MLP: a read of memory that nothing the shader does can
+/// change (a constant-order load: read-only buffers; a texture read), which
+/// needs no order against the shader's other memory operations
+pub fn is_read_only_mem(op: &Op) -> bool {
+    match op {
+        Op::Ld(ld) => matches!(ld.access.order, MemOrder::Constant),
+        Op::Tex(_)
+        | Op::Tld(_)
+        | Op::Tld4(_)
+        | Op::Tmml(_)
+        | Op::Txd(_)
+        | Op::Txq(_) => true,
+        _ => false,
+    }
+}
+
+/// A global or local memory, texture or surface access whose result
+/// NAK_SCHED_MLP schedules for: what misses L1 and goes to L2 or further
+pub fn is_mlp_mem(op: &Op) -> bool {
+    match op {
+        Op::Ld(ld) => !matches!(ld.access.space, MemSpace::Shared),
+        Op::Atom(atom) => !matches!(atom.mem_space, MemSpace::Shared),
+        Op::Tex(_)
+        | Op::Tld(_)
+        | Op::Tld4(_)
+        | Op::Tmml(_)
+        | Op::Txd(_)
+        | Op::SuLd(_)
+        | Op::SuAtom(_)
+        | Op::SuLdGa(_) => true,
+        _ => false,
+    }
+}
+
 pub fn estimate_variable_latency(sm: &ShaderModelInfo, op: &Op) -> u32 {
+    estimate_variable_latency_mlp(sm, op, crate::knobs::sched_mlp())
+}
+
+/// estimate_variable_latency() at a given NAK_SCHED_MLP level
+pub fn estimate_variable_latency_mlp(
+    sm: &ShaderModelInfo,
+    op: &Op,
+    mlp: u32,
+) -> u32 {
     if !sm.op_needs_scoreboard(op) {
         return 0;
     }
 
+    if let Some(latency) = mlp_latency(op, mlp) {
+        return latency;
+    }
+
     match op {
         // Multi-function unit
         Op::Rro(_) | Op::MuFu(_) => 15,
@@ -353,6 +420,10 @@ pub struct NodeLabel {
