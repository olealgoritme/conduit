 src/nouveau/vulkan/nvk_cmd_buffer.h | 21 ++++++++
 src/nouveau/vulkan/nvk_cmd_clear.c  | 78 +++++++++++++++++++++++++++++
 src/nouveau/vulkan/nvk_cmd_draw.c   | 57 ++++++++++++++++++---
 src/nouveau/vulkan/nvk_cmd_meta.c   | 18 +++++++
 src/nouveau/vulkan/nvk_image.c      | 12 ++++-
 src/nouveau/vulkan/nvk_image.h      | 19 +++++++
