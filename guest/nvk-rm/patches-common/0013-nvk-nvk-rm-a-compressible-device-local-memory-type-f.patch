index 199c1e9..fb592f9 100644
--- a/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_pdev.c
+++ b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_pdev.c
@@ -431,10 +431,24 @@ nvkmd_rm_try_create_pdev(const struct nvkmd_rm_lib *lib,
     * as a whole and sub-allocated images compressed by their PTE kind
     * (nvkmd_rm_mem.c).  Off by default (NVK_RM_COMPRESS_ALL=1 turns it on).
     */
-   pdev->base.kmd_info.has_compressible_mem =
+   pdev->base.kmd_info.compress_all_mem =
       pdev->base.kmd_info.has_compression &&
