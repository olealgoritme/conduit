diff --git a/src/nouveau/vulkan/nvk_buffer.c b/src/nouveau/vulkan/nvk_buffer.c
index 58f01b0..95500ff 100644
--- a/src/nouveau/vulkan/nvk_buffer.c
+++ b/src/nouveau/vulkan/nvk_buffer.c
@@ -189,10 +189,22 @@ nvk_GetDeviceBufferMemoryRequirements(
                                pInfo->pCreateInfo->usage,
                                pInfo->pCreateInfo->flags);
 
+   /* Compressible memory only for buffers the copy engine alone touches
+    * (vkd3d-proton's and DXVK's clear buffers over image memory).  The spec
+    * lets a buffer with fewer usage bits allow more memory types.
+    */
+   uint32_t memory_types = BITFIELD_MASK(pdev->mem_type_count);
+   const VkBufferUsageFlags2KHR transfer_usage =
+      VK_BUFFER_USAGE_2_TRANSFER_SRC_BIT_KHR |
+      VK_BUFFER_USAGE_2_TRANSFER_DST_BIT_KHR;
+   if ((vk_buffer_usage_flags(pInfo->pCreateInfo) & ~transfer_usage) ||
+       (pInfo->pCreateInfo->flags & VK_BUFFER_CREATE_SPARSE_BINDING_BIT))
+      memory_types &= ~pdev->compressed_mem_types;
+
    pMemoryRequirements->memoryRequirements = (VkMemoryRequirements) {
       .size = align64(pInfo->pCreateInfo->size, alignment),
       .alignment = alignment,
-      .memoryTypeBits = BITFIELD_MASK(pdev->mem_type_count),
+      .memoryTypeBits = memory_types,
    };
 
    vk_foreach_struct(sType, ext, pMemoryRequirements->pNext) {
diff --git a/src/nouveau/vulkan/nvk_cmd_indirect.c b/src/nouveau/vulkan/nvk_cmd_indirect.c
index f276955..0859a22 100644
--- a/src/nouveau/vulkan/nvk_cmd_indirect.c
+++ b/src/nouveau/vulkan/nvk_cmd_indirect.c
@@ -1041,7 +1041,8 @@ nvk_GetGeneratedCommandsMemoryRequirementsEXT(
    pMemoryRequirements->memoryRequirements = (VkMemoryRequirements) {
       .size = size,
       .alignment = NAK_QMD_ALIGN_B,
-      .memoryTypeBits = BITFIELD_MASK(pdev->mem_type_count),
+      .memoryTypeBits = BITFIELD_MASK(pdev->mem_type_count) &
+                        ~pdev->compressed_mem_types,
    };
 }
 
diff --git a/src/nouveau/vulkan/nvk_device_memory.c b/src/nouveau/vulkan/nvk_device_memory.c
index fcb7116..7db3a29 100644
--- a/src/nouveau/vulkan/nvk_device_memory.c
+++ b/src/nouveau/vulkan/nvk_device_memory.c
@@ -86,6 +86,15 @@ nvk_compressible_mem_flags(const struct nvk_physical_device *pdev,
        (type->propertyFlags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT))
       return 0;
 
+   /* The compressible memory type (NVK_RM_COMPRESS_TYPE), or every
+    * device-local type (NVK_RM_COMPRESS_ALL).  Exported memory of the
+    * compressible type is allocated uncompressed (not_shared above).
+    */
+   const uint32_t type_bit = BITFIELD_BIT(type - pdev->mem_types);
+   if (!(pdev->compressed_mem_types & type_bit) &&
+       !pdev->nvkmd->kmd_info.compress_all_mem)
+      return 0;
+
    return NVKMD_MEM_COMPRESSIBLE;
 }
 
@@ -122,6 +131,10 @@ nvk_GetMemoryFdPropertiesKHR(VkDevice device,
    uint32_t type_bits = 0;
    for (unsigned t = 0; t < ARRAY_SIZE(pdev->mem_types); t++) {
       const VkMemoryType *type = &pdev->mem_types[t];
+
+      /* Imports never go in the compressible memory type */
+      if (pdev->compressed_mem_types & BITFIELD_BIT(t))
+         continue;
       const enum nvkmd_mem_flags type_flags =
          nvk_memory_type_flags(type, handleType, false);
 
@@ -334,7 +347,12 @@ nvk_AllocateMemory(VkDevice device,
       if (result != VK_SUCCESS)
          goto fail_alloc;
    } else {
-      flags |= nvk_compressible_mem_flags(pdev, type, not_shared);
+      /* Not for a dedicated image that is not compressed itself: nothing
+       * to gain, and such memory may still be exported with the image's
+       * uncompressed layout (Helios).
+       */
+      if (mem->dedicated_image == NULL)
+         flags |= nvk_compressible_mem_flags(pdev, type, not_shared);
       result = nvkmd_dev_alloc_mem(dev->nvkmd, &dev->vk.base,
                                    aligned_size, alignment, flags,
                                    &mem->mem);
diff --git a/src/nouveau/vulkan/nvk_image.c b/src/nouveau/vulkan/nvk_image.c
index 21b3266..4421567 100644
--- a/src/nouveau/vulkan/nvk_image.c
+++ b/src/nouveau/vulkan/nvk_image.c
@@ -1388,6 +1388,30 @@ nvk_get_image_memory_requirements(struct nvk_device *dev,
       }
    }
 
+   /* Compressible memory types (NVK_RM_COMPRESS_TYPE): every optimal-tiling
+    * image may use them, compressible or not, since for a color format the
+    * spec lets memoryTypeBits depend on the tiling, sparse, protected and
+    * host transfer bits and the external handle types but not on the usage
+    * or format.  An image that is not compressed is mapped with the
+    * compressible kind there all the same (nvkmd_rm_va.c).  Video images are
+    * left out (the video engines have not been tried on compressible
+    * memory).
+    */
+   const VkImageUsageFlags video_usage =
+      VK_IMAGE_USAGE_VIDEO_DECODE_DST_BIT_KHR |
+      VK_IMAGE_USAGE_VIDEO_DECODE_SRC_BIT_KHR |
+      VK_IMAGE_USAGE_VIDEO_DECODE_DPB_BIT_KHR |
+      VK_IMAGE_USAGE_VIDEO_ENCODE_DST_BIT_KHR |
+      VK_IMAGE_USAGE_VIDEO_ENCODE_SRC_BIT_KHR |
+      VK_IMAGE_USAGE_VIDEO_ENCODE_DPB_BIT_KHR;
+   if (image->vk.tiling != VK_IMAGE_TILING_OPTIMAL ||
+       (image->vk.create_flags & (VK_IMAGE_CREATE_SPARSE_BINDING_BIT |
+                                  VK_IMAGE_CREATE_PROTECTED_BIT)) ||
+       (image->vk.usage & (VK_IMAGE_USAGE_HOST_TRANSFER_BIT_EXT |
+                           video_usage)) ||
+       image->vk.external_handle_types != 0)
+      memory_types &= ~pdev->compressed_mem_types;
+
    uint64_t size_B = 0;
    uint32_t align_B = 0;
    if (image->disjoint) {
