       if (nvkmd->kmd_info.has_get_vram_used)
          pdev->mem_heaps[vram_heap_idx].available = nvk_get_vram_heap_available;
 
+      /* Compressible VRAM, before plain VRAM in the same heap so that
+       * allocators which take the first type an image allows (vkd3d-proton,
+       * DXVK) pick it for images.  Only images and transfer-only buffers
+       * report it (nvk_image.c, nvk_buffer.c).
+       */
+      if (nvkmd->kmd_info.has_compressed_mem_type) {
+         mesa_logi("NVK: memory type %u is compressible VRAM, for images "
+                   "and transfer-only buffers (NVK_RM_COMPRESS_TYPE)",
+                   pdev->mem_type_count);
+         pdev->compressed_mem_types |= BITFIELD_BIT(pdev->mem_type_count);
+         pdev->mem_types[pdev->mem_type_count++] = (VkMemoryType) {
+            .propertyFlags = VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT,
+            .heapIndex = vram_heap_idx,
+         };
+      }
+
       pdev->mem_types[pdev->mem_type_count++] = (VkMemoryType) {
          .propertyFlags = VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT,
          .heapIndex = vram_heap_idx,
