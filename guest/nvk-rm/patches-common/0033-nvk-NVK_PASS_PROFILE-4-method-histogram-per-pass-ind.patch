+static void
+prof_log_hist(struct nvk_pass_profile *prof, const struct prof_hist *h)
+{
+   /* The 24 most written 3D methods, per recorded pass */
+   uint32_t top[24];
+   unsigned ntop = 0;
+   for (uint32_t m = 0; m < PROF_HIST_3D; m++) {
+      if (h->mthd[m] == 0)
+         continue;
+      unsigned pos = ntop;
+      while (pos > 0 && h->mthd[top[pos - 1]] < h->mthd[m])
+         pos--;
+      if (pos >= ARRAY_SIZE(top))
+         continue;
+      if (ntop < ARRAY_SIZE(top))
+         ntop++;
+      memmove(&top[pos + 1], &top[pos], (ntop - 1 - pos) * sizeof(top[0]));
+      top[pos] = m;
+   }
+   const double n = (double)h->passes;
+   uint64_t other = 0;
+   for (unsigned i = 0; i < 8; i++)
+      other += h->other_subc[i];
+   prof_log(prof, "NVK pass profile:            methods per pass (%" PRIu64
+            " passes recorded; other subchannels %.1f):", h->passes,
+            other / n);
+   for (unsigned i = 0; i < ntop; i++) {
+      const uint32_t addr = top[i] << 2;
+      char name[96];
+      if (addr >= NVC597_CALL_MME_MACRO(0) &&
+          addr < NVC597_CALL_MME_MACRO(NVK_MME_COUNT)) {
+         const uint32_t macro = (addr - NVC597_CALL_MME_MACRO(0)) / 8;
+         const bool param = (addr - NVC597_CALL_MME_MACRO(0)) % 8 != 0;
+         snprintf(name, sizeof(name), "%s MME %s",
+                  param ? "param" : "CALL",
+                  prof_mme_names[macro] ? prof_mme_names[macro] : "?");
+      } else {
+         snprintf(name, sizeof(name), "%s", P_PARSE_NVCD97_MTHD(addr));
+      }
+      prof_log(prof, "NVK pass profile:              %9.1f  %04x %s",
+               h->mthd[top[i]] / n, addr, name);
+   }
+}
+
