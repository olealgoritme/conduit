+/* NVK_PASS_PROFILE=4: count the methods of [p, end) into hist */
+static void
+prof_hist_scan(struct prof_hist *hist, const uint32_t *p, const uint32_t *end)
+{
+   while (p < end) {
+      const uint32_t hdr = *p++;
+      const uint32_t type = NVVAL_GET(hdr, NV906F, DMA, SEC_OP);
+      const uint32_t subc = NVVAL_GET(hdr, NV906F, DMA, METHOD_SUBCHANNEL);
+      const uint32_t mthd = NVVAL_GET(hdr, NV906F, DMA, METHOD_ADDRESS);
+      uint32_t count = NVVAL_GET(hdr, NV906F, DMA, METHOD_COUNT);
+      uint32_t inc;
+      switch (type) {
+      case NV906F_DMA_SEC_OP_IMMD_DATA_METHOD:
+         count = 1;
+         inc = 0;
+         break;
+      case NV906F_DMA_SEC_OP_INC_METHOD:
+         inc = 2; /* every dword */
+         break;
+      case NV906F_DMA_SEC_OP_NON_INC_METHOD:
+         inc = 0;
+         break;
+      case NV906F_DMA_SEC_OP_ONE_INC:
+         inc = 1;
+         break;
+      default:
+         return; /* not something NVK records */
+      }
+      for (uint32_t i = 0; i < count; i++) {
+         const uint32_t m = inc == 2 ? mthd + i :
+                            inc == 1 ? mthd + (i > 0) : mthd;
+         if (subc == SUBC_NV9097)
+            hist->mthd[m % PROF_HIST_3D]++;
+         else
+            hist->other_subc[subc & 7]++;
+      }
+      if (type != NV906F_DMA_SEC_OP_IMMD_DATA_METHOD)
+         p += count;
+   }
+}
+
+static void
+prof_hist_end_pass(struct nvk_cmd_buffer *cmd)
+{
+   struct nvk_device *dev = nvk_cmd_buffer_device(cmd);
+   struct nvk_pass_profile *prof = dev->pass_profile;
+   const uint32_t sig = cmd->pass_profile_hist_sig;
+   cmd->pass_profile_hist_sig = 0;
+   if (sig == 0 || cmd->pass_profile_hist_start == NULL)
+      return;
+
+   simple_mtx_lock(&prof->mutex);
+   struct prof_sig *ps = &prof->sigs[sig - 1];
+   if (ps->hist == NULL)
+      ps->hist = calloc(1, sizeof(*ps->hist));
+   struct prof_hist *hist = ps->hist;
+   if (hist != NULL) {
+      hist->passes++;
+      const uint32_t n = util_dynarray_num_elements(&cmd->pushes,
+                                                    struct nvk_cmd_push);
+      const uint32_t *start = cmd->pass_profile_hist_start;
+      bool in_current = true;
+      for (uint32_t i = cmd->pass_profile_hist_npushes; i < n; i++) {
+         const struct nvk_cmd_push *push =
+            util_dynarray_element(&cmd->pushes, struct nvk_cmd_push, i);
+         if (push->map == NULL || push->range == 0)
+            continue; /* indirect data, not methods */
+         const uint32_t *b = push->map;
+         const uint32_t *e = b + push->range / 4;
+         if (i == cmd->pass_profile_hist_npushes && start >= b && start <= e)
+            b = start;
+         prof_hist_scan(hist, b, e);
+         in_current = false;
+      }
+      const uint32_t *b = in_current ? start : cmd->push.start;
+      if (b >= cmd->push.start && b <= cmd->push.end)
+         prof_hist_scan(hist, b, cmd->push.end);
+   }
+   simple_mtx_unlock(&prof->mutex);
+}
