@@ -445,6 +457,8 @@ VkResult nvkmd_rm_create_dev(struct nvkmd_pdev *pdev,
  * Memory
  */
 
+struct nvkmd_rm_slab;
+
 struct nvkmd_rm_mem {
    struct nvkmd_mem base;
 
@@ -464,6 +478,13 @@ struct nvkmd_rm_mem {
     */
    void *os_pages;
 
+   /* A range of a shared slab (small system memory): h_memory and os_pages
