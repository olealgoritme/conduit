+++ b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_dev.c
@@ -237,6 +237,9 @@ nvkmd_rm_create_dev(struct nvkmd_pdev *_pdev,
    nvkmd_rm_dev_init_nonstall_event(dev);
 
