       return vk_error(dev, VK_ERROR_OUT_OF_HOST_MEMORY);
 
    list_inithead(&pool->sets);
+   /* Initialized before anything can fail: nvk_destroy_descriptor_pool()
+    * finishes the heap on the error paths below too.
+    */
+   util_vma_heap_init(&pool->heap, 0, 0);
 
    const VkMutableDescriptorTypeCreateInfoEXT *mutable_info =
       vk_find_struct_const(pCreateInfo->pNext,
@@ -713,9 +717,8 @@ nvk_CreateDescriptorPool(VkDevice _device,
          mem_size = pool->mem->size_B;
       }
 
