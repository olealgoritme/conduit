diff --git a/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_mem.c b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_mem.c
index 25cdb17..0cecdda 100644
--- a/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_mem.c
+++ b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_mem.c
@@ -10,6 +10,7 @@
 #include "util/log.h"
 #include "util/u_atomic.h"
 #include "util/os_misc.h"
+#include "util/os_time.h"
 #include "util/u_math.h"
 #include "vk_log.h"
 
@@ -307,6 +308,177 @@ nvkmd_rm_alloc_mem(struct nvkmd_dev *dev,
                                    flags, mem_out);
 }
 
+/* Small system memory in shared slabs
+ *
+ * Every system memory allocation NVK makes on Windows is our own pages
+ * registered with RM (alloc_os_pages): one pin in the Helios KMD, which
+ * holds at most a few hundred per process, and a table of page runs that the
+ * host maps into its address space one run at a time.  NVK makes many small
+ * ones (64 KiB command buffer chunks, descriptor pools, query pools, upload
+ * streams), and a native Vulkan application making several thousand ran out
+ * of pins: the fallback, RM's own system memory, needs a KMD handle for each
+ * CPU mapping and ran out of those next, and pipeline and descriptor pool
+ * creation failed with VK_ERROR_MEMORY_MAP_FAILED.
+ *
+ * So allocations up to NVKMD_RM_SLAB_MAX_ALLOC_B share 4 MiB slabs, each one
+ * registration: a range of a slab is mapped on the GPU from the slab's RM
+ * object at its offset, and on the CPU it is the slab's pages at that offset.
+ * Memory that is shared, tiled, VRAM or that RM itself must name by handle
+ * (NVKMD_RM_MEM_RM_SYSMEM) keeps an allocation of its own.
+ * NVK_RM_SYSMEM_SLABS=0 turns this off.
+ */
+#define NVKMD_RM_SLAB_SIZE_B (4ull << 20)
+#define NVKMD_RM_SLAB_MAX_ALLOC_B (512ull << 10)
+/* util_vma_heap answers 0 for "no room": offsets are biased by this */
+#define NVKMD_RM_SLAB_BASE NVKMD_RM_SLAB_SIZE_B
+
+struct nvkmd_rm_slab {
+   struct list_head link;
+   uint32_t h_memory;
+   void *pages;
+   struct util_vma_heap heap;
+   uint32_t live;
+};
+
+static void
+slab_destroy(struct nvkmd_rm_dev *dev, struct nvkmd_rm_slab *slab)
+{
+   list_del(&slab->link);
+   util_vma_heap_finish(&slab->heap);
+   nvkmd_rm_free_memory(dev, slab->h_memory);
+   dev->lib->free_pages(dev->client, slab->pages, NVKMD_RM_SLAB_SIZE_B);
+   FREE(slab);
+}
+
+/* A range in a slab that has room, under slab_mutex; false if none has */
+static bool
+slab_take_locked(struct nvkmd_rm_dev *dev, uint64_t size_B, uint64_t align_B,
+                 struct nvkmd_rm_slab **slab_out, uint64_t *offset_B_out)
+{
+   list_for_each_entry(struct nvkmd_rm_slab, slab, &dev->slabs, link) {
+      const uint64_t addr = util_vma_heap_alloc(&slab->heap, size_B, align_B);
+      if (addr != 0) {
+         slab->live++;
+         *slab_out = slab;
+         *offset_B_out = addr - NVKMD_RM_SLAB_BASE;
+         return true;
+      }
+   }
+   return false;
+}
+
+static VkResult
+slab_alloc(struct nvkmd_rm_dev *dev, struct vk_object_base *log_obj,
+           uint64_t size_B, uint64_t align_B,
+           struct nvkmd_rm_slab **slab_out, uint64_t *offset_B_out)
+{
+   simple_mtx_lock(&dev->slab_mutex);
+   bool found = slab_take_locked(dev, size_B, align_B, slab_out, offset_B_out);
+   /* After a refused registration (the pin quota is spent), new slabs are
+    * not tried again for a while: each attempt is a 4 MiB VirtualAlloc and
+    * a KMD call that would only be refused again.
+    */
+   const bool backoff = !found && dev->slab_refused_until != 0 &&
+                        os_time_get_nano() < dev->slab_refused_until;
+   simple_mtx_unlock(&dev->slab_mutex);
+   if (found)
+      goto zero;
+   if (backoff)
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+
+   /* Registered outside the lock: frees on other threads (deferred ones on
+    * submit paths among them) go on meanwhile.
+    */
+   struct nvkmd_rm_slab *slab = CALLOC_STRUCT(nvkmd_rm_slab);
+   if (slab == NULL)
+      return vk_error(log_obj, VK_ERROR_OUT_OF_HOST_MEMORY);
+
+   VkResult result = alloc_os_pages(dev, log_obj, NVKMD_RM_SLAB_SIZE_B,
+                                    &slab->h_memory, &slab->pages);
+   if (result != VK_SUCCESS) {
+      FREE(slab);
+      simple_mtx_lock(&dev->slab_mutex);
+      dev->slab_refused_until = os_time_get_nano() + 1000000000ull;
+      simple_mtx_unlock(&dev->slab_mutex);
+      return result;
+   }
+
+   util_vma_heap_init(&slab->heap, NVKMD_RM_SLAB_BASE, NVKMD_RM_SLAB_SIZE_B);
+   slab->heap.alloc_high = false;
+
+   simple_mtx_lock(&dev->slab_mutex);
+   dev->slab_refused_until = 0;
+   /* New slabs go first: older ones fill up again as their ranges are freed */
+   list_add(&slab->link, &dev->slabs);
+   /* Another thread may have freed or added room meanwhile: any slab will do */
+   found = slab_take_locked(dev, size_B, align_B, slab_out, offset_B_out);
+   assert(found);
+   const bool in_new_slab = *slab_out == slab;
+   if (!in_new_slab) {
+      /* The range came from a slab another thread added meanwhile: ours
+       * stays empty, and is freed unless it is the only empty one
+       */
+      bool other_empty = false;
+      list_for_each_entry(struct nvkmd_rm_slab, s, &dev->slabs, link) {
+         if (s != slab && s->live == 0)
+            other_empty = true;
+      }
+      if (other_empty)
+         slab_destroy(dev, slab);
+   }
+   simple_mtx_unlock(&dev->slab_mutex);
+
+   /* A new slab's pages are zero (VirtualAlloc); a range from another one
+    * may have been used before
+    */
+   if (in_new_slab)
+      return VK_SUCCESS;
+
+zero:
+   /* A reused range holds what its last owner left.  Every system memory
+    * allocation used to be fresh, zeroed pages, and applications rely on
+    * that more than the spec allows; a memset of at most 512 KiB costs far
+    * less than the registration it replaces.
+    */
+   memset((char *)(*slab_out)->pages + *offset_B_out, 0, size_B);
+   return VK_SUCCESS;
+}
+
+static void
+slab_free(struct nvkmd_rm_dev *dev, struct nvkmd_rm_slab *slab,
+          uint64_t offset_B, uint64_t size_B)
+{
+   simple_mtx_lock(&dev->slab_mutex);
+
+   util_vma_heap_free(&slab->heap, NVKMD_RM_SLAB_BASE + offset_B, size_B);
+   assert(slab->live > 0);
+   if (--slab->live == 0) {
+      /* Keep one empty slab for the next allocation, free the others */
+      bool other_empty = false;
+      list_for_each_entry(struct nvkmd_rm_slab, s, &dev->slabs, link) {
+         if (s != slab && s->live == 0)
+            other_empty = true;
+      }
+      if (other_empty)
+         slab_destroy(dev, slab);
+   }
+
+   simple_mtx_unlock(&dev->slab_mutex);
+}
+
+void
+nvkmd_rm_slabs_finish(struct nvkmd_rm_dev *dev)
+{
+   list_for_each_entry_safe(struct nvkmd_rm_slab, slab, &dev->slabs, link) {
+      if (slab->live != 0) {
+         mesa_logw("NVK: a system memory slab still holds %u allocations at "
+                   "device destruction", slab->live);
+      }
+      slab_destroy(dev, slab);
+   }
+   simple_mtx_destroy(&dev->slab_mutex);
+}
+
 VkResult
 nvkmd_rm_alloc_tiled_mem(struct nvkmd_dev *_dev,
                          struct vk_object_base *log_obj,
@@ -483,7 +655,20 @@ nvkmd_rm_alloc_tiled_mem(struct nvkmd_dev *_dev,
          }
       }
    }
-   if (!vram) {
+   bool slab_done = false;
+   if (!vram && dev->slabs_enabled && !force_rm_sysmem &&
+       size_B <= NVKMD_RM_SLAB_MAX_ALLOC_B && pte_kind == 0 &&
+       tile_mode == 0 && !(flags & NVKMD_MEM_SHARED)) {
+      /* A refusal (no pin left for a new slab) falls back to the paths below */
+      if (slab_alloc(dev, log_obj, size_B, align_B, &mem->slab,
+                     &mem->slab_offset_B) == VK_SUCCESS) {
+         mem->h_memory = mem->slab->h_memory;
+         mem->os_pages = (char *)mem->slab->pages + mem->slab_offset_B;
+         result = VK_SUCCESS;
+         slab_done = true;
+      }
+   }
+   if (!vram && !slab_done) {
       result = VK_ERROR_OUT_OF_DEVICE_MEMORY;
       if (!force_rm_sysmem) {
          result = alloc_os_pages(dev, log_obj, size_B,
@@ -582,9 +767,13 @@ fail_rm:
    if (mem->bar_map != NULL)
       dev->lib->unmap_memory(dev->client, dev->h_device, mem->h_memory,
                              mem->bar_map, size_B, 0);
-   nvkmd_rm_free_memory(dev, mem->h_memory);
-   if (mem->os_pages != NULL)
-      dev->lib->free_pages(dev->client, mem->os_pages, size_B);
+   if (mem->slab != NULL) {
+      slab_free(dev, mem->slab, mem->slab_offset_B, size_B);
+   } else {
+      nvkmd_rm_free_memory(dev, mem->h_memory);
+      if (mem->os_pages != NULL)
+         dev->lib->free_pages(dev->client, mem->os_pages, size_B);
+   }
 fail_bar:
    if (bar)
       bar_release(dev, size_B);
@@ -622,11 +811,15 @@ nvkmd_rm_mem_free_now(void *obj)
    if (mem->bar_charged)
       bar_release(dev, mem->base.size_B);
 
-   nvkmd_rm_free_memory(dev, mem->h_memory);
-   if (mem->imported && dev->lib->release_handle != NULL)
-      dev->lib->release_handle(dev->client, mem->h_memory);
-   if (mem->os_pages != NULL)
-      dev->lib->free_pages(dev->client, mem->os_pages, mem->base.size_B);
+   if (mem->slab != NULL) {
+      slab_free(dev, mem->slab, mem->slab_offset_B, mem->base.size_B);
+   } else {
+      nvkmd_rm_free_memory(dev, mem->h_memory);
+      if (mem->imported && dev->lib->release_handle != NULL)
+         dev->lib->release_handle(dev->client, mem->h_memory);
+      if (mem->os_pages != NULL)
+         dev->lib->free_pages(dev->client, mem->os_pages, mem->base.size_B);
+   }
 
    FREE(mem);
 }
diff --git a/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_va.c b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_va.c
index de0649a..3d168f5 100644
--- a/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_va.c
+++ b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_va.c
@@ -477,7 +477,7 @@ nvkmd_rm_va_bind_mem(struct nvkmd_va *_va,
       .va_offset_B = va_offset_B,
       .range_B = range_B,
       .h_memory = mem->h_memory,
-      .mem_offset_B = mem_offset_B,
+      .mem_offset_B = mem->slab_offset_B + mem_offset_B,
       .flags = flags,
       .kind = kind,
    };
diff --git a/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_win.c b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_win.c
index 1b7500b..d68cd90 100644
--- a/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_win.c
+++ b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_win.c
@@ -426,7 +426,10 @@ nvkmd_rm_mem_rm_handles(struct nvkmd_mem *_mem, uint32_t *h_client,
    struct nvkmd_rm_dev *dev = nvkmd_rm_dev(_mem->dev);
 
    *h_client = dev->lib->root(dev->client);
-   *h_memory = mem->h_memory;
+   /* A range of a shared slab has no RM object of its own: the slab's
+    * handle would name the whole slab, so there is none to give
+    */
+   *h_memory = mem->slab != NULL ? 0 : mem->h_memory;
 }
 
