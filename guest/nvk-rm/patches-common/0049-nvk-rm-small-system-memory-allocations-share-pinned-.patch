 src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_mem.c | 211 ++++++++++++++++++++-
 src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_va.c  |   2 +-
 src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_win.c |   5 +-
 6 files changed, 240 insertions(+), 13 deletions(-)

