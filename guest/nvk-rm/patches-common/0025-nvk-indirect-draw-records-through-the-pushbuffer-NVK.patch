+/* NVK_INDIRECT_PUSH (Turing+, default on; =0 is upstream's MME DMA reads):
+ * the draw records of vkCmdDraw[Indexed]Indirect reach the MME as inline
+ * macro data fetched by the host from the indirect buffer itself (a
+ * pushbuffer segment pointing at the records, as NVK does before Turing),
+ * instead of an MME_DMA_READ_FIFOED per draw that the front end waits for.
+ * The segment is a no-prefetch GPFIFO entry (SYNC_WAIT), so it is fetched
+ * only after the work before it, which may have written the records, is
+ * done; one wait per call instead of one memory round trip per draw.
+ */
+static bool
+nvk_indirect_push(void)
+{
+   static uint32_t state;
+   uint32_t s = p_atomic_read(&state);
+   if (unlikely(s == 0)) {
+      s = debug_get_bool_option("NVK_INDIRECT_PUSH", true) ? 2 : 1;
+      p_atomic_set(&state, s);
+   }
+   return s == 2;
+}
+
+static bool
+nvk_cmd_draw_indirect_pushed(struct nvk_cmd_buffer *cmd, bool indexed,
+                             uint64_t draw_addr, uint32_t draw_count,
+                             uint64_t stride)
+{
+   if (!nvk_indirect_push() || nvk_cmd_buffer_3d_cls(cmd) < TURING_A)
+      return false;
+
+   const uint32_t rec_dw = indexed ? 5 : 4;
+   assert(stride % 4 == 0 && stride / 4 >= rec_dw);
+   const uint32_t stride_dw = stride / 4;
+   /* The macro's 3 parameters and the records in one method's data */
+   const uint32_t max_dw = NV_PUSH_MAX_COUNT - 3;
+   if (stride_dw > max_dw - rec_dw)
+      return false;
+   const uint32_t max_n = (max_dw - rec_dw) / stride_dw + 1;
+
+   for (uint32_t first = 0; first < draw_count;) {
+      const uint32_t n = MIN2(max_n, draw_count - first);
+      const uint64_t addr = draw_addr + (uint64_t)first * stride;
+      const uint32_t rec_total_dw = (n - 1) * stride_dw + rec_dw;
+
+      struct nv_push *p = nvk_cmd_buffer_push(cmd, 4);
+      P_1INC(p, NV9097, CALL_MME_MACRO(indexed ?
+                                       NVK_MME_DRAW_INDEXED_INDIRECT_INLINE :
+                                       NVK_MME_DRAW_INDIRECT_INLINE));
+      P_INLINE_DATA(p, stride_dw - rec_dw);
+      P_INLINE_DATA(p, first);
+      P_INLINE_DATA(p, first + n);
+      nv_push_update_count(p, rec_total_dw);
+      nvk_cmd_buffer_push_indirect(cmd, addr, rec_total_dw * 4);
+
+      first += n;
+   }
+   return true;
 }
 
