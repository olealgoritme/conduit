@@ -215,8 +216,20 @@ struct nvk_rendering_state {
    VkRect2D area;
    uint32_t layer_count;
    uint32_t view_mask;
+
+   /* The attachments' sample count (SET_ANTI_ALIAS): the color
+    * attachments', or the depth/stencil attachment's without color
+    * attachments.  0 without attachments.
+    */
    uint32_t samples;
 
+   /* The color attachments' and the depth/stencil attachment's sample
+    * counts, 0 without such an attachment.  They differ only with
+    * VK_NV_framebuffer_mixed_samples, see nvk_flush_mixed_samples().
+    */
