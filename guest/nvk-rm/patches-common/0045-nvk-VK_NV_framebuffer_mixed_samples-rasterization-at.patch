+      /* The secondary may leave target-independent rasterization on */
+      cmd->state.gfx.tir_maybe_on = true;
+      BITSET_SET(cmd->vk.dynamic_graphics_state.dirty,
+                 MESA_VK_DYNAMIC_MS_RASTERIZATION_SAMPLES);
 
       if (prof_slot >= 0) {
          nvk_pass_profile_end_secondary(cmd, other, prof_slot);
