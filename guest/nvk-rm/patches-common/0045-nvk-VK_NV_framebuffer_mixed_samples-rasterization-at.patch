+   uint32_t zs_samples;
+
    uint32_t color_att_count;
    struct nvk_attachment color_att[NVK_MAX_RTS];
    struct nvk_attachment depth_att;
@@ -260,6 +273,15 @@ struct nvk_graphics_state {
     */
    uint8_t zcull_internal;
 
+   /* VK_NV_framebuffer_mixed_samples: target-independent rasterization
+    * (SET_TIR) may be on.  True at command buffer begin and after
+    * secondaries (whatever ran before may have left it on), set when a draw
+    * turns it on, cleared when it is turned off.  CLEAR_SURFACE with it on
+    * is a class error (Xid 69 on GB202), so render pass begins and
+    * vkCmdClearAttachments turn it off first.
+    */
+   bool tir_maybe_on;
+
    struct nvk_draw_params_state {
       bool valid;
       uint32_t first_vertex;
@@ -452,6 +474,8 @@ nvk_cmd_buffer_push_indirect_ext(struct nvk_cmd_buffer *cmd,
                                  uint64_t addr, uint32_t range,
                                  bool no_prefetch);
 
+void nvk_cmd_disable_tir(struct nvk_cmd_buffer *cmd);
+
 void nvk_cmd_buffer_begin_graphics(struct nvk_cmd_buffer *cmd,
                                    const VkCommandBufferBeginInfo *pBeginInfo);
 void nvk_cmd_buffer_begin_compute(struct nvk_cmd_buffer *cmd,
diff --git a/src/nouveau/vulkan/nvk_cmd_clear.c b/src/nouveau/vulkan/nvk_cmd_clear.c
index bcfe072c..4d666891 100644
--- a/src/nouveau/vulkan/nvk_cmd_clear.c
+++ b/src/nouveau/vulkan/nvk_cmd_clear.c
@@ -150,7 +150,15 @@ nvk_CmdClearAttachments(VkCommandBuffer commandBuffer,
                         const VkClearRect *pRects)
 {
    VK_FROM_HANDLE(nvk_cmd_buffer, cmd, commandBuffer);
-   const struct vk_dynamic_graphics_state *dyn = &cmd->vk.dynamic_graphics_state;
+   struct vk_dynamic_graphics_state *dyn = &cmd->vk.dynamic_graphics_state;
+
+   /* CLEAR_SURFACE is a class error with target-independent rasterization
+    * on; the next draw turns it back on if it wants it.
+    */
+   if (cmd->state.gfx.tir_maybe_on) {
+      nvk_cmd_disable_tir(cmd);
+      BITSET_SET(dyn->dirty, MESA_VK_DYNAMIC_MS_RASTERIZATION_SAMPLES);
+   }
 
    struct nv_push *p = nvk_cmd_buffer_push(cmd, 4 + attachmentCount * 4);
 
diff --git a/src/nouveau/vulkan/nvk_cmd_draw.c b/src/nouveau/vulkan/nvk_cmd_draw.c
index 0765625a..176d50b7 100644
--- a/src/nouveau/vulkan/nvk_cmd_draw.c
+++ b/src/nouveau/vulkan/nvk_cmd_draw.c
@@ -616,6 +616,25 @@ nvk_push_draw_state_init(struct nvk_queue *queue, struct nv_push *p)
       P_IMMD(p, NVB197, SET_POST_PS_INITIAL_COVERAGE, true);
       P_IMMD(p, NVB197, SET_OFFSET_RENDER_TARGET_INDEX,
                         BY_VIEWPORT_INDEX_FALSE);
+
+      /* VK_NV_framebuffer_mixed_samples (see nvk_flush_mixed_samples()):
+       * rasterization at more samples than the color attachments have is
+       * the hardware's target-independent rasterization, off until a draw
+       * asks for it.  While it is on, a color sample is covered if any of
+       * the raster samples associated with it is (the extension's merge
+       * reduction), and alpha to coverage and occlusion queries work on the
+       * raster samples, which the spec orders before coverage reduction.
+       */
+      P_IMMD(p, NVB197, SET_TIR, MODE_DISABLED);
+      P_IMMD(p, NVB197, SET_TIR_CONTROL, {
+         .z_pass_pixel_count_use_raster_samples =
+            Z_PASS_PIXEL_COUNT_USE_RASTER_SAMPLES_ENABLE,
+         .alpha_to_coverage_use_raster_samples =
+            ALPHA_TO_COVERAGE_USE_RASTER_SAMPLES_ENABLE,
+         .reduce_coverage = REDUCE_COVERAGE_ENABLE,
+      });
+      P_IMMD(p, NVB197, SET_TIR_MODULATION, COMPONENT_SELECT_NO_MODULATION);
+      P_IMMD(p, NVB197, SET_TIR_MODULATION_FUNCTION, SELECT_LINEAR);
    }
 
    P_IMMD(p, NV9097, SET_WINDOW_ORIGIN, {
@@ -969,6 +988,8 @@ nvk_cmd_buffer_begin_graphics(struct nvk_cmd_buffer *cmd,
                               const VkCommandBufferBeginInfo *pBeginInfo)
 {
    const struct nvk_device *dev = nvk_cmd_buffer_device(cmd);
+
+   cmd->state.gfx.tir_maybe_on = true;
    if (cmd->vk.level == VK_COMMAND_BUFFER_LEVEL_PRIMARY) {
       struct nv_push *p = nvk_cmd_buffer_push(cmd, 9);
       P_MTHD(p, NV9097, INVALIDATE_SAMPLER_CACHE_NO_WFI);
@@ -1013,7 +1034,56 @@ nvk_cmd_buffer_begin_graphics(struct nvk_cmd_buffer *cmd,
          render->area = (VkRect2D) { };
          render->layer_count = 0;
          render->view_mask = inheritance_info->viewMask;
-         render->samples = inheritance_info->rasterizationSamples;
+
+         /* The attachments' sample counts, as nvk_CmdBeginRendering() works
+          * them out.  VkAttachmentSampleCountInfoAMD gives them when they
+          * differ from rasterizationSamples (mixed samples): in the
+          * inheritance info's chain for dynamic rendering, and in the
+          * runtime's subpass inheritance chain for a legacy render pass,
+          * whose rasterizationSamples is then the OR of the attachments'
+          * counts and no count at all.
+          */
+         const VkAttachmentSampleCountInfoAMD *att_samples =
+            vk_find_struct_const(inheritance_info->pNext,
+                                 ATTACHMENT_SAMPLE_COUNT_INFO_AMD);
+         if (att_samples == NULL) {
+            att_samples =
+               vk_find_struct_const(pBeginInfo->pInheritanceInfo->pNext,
+                                    ATTACHMENT_SAMPLE_COUNT_INFO_AMD);
+         }
+         const uint32_t inh_samples =
+            util_is_power_of_two_or_zero(inheritance_info->rasterizationSamples) ?
+            inheritance_info->rasterizationSamples :
+            util_next_power_of_two(inheritance_info->rasterizationSamples) >> 1;
+
+         render->color_samples = 0;
+         for (uint32_t i = 0; i < inheritance_info->colorAttachmentCount; i++) {
+            if (inheritance_info->pColorAttachmentFormats[i] ==
+                VK_FORMAT_UNDEFINED)
+               continue;
+            uint32_t s = inh_samples;
+            if (att_samples != NULL &&
+                att_samples->pColorAttachmentSamples != NULL &&
+                i < att_samples->colorAttachmentCount &&
+                att_samples->pColorAttachmentSamples[i] != 0)
+               s = att_samples->pColorAttachmentSamples[i];
+            /* The smallest, as SET_ANTI_ALIAS takes it */
+            if (s != 0 && (render->color_samples == 0 || s < render->color_samples))
+               render->color_samples = s;
+         }
+         render->zs_samples = 0;
+         if (inheritance_info->depthAttachmentFormat != VK_FORMAT_UNDEFINED ||
+             inheritance_info->stencilAttachmentFormat != VK_FORMAT_UNDEFINED) {
+            render->zs_samples =
+               (att_samples != NULL && att_samples->depthStencilAttachmentSamples) ?
+               att_samples->depthStencilAttachmentSamples : inh_samples;
+         }
+         render->samples = render->color_samples;
+         if (render->zs_samples != 0 &&
+             (render->samples == 0 || render->zs_samples < render->samples))
+            render->samples = render->zs_samples;
+         if (render->samples == 0)
+            render->samples = inh_samples;
 
          render->color_att_count = inheritance_info->colorAttachmentCount;
          for (uint32_t i = 0; i < render->color_att_count; i++) {
@@ -1116,6 +1186,26 @@ nil_to_nv9097_samples_mode(enum nil_sample_layout sample_layout)
 
 static uint32_t nvk_mme_anti_alias_samples(uint32_t samples);
 
+void
+nvk_cmd_disable_tir(struct nvk_cmd_buffer *cmd)
+{
+   const struct nvk_device *dev = nvk_cmd_buffer_device(cmd);
+
+   if (!cmd->state.gfx.tir_maybe_on)
+      return;
+
+   cmd->state.gfx.tir_maybe_on = false;
+
+   /* Only a device with VK_NV_framebuffer_mixed_samples enabled ever turns
+    * it on; the queue's init state has it off.
+    */
+   if (!dev->vk.enabled_extensions.NV_framebuffer_mixed_samples)
+      return;
+
+   struct nv_push *p = nvk_cmd_buffer_push(cmd, 2);
+   P_IMMD(p, NVB197, SET_TIR, MODE_DISABLED);
+}
+
 static void
 nvk_cmd_set_sample_layout(struct nvk_cmd_buffer *cmd,
                           enum nil_sample_layout sample_layout)
@@ -1130,7 +1220,13 @@ nvk_cmd_set_sample_layout(struct nvk_cmd_buffer *cmd,
    case NIL_SAMPLE_LAYOUT_1X1:
    case NIL_SAMPLE_LAYOUT_2X1:
    case NIL_SAMPLE_LAYOUT_2X1_D3D:
-      /* These only have two modes: Single-pass or per-sample */
+   case NIL_SAMPLE_LAYOUT_4X4:
+      /* These only have two modes: Single-pass or per-sample.  16 samples
+       * are only ever rasterized, without attachments (beyond
+       * framebufferNoAttachmentsSampleCounts, as D3D11 UAV-only rendering
+       * with a forced sample count of 16 may ask), where sample shading is
+       * not supported, so single pass is all they need.
+       */
       P_MTHD(p, NV9097, SET_MME_SHADOW_SCRATCH(NVK_MME_SCRATCH_SAMPLE_MASKS_2PASS_0));
       P_INLINE_DATA(p, 0);
       P_INLINE_DATA(p, 0);
@@ -1197,8 +1293,16 @@ nvk_cmd_set_sample_layout(struct nvk_cmd_buffer *cmd,
       UNREACHABLE("Unknown sample layout");
    }
 
+   /* The MME macro's pass count and per-sample masks go up to
+    * NVK_MAX_SAMPLES (the 4-bit pass count of SET_HYBRID_ANTI_ALIAS_CONTROL
+    * and the root table's sample masks).  Sample shading is never valid at
+    * 16 samples (not in framebufferNoAttachmentsSampleCounts, and not
+    * allowed with mixed samples), so 4X4 shades in a single pass with all
+    * 16 bits in the mask either way; capping the count keeps an invalid
+    * request within those limits instead of overflowing them.
+    */
    P_1INC(p, NV9097, CALL_MME_MACRO(NVK_MME_SET_ANTI_ALIAS));
-   P_INLINE_DATA(p, nvk_mme_anti_alias_samples(samples));
+   P_INLINE_DATA(p, nvk_mme_anti_alias_samples(MIN2(samples, NVK_MAX_SAMPLES)));
 }
 
 VKAPI_ATTR void VKAPI_CALL
@@ -1368,6 +1472,8 @@ nvk_CmdBeginRendering(VkCommandBuffer commandBuffer,
    render->view_mask = pRenderingInfo->viewMask;
    render->layer_count = pRenderingInfo->layerCount;
    render->samples = 0;
+   render->color_samples = 0;
+   render->zs_samples = 0;
 
    const uint32_t layer_count =
       render->view_mask ? util_last_bit(render->view_mask) :
@@ -1406,6 +1512,12 @@ nvk_CmdBeginRendering(VkCommandBuffer commandBuffer,
 
    nvk_cmd_buffer_dirty_render_pass(cmd);
 
+   /* No target-independent rasterization across the SET_ANTI_ALIAS and the
+    * load-op clears below; the first draw that wants it turns it back on
+    * (nvk_flush_mixed_samples(), rasterization samples are dirty).
+    */
+   nvk_cmd_disable_tir(cmd);
+
    const size_t zcull_count = 47;
    struct nv_push *p = nvk_cmd_buffer_push(
       cmd, NVK_MAX_RTS * 12 + 46 + zcull_count
@@ -1459,10 +1571,16 @@ nvk_CmdBeginRendering(VkCommandBuffer commandBuffer,
          struct nil_Extent4D_Samples level_extent_sa =
             nil_image_level_extent_sa(nil_image, iview->vk.base_mip_level);
 
-         assert(sample_layout == NIL_SAMPLE_LAYOUT_INVALID ||
-                sample_layout == nil_image->sample_layout);
-         sample_layout = nil_image->sample_layout;
-         render->samples = image->vk.samples;
+         /* Color attachments with different sample counts (mixed
+          * attachment samples): SET_ANTI_ALIAS takes the smallest, the one
+          * layout that keeps every access inside every attachment.
+          */
+         if (sample_layout == NIL_SAMPLE_LAYOUT_INVALID ||
+             image->vk.samples < render->color_samples) {
+            sample_layout = nil_image->sample_layout;
+            render->samples = image->vk.samples;
+            render->color_samples = image->vk.samples;
+         }
 
          uint64_t addr = nvk_image_plane_base_address(plane) + level->offset_B;
 
@@ -1580,10 +1698,24 @@ nvk_CmdBeginRendering(VkCommandBuffer commandBuffer,
                                      &nil_image);
 
       const struct nil_image_level *level = &nil_image.levels[mip_level];
-      assert(sample_layout == NIL_SAMPLE_LAYOUT_INVALID ||
-             sample_layout == nil_image.sample_layout);
-      sample_layout = nil_image.sample_layout;
-      render->samples = image->vk.samples;
+      render->zs_samples = image->vk.samples;
+      /* A depth/stencil attachment with a sample count other than the
+       * color attachments' (VK_NV_framebuffer_mixed_samples allows more or
+       * fewer).  The hardware has one sample layout for color and Z
+       * (SET_ANTI_ALIAS), and target-independent rasterization raster
+       * samples above it, not a Z buffer at the raster count, so this is
+       * not supported: SET_ANTI_ALIAS takes the smaller of the two
+       * layouts, which keeps every access (draws, clears, ZCULL) inside
+       * both images, and nvk_flush_mixed_samples() leaves target-independent
+       * rasterization off with a depth/stencil attachment.  D3D11 forbids a
+       * depth-stencil view with a forced sample count, and DXVK never mixes
+       * them.
+       */
+      if (sample_layout == NIL_SAMPLE_LAYOUT_INVALID ||
+          image->vk.samples < render->samples) {
+         sample_layout = nil_image.sample_layout;
+         render->samples = image->vk.samples;
+      }
 
       P_MTHD(p, NV9097, SET_ZT_A);
       P_NV9097_SET_ZT_A(p, addr >> 32);
@@ -2029,6 +2161,12 @@ nvk_CmdEndRendering2KHR(VkCommandBuffer commandBuffer,
    struct nvk_zcull_plane* zcull_plane = nvk_get_zcull_plane(render);
    if (zcull_plane &&
        render->depth_att.store_op == VK_ATTACHMENT_STORE_OP_STORE) {
+      /* Like CLEAR_SURFACE, no ZCULL storage with target-independent
+       * rasterization on.  A pass with a depth attachment never turns it on
+       * (nvk_flush_mixed_samples()), but a secondary may have left the CPU
+       * flag set; this is a no-op otherwise.
+       */
+      nvk_cmd_disable_tir(cmd);
       struct nv_push *p = nvk_cmd_buffer_push(cmd, 2);
       P_IMMD(p, NV9097, STORE_ZCULL, 0);
    }
@@ -3959,6 +4097,100 @@ vk_to_nak_sample_location(VkSampleLocationEXT loc)
    };
 }
 
+static uint32_t
+nvk_raster_samples_mode(uint32_t samples)
+{
+   switch (samples) {
+   case 2:  return NVB197_SET_ANTI_ALIAS_RASTER_SAMPLES_MODE_2X1_D3D;
+   case 4:  return NVB197_SET_ANTI_ALIAS_RASTER_SAMPLES_MODE_2X2;
+   case 8:  return NVB197_SET_ANTI_ALIAS_RASTER_SAMPLES_MODE_4X2_D3D;
+   case 16: return NVB197_SET_ANTI_ALIAS_RASTER_SAMPLES_MODE_4X4;
+   default: return NVB197_SET_ANTI_ALIAS_RASTER_SAMPLES_MODE_1X1;
+   }
+}
+
+static uint32_t
+vk_to_nvb197_tir_modulation(VkCoverageModulationModeNV mode)
+{
+   switch (mode) {
+   case VK_COVERAGE_MODULATION_MODE_RGB_NV:
+      return NVB197_SET_TIR_MODULATION_COMPONENT_SELECT_MODULATE_RGB;
+   case VK_COVERAGE_MODULATION_MODE_ALPHA_NV:
+      return NVB197_SET_TIR_MODULATION_COMPONENT_SELECT_MODULATE_ALPHA_ONLY;
+   case VK_COVERAGE_MODULATION_MODE_RGBA_NV:
+      return NVB197_SET_TIR_MODULATION_COMPONENT_SELECT_MODULATE_RGBA;
+   default:
+      return NVB197_SET_TIR_MODULATION_COMPONENT_SELECT_NO_MODULATION;
+   }
+}
+
+/* VK_NV_framebuffer_mixed_samples: a draw that rasterizes at more samples
