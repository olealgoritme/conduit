    }
@@ -3959,6 +4066,91 @@ vk_to_nak_sample_location(VkSampleLocationEXT loc)
    };
 }
 
+static uint32_t
+nvk_raster_samples_mode(uint32_t samples)
+{
+   switch (samples) {
+   case 2:  return NVB197_SET_ANTI_ALIAS_RASTER_SAMPLES_MODE_2X1_D3D;
+   case 4:  return NVB197_SET_ANTI_ALIAS_RASTER_SAMPLES_MODE_2X2;
+   case 8:  return NVB197_SET_ANTI_ALIAS_RASTER_SAMPLES_MODE_4X2_D3D;
+   case 16: return NVB197_SET_ANTI_ALIAS_RASTER_SAMPLES_MODE_4X4;
+   default: return NVB197_SET_ANTI_ALIAS_RASTER_SAMPLES_MODE_1X1;
+   }
+}
+
+static uint32_t
+vk_to_nvb197_tir_modulation(VkCoverageModulationModeNV mode)
+{
+   switch (mode) {
+   case VK_COVERAGE_MODULATION_MODE_RGB_NV:
+      return NVB197_SET_TIR_MODULATION_COMPONENT_SELECT_MODULATE_RGB;
+   case VK_COVERAGE_MODULATION_MODE_ALPHA_NV:
+      return NVB197_SET_TIR_MODULATION_COMPONENT_SELECT_MODULATE_ALPHA_ONLY;
+   case VK_COVERAGE_MODULATION_MODE_RGBA_NV:
+      return NVB197_SET_TIR_MODULATION_COMPONENT_SELECT_MODULATE_RGBA;
+   default:
+      return NVB197_SET_TIR_MODULATION_COMPONENT_SELECT_NO_MODULATION;
+   }
+}
+
+/* VK_NV_framebuffer_mixed_samples: a draw that rasterizes at more samples
+ * than its color attachments have (rasterizationSamples > the attachments'
+ * sample count, which nvk_BeginRendering() programmed with SET_ANTI_ALIAS)
+ * turns on target-independent rasterization: SET_ANTI_ALIAS_RASTER gives
+ * the raster sample count, the pixel shader's coverage input (covmask) has
+ * one bit per raster sample, and color writes see the coverage reduced to
+ * the color samples.  D3D11.1 target-independent rasterization (Direct2D's
+ * anti-aliased fills: ForcedSampleCount 16 with a single-sample render
+ * target) is exactly this.
+ *
+ * The extension requires sampleShadingEnable = VK_FALSE in that case, so
+ * the per-pass sample masks (the MME's SET_ANTI_ALIAS state, from the
+ * attachments' count) need nothing new.  The raster count is the color
+ * attachments' and the mixed decision is made against those: a
+ * depth/stencil attachment is not part of target-independent
+ * rasterization on this hardware (one sample layout for color and Z, see
+ * nvk_CmdBeginRendering()), so with one bound the draw rasterizes at the
+ * attachments' count.  D3D11 forbids depth-stencil views with a forced
+ * sample count.
+ */
+static void
+nvk_flush_mixed_samples(struct nvk_cmd_buffer *cmd)
+{
+   const struct nvk_rendering_state *render = &cmd->state.gfx.render;
+   const struct vk_dynamic_graphics_state *dyn =
+      &cmd->vk.dynamic_graphics_state;
+
+   const uint32_t raster_samples = dyn->ms.rasterization_samples;
+   const bool mixed = render->color_samples != 0 &&
+                      render->zs_samples == 0 &&
+                      raster_samples > render->color_samples;
+
+   if (!mixed) {
+      nvk_cmd_disable_tir(cmd);
+      return;
+   }
+
+   struct nv_push *p = nvk_cmd_buffer_push(cmd, 6);
+
+   P_IMMD(p, NVB197, SET_ANTI_ALIAS_RASTER,
+          nvk_raster_samples_mode(raster_samples));
+
+   /* Coverage modulation by the linear function (the queue's init state):
+    * the factor is the fraction of a color sample's raster samples that are
+    * covered.  A coverage modulation table is not programmed: the
+    * hardware's coefficient table (SET_TIR_MODULATION_COEFFICIENT_TABLE)
+    * took a class error on GB202 (Xid 69, error code 4) with a valid
+    * non-monotonic table, and its indexing for raster/color ratios below
+    * 16 could not be verified, so a table is modulated linearly instead.
+    * The dynamic coverage modulation states are not advertised.
+    */
+   P_IMMD(p, NVB197, SET_TIR_MODULATION,
+          vk_to_nvb197_tir_modulation(dyn->ms.coverage_modulation_mode));
+
+   P_IMMD(p, NVB197, SET_TIR, MODE_RASTER_N_TARGET_M);
+   cmd->state.gfx.tir_maybe_on = true;
+}
+
 static void
 nvk_flush_ms_state(struct nvk_cmd_buffer *cmd)
 {
@@ -3980,13 +4172,20 @@ nvk_flush_ms_state(struct nvk_cmd_buffer *cmd)
          nvk_cmd_set_sample_layout(cmd, nil_choose_sample_layout(samples));
       } else {
          /* Multisample information MAY be missing (rasterizationSamples == 0)
-          * if rasterizer discard is enabled.
+          * if rasterizer discard is enabled.  With
+          * VK_NV_framebuffer_mixed_samples it may be more than the
+          * attachments' sample count (nvk_flush_mixed_samples()).
           */
          assert(dyn->ms.rasterization_samples == 0 ||
-                dyn->ms.rasterization_samples == render->samples);
+                dyn->ms.rasterization_samples >= render->samples);
