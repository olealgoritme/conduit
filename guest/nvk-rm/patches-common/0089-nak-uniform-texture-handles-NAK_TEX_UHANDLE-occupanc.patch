+                    b.push_op(OpR2UR {
+                        src: h.into(),
+                        dst: u.into(),
+                    });
+                    u.into()
+                }
+            }
+        };
 
         let flags: nak_nir_tex_flags =
             unsafe { std::mem::transmute_copy(&tex.backend_flags) };
@@ -2162,6 +2185,7 @@ impl<'a> ShaderFromNir<'a> {
                     nodep: flags.nodep(),
                     channel_mask,
                     scalar: flags.scalar(),
+                    handle: handle.clone(),
                 });
             } else if tex.op == nir_texop_tg4 {
                 b.push_op(OpTld4 {
@@ -2177,6 +2201,7 @@ impl<'a> ShaderFromNir<'a> {
                     nodep: flags.nodep(),
                     channel_mask,
                     scalar: flags.scalar(),
+                    handle: handle.clone(),
