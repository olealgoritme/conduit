@@ -2904,12 +2904,30 @@ fn legalize_tex_instr(op: &mut impl SrcsAsSlice, b: &mut LegalizeBuilder) {
         b.copy_ssa_ref_if_uniform(ssa);
     }
     if srcs.len() > 1 {
-        debug_assert!(srcs.len() == 2);
         assert!(matches!(&srcs[1].src_ref, SrcRef::SSA(_) | SrcRef::Zero));
         if let SrcRef::SSA(ssa) = &mut srcs[1].src_ref {
             b.copy_ssa_ref_if_uniform(ssa);
         }
     }
+    // TEX/TLD/TLD4: the uniform handle (NAK_TEX_UHANDLE) must be in a UGPR.
+    // It may have been moved to a GPR since; the value is the same in every
+    // lane (NIR's divergence analysis), so R2UR brings it back.
+    if srcs.len() > 2 {
+        debug_assert!(srcs.len() == 3);
+        let gpr_ssa = match &srcs[2].src_ref {
+            SrcRef::SSA(ssa) if !ssa.file().is_uniform() => Some(ssa[0]),
+            _ => None,
+        };
+        if let Some(gpr) = gpr_ssa {
+            let u = b.alloc_ssa(RegFile::UGPR);
+            b.push_op(OpR2UR {
+                src: gpr.into(),
+                dst: u.into(),
+            });
+            srcs[2] = u.into();
+        }
+        assert!(srcs[2].is_zero() || srcs[2].is_uniform());
+    }
 }
 
