diff --git a/src/nouveau/compiler/nak/occ_target.rs b/src/nouveau/compiler/nak/occ_target.rs
index 48ca45c..18095ba 100644
--- a/src/nouveau/compiler/nak/occ_target.rs
+++ b/src/nouveau/compiler/nak/occ_target.rs
@@ -158,6 +158,23 @@ impl Shader<'_> {
         let natural = (total + hw_reserved).next_multiple_of(8);
         let w0 = self.occupancy(natural);
 
+        // NAK_OCC_GPRS: a fixed target, for sweeps of one shader
+        let forced = crate::knobs::occ_gprs();
+        if forced > 0 {
+            let a = max(forced.next_multiple_of(8), floor);
+            if occ_trace() {
+                eprintln!(
+                    "NAK_OCC_TRACE: {} GPRs {} warps -> NAK_OCC_GPRS {} GPRs \
+                     {} warps",
+                    natural,
+                    w0,
+                    a,
+                    self.occupancy(a)
+                );
+            }
+            return if a < natural { Some(a - hw_reserved) } else { None };
+        }
+
         // Occupancy cliffs below the natural count
         let mut cands = Vec::new();
         let mut a = natural;
