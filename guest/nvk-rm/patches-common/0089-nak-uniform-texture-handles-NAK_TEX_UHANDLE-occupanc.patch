+/// NAK_TEX_UHANDLE (default off, SM100+): a bindless texture handle that is
+/// the same in every lane goes in the instruction's uniform register field
+/// (TEX/TLD/TLD4 with a UR handle, as in the reference compiler's code)
+/// instead of the second source vector, which then often is empty and lets
+/// the sources use the scalar form (.SCR): fewer copies to build contiguous
+/// source vectors (nak_nir_lower_tex.c, from_nir.rs, sm70_encode.rs)
+pub fn tex_uhandle() -> bool {
+    *TEX_UHANDLE.get_or_init(|| {
+        parse("NAK_TEX_UHANDLE", env::var("NAK_TEX_UHANDLE"), false)
+    })
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn nak_knob_tex_uhandle() -> bool {
+    tex_uhandle()
+}
+
+fn parse_u32(name: &str, default: u32, max: u32) -> u32 {
+    match env::var(name) {
+        Ok(s) => match s.trim().parse::<u32>() {
+            Ok(v) if v <= max => v,
+            _ => {
+                eprintln!("NAK: ignoring {}=\"{}\" (0-{})", name, s.trim(), max);
+                default
+            }
+        },
+        Err(_) => default,
+    }
+}
+
+/// NAK_REMAT_LD_COST (1-63, default 4): what a rematerialized global or
+/// constant load costs in the spiller and in the occupancy target's dry run
+/// (spill_remat::op_cost).  A memory fill costs 8; a reload that is a load
+/// from L1 or L2 can cost more than its issue slot
+pub fn remat_ld_cost() -> u32 {
+    *REMAT_LD_COST
+        .get_or_init(|| parse_u32("NAK_REMAT_LD_COST", 4, 63).max(1))
+}
+
+/// NAK_OCC_GPRS (0-255, default 0 = off): with NAK_OCC_TARGET, the register
+/// target of every shader whose natural count is higher, instead of the
+/// estimated best (rounded up to a multiple of 8).  For sweeps of one
+/// shader (dispatch-replay), not for games
+pub fn occ_gprs() -> u32 {
+    *OCC_GPRS.get_or_init(|| parse_u32("NAK_OCC_GPRS", 0, 255))
+}
+
 /// NAK_SCHED_ILP (default off): the prepass enters an instruction in its
 /// future-ready set at the cycle its edge latencies give, as NAK_SCHED_MLP
 /// does, but keeps the plain latency model.  Without it a producer is ready
@@ -186,6 +236,9 @@ pub extern "C" fn nak_knobs_key2() -> u32 {
         | (u32::from(fset_bf()) << 8)
         | (u32::from(sched_ilp()) << 9)
         | (gcm() << 10)
+        | (u32::from(tex_uhandle()) << 12)
+        | (remat_ld_cost() << 13)
+        | (occ_gprs() << 19)
 }
 
 /// NAK_YIELD (default off, experimental, SM120): control bit 109 set on
