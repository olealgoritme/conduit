    int32_t pass_profile_slot;
    int32_t pass_profile_cmd_slot;
-   uint32_t pass_profile_draws;
-   uint32_t pass_profile_cmd_draws;
+   int32_t pass_profile_op_slot;
+   int32_t pass_profile_stat_slot;
+   enum nvk_pass_profile_op pass_profile_op;
+   uint32_t pass_profile_op_count;
+   uint64_t pass_profile_op_groups;
+   uint32_t pass_profile_internal;
+   bool pass_profile_in_pass;
+   struct nvk_pass_profile_counts pass_profile_pass_counts;
+   struct nvk_pass_profile_counts pass_profile_op_counts;
+   struct nvk_pass_profile_counts pass_profile_cmd_counts;
 
    struct nvk_cmd_mem *upload_mem;
    uint32_t upload_offset;
@@ -496,6 +509,43 @@ nvk_cmd_buffer_last_subchannel(const struct nvk_cmd_buffer *cmd)
 
