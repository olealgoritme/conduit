+/* NVK_PASS_PROFILE counters (see struct nvk_pass_profile_counts) */
+static inline void
+nvk_cmd_profile_count_draws(struct nvk_cmd_buffer *cmd, uint32_t draws,
+                            bool indirect)
+{
+   struct nvk_pass_profile_counts *c[3] = {
+      &cmd->pass_profile_pass_counts,
+      &cmd->pass_profile_op_counts,
+      &cmd->pass_profile_cmd_counts,
+   };
+   for (unsigned i = 0; i < 3; i++) {
+      c[i]->calls++;
+      c[i]->draws += draws;
+      if (indirect) {
+         c[i]->ind_calls++;
+         c[i]->ind_draws += draws;
+      }
+   }
+}
+
+static inline void
+nvk_cmd_profile_count_query(struct nvk_cmd_buffer *cmd)
+{
+   cmd->pass_profile_pass_counts.queries++;
+   cmd->pass_profile_op_counts.queries++;
+   cmd->pass_profile_cmd_counts.queries++;
+}
+
+static inline void
+nvk_cmd_profile_count_barrier(struct nvk_cmd_buffer *cmd)
+{
+   cmd->pass_profile_pass_counts.barriers++;
+   cmd->pass_profile_op_counts.barriers++;
+   cmd->pass_profile_cmd_counts.barriers++;
+}
+
+
 VkResult nvk_cmd_buffer_alloc_mem(struct nvk_cmd_buffer *cmd,
                                   bool force_gart,
                                   struct nvk_cmd_mem **mem_out);
