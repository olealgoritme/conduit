From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ole Algoritme <olealgoritme@gmail.com>
Date: Sun, 18 Oct 2026 10:34:41 +0200
Subject: [PATCH] nak: loops without a continue skip the per-iteration lane
 sync (NAK_LOOP_CONT_SYNC)

A divergent loop synced its lanes at the end of every iteration: a
BSSY/BSYNC pair around the body, and breaks escaped through it.  A loop
with no continue needs no such sync: such loops now skip it and breaks
go to the loop's exit sync directly, as in the reference compiler's code.

On an RTX 5090 with captured Steel Nomad inputs, one compute shader runs
12% faster and another 4%, with bit-identical outputs.

NAK_LOOP_CONT_SYNC=1 brings back the per-iteration sync.  Part of
nak_knobs_key() (bit 16).
---
 src/nouveau/compiler/nak/knobs.rs       | 19 +++++++++
 src/nouveau/compiler/nak_nir_lower_cf.c | 51 ++++++++++++++++++++++++-
 src/nouveau/compiler/nak_private.h      |  1 +
 3 files changed, 70 insertions(+), 1 deletion(-)

diff --git a/src/nouveau/compiler/nak/knobs.rs b/src/nouveau/compiler/nak/knobs.rs
index 2ab6488..f62e365 100644
--- a/src/nouveau/compiler/nak/knobs.rs
+++ b/src/nouveau/compiler/nak/knobs.rs
@@ -53,6 +53,11 @@
 //!   HADD2.F32 with -0, as in the reference compiler's code, instead of
 //!   F2F, which runs on the quarter-rate conversion pipe shared with MUFU
 //!   (from_nir.rs)
+//! - NAK_LOOP_CONT_SYNC (default off): 1 makes every divergent loop sync
+//!   its lanes at the end of each iteration (BSSY/BSYNC around the body,
+//!   breaks escape through it).  Off, loops with no continue skip that sync
+//!   and breaks go to the loop's exit sync directly, as in the reference
+//!   compiler's code (nak_nir_lower_cf.c)
 
 use std::env;
 use std::sync::OnceLock;
@@ -90,6 +95,7 @@ static VEC_CSE: OnceLock<bool> = OnceLock::new();
 static WEAK_MEM: OnceLock<bool> = OnceLock::new();
 static UNIFORM_ATOMICS: OnceLock<bool> = OnceLock::new();
 static F16_CVT: OnceLock<bool> = OnceLock::new();
+static LOOP_CONT_SYNC: OnceLock<bool> = OnceLock::new();
 
 /// NAK_IMM_CSE for a shader: compute shaders unless set
 pub fn imm_cse(compute: bool) -> bool {
@@ -192,6 +198,13 @@ pub fn f16_cvt() -> bool {
     *v
 }
 
+pub fn loop_cont_sync() -> bool {
+    let v = LOOP_CONT_SYNC.get_or_init(|| {
+        parse("NAK_LOOP_CONT_SYNC", env::var("NAK_LOOP_CONT_SYNC"), false)
+    });
+    *v
+}
+
 pub fn vec_cse() -> bool {
     let v = VEC_CSE
         .get_or_init(|| parse("NAK_VEC_CSE", env::var("NAK_VEC_CSE"), true));
@@ -242,6 +255,11 @@ pub extern "C" fn nak_knob_uniform_atomics() -> bool {
     uniform_atomics()
 }
 
+#[unsafe(no_mangle)]
+pub extern "C" fn nak_knob_loop_cont_sync() -> bool {
+    loop_cont_sync()
+}
+
 /// The knobs that do not fit in nak_gpr_cap_key(), for the low 12 bits of
 /// NVK's compiler flags
 #[unsafe(no_mangle)]
@@ -264,4 +282,5 @@ pub extern "C" fn nak_knobs_key() -> u32 {
         | (u32::from(weak_mem()) << 13)
         | (u32::from(uniform_atomics()) << 14)
         | (u32::from(f16_cvt()) << 15)
+        | (u32::from(!loop_cont_sync()) << 16)
 }
diff --git a/src/nouveau/compiler/nak_nir_lower_cf.c b/src/nouveau/compiler/nak_nir_lower_cf.c
index 078ed9d..45483f7 100644
--- a/src/nouveau/compiler/nak_nir_lower_cf.c
+++ b/src/nouveau/compiler/nak_nir_lower_cf.c
@@ -249,6 +249,55 @@ block_is_merge(const nir_block *block)
    return num_preds > 1;
 }
 
+static bool
+cf_list_has_continue(struct exec_list *cf_list)
+{
+   foreach_list_typed(nir_cf_node, node, node, cf_list) {
+      switch (node->type) {
+      case nir_cf_node_block: {
+         nir_block *block = nir_cf_node_as_block(node);
+         nir_instr *last = nir_block_last_instr(block);
+         if (last != NULL && last->type == nir_instr_type_jump &&
+             nir_instr_as_jump(last)->type == nir_jump_continue)
+            return true;
+         break;
+      }
+      case nir_cf_node_if: {
+         nir_if *nif = nir_cf_node_as_if(node);
+         if (cf_list_has_continue(&nif->then_list) ||
+             cf_list_has_continue(&nif->else_list))
+            return true;
+         break;
+      }
+      case nir_cf_node_loop:
+         /* A continue in a nested loop continues that loop */
+         break;
+      default:
+         UNREACHABLE("Unknown CF node type");
+      }
+   }
+   return false;
+}
+
+/* Whether a divergent loop syncs at the end of every iteration.  Without
+ * that sync, a break goes straight to the loop's exit sync.  A continue
+ * would have to cascade through the syncs of the ifs around it to the
+ * continue block, which the escape cascade cannot express without a sync
+ * there (it always continues at the next scope with a sync), so loops
+ * with a continue keep the sync.
+ */
+static bool
+loop_needs_cont_sync(nir_loop *loop)
+{
+   if (!nir_loop_is_divergent(loop))
+      return false;
+
+   if (nak_knob_loop_cont_sync())
+      return true;
+
+   return cf_list_has_continue(&loop->body);
+}
+
 static void
 lower_cf_list(nir_builder *b, nir_def *esc_reg, struct scope *parent_scope,
               struct exec_list *cf_list)
@@ -350,7 +399,7 @@ lower_cf_list(nir_builder *b, nir_def *esc_reg, struct scope *parent_scope,
          struct scope cont_scope = push_scope(b, SCOPE_TYPE_LOOP_CONT,
                                               &break_scope,
                                               nir_loop_is_divergent(loop),
-                                              nir_loop_is_divergent(loop),
+                                              loop_needs_cont_sync(loop),
                                               cont_block);
 
          lower_cf_list(b, esc_reg, &cont_scope, &loop->body);
diff --git a/src/nouveau/compiler/nak_private.h b/src/nouveau/compiler/nak_private.h
index 82b7618..13824ab 100644
--- a/src/nouveau/compiler/nak_private.h
+++ b/src/nouveau/compiler/nak_private.h
@@ -19,6 +19,7 @@ bool nak_debug_no_ugpr(void);
 bool nak_knob_uaddr_pin(void);
 bool nak_knob_nir_flatten(void);
 bool nak_knob_uniform_atomics(void);
+bool nak_knob_loop_cont_sync(void);
 
 struct nak_compiler {
    uint8_t sm;
-- 
2.43.0

