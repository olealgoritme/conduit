new file mode 100644
index 0000000..41de945
--- /dev/null
+++ b/src/nouveau/compiler/nak_nir_lower_early_exit.c
@@ -0,0 +1,313 @@
+/*
+ * Copyright © 2026 Conduit contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "nak_private.h"
+#include "nir_builder.h"
+#include "nir_control_flow.h"
+
+/*
+ * Compute shaders often end in one of two shapes:
+ *
+ *    if (in_bounds) {
+ *       ... the whole shader ...
+ *    }
+ *
+ * or, for an early return that the front-end lowered to a loop that never
+ * iterates:
+ *
+ *    loop {
+ *       if (out_of_bounds) {
+ *          ...
+ *          break;
+ *       }
+ *       ... the whole shader ...
+ *       break;
+ *    }
+ *
+ * Either way the rest of the shader sits in divergent control flow, and NAK
+ * never puts values of divergent blocks in uniform registers, so the whole
+ * shader runs without the uniform datapath: every descriptor index, handle
+ * and uniform address is computed per lane in GPRs.  In a compute shader,
+ * reaching the end of the shader is the same as exiting, so we rewrite these
+ * shapes so that the lanes that leave early exit (halt, which maps to EXIT
+ * and doesn't block later syncs) and the rest of the shader runs in
+ * convergent control flow at the top level:
+ *
+ *    if (out_of_bounds) {
+ *       ...
+ *    }
+ *    if (out_of_bounds)
+ *       halt;
+ *    ... the whole shader ...
+ *
+ * The side that stays guarded keeps its own if, which reconverges before the
+ * halt, so no lane runs it while the other lanes run the code after it.
+ */
+
+/* Most instructions the guarded side of a split if may have regardless of
+ * the other side's size
+ */
+#define MAX_GUARDED_INSTRS 16
+
+static unsigned
+cf_list_instr_count(struct exec_list *list)
+{
+   unsigned count = 0;
+   foreach_list_typed(nir_cf_node, node, node, list) {
+      switch (node->type) {
+      case nir_cf_node_block:
+         count += exec_list_length(&nir_cf_node_as_block(node)->instr_list);
+         break;
+      case nir_cf_node_if: {
+         nir_if *nif = nir_cf_node_as_if(node);
+         count += cf_list_instr_count(&nif->then_list);
+         count += cf_list_instr_count(&nif->else_list);
+         break;
+      }
+      case nir_cf_node_loop:
+         count += cf_list_instr_count(&nir_cf_node_as_loop(node)->body);
+         break;
+      default:
+         UNREACHABLE("Unknown CF node type");
+      }
+   }
+   return count;
+}
+
+static bool
+cf_list_is_empty(struct exec_list *list)
+{
+   if (!exec_list_is_singular(list))
+      return false;
+
+   nir_block *block = nir_cf_node_as_block(exec_node_data(nir_cf_node,
+                                           exec_list_get_head(list), node));
+   return exec_list_is_empty(&block->instr_list);
+}
+
+/* The last CF node of the function body before its (empty) last block, or
+ * NULL if the last block has instructions.
+ */
+static nir_cf_node *
+trailing_cf_node(nir_function_impl *impl)
+{
+   nir_block *last = nir_impl_last_block(impl);
+   if (!exec_list_is_empty(&last->instr_list))
+      return NULL;
+
+   return nir_cf_node_prev(&last->cf_node);
+}
+
+/* Replaces the breaks of a loop (not of loops nested in it) with halts */
+static void
+breaks_to_halts(nir_builder *b, struct exec_list *list)
+{
+   foreach_list_typed(nir_cf_node, node, node, list) {
+      switch (node->type) {
+      case nir_cf_node_block: {
+         nir_block *block = nir_cf_node_as_block(node);
+         nir_instr *last = nir_block_last_instr(block);
+         if (last != NULL && last->type == nir_instr_type_jump &&
+             nir_instr_as_jump(last)->type == nir_jump_break) {
+            b->cursor = nir_instr_remove(last);
+            nir_jump(b, nir_jump_halt);
+         }
+         break;
+      }
+      case nir_cf_node_if: {
+         nir_if *nif = nir_cf_node_as_if(node);
+         breaks_to_halts(b, &nif->then_list);
+         breaks_to_halts(b, &nif->else_list);
+         break;
+      }
+      case nir_cf_node_loop:
+         break;
+      default:
+         UNREACHABLE("Unknown CF node type");
+      }
+   }
+}
+
+/* A trailing loop that never iterates (its header's only predecessor is the
+ * block before it): its breaks become halts and its body moves out of it.
+ */
+static bool
+unwrap_trailing_loop(nir_builder *b, nir_loop *loop)
+{
+   if (nir_loop_has_continue_construct(loop))
+      return false;
+
+   if (nir_block_num_preds(nir_loop_first_block(loop)) != 1)
+      return false;
+
+   breaks_to_halts(b, &loop->body);
+
+   nir_cf_list body;
+   nir_cf_list_extract(&body, &loop->body);
+   nir_cf_reinsert(&body, nir_before_cf_node(&loop->cf_node));
+   nir_cf_node_remove(&loop->cf_node);
+
+   return true;
+}
+
+/* A trailing if with a divergent condition: the larger side runs after it
+ * at the top level, the other side stays in the if and then exits.
+ */
+static bool
+split_trailing_if(nir_builder *b, nir_if *nif)
+{
+   if (!nir_src_is_divergent(&nif->condition))
+      return false;
+
+   const bool then_empty = cf_list_is_empty(&nif->then_list);
+   const bool else_empty = cf_list_is_empty(&nif->else_list);
+   if (then_empty && else_empty)
+      return false;
+
+   bool keep_then;
+   if (then_empty || else_empty) {
+      keep_then = else_empty;
+   } else {
+      const unsigned then_count = cf_list_instr_count(&nif->then_list);
+      const unsigned else_count = cf_list_instr_count(&nif->else_list);
+      keep_then = then_count >= else_count;
+
+      /* The side that stays guarded is still divergent, and its uniform
+       * values are computed apart from the rest's.  Only worth it when that
+       * side is small next to the one that becomes convergent.
+       */
+      const unsigned guarded = keep_then ? else_count : then_count;
+      const unsigned kept = keep_then ? then_count : else_count;
+      if (guarded > MAX_GUARDED_INSTRS && guarded * 4 > kept)
+         return false;
+   }
+
+   nir_def *cond = nif->condition.ssa;
+
+   b->cursor = nir_after_cf_node(&nif->cf_node);
+   nir_if *exit_if = nir_push_if(b, cond);
+   if (keep_then) {
+      nir_push_else(b, exit_if);
+      nir_jump(b, nir_jump_halt);
+   } else {
+      nir_jump(b, nir_jump_halt);
+   }
+   nir_pop_if(b, exit_if);
+
+   nir_cf_list rest;
+   nir_cf_list_extract(&rest, keep_then ? &nif->then_list
+                                        : &nif->else_list);
+   nir_cf_reinsert(&rest, nir_after_cf_node(&exit_if->cf_node));
+
+   /* Past the exit, the condition has the same value in every lane that is
+    * left.  Shaders often test it again (one bounds check per block of
+    * work); those tests become constants, which nir_opt_dead_cf folds.
+    */
+   nir_progress(true, b->impl, nir_metadata_none);
+   nir_metadata_require(b->impl, nir_metadata_block_index |
+                                 nir_metadata_dominance);
+   nir_block *after = nir_cf_node_as_block(nir_cf_node_next(&exit_if->cf_node));
+   nir_block *then_first = nir_if_first_then_block(nif);
+   nir_block *else_first = nir_if_first_else_block(nif);
+   nir_def *values[2] = { NULL, NULL };
+   nir_foreach_use_including_if_safe(use, cond) {
+      if (!nir_src_is_if(use) &&
+          nir_src_use_instr(use)->type == nir_instr_type_phi)
+         continue;
+
+      /* Within the guarded side, the condition is known too */
+      nir_block *use_block = nir_src_get_block(use);
+      nir_block *def_block;
+      bool value;
+      if (nir_block_dominates(after, use_block)) {
+         def_block = after;
+         value = keep_then;
+      } else if (nir_block_dominates(then_first, use_block)) {
+         def_block = then_first;
+         value = true;
+      } else if (nir_block_dominates(else_first, use_block)) {
+         def_block = else_first;
+         value = false;
+      } else {
+         continue;
+      }
+
+      nir_def **v = &values[def_block == after ? 0 : 1];
+      if (*v == NULL || nir_def_block(*v) != def_block) {
+         b->cursor = nir_before_block(def_block);
+         *v = nir_imm_bool(b, value);
+      }
+      nir_src_rewrite(use, *v);
+   }
+
+   /* An if with both sides empty is left for nir_opt_dead_cf */
+   return true;
+}
+
+static bool
+remove_trailing_halt(nir_function_impl *impl)
+{
+   nir_block *last = nir_impl_last_block(impl);
+   nir_instr *instr = nir_block_last_instr(last);
+   if (instr == NULL || instr->type != nir_instr_type_jump ||
+       nir_instr_as_jump(instr)->type != nir_jump_halt)
+      return false;
+
+   nir_instr_remove(instr);
+   return true;
+}
+
+static bool
+lower_early_exit_impl(nir_function_impl *impl)
+{
+   nir_builder b = nir_builder_create(impl);
+   bool progress = false;
+
+   /* Each round moves at most one CF node and the trailing nodes of a
+    * shader are few, so this terminates quickly; the bound is a safety net.
+    */
+   for (unsigned round = 0; round < 64; round++) {
+      nir_metadata_require(impl, nir_metadata_block_index |
+                                 nir_metadata_dominance |
+                                 nir_metadata_divergence);
+
+      nir_cf_node *node = trailing_cf_node(impl);
+      if (node == NULL)
+         break;
+
+      bool changed = false;
+      if (node->type == nir_cf_node_loop) {
+         changed = unwrap_trailing_loop(&b, nir_cf_node_as_loop(node));
+      } else if (node->type == nir_cf_node_if) {
+         changed = split_trailing_if(&b, nir_cf_node_as_if(node));
+      }
+
+      if (!changed)
+         break;
+
+      remove_trailing_halt(impl);
+      nir_progress(true, impl, nir_metadata_none);
+      progress = true;
+   }
+
+   return progress;
+}
+
+bool
+nak_nir_lower_early_exit(nir_shader *nir)
+{
+   if (!mesa_shader_stage_is_compute(nir->info.stage))
+      return false;
+
+   if (nir->info.derivative_group != DERIVATIVE_GROUP_NONE)
+      return false;
+
+   nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+   if (impl == NULL)
+      return false;
+
+   bool progress = lower_early_exit_impl(impl);
+   return progress;
+}
