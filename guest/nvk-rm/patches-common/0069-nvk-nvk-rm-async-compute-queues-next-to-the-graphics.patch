+static VkResult nvk_queue_init_context_state(struct nvk_queue *queue,
+                                             struct nvk_queue_chan *chan);
+
+static VkResult
+nvk_queue_chan_init(struct nvk_queue *queue, struct nvk_queue_chan *chan,
+                    enum nvkmd_engines engines)
+{
+   struct nvk_device *dev = nvk_queue_device(queue);
+   VkResult result;
+
+   nvk_queue_state_init(&chan->state);
+   chan->engines = engines;
+
+   result = nvkmd_dev_create_ctx(dev->nvkmd, &dev->vk.base, engines,
+                                 &chan->ctx);
+   if (result != VK_SUCCESS)
+      return result;
+
+   result = nvk_mem_stream_init(dev, &chan->push_stream);
+   if (result != VK_SUCCESS)
+      goto fail_ctx;
+
+   return VK_SUCCESS;
+
+fail_ctx:
+   nvkmd_ctx_destroy(chan->ctx);
+   chan->ctx = NULL;
+   return result;
+}
+
+static void
+nvk_queue_chan_finish(struct nvk_queue *queue, struct nvk_queue_chan *chan)
+{
+   struct nvk_device *dev = nvk_queue_device(queue);
+
+   if (chan->ctx == NULL)
+      return;
+
+   nvk_mem_stream_sync(dev, &chan->push_stream, chan->ctx);
+   nvk_mem_stream_finish(dev, &chan->push_stream);
+   nvk_queue_state_finish(dev, &chan->state);
+   nvkmd_ctx_destroy(chan->ctx);
+   chan->ctx = NULL;
+}
+
+/* The channel with every engine of an async compute queue, made the first
+ * time a command buffer needs it
+ */
+static VkResult
+nvk_queue_full_chan_init(struct nvk_queue *queue)
+{
+   struct nvk_device *dev = nvk_queue_device(queue);
+   const struct nvk_physical_device *pdev = nvk_device_physical(dev);
+   struct nvk_queue_chan *chan = &queue->chans[NVK_QUEUE_CHAN_FULL];
+   VkResult result;
+
+   const struct nvk_queue_family *queue_family =
+      &pdev->queue_families[queue->vk.queue_family_index];
+   result = nvk_queue_chan_init(queue, chan,
+      nvk_queue_engines_from_queue_flags(queue_family->queue_flags));
+   if (result != VK_SUCCESS)
+      return result;
+
+   result = nvk_queue_init_context_state(queue, chan);
+   if (result != VK_SUCCESS) {
+      nvk_queue_chan_finish(queue, chan);
+      return result;
+   }
+
+   return VK_SUCCESS;
+}
+
+/* Moves the queue's work to channel c: what was submitted to the other
+ * channel so far comes first.  Pushes the channel's state for the command
+ * buffers that come next (with_state).
+ */
+static VkResult
+nvk_queue_use_chan(struct nvk_queue *queue, uint8_t c, bool with_state)
+{
+   VkResult result;
+
+   if (c != queue->last_chan) {
+      if (queue->chans[c].ctx == NULL) {
+         assert(c == NVK_QUEUE_CHAN_FULL);
+         result = nvk_queue_full_chan_init(queue);
+         if (result != VK_SUCCESS)
+            return result;
+      }
+
+      const struct vk_sync_signal signal = {
+         .sync = queue->handoff_sync,
+         .stage_mask = ~0,
+         .signal_value = ++queue->handoff_value,
+      };
+      result = nvkmd_ctx_signal(queue->chans[queue->last_chan].ctx,
+                                &queue->vk.base, 1, &signal);
+      if (result != VK_SUCCESS)
+         return result;
+
+      const struct vk_sync_wait wait = {
+         .sync = queue->handoff_sync,
+         .stage_mask = ~0,
+         .wait_value = queue->handoff_value,
+      };
+      result = nvkmd_ctx_wait(queue->chans[c].ctx, &queue->vk.base, 1, &wait);
+      if (result != VK_SUCCESS)
+         return result;
+
+      queue->last_chan = c;
+   }
+
+   if (with_state)
+      return nvk_queue_state_update(queue, &queue->chans[c]);
+
+   return VK_SUCCESS;
+}
