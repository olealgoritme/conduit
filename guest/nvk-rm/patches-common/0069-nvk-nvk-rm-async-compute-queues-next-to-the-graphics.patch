+         .queue_flags = VK_QUEUE_COMPUTE_BIT |
+                        VK_QUEUE_TRANSFER_BIT,
+         .queue_count = 4,
+      };
+   }
    if (pdev->info.has_transfer_queue) {
       pdev->queue_families[pdev->queue_family_count++] = (struct nvk_queue_family) {
          .queue_flags = VK_QUEUE_TRANSFER_BIT |
diff --git a/src/nouveau/vulkan/nvk_physical_device.h b/src/nouveau/vulkan/nvk_physical_device.h
index f2d0790..d631f88 100644
--- a/src/nouveau/vulkan/nvk_physical_device.h
+++ b/src/nouveau/vulkan/nvk_physical_device.h
@@ -67,7 +67,7 @@ struct nvk_physical_device {
    uint8_t mem_heap_count;
    uint8_t mem_type_count;
 
-   struct nvk_queue_family queue_families[3];
+   struct nvk_queue_family queue_families[4];
    uint8_t queue_family_count;
 };
 
diff --git a/src/nouveau/vulkan/nvk_query_pool.c b/src/nouveau/vulkan/nvk_query_pool.c
index 38708ef..67cb487 100644
--- a/src/nouveau/vulkan/nvk_query_pool.c
+++ b/src/nouveau/vulkan/nvk_query_pool.c
@@ -350,7 +350,42 @@ nvk_CmdResetQueryPool(VkCommandBuffer commandBuffer,
    const struct nvk_device *dev = nvk_cmd_buffer_device(cmd);
    const struct nvk_physical_device *pdev = nvk_device_physical(dev);
 
-   if (queryCount > 1 && pool->layout != NVK_QUERY_POOL_LAYOUT_ALIGNED_INTERLEAVED) {
+   if (cmd->compute_only) {
+      /* The async compute family's channel has neither the copy nor the 3D
+       * engine: a compute shader fill, or compute report semaphores
+       */
+      if (queryCount > 1 &&
+          pool->layout != NVK_QUERY_POOL_LAYOUT_ALIGNED_INTERLEAVED) {
+         uint64_t clear_size;
+         if (pool->layout == NVK_QUERY_POOL_LAYOUT_SEPARATE)
+            clear_size = queryCount * sizeof(uint32_t);
+         else if (pool->layout == NVK_QUERY_POOL_LAYOUT_TIMESTAMP_PACKED)
+            clear_size = queryCount * pool->query_stride;
+         else
+            UNREACHABLE("Unsupported query type");
+
+         const VkDeviceAddressRangeKHR range = {
+            .address = nvk_query_available_addr(pool, firstQuery),
+            .size = clear_size,
+         };
