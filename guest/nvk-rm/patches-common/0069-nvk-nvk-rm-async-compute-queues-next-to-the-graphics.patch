diff --git a/src/nouveau/headers/nv_push.h b/src/nouveau/headers/nv_push.h
index 0880725..24cc7b2 100644
--- a/src/nouveau/headers/nv_push.h
+++ b/src/nouveau/headers/nv_push.h
@@ -25,6 +25,12 @@ struct nv_push {
    /* The value in the last method header, used to avoid read-back */
    uint32_t last_hdr_dw;
 
+   /* Subchannels that got a class method (not a host method, which any
+    * subchannel takes), as a mask: which engine objects the push needs.
+    * NV_PUSH_USED_MME: a method of the MME (macro calls, shadow scratch).
+    */
+   uint8_t subc_used;
+
 #ifndef NDEBUG
    /* A mask of valid subchannels */
    uint8_t subc_mask;
@@ -33,6 +39,9 @@ struct nv_push {
 
 #define SUBC_MASK_ALL 0xff
 
+/* nv_push::subc_used bit for MME methods (subchannel 7 is not used) */
+#define NV_PUSH_USED_MME (1u << 7)
+
 static inline void
 nv_push_init(struct nv_push *push, uint32_t *start,
              size_t dw_count, uint8_t subc_mask)
@@ -42,6 +51,7 @@ nv_push_init(struct nv_push *push, uint32_t *start,
    push->limit = start + dw_count;
    push->last_hdr = NULL;
    push->last_hdr_dw = 0;
+   push->subc_used = 0;
 
 #ifndef NDEBUG
    push->subc_mask = subc_mask;
@@ -132,9 +142,19 @@ __push_hdr(struct nv_push *push, uint32_t hdr)
 {
    __push_verify(push);
 
-   ASSERTED const uint32_t subc = NVC0_FIFO_SUBC_FROM_PKHDR(hdr);
+   const uint32_t subc = NVC0_FIFO_SUBC_FROM_PKHDR(hdr);
    assert(push->subc_mask & BITFIELD_BIT(subc));
 
+   /* The address field (11:0) is the method >> 2.  Methods below 0x100
+    * are host methods; 0x3400 and up are the MME's (SET_MME_SHADOW_SCRATCH,
+    * CALL_MME_MACRO/DATA) in the 3D and compute classes.
+    */
+   const uint32_t addr = hdr & 0xfff;
+   if (addr >= 0x40)
+      push->subc_used |= BITFIELD_BIT(subc);
+   if (addr >= 0xd00)
+      push->subc_used |= NV_PUSH_USED_MME;
+
    *push->end = hdr;
    push->last_hdr_dw = hdr;
    push->last_hdr = push->end;
diff --git a/src/nouveau/vulkan/nvk_cmd_buffer.c b/src/nouveau/vulkan/nvk_cmd_buffer.c
index cdcd992..4097310 100644
--- a/src/nouveau/vulkan/nvk_cmd_buffer.c
+++ b/src/nouveau/vulkan/nvk_cmd_buffer.c
@@ -106,7 +106,11 @@ nvk_create_cmd_buffer(struct vk_command_pool *vk_pool,
    cmd->pushes = UTIL_DYNARRAY_INIT;
    cmd->copy_memory_indirect_temps = UTIL_DYNARRAY_INIT;
 
-   cmd->prev_subc = ffs(nvk_cmd_buffer_subchannel_mask(cmd)) - 1;
+   const VkQueueFlags queue_flags = nvk_cmd_buffer_queue_flags(cmd);
+   cmd->compute_only = (queue_flags & VK_QUEUE_COMPUTE_BIT) &&
+                       !(queue_flags & VK_QUEUE_GRAPHICS_BIT);
+   cmd->prev_subc = cmd->compute_only ? SUBC_NV90C0 :
+                    ffs(nvk_cmd_buffer_subchannel_mask(cmd)) - 1;
 
    *cmd_buffer_out = &cmd->vk;
 
@@ -141,6 +145,10 @@ nvk_reset_cmd_buffer(struct vk_command_buffer *vk_cmd_buffer,
    util_dynarray_clear(&cmd->copy_memory_indirect_temps);
 
    memset(&cmd->state, 0, sizeof(cmd->state));
+
+   cmd->subc_used = 0;
+   cmd->needs_all_engines = false;
+   cmd->gfx_begun = false;
 }
 
 VkQueueFlags
@@ -210,6 +218,7 @@ nvk_cmd_buffer_flush_push(struct nvk_cmd_buffer *cmd, bool incomplete)
       cmd->prev_subc = NVC0_FIFO_SUBC_FROM_PKHDR(cmd->push.last_hdr_dw);
    }
 
+   cmd->subc_used |= cmd->push.subc_used;
    cmd->push.start = cmd->push.end;
 }
 
@@ -418,10 +427,17 @@ nvk_BeginCommandBuffer(VkCommandBuffer commandBuffer,
       cmd->state.inherited_pipeline_statistics =
          pBeginInfo->pInheritanceInfo->pipelineStatistics;
 
-   /* Start with a nop so we have at least something to submit */
+   /* Start with a nop so we have at least something to submit; on the
+    * engine the queue surely has
+    */
    struct nv_push *p = nvk_cmd_buffer_push(cmd, 2);
-   P_MTHD(p, NV90B5, NOP);
-   P_NV90B5_NOP(p, 0);
+   if (cmd->compute_only) {
+      P_MTHD(p, NVA0C0, NO_OPERATION);
+      P_NVA0C0_NO_OPERATION(p, 0);
+   } else {
+      P_MTHD(p, NV90B5, NOP);
+      P_NV90B5_NOP(p, 0);
+   }
 
    if (queue_flags & VK_QUEUE_COMPUTE_BIT)
       nvk_cmd_buffer_begin_compute(cmd, pBeginInfo);
@@ -502,6 +518,8 @@ nvk_CmdExecuteCommands(VkCommandBuffer commandBuffer,
        * do with it is reset it.  vkResetCommandPool() has similar language.
        */
       util_dynarray_append_dynarray(&cmd->pushes, &other->pushes);
+      cmd->subc_used |= other->subc_used;
+      cmd->needs_all_engines |= other->needs_all_engines;
 
       cmd->prev_subc = nvk_cmd_buffer_last_subchannel(other);
       /* The secondary may hold barriers and set any 3D state */
@@ -926,6 +944,12 @@ nvk_cmd_invalidate_deps(struct nvk_cmd_buffer *cmd,
    if (!(engines & NVKMD_ENGINE_COMPUTE))
       barriers &= ~NVK_BARRIER_INVALIDATE_QMD_DATA;
 
+   /* No fragment shading rate attachment on the async compute family (and
+    * no 3D engine on its channel)
+    */
+   if (cmd->compute_only)
+      barriers &= ~NVK_BARRIER_INVALIDATE_RASTER_CACHE;
+
    if (!barriers)
       return;
 
diff --git a/src/nouveau/vulkan/nvk_cmd_buffer.h b/src/nouveau/vulkan/nvk_cmd_buffer.h
index 4141e30..830fedc 100644
--- a/src/nouveau/vulkan/nvk_cmd_buffer.h
+++ b/src/nouveau/vulkan/nvk_cmd_buffer.h
@@ -431,6 +431,23 @@ struct nvk_cmd_buffer {
    struct util_dynarray pushes;
 
    uint8_t prev_subc;
+
+   /* The pool's queue family is the async compute family: compute without
+    * graphics.  Its queues run a command buffer on a channel with the
+    * compute engine alone when nvk_cmd_buffer_compute_channel_ok() says so.
+    */
+   bool compute_only;
+   /* What the command buffer and its secondaries need of a channel: the
+    * subchannels they gave class methods to (nv_push::subc_used, MME use
+    * included), and anything else that needs every engine (commands the
+    * GPU generates)
+    */
+   uint8_t subc_used;
+   bool needs_all_engines;
+   /* An async compute family command buffer set up the 3D state (for a
+    * clear)
+    */
+   bool gfx_begun;
 };
 
 VK_DEFINE_HANDLE_CASTS(nvk_cmd_buffer, vk.base, VkCommandBuffer,
@@ -568,11 +585,28 @@ nvk_get_descriptor_state_for_stages(struct nvk_cmd_buffer *cmd,
 static inline uint8_t
 nvk_cmd_buffer_last_subchannel(const struct nvk_cmd_buffer *cmd)
 {
-   if (cmd->push.last_hdr_dw) {
-      return NVC0_FIFO_SUBC_FROM_PKHDR(cmd->push.last_hdr_dw);
-   } else {
-      return cmd->prev_subc;
-   }
+   const uint8_t subc = cmd->push.last_hdr_dw ?
+                        NVC0_FIFO_SUBC_FROM_PKHDR(cmd->push.last_hdr_dw) :
+                        cmd->prev_subc;
+
+   /* The async compute family works on the compute engine: subchannel 0
+    * here only means host methods, which go on any subchannel
+    */
+   if (cmd->compute_only && subc == SUBC_NV9097)
+      return SUBC_NV90C0;
+
+   return subc;
+}
+
+/* Whether a command buffer recorded for the async compute family can run
+ * on a channel that has the compute engine alone: no 3D, copy, 2D or MME
+ * method, nothing the GPU generates.  Valid once it has ended.
+ */
+static inline bool
+nvk_cmd_buffer_compute_channel_ok(const struct nvk_cmd_buffer *cmd)
+{
+   return !cmd->needs_all_engines &&
+          !(cmd->subc_used & ~BITFIELD_BIT(SUBC_NV90C0));
 }
 
 VkQueueFlags nvk_cmd_buffer_queue_flags(struct nvk_cmd_buffer *cmd);
diff --git a/src/nouveau/vulkan/nvk_cmd_clear.c b/src/nouveau/vulkan/nvk_cmd_clear.c
index 4d66689..2e86884 100644
--- a/src/nouveau/vulkan/nvk_cmd_clear.c
+++ b/src/nouveau/vulkan/nvk_cmd_clear.c
@@ -473,6 +473,17 @@ nvk_CmdClearColorImage(VkCommandBuffer commandBuffer,
 
    nvk_pass_profile_op(cmd, NVK_PASS_PROFILE_OP_CLEAR_COLOR_IMAGE, 0);
    nvk_pass_profile_internal_begin(cmd);
+   /* The clear renders: on the async compute family that takes the 3D
+    * state a graphics command buffer starts with (and the channel with
+    * every engine, nvk_queue.c)
+    */
+   if (cmd->compute_only && !cmd->gfx_begun) {
+      const VkCommandBufferBeginInfo begin = {
+         .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+      };
+      nvk_cmd_buffer_begin_graphics(cmd, &begin);
+      cmd->gfx_begun = true;
+   }
    clear_image(cmd, image, imageLayout, vk_format,
                &clear_value, rangeCount, pRanges);
    nvk_pass_profile_internal_end(cmd);
diff --git a/src/nouveau/vulkan/nvk_cmd_indirect.c b/src/nouveau/vulkan/nvk_cmd_indirect.c
index 0859a22..192da47 100644
--- a/src/nouveau/vulkan/nvk_cmd_indirect.c
+++ b/src/nouveau/vulkan/nvk_cmd_indirect.c
@@ -1132,6 +1132,12 @@ nvk_CmdExecuteGeneratedCommandsEXT(VkCommandBuffer commandBuffer,
    struct nvk_device *dev = nvk_cmd_buffer_device(cmd);
    const struct nvk_physical_device *pdev = nvk_device_physical(dev);
 
+   /* The generated commands call MME macros, which only a channel with
+    * every engine has loaded
+    */
+   if (cmd->compute_only)
+      cmd->needs_all_engines = true;
+
    if (!isPreprocessed) {
       nvk_cmd_flush_process_state(cmd, info);
       nvk_cmd_process_cmds(cmd, info, &cmd->state);
diff --git a/src/nouveau/vulkan/nvk_device.c b/src/nouveau/vulkan/nvk_device.c
index 634328b..3d409e1 100644
--- a/src/nouveau/vulkan/nvk_device.c
+++ b/src/nouveau/vulkan/nvk_device.c
@@ -401,11 +401,24 @@ nvk_CreateDevice(VkPhysicalDevice physicalDevice,
             goto fail_slm;
       }
 
-      for (unsigned i = 0; i < pCreateInfo->queueCreateInfoCount; i++) {
-         for (unsigned q = 0; q < pCreateInfo->pQueueCreateInfos[i].queueCount; q++) {
-            result = nvk_queue_create(dev, &pCreateInfo->pQueueCreateInfos[i], q);
-            if (result != VK_SUCCESS)
-               goto fail_queues;
+      /* Graphics queues first: async compute queues share the first one's
+       * TSG (nvk_queue_create)
+       */
+      for (unsigned pass = 0; pass < 2; pass++) {
+         for (unsigned i = 0; i < pCreateInfo->queueCreateInfoCount; i++) {
+            const VkDeviceQueueCreateInfo *qci =
+               &pCreateInfo->pQueueCreateInfos[i];
+            const bool graphics =
+               pdev->queue_families[qci->queueFamilyIndex].queue_flags &
+               VK_QUEUE_GRAPHICS_BIT;
+            if (graphics != (pass == 0))
+               continue;
+
+            for (unsigned q = 0; q < qci->queueCount; q++) {
+               result = nvk_queue_create(dev, qci, q);
+               if (result != VK_SUCCESS)
+                  goto fail_queues;
+            }
          }
       }
    }
diff --git a/src/nouveau/vulkan/nvk_image.c b/src/nouveau/vulkan/nvk_image.c
index 761915b..f473e5b 100644
--- a/src/nouveau/vulkan/nvk_image.c
+++ b/src/nouveau/vulkan/nvk_image.c
@@ -113,14 +113,21 @@ nvk_get_image_plane_format_features(const struct nvk_physical_device *pdev,
       if (!vk_format_is_depth_or_stencil(vk_format))
          features |= VK_FORMAT_FEATURE_2_HOST_IMAGE_TRANSFER_BIT_EXT;
 
-      /* The copy engine handles depth and stencil just fine */
+      /* The copy engine handles depth and stencil just fine.  But not on
+       * the async compute family's queues: no queue but a graphics one
+       * may write a depth image, so ZCULL storage stays valid for images
+       * shared with them (VK_SHARING_MODE_CONCURRENT, see below).
+       */
+      const bool compute_copy = !pdev->nvkmd->kmd_info.has_async_compute;
       if (vk_format_has_depth(vk_format)) {
-         features |= VK_FORMAT_FEATURE_2_DEPTH_COPY_ON_COMPUTE_QUEUE_BIT_KHR |
-                     VK_FORMAT_FEATURE_2_DEPTH_COPY_ON_TRANSFER_QUEUE_BIT_KHR;
+         features |= VK_FORMAT_FEATURE_2_DEPTH_COPY_ON_TRANSFER_QUEUE_BIT_KHR;
+         if (compute_copy)
+            features |= VK_FORMAT_FEATURE_2_DEPTH_COPY_ON_COMPUTE_QUEUE_BIT_KHR;
       }
       if (vk_format_has_stencil(vk_format)) {
-         features |= VK_FORMAT_FEATURE_2_STENCIL_COPY_ON_COMPUTE_QUEUE_BIT_KHR |
-                     VK_FORMAT_FEATURE_2_STENCIL_COPY_ON_TRANSFER_QUEUE_BIT_KHR;
+         features |= VK_FORMAT_FEATURE_2_STENCIL_COPY_ON_TRANSFER_QUEUE_BIT_KHR;
+         if (compute_copy)
+            features |= VK_FORMAT_FEATURE_2_STENCIL_COPY_ON_COMPUTE_QUEUE_BIT_KHR;
       }
    }
 
@@ -860,6 +867,36 @@ nvk_image_can_compress(const struct nvk_physical_device *pdev,
    return true;
 }
 
+/* ZCULL storage of a depth image that transfers may write: a write on
+ * another queue must reach the 3D queue through an ownership transfer, whose
+ * acquire barrier resets ZCULL (nvk_cmd_image_layout_transition()), so the
+ * image is VK_SHARING_MODE_EXCLUSIVE.  Or every queue family that shares it
+ * has graphics or is the async compute family, whose queues may not write
+ * depth or stencil (nvk_get_image_plane_format_features()): vkd3d-proton
+ * makes every image CONCURRENT once it has more than one queue family.
+ */
+static bool
+nvk_zcull_sharing_ok(const struct nvk_physical_device *pdev,
+                     const VkImageCreateInfo *pCreateInfo)
+{
+   if (pCreateInfo->sharingMode == VK_SHARING_MODE_EXCLUSIVE)
+      return true;
+
+   if (!pdev->nvkmd->kmd_info.has_async_compute)
+      return false;
+
+   for (uint32_t i = 0; i < pCreateInfo->queueFamilyIndexCount; i++) {
+      const uint32_t family = pCreateInfo->pQueueFamilyIndices[i];
+      if (family >= pdev->queue_family_count)
+         return false;
+      if (!(pdev->queue_families[family].queue_flags &
+            (VK_QUEUE_GRAPHICS_BIT | VK_QUEUE_COMPUTE_BIT)))
+         return false;
+   }
+
+   return true;
+}
+
 static VkResult
 nvk_image_init(struct nvk_device *dev,
                struct nvk_image *image,
@@ -1140,7 +1177,7 @@ nvk_image_init(struct nvk_device *dev,
        (image->vk.usage & VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT) &&
        !(image->vk.usage & ~ZCULL_COMPATIBLE_IMAGE_USAGE) &&
        (!(image->vk.usage & VK_IMAGE_USAGE_TRANSFER_DST_BIT) ||
-        pCreateInfo->sharingMode == VK_SHARING_MODE_EXCLUSIVE) &&
+        nvk_zcull_sharing_ok(pdev, pCreateInfo)) &&
        !(image->vk.create_flags & VK_IMAGE_CREATE_SPARSE_BINDING_BIT) &&
        image->vk.image_type != VK_IMAGE_TYPE_3D &&
        image->vk.array_layers == 1 && image->vk.mip_levels == 1 &&
diff --git a/src/nouveau/vulkan/nvk_physical_device.c b/src/nouveau/vulkan/nvk_physical_device.c
index 74d2e83..3a3f290 100644
--- a/src/nouveau/vulkan/nvk_physical_device.c
+++ b/src/nouveau/vulkan/nvk_physical_device.c
@@ -1795,6 +1795,19 @@ nvk_create_physical_device_for_nvkmd(struct nvk_instance *instance,
                      VK_QUEUE_SPARSE_BINDING_BIT,
       .queue_count = 1,
    };
+   /* Async compute (nvkmd_info::has_async_compute): queues of this family
+    * run next to the graphics queue instead of being time-sliced against it.
+    * vkd3d-proton puts D3D12 compute (and copy) queues here.  Four queues,
+    * as many as vkd3d-proton creates of a family.  Copies that need the
+    * copy engine are allowed (TRANSFER), see nvk_queue.c.
+    */
+   if (pdev->nvkmd->kmd_info.has_async_compute) {
