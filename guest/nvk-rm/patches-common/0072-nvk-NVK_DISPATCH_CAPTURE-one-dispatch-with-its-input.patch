diff --git a/src/nouveau/vulkan/nvk_dispatch_capture.c b/src/nouveau/vulkan/nvk_dispatch_capture.c
new file mode 100644
index 0000000..7725c19
--- /dev/null
+++ b/src/nouveau/vulkan/nvk_dispatch_capture.c
@@ -0,0 +1,2128 @@
+/*
+ * Copyright © 2026 Conduit contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * NVK_DISPATCH_CAPTURE: one dispatch of a chosen compute shader, captured
+ * with everything a standalone program needs to run it again with the same
+ * inputs, so that NAK's code and another driver's can be timed and checked
+ * on a real game's data rather than on synthetic inputs, which drive loops
+ * differently.
+ *
+ *   NVK_DISPATCH_CAPTURE=<hash>[,<hash>...]  vk_shader::src_hash of the
+ *       shaders, 16 hex digits: vkd3d-proton's DXIL hash (the name of its
+ *       VKD3D_SHADER_DUMP_PATH files and of NVK_DISPATCH_PROFILE's rows)
+ *   NVK_DISPATCH_CAPTURE_DIR      where captures go (default
+ *       %ProgramData%\Helios\dcap on Windows, /tmp/nvk-dcap elsewhere)
+ *   NVK_DISPATCH_CAPTURE_DELAY_S  seconds after device creation before
+ *       dispatches count (default 20)
+ *   NVK_DISPATCH_CAPTURE_TRIGGER  a file: dispatches count only once it
+ *       exists (checked at most every 250 ms), so a capture can be started
+ *       at the right moment of a running game; unset: no file needed
+ *   NVK_DISPATCH_CAPTURE_SKIP     matching dispatches skipped after that,
+ *       per hash (default 0: the first one is captured)
+ *   NVK_DISPATCH_CAPTURE_COUNT    captures per hash (default 1)
+ *   NVK_DISPATCH_CAPTURE_POST=1   also copies what the shader may write after
+ *       the dispatch (the NVK result, for comparing a replay against)
+ *   NVK_DISPATCH_CAPTURE_MAX_MB   staging limit per capture (default 2048)
+ *
+ * The SPIR-V of every compute pipeline whose shader has a listed hash is
+ * scanned when the pipeline is created (vk_device::compute_spirv_hook): the
+ * push constant block, every resource variable with its descriptor set,
+ * binding and descriptor type, the array index of every access to a
+ * descriptor array when it is a push constant word plus a constant (how
+ * vkd3d-proton indexes its descriptor heaps from root table offsets) or a
+ * constant, and every buffer device address loaded from a push constant
+ * (vkd3d-proton's root descriptors).  Other index expressions are reported
+ * as unsupported in the manifest; the capture goes on without them.
+ *
+ * When a captured dispatch is recorded, the push constants come from the
+ * root table, each referenced descriptor is read from its set's CPU map (or
+ * from a mapped descriptor buffer) and turned back into its object through
+ * tables kept from image view, buffer view and sampler creation, and copy
+ * engine copies of every image subresource of the view, of every texel and
+ * storage buffer range, of every root buffer address (up to the end of its
+ * allocation or the type's size) and of indirect arguments go into a GART
+ * staging buffer right before the launch, behind a flush and wait for idle.
+ * A copy engine semaphore marks the end.  When the command buffer is reset
+ * or destroyed (the GPU is done with it) a capture whose marker landed is
+ * written: manifest.json, shader.spv, push.bin and one .bin per resource,
+ * in <dir>\<hash>-p<pid>-<n>.  Events are logged with mesa_logi and to
+ * <dir>\nvk-dcap.log.
+ *
+ * A command buffer of the async compute family that captures runs on the
+ * channel with every engine (it uses the copy engine).
+ *
+ * Limits: direct and indirect vkCmdDispatch only (not device-generated
+ * commands); single-plane, single-sample, non-sparse-residency images
+ * (color, or the depth or stencil aspect of a depth view); descriptors as
+ * the CPU sees them when the dispatch is recorded (an application that
+ * rewrites a heap entry between recording and execution is captured with
+ * the old entry); root buffer addresses whose pointee has no fixed size
+ * (runtime arrays) are copied up to 16 MiB; a resource two descriptors
+ * alias (the same image as SRV and UAV) is captured twice.
+ */
+#include "nvk_dispatch_capture.h"
+
+#include "nvk_buffer.h"
+#include "nvk_buffer_view.h"
+#include "nvk_cmd_buffer.h"
+#include "nvk_descriptor_set.h"
+#include "nvk_descriptor_set_layout.h"
+#include "nvk_descriptor_types.h"
+#include "nvk_device.h"
+#include "nvk_edb_bview_cache.h"
+#include "nvk_format.h"
+#include "nvk_image.h"
+#include "nvk_image_view.h"
+#include "nvk_physical_device.h"
+#include "nvk_sampler.h"
+#include "nvk_shader.h"
+#include "nvkmd/nvkmd.h"
+
+#include "nv_push_cl90b5.h"
+#include "nv_push_cla0c0.h"
+
+#include "vk_enum_to_str.h"
+#include "vk_format.h"
+#include "vk_pipeline_layout.h"
+#include "vk_sampler.h"
+
+#include "util/format/u_format.h"
+#include "util/hash_table.h"
+#include "util/log.h"
+#include "util/os_misc.h"
+#include "util/os_time.h"
+#include "util/simple_mtx.h"
+#include "util/u_debug.h"
+#include "util/u_math.h"
+
+#include <inttypes.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+#ifdef _WIN32
+#include <windows.h>
+#else
+#include <sys/stat.h>
+#include <unistd.h>
+#endif
+
+#define DCAP_MAX_HASHES 32
+#define DCAP_MAX_VARS   64
+#define DCAP_MAX_REFS   256
+#define DCAP_MAX_BDAS   32
+#define DCAP_MAX_RES    256
+#define DCAP_MAX_MIPS   16
+#define DCAP_NONE       0xffffffffu
+#define DCAP_BDA_RUNTIME_MAX (16ull << 20)
+#define DCAP_BUF_MAX    (256ull << 20)
+#define DCAP_HEADER_B   256u
+#define DCAP_MARKER     0xdc000000u
+
+/* Tags in the low bits of the image table registry's pointers */
+#define DCAP_TAG_SAMPLED  1u
+#define DCAP_TAG_STORAGE  2u
+#define DCAP_TAG_BVIEW    3u
+
+struct nvk_dcap_dev {
+   simple_mtx_t mutex;
+   uint64_t hashes[DCAP_MAX_HASHES];
+   uint32_t seen[DCAP_MAX_HASHES];
+   uint32_t taken[DCAP_MAX_HASHES];
+   uint32_t hash_count;
+   int64_t arm_ns;
+   char trigger[512];
+   bool triggered;
+   int64_t trigger_check_ns;
+   uint32_t skip, count;
+   bool post;
+   uint64_t max_B;
+   uint32_t serial;
+   char dir[512];
+   FILE *log;
+   /* image table index -> tagged nvk_image_view / nvk_buffer_view */
+   struct hash_table_u64 *images;
+   /* sampler table index -> struct vk_sampler_state (malloc) */
+   struct hash_table_u64 *samplers;
+};
+
+struct dcap_var {
+   uint32_t id, set, binding;
+   VkDescriptorType type;
+   bool array, writable;
+   uint8_t dim, arrayed, ms, depth;
+   /* The binding in the pipeline layout the pipeline was created with */
+   bool have_layout;
+   VkDescriptorType layout_type;
+   uint32_t layout_offset, layout_stride, layout_array_size;
+   uint32_t layout_set_flags;
+};
+
+struct dcap_ref {
+   uint16_t var;
+   uint32_t pc_off; /* byte offset of the push constant word, DCAP_NONE */
+   uint32_t add;
+};
+
+struct dcap_bda {
+   uint32_t pc_off;
+   uint64_t size_B; /* 0: unknown (runtime array) */
+   bool writable;
+};
+
+struct nvk_dcap_recipe {
+   uint64_t src_hash;
+   uint32_t *spirv;
+   size_t spirv_size;
+   uint32_t push_size;
+   uint32_t nvars, nrefs, nbdas;
+   struct dcap_var vars[DCAP_MAX_VARS];
+   struct dcap_ref refs[DCAP_MAX_REFS];
+   struct dcap_bda bdas[DCAP_MAX_BDAS];
+   uint32_t nunsupported;
+   char unsupported[1024];
+};
+
+enum dcap_res_kind {
+   DCAP_RES_NULL,
+   DCAP_RES_IMAGE,
+   DCAP_RES_TEXEL_BUFFER,
+   DCAP_RES_BUFFER,
+   DCAP_RES_SAMPLER,
+   DCAP_RES_BDA,
+   DCAP_RES_ERROR,
+};
+
+struct dcap_sub {
+   uint32_t mip;
+   VkExtent3D extent;
+   uint32_t layers;
+   uint32_t row_stride_B;
+   uint64_t image_stride_B;
+   uint64_t off_B, size_B;
+};
+
+struct dcap_res {
+   enum dcap_res_kind kind;
+   uint32_t var; /* DCAP_NONE for a root address */
+   uint32_t set, binding, index;
+   VkDescriptorType dtype;
+   uint32_t pc_off, add;
+   bool writable;
+
+   /* Image */
+   const struct nvk_image *img;
+   VkImageType image_type;
+   VkImageViewType view_type;
+   VkFormat image_format, view_format, copy_format;
+   VkImageAspectFlags aspect;
+   VkComponentMapping swizzle;
+   float min_lod;
+   uint32_t base_mip, mips, base_layer, layers;
+   VkExtent3D extent; /* the view's first level */
+   uint32_t nsubs;
+   struct dcap_sub subs[DCAP_MAX_MIPS];
+
+   /* Buffers and root addresses */
+   uint64_t addr, range_B, bound_B;
+   VkFormat buf_format;
+   bool truncated;
+
+   /* Samplers (alone, or with a combined image) */
+   bool have_sampler;
+   uint32_t sampler_index;
+   struct vk_sampler_state sampler;
+
+   /* Staging */
+   uint64_t off_B, size_B, post_off_B;
+   char note[160];
+};
+
+struct nvk_dcap {
+   struct list_head link;
+   uint32_t serial, marker;
+   uint64_t src_hash;
+   uint32_t code_hash;
+   uint32_t local[3];
+   uint32_t base_group[3];
+   uint32_t groups[3];
+   bool indirect;
+   uint64_t indirect_addr;
+   uint32_t call_index;
+   bool post;
+   bool compute_only;
+   double t_s;
+   uint8_t push[NVK_MAX_PUSH_SIZE];
+   uint32_t push_size;
+   uint32_t *spirv;
+   size_t spirv_size;
+   char unsupported[1024];
+   struct nvkmd_mem *mem;
+   uint64_t mem_size_B;
+   uint32_t nres;
+   struct dcap_res res[DCAP_MAX_RES];
+   /* Copy of the recipe's variables for the manifest's binding list */
+   uint32_t nvars;
+   struct dcap_var vars[DCAP_MAX_VARS];
+};
+
+/* ------------------------------------------------------------------------ */
+/* Logging */
+
+static void PRINTFLIKE(2, 3)
+dcap_log(struct nvk_dcap_dev *dcap, const char *fmt, ...)
+{
+   char buf[1024];
+   va_list ap;
+   va_start(ap, fmt);
+   vsnprintf(buf, sizeof(buf), fmt, ap);
+   va_end(ap);
+   mesa_logi("NVK dispatch capture: %s", buf);
+   if (dcap->log != NULL) {
+      fprintf(dcap->log, "%.3f %s\n", os_time_get_nano() / 1e9, buf);
+      fflush(dcap->log);
+   }
+}
