+++ b/src/nouveau/vulkan/nvk_dispatch_capture.h
@@ -0,0 +1,61 @@
+/*
+ * Copyright © 2026 Conduit contributors
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef NVK_DISPATCH_CAPTURE_H
+#define NVK_DISPATCH_CAPTURE_H 1
+
+#include "nvk_private.h"
+
+struct nvk_buffer_view;
+struct nvk_cmd_buffer;
+struct nvk_dcap;
+struct nvk_dcap_recipe;
+struct nvk_device;
+struct nvk_image_view;
+struct vk_sampler_state;
+
+/* NVK_DISPATCH_CAPTURE=<hash>[,<hash>...]: everything one dispatch of a
+ * compute shader with that source hash (vk_shader::src_hash, the
+ * vkd3d-proton DXIL hash) needs to be replayed outside the application --
+ * SPIR-V, push constants, grid and the contents of every descriptor and
+ * root buffer address the shader reads -- written to a directory per
+ * capture (see nvk_dispatch_capture.c).  dev->dcap is NULL without it.
+ */
+void nvk_dcap_init(struct nvk_device *dev);
+void nvk_dcap_finish(struct nvk_device *dev);
+
+void nvk_dcap_recipe_free(struct nvk_dcap_recipe *recipe);
+
+/* Image table and sampler table indices back to their objects */
+void nvk_dcap_note_image_view(struct nvk_device *dev,
+                              const struct nvk_image_view *view);
+void nvk_dcap_forget_image_view(struct nvk_device *dev,
+                                const struct nvk_image_view *view);
+void nvk_dcap_note_buffer_view(struct nvk_device *dev,
+                               const struct nvk_buffer_view *view);
+void nvk_dcap_forget_buffer_view(struct nvk_device *dev,
+                                 const struct nvk_buffer_view *view);
+void nvk_dcap_note_sampler(struct nvk_device *dev, uint32_t desc_index,
+                           const struct vk_sampler_state *state);
+void nvk_dcap_forget_sampler(struct nvk_device *dev, uint32_t desc_index);
+
+/* Around a dispatch's launch: begin before anything of the dispatch is
+ * recorded (it records copies of the inputs), end after the launch (copies
+ * of the outputs with NVK_DISPATCH_CAPTURE_POST, the completion marker).
+ * begin returns NULL when this dispatch is not captured.  groups is the
+ * grid of a direct dispatch, indirect_addr the arguments of an indirect
+ * one (0 for direct).
+ */
+struct nvk_dcap *nvk_dcap_begin(struct nvk_cmd_buffer *cmd,
+                                const uint32_t base_group[3],
+                                const uint32_t groups[3],
+                                uint64_t indirect_addr);
+void nvk_dcap_end(struct nvk_cmd_buffer *cmd, struct nvk_dcap *cap);
+
+/* The command buffer is reset or destroyed: the GPU is done with it, so
+ * captures it ran are written and all are freed.
+ */
+void nvk_dcap_cmd_reset(struct nvk_cmd_buffer *cmd);
+
+#endif
diff --git a/src/nouveau/vulkan/nvk_edb_bview_cache.c b/src/nouveau/vulkan/nvk_edb_bview_cache.c
index 8d8fb1d..d73a447 100644
--- a/src/nouveau/vulkan/nvk_edb_bview_cache.c
+++ b/src/nouveau/vulkan/nvk_edb_bview_cache.c
@@ -257,3 +257,24 @@ nvk_edb_bview_cache_get_descriptor(struct nvk_device *dev,
       .oob_alpha = oob_alpha,
    };
 }
+
+bool
+nvk_edb_bview_cache_lookup_index(struct nvk_device *dev,
+                                 struct nvk_edb_bview_cache *cache,
+                                 uint32_t index, uint64_t *base_addr_out,
+                                 enum pipe_format *format_out)
+{
+   if (cache->cache == NULL || index == 0)
+      return false;
+   hash_table_foreach(cache->cache, entry) {
+      if ((uint32_t)(uintptr_t)entry->data != index)
+         continue;
+      struct bvdesc_key key;
+      memcpy(&key, &entry->key, sizeof(key));
+      *base_addr_out = base_addr_for_chunk(dev, key.chunk, key.format) +
+                       key.rgb_offset;
+      *format_out = key.format;
+      return true;
+   }
+   return false;
+}
