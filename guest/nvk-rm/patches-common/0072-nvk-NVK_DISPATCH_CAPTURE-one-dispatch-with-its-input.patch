+
+   /* NVK_DISPATCH_CAPTURE: copies of the inputs before anything else */
+   struct nvk_dcap *dcap = NULL;
+   if (unlikely(nvk_cmd_buffer_device(cmd)->dcap != NULL))
+      dcap = nvk_dcap_begin(cmd, base_workgroup, global_size, 0);
    nvk_flush_compute_state(cmd, base_workgroup, global_size);
 
    uint64_t qmd_addr = 0;
@@ -365,6 +371,9 @@ nvk_CmdDispatchBase(VkCommandBuffer commandBuffer,
 
    if (unlikely(prof_slot >= 0))
       nvk_dispatch_profile_end(cmd, prof_slot);
+
+   if (unlikely(dcap != NULL))
+      nvk_dcap_end(cmd, dcap);
 }
 
 void
@@ -490,6 +499,13 @@ nvk_CmdDispatchIndirect2KHR(VkCommandBuffer commandBuffer,
 
    nvk_pass_profile_op(cmd, NVK_PASS_PROFILE_OP_DISPATCH_INDIRECT, 0);
 
+   /* NVK_DISPATCH_CAPTURE: copies of the inputs and arguments first */
+   struct nvk_dcap *dcap = NULL;
+   if (unlikely(dev->dcap != NULL)) {
+      const uint32_t zero[3] = { 0, 0, 0 };
+      dcap = nvk_dcap_begin(cmd, zero, NULL, dispatch_addr);
+   }
+
    /* We set these through the MME */
    uint32_t base_workgroup[3] = { 0, 0, 0 };
    uint32_t global_size[3] = { 0, 0, 0 };
@@ -605,4 +621,7 @@ nvk_CmdDispatchIndirect2KHR(VkCommandBuffer commandBuffer,
 
    if (unlikely(prof_slot >= 0))
       nvk_dispatch_profile_end(cmd, prof_slot);
+
+   if (unlikely(dcap != NULL))
+      nvk_dcap_end(cmd, dcap);
 }
