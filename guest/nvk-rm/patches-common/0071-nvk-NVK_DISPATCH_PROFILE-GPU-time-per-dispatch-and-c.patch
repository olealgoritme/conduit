diff --git a/src/nouveau/vulkan/nvk_pass_profile.c b/src/nouveau/vulkan/nvk_pass_profile.c
index 218eb14..463e95e 100644
--- a/src/nouveau/vulkan/nvk_pass_profile.c
+++ b/src/nouveau/vulkan/nvk_pass_profile.c
@@ -53,6 +53,36 @@
  * The reports cost a little GPU time each (a flush of pending writes or a
  * wait for idle, and a release); fine for finding a 10x, not for measuring
  * 1 %.
+ *
+ * NVK_DISPATCH_PROFILE=1 (with or without NVK_PASS_PROFILE) times every
+ * dispatch: vkCmdDispatch, vkCmdDispatchBase and vkCmdDispatchIndirect in
+ * any command buffer on any queue (the async compute queue too), the
+ * dispatches the driver records for meta operations, and each
+ * vkCmdExecuteGeneratedCommandsEXT of compute commands as a whole.  A
+ * compute-class report goes right before the launch and another right
+ * after it, each behind a WAIT_FOR_IDLE, in the same ring and harvest as
+ * the passes.  Each sample is keyed by the compute shader: its source hash
+ * (vk_shader::src_hash, vkd3d-proton's DXIL hash -- the name of its
+ * VKD3D_SHADER_DUMP_PATH files -- else a hash of the SPIR-V), its code hash
+ * (the one NVK_SHADER_STATS prints) and its workgroup size.  A direct
+ * dispatch records its grid; an indirect one has its arguments copied by
+ * the compute engine into a mapped buffer just before it launches, so its
+ * grid is known too.  Every two seconds a table, heaviest first: GPU ms/s,
+ * share of all dispatch time, calls/s, mean, median and maximum us per
+ * call, the shader's registers, warps per SM, instructions, spills and
+ * local and shared memory, the most common grids and the range of
+ * workgroup counts.
+ *
+ * The waits serialize every dispatch: dispatches that would overlap on the
+ * GPU run one after another, each with the machine to itself (no tail of
+ * the previous one), so the frame gets slower and short dispatches look a
+ * little longer than they are.  Right for attributing time to shaders, not
+ * for the frame time.  On the async compute queue the time is the compute
+ * channel's own, with whatever graphics work runs next to it; set
+ * NVK_RM_ASYNC_COMPUTE=0 to time all dispatches on the graphics channel
+ * alone.  A secondary command buffer's dispatches have one slot each per
+ * recording, so a secondary executed several times between two harvests
+ * counts once.
  */
 #include "nvk_pass_profile.h"
 
@@ -97,6 +127,11 @@
 #define PROF_PAYLOAD    0x4e564b50u /* "NVKP" */
 #define PROF_DUMP_MEM_B (4u << 20)
 #define PROF_DUMP_PAYLOAD 0x504d5544u /* "DUMP" */
+#define PROF_DISP_SIGS    4096u
+#define PROF_DISP_SAMPLES 64u   /* durations kept per shader and window */
+#define PROF_DISP_GRIDS   4u
+#define PROF_DISP_LOG_TOP 80u
+#define PROF_ARGS_NONE    0xffffffffu
 
 /* One report as the 3D or compute class or the copy engine writes it with a
  * four-word structure: payload (or a counter's low 32 bits) and timestamp.
@@ -166,6 +201,39 @@ struct prof_meta {
    uint32_t sig;   /* index into sigs + 1, 0 = none (yet) */
    uint32_t stat;  /* index into the stat ring + 1, 0 = none */
    struct nvk_pass_profile_counts counts;
+   /* NVK_DISPATCH_PROFILE: index into disp_sigs + 1 (0: not a dispatch),
+    * the kind, whether a meta operation recorded it, and the grid of a
+    * direct dispatch
+    */
+   uint32_t disp;
+   uint8_t disp_kind;
+   bool disp_meta;
+   uint32_t grid[3];
+};
+
+/* NVK_DISPATCH_PROFILE: one compute shader (and workgroup size) */
+struct prof_disp_grid {
+   uint32_t g[3];
+   uint64_t count;
+};
+
+struct prof_disp_sig {
+   char key[64];
+   uint64_t src_hash;
+   uint32_t code_hash;
+   uint32_t local[3];
+   uint32_t gprs, warps, instrs, spills, slm, smem;
+   uint64_t cycles;
+   /* The window (harvest thread) */
+   uint64_t gpu_ns, count;
+   uint64_t ind_count, ind_read, dgc_count, meta_count;
+   uint64_t known, groups_min, groups_max;
+   uint64_t max_ns;
+   uint32_t nsamples;
+   uint32_t samples[PROF_DISP_SAMPLES];
+   struct prof_disp_grid grids[PROF_DISP_GRIDS];
+   uint32_t ngrids;
+   uint64_t grids_evicted;
 };
 
 /* NVK_PASS_PROFILE=4: the methods recorded in a render pass, per
@@ -292,6 +360,19 @@ struct nvk_pass_profile {
    } dump_recs[1024];
    uint32_t dump_rec_count;
 
+   /* NVK_DISPATCH_PROFILE: shaders (recording threads, prof->mutex),
+    * indirect arguments per slot (4 words), the reservoir's random state
+    * (harvest thread)
+    */
+   bool dispatch;
+   struct hash_table *disp_ht;
+   struct prof_disp_sig *disp_sigs;   /* PROF_DISP_SIGS */
+   uint32_t disp_sig_count;
+   uint64_t disp_dropped, disp_dropped_window;
+   struct nvkmd_mem *args_mem;
+   uint32_t *args;
+   uint64_t rng;
+
    /* The harvest thread (every PROF_HARVEST_MS, a log line every
     * PROF_LOG_NS), independent of submits and frames.
     */
@@ -385,6 +466,11 @@ prof_open_file(char *path, size_t size)
 static void
 prof_free(struct nvk_pass_profile *prof)
 {
+   if (prof->args_mem != NULL)
+      nvkmd_mem_unref(prof->args_mem);
+   if (prof->disp_ht != NULL)
+      _mesa_hash_table_destroy(prof->disp_ht, NULL);
+   free(prof->disp_sigs);
    if (prof->dump_mem != NULL)
       nvkmd_mem_unref(prof->dump_mem);
    free(prof->dump_text);
@@ -407,20 +493,31 @@ void
 nvk_pass_profile_init(struct nvk_device *dev)
 {
    const unsigned level = debug_get_num_option("NVK_PASS_PROFILE", 0);
-   if (level == 0)
+   const bool dispatch = debug_get_bool_option("NVK_DISPATCH_PROFILE", false);
+   if (level == 0 && !dispatch)
       return;
 
    struct nvk_pass_profile *prof = calloc(1, sizeof(*prof));
    if (prof == NULL)
       return;
    prof->level = level;
+   prof->dispatch = dispatch;
+   prof->rng = 0x9e3779b97f4a7c15ull;
    prof->meta = calloc(PROF_SLOTS, sizeof(*prof->meta));
    prof->sigs = calloc(PROF_SIGS, sizeof(*prof->sigs));
    prof->sig_ht = _mesa_hash_table_create(NULL, _mesa_hash_string,
                                           _mesa_key_string_equal);
+   bool disp_ok = true;
+   if (dispatch) {
+      prof->disp_sigs = calloc(PROF_DISP_SIGS, sizeof(*prof->disp_sigs));
+      prof->disp_ht = _mesa_hash_table_create(NULL, _mesa_hash_string,
+                                              _mesa_key_string_equal);
+      disp_ok = prof->disp_sigs != NULL && prof->disp_ht != NULL;
+   }
 
    VkResult result = VK_ERROR_OUT_OF_HOST_MEMORY;
-   if (prof->meta != NULL && prof->sigs != NULL && prof->sig_ht != NULL) {
+   if (prof->meta != NULL && prof->sigs != NULL && prof->sig_ht != NULL &&
+       disp_ok) {
       result = nvkmd_dev_alloc_mapped_mem(dev->nvkmd, &dev->vk.base,
                                           PROF_SLOTS * sizeof(struct prof_slot_gpu),
                                           0, NVKMD_MEM_GART,
@@ -448,6 +545,18 @@ nvk_pass_profile_init(struct nvk_device *dev)
    }
    prof->gpu = prof->mem->map;
    memset(prof->gpu, 0, PROF_SLOTS * sizeof(struct prof_slot_gpu));
+   if (dispatch) {
+      /* Without it indirect dispatches have no grid */
+      if (nvkmd_dev_alloc_mapped_mem(dev->nvkmd, &dev->vk.base,
+                                     PROF_SLOTS * 4 * sizeof(uint32_t),
+                                     0, NVKMD_MEM_GART, NVKMD_MEM_MAP_RDWR,
+                                     &prof->args_mem) != VK_SUCCESS) {
+         prof->args_mem = NULL;
+      } else {
+         prof->args = prof->args_mem->map;
+         memset(prof->args, 0xff, PROF_SLOTS * 4 * sizeof(uint32_t));
+      }
+   }
    if (level >= 5) {
       if (nvkmd_dev_alloc_mapped_mem(dev->nvkmd, &dev->vk.base, PROF_DUMP_MEM_B,
                                      0, NVKMD_MEM_GART, NVKMD_MEM_MAP_RDWR,
@@ -473,10 +582,20 @@ nvk_pass_profile_init(struct nvk_device *dev)
    char path[512] = "";
    prof->file = prof_open_file(path, sizeof(path));
    dev->pass_profile = prof;
-   prof_log(prof, "NVK pass profile: level %u on for device %p (%u slots, "
-            "%u signatures%s), file %s", level, (void *)dev, PROF_SLOTS,
-            PROF_SIGS, prof->stat_mem != NULL ? ", pass counters" : "",
-            prof->file != NULL ? path : "(none: no writable folder)");
+   if (level > 0) {
+      prof_log(prof, "NVK pass profile: level %u on for device %p (%u slots, "
+               "%u signatures%s), file %s", level, (void *)dev, PROF_SLOTS,
+               PROF_SIGS, prof->stat_mem != NULL ? ", pass counters" : "",
+               prof->file != NULL ? path : "(none: no writable folder)");
+   }
+   if (dispatch) {
+      prof_log(prof, "NVK dispatch profile: on for device %p (%u slots, %u "
+               "shaders, indirect arguments %s), file %s; every dispatch "
+               "waits for idle before and after it", (void *)dev,
+               PROF_SLOTS, PROF_DISP_SIGS,
+               prof->args != NULL ? "read back" : "not read (no memory)",
+               prof->file != NULL ? path : "(none: no writable folder)");
+   }
    if (prof->file != NULL)
       fflush(prof->file);
    if (mtx_init(&prof->stop_mutex, mtx_plain) == thrd_success &&
@@ -579,21 +698,27 @@ prof_describe_att(char *buf, size_t size, const char *what,
 /* A timestamped report at addr, on the engine that ran the last method, so
  * it is written after the preceding work on that engine has finished.
  */
+static void
+prof_emit_report_compute(struct nvk_cmd_buffer *cmd, uint64_t addr)
+{
+   struct nv_push *p = nvk_cmd_buffer_push(cmd, 7);
+   P_IMMD(p, NV90C0, WAIT_FOR_IDLE, 0);
+   P_MTHD(p, NV90C0, SET_REPORT_SEMAPHORE_A);
+   P_NV90C0_SET_REPORT_SEMAPHORE_A(p, addr >> 32);
+   P_NV90C0_SET_REPORT_SEMAPHORE_B(p, addr);
+   P_NV90C0_SET_REPORT_SEMAPHORE_C(p, PROF_PAYLOAD);
+   P_NV90C0_SET_REPORT_SEMAPHORE_D(p, {
+      .operation = OPERATION_RELEASE,
+      .structure_size = STRUCTURE_SIZE_FOUR_WORDS,
+   });
+}
+
 static void
 prof_emit_report(struct nvk_cmd_buffer *cmd, uint64_t addr)
 {
    const uint8_t subc = nvk_cmd_buffer_last_subchannel(cmd);
    if (subc == SUBC_NV90C0) {
-      struct nv_push *p = nvk_cmd_buffer_push(cmd, 7);
-      P_IMMD(p, NV90C0, WAIT_FOR_IDLE, 0);
-      P_MTHD(p, NV90C0, SET_REPORT_SEMAPHORE_A);
-      P_NV90C0_SET_REPORT_SEMAPHORE_A(p, addr >> 32);
-      P_NV90C0_SET_REPORT_SEMAPHORE_B(p, addr);
-      P_NV90C0_SET_REPORT_SEMAPHORE_C(p, PROF_PAYLOAD);
-      P_NV90C0_SET_REPORT_SEMAPHORE_D(p, {
-         .operation = OPERATION_RELEASE,
-         .structure_size = STRUCTURE_SIZE_FOUR_WORDS,
-      });
+      prof_emit_report_compute(cmd, addr);
    } else if (subc == SUBC_NV90B5) {
       struct nv_push *p = nvk_cmd_buffer_push(cmd, 9);
       P_MTHD(p, NV90B5, SET_SEMAPHORE_A);
@@ -650,6 +775,7 @@ prof_begin(struct nvk_cmd_buffer *cmd, const char *name, enum prof_kind kind)
       prof->next = (prof->next + 1) % PROF_SLOTS;
       prof->meta[slot].sig = name != NULL ? sig : 0;
       prof->meta[slot].stat = 0;
+      prof->meta[slot].disp = 0;
       memset(&prof->meta[slot].counts, 0, sizeof(prof->meta[slot].counts));
    } else {
       prof->dropped++;
@@ -744,8 +870,7 @@ void
 nvk_pass_profile_op(struct nvk_cmd_buffer *cmd, enum nvk_pass_profile_op op,
                     uint64_t groups)
 {
-   struct nvk_device *dev = nvk_cmd_buffer_device(cmd);
-   if (likely(dev->pass_profile == NULL))
+   if (likely(!cmd->pass_profile_on))
       return;
    /* Inside a render pass it is the pass's; inside a meta operation the
     * operation's.  Secondaries are timed as a whole by their primary.
@@ -768,6 +893,130 @@ nvk_pass_profile_op(struct nvk_cmd_buffer *cmd, enum nvk_pass_profile_op op,
    cmd->pass_profile_op_slot = prof_begin(cmd, NULL, PROF_KIND_OP);
 }
 
+/* NVK_DISPATCH_PROFILE: with prof->mutex held, the shader's signature + 1,
+ * 0 when the table is full
+ */
+static uint32_t
+prof_disp_sig_locked(struct nvk_pass_profile *prof, const char *key,
+                     const struct nvk_shader *sh, uint64_t src_hash,
+                     uint32_t code_hash)
+{
+   struct hash_entry *he = _mesa_hash_table_search(prof->disp_ht, key);
+   if (he != NULL)
+      return (uint32_t)(uintptr_t)he->data;
+   if (prof->disp_sig_count == PROF_DISP_SIGS)
+      return 0;
+   struct prof_disp_sig *d = &prof->disp_sigs[prof->disp_sig_count];
+   snprintf(d->key, sizeof(d->key), "%s", key);
+   d->src_hash = src_hash;
+   d->code_hash = code_hash;
+   if (sh != NULL) {
+      const struct nak_shader_info *i = &sh->info;
+      for (unsigned c = 0; c < 3; c++)
+         d->local[c] = i->cs.local_size[c];
+      d->gprs = i->num_gprs;
+      d->warps = i->max_warps_per_sm;
+      d->instrs = i->num_instrs;
+      d->cycles = i->num_static_cycles;
+      d->spills = i->num_spills_to_mem + i->num_fills_from_mem;
+      d->slm = i->slm_size;
+      d->smem = i->cs.smem_size;
+   }
+   d->groups_min = UINT64_MAX;
+   /* Published to the harvest thread with the count */
+   p_atomic_set(&prof->disp_sig_count, prof->disp_sig_count + 1);
+   _mesa_hash_table_insert(prof->disp_ht, d->key,
+                           (void *)(uintptr_t)prof->disp_sig_count);
+   return prof->disp_sig_count;
+}
+
+int32_t
+nvk_dispatch_profile_alloc(struct nvk_cmd_buffer *cmd,
+                           struct nvk_shader *shader,
+                           enum nvk_dispatch_profile_kind kind,
+                           const uint32_t *groups,
+                           uint64_t *args_addr_out)
+{
+   struct nvk_device *dev = nvk_cmd_buffer_device(cmd);
+   struct nvk_pass_profile *prof = dev->pass_profile;
+   if (args_addr_out != NULL)
+      *args_addr_out = 0;
+
+   /* The key once per shader: the code hash reads all of its code */
+   uint32_t ds = shader != NULL ? p_atomic_read(&shader->dispatch_profile_sig) : 0;
+   char key[64] = "";
+   uint64_t src_hash = 0;
+   uint32_t code_hash = 0;
+   if (ds == 0) {
+      if (shader != NULL) {
+         src_hash = shader->vk.src_hash;
+         code_hash = shader->code_size > 0 ?
+            _mesa_hash_data(shader->code_ptr, shader->code_size) : 0;
+         snprintf(key, sizeof(key), "%016" PRIx64 " %08x %ux%ux%u", src_hash,
+                  code_hash, shader->info.cs.local_size[0],
+                  shader->info.cs.local_size[1],
+                  shader->info.cs.local_size[2]);
+      } else {
+         snprintf(key, sizeof(key), "execution set");
+      }
+   }
+
+   simple_mtx_lock(&prof->mutex);
+   if (ds == 0)
+      ds = prof_disp_sig_locked(prof, key, shader, src_hash, code_hash);
+   uint32_t slot = 0;
+   if (ds != 0) {
+      slot = prof->next;
+      prof->next = (prof->next + 1) % PROF_SLOTS;
+      struct prof_meta *m = &prof->meta[slot];
+      m->sig = 0;
+      m->stat = 0;
+      m->disp = ds;
+      m->disp_kind = kind;
+      m->disp_meta = cmd->pass_profile_internal > 0;
+      for (unsigned c = 0; c < 3; c++)
+         m->grid[c] = groups != NULL ? groups[c] : 0;
+   } else {
+      prof->disp_dropped++;
+      prof->disp_dropped_window++;
+   }
+   simple_mtx_unlock(&prof->mutex);
+   if (ds == 0)
+      return -1;
+   if (shader != NULL)
+      p_atomic_set(&shader->dispatch_profile_sig, ds);
+
+   if (kind == NVK_DISPATCH_PROFILE_INDIRECT && prof->args != NULL &&
+       args_addr_out != NULL) {
+      uint32_t *a = &prof->args[slot * 4];
+      a[0] = a[1] = a[2] = PROF_ARGS_NONE;
+      *args_addr_out = prof->args_mem->va->addr + slot * 4 * sizeof(uint32_t);
+   }
+   return (int32_t)slot;
+}
+
+/* On the compute class whatever ran last: the launch is a compute method,
+ * and a command buffer of the async compute family stays on the channel
+ * with the compute engine alone.
+ */
+void
+nvk_dispatch_profile_begin(struct nvk_cmd_buffer *cmd, int32_t slot)
+{
+   if (slot < 0)
+      return;
+   struct nvk_pass_profile *prof = nvk_cmd_buffer_device(cmd)->pass_profile;
+   prof_emit_report_compute(cmd, prof_slot_addr(prof, slot, false));
+}
+
+void
+nvk_dispatch_profile_end(struct nvk_cmd_buffer *cmd, int32_t slot)
+{
+   if (slot < 0)
+      return;
+   struct nvk_pass_profile *prof = nvk_cmd_buffer_device(cmd)->pass_profile;
+   prof_emit_report_compute(cmd, prof_slot_addr(prof, slot, true));
+}
