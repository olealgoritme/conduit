+/* NVK_DISPATCH_PROFILE: the window's table, heaviest shader first, then
+ * the window reset (harvest thread, totals_mutex)
+ */
+static void
+prof_disp_log(struct nvk_pass_profile *prof, double window_s, bool final)
+{
+   const uint32_t n = p_atomic_read(&prof->disp_sig_count);
+   uint64_t total_ns = 0, total_n = 0;
+   uint32_t active = 0;
+   for (uint32_t i = 0; i < n; i++) {
+      if (prof->disp_sigs[i].count == 0)
+         continue;
+      active++;
+      total_ns += prof->disp_sigs[i].gpu_ns;
+      total_n += prof->disp_sigs[i].count;
+   }
+   simple_mtx_lock(&prof->mutex);
+   const uint64_t dropped = prof->disp_dropped;
+   const uint64_t dropped_window = prof->disp_dropped_window;
+   prof->disp_dropped_window = 0;
+   simple_mtx_unlock(&prof->mutex);
+
+   prof_log(prof, "NVK dispatch profile: window %" PRIu64 "%s, %.2f s, %"
+            PRIu64 " dispatches (%.1f/s), %.3f GPU ms/s in dispatches, %u "
+            "of %u shaders active, %" PRIu64 " dropped (%" PRIu64 " in all)",
+            prof->windows, final ? " (final)" : "", window_s, total_n,
+            total_n / window_s, total_ns / 1e6 / window_s, active, n,
+            dropped_window, dropped);
+
+   uint32_t *order = active > 0 ? malloc(active * sizeof(*order)) : NULL;
+   if (order != NULL) {
+      uint32_t k = 0;
+      for (uint32_t i = 0; i < n; i++) {
+         if (prof->disp_sigs[i].count > 0)
+            order[k++] = i;
+      }
+      prof_disp_sort_base = prof->disp_sigs;
+      qsort(order, active, sizeof(*order), prof_disp_idx_cmp);
+
+      uint64_t rest_ns = 0, rest_n = 0;
+      for (uint32_t r = 0; r < active; r++) {
+         struct prof_disp_sig *d = &prof->disp_sigs[order[r]];
+         if (r >= PROF_DISP_LOG_TOP) {
+            rest_ns += d->gpu_ns;
+            rest_n += d->count;
+            continue;
+         }
+         qsort(d->samples, d->nsamples, sizeof(d->samples[0]), prof_u32_cmp);
+         const double p50 = d->nsamples > 0 ?
+                            d->samples[d->nsamples / 2] / 1e3 : 0.0;
+
+         char grids[160] = "-";
+         if (d->known > 0) {
+            qsort(d->grids, d->ngrids, sizeof(d->grids[0]), prof_disp_grid_cmp);
+            int len = 0;
+            for (uint32_t g = 0; g < d->ngrids && g < 3 &&
+                                 len < (int)sizeof(grids); g++) {
+               len += snprintf(grids + len, sizeof(grids) - len, "%s%ux%ux%u:%.0f%%",
+                               g > 0 ? "," : "", d->grids[g].g[0],
+                               d->grids[g].g[1], d->grids[g].g[2],
+                               100.0 * d->grids[g].count / d->known);
+            }
+            if ((d->ngrids > 3 || d->grids_evicted > 0) &&
+                len < (int)sizeof(grids))
+               snprintf(grids + len, sizeof(grids) - len, ",+");
+         }
+         char groups[64] = "-";
+         if (d->known > 0)
+            snprintf(groups, sizeof(groups), "%" PRIu64 "..%" PRIu64,
+                     d->groups_min, d->groups_max);
+
+         prof_log(prof, "NVK dispatch profile: %8.3f ms/s %5.1f%% %8.1f calls/s "
+                  "%8.2f us/call p50 %8.2f max %8.2f | src %016" PRIx64
+                  " code %08x local %ux%ux%u gprs %u warps %u instrs %u cycles %"
+                  PRIu64 " spills %u slm %u smem %u | grid %s groups %s | "
+                  "ind %" PRIu64 "/%" PRIu64 " dgc %" PRIu64 " meta %" PRIu64,
+                  d->gpu_ns / 1e6 / window_s,
+                  total_ns > 0 ? 100.0 * d->gpu_ns / total_ns : 0.0,
+                  d->count / window_s, d->gpu_ns / 1e3 / d->count, p50,
+                  d->max_ns / 1e3, d->src_hash, d->code_hash, d->local[0],
+                  d->local[1], d->local[2], d->gprs, d->warps, d->instrs,
+                  d->cycles, d->spills, d->slm, d->smem, grids, groups,
+                  d->ind_count, d->ind_read, d->dgc_count, d->meta_count);
+      }
+      if (rest_n > 0) {
+         prof_log(prof, "NVK dispatch profile: %8.3f ms/s %5.1f%% %8.1f calls/s "
+                  "in the %u other shaders", rest_ns / 1e6 / window_s,
+                  total_ns > 0 ? 100.0 * rest_ns / total_ns : 0.0,
+                  rest_n / window_s, active - PROF_DISP_LOG_TOP);
+      }
+      free(order);
+   }
+
+   for (uint32_t i = 0; i < n; i++) {
+      struct prof_disp_sig *d = &prof->disp_sigs[i];
+      d->gpu_ns = d->count = 0;
+      d->ind_count = d->ind_read = d->dgc_count = d->meta_count = 0;
+      d->known = d->groups_max = d->max_ns = 0;
+      d->groups_min = UINT64_MAX;
+      d->nsamples = d->ngrids = 0;
+      d->grids_evicted = 0;
+   }
+}
