+/* NVK_DISPATCH_PROFILE: one sample (harvest thread, totals_mutex) */
+static void
+prof_disp_add(struct nvk_pass_profile *prof, const struct prof_meta *m,
+              uint32_t slot, uint64_t ns)
+{
+   const uint32_t ds = m->disp;
+   if (ds > p_atomic_read(&prof->disp_sig_count))
+      return;
+   struct prof_disp_sig *d = &prof->disp_sigs[ds - 1];
+   d->gpu_ns += ns;
+   d->count++;
+   d->max_ns = MAX2(d->max_ns, ns);
+   d->meta_count += m->disp_meta;
+
+   /* Reservoir sample of the durations, for the median */
+   const uint32_t ns32 = (uint32_t)MIN2(ns, UINT32_MAX);
+   if (d->nsamples < PROF_DISP_SAMPLES) {
+      d->samples[d->nsamples++] = ns32;
+   } else {
+      prof->rng ^= prof->rng << 13;
+      prof->rng ^= prof->rng >> 7;
+      prof->rng ^= prof->rng << 17;
+      const uint64_t j = prof->rng % d->count;
+      if (j < PROF_DISP_SAMPLES)
+         d->samples[j] = ns32;
+   }
+
+   uint32_t g[3];
+   bool known = false;
+   switch (m->disp_kind) {
+   case NVK_DISPATCH_PROFILE_DIRECT:
+   case NVK_DISPATCH_PROFILE_INTERNAL:
+      memcpy(g, m->grid, sizeof(g));
+      known = true;
+      break;
+   case NVK_DISPATCH_PROFILE_INDIRECT:
+      d->ind_count++;
+      if (prof->args != NULL) {
+         volatile uint32_t *a = &prof->args[slot * 4];
+         if (a[0] != PROF_ARGS_NONE) {
+            g[0] = a[0];
+            g[1] = a[1];
+            g[2] = a[2];
+            known = true;
+            d->ind_read++;
+         }
+      }
+      break;
+   case NVK_DISPATCH_PROFILE_DGC:
+      d->dgc_count++;
+      break;
+   }
+   if (!known)
+      return;
+
+   const uint64_t groups = (uint64_t)g[0] * g[1] * g[2];
+   d->known++;
+   d->groups_min = MIN2(d->groups_min, groups);
+   d->groups_max = MAX2(d->groups_max, groups);
+   /* The most common grids, approximately: a full table gives its least
+    * common entry's place to the new grid
+    */
+   uint32_t least = 0;
+   for (uint32_t k = 0; k < d->ngrids; k++) {
+      if (memcmp(d->grids[k].g, g, sizeof(g)) == 0) {
+         d->grids[k].count++;
+         return;
+      }
+      if (d->grids[k].count < d->grids[least].count)
+         least = k;
+   }
+   if (d->ngrids < PROF_DISP_GRIDS) {
+      least = d->ngrids++;
+   } else {
+      d->grids_evicted += d->grids[least].count;
+   }
+   memcpy(d->grids[least].g, g, sizeof(g));
+   d->grids[least].count = 1;
+}
+
+static int
+prof_u32_cmp(const void *a, const void *b)
+{
+   const uint32_t x = *(const uint32_t *)a, y = *(const uint32_t *)b;
+   return x < y ? -1 : x > y ? 1 : 0;
+}
+
+static int
+prof_disp_grid_cmp(const void *a, const void *b)
+{
+   const struct prof_disp_grid *x = a, *y = b;
+   return x->count < y->count ? 1 : x->count > y->count ? -1 : 0;
+}
+
+static const struct prof_disp_sig *prof_disp_sort_base;
+
+static int
+prof_disp_idx_cmp(const void *a, const void *b)
+{
+   const struct prof_disp_sig *x = &prof_disp_sort_base[*(const uint32_t *)a];
+   const struct prof_disp_sig *y = &prof_disp_sort_base[*(const uint32_t *)b];
+   return x->gpu_ns < y->gpu_ns ? 1 : x->gpu_ns > y->gpu_ns ? -1 : 0;
+}
