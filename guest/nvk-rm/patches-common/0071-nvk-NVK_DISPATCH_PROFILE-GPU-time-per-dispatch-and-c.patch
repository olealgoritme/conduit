+uint64_t
+vk_spirv_source_hash(const uint32_t *spirv, size_t size_B)
+{
+   if (spirv == NULL || size_B < 20)
+      return 0;
+   const size_t words = size_B / 4;
+   if (spirv[0] == 0x07230203) {
+      for (size_t i = 5; i < words;) {
+         const uint32_t op = spirv[i] & 0xffff, wc = spirv[i] >> 16;
+         if (wc == 0 || i + wc > words)
+            break;
+         if (op == 7 /* OpString */ && wc >= 3) {
+            const char *str = (const char *)&spirv[i + 2];
+            const size_t n = strnlen(str, (wc - 2) * 4);
+            if (n == 21 && strcmp(str + 16, ".dxil") == 0) {
+               uint64_t h = 0;
+               size_t d = 0;
+               for (; d < 16; d++) {
