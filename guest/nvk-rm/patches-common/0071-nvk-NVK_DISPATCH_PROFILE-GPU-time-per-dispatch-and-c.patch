 src/nouveau/vulkan/nvk_device.h       |   4 +-
 src/nouveau/vulkan/nvk_pass_profile.c | 550 ++++++++++++++++++++++++--
 src/nouveau/vulkan/nvk_pass_profile.h |  22 ++
 src/nouveau/vulkan/nvk_shader.h       |   5 +
 src/vulkan/runtime/vk_pipeline.c      |   8 +
 src/vulkan/runtime/vk_shader.c        |  54 ++-
 src/vulkan/runtime/vk_shader.h        |  14 +
 10 files changed, 670 insertions(+), 45 deletions(-)

diff --git a/src/nouveau/vulkan/nvk_cmd_buffer.h b/src/nouveau/vulkan/nvk_cmd_buffer.h
