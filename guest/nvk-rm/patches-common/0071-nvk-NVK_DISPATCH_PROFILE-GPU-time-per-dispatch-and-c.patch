+++ b/src/nouveau/vulkan/nvk_cmd_buffer.h
@@ -392,6 +392,8 @@ struct nvk_cmd_buffer {
    bool pass_profile_buffers;
    bool pass_profile_dump;
    uint32_t pass_profile_dump_call;
+   /* NVK_DISPATCH_PROFILE: every dispatch is timed (nvk_pass_profile.c) */
+   bool dispatch_profile_on;
    /* NVK_PASS_PROFILE=4: where the open pass's pushes start */
    uint32_t pass_profile_hist_sig;
    uint32_t pass_profile_hist_npushes;
diff --git a/src/nouveau/vulkan/nvk_cmd_dispatch.c b/src/nouveau/vulkan/nvk_cmd_dispatch.c
index 6f2874c..ea2d53a 100644
--- a/src/nouveau/vulkan/nvk_cmd_dispatch.c
+++ b/src/nouveau/vulkan/nvk_cmd_dispatch.c
@@ -341,6 +341,14 @@ nvk_CmdDispatchBase(VkCommandBuffer commandBuffer,
       P_INLINE_DATA(p, local_size);
    }
 
+   int32_t prof_slot = -1;
+   if (unlikely(cmd->dispatch_profile_on)) {
+      prof_slot = nvk_dispatch_profile_alloc(cmd, cmd->state.cs.shader,
+                                             NVK_DISPATCH_PROFILE_DIRECT,
+                                             global_size, NULL);
+      nvk_dispatch_profile_begin(cmd, prof_slot);
+   }
+
    struct nv_push *p = nvk_cmd_buffer_push(cmd, 4);
    P_MTHD(p, NVA0C0, SEND_PCAS_A);
    P_NVA0C0_SEND_PCAS_A(p, qmd_addr >> 8);
@@ -354,6 +362,9 @@ nvk_CmdDispatchBase(VkCommandBuffer commandBuffer,
       P_IMMD(p, NVC6C0, SEND_SIGNALING_PCAS2_B,
              PCAS_ACTION_INVALIDATE_COPY_SCHEDULE);
    }
+
+   if (unlikely(prof_slot >= 0))
+      nvk_dispatch_profile_end(cmd, prof_slot);
 }
 
 void
@@ -384,6 +395,14 @@ nvk_cmd_dispatch_with_root(struct nvk_cmd_buffer *cmd,
                                  shader->info.crs_size);
    }
 
+   int32_t prof_slot = -1;
+   if (unlikely(cmd->dispatch_profile_on) && shader != NULL) {
+      prof_slot = nvk_dispatch_profile_alloc(cmd, shader,
+                                             NVK_DISPATCH_PROFILE_INTERNAL,
+                                             group_count, NULL);
+      nvk_dispatch_profile_begin(cmd, prof_slot);
+   }
+
    struct nv_push *p = nvk_cmd_buffer_push(cmd, 8);
 
    /* Internal shaders don't want conditional rendering */
@@ -403,6 +422,9 @@ nvk_cmd_dispatch_with_root(struct nvk_cmd_buffer *cmd,
    }
 
    P_IMMD(p, NVA0C0, SET_RENDER_ENABLE_OVERRIDE, MODE_USE_RENDER_ENABLE);
+
+   if (unlikely(prof_slot >= 0))
+      nvk_dispatch_profile_end(cmd, prof_slot);
 }
 
 void
@@ -551,6 +573,22 @@ nvk_CmdDispatchIndirect2KHR(VkCommandBuffer commandBuffer,
          sizeof(uint16_t));
    };
 
+   /* NVK_DISPATCH_PROFILE: the arguments copied for the profile the same
+    * way, then the report before the launch
+    */
+   int32_t prof_slot = -1;
+   if (unlikely(cmd->dispatch_profile_on)) {
+      uint64_t args_addr = 0;
+      prof_slot = nvk_dispatch_profile_alloc(cmd, cmd->state.cs.shader,
+                                             NVK_DISPATCH_PROFILE_INDIRECT,
+                                             NULL, &args_addr);
+      if (args_addr != 0) {
+         nvk_cmd_compute_indirect_copy(cmd, args_addr, dispatch_addr,
+                                       sizeof(VkDispatchIndirectCommand));
+      }
+      nvk_dispatch_profile_begin(cmd, prof_slot);
+   }
+
    /* Finally we schedule the QMD */
    struct nv_push *p = nvk_cmd_buffer_push(cmd, 4);
    P_MTHD(p, NVA0C0, SEND_PCAS_A);
@@ -564,4 +602,7 @@ nvk_CmdDispatchIndirect2KHR(VkCommandBuffer commandBuffer,
       P_IMMD(p, NVC6C0, SEND_SIGNALING_PCAS2_B,
              PCAS_ACTION_INVALIDATE_COPY_SCHEDULE);
    }
+
+   if (unlikely(prof_slot >= 0))
+      nvk_dispatch_profile_end(cmd, prof_slot);
 }
diff --git a/src/nouveau/vulkan/nvk_cmd_indirect.c b/src/nouveau/vulkan/nvk_cmd_indirect.c
index 192da47..55d2c67 100644
--- a/src/nouveau/vulkan/nvk_cmd_indirect.c
+++ b/src/nouveau/vulkan/nvk_cmd_indirect.c
@@ -1214,6 +1214,18 @@ nvk_CmdExecuteGeneratedCommandsEXT(VkCommandBuffer commandBuffer,
    uint64_t addr = info->preprocessAddress;
    uint64_t seq_count = info->maxSequenceCount;
 
+   /* NVK_DISPATCH_PROFILE: the generated dispatches timed as one */
+   int32_t prof_slot = -1;
+   if (unlikely(cmd->dispatch_profile_on) &&
+       (layout->stages & VK_SHADER_STAGE_COMPUTE_BIT)) {
+      prof_slot = nvk_dispatch_profile_alloc(cmd,
+                                             layout->set_stages == 0 ?
+                                             cmd->state.cs.shader : NULL,
+                                             NVK_DISPATCH_PROFILE_DGC,
+                                             NULL, NULL);
+      nvk_dispatch_profile_begin(cmd, prof_slot);
+   }
+
    /* Break it into pices that are a multiple of cmd_seq_stride_B so that, if
     * the kernel inserts a sync point between two of our pushes, it doesn't
     * break a single command.
@@ -1229,6 +1241,9 @@ nvk_CmdExecuteGeneratedCommandsEXT(VkCommandBuffer commandBuffer,
       seq_count -= push_seq;
    }
 
+   if (unlikely(prof_slot >= 0))
+      nvk_dispatch_profile_end(cmd, prof_slot);
+
    if (layout->set_stages != 0) {
       if (layout->stages & NVK_SHADER_STAGE_GRAPHICS_BITS) {
          cmd->state.gfx.shaders_dirty |= NVK_SHADER_STAGE_GRAPHICS_BITS;
diff --git a/src/nouveau/vulkan/nvk_device.h b/src/nouveau/vulkan/nvk_device.h
index 6dc8337..92d4385 100644
--- a/src/nouveau/vulkan/nvk_device.h
+++ b/src/nouveau/vulkan/nvk_device.h
@@ -50,7 +50,9 @@ struct nvk_device {
 
