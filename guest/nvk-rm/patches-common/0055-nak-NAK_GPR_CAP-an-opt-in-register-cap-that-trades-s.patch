diff --git a/src/nouveau/vulkan/nvk_shader.c b/src/nouveau/vulkan/nvk_shader.c
index 6780df7..8d06b67 100644
--- a/src/nouveau/vulkan/nvk_shader.c
+++ b/src/nouveau/vulkan/nvk_shader.c
@@ -88,13 +88,17 @@ nvk_physical_device_compiler_flags(const struct nvk_physical_device *pdev)
    bool no_cbufs = pdev->debug_flags & NVK_DEBUG_NO_CBUF;
    bool use_edb_buffer_views = nvk_use_edb_buffer_views(pdev);
    uint64_t nak_flags = nak_debug_flags(pdev->nak);
+   /* NAK_GPR_CAP*: binaries compiled under another cap are not reused */
+   uint64_t nak_gpr_caps = nak_gpr_cap_key();
 
    assert(nak_flags <= UINT16_MAX);
+   assert(nak_gpr_caps <= 0xffffff);
 
    return (no_cbufs ? 1 << 12 : 0)
       | (pdev->ubo_desc_cbufs ? 0 : 1 << 15)
       | (use_edb_buffer_views ? 1 << 13 : 0)
       | (instance->drirc.misc.ssbo_align_4b ? 1 << 14 : 0)
+      | (nak_gpr_caps << 16)
       | (nak_flags << 48);
 }
 
@@ -741,6 +745,12 @@ nvk_shader_stats_file(void)
          fprintf(file, "NVK shader stats: stage hash code_B instrs gprs "
                  "max_warps static_cycles spills_mem fills_mem spills_reg "
                  "fills_reg slm_B crs_B [stage details]\n");
+         uint32_t caps = nak_gpr_cap_key();
+         if (caps != 0) {
+            fprintf(file, "NVK shader stats: NAK_GPR_CAP compute %u "
+                    "fragment %u other %u (0: none)\n", caps & 0xff,
+                    (caps >> 8) & 0xff, (caps >> 16) & 0xff);
+         }
          fflush(file);
       }
    }
