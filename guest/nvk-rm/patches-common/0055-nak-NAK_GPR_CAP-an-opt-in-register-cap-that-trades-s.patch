index 0000000..4638e8d
--- /dev/null
+++ b/src/nouveau/compiler/nak/gpr_cap.rs
@@ -0,0 +1,126 @@
+// Copyright © 2026 Conduit contributors
+// SPDX-License-Identifier: MIT
+
+//! NAK_GPR_CAP: an opt-in limit on the GPRs a shader may use
+//!
+//! NAK normally uses as many GPRs as the program needs and spills only past
+//! the hardware maximum.  With a cap, the pre-RA scheduler schedules for the
+//! capped register count and register allocation spills (through
+//! spill_values) whatever does not fit, trading spills for occupancy.
+//!
+//!   NAK_GPR_CAP=N      cap for every stage
+//!   NAK_GPR_CAP_CS=N   cap for compute shaders (overrides NAK_GPR_CAP)
+//!   NAK_GPR_CAP_FS=N   cap for fragment shaders (overrides NAK_GPR_CAP)
+//!
+//! N counts registers per thread the way the hardware allocates them (and
+//! NVK_SHADER_STATS reports them): including the GPRs the hardware reserves,
+//! rounded down to the allocation granularity of 8.  0, unset, or 256 and
+//! more mean no cap; caps below 24 become 24, the least register allocation
+//! can work with.  The variables are read once per process.
+
+use crate::ir::*;
+
+use std::cmp::max;
+use std::env;
+use std::sync::OnceLock;
+
+/// The least cap: register allocation needs 16 GPRs for any instruction's
+/// vector sources and destinations, 2 for parallel-copy temporaries when it
+/// spills, plus the hardware-reserved GPRs, rounded up to 8.
+const MIN_GPR_CAP: u32 = 24;
+
+#[derive(Clone, Copy, Default)]
+struct GprCaps {
+    compute: u8,
+    fragment: u8,
+    other: u8,
+}
+
+/// Parses one cap variable's value: None if unset or unparsable, Some(0) for
+/// no cap.
+fn parse_cap(var: &str, val: Result<String, env::VarError>) -> Option<u8> {
+    let s = val.ok()?;
+    let s = s.trim();
+    if s.is_empty() {
+        return None;
+    }
+    match s.parse::<u32>() {
+        Ok(0) => Some(0),
+        Ok(n) if n >= 256 => Some(0),
+        Ok(n) => {
+            let n = prev_multiple_of(max(n, MIN_GPR_CAP), 8);
+            Some(n.try_into().unwrap())
+        }
+        Err(_) => {
+            eprintln!("NAK: ignoring {}=\"{}\" (not a number)", var, s);
+            None
+        }
+    }
+}
+
+static GPR_CAPS: OnceLock<GprCaps> = OnceLock::new();
+
+fn gpr_caps() -> GprCaps {
+    *GPR_CAPS.get_or_init(|| {
+        let all =
+            parse_cap("NAK_GPR_CAP", env::var("NAK_GPR_CAP")).unwrap_or(0);
+        let cs = parse_cap("NAK_GPR_CAP_CS", env::var("NAK_GPR_CAP_CS"));
+        let fs = parse_cap("NAK_GPR_CAP_FS", env::var("NAK_GPR_CAP_FS"));
+        GprCaps {
+            compute: cs.unwrap_or(all),
+            fragment: fs.unwrap_or(all),
+            other: all,
+        }
+    })
+}
+
+/// The effective caps, packed for driver cache keys: compute in bits 0-7,
+/// fragment in bits 8-15, every other stage in bits 16-23; 0 is no cap.
+#[unsafe(no_mangle)]
+pub extern "C" fn nak_gpr_cap_key() -> u32 {
+    let c = gpr_caps();
+    u32::from(c.compute)
+        | (u32::from(c.fragment) << 8)
+        | (u32::from(c.other) << 16)
+}
+
+impl Shader<'_> {
+    /// The most GPRs register allocation may use for this shader under
+    /// NAK_GPR_CAP, not counting the hardware-reserved ones, or None without
+    /// a cap for its stage.  OpRegOut needs all of its sources in GPRs at
+    /// once, so the limit never drops below that (plus the parallel-copy
+    /// temporaries).
+    pub fn gpr_cap(&self) -> Option<u32> {
+        let caps = gpr_caps();
+        let cap = match &self.info.stage {
+            ShaderStageInfo::Compute(_) => caps.compute,
+            ShaderStageInfo::Fragment(_) => caps.fragment,
+            _ => caps.other,
+        };
+        if cap == 0 {
+            return None;
+        }
+
+        let hw_reserved = self.sm.hw_reserved_gprs();
+        let mut need = 16;
+        for f in &self.functions {
+            for b in &f.blocks {
+                for instr in b.instrs.iter().rev() {
+                    match &instr.op {
+                        Op::Exit(_) => (),
+                        Op::RegOut(op) => {
+                            need = max(
+                                need,
+                                u32::try_from(op.srcs.len()).unwrap(),
+                            );
+                        }
+                        _ => break,
+                    }
+                }
+            }
+        }
+        let floor = (need + 2 + hw_reserved).next_multiple_of(8);
+
+        Some(max(u32::from(cap), floor) - hw_reserved)
+    }
+}
