--- /dev/null
+++ b/src/nouveau/compiler/nak/spill_remat.rs
@@ -0,0 +1,1187 @@
+// Copyright © 2026 Conduit contributors
+// SPDX-License-Identifier: MIT
+
+//! Rematerialization for GPR spilling
+//!
+//! A GPR value whose definition is cheap and whose inputs are available
+//! wherever the value is live does not need to go to local memory when the
+//! spiller evicts it: it is recomputed at each reload instead, and evicting
+//! it costs no store.  This module finds those values and builds the
+//! instructions that recompute them.
+//!
+//! A value is rematerializable when its defining instruction is one of a
+//! small set of side-effect-free operations (copies, integer and float ALU
+//! ops, conversions, invariant system values such as the thread and CTA
+//! IDs, constant-buffer loads with a GPR offset, and global loads from
+//! constant memory) and every source is
+//!
+//!  - an immediate, rZ/pT/pF, or a bound constant buffer reference, which
+//!    are the same everywhere,
+//!  - a scalar UGPR whose live range covers the value's live range, so it
+//!    still holds the same value at any reload point (in strict SSA a
+//!    source that is live at a point where the value is live holds the
+//!    instance the value was computed from), or
+//!  - a GPR value that is itself rematerializable, recomputed into a
+//!    temporary first (a chain of at most a few instructions).
+//!
+//! Recomputing a chain needs temporaries next to the value's own register:
+//! `RematCost::extra` counts the registers a reload needs beyond that one,
+//! and the spiller makes room for them.
+//!
+//! Constant-memory loads through a 64-bit address that comes straight from
+//! a bound constant buffer (vkd3d-proton's root CBVs, loaded through a BDA
+//! pointer in a root constant) are the common case.  Recomputing the
+//! address would take two moves per reload, so instead the address is
+//! loaded once into a pinned UGPR pair at the start of the (uniform) entry
+//! block, shared by every reload from that base, and each reload is a
+//! single `LDG [rZ + UR]`.  That needs room in the UGPR file for the whole
+//! shader; without it, or on hardware without UGPRs, the address is
+//! recomputed.
+
+use crate::ir::*;
+use crate::liveness::{
+    BlockLiveness, Liveness, NextUseLiveness, SimpleLiveness,
+};
+
+use rustc_hash::{FxHashMap, FxHashSet};
+use std::cmp::{max, min};
+
+/// Longest chain of definitions a reload may recompute
+const MAX_DEPTH: u32 = 3;
+
+/// Most instructions one reload may take
+const MAX_INSTRS: u32 = 4;
+
+/// Most registers one reload may need beyond the value's own register
+pub const MAX_EXTRA: u32 = 1;
+
+/// Most constant-buffer addresses kept in pinned UGPR pairs
+const MAX_UBASES: usize = 4;
+
+#[derive(Clone, Copy, Debug, Default)]
+pub struct RematCost {
+    /// Instructions per reload
+    pub instrs: u32,
+    /// Registers a reload needs beyond the value's own register
+    pub extra: u32,
+    /// Estimated cost of a reload in issue slots (memory loads count more)
+    pub cost: u32,
+}
+
+/// The cost of one reload from local memory in the same units as
+/// `RematCost::cost`.  A store (once per spilled value) costs the same.
+pub const MEM_FILL_COST: u32 = 8;
+
+/// System values that are the same wherever a thread reads them
+fn is_invariant_sr(idx: u8) -> bool {
+    matches!(
+        idx,
+        0x00 // SR_LANEID
+            | 0x20..=0x23 // SR_TID, SR_TID.X/Y/Z
+            | 0x25..=0x27 // SR_CTAID.X/Y/Z
+            | 0x38..=0x3c // SR_LANEMASK_*
+    )
+}
+
+pub fn op_cost(op: &Op) -> u32 {
+    match op {
+        Op::Ld(_) => 4,
+        Op::Ldc(_) | Op::S2R(_) => 2,
+        _ => 1,
+    }
+}
+
+/// Clones a rematerializable instruction with every destination cleared.
+/// Returns None for anything not on the list.
+fn clone_op(op: &Op) -> Option<Op> {
+    let op: Op = match op {
+        Op::Copy(op) => OpCopy {
+            dst: Dst::None,
+            src: op.src.clone(),
+        }
+        .into(),
+        Op::S2R(op) => {
+            if !is_invariant_sr(op.idx) {
+                return None;
+            }
+            OpS2R {
+                dst: Dst::None,
+                idx: op.idx,
+            }
+            .into()
+        }
+        Op::IAdd3(op) => {
+            let mut op = op.clone();
+            op.dst = Dst::None;
+            op.overflow = [Dst::None, Dst::None];
+            op.into()
+        }
+        Op::Lea(op) => {
+            let mut op = op.clone();
+            op.dst = Dst::None;
+            op.overflow = Dst::None;
+            op.into()
+        }
+        Op::Lop3(op) => {
+            let mut op = op.clone();
+            op.dst = Dst::None;
+            op.into()
+        }
+        Op::Shf(op) => {
+            let mut op = op.clone();
+            op.dst = Dst::None;
+            op.into()
+        }
+        Op::Shl(op) => {
+            let mut op = op.clone();
+            op.dst = Dst::None;
+            op.into()
+        }
+        Op::Shr(op) => {
+            let mut op = op.clone();
+            op.dst = Dst::None;
+            op.into()
+        }
+        Op::IMnMx(op) => {
+            let mut op = op.clone();
+            op.dst = Dst::None;
+            op.into()
+        }
+        Op::Prmt(op) => {
+            let mut op = op.clone();
+            op.dst = Dst::None;
+            op.into()
+        }
+        Op::IAbs(op) => {
+            let mut op = op.clone();
+            op.dst = Dst::None;
+            op.into()
+        }
+        Op::IMad(op) => OpIMad {
+            dst: Dst::None,
+            srcs: op.srcs.clone(),
+            signed: op.signed,
+        }
+        .into(),
+        Op::IMul(op) => OpIMul {
+            dst: Dst::None,
+            srcs: op.srcs.clone(),
+            signed: op.signed,
+            high: op.high,
+        }
+        .into(),
+        Op::Mov(op) => OpMov {
+            dst: Dst::None,
+            src: op.src.clone(),
+            quad_lanes: op.quad_lanes,
+        }
+        .into(),
+        Op::F2F(op) => OpF2F {
+            dst: Dst::None,
+            src: op.src.clone(),
+            src_type: op.src_type,
+            dst_type: op.dst_type,
+            rnd_mode: op.rnd_mode,
+            ftz: op.ftz,
+            integer_rnd: op.integer_rnd,
+        }
+        .into(),
+        Op::F2FP(op) => OpF2FP {
+            dst: Dst::None,
+            srcs: op.srcs.clone(),
+            rnd_mode: op.rnd_mode,
+        }
+        .into(),
+        Op::I2F(op) => OpI2F {
+            dst: Dst::None,
+            src: op.src.clone(),
+            dst_type: op.dst_type,
+            src_type: op.src_type,
+            rnd_mode: op.rnd_mode,
+        }
+        .into(),
+        Op::I2I(op) => OpI2I {
+            dst: Dst::None,
+            src: op.src.clone(),
+            src_type: op.src_type,
+            dst_type: op.dst_type,
+            saturate: op.saturate,
+            abs: op.abs,
+            neg: op.neg,
+        }
+        .into(),
+        Op::FAdd(op) => OpFAdd {
+            dst: Dst::None,
+            srcs: op.srcs.clone(),
+            saturate: op.saturate,
+            rnd_mode: op.rnd_mode,
+            ftz: op.ftz,
+        }
+        .into(),
+        Op::FMul(op) => OpFMul {
+            dst: Dst::None,
+            srcs: op.srcs.clone(),
+            saturate: op.saturate,
+            rnd_mode: op.rnd_mode,
+            ftz: op.ftz,
+            dnz: op.dnz,
+        }
+        .into(),
+        Op::FFma(op) => OpFFma {
+            dst: Dst::None,
+            srcs: op.srcs.clone(),
+            saturate: op.saturate,
+            rnd_mode: op.rnd_mode,
+            ftz: op.ftz,
+            dnz: op.dnz,
+        }
+        .into(),
+        Op::FMnMx(op) => OpFMnMx {
+            dst: Dst::None,
+            srcs: op.srcs.clone(),
+            min: op.min.clone(),
+            ftz: op.ftz,
+        }
+        .into(),
+        Op::Ldc(op) => {
+            let mut op = op.clone();
+            op.dst = Dst::None;
+            op.into()
+        }
+        Op::Ld(op) => {
+            // Only loads from memory that cannot change while the shader
+            // runs
+            if !matches!(op.access.space, MemSpace::Global(_))
+                || op.access.order != MemOrder::Constant
+            {
+                return None;
+            }
+            OpLd {
+                dst: Dst::None,
+                addr: op.addr.clone(),
+                uniform_addr: op.uniform_addr.clone(),
+                pred: op.pred.clone(),
+                offset: op.offset,
+                stride: op.stride,
+                access: op.access.clone(),
+            }
+            .into()
+        }
+        _ => return None,
+    };
+    Some(op)
+}
+
+/// Sets the main destination of an op made by clone_op
+fn set_dst(op: &mut Op, dst: Dst) {
+    let dsts = op.dsts_as_mut_slice();
+    debug_assert!(dsts.iter().all(|d| d.is_none()));
+    dsts[0] = dst;
+}
+
+/// Builds the template for recomputing `ssa`, defined by `instr`: the
+/// instruction with its destinations cleared, and for a component of a
+/// vector load, a 32-bit load of that component alone.
+fn make_template(instr: &Instr, ssa: SSAValue) -> Option<Op> {
+    if !instr.pred.is_true() || instr.is_uniform() {
+        return None;
+    }
+
+    // The value must be the only GPR destination, except for loads, where
+    // we load just its component
+    let dst = instr.dsts().first()?;
+    let vec = dst.as_ssa()?;
+    let comp = vec.iter().position(|v| *v == ssa)?;
+    if vec.comps() > 1 {
+        let Op::Ld(ld) = &instr.op else {
+            return None;
+        };
+        let bytes = match ld.access.mem_type {
+            MemType::B64 => 8,
+            MemType::B128 => 16,
+            _ => return None,
+        };
+        if usize::from(vec.comps()) * 4 != bytes {
+            return None;
+        }
+        let mut op = clone_op(&instr.op)?;
+        let Op::Ld(new_ld) = &mut op else {
+            unreachable!();
+        };
+        new_ld.access.mem_type = MemType::B32;
+        new_ld.offset += i32::try_from(comp * 4).unwrap();
+        return check_srcs(op);
+    }
+    for d in &instr.dsts()[1..] {
+        // Extra destinations (carry-outs) must be unused predicates: they
+        // are dropped from the copy
+        match d {
+            Dst::None => (),
+            Dst::SSA(v) if v.file() == RegFile::Pred => (),
+            _ => return None,
+        }
+    }
+    check_srcs(clone_op(&instr.op)?)
+}
+
+fn check_srcs(op: Op) -> Option<Op> {
+    for src in op.srcs_as_slice() {
+        match &src.src_ref {
+            SrcRef::Zero | SrcRef::True | SrcRef::False | SrcRef::Imm32(_) => {
+            }
+            SrcRef::CBuf(cb) => {
+                if !matches!(cb.buf, CBuf::Binding(_)) {
+                    return None;
+                }
+            }
+            SrcRef::SSA(vec) => match vec.file() {
+                RegFile::GPR => (),
+                // Uniform vectors cannot be collected in non-uniform control
+                // flow, so only scalars
+                RegFile::UGPR if vec.comps() == 1 => (),
+                _ => return None,
+            },
+            SrcRef::Reg(_) => return None,
+        }
+    }
+    Some(op)
+}
+
+/// A 64-bit address read from a bound constant buffer and kept in a
+/// pinned UGPR pair from the start of the entry block (see the module
+/// documentation)
+struct UBase {
+    cb: CBufRef,
+    /// The pinned pair the reloads read
+    pin: SSARef,
+    /// Set once a reload uses it: only used bases are materialized
+    used: bool,
+}
+
+pub struct Remat {
+    templates: FxHashMap<SSAValue, Op>,
+    costs: FxHashMap<SSAValue, RematCost>,
+    /// Inputs of other values' recomputations: keeping them resident makes
+    /// those reloads cheaper
+    feeds: FxHashSet<SSAValue>,
+    ubases: Vec<UBase>,
+    /// Components of the pinned pairs, to their UBase index
+    ubase_comps: FxHashMap<SSAValue, usize>,
+}
+
+impl Remat {
+    /// An empty set: nothing is rematerialized
+    pub fn none() -> Remat {
+        Remat {
+            templates: Default::default(),
+            costs: Default::default(),
+            feeds: Default::default(),
+            ubases: Vec::new(),
+            ubase_comps: Default::default(),
+        }
+    }
+
+    /// Finds the rematerializable GPR values of `func`.  `live` is the GPR
+    /// next-use liveness the spiller uses, `num_ugprs` the size of the UGPR
+    /// file (0 without UGPRs).
+    pub fn for_function(
+        func: &mut Function,
+        live: &NextUseLiveness,
+        num_ugprs: u32,
+    ) -> Remat {
+        let mut templates = FxHashMap::default();
+        let mut copy_srcs: FxHashSet<SSAValue> = Default::default();
+        let mut has_ugpr = false;
+        for b in func.blocks.iter() {
+            for instr in &b.instrs {
+                match &instr.op {
+                    Op::ParCopy(_) | Op::PhiSrcs(_) | Op::RegOut(_) => {
+                        // Values flowing into these are handled in spill
+                        // space by the spiller; leave them alone
+                        instr.for_each_ssa_use(|ssa| {
+                            copy_srcs.insert(*ssa);
+                        });
+                        continue;
+                    }
+                    _ => (),
+                }
+                let mut gpr_dsts = Vec::new();
+                instr.for_each_ssa_def(|ssa| {
+                    if ssa.file() == RegFile::GPR {
+                        gpr_dsts.push(*ssa);
+                    }
+                });
+                for ssa in gpr_dsts {
+                    if let Some(t) = make_template(instr, ssa) {
+                        has_ugpr |= t.srcs_as_slice().iter().any(|s| {
+                            s.src_ref
+                                .as_ssa()
+                                .is_some_and(|v| v.file() == RegFile::UGPR)
+                        });
+                        templates.insert(ssa, t);
+                    }
+                }
+            }
+        }
+
+        let mut r = Remat {
+            templates,
+            costs: Default::default(),
+            feeds: Default::default(),
+            ubases: Vec::new(),
+            ubase_comps: Default::default(),
+        };
+
+        let ulive = if has_ugpr || num_ugprs > 0 {
+            Some(SimpleLiveness::for_function(func))
+        } else {
+            None
+        };
+        if num_ugprs > 0 && func.blocks[0].uniform {
+            let max_ugprs =
+                ulive.as_ref().unwrap().calc_max_live(func)[RegFile::UGPR];
+            let room = num_ugprs.saturating_sub(max_ugprs) / 2;
+            let room = min(usize::try_from(room).unwrap(), MAX_UBASES);
+            r.find_ubases(func, room);
+        }
+        let func = &*func;
+
+        let cands: Vec<SSAValue> = r.templates.keys().cloned().collect();
+        for ssa in cands {
+            if copy_srcs.contains(&ssa) {
+                continue;
+            }
+            let mut ugprs = Vec::new();
+            let Some((cost, peak)) = r.analyze(ssa, 0, &mut ugprs) else {
+                continue;
+            };
+            let extra = peak - 1;
+            if cost.instrs > MAX_INSTRS || extra > MAX_EXTRA {
+                continue;
+            }
+            if !ugprs.is_empty() {
+                let ulive = ulive.as_ref().unwrap();
+                if !ugprs
+                    .iter()
+                    .all(|u| covers(func, live, ulive, &ssa, u))
+                {
+                    continue;
+                }
+            }
+            for src in r.templates[&ssa].srcs_as_slice() {
+                if let SrcRef::SSA(vec) = &src.src_ref {
+                    if vec.file() == RegFile::GPR {
+                        r.feeds.extend(vec.iter().cloned());
+                    }
+                }
+            }
+            r.costs.insert(
+                ssa,
+                RematCost {
+                    instrs: cost.instrs,
+                    extra,
+                    cost: cost.cost,
+                },
+            );
+        }
+        r
+    }
+
+    /// Instruction count, cost and register peak (counting the value's own
+    /// register) of recomputing `ssa`, or None if it cannot be
+    fn analyze(
+        &self,
+        ssa: SSAValue,
+        depth: u32,
+        ugprs: &mut Vec<SSAValue>,
+    ) -> Option<(RematCost, u32)> {
+        if depth >= MAX_DEPTH {
+            return None;
+        }
+        let t = self.templates.get(&ssa)?;
+        let t_ubase = self.op_ubase(t);
+        let mut cost = RematCost {
+            instrs: 1,
+            extra: 0,
+            cost: op_cost(t),
+        };
+        let mut peak = 1;
+        let mut held = 0;
+        for src in t.srcs_as_slice() {
+            let SrcRef::SSA(vec) = &src.src_ref else {
+                continue;
+            };
+            for c in vec.iter() {
+                if t_ubase.is_some() && self.ubase_comps.contains_key(c) {
+                    // Available everywhere
+                    continue;
+                }
+                if c.file() == RegFile::UGPR {
+                    ugprs.push(*c);
+                    continue;
+                }
+                let (cc, cp) = self.analyze(*c, depth + 1, ugprs)?;
+                cost.instrs += cc.instrs;
+                cost.cost += cc.cost;
+                peak = max(peak, held + cp);
+                held += 1;
+            }
+        }
+        peak = max(peak, held);
+        Some((cost, peak))
+    }
+
+    /// The UBase a template's address comes from, if any
+    fn op_ubase(&self, op: &Op) -> Option<usize> {
+        let Op::Ld(ld) = op else {
+            return None;
+        };
+        let vec = ld.uniform_addr.src_ref.as_ssa()?;
+        self.ubase_comps.get(&vec[0]).cloned()
+    }
+
+    /// The constant-buffer address that a template's 64-bit address is
+    /// read from, if both halves are rematerializable copies of
+    /// consecutive words of one bound constant buffer
+    fn cbuf_addr(&self, op: &Op) -> Option<CBufRef> {
+        let Op::Ld(ld) = op else {
+            return None;
+        };
+        if !ld.uniform_addr.is_zero() || !ld.addr.is_unmodified() {
+            return None;
+        }
+        let vec = ld.addr.src_ref.as_ssa()?;
+        if vec.comps() != 2 || vec.file() != RegFile::GPR {
+            return None;
+        }
+        let mut cbs = [None, None];
+        for c in 0..2 {
+            let Some(Op::Copy(copy)) = self.templates.get(&vec[c]) else {
+                return None;
+            };
+            if !copy.src.is_unmodified() {
+                return None;
+            }
+            let SrcRef::CBuf(cb) = &copy.src.src_ref else {
+                return None;
+            };
+            if !matches!(cb.buf, CBuf::Binding(_)) {
+                return None;
+            }
+            cbs[c] = Some(cb.clone());
+        }
+        let [lo, hi] = cbs.map(|c| c.unwrap());
+        if lo.buf != hi.buf || hi.offset != lo.offset + 4 {
+            return None;
+        }
+        Some(lo)
+    }
+
+    /// Points constant-memory load templates whose address comes from a
+    /// bound constant buffer at a pinned UGPR copy of that address, for at
+    /// most @room distinct addresses
+    fn find_ubases(&mut self, func: &mut Function, room: usize) {
+        let mut keys: Vec<SSAValue> = self.templates.keys().cloned().collect();
+        // Deterministic base order
+        keys.sort_by_key(|v| v.idx());
+        for ssa in keys {
+            let Some(cb) = self.cbuf_addr(&self.templates[&ssa]) else {
+                continue;
+            };
+            let idx = match self.ubases.iter().position(|b| b.cb == cb) {
+                Some(i) => i,
+                None => {
+                    if self.ubases.len() >= room {
+                        continue;
+                    }
+                    let pin = func.ssa_alloc.alloc_vec(RegFile::UGPR, 2);
+                    for c in pin.iter() {
+                        self.ubase_comps.insert(*c, self.ubases.len());
+                    }
+                    self.ubases.push(UBase {
+                        cb,
+                        pin,
+                        used: false,
+                    });
+                    self.ubases.len() - 1
+                }
+            };
+            let Some(Op::Ld(ld)) = self.templates.get_mut(&ssa) else {
+                unreachable!();
+            };
+            ld.addr = Src::ZERO;
+            ld.uniform_addr = self.ubases[idx].pin.clone().into();
+        }
+    }
+
+    /// Materializes the UGPR addresses that reloads use: loads each into a
+    /// pinned pair at the start of the entry block.  Call once, after the
+    /// reloads are generated.
+    pub fn insert_ubases(&self, func: &mut Function) {
+        let mut instrs = Vec::new();
+        for b in &self.ubases {
+            if !b.used {
+                continue;
+            }
+            let u = func.ssa_alloc.alloc_vec(RegFile::UGPR, 2);
+            for c in 0..2_u16 {
+                let mut cb = b.cb.clone();
+                cb.offset += 4 * c;
+                instrs.push(Instr::new(OpCopy {
+                    dst: u[usize::from(c)].into(),
+                    src: cb.into(),
+                }));
+            }
+            instrs.push(Instr::new(OpPin {
+                dst: b.pin.clone().into(),
+                src: u.into(),
+            }));
+        }
+        if instrs.is_empty() {
+            return;
+        }
+        let entry = &mut func.blocks[0];
+        debug_assert!(entry.uniform);
+        debug_assert!(entry.phi_dsts().is_none());
+        entry.instrs.splice(0..0, instrs);
+    }
+
+    pub fn get(&self, ssa: &SSAValue) -> Option<&RematCost> {
+        self.costs.get(ssa)
+    }
+
+    pub fn contains(&self, ssa: &SSAValue) -> bool {
+        self.costs.contains_key(ssa)
+    }
+
+    /// True if @ssa is an input of another value's recomputation
+    pub fn feeds(&self, ssa: &SSAValue) -> bool {
+        self.feeds.contains(ssa)
+    }
+
+    /// Instructions that recompute `ssa` into `dst`, temporaries first.
+    /// A GPR input for which `resident` returns true is used as it is
+    /// instead of being recomputed: the caller guarantees it is live and in
+    /// a register at the insertion point.
+    pub fn instrs(
+        &mut self,
+        ssa: SSAValue,
+        dst: Dst,
+        resident: &dyn Fn(&SSAValue) -> bool,
+        alloc: &mut SSAValueAllocator,
+        out: &mut Vec<Instr>,
+    ) {
+        let mut op = clone_op(&self.templates[&ssa]).unwrap();
+        if let Some(i) = self.op_ubase(&op) {
+            self.ubases[i].used = true;
+        }
+        for src in op.srcs_as_mut_slice() {
+            let SrcRef::SSA(vec) = &src.src_ref else {
+                continue;
+            };
+            if vec.file() != RegFile::GPR {
+                continue;
+            }
+            let comps: Vec<SSAValue> = vec.iter().cloned().collect();
+            let mut new_comps = Vec::new();
+            for c in comps {
+                if resident(&c) {
+                    new_comps.push(c);
+                    continue;
+                }
+                let tmp = alloc.alloc(RegFile::GPR);
+                self.instrs(c, tmp.into(), resident, alloc, out);
+                new_comps.push(tmp);
+            }
+            src.src_ref = SrcRef::SSA(SSARef::new(&new_comps));
+        }
+        set_dst(&mut op, dst);
+        out.push(Instr::new(op));
+    }
+}
+
+/// Returns true if UGPR `u` is live wherever GPR `v` is
+fn covers(
+    func: &Function,
+    live: &NextUseLiveness,
+    ulive: &SimpleLiveness,
+    v: &SSAValue,
+    u: &SSAValue,
+) -> bool {
+    for b_idx in 0..func.blocks.len() {
+        let bv = live.block_live(b_idx);
+        let bu = ulive.block_live(b_idx);
+        if bv.is_live_in(v) && !bu.is_live_in(u) {
+            return false;
+        }
+        if bv.is_live_out(v) {
+            if !bu.is_live_out(u) {
+                return false;
+            }
+        } else if let Some(last) = bv.last_use_in_block(v) {
+            // u's live range in the block is contiguous and starts before
+            // v's (u's definition dominates v's), so it is enough that u is
+            // live at v's last use.
+            let ok = if last == 0 {
+                bu.is_live_in(u)
+            } else {
+                bu.is_live_after_ip(u, last - 1)
+            };
+            if !ok {
+                return false;
+            }
+        }
+    }
+    true
+}
