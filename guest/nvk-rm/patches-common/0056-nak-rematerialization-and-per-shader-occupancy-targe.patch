diff --git a/src/nouveau/compiler/nak/occ_target.rs b/src/nouveau/compiler/nak/occ_target.rs
new file mode 100644
index 0000000..c4c9b23
--- /dev/null
+++ b/src/nouveau/compiler/nak/occ_target.rs
@@ -0,0 +1,221 @@
+// Copyright © 2026 Conduit contributors
+// SPDX-License-Identifier: MIT
+
+//! Per-shader occupancy target (NAK_OCC_TARGET)
+//!
+//! The pre-RA scheduler reaches the lowest occupancy cliff it can without
+//! spilling, and register allocation then uses as many GPRs as that
+//! schedule needs.  For shaders whose register demand is inherently high,
+//! occupancy stays low even when a few cheap rematerializations or spills
+//! would buy many more resident warps.
+//!
+//! After scheduling, this pass computes the shader's occupancy as the
+//! hardware does (registers per warp, and for compute shaders whole
+//! workgroups and their shared memory), and for each lower register count
+//! that gives more warps, estimates the cost of spilling down to it with a
+//! dry run of the spiller (rematerialization included, loop-weighted, see
+//! Function::spill_gpr_cost).
+//!
+//! The model is deliberately conservative, since a wrong choice costs more
+//! than a missed one:
+//!
+//!  - A count whose dry run needs more than a handful of memory spills and
+//!    fills, or any inside a loop, is never chosen: local memory traffic is
+//!    what made a plain register cap slower.  Reductions that
+//!    rematerialization alone pays for are what this is for.
+//!  - Of the rest, it picks the count with the best estimated gain, if any
+//!    is at least MIN_GAIN:
+//!
+//!      gain = sqrt(min(warps', S) / min(warps, S)) / (1 + cost / work)
+//!
+//!    where work is the shader's loop-weighted instruction count and S is
+//!    SATURATION_WARPS.  The square root and the saturation stand for the
+//!    diminishing returns of more warps.  The dry run sees the schedule made
+//!    for the natural count; the schedule made for the target needs less
+//!    spill code than that, so the estimate errs high.
+//!
+//! When shared memory or the workgroup size limits occupancy, fewer
+//! registers gain nothing and the shader is left alone.  The chosen count is
+//! then scheduled for and spilled to like NAK_GPR_CAP.
+//!
+//! NAK_OCC_TRACE=1 prints each candidate's estimate to stderr.
+
+use crate::ir::*;
+use crate::liveness::{Liveness, SimpleLiveness};
+use crate::spill_values::{loop_weight, DryCost};
+
+use std::cmp::{max, min};
+use std::env;
+use std::sync::OnceLock;
+
+/// Warps beyond which more occupancy is assumed to gain nothing
+const SATURATION_WARPS: u32 = 32;
+
+/// Least estimated gain worth spilling for
+const MIN_GAIN: f64 = 1.05;
+
+/// Most memory spills and fills (static count) a target may need; none of
+/// them may be inside a loop
+const MAX_MEM_OPS: u32 = 4;
+
+fn occ_trace() -> bool {
+    static TRACE: OnceLock<bool> = OnceLock::new();
+    *TRACE.get_or_init(|| {
+        env::var("NAK_OCC_TRACE").is_ok_and(|v| v.trim() == "1")
+    })
+}
+
+/// True if a dry run's memory spills and fills are few enough
+fn mem_ok(d: &DryCost) -> bool {
+    d.mem_ops <= MAX_MEM_OPS && d.mem_weighted == u64::from(d.mem_ops)
+}
+
+/// Most occupancy cliffs below the natural register count to evaluate
+const MAX_CANDIDATES: usize = 3;
+
+/// Shared memory per SM a compute shader can get, in bytes
+fn smem_per_sm(sm: u8) -> u32 {
+    match sm {
+        0..=69 => 48 * 1024,
+        70..=72 => 96 * 1024,
+        73..=79 => 64 * 1024,
+        80 | 87 => 164 * 1024,
+        90..=109 => 228 * 1024,
+        _ => 100 * 1024,
+    }
+}
+
+/// Most resident CTAs per SM
+fn max_ctas_per_sm(sm: u8) -> u32 {
+    match sm {
+        73..=79 => 16,
+        _ => 32,
+    }
+}
+
+/// Shared memory the hardware reserves per CTA (SM80 and later)
+fn smem_reserved_per_cta(sm: u8) -> u32 {
+    if sm >= 80 {
+        1024
+    } else {
+        0
+    }
+}
+
+impl Shader<'_> {
+    /// Resident warps per SM with @gprs registers per thread (as allocated,
+    /// with the hardware-reserved ones), including the workgroup and shared
+    /// memory limits of compute shaders
+    pub fn occupancy(&self, gprs: u32) -> u32 {
+        let warps = max_warps_per_sm(self.sm, gprs);
+        let ShaderStageInfo::Compute(cs) = &self.info.stage else {
+            return warps;
+        };
+        let threads = u32::from(cs.local_size[0])
+            * u32::from(cs.local_size[1])
+            * u32::from(cs.local_size[2]);
+        let warps_per_cta = max(1, threads.div_ceil(32));
+        let mut ctas = min(max_ctas_per_sm(self.sm.sm()), warps / warps_per_cta);
+        if cs.smem_size > 0 {
+            let per_cta =
+                u32::from(cs.smem_size) + smem_reserved_per_cta(self.sm.sm());
+            ctas = min(ctas, smem_per_sm(self.sm.sm()) / per_cta);
+        }
+        ctas * warps_per_cta
+    }
+
+    /// Chooses the register target for this shader after pre-RA scheduling:
+    /// the most GPRs register allocation may use, not counting the
+    /// hardware-reserved ones, or None to keep the natural count.  The
+    /// function is put in CSSA form (assign_regs does that first anyway).
+    pub fn choose_gpr_target(&mut self) -> Option<u32> {
+        assert!(self.functions.len() == 1);
+        let hw_reserved = self.sm.hw_reserved_gprs();
+        let floor = self.gpr_floor();
+
+        let mut hw_max = self.sm.num_regs(RegFile::GPR);
+        if let ShaderStageInfo::Compute(cs) = &self.info.stage {
+            hw_max = min(
+                hw_max,
+                gpr_limit_from_local_size(&cs.local_size) - hw_reserved,
+            );
+        }
+
+        let f = &mut self.functions[0];
+        f.to_cssa();
+        let live = SimpleLiveness::for_function(f);
+        let max_live = live.calc_max_live(f);
+        let total = max(max_live[RegFile::GPR], 16) + 1;
+        if total > hw_max {
+            // Already spilling
+            return None;
+        }
+        let natural = (total + hw_reserved).next_multiple_of(8);
+        let w0 = self.occupancy(natural);
+
+        // Occupancy cliffs below the natural count
+        let mut cands = Vec::new();
+        let mut a = natural;
+        while a >= floor + 8 && cands.len() < MAX_CANDIDATES {
+            a -= 8;
+            if self.occupancy(a) > self.occupancy(a + 8)
+                && self.occupancy(a) > w0
+            {
+                cands.push(a);
+            }
+        }
+        if cands.is_empty() {
+            return None;
+        }
+
+        let f = &mut self.functions[0];
+        let mut work = 0_u64;
+        let mut num_instrs = 0_u64;
+        for b_idx in 0..f.blocks.len() {
+            let n = u64::try_from(f.blocks[b_idx].instrs.len()).unwrap();
+            num_instrs += n;
+            work += n * loop_weight(f.blocks.loop_depth(b_idx));
+        }
+        let work = max(work, 1) as f64;
+
+        let num_ugprs = self.sm.num_regs(RegFile::UGPR);
+        let sat = |w: u32| f64::from(min(w, SATURATION_WARPS));
+        let mut best: Option<(f64, u32)> = None;
+        for a in cands {
+            let warps = self.occupancy(a);
+            let benefit = (sat(warps) / sat(w0)).sqrt();
+            if benefit <= MIN_GAIN {
+                continue;
+            }
+            // assign_regs reserves 2 GPRs for parallel copies when spilling
+            let limit = a - hw_reserved - 2;
+            let f = &mut self.functions[0];
+            let d = f.spill_gpr_cost(limit, num_ugprs, &mut self.info);
+            let gain = benefit / (1.0 + d.cost as f64 / work);
+            let ok = mem_ok(&d) && gain >= MIN_GAIN;
+            if occ_trace() {
+                eprintln!(
+                    "NAK_OCC_TRACE: {} GPRs {} warps -> {} GPRs {} warps: \
+                     cost {:.1}% of work, {} instrs added of {}, \
+                     {} memory ops ({} weighted), gain {:.3}{}",
+                    natural,
+                    w0,
+                    a,
+                    warps,
+                    100.0 * d.cost as f64 / work,
+                    d.instrs,
+                    num_instrs,
+                    d.mem_ops,
+                    d.mem_weighted,
+                    gain,
+                    if ok { "" } else { " (rejected)" },
+                );
+            }
+            if ok && best.is_none_or(|(g, _)| gain > g) {
+                best = Some((gain, a));
+            }
+        }
+
+        best.map(|(_, a)| a - hw_reserved)
+    }
+}
