+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::liveness::NextUseLiveness;
+
+    use compiler::cfg::CFGBuilder;
+    use rustc_hash::FxBuildHasher;
+
+    fn sm120() -> ShaderModelInfo {
+        ShaderModelInfo::new(120, 48)
+    }
+
+    fn access(mem_type: MemType, order: MemOrder) -> MemAccess {
+        MemAccess {
+            mem_type,
+            space: MemSpace::Global(MemAddrType::A64),
+            order,
+            eviction_priority: MemEvictionPriority::Normal,
+        }
+    }
+
+    fn cb(offset: u16) -> CBufRef {
+        CBufRef {
+            buf: CBuf::Binding(0),
+            offset,
+        }
+    }
+
+    /// A small straight-line program builder
+    struct Prog {
+        alloc: SSAValueAllocator,
+        instrs: Vec<Instr>,
+    }
+
+    impl Prog {
+        fn new() -> Prog {
+            Prog {
+                alloc: SSAValueAllocator::new(),
+                instrs: Vec::new(),
+            }
+        }
+
+        fn push(&mut self, op: impl Into<Op>) {
+            self.instrs.push(Instr::new(op));
+        }
+
+        fn copy(&mut self, file: RegFile, src: impl Into<Src>) -> SSAValue {
+            let dst = self.alloc.alloc(file);
+            self.push(OpCopy {
+                dst: dst.into(),
+                src: src.into(),
+            });
+            dst
+        }
+
+        fn iadd(&mut self, a: impl Into<Src>, b: impl Into<Src>) -> SSAValue {
+            let dst = self.alloc.alloc(RegFile::GPR);
+            self.push(OpIAdd3 {
+                dst: dst.into(),
+                overflow: [Dst::None, Dst::None],
+                srcs: [a.into(), b.into(), Src::ZERO],
+            });
+            dst
+        }
+
+        fn ld(
+            &mut self,
+            addr: &SSARef,
+            offset: i32,
+            mem_type: MemType,
+            order: MemOrder,
+        ) -> SSARef {
+            let comps = u8::try_from(mem_type.bits() / 32).unwrap();
+            let dst = self.alloc.alloc_vec(RegFile::GPR, comps);
+            self.push(OpLd {
+                dst: dst.clone().into(),
+                addr: addr.clone().into(),
+                uniform_addr: Src::ZERO,
+                pred: true.into(),
+                offset,
+                stride: OffsetStride::X1,
+                access: access(mem_type, order),
+            });
+            dst
+        }
+
+        fn st(&mut self, addr: &SSARef, data: SSAValue) {
+            self.push(OpSt {
+                addr: addr.clone().into(),
+                data: data.into(),
+                uniform_addr: Src::ZERO,
+                offset: 0,
+                stride: OffsetStride::X1,
+                access: access(MemType::B32, MemOrder::Strong(MemScope::GPU)),
+            });
+        }
+
+        /// The address of a root constant buffer, read from cbuf 0
+        fn addr(&mut self) -> SSARef {
+            let lo = self.copy(RegFile::GPR, cb(0x10));
+            let hi = self.copy(RegFile::GPR, cb(0x14));
+            SSARef::from([lo, hi])
+        }
+
+        /// @n values that can only be spilled to memory (loads that are not
+        /// from constant memory), to make register pressure
+        fn noise(&mut self, addr: &SSARef, n: i32) -> Vec<SSAValue> {
+            (0..n)
+                .map(|i| {
+                    let strong = MemOrder::Strong(MemScope::GPU);
+                    self.ld(addr, 0x100 + 4 * i, MemType::B32, strong)[0]
+                })
+                .collect()
+        }
+
+        /// Sums @vals in order, so they die one by one
+        fn sum(&mut self, vals: &[SSAValue]) -> SSAValue {
+            let mut acc = vals[0];
+            for v in &vals[1..] {
+                acc = self.iadd(acc, *v);
+            }
+            acc
+        }
+
+        fn function(mut self, uniform: bool) -> Function {
+            self.push(OpExit {});
+            let mut cfg = CFGBuilder::<_, _, FxBuildHasher>::new();
+            cfg.add_node(
+                0,
+                BasicBlock {
+                    label: LabelAllocator::new().alloc(),
+                    uniform,
+                    instrs: self.instrs,
+                },
+            );
+            Function {
+                ssa_alloc: self.alloc,
+                phi_alloc: PhiAllocator::new(),
+                blocks: cfg.as_cfg(true),
+            }
+        }
+    }
+
+    fn shader_info() -> ShaderInfo {
+        ShaderInfo {
+            max_warps_per_sm: 0,
+            num_gprs: 0,
+            num_control_barriers: 0,
+            num_instrs: 0,
+            num_static_cycles: 0,
+            num_spills_to_mem: 0,
+            num_fills_from_mem: 0,
+            num_spills_to_reg: 0,
+            num_fills_from_reg: 0,
+            slm_size: 0,
+            max_crs_depth: 0,
+            uses_global_mem: true,
+            writes_global_mem: true,
+            uses_fp64: false,
+            stage: ShaderStageInfo::Compute(ComputeShaderInfo {
+                local_size: [32, 1, 1],
+                smem_size: 0,
+            }),
+            io: ShaderIoInfo::None,
+        }
+    }
+
+    /// Spills @f's GPRs down to @limit with rematerialization
+    fn spill(f: &mut Function, limit: u32) -> ShaderInfo {
+        let mut info = shader_info();
+        f.to_cssa();
+        let num_ugprs = sm120().num_regs(RegFile::UGPR);
+        f.spill_values(RegFile::GPR, limit, &mut info, true, num_ugprs);
+        info
+    }
+
+    /// Runs register allocation (spilling to @gprs GPRs with
+    /// rematerialization) and the rest of the back end through encoding,
+    /// which checks the result with their assertions
+    fn compile(f: Function, gprs: u32) -> ShaderInfo {
+        let sm = sm120();
+        let mut s = Shader {
+            sm: &sm,
+            info: shader_info(),
+            functions: vec![f],
+        };
+        s.assign_regs_target(Some(gprs), true);
+        s.lower_par_copies();
+        s.lower_copy_swap();
+        s.calc_instr_deps();
+        s.gather_info();
+        s.remove_annotations();
+        let code = s.sm.encode_shader(&s);
+        assert!(!code.is_empty());
+        s.info
+    }
+
+    fn instrs(f: &Function) -> impl Iterator<Item = &Instr> {
+        f.blocks.iter().flat_map(|b| b.instrs.iter())
+    }
+
+    /// Single-component constant loads at @offset
+    fn ld_b32_at(f: &Function, offset: i32) -> Vec<&OpLd> {
+        instrs(f)
+            .filter_map(|i| match &i.op {
+                Op::Ld(ld)
+                    if ld.access.mem_type == MemType::B32
+                        && ld.access.order == MemOrder::Constant
+                        && ld.offset == offset =>
+                {
+                    Some(&**ld)
+                }
+                _ => None,
+            })
+            .collect()
+    }
+
+    /// Components of a vector constant load are reloaded one at a time:
+    /// one 32-bit load per component, from a UGPR copy of the address when
+    /// the entry block is uniform, else from the recomputed address.
+    ///
+    /// Register pressure peaks at the last of the 10 other loads: their
+    /// address, the 4 components and 10 loaded values.  With 12 registers,
+    /// components (used last, cheapest to restore) are evicted, not the
+    /// loaded values.
+    fn constant_load_component(uniform: bool) -> Function {
+        let mut p = Prog::new();
+        let addr = p.addr();
+        let v = p.ld(&addr, 0x20, MemType::B128, MemOrder::Constant);
+        let noise = p.noise(&addr, 10);
+        let n = p.sum(&noise);
+        let a = p.iadd(v[0], v[1]);
+        let b = p.iadd(v[2], v[3]);
+        let ab = p.iadd(a, b);
+        let r = p.iadd(n, ab);
+        let out = p.addr();
+        p.st(&out, r);
+        p.function(uniform)
+    }
+
+    #[test]
+    fn test_remat_constant_load_component_ugpr() {
+        let mut f = constant_load_component(true);
+        let info = spill(&mut f, 12);
+        assert_eq!(info.num_spills_to_mem, 0);
+        assert_eq!(info.num_fills_from_mem, 0);
+
+        // Components of the b128 load were evicted and are reloaded alone,
+        // once each, through the pinned UGPR address
+        let mut reloaded = 0;
+        for c in 0..4 {
+            let lds = ld_b32_at(&f, 0x20 + 4 * c);
+            assert!(lds.len() <= 1, "component {c}");
+            for ld in lds {
+                assert!(ld.addr.is_zero());
+                let ua = ld.uniform_addr.src_ref.as_ssa().unwrap();
+                assert_eq!(ua.comps(), 2);
+                assert_eq!(ua.file(), RegFile::UGPR);
+                reloaded += 1;
+            }
+        }
+        assert!(reloaded >= 2);
+
+        // The address is loaded once, at the start of the entry block, and
+        // pinned
+        let entry = &f.blocks[0].instrs;
+        assert!(matches!(&entry[2].op, Op::Pin(_)));
+        let pins = instrs(&f).filter(|i| matches!(&i.op, Op::Pin(_))).count();
+        assert_eq!(pins, 1);
+
+        let info = compile(constant_load_component(true), 14);
+        assert_eq!(info.num_spills_to_mem, 0);
+    }
+
+    #[test]
+    fn test_remat_constant_load_component_gpr() {
+        // Without a uniform entry block, the address is recomputed
+        let mut f = constant_load_component(false);
+        let info = spill(&mut f, 12);
+        assert_eq!(info.num_spills_to_mem, 0);
+        let mut reloaded = 0;
+        for c in 0..4 {
+            let lds = ld_b32_at(&f, 0x20 + 4 * c);
+            assert!(lds.len() <= 1, "component {c}");
+            for ld in lds {
+                assert!(ld.uniform_addr.is_zero());
+                assert_eq!(ld.addr.src_ref.as_ssa().unwrap().comps(), 2);
+                reloaded += 1;
+            }
+        }
+        assert!(reloaded >= 2);
+        assert!(!instrs(&f).any(|i| matches!(&i.op, Op::Pin(_))));
+
+        let info = compile(constant_load_component(false), 14);
+        assert_eq!(info.num_spills_to_mem, 0);
+    }
+
+    /// A value computed from another rematerializable value that is still
+    /// resident at the reload uses that value instead of recomputing it.
+    ///
+    /// w = tid + 0x1234 is used only at the end; tid is used throughout.
+    /// Pressure peaks at the 8th of the 9 loads (address, tid, w, 7 values
+    /// and the new one): with 11 registers, w is evicted.
+    fn chain_with_resident_input() -> Function {
+        let mut p = Prog::new();
+        let addr = p.addr();
+        let tid = p.alloc.alloc(RegFile::GPR);
+        p.push(OpS2R {
+            dst: tid.into(),
+            idx: 0x21, // SR_TID.X
+        });
+        let w = p.iadd(tid, 0x1234_u32);
+        let ys: Vec<SSAValue> = p
+            .noise(&addr, 9)
+            .into_iter()
+            .map(|x| p.iadd(x, tid))
+            .collect();
+        let mut acc = ys[0];
+        for y in &ys[1..] {
+            acc = p.iadd(acc, *y);
+            acc = p.iadd(acc, tid);
+        }
+        let r = p.iadd(acc, w);
+        let r = p.iadd(r, tid);
+        let out = p.addr();
+        p.st(&out, r);
+        p.function(true)
+    }
+
+    #[test]
+    fn test_remat_chain_with_resident_input() {
+        let mut f = chain_with_resident_input();
+        let info = spill(&mut f, 11);
+        assert_eq!(info.num_spills_to_mem, 0);
+
+        let adds: Vec<_> = instrs(&f)
+            .filter_map(|i| match &i.op {
+                Op::IAdd3(op)
+                    if op.srcs[1].src_ref == SrcRef::Imm32(0x1234) =>
+                {
+                    Some(&**op)
+                }
+                _ => None,
+            })
+            .collect();
+        // Only the recomputation at the end is left (the original is dead
+        // once its value was evicted without a store)
+        assert_eq!(adds.len(), 1);
+        let last_noise = instrs(&f)
+            .collect::<Vec<_>>()
+            .iter()
+            .rposition(|i| matches!(&i.op, Op::Ld(_)))
+            .unwrap();
+        let add_pos = instrs(&f)
+            .position(|i| match &i.op {
+                Op::IAdd3(op) => op.srcs[1].src_ref == SrcRef::Imm32(0x1234),
+                _ => false,
+            })
+            .unwrap();
+        assert!(add_pos > last_noise);
+        // It reads the thread ID, which was never recomputed
+        let s2rs: Vec<SSAValue> = instrs(&f)
+            .filter_map(|i| match &i.op {
+                Op::S2R(op) => Some(op.dst.as_ssa().unwrap()[0]),
+                _ => None,
+            })
+            .collect();
+        assert_eq!(s2rs.len(), 1);
+        for op in adds {
+            assert_eq!(op.srcs[0].src_ref.as_ssa().unwrap()[0], s2rs[0]);
+        }
+
+        let info = compile(chain_with_resident_input(), 14);
+        assert_eq!(info.num_spills_to_mem, 0);
+    }
+
+    /// v = u + 7 with a UGPR u: v is rematerializable only if u is live
+    /// wherever v is
+    fn ugpr_input(u_outlives_v: bool) -> (Function, SSAValue) {
+        let mut p = Prog::new();
+        let addr = p.addr();
+        let u = p.copy(RegFile::UGPR, cb(0x40));
+        let v = p.iadd(u, 7_u32);
+        let noise = p.noise(&addr, 4);
+        let n = p.sum(&noise);
+        let r = if u_outlives_v {
+            let r = p.iadd(n, v);
+            p.iadd(r, u)
+        } else {
+            let r = p.iadd(n, u);
+            p.iadd(r, v)
+        };
+        let out = p.addr();
+        p.st(&out, r);
+        (p.function(true), v)
+    }
+
+    #[test]
+    fn test_remat_ugpr_coverage() {
+        let files = RegFileSet::from_iter([RegFile::GPR]);
+        for covered in [true, false] {
+            let (mut f, v) = ugpr_input(covered);
+            let live = NextUseLiveness::for_function(&f, &files);
+            let remat = Remat::for_function(&mut f, &live, 0);
+            assert_eq!(remat.contains(&v), covered);
+        }
+
+        // Spilled hard, the covered value is recomputed from the UGPR where
+        // it is used (after the loads) and the other one goes to memory
+        for covered in [true, false] {
+            let (mut f, _) = ugpr_input(covered);
+            spill(&mut f, 4);
+            let last_ld = instrs(&f)
+                .collect::<Vec<_>>()
+                .iter()
+                .rposition(|i| matches!(&i.op, Op::Ld(_)))
+                .unwrap();
+            let adds: Vec<usize> = instrs(&f)
+                .enumerate()
+                .filter(|(_, i)| match &i.op {
+                    Op::IAdd3(op) => op.srcs[1].src_ref == SrcRef::Imm32(7),
+                    _ => false,
+                })
+                .map(|(ip, _)| ip)
+                .collect();
+            assert_eq!(adds.len(), 1);
+            // v, renamed by SSA repair
+            let v = instrs(&f)
+                .nth(adds[0])
+                .unwrap()
+                .dsts()[0]
+                .as_ssa()
+                .unwrap()[0];
+            let v_to_mem = instrs(&f).any(|i| match &i.op {
+                Op::Copy(op) => {
+                    op.dst.as_ssa().is_some_and(|d| d.file() == RegFile::Mem)
+                        && op.src.src_ref.as_ssa().is_some_and(|s| s[0] == v)
+                }
+                _ => false,
+            });
+            if covered {
+                assert!(adds[0] > last_ld);
+                assert!(!v_to_mem);
+            } else {
+                assert!(adds[0] < last_ld);
+                assert!(v_to_mem);
+            }
+        }
+    }
+}
