From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ole Algoritme <olealgoritme@gmail.com>
Date: Sat, 24 Oct 2026 10:02:54 +0200
Subject: [PATCH] nak: NAK_SCHED_SPILL_ROOM, NAK_SCHED_DELAY_WEIGHT (pre-RA
 schedule)

NAK_SCHED_SPILL_ROOM: once one block of a shader cannot be scheduled
within the register target, every block gets the Spill thresholds, whose
give-up point is the peak of the block's original order.  A block that
peaks far below the register limit then has to stay at that peak, the
NAK_SCHED_MLP schedule fails there and the block falls back to the plain
one, which puts texture, memory and MUFU results right above their uses.
With the knob such a block may use registers up to the limit.

NAK_SCHED_DELAY_WEIGHT (1-64, default 1): under register pressure, the
cost of a cycle an instruction would wait for a result, against 64 for a
register over the limit.
---
 src/nouveau/compiler/nak/knobs.rs             | 29 +++++++++++++++++++
 .../compiler/nak/opt_instr_sched_prepass.rs   | 21 ++++++++++++--
 2 files changed, 48 insertions(+), 2 deletions(-)

diff --git a/src/nouveau/compiler/nak/knobs.rs b/src/nouveau/compiler/nak/knobs.rs
index cb51438..58c5eb7 100644
--- a/src/nouveau/compiler/nak/knobs.rs
+++ b/src/nouveau/compiler/nak/knobs.rs
@@ -125,6 +125,8 @@ static SCHED_ILP: OnceLock<bool> = OnceLock::new();
 static GCM: OnceLock<u32> = OnceLock::new();
 static LDCU_INDEX: OnceLock<bool> = OnceLock::new();
 static LAT_NV: OnceLock<bool> = OnceLock::new();
+static SCHED_SPILL_ROOM: OnceLock<bool> = OnceLock::new();
+static SCHED_DELAY_WEIGHT: OnceLock<u32> = OnceLock::new();
 
 /// NAK_GCM (0-3, default 0): nir_opt_gcm with value numbering after NAK's
 /// NIR optimization loop; 2 also sinks ALU instructions back towards their
@@ -199,6 +201,31 @@ pub fn lat_nv() -> bool {
     *LAT_NV.get_or_init(|| parse("NAK_LAT_NV", env::var("NAK_LAT_NV"), dflt))
 }
 
+/// NAK_SCHED_SPILL_ROOM (default off): in a shader where one block's
+/// schedule spills, the other blocks may use registers up to the limit in
+/// the pre-RA schedule instead of staying at the peak of their original
+/// order, so that the NAK_SCHED_MLP schedule (results of texture, memory and
+/// MUFU instructions used later) fits there (opt_instr_sched_prepass.rs)
+pub fn sched_spill_room() -> bool {
+    *SCHED_SPILL_ROOM.get_or_init(|| {
+        parse("NAK_SCHED_SPILL_ROOM", env::var("NAK_SCHED_SPILL_ROOM"), false)
+    })
+}
+
+/// NAK_SCHED_DELAY_WEIGHT (1-64, default 1): in the pre-RA schedule under
+/// register pressure, the cost of a cycle that an instruction would wait for
+/// a result, against 64 for a register over the limit
+pub fn sched_delay_weight() -> i32 {
+    sched_delay_weight_u32() as i32
+}
+
+fn sched_delay_weight_u32() -> u32 {
+    *SCHED_DELAY_WEIGHT.get_or_init(|| {
+        let v = parse_u32("NAK_SCHED_DELAY_WEIGHT", 1, 64);
+        if v == 0 { 1 } else { v }
+    })
+}
+
 /// NAK_LDCU_INDEX (default off): on SM100+, a constant buffer load whose
 /// offset is a uniform register value is a uniform LDCU c[N][URx] (the
 /// form the reference compiler uses for descriptor loads) instead of a
@@ -368,6 +395,8 @@ pub extern "C" fn nak_knobs_key2() -> u32 {
         ^ uniform_hoist().wrapping_mul(0x85eb_ca6b)
         ^ if ldcu_index() { 0xc2b2_ae35 } else { 0 }
         ^ if lat_nv() { 0x27d4_eb2f } else { 0 }
+        ^ if sched_spill_room() { 0x1656_67b1 } else { 0 }
+        ^ (sched_delay_weight() as u32 - 1).wrapping_mul(0x9e37_79b1)
 }
 
 /// NAK_YIELD (default off, experimental, SM120): control bit 109 set on
diff --git a/src/nouveau/compiler/nak/opt_instr_sched_prepass.rs b/src/nouveau/compiler/nak/opt_instr_sched_prepass.rs
index 78c35f0..6f87362 100644
--- a/src/nouveau/compiler/nak/opt_instr_sched_prepass.rs
+++ b/src/nouveau/compiler/nak/opt_instr_sched_prepass.rs
@@ -374,7 +374,10 @@ fn calc_score(
     }
 
     let (mut badness, goodness) = calc_score_part(net, max_regs);
-    badness += i32::try_from(delay_cycles).unwrap();
+    // NAK_SCHED_DELAY_WEIGHT: under register pressure, what a cycle of
+    // waiting for a result costs against a register over the limit (64)
+    badness += i32::try_from(delay_cycles).unwrap()
+        * crate::knobs::sched_delay_weight();
 
     (true, Reverse(badness), goodness)
 }
@@ -864,7 +867,21 @@ impl ScheduleType {
                 heuristic_threshold: max_regs[RegFile::GPR]
                     - SW_RESERVED_GPRS_SPILL
                     - TARGET_FREE(),
-                quit_threshold: schedule_unit.peak_gpr_count,
+                // NAK_SCHED_SPILL_ROOM: once one block spills, every block
+                // gets the Spill thresholds, and a block whose own order
+                // peaks far below the register limit then has to stay at
+                // that peak; the NAK_SCHED_MLP schedule fails there and the
+                // block falls back to the plain one, which puts texture and
+                // MUFU results right above their uses.  With the knob such
+                // a block may use registers up to the limit
+                quit_threshold: if crate::knobs::sched_spill_room() {
+                    max(
+                        schedule_unit.peak_gpr_count,
+                        max_regs[RegFile::GPR] - SW_RESERVED_GPRS_SPILL,
+                    )
+                } else {
+                    schedule_unit.peak_gpr_count
+                },
             },
         }
     }
-- 
