+      const uint32_t d[5] = { indexCount, instanceCount, firstIndex,
+                              (uint32_t)vertexOffset, firstInstance };
+      nvk_pass_profile_dump_draw(cmd, 1, 0, 1, 0, d);
+   }
 
    if (nvk_cmd_can_draw_direct(cmd)) {
