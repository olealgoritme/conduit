    nvk_cmd_profile_count_draws(cmd, drawCount, false);
+   if (unlikely(cmd->pass_profile_dump)) {
+      /* The first of drawCount draws */
+      const uint32_t d[5] = { pIndexInfo->indexCount, instanceCount,
+                              pIndexInfo->firstIndex,
+                              (uint32_t)(pVertexOffset != NULL ? *pVertexOffset :
