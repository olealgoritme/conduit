@@ -0,0 +1,510 @@
+// Copyright © 2026 Conduit contributors
+// SPDX-License-Identifier: MIT
+
+//! If-conversion after register allocation
+//!
+//! A divergent if/else costs NAK a BSSY, a BSYNC, the label NOP after it,
+//! one or two branches and, without .RECONVERGENT, a BMOV.CLEAR, around
+//! blocks that are often only a few instructions long (frequently just the
+//! phi copies).  This pass predicates small then/else blocks instead:
+//!
+//!   @p bra else           ->  @!p <then instrs>
+//!   <then instrs>             @p  <else instrs>
+//!   bra merge
+//!   else: <else instrs>
+//!   merge:
+//!
+//! After register allocation this is exact: a predicated-off lane writes no
+//! register, which is all a lane that skipped the block ever relied on.
+//! When an if/else region is left without branches, its BSSY/BSYNC pair (and
+//! the BMOV.CLEAR and label NOP that belong to it) goes too, and blocks that
+//! now simply fall into each other are merged so the post-RA scheduler sees
+//! them as one.  NAK_IF_CONVERT=0 turns it off.
+
+use crate::ir::*;
+use crate::opt_jump_thread::rewrite_cfg;
+
+use rustc_hash::FxHashSet;
+
+/// Most instructions a predicated then-block may have
+const MAX_THEN: usize = 8;
+/// Most instructions a predicated then-block and else-block may have together
+const MAX_IF_ELSE: usize = 12;
+
+fn writes_pred_reg(instr: &Instr, p: &RegRef) -> bool {
+    instr.dsts().iter().any(|dst| match dst {
+        Dst::Reg(reg) => {
+            reg.file() == p.file() && reg.idx_range().contains(&p.base_idx())
+        }
+        _ => false,
+    })
+}
+
+fn can_predicate(instr: &Instr, p: &RegRef) -> bool {
+    if !instr.pred.is_true() || instr.is_uniform() || writes_pred_reg(instr, p)
+    {
+        return false;
+    }
+    !matches!(
+        &instr.op,
+        Op::Bra(_)
+            | Op::Exit(_)
+            | Op::Sync(_)
+            | Op::Brk(_)
+            | Op::Cont(_)
+            | Op::BSSy(_)
+            | Op::BSync(_)
+            | Op::BClear(_)
+            | Op::BMov(_)
+            | Op::Break(_)
+            | Op::Bar(_)
+            | Op::Kill(_)
+            | Op::Nop(_)
+            | Op::WarpSync(_)
+            | Op::Vote(_)
+            | Op::Shfl(_)
+            | Op::Redux(_)
+            | Op::Match(_)
+            | Op::Out(_)
+            | Op::OutFinal(_)
+            | Op::RegOut(_)
+            | Op::SrcBar(_)
+            | Op::Annotate(_)
+            | Op::ParCopy(_)
+            | Op::Swap(_)
+            | Op::Copy(_)
+            | Op::Undef(_)
+            | Op::PhiSrcs(_)
+            | Op::PhiDsts(_)
+            | Op::Pin(_)
+            | Op::Unpin(_)
+    )
+}
+
+/// The block's instructions before its branch, if it ends in one
+fn body(b: &BasicBlock) -> &[Instr] {
+    match b.branch_ip() {
+        Some(ip) => &b.instrs[..ip],
+        None => &b.instrs[..],
+    }
+}
+
+fn body_ok(b: &BasicBlock, p: &RegRef, max: usize) -> bool {
+    let body = body(b);
+    body.len() <= max && body.iter().all(|i| can_predicate(i, p))
+}
+
+/// `@p bra L` at the end of block i: (p, inverted, L)
+fn cond_branch(b: &BasicBlock) -> Option<(RegRef, bool, Label)> {
+    let instr = b.branch()?;
+    let Op::Bra(bra) = &instr.op else {
+        return None;
+    };
+    if !bra.cond.is_true() {
+        return None;
+    }
+    match &instr.pred.pred_ref {
+        PredRef::Reg(reg) if reg.file() == RegFile::Pred => {
+            Some((*reg, instr.pred.pred_inv, bra.target))
+        }
+        _ => None,
+    }
+}
+
+/// The target of the block's unconditional branch, if it ends in one
+fn uncond_target(b: &BasicBlock) -> Option<Label> {
+    let instr = b.branch()?;
+    match &instr.op {
+        Op::Bra(bra) if instr.pred.is_true() && bra.cond.is_true() => {
+            Some(bra.target)
+        }
+        _ => None,
+    }
+}
+
+/// Where control goes after the block's body: its unconditional branch
+/// target, or the next block's label if it falls through
+fn successor(f: &Function, i: usize) -> Option<Label> {
+    let b = &f.blocks[i];
+    match b.branch() {
+        Some(_) => uncond_target(b),
+        None => f.blocks.get(i + 1).map(|n| n.label),
+    }
+}
+
+fn predicate(b: &mut BasicBlock, p: RegRef, inv: bool) {
+    let n = body(b).len();
+    for instr in &mut b.instrs[..n] {
+        instr.pred = Pred {
+            pred_ref: PredRef::Reg(p),
+            pred_inv: inv,
+        };
+    }
+}
+
+fn try_convert(f: &mut Function, i: usize) -> bool {
+    if i + 1 >= f.blocks.len() {
+        return false;
+    }
+    let Some((p, inv, target)) = cond_branch(&f.blocks[i]) else {
+        return false;
+    };
+    let t = i + 1;
+    if f.blocks.pred_indices(t) != [i] {
+        return false;
+    }
+
+    // if/else: the then-block jumps over the else-block, which only the
+    // branch reaches, and both end up at the same place
+    let e = i + 2;
+    if e < f.blocks.len()
+        && f.blocks[e].label == target
+        && f.blocks.pred_indices(e) == [i]
+        && uncond_target(&f.blocks[t]).is_some()
+        && uncond_target(&f.blocks[t]) == successor(f, e)
+        && body(&f.blocks[t]).len() + body(&f.blocks[e]).len() <= MAX_IF_ELSE
+        && body_ok(&f.blocks[t], &p, MAX_IF_ELSE)
+        && body_ok(&f.blocks[e], &p, MAX_IF_ELSE)
+    {
+        predicate(&mut f.blocks[t], p, !inv);
+        predicate(&mut f.blocks[e], p, inv);
+        f.blocks[i].instrs.pop();
+        f.blocks[t].instrs.pop();
+        return true;
+    }
+
+    // then only: the then-block continues where the branch goes
+    if successor(f, t) == Some(target) && body_ok(&f.blocks[t], &p, MAX_THEN) {
+        predicate(&mut f.blocks[t], p, !inv);
+        f.blocks[i].instrs.pop();
+        if f.blocks[t].branch().is_some()
+            && t + 1 < f.blocks.len()
+            && f.blocks[t + 1].label == target
+        {
+            f.blocks[t].instrs.pop();
+        }
+        return true;
+    }
+
+    false
+}
+
+fn referenced_labels(f: &Function) -> FxHashSet<Label> {
+    let mut labels = FxHashSet::default();
+    for b in f.blocks.iter() {
+        for instr in &b.instrs {
+            match &instr.op {
+                Op::Bra(op) => {
+                    labels.insert(op.target);
+                }
+                Op::BSSy(op) => {
+                    labels.insert(op.target);
+                }
+                Op::Sync(op) => {
+                    labels.insert(op.target);
+                }
+                Op::Brk(op) => {
+                    labels.insert(op.target);
+                }
+                Op::Cont(op) => {
+                    labels.insert(op.target);
+                }
+                Op::SSy(op) => {
+                    labels.insert(op.target);
+                }
+                Op::PBk(op) => {
+                    labels.insert(op.target);
+                }
+                Op::PCnt(op) => {
+                    labels.insert(op.target);
+                }
+                _ => (),
+            }
+        }
+    }
+    labels
+}
+
+fn bar_reg(src: &Src) -> Option<RegRef> {
+    src.src_ref.as_reg().copied()
+}
+
+fn uses_bar(instr: &Instr, bar: &RegRef) -> bool {
+    instr.srcs().iter().any(|s| s.src_ref.as_reg() == Some(bar))
+        || instr.dsts().iter().any(|d| d.as_reg() == Some(bar))
+}
+
+/// Removes the BSSY/BSYNC pair (and BMOV.CLEAR and label NOP) of a region
+/// that has no branch left in it.  Returns true on progress.
+fn remove_dead_sync(f: &mut Function) -> bool {
+    for bi in 0..f.blocks.len() {
+        for ip in 0..f.blocks[bi].instrs.len() {
+            let Op::BSSy(bssy) = &f.blocks[bi].instrs[ip].op else {
+                continue;
+            };
+            if !f.blocks[bi].instrs[ip].pred.is_true() {
+                continue;
+            }
+            let Some(bar) = bssy.bar_out.as_reg().copied() else {
+                continue;
+            };
+            let target = bssy.target;
+
+            // Walk forward to the BSYNC on this barrier: no branch, no other
+            // use of the barrier, no entry from elsewhere on the way.
+            let mut found = None;
+            let (mut cb, mut cip) = (bi, ip + 1);
+            'walk: loop {
+                if cip >= f.blocks[cb].instrs.len() {
+                    cb += 1;
+                    cip = 0;
+                    if cb >= f.blocks.len()
+                        || f.blocks.pred_indices(cb) != [cb - 1]
+                    {
+                        break 'walk;
+                    }
+                    continue;
+                }
+                let instr = &f.blocks[cb].instrs[cip];
+                if instr.is_branch() {
+                    break 'walk;
+                }
+                if let Op::BSync(bsync) = &instr.op {
+                    if bar_reg(&bsync.bar) == Some(bar) {
+                        if instr.pred.is_true() {
+                            found = Some((cb, cip));
+                        }
+                        break 'walk;
+                    }
+                }
+                if uses_bar(instr, &bar) {
+                    break 'walk;
+                }
+                cip += 1;
+            }
+            let Some((sb, sip)) = found else {
+                continue;
+            };
+
+            // The BSSY target: the instruction after the BSYNC (a label NOP
+            // or the next block's start)
+            f.blocks[sb].instrs.remove(sip);
+            f.blocks[bi].instrs.remove(ip);
+            // BMOV.CLEAR of this barrier right before, if any
+            let mut k = ip;
+            while k > 0 {
+                k -= 1;
+                let instr = &f.blocks[bi].instrs[k];
+                if let Op::BClear(op) = &instr.op {
+                    if op.dst.as_reg() == Some(&bar) {
+                        f.blocks[bi].instrs.remove(k);
+                    }
+                    break;
+                }
+                if uses_bar(instr, &bar) || instr.is_branch() {
+                    break;
+                }
+            }
+            // The label NOP, unless something else still targets it
+            let refs = referenced_labels(f);
+            if !refs.contains(&target) {
+                for b in f.blocks.iter_mut() {
+                    b.instrs.retain(|i| {
+                        !matches!(&i.op, Op::Nop(nop) if nop.label == Some(target))
+                    });
+                }
+            }
+            return true;
+        }
+    }
+    false
+}
+
+/// Appends a block to its fall-through predecessor when nothing else reaches
+/// it or names its label
+fn merge_blocks(f: &mut Function) {
+    let refs = referenced_labels(f);
+    for i in (1..f.blocks.len()).rev() {
+        // A block that ends in a branch stays: the empty block left behind
+        // falls through, which the last block must not
+        if f.blocks.pred_indices(i) != [i - 1]
+            || f.blocks[i - 1].branch().is_some()
+            || f.blocks[i].branch().is_some()
+            || refs.contains(&f.blocks[i].label)
+            || f.blocks[i].instrs.is_empty()
+        {
+            continue;
+        }
+        let mut instrs = std::mem::take(&mut f.blocks[i].instrs);
+        let uniform = f.blocks[i].uniform;
+        let prev = &mut f.blocks[i - 1];
+        prev.instrs.append(&mut instrs);
+        prev.uniform &= uniform;
+    }
+}
+
+impl Function {
+    pub fn opt_if_convert(&mut self) {
+        let mut progress = false;
+        loop {
+            let mut changed = false;
+            // Inner regions come after their outer branch, so go backwards
+            for i in (0..self.blocks.len()).rev() {
+                if try_convert(self, i) {
+                    changed = true;
+                }
+            }
+            if !changed {
+                break;
+            }
+            progress = true;
+            rewrite_cfg(self);
+            while remove_dead_sync(self) {}
+            rewrite_cfg(self);
+        }
+        if progress {
+            merge_blocks(self);
+            rewrite_cfg(self);
+        }
+    }
+}
+
+impl Shader<'_> {
+    pub fn opt_if_convert(&mut self) {
+        if !crate::knobs::if_convert() {
+            return;
+        }
+        for f in &mut self.functions {
+            f.opt_if_convert();
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    use compiler::cfg::CFGBuilder;
+    use rustc_hash::FxBuildHasher;
+
+    fn gpr(i: u32) -> RegRef {
+        RegRef::new(RegFile::GPR, i, 1)
+    }
+
+    fn bra(target: Label, p: Option<(RegRef, bool)>) -> Instr {
+        let mut i = Instr::new(OpBra {
+            target,
+            cond: true.into(),
+        });
+        if let Some((p, inv)) = p {
+            i.pred = Pred {
+                pred_ref: PredRef::Reg(p),
+                pred_inv: inv,
+            };
+        }
+        i
+    }
+
+    /// @p0 bra L2; L1: r0 = r1 + r2 (or p0 = ...); bra L3; L2: r0 = r3;
+    /// L3: exit
+    fn if_else(then_writes_p0: bool) -> Function {
+        let mut labels = LabelAllocator::new();
+        let l: Vec<Label> = (0..4).map(|_| labels.alloc()).collect();
+        let p0 = RegRef::new(RegFile::Pred, 0, 1);
+
+        let then_op: Instr = if then_writes_p0 {
+            Instr::new(OpFSetP {
+                dst: p0.into(),
+                set_op: PredSetOp::And,
+                cmp_op: FloatCmpOp::OrdLt,
+                srcs: [gpr(1).into(), gpr(2).into()],
+                accum: true.into(),
+                ftz: false,
+            })
+        } else {
+            Instr::new(OpFAdd {
+                dst: gpr(0).into(),
+                srcs: [gpr(1).into(), gpr(2).into()],
+                saturate: false,
+                rnd_mode: FRndMode::NearestEven,
+                ftz: false,
+            })
+        };
+        let blocks = vec![
+            vec![bra(l[2], Some((p0, false)))],
+            vec![then_op, bra(l[3], None)],
+            vec![Instr::new(OpMov {
+                dst: gpr(0).into(),
+                src: gpr(3).into(),
+                quad_lanes: 0xf,
+            })],
+            vec![Instr::new(OpExit {})],
+        ];
+
+        let mut cfg = CFGBuilder::<_, _, FxBuildHasher>::new();
+        for (i, instrs) in blocks.into_iter().enumerate() {
+            cfg.add_node(
+                l[i],
+                BasicBlock {
+                    label: l[i],
+                    uniform: false,
+                    instrs,
+                },
+            );
+        }
+        cfg.add_edge(l[0], l[1]);
+        cfg.add_edge(l[0], l[2]);
+        cfg.add_edge(l[1], l[3]);
+        cfg.add_edge(l[2], l[3]);
+        Function {
+            ssa_alloc: SSAValueAllocator::new(),
+            phi_alloc: PhiAllocator::new(),
+            blocks: cfg.as_cfg(true),
+        }
+    }
+
+    fn all_instrs(f: &Function) -> Vec<&Instr> {
+        f.blocks.iter().flat_map(|b| b.instrs.iter()).collect()
+    }
+
+    #[test]
+    fn if_else_is_predicated() {
+        let mut f = if_else(false);
+        f.opt_if_convert();
+        let instrs = all_instrs(&f);
+        assert!(!instrs.iter().any(|i| matches!(&i.op, Op::Bra(_))));
+        let fadd = instrs
+            .iter()
+            .find(|i| matches!(&i.op, Op::FAdd(_)))
+            .unwrap();
+        assert!(fadd.pred.pred_inv);
+        let mov = instrs.iter().find(|i| matches!(&i.op, Op::Mov(_))).unwrap();
+        assert!(!mov.pred.is_true() && !mov.pred.pred_inv);
+        // Then before else, and the exit last
+        let pos = |f: &dyn Fn(&Op) -> bool| {
+            instrs.iter().position(|i| f(&i.op)).unwrap()
+        };
+        assert!(
+            pos(&|op| matches!(op, Op::FAdd(_)))
+                < pos(&|op| matches!(op, Op::Mov(_)))
+        );
+        assert!(matches!(&instrs.last().unwrap().op, Op::Exit(_)));
+    }
+
+    #[test]
+    fn predicate_overwrite_stays() {
+        let mut f = if_else(true);
+        f.opt_if_convert();
+        let instrs = all_instrs(&f);
+        assert_eq!(
+            instrs
+                .iter()
+                .filter(|i| matches!(&i.op, Op::Bra(_)))
+                .count(),
+            2
+        );
+        assert!(instrs
+            .iter()
+            .all(|i| !matches!(&i.op, Op::FSetP(_)) || i.pred.is_true()));
+    }
+}
diff --git a/src/nouveau/compiler/nak/opt_jump_thread.rs b/src/nouveau/compiler/nak/opt_jump_thread.rs
index b484fde..82f3058 100644
--- a/src/nouveau/compiler/nak/opt_jump_thread.rs
