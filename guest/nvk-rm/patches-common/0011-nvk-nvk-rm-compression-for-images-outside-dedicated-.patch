diff --git a/src/nouveau/vulkan/nvk_device_memory.c b/src/nouveau/vulkan/nvk_device_memory.c
index 10992e8..fcb7116 100644
--- a/src/nouveau/vulkan/nvk_device_memory.c
+++ b/src/nouveau/vulkan/nvk_device_memory.c
@@ -70,6 +70,25 @@ nvk_memory_type_flags(const VkMemoryType *type,
    return flags;
 }
 
+/* Compression for images that are not alone in their allocation: device-
+ * local memory any compressible image may be bound to is asked for
+ * compressible (nvk_image_plane_bind checks what the backend granted).  Not
+ * for memory the CPU maps or another process or API opens.
+ */
+static enum nvkmd_mem_flags
+nvk_compressible_mem_flags(const struct nvk_physical_device *pdev,
+                           const VkMemoryType *type, bool not_shared)
+{
+   if (!pdev->nvkmd->kmd_info.has_compressible_mem || !not_shared)
+      return 0;
+
+   if (!(type->propertyFlags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT) ||
+       (type->propertyFlags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT))
+      return 0;
+
+   return NVKMD_MEM_COMPRESSIBLE;
+}
+
 VKAPI_ATTR VkResult VKAPI_CALL
 nvk_GetMemoryFdPropertiesKHR(VkDevice device,
                              VkExternalMemoryHandleTypeFlagBits handleType,
@@ -315,6 +334,7 @@ nvk_AllocateMemory(VkDevice device,
       if (result != VK_SUCCESS)
          goto fail_alloc;
    } else {
+      flags |= nvk_compressible_mem_flags(pdev, type, not_shared);
       result = nvkmd_dev_alloc_mem(dev->nvkmd, &dev->vk.base,
                                    aligned_size, alignment, flags,
                                    &mem->mem);
diff --git a/src/nouveau/vulkan/nvk_image.c b/src/nouveau/vulkan/nvk_image.c
index af77ee7..42211d0 100644
--- a/src/nouveau/vulkan/nvk_image.c
+++ b/src/nouveau/vulkan/nvk_image.c
@@ -1210,7 +1210,8 @@ nvk_image_init(struct nvk_device *dev,
 static VkResult
 nvk_image_plane_alloc_va(struct nvk_device *dev,
                          const struct nvk_image *image,
-                         struct nvk_image_plane *plane)
+                         struct nvk_image_plane *plane,
+                         uint8_t pte_kind)
 {
    assert(plane->va == NULL);
    VkResult result;
@@ -1230,7 +1231,7 @@ nvk_image_plane_alloc_va(struct nvk_device *dev,
       const uint64_t va_size_B = align64(plane->nil.size_B, va_align_B);
 
       result = nvkmd_dev_alloc_va(dev->nvkmd, &dev->vk.base,
-                                  va_flags, plane->nil.pte_kind,
+                                  va_flags, pte_kind,
                                   va_size_B, va_align_B,
                                   0 /* fixed_addr */, &plane->va);
       if (result != VK_SUCCESS)
@@ -1308,13 +1309,15 @@ nvk_CreateImage(VkDevice _device,
    if (image->vk.create_flags & (VK_IMAGE_CREATE_SPARSE_BINDING_BIT |
                                  VK_IMAGE_CREATE_SPARSE_RESIDENCY_BIT)) {
       for (uint8_t plane = 0; plane < image->plane_count; plane++) {
-         result = nvk_image_plane_alloc_va(dev, image, &image->planes[plane]);
+         result = nvk_image_plane_alloc_va(dev, image, &image->planes[plane],
+                                           image->planes[plane].nil.pte_kind);
          if (result != VK_SUCCESS)
             goto fail;
       }
 
       if (image->stencil_copy_temp.nil.size_B > 0) {
-         result = nvk_image_plane_alloc_va(dev, image, &image->stencil_copy_temp);
+         result = nvk_image_plane_alloc_va(dev, image, &image->stencil_copy_temp,
+                                           image->stencil_copy_temp.nil.pte_kind);
          if (result != VK_SUCCESS)
             goto fail;
       }
@@ -1655,7 +1658,20 @@ nvk_image_plane_bind(struct nvk_device *dev,
          image->is_compressed = true;
          plane->addr = mem->mem->va->addr + offset_B;
       } else {
-         VkResult result = nvk_image_plane_alloc_va(dev, image, plane);
+         /* Memory the backend backed with compression resources
+          * (NVKMD_MEM_COMPRESSIBLE): the image is compressed through its
+          * own VA wherever in the memory it is bound.  Only an image's
+          * single plane: can_compress rules out multi-plane images.
+          */
+         const bool compress = image->can_compress && not_shared &&
+                               plane == &image->planes[0] &&
+                               plane->nil.compressed_pte_kind != 0 &&
+                               (mem->mem->flags & NVKMD_MEM_COMPRESSIBLE);
+         const uint8_t pte_kind = compress ? plane->nil.compressed_pte_kind
+                                           : plane->nil.pte_kind;
+
+         VkResult result = nvk_image_plane_alloc_va(dev, image, plane,
+                                                    pte_kind);
          if (result != VK_SUCCESS)
             return result;
 
@@ -1664,6 +1680,9 @@ nvk_image_plane_bind(struct nvk_device *dev,
                                     plane->va->size_B);
          if (result != VK_SUCCESS)
             return result;
+
+         if (compress)
+            image->is_compressed = true;
       }
    } else {
       plane->addr = mem->mem->va->addr + offset_B;
diff --git a/src/nouveau/vulkan/nvkmd/nvkmd.h b/src/nouveau/vulkan/nvkmd/nvkmd.h
index fdd4352..c478eb2 100644
--- a/src/nouveau/vulkan/nvkmd/nvkmd.h
+++ b/src/nouveau/vulkan/nvkmd/nvkmd.h
@@ -64,6 +64,14 @@ enum nvkmd_mem_flags {
     *  memory may let the GPU cache it.
     */
    NVKMD_MEM_GPU_READ_ONLY = 1 << 6,
+
+   /** Images bound anywhere in this memory may use their compressed PTE
+    *  kind, not only a dedicated image through the memory's own VA.  Only
+    *  asked for when nvkmd_info::has_compressible_mem is set.  The backend
+    *  keeps the flag in nvkmd_mem::flags only when the memory really got
+    *  compression resources; NVK checks it there at bind time.
+    */
+   NVKMD_MEM_COMPRESSIBLE = 1 << 7,
 };
 
 #define NVKMD_MEM_PLACEMENT_FLAGS \
@@ -131,6 +139,12 @@ struct nvkmd_info {
    bool has_overmap;
    bool has_compression;
 
+   /** Device-local memory may be allocated NVKMD_MEM_COMPRESSIBLE, so that
+    *  images sub-allocated from it are compressed too (implies
+    *  has_compression)
+    */
+   bool has_compressible_mem;
+
    /** VRAM may be mapped by the CPU (exposes a host-visible VRAM type) */
    bool has_host_visible_vram;
 
diff --git a/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm.h b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm.h
index d1b7eb1..dc628c6 100644
--- a/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm.h
+++ b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm.h
@@ -300,6 +300,15 @@ struct nvkmd_rm_dev {
    struct util_vma_heap heap;
    struct util_vma_heap replay_heap;
 
+   /* NVK_RM_COMPRESS_ALL statistics, logged as they grow and at device
