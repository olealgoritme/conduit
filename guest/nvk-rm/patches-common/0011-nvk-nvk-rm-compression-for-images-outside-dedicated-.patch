 src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_dev.c  | 10 +++++
 src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_mem.c  | 48 ++++++++++++++++++++-
 src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_pdev.c |  9 ++++
