+    */
+   uint32_t compr_mems, compr_refused, compr_image_binds, compr_upgraded;
+   uint64_t compr_mem_B;
+
    struct nvkmd_rm_sema_pool sema_pool;
 
    /* Host-visible VRAM (the BAR heap): bytes of CPU-mapped VRAM currently
@@ -383,6 +392,11 @@ struct nvkmd_rm_mem {
    uint8_t pte_kind;
    uint16_t tile_mode;
 
+   /* RM backed the memory with compression resources (COMPR_ANY): every
+    * GPU mapping of it then uses a compressible kind (nvkmd_rm_va.c).
+    */
+   bool compressed;
+
    /* GEM handle on dev->drm_fd once the memory has been exported, 0 before */
    simple_mtx_t export_mutex;
    uint32_t gem_handle;
diff --git a/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_dev.c b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_dev.c
index 2faf259..bbdc240 100644
--- a/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_dev.c
+++ b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_dev.c
@@ -246,6 +246,16 @@ fail_alloc:
 static void
 nvkmd_rm_dev_destroy(struct nvkmd_dev *_dev)
 {
+   /* NVK_RM_COMPRESS_ALL statistics (nvkmd_rm_mem.c, nvkmd_rm_va.c) */
+   const struct nvkmd_rm_dev *stats = nvkmd_rm_dev(_dev);
+   if (stats->compr_mems + stats->compr_refused != 0) {
+      mesa_logi("NVK: NVK_RM_COMPRESS_ALL: %u compressible memories (%u "
+                "MiB), %u refused; %u compressed image binds, %u "
+                "uncompressed kinds made compressible", stats->compr_mems,
+                (unsigned)(stats->compr_mem_B >> 20), stats->compr_refused,
+                stats->compr_image_binds, stats->compr_upgraded);
+   }
+
    struct nvkmd_rm_dev *dev = nvkmd_rm_dev(_dev);
    const struct nvkmd_rm_lib *lib = dev->lib;
 
diff --git a/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_mem.c b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_mem.c
index 8dc582e..f7dbbaf 100644
--- a/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_mem.c
+++ b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_mem.c
@@ -353,7 +353,27 @@ nvkmd_rm_alloc_tiled_mem(struct nvkmd_dev *_dev,
    }
 
    /* NVK only asks for a compressible kind for a dedicated allocation of
-    * an image it then uses through the memory's own VA.
+    * an image it then uses through the memory's own VA, and, with
+    * NVK_RM_COMPRESS_ALL, for device-local memory any image may be bound to
+    * (vkd3d-proton heaps, application sub-allocators): that is allocated
+    * compressible like a dedicated image's, so the images placed in it can
+    * be mapped with their compressible kind.  GB20x keeps compression state
+    * per physical page (GMMU v3 PTEs have no comptag line), so this costs
+    * no comptag pool.  RM maps a compressible kind over memory allocated
+    * without compression with the uncompressed kind (virtual_mem.c), which
+    * is why the allocation has to ask for it.  Only memory the CPU never
+    * maps and nobody else opens.
+    */
+   const bool compr_heap = vram && pte_kind == 0 && tile_mode == 0 &&
+                           (flags & NVKMD_MEM_COMPRESSIBLE) &&
+                           !(flags & (NVKMD_MEM_CAN_MAP | NVKMD_MEM_SHARED)) &&
+                           dev->base.pdev->kmd_info.has_compressible_mem;
+   flags &= ~NVKMD_MEM_COMPRESSIBLE;
+   if (compr_heap)
+      pte_kind = NVKMD_RM_PTE_KIND_GENERIC_MEMORY_COMPRESSIBLE;
+
+   /* Either way RM backs the memory with compression resources, or says it
+    * did not.
     */
    const bool image_mem = vram && pte_kind_is_compressible(dev_info, pte_kind);
    bool compressed = image_mem;
@@ -427,6 +447,32 @@ nvkmd_rm_alloc_tiled_mem(struct nvkmd_dev *_dev,
    nvkmd_mem_init(&dev->base, &mem->base, &nvkmd_rm_mem_ops,
                   flags, size_B, page_size_B);
 
+   /* The memory's own VA (buffers, linear images, ZCULL) is mapped below
+    * with pte_kind: the compressible kind when RM granted it, so that no GPU
+    * access to compressible memory goes through an uncompressed kind.
+    */
+   mem->compressed = vram && compressed;
+   if (compr_heap) {
+      /* Not an image's layout: nothing to tell an importer */
+      mem->pte_kind = 0;
+      if (compressed) {
+         mem->base.flags |= NVKMD_MEM_COMPRESSIBLE;
+         const uint32_t n = p_atomic_inc_return(&dev->compr_mems);
+         p_atomic_add(&dev->compr_mem_B, size_B);
+         if (util_is_power_of_two_nonzero(n)) {
+            mesa_logi("NVK: %u compressible device-local memories, %" PRIu64
+                      " MiB (NVK_RM_COMPRESS_ALL)", n,
+                      p_atomic_read(&dev->compr_mem_B) >> 20);
+         }
+      } else {
+         const uint32_t n = p_atomic_inc_return(&dev->compr_refused);
+         if (util_is_power_of_two_nonzero(n)) {
+            mesa_logw("NVK: RM refused compression for %u device-local "
+                      "memories (NVK_RM_COMPRESS_ALL)", n);
+         }
+      }
+   }
+
    /* So the memory's own VA gets the image's kind (compressible, or GMK if
     * RM declined).  Everything else maps the memory as generic and gives
     * images their kind on their own VA.
diff --git a/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_pdev.c b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_pdev.c
index de1f951..852d5eb 100644
--- a/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_pdev.c
+++ b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_pdev.c
@@ -426,6 +426,15 @@ nvkmd_rm_try_create_pdev(const struct nvkmd_rm_lib *lib,
       .host_visible_vram_is_pinned = true,
    };
 
+   /* GB20x compression is per physical page (GMMU v3 PTEs carry no
+    * comptag line), so device-local memory may be allocated compressible
+    * as a whole and sub-allocated images compressed by their PTE kind
+    * (nvkmd_rm_mem.c).  Off by default while it is measured.
+    */
+   pdev->base.kmd_info.has_compressible_mem =
+      pdev->base.kmd_info.has_compression &&
+      debug_get_bool_option("NVK_RM_COMPRESS_ALL", false);
+
    /* VRAM is allocated with 64 KiB pages; system memory BOs get their own
     * 4 KiB bind alignment (nvkmd_mem::bind_align_B).
     */
diff --git a/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_va.c b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_va.c
index e43b3dc..265a39c 100644
--- a/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_va.c
+++ b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_va.c
@@ -6,6 +6,7 @@
 #include "nvkmd_rm.h"
 
 #include "util/log.h"
+#include "util/u_atomic.h"
 #include "util/u_math.h"
 #include "vk_log.h"
 
@@ -341,6 +342,42 @@ nvkmd_rm_va_free(struct nvkmd_va *_va)
    FREE(va);
 }
 
+/* GB20x PTE kinds (dev_mmu.h): GB20x has only these and PITCH */
+#define NVKMD_RM_VA_KIND_GMK              0x06
+#define NVKMD_RM_VA_KIND_GMK_COMPRESSIBLE 0x08
+
+/* The kind for an image VA bound to memory RM backed with compression
+ * resources (nvkmd_rm_mem::compressed, GB20x only).  An uncompressed access
+ * would read and write the raw compressed pages, so block-linear images
+ * that are not compressed themselves (sampled-only textures, sparse
+ * images, images NVK does not compress) get the compressible kind too:
+ * the GPU compresses and decompresses those transparently, as it does for
+ * buffers through the memory's own VA, and their 3D state keeps
+ * compression off.
+ */
+static uint32_t
+compressed_mem_kind(struct nvkmd_rm_dev *dev, const struct nvkmd_rm_va *va,
+                    const struct nvkmd_rm_mem *mem, uint32_t kind)
+{
+   if (kind == NVKMD_RM_VA_KIND_GMK) {
+      p_atomic_inc(&dev->compr_upgraded);
+      return NVKMD_RM_VA_KIND_GMK_COMPRESSIBLE;
+   }
+
+   /* An image bound with its compressible kind outside a dedicated
+    * allocation (the memory's own VA)
+    */
+   if (&va->base != mem->base.va) {
+      const uint32_t n = p_atomic_inc_return(&dev->compr_image_binds);
+      if (util_is_power_of_two_nonzero(n)) {
+         mesa_logi("NVK: %u image binds with compressible kind 0x%x in "
+                   "sub-allocated memories (NVK_RM_COMPRESS_ALL)", n, kind);
+      }
+   }
+
+   return kind;
+}
+
 static VkResult
 nvkmd_rm_va_bind_mem(struct nvkmd_va *_va,
                      struct vk_object_base *log_obj,
@@ -372,6 +409,8 @@ nvkmd_rm_va_bind_mem(struct nvkmd_va *_va,
       if (dev->lib->map_dma2 != NULL) {
          flags |= NVRM_DEF(OS46, _FLAGS, _PAGE_KIND_OVERRIDE, _YES);
          kind = va->base.pte_kind;
+         if (mem->compressed)
+            kind = compressed_mem_kind(dev, va, mem, kind);
       } else {
          static bool warned;
          if (!warned) {
