+static bool
+is_f2f16_seed(const nir_instr *instr)
+{
+   if (instr->type != nir_instr_type_alu)
+      return false;
+   const nir_alu_instr *alu = nir_instr_as_alu(instr);
+   if (alu->op != nir_op_f2f16 && alu->op != nir_op_f2f16_rtne &&
+       alu->op != nir_op_f2f16_rtz)
+      return false;
+   return alu->def.num_components == 1 && alu->def.bit_size == 16 &&
+          alu->src[0].src.ssa->bit_size == 32;
+}
+
+/* The first ALU use of def, for the partner preference: (op, source) */
+static bool
+first_alu_use(nir_def *def, nir_op *op, unsigned *src_idx)
+{
+   nir_foreach_use(src, def) {
+      nir_instr *u = nir_src_use_instr(src);
+      if (u->type != nir_instr_type_alu)
+         continue;
+      nir_alu_instr *ua = nir_instr_as_alu(u);
+      *op = ua->op;
+      *src_idx = container_of(src, nir_alu_src, src) - ua->src;
+      return true;
+   }
+   return false;
+}
+
+/* True if no use of a's result comes before instruction index limit in
+ * a's block (the pair is placed at the later conversion)
+ */
+static bool
+uses_after(nir_alu_instr *a, unsigned limit)
+{
+   nir_foreach_use_including_if(src, &a->def) {
+      if (nir_src_is_if(src))
+         return false;
+      nir_instr *u = nir_src_use_instr(src);
+      if (u->block == a->instr.block && u->index < limit)
+         return false;
+   }
+   return true;
+}
+
+/* NAK_F16_PAIR: independent scalar f2f16 (32 -> 16 bit) conversions in a
+ * block become one 2-wide conversion (F2FP.PACK_AB takes the two 32-bit
+ * values from separate registers, so the source vector costs nothing).
+ * The 16-bit math that follows then reads the two lanes of one vector,
+ * which nir_opt_vectorize pairs into HFMA2/HADD2/HMUL2 along the chain.
+ * Partners are picked within a window, preferring one whose first use is
+ * the same operation at the same source.
