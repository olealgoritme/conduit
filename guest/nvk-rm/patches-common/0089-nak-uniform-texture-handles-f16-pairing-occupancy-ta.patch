diff --git a/src/nouveau/compiler/nak/from_nir.rs b/src/nouveau/compiler/nak/from_nir.rs
index dac9df5..ab5c742 100644
--- a/src/nouveau/compiler/nak/from_nir.rs
+++ b/src/nouveau/compiler/nak/from_nir.rs
@@ -1994,12 +1994,55 @@ impl<'a> ShaderFromNir<'a> {
             _ => panic!("Unsupported texture dimension: {}", tex.sampler_dim),
         };
 
-        let srcs = tex.srcs_as_slice();
+        let all_srcs = tex.srcs_as_slice();
+        // NAK_TEX_UHANDLE: a uniform bindless handle, last
+        let uhandle_src = all_srcs
+            .last()
+            .filter(|s| s.src_type == nir_tex_src_texture_handle);
+        let srcs = &all_srcs
+            [..all_srcs.len() - usize::from(uhandle_src.is_some())];
         assert!(srcs[0].src_type == nir_tex_src_backend1);
         if srcs.len() > 1 {
             assert!(srcs.len() == 2);
             assert!(srcs[1].src_type == nir_tex_src_backend2);
         }
+        // The instruction's uniform register field names a UGPR pair:
+        // texture index (bits 0-19 of the handle), sampler index (bits
+        // 20-31), as the reference compiler's code unpacks it
+        let handle: Src = match uhandle_src {
+            None => Src::ZERO,
+            Some(s) => {
+                let h = self.get_ssa(s.src.as_def())[0];
+                let h = if h.file().is_uniform() {
+                    h
+                } else {
+                    // Uniform by NIR's divergence analysis: any lane's value
+                    let u = b.alloc_ssa(RegFile::UGPR);
+                    b.push_op(OpR2UR {
+                        src: h.into(),
+                        dst: u.into(),
+                    });
+                    u
+                };
+                let pair = b.alloc_ssa_vec(RegFile::UGPR, 2);
+                b.push_op(OpLop3 {
+                    dst: pair[0].into(),
+                    srcs: [h.into(), 0xfffff_u32.into(), 0.into()],
+                    op: LogicOp3::new_lut(&|x, y, _| x & y),
+                });
+                b.push_op(OpShf {
+                    dst: pair[1].into(),
+                    low: h.into(),
+                    high: 0.into(),
+                    shift: 20_u32.into(),
+                    right: true,
+                    wrap: true,
+                    data_type: IntType::U32,
+                    dst_high: false,
+                });
+                pair.into()
+            }
+        };
 
         let flags: nak_nir_tex_flags =
             unsafe { std::mem::transmute_copy(&tex.backend_flags) };
@@ -2162,6 +2205,7 @@ impl<'a> ShaderFromNir<'a> {
                     nodep: flags.nodep(),
                     channel_mask,
                     scalar: flags.scalar(),
+                    handle: handle.clone(),
                 });
             } else if tex.op == nir_texop_tg4 {
                 b.push_op(OpTld4 {
@@ -2177,6 +2221,7 @@ impl<'a> ShaderFromNir<'a> {
                     nodep: flags.nodep(),
                     channel_mask,
                     scalar: flags.scalar(),
+                    handle: handle.clone(),
                 });
             } else {
                 assert!(offset_mode != TexOffsetMode::PerPx);
@@ -2194,6 +2239,7 @@ impl<'a> ShaderFromNir<'a> {
                     nodep: flags.nodep(),
                     channel_mask,
                     scalar: flags.scalar(),
+                    handle: handle.clone(),
                 });
             }
         }
