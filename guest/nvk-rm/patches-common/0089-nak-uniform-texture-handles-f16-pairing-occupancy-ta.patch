+/// NAK_TEX_UHANDLE (0-2, default 0, SM100+): a bindless texture handle that
+/// is the same in every lane goes in the instruction's uniform register
+/// field, a UGPR pair (texture index, sampler index), with the scalar source
+/// form (.SCR), as in the reference compiler's code, instead of the second
+/// source vector: fewer copies to build contiguous source vectors.  1: texel
+/// fetches (TLD) only; 2: TEX, TLD and TLD4 (nak_nir_lower_tex.c,
+/// from_nir.rs, sm70_encode.rs)
+pub fn tex_uhandle() -> u32 {
+    *TEX_UHANDLE.get_or_init(|| match env::var("NAK_TEX_UHANDLE") {
+        Ok(s) => match s.trim().parse::<u32>() {
+            Ok(v) if v <= 2 => v,
+            _ => 0,
+        },
+        Err(_) => 0,
+    })
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn nak_knob_tex_uhandle() -> u32 {
+    tex_uhandle()
+}
+
+fn parse_u32(name: &str, default: u32, max: u32) -> u32 {
+    match env::var(name) {
+        Ok(s) => match s.trim().parse::<u32>() {
+            Ok(v) if v <= max => v,
+            _ => {
+                eprintln!("NAK: ignoring {}=\"{}\" (0-{})", name, s.trim(), max);
+                default
+            }
+        },
+        Err(_) => default,
+    }
+}
+
+/// NAK_F16_PAIR (default off): independent scalar 32-to-16-bit float
+/// conversions in a block are paired into one 2-wide conversion (one
+/// F2FP.PACK_AB), so the 16-bit math that follows reads the lanes of one
+/// vector and nir_opt_vectorize pairs it into HFMA2/HADD2/HMUL2 (nak_nir.c)
+pub fn f16_pair() -> bool {
+    *F16_PAIR.get_or_init(|| parse("NAK_F16_PAIR", env::var("NAK_F16_PAIR"), false))
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn nak_knob_f16_pair() -> bool {
+    f16_pair()
+}
+
+/// NAK_REMAT_LD_COST (1-63, default 4): what a rematerialized global or
+/// constant load costs in the spiller and in the occupancy target's dry run
+/// (spill_remat::op_cost).  A memory fill costs 8; a reload that is a load
+/// from L1 or L2 can cost more than its issue slot
+pub fn remat_ld_cost() -> u32 {
+    *REMAT_LD_COST
+        .get_or_init(|| parse_u32("NAK_REMAT_LD_COST", 4, 63).max(1))
+}
+
+/// NAK_OCC_GPRS (0-255, default 0 = off): with NAK_OCC_TARGET, the register
+/// target of every shader whose natural count is higher, instead of the
+/// estimated best (rounded up to a multiple of 8).  For sweeps of one
+/// shader (dispatch-replay), not for games
+pub fn occ_gprs() -> u32 {
+    *OCC_GPRS.get_or_init(|| parse_u32("NAK_OCC_GPRS", 0, 255))
+}
+
 /// NAK_SCHED_ILP (default off): the prepass enters an instruction in its
 /// future-ready set at the cycle its edge latencies give, as NAK_SCHED_MLP
 /// does, but keeps the plain latency model.  Without it a producer is ready
@@ -186,6 +255,10 @@ pub extern "C" fn nak_knobs_key2() -> u32 {
         | (u32::from(fset_bf()) << 8)
         | (u32::from(sched_ilp()) << 9)
         | (gcm() << 10)
+        | (tex_uhandle() << 12)
+        | (remat_ld_cost() << 14)
+        | (occ_gprs() << 20)
+        | (u32::from(f16_pair()) << 28)
 }
 
