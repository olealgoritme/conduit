     * buffers and push descriptors (a bound set has its own layout)
@@ -1102,6 +1179,90 @@ nvk_dcap_compute_spirv_hook(struct vk_device *vk_dev,
    }
 }
 
+static int dcap_draw_slot(const struct nvk_dcap_dev *dcap,
+                          const struct nvk_dcap_recipe *rc);
+
+/* The bindings as set layouts lay them out, for descriptor buffers and push
+ * descriptors (a bound set has its own layout)
+ */
+static void
+dcap_recipe_layouts(struct nvk_dcap_recipe *r, uint32_t set_count,
+                    const struct vk_descriptor_set_layout *const *sets)
+{
+   for (uint32_t i = 0; i < r->nvars; i++) {
+      struct dcap_var *v = &r->vars[i];
+      if (v->set >= set_count || sets[v->set] == NULL)
+         continue;
+      const struct nvk_descriptor_set_layout *sl =
+         vk_to_nvk_descriptor_set_layout(
+            (struct vk_descriptor_set_layout *)sets[v->set]);
+      if (v->binding >= sl->binding_count)
+         continue;
+      const struct nvk_descriptor_set_binding_layout *bl =
+         &sl->binding[v->binding];
+      v->have_layout = true;
+      v->layout_type = bl->type;
+      v->layout_offset = bl->offset;
+      v->layout_stride = bl->stride;
+      v->layout_array_size = bl->array_size;
+      v->layout_set_flags = sl->flags;
+   }
+}
+
+/* Every graphics shader gets a recipe (the vertex shader of a captured draw
+ * is not in the list); only listed ones are logged
+ */
+static void
+nvk_dcap_graphics_spirv_hook(struct vk_device *vk_dev,
+                             struct vk_shader *vk_shader,
+                             const uint32_t *spirv, size_t spirv_size_B,
+                             uint32_t set_layout_count,
+                             struct vk_descriptor_set_layout *const *set_layouts)
+{
+   struct nvk_device *dev = container_of(vk_dev, struct nvk_device, vk);
+   struct nvk_dcap_dev *dcap = dev->dcap;
+   if (dcap == NULL)
+      return;
+   struct nvk_shader *shader = container_of(vk_shader, struct nvk_shader, vk);
+
+   simple_mtx_lock(&dcap->mutex);
+   const bool have = shader->dcap_recipe != NULL;
+   simple_mtx_unlock(&dcap->mutex);
+   if (have)
+      return;
+
+   struct nvk_dcap_recipe *r = dcap_scan_spirv(spirv, spirv_size_B);
+   if (r == NULL)
+      return;
+   r->src_hash = vk_shader->src_hash;
+   r->stage = vk_shader->stage;
+   r->code_hash = shader->code_size > 0 ?
