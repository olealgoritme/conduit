+/* Whether the next matching call of this slot is captured; its call index
+ * and capture serial
+ */
+static bool
+dcap_take(struct nvk_dcap_dev *dcap, int slot, uint32_t *call_index_out,
+          uint32_t *serial_out)
+{
+   const int64_t now = os_time_get_nano();
+   if (now < dcap->arm_ns)
+      return false;
+
+   simple_mtx_lock(&dcap->mutex);
+   if (!dcap->triggered) {
+      if (now < dcap->trigger_check_ns) {
+         simple_mtx_unlock(&dcap->mutex);
+         return false;
+      }
+      dcap->trigger_check_ns = now + 250000000ll;
+      dcap->triggered = dcap_file_exists(dcap->trigger);
+      if (!dcap->triggered) {
+         simple_mtx_unlock(&dcap->mutex);
+         return false;
+      }
+      dcap_log(dcap, "trigger file %s found: armed", dcap->trigger);
+   }
+   const bool take = dcap->taken[slot] < dcap->count &&
+                     dcap->seen[slot]++ >= dcap->skip;
+   *call_index_out = dcap->seen[slot] - 1;
+   *serial_out = 0;
+   if (take) {
+      dcap->taken[slot]++;
+      *serial_out = ++dcap->serial;
+   }
+   simple_mtx_unlock(&dcap->mutex);
+   return take;
+}
+
+/* The slot of a fragment shader in the list: by source hash, or by code
+ * hash (an 8-digit entry)
+ */
+static int
+dcap_draw_slot(const struct nvk_dcap_dev *dcap,
+               const struct nvk_dcap_recipe *rc)
+{
+   int slot = dcap_hash_slot(dcap, rc->src_hash);
+   if (slot >= 0 || rc->code_hash == 0)
+      return slot;
+   return dcap_hash_slot(dcap, rc->code_hash);
+}
+
+/* A recipe's descriptors and root addresses as resources of cap (shared
+ * with the ones already there)
+ */
+static void
+dcap_add_recipe_resources(struct nvk_cmd_buffer *cmd,
+                          struct nvk_descriptor_state *desc,
+                          struct nvk_dcap *cap,
+                          const struct nvk_dcap_recipe *rc)
+{
+   struct nvk_device *dev = nvk_cmd_buffer_device(cmd);
+
+   /* The recipe's variables, for the manifest's binding list */
+   uint32_t var_base[DCAP_MAX_VARS];
+   for (uint32_t i = 0; i < rc->nvars; i++) {
+      const struct dcap_var *v = &rc->vars[i];
+      uint32_t j;
+      for (j = 0; j < cap->nvars; j++) {
+         if (cap->vars[j].set == v->set && cap->vars[j].binding == v->binding)
+            break;
+      }
+      if (j == cap->nvars && cap->nvars < DCAP_MAX_VARS)
+         cap->vars[cap->nvars++] = *v;
+      var_base[i] = j;
+   }
+
+   for (uint32_t i = 0; i < rc->nrefs && cap->nres < DCAP_MAX_RES; i++) {
+      const struct dcap_ref *ref = &rc->refs[i];
+      const struct dcap_var *v = &rc->vars[ref->var];
+      uint32_t index = ref->add;
+      if (ref->pc_off != DCAP_NONE && ref->pc_off + 4 <= NVK_MAX_PUSH_SIZE) {
+         uint32_t w;
+         memcpy(&w, cap->push + ref->pc_off, 4);
+         index += w;
+      }
+      bool dup = false;
+      for (uint32_t j = 0; j < cap->nres; j++) {
+         const struct dcap_res *o = &cap->res[j];
+         if (o->var != DCAP_NONE && o->role == DCAP_ROLE_NONE &&
+             o->set == v->set && o->binding == v->binding &&
+             o->index == index && o->dtype == v->type) {
+            dup = true;
+            break;
+         }
+      }
+      if (dup)
+         continue;
+      struct dcap_res *r = &cap->res[cap->nres++];
+      r->var = var_base[ref->var];
+      r->set = v->set;
+      r->binding = v->binding;
+      r->index = index;
+      r->dtype = v->type;
+      r->pc_off = ref->pc_off;
+      r->add = ref->add;
+      r->writable = v->writable;
+      dcap_resolve_ref(cmd, desc, cap, v, index, r);
+   }
+
+   for (uint32_t i = 0; i < rc->nbdas && cap->nres < DCAP_MAX_RES; i++) {
+      const struct dcap_bda *b = &rc->bdas[i];
+      bool dup = false;
+      for (uint32_t j = 0; j < cap->nres; j++) {
+         if (cap->res[j].kind == DCAP_RES_BDA &&
+             cap->res[j].pc_off == b->pc_off) {
+            cap->res[j].writable |= b->writable;
+            dup = true;
+            break;
+         }
+      }
+      if (dup)
+         continue;
+      struct dcap_res *r = &cap->res[cap->nres++];
+      r->var = DCAP_NONE;
+      r->pc_off = b->pc_off;
+      r->writable = b->writable;
+      uint64_t addr = 0;
+      if (b->pc_off + 8 <= NVK_MAX_PUSH_SIZE)
+         memcpy(&addr, cap->push + b->pc_off, 8);
+      dcap_fill_buffer(dev, r, DCAP_RES_BDA, addr,
+                       b->size_B != 0 ? b->size_B : DCAP_BDA_RUNTIME_MAX,
+                       DCAP_BDA_RUNTIME_MAX);
+   }
+}
+
+/* The staging buffer of cap (inputs, then outputs with _POST); false (and
+ * logged) if it cannot be had.  When a mapping of inputs and outputs cannot
+ * be had, the capture goes without the outputs.
+ */
+static bool
+dcap_alloc_staging(struct nvk_device *dev, struct nvk_dcap *cap)
+{
+   struct nvk_dcap_dev *dcap = dev->dcap;
+retry:;
+   uint64_t off = DCAP_HEADER_B;
+   for (uint32_t i = 0; i < cap->nres; i++) {
+      struct dcap_res *r = &cap->res[i];
+      if (r->size_B == 0)
+         continue;
+      r->off_B = off;
+      off = align64(off + r->size_B, 256);
+   }
+   if (cap->post) {
+      for (uint32_t i = 0; i < cap->nres; i++) {
+         struct dcap_res *r = &cap->res[i];
+         if (r->size_B == 0 || !r->writable)
+            continue;
+         r->post_off_B = off;
+         off = align64(off + r->size_B, 256);
+      }
+   }
+   cap->mem_size_B = off;
+   if (off > dcap->max_B) {
+      dcap_log(dcap, "shader %016" PRIx64 " call %u: %" PRIu64 " MiB of "
+               "staging is over NVK_DISPATCH_CAPTURE_MAX_MB, not captured",
+               cap->src_hash, cap->call_index, off >> 20);
+      return false;
+   }
+   VkResult result = nvkmd_dev_alloc_mapped_mem(dev->nvkmd, &dev->vk.base,
+                                                off, 0, NVKMD_MEM_GART,
+                                                NVKMD_MEM_MAP_RDWR, &cap->mem);
+   if (result != VK_SUCCESS && cap->post) {
+      dcap_log(dcap, "shader %016" PRIx64 " call %u: no staging memory "
+               "(%" PRIu64 " MiB): %s; capturing without the outputs",
+               cap->src_hash, cap->call_index, off >> 20,
+               vk_Result_to_str(result));
+      cap->mem = NULL;
+      cap->post = false;
+      for (uint32_t i = 0; i < cap->nres; i++)
+         cap->res[i].post_off_B = 0;
+      goto retry;
+   }
+   if (result != VK_SUCCESS) {
+      cap->mem = NULL;
+      dcap_log(dcap, "shader %016" PRIx64 " call %u: no staging memory "
+               "(%" PRIu64 " MiB): %s", cap->src_hash, cap->call_index,
+               off >> 20, vk_Result_to_str(result));
+      return false;
+   }
+   memset(cap->mem->map, 0, DCAP_HEADER_B);
+   return true;
+}
+
+/* Copies of every captured resource into the staging buffer (post: the
+ * writable ones into their output slots)
+ */
+static void
+dcap_copy_resources(struct nvk_cmd_buffer *cmd, struct nvk_dcap *cap,
+                    bool post)
+{
+   const uint64_t va = cap->mem->va->addr;
+   for (uint32_t i = 0; i < cap->nres; i++) {
+      const struct dcap_res *r = &cap->res[i];
+      if (r->size_B == 0 || (post && !r->writable))
+         continue;
+      const uint64_t dst = va + (post ? r->post_off_B : r->off_B);
+      if (r->kind == DCAP_RES_IMAGE)
+         dcap_copy_image(cmd, r, dst);
+      else
+         dcap_copy_linear(cmd, r->addr, dst, r->size_B);
+   }
+}
+
+/* Waits for everything recorded before on the 3D and compute engines and
+ * flushes their writes, as a barrier from all commands to transfers
+ */
+static void
+dcap_barrier_all(struct nvk_cmd_buffer *cmd)
+{
+   const VkMemoryBarrier2 mb = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER_2,
+      .srcStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
+      .srcAccessMask = VK_ACCESS_2_MEMORY_WRITE_BIT,
+      .dstStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
+      .dstAccessMask = VK_ACCESS_2_MEMORY_READ_BIT |
+                       VK_ACCESS_2_MEMORY_WRITE_BIT,
+   };
+   const VkDependencyInfo dep = {
+      .sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO,
+      .memoryBarrierCount = 1,
+      .pMemoryBarriers = &mb,
+   };
+   nvk_cmd_flush_wait_dep(cmd, &dep, true);
+   nvk_cmd_invalidate_deps(cmd, 1, &dep);
+}
+
+static void
+dcap_free(struct nvk_dcap *cap)
+{
+   if (cap->mem != NULL)
+      nvkmd_mem_unref(cap->mem);
+   free(cap->spirv);
+   free(cap->vs_spirv);
+   free(cap);
+}
+
+void
+nvk_dcap_note_dgc(struct nvk_cmd_buffer *cmd)
+{
+   struct nvk_device *dev = nvk_cmd_buffer_device(cmd);
+   struct nvk_dcap_dev *dcap = dev->dcap;
+   const struct nvk_shader *fs = cmd->state.gfx.shaders[MESA_SHADER_FRAGMENT];
+   if (fs == NULL || fs->dcap_recipe == NULL)
+      return;
+   const int slot = dcap_draw_slot(dcap, fs->dcap_recipe);
+   if (slot < 0)
+      return;
+   uint32_t call_index = 0, serial = 0;
+   if (!dcap_take(dcap, slot, &call_index, &serial))
+      return;
+   dcap_log(dcap, "shader %016" PRIx64 " (code %08x) draw %u: not captured: "
+            "device-generated commands", fs->dcap_recipe->src_hash,
+            fs->dcap_recipe->code_hash, call_index);
+}
+
+struct nvk_dcap *
+nvk_dcap_draw_begin(struct nvk_cmd_buffer *cmd,
+                    const struct nvk_dcap_draw_call *call)
+{
+   const bool indexed = call->indexed;
+   const bool indirect = call->indirect_addr != 0;
+   const uint32_t count = call->count, instance_count = call->instance_count;
+   const uint32_t first = call->first, first_instance = call->first_instance;
+   const int32_t vertex_offset = call->vertex_offset;
+   const uint32_t vertex_count = count;
+   struct nvk_device *dev = nvk_cmd_buffer_device(cmd);
+   struct nvk_dcap_dev *dcap = dev->dcap;
+   const struct nvk_shader *fs = cmd->state.gfx.shaders[MESA_SHADER_FRAGMENT];
+   const struct nvk_shader *vs = cmd->state.gfx.shaders[MESA_SHADER_VERTEX];
+   if (fs == NULL || fs->dcap_recipe == NULL)
+      return NULL;
+   const struct nvk_dcap_recipe *frc = fs->dcap_recipe;
+   const int slot = dcap_draw_slot(dcap, frc);
+   if (slot < 0)
+      return NULL;
+
+   struct vk_dynamic_graphics_state *dyn = &cmd->vk.dynamic_graphics_state;
+   const struct nvk_rendering_state *render = &cmd->state.gfx.render;
+   const char *why = NULL;
+   if (vs == NULL || vs->dcap_recipe == NULL)
+      why = "no vertex shader with SPIR-V";
+   else if (cmd->state.gfx.shaders[MESA_SHADER_TESS_CTRL] != NULL ||
+            cmd->state.gfx.shaders[MESA_SHADER_TESS_EVAL] != NULL ||
+            cmd->state.gfx.shaders[MESA_SHADER_GEOMETRY] != NULL ||
+            cmd->state.gfx.shaders[MESA_SHADER_MESH] != NULL)
+      why = "tessellation, geometry or mesh shaders";
+   else if (indexed && cmd->state.gfx.dcap_ib_addr == 0)
+      why = "no index buffer";
+   else if (render->samples > 1 || dyn->ms.rasterization_samples > 1)
+      why = "multisampled rendering";
+   else if (render->view_mask != 0)
+      why = "multiview rendering";
+
+   uint32_t call_index = 0, serial = 0;
+   if (!dcap_take(dcap, slot, &call_index, &serial))
+      return NULL;
+   if (why != NULL) {
+      dcap_log(dcap, "shader %016" PRIx64 " (code %08x) draw %u: not "
+               "captured: %s", frc->src_hash, frc->code_hash, call_index, why);
+      return NULL;
+   }
+
+   struct nvk_dcap *cap = calloc(1, sizeof(*cap));
+   if (cap == NULL)
+      return NULL;
+   cap->draw = true;
+   cap->serial = serial;
+   cap->marker = DCAP_MARKER | (serial & 0xffffff);
+   cap->src_hash = frc->src_hash;
+   cap->code_hash = frc->code_hash;
+   cap->vs_src_hash = vs->dcap_recipe->src_hash;
+   cap->vs_code_hash = vs->dcap_recipe->code_hash;
+   cap->call_index = call_index;
+   cap->post = dcap->post;
+   cap->t_s = os_time_get_nano() / 1e9;
+   const struct nvk_root_descriptor_table *root =
+      (const struct nvk_root_descriptor_table *)
+      cmd->state.gfx.descriptors.root;
+   memcpy(cap->push, root->push, sizeof(cap->push));
+   cap->push_size = MAX2(frc->push_size, vs->dcap_recipe->push_size);
+   cap->spirv = malloc(frc->spirv_size);
+   if (cap->spirv != NULL) {
+      memcpy(cap->spirv, frc->spirv, frc->spirv_size);
+      cap->spirv_size = frc->spirv_size;
+   }
+   cap->vs_spirv = malloc(vs->dcap_recipe->spirv_size);
+   if (cap->vs_spirv != NULL) {
+      memcpy(cap->vs_spirv, vs->dcap_recipe->spirv,
+             vs->dcap_recipe->spirv_size);
+      cap->vs_spirv_size = vs->dcap_recipe->spirv_size;
+   }
+   snprintf(cap->unsupported, sizeof(cap->unsupported), "%s%s%s",
+            frc->unsupported, frc->nunsupported &&
+            vs->dcap_recipe->nunsupported ? "; vertex shader: " :
+            vs->dcap_recipe->nunsupported ? "vertex shader: " : "",
+            vs->dcap_recipe->unsupported);
+
+   /* State */
+   struct dcap_draw *dd = &cap->d;
+   dd->vertex_count = vertex_count;
+   dd->instance_count = instance_count;
+   dd->first_vertex = indexed ? 0 : first;
+   dd->first_instance = first_instance;
+   dd->indexed = indexed;
+   dd->first_index = indexed ? first : 0;
+   dd->vertex_offset = indexed ? vertex_offset : 0;
+   dd->index_type = cmd->state.gfx.dcap_ib_type;
+   dd->indirect = indirect;
+   dd->indirect_count = indirect && call->count_addr != 0;
+   dd->draw_count = indirect ? call->draw_count : 0;
+   dd->stride = indirect ? call->stride : 0;
+   if (dyn->vi != NULL)
+      dd->vi = *dyn->vi;
+   for (uint32_t b = 0; b < MESA_VK_MAX_VERTEX_BINDINGS; b++)
+      dd->vi_strides[b] = dyn->vi_binding_strides[b];
+   dd->topology = dyn->ia.primitive_topology;
+   dd->primitive_restart = dyn->ia.primitive_restart_enable;
+   dd->polygon_mode = dyn->rs.polygon_mode;
+   dd->cull_mode = dyn->rs.cull_mode;
+   dd->front_face = dyn->rs.front_face;
+   dd->depth_clamp = dyn->rs.depth_clamp_enable;
+   dd->rasterizer_discard = dyn->rs.rasterizer_discard_enable;
+   dd->depth_bias = dyn->rs.depth_bias.enable;
+   dd->depth_bias_constant = dyn->rs.depth_bias.constant_factor;
+   dd->depth_bias_slope = dyn->rs.depth_bias.slope_factor;
+   dd->depth_bias_clamp = dyn->rs.depth_bias.clamp;
+   dd->line_width = dyn->rs.line.width;
+   dd->viewport_count = dyn->vp.viewport_count;
+   dd->scissor_count = dyn->vp.scissor_count;
+   dd->viewport = dyn->vp.viewports[0];
+   dd->scissor = dyn->vp.scissors[0];
+   dd->area = render->area;
+   dd->layers = render->layer_count;
+   dd->view_mask = render->view_mask;
+   dd->samples = MAX2(render->samples, 1);
+   dd->sample_mask = dyn->ms.sample_mask;
+   dd->alpha_to_coverage = dyn->ms.alpha_to_coverage_enable;
+   dd->ds = dyn->ds;
+   dd->cb = dyn->cb;
+   dd->color_count = render->color_att_count;
+
+   /* The shaders' resources: fragment, then vertex */
+   struct nvk_descriptor_state *desc = &cmd->state.gfx.descriptors;
+   dcap_add_recipe_resources(cmd, desc, cap, frc);
+   dcap_add_recipe_resources(cmd, desc, cap, vs->dcap_recipe);
+
+   /* Attachments */
+   for (uint32_t i = 0; i < render->color_att_count && i < NVK_MAX_RTS &&
+                        cap->nres < DCAP_MAX_RES; i++) {
+      dd->color_format[i] = render->color_att[i].vk_format;
+      const struct nvk_image_view *iview = render->color_att[i].iview;
+      if (iview == NULL)
+         continue;
+      struct dcap_res *r = &cap->res[cap->nres++];
+      r->var = DCAP_NONE;
+      r->pc_off = DCAP_NONE;
+      r->role = DCAP_ROLE_COLOR;
+      r->attachment = i;
+      r->att_format = render->color_att[i].vk_format;
+      r->writable = true;
+      if (!dcap_fill_image_aspect(dev, r, iview, VK_IMAGE_ASPECT_COLOR_BIT))
+         r->kind = DCAP_RES_ERROR;
