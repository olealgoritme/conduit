+      nvk_dcap_recipe_free(r);
+   } else if (dcap_draw_slot(dcap, shader->dcap_recipe) >= 0) {
+      const struct nvk_dcap_recipe *sr = shader->dcap_recipe;
+      dcap_log(dcap, "%s shader %016" PRIx64 " (code %08x): %u bytes of "
+               "SPIR-V, push constants %u B, %u resource variables, %u "
+               "descriptor references, %u root addresses%s%s",
+               _mesa_shader_stage_to_string(sr->stage), sr->src_hash,
+               sr->code_hash, (unsigned)sr->spirv_size, sr->push_size,
+               sr->nvars, sr->nrefs, sr->nbdas,
+               sr->nunsupported ? "; unsupported: " : "", sr->unsupported);
