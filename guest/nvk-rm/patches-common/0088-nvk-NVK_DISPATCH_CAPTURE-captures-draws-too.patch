 struct nvk_dcap {
    struct list_head link;
    uint32_t serial, marker;
@@ -264,6 +330,14 @@ struct nvk_dcap {
    /* Copy of the recipe's variables for the manifest's binding list */
    uint32_t nvars;
    struct dcap_var vars[DCAP_MAX_VARS];
+
+   /* Draws */
+   bool draw;
+   struct dcap_draw d;
+   uint64_t vs_src_hash;
