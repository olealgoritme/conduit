diff --git a/src/nouveau/vulkan/nvk_dispatch_capture.c b/src/nouveau/vulkan/nvk_dispatch_capture.c
index 7725c19..06997f8 100644
--- a/src/nouveau/vulkan/nvk_dispatch_capture.c
+++ b/src/nouveau/vulkan/nvk_dispatch_capture.c
@@ -52,6 +52,17 @@
  * A command buffer of the async compute family that captures runs on the
  * channel with every engine (it uses the copy engine).
  *
+ * Draws (NVK_DISPATCH_CAPTURE lists a fragment shader, by source hash or
+ * by the 8-digit code hash NVK_SHADER_STATS prints): every graphics shader
+ * gets a recipe when its pipeline is created (vk_device::
+ * graphics_spirv_hook); a direct vkCmdDraw with a listed fragment shader
+ * and a vertex shader only (no tessellation, geometry or vertex attributes,
+ * single sample) is captured with both shaders' SPIR-V and resources, the
+ * color, depth and stencil attachments before and (with _POST) after the
+ * draw, and the state a replay needs (viewport, scissor, render area,
+ * topology, rasterization, depth/stencil and blend state); manifest "kind"
+ * "draw".
+ *
  * Limits: direct and indirect vkCmdDispatch only (not device-generated
  * commands); single-plane, single-sample, non-sparse-residency images
  * (color, or the depth or stencil aspect of a depth view); descriptors as
@@ -115,6 +126,8 @@
 #define DCAP_MAX_MIPS   16
 #define DCAP_NONE       0xffffffffu
 #define DCAP_BDA_RUNTIME_MAX (16ull << 20)
+/* Index and vertex buffers: at most this much of each */
+#define DCAP_VB_MAX (256ull << 20)
 #define DCAP_BUF_MAX    (256ull << 20)
 #define DCAP_HEADER_B   256u
 #define DCAP_MARKER     0xdc000000u
@@ -172,6 +185,8 @@ struct dcap_bda {
 
 struct nvk_dcap_recipe {
    uint64_t src_hash;
+   uint32_t code_hash;
+   mesa_shader_stage stage;
    uint32_t *spirv;
    size_t spirv_size;
    uint32_t push_size;
@@ -233,11 +248,62 @@ struct dcap_res {
    uint32_t sampler_index;
    struct vk_sampler_state sampler;
 
+   /* Draws: an attachment (DCAP_ROLE_*), its index and format */
+   uint8_t role;
+   uint32_t attachment;
+   VkFormat att_format;
+
    /* Staging */
    uint64_t off_B, size_B, post_off_B;
    char note[160];
 };
 
+enum dcap_role {
+   DCAP_ROLE_NONE,
+   DCAP_ROLE_COLOR,
+   DCAP_ROLE_DEPTH,
+   DCAP_ROLE_STENCIL,
+   DCAP_ROLE_INDEX,
+   DCAP_ROLE_VERTEX,
+   DCAP_ROLE_INDIRECT,
+   DCAP_ROLE_COUNT,
+};
+
+/* What a draw capture records of the state */
+struct dcap_draw {
+   uint32_t vertex_count, instance_count, first_vertex, first_instance;
+   bool indexed;
+   uint32_t first_index;
+   int32_t vertex_offset;
+   VkIndexType index_type;
+   bool indirect, indirect_count;
+   uint32_t draw_count, stride;
+   struct vk_vertex_input_state vi;
+   uint16_t vi_strides[MESA_VK_MAX_VERTEX_BINDINGS];
+   uint8_t topology;
+   bool primitive_restart;
+   VkPolygonMode polygon_mode;
+   VkCullModeFlags cull_mode;
+   VkFrontFace front_face;
+   bool depth_clamp, rasterizer_discard;
+   bool depth_bias;
+   float depth_bias_constant, depth_bias_slope, depth_bias_clamp;
+   float line_width;
+   uint32_t viewport_count, scissor_count;
+   VkViewport viewport;
+   VkRect2D scissor;
+   VkRect2D area;
+   uint32_t layers, view_mask;
+   uint32_t samples;
+   uint16_t sample_mask;
+   bool alpha_to_coverage;
+   struct vk_depth_stencil_state ds;
+   struct vk_color_blend_state cb;
+   uint32_t color_count;
+   VkFormat color_format[NVK_MAX_RTS];
+   VkFormat depth_format, stencil_format;
+};
