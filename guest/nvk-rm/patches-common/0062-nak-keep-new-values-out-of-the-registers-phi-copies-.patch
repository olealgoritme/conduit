From aed04878723602758416c80593df9cd4625fed8c Mon Sep 17 00:00:00 2001
From: Ole Algoritme <olealgoritme@gmail.com>
Date: Sat, 17 Oct 2026 16:00:29 +0200
Subject: [PATCH] nak: keep new values out of the registers phi copies want
 (NAK_PHI_AVOID)

Register copies at if/else merges are the largest part of what is left of
NAK's extra instructions over the reference compiler in the heavy Steel
Nomad fragment shaders.  Part of them come from a value without a register
preference taking the lowest free register, which the phi web of a value
flowing out of the block already has: the phi copies at the end of the
block then have to move it out of the way, often as a swap.

The register allocator now notes, per block, the registers the phi webs of
the block's phi sources already have, and a new value without a phi or
vector preference picks a free register outside them when there is one.

The NAK knobs that do not fit in nak_gpr_cap_key() go into a second key,
nak_knobs_key(), which NVK puts in bits 0-11 and 56-63 of its compiler
flags (NAK's debug flags use 8 bits).

Offline, GB202 (NAK_PHI_AVOID=0 -> 1): Steel Nomad fragment 135760 ->
134712 instructions, compute 67220 -> 67094; CS2 -0.5%; no register count
changes.
---
 src/nouveau/compiler/nak.h              |  1 +
 src/nouveau/compiler/nak/assign_regs.rs | 39 +++++++++++++++++++++++++
 src/nouveau/compiler/nak/knobs.rs       | 19 +++++++++++-
 src/nouveau/vulkan/nvk_shader.c         |  6 +++-
 4 files changed, 63 insertions(+), 2 deletions(-)

diff --git a/src/nouveau/compiler/nak.h b/src/nouveau/compiler/nak.h
index 23898bd..f5303dd 100644
--- a/src/nouveau/compiler/nak.h
+++ b/src/nouveau/compiler/nak.h
@@ -32,6 +32,7 @@ uint64_t nak_debug_flags(const struct nak_compiler *nak);
  * 16-23, each in registers per thread; 0 is no cap.
  */
 uint32_t nak_gpr_cap_key(void);
+uint32_t nak_knobs_key(void);
 
 const struct nir_shader_compiler_options *
 nak_nir_options(const struct nak_compiler *nak);
diff --git a/src/nouveau/compiler/nak/assign_regs.rs b/src/nouveau/compiler/nak/assign_regs.rs
index 4962473..195dd88 100644
--- a/src/nouveau/compiler/nak/assign_regs.rs
+++ b/src/nouveau/compiler/nak/assign_regs.rs
@@ -265,6 +265,9 @@ struct RegAllocator {
     pinned: BitSet,
     reg_ssa: Vec<Option<SSAValue>>,
     ssa_reg: FxHashMap<SSAValue, u32>,
+    /// Registers that the phi copies at the end of the current block want
+    /// for other values: new values without a preference avoid them
+    avoid: BitSet,
 }
 
 impl RegAllocator {
@@ -276,6 +279,7 @@ impl RegAllocator {
             pinned: Default::default(),
             reg_ssa: Vec::new(),
             ssa_reg: Default::default(),
+            avoid: Default::default(),
         }
     }
 
@@ -474,6 +478,20 @@ impl RegAllocator {
             }
         }
 
+        // Keep out of the registers this block's phi copies want, if there
+        // is room elsewhere (NAK_PHI_AVOID)
+        if !self.avoid.is_empty() {
+            let mut busy = self.used.clone();
+            for r in self.avoid.iter() {
+                busy.insert(r);
+            }
+            if let Some(reg) = self.try_find_unset_reg_range(&busy, 0, 1, 1, 0)
+            {
+                self.assign_reg(ssa, reg);
+                return reg;
+            }
+        }
+
         let reg = self
             .try_find_unused_reg_range(0, 1, 1, 0)
             .expect("Failed to find free register");
@@ -1303,6 +1321,23 @@ impl AssignRegsBlock {
 
         let sum = SSAUseMap::for_block(b);
 
+        // The registers the phi webs of this block's phi sources already
+        // have: whatever else gets one of them now has to move out of the
+        // way in the phi copies at the end of the block
+        if crate::knobs::phi_avoid() {
+            if let Some(phi_srcs) = b.phi_srcs() {
+                for (_, src) in phi_srcs.srcs.iter() {
+                    let Some(ssa) = src.as_ssa() else {
+                        continue;
+                    };
+                    let Some(reg) = phi_webs.get(ssa[0]) else {
+                        continue;
+                    };
+                    self.ra[ssa[0].file()].avoid.insert(reg as usize);
+                }
+            }
+        }
+
         let mut instrs = Vec::new();
         let mut srcs_killed = KillSet::new();
         let mut dsts_killed = KillSet::new();
@@ -1368,6 +1403,10 @@ impl AssignRegsBlock {
             }
         }
 
+        for ra in self.ra.values_mut() {
+            ra.avoid.clear();
+        }
+
         // Update phi_webs with the registers assigned in this block
         for ra in self.ra.values() {
             for (ssa, reg) in &ra.ssa_reg {
diff --git a/src/nouveau/compiler/nak/knobs.rs b/src/nouveau/compiler/nak/knobs.rs
index 9a5ed44..e498fe3 100644
--- a/src/nouveau/compiler/nak/knobs.rs
+++ b/src/nouveau/compiler/nak/knobs.rs
@@ -5,7 +5,8 @@
 //! reference compiler's for the same shaders.  Each is read once from the
 //! environment: 0 turns it off (NAK's previous code generation for that
 //! part), 1 on; unset is the default given below.  They are part of
-//! nak_gpr_cap_key() and so of the driver's shader cache keys.
+//! nak_gpr_cap_key() or nak_knobs_key() and so of the driver's shader cache
+//! keys.
 //!
 //! - NAK_IMM_CSE: a register copy of an immediate serves the next uses in
 //!   its block (legalizer).  Default: compute shaders only, where it never
@@ -20,6 +21,9 @@
 //!   (nir_opt_peephole_select limit 8, nak_nir.c).  Fewer instructions, but
 //!   the values of both sides are live at once, which costs occupancy on
 //!   some shaders
+//! - NAK_PHI_AVOID (default on): register allocation keeps new values out
+//!   of the registers that the phi copies at the end of the block want
+//!   (assign_regs.rs)
 //! - NAK_BSSY_RECONVERGENT (default off): on SM100+, the BSSY/BSYNC pairs of
 //!   if/else regions (barriers no BREAK uses) use the .RECONVERGENT mode,
 //!   as the reference compiler's SM120 code does, without the BMOV.CLEAR
@@ -53,6 +57,7 @@ static PLOP_FOLD: OnceLock<bool> = OnceLock::new();
 static IF_CONVERT: OnceLock<bool> = OnceLock::new();
 static NIR_FLATTEN: OnceLock<bool> = OnceLock::new();
 static BSSY_RECONVERGENT: OnceLock<bool> = OnceLock::new();
+static PHI_AVOID: OnceLock<bool> = OnceLock::new();
 
 /// NAK_IMM_CSE for a shader: compute shaders unless set
 pub fn imm_cse(compute: bool) -> bool {
@@ -108,6 +113,11 @@ pub fn bssy_reconvergent() -> bool {
     })
 }
 
+pub fn phi_avoid() -> bool {
+    *PHI_AVOID
+        .get_or_init(|| parse("NAK_PHI_AVOID", env::var("NAK_PHI_AVOID"), true))
+}
+
 /// The knobs packed for nak_gpr_cap_key(), bits 25 and up
 pub fn cache_key_bits() -> u32 {
     (imm_cse_key() << 30)
@@ -127,3 +137,10 @@ pub extern "C" fn nak_knob_uaddr_pin() -> bool {
 pub extern "C" fn nak_knob_nir_flatten() -> bool {
     nir_flatten()
 }
+
+/// The knobs that do not fit in nak_gpr_cap_key(), for the low 12 bits of
+/// NVK's compiler flags
+#[unsafe(no_mangle)]
+pub extern "C" fn nak_knobs_key() -> u32 {
+    u32::from(phi_avoid())
+}
diff --git a/src/nouveau/vulkan/nvk_shader.c b/src/nouveau/vulkan/nvk_shader.c
index 423b451..1625ebc 100644
--- a/src/nouveau/vulkan/nvk_shader.c
+++ b/src/nouveau/vulkan/nvk_shader.c
@@ -91,16 +91,20 @@ nvk_physical_device_compiler_flags(const struct nvk_physical_device *pdev)
    /* NAK_GPR_CAP*, NAK_OCC_TARGET: binaries compiled under other register
     * settings are not reused */
    uint64_t nak_gpr_caps = nak_gpr_cap_key();
+   /* The NAK_* knobs that do not fit in nak_gpr_cap_key() */
+   uint64_t nak_knobs = nak_knobs_key();
 
    assert(nak_flags <= UINT16_MAX);
    assert(nak_gpr_caps <= UINT32_MAX);
+   assert(nak_knobs <= 0xfff);
 
    return (no_cbufs ? 1 << 12 : 0)
       | (pdev->ubo_desc_cbufs ? 0 : 1 << 15)
       | (use_edb_buffer_views ? 1 << 13 : 0)
       | (instance->drirc.misc.ssbo_align_4b ? 1 << 14 : 0)
       | (nak_gpr_caps << 16)
-      | (nak_flags << 48);
+      | (nak_flags << 48)
+      | nak_knobs;
 }
 
 static const nir_shader_compiler_options *
