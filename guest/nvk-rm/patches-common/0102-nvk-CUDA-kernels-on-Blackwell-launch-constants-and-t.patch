diff --git a/src/nouveau/vulkan/nvk_descriptor_table.c b/src/nouveau/vulkan/nvk_descriptor_table.c
index a201a57..724a0ab 100644
--- a/src/nouveau/vulkan/nvk_descriptor_table.c
+++ b/src/nouveau/vulkan/nvk_descriptor_table.c
@@ -302,6 +302,60 @@ nvk_descriptor_table_insert(struct nvk_device *dev,
    return result;
 }
 
+static void
+nvk_descriptor_table_remove_locked(struct nvk_device *dev,
+                                   struct nvk_descriptor_table *table,
+                                   uint32_t index);
+
+static bool
+nvk_descriptor_table_index_free_locked(const struct nvk_descriptor_table *table,
+                                       uint32_t index)
+{
+   return index >= table->alloc || !BITSET_TEST(table->in_use, index);
+}
+
+VkResult
+nvk_descriptor_table_insert_pair(struct nvk_device *dev,
+                                 struct nvk_descriptor_table *a,
+                                 const void *desc_a, size_t size_a,
+                                 struct nvk_descriptor_table *b,
+                                 const void *desc_b, size_t size_b,
+                                 uint32_t *index_out)
+{
+   assert(a != b);
+   VkResult result = VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   /* Always a before b: no other path holds two table locks. */
+   simple_mtx_lock(&a->arena.mutex);
+   simple_mtx_lock(&b->arena.mutex);
+   const uint32_t limit = MIN2(a->max_alloc, b->max_alloc);
+   uint32_t index;
+   for (index = 1; index < limit; index++) {
+      if (nvk_descriptor_table_index_free_locked(a, index) &&
+          nvk_descriptor_table_index_free_locked(b, index))
+         break;
+   }
+   if (index < limit) {
+      result = nvk_descriptor_table_insert_locked(dev, a, index,
+                                                  desc_a, size_a);
+      if (result == VK_SUCCESS) {
+         result = nvk_descriptor_table_insert_locked(dev, b, index,
+                                                     desc_b, size_b);
+         if (result != VK_SUCCESS)
+            nvk_descriptor_table_remove_locked(dev, a, index);
+      }
+   } else {
+      result = vk_errorf(dev, VK_ERROR_OUT_OF_HOST_MEMORY,
+                         "No index free in both descriptor tables");
+   }
+   simple_mtx_unlock(&b->arena.mutex);
+   simple_mtx_unlock(&a->arena.mutex);
+
+   if (result == VK_SUCCESS)
+      *index_out = index;
+   return result;
+}
+
 static int
 compar_u32(const void *_a, const void *_b)
 {
