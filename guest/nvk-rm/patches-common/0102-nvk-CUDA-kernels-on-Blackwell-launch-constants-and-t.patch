+}
+
 static void
 nvk_cubin_dump(const char *extension, const void *data, size_t size)
 {
@@ -987,12 +993,60 @@ nvk_DestroyCuFunctionNVX(VkDevice _device, VkCuFunctionNVX _function,
 
 /* kernel launch */
 
+/* Bank 0: launch constants (nvk_cubin_launch_constants) and parameters */
 struct nvk_cubin_root_descriptor {
-   uint32_t block_dim[3];
-   uint32_t grid_dim[3];
-   uint8_t data[4096 - (6 * sizeof(uint32_t))];
+   uint8_t data[4096];
 };
 
+/* The launch constants CUDA kernels read from bank 0 besides their
+ * parameters.
+ *
+ * Before sm_100, NVK keeps the layout it always had: blockDim (%ntid) at
+ * 0x0, gridDim (%nctaid) at 0xc.  SASS for sm_100 and later (Blackwell:
+ * RTX 50 is sm_120) has its parameters at 0x380 and reads, checked with
+ * ngx-smoketest --cutest on an RTX 5090 (kernels compiled by NVIDIA's PTX
+ * JIT for sm_120):
+ *
+ *    0x2f8  64-bit generic address of the local memory window (cvta.local)
+ *    0x360  %ntid.x, .y, .z
+ *    0x370  %nctaid.x, .y, .z
+ *    0x37c  initial stack pointer: the stack grows down from it in the
+ *           thread's local memory
+ *
+ * With them zero, every kernel computed its pixel from blockIdx * 0 +
+ * threadIdx, and a kernel with a stack frame (local arrays, spills: DLSS's
+ * output kernels have one) addressed it below local address 0, outside
+ * the thread's local memory, where its loads return zero.  NVK gives
+ * the thread slm_size bytes of local memory (QMD low local memory size,
+ * from the kernel's EIATTR_MIN_STACK_SIZE), so the stack starts at its top.
+ */
+static void
+nvk_cubin_launch_constants(void *root, const struct nv_cubin_function *info,
+                           uint32_t sm, const VkCuLaunchInfoNVX *launch)
+{
+   const uint32_t block[3] = {
+      launch->blockDimX, launch->blockDimY, launch->blockDimZ,
+   };
+   const uint32_t grid[3] = {
+      launch->gridDimX, launch->gridDimY, launch->gridDimZ,
+   };
+   uint8_t *cb0 = root;
+
+   if (sm < 100) {
+      memcpy(cb0 + 0x0, block, sizeof(block));
+      memcpy(cb0 + 0xc, grid, sizeof(grid));
+      return;
+   }
+
+   assert(info->params_offset >= 0x380);
+   const uint64_t local_window = NVK_SHADER_LOCAL_MEMORY_WINDOW;
+   const uint32_t stack_top = align(info->slm_size, 16);
+   memcpy(cb0 + 0x2f8, &local_window, sizeof(local_window));
+   memcpy(cb0 + 0x360, block, sizeof(block));
+   memcpy(cb0 + 0x370, grid, sizeof(grid));
+   memcpy(cb0 + 0x37c, &stack_top, sizeof(stack_top));
+}
+
 /* extra launch parameters taken from vkd3d-proton */
 #define CU_LAUNCH_PARAM_BUFFER_POINTER ((const void *)0x01)
 #define CU_LAUNCH_PARAM_BUFFER_SIZE    ((const void *)0x02)
@@ -1023,12 +1077,8 @@ nvk_CmdCuLaunchKernelNVX(VkCommandBuffer commandBuffer,
       root = malloc(root_size);
    }
    memset(root, 0, root_size);
-   root->block_dim[0] = pLaunchInfo->blockDimX;
-   root->block_dim[1] = pLaunchInfo->blockDimY;
-   root->block_dim[2] = pLaunchInfo->blockDimZ;
-   root->grid_dim[0] = pLaunchInfo->gridDimX;
-   root->grid_dim[1] = pLaunchInfo->gridDimY;
-   root->grid_dim[2] = pLaunchInfo->gridDimZ;
+   nvk_cubin_launch_constants(root, function_info,
+                              function->module->info->sm, pLaunchInfo);
 
    const void *param_buffer = NULL;
    const uint32_t *param_buffer_size = NULL;
@@ -1103,8 +1153,11 @@ nvk_CmdCuLaunchKernelNVX(VkCommandBuffer commandBuffer,
    shader.cbuf_map.cbuf_count = function->cbuf_count;
    shader.cbuf_map.cbufs[0].type = NVK_CBUF_TYPE_ROOT_DESC;
 
+   const struct nvk_physical_device *pdev =
+      nvk_device_physical(nvk_cmd_buffer_device(cmd));
    nvk_cmd_dispatch_with_root_cbufs(cmd, &shader, root, root_size,
                                     function->cbufs,
+                                    nvk_cuda_sampler_via_header(pdev),
                                     pLaunchInfo->gridDimX,
                                     pLaunchInfo->gridDimY,
                                     pLaunchInfo->gridDimZ);
