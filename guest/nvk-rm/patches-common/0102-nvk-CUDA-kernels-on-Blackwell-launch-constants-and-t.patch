+/* CUDA texture handles on Blackwell
+ *
+ * CUDA kernels for sm_100 and later (Blackwell; RTX 50 is sm_120) take
+ * the whole handle as the texture header index: a sampler index in its
+ * upper bits, where NVK's combined handles have it, makes the texture
+ * instruction read another (or no) texture header.  The sampler comes from
+ * the QMD instead, which for CUDA launches NVK sets to
+ * SAMPLER_INDEX_VIA_HEADER_INDEX (nvk_CmdCuLaunchKernelNVX): the sampler at
+ * the texture header's index.  So a combined image sampler handle is an
+ * index where the image table holds a copy of the view's sampled
+ * descriptor and the sampler table a copy of the sampler, one per view and
+ * sampler state, kept until the view is destroyed.
+ *
+ * Checked with ngx-smoketest --cutest on an RTX 5090: with the sampler in
+ * the handle's upper bits, texture fetches and filtered lookups return
+ * zeros; through a pair index both return the texels, filtered with the
+ * pair's sampler.
+ */
+static simple_mtx_t nvk_cuda_tex_mutex = SIMPLE_MTX_INITIALIZER;
+
+static uint32_t
+nvk_image_view_cuda_tex_index(struct nvk_device *dev,
+                              struct nvk_image_view *view,
+                              const struct nvk_sampler *sampler)
+{
+   STATIC_ASSERT(sizeof(view->cuda_tex[0].sampler) ==
+                 sizeof(sampler->header));
+   uint32_t index = 0;
+
+   simple_mtx_lock(&nvk_cuda_tex_mutex);
+   for (uint32_t i = 0; i < view->cuda_tex_count; i++) {
