 /* Returns NULL if librmclient cannot be loaded */
@@ -215,6 +229,13 @@ struct nvkmd_rm_dev {
    bool no_kmd_source;
    bool source_live;
    struct nvrm_crm_scanout_source source;
+
+   /* RM fences for presents (nvkmd_rm_rmfence.c, dxvk-on-nvk S4), made on
+    * first use under rmfence_mutex.
+    */
+   struct nvkmd_rm_rmfence *rmfence;
+   simple_mtx_t rmfence_mutex;
+   bool rmfence_failed;
 #endif
 
    /* Map coherent host-visible system memory GPU-cacheable */
@@ -413,6 +434,66 @@ VkResult nvkmd_rm_mem_scanout_flip(struct nvkmd_mem *mem,
 /* Gives scanout 0 back to the desktop (no-op without a live source) */
 void nvkmd_rm_dev_scanout_release(struct nvkmd_dev *dev);
 
+/*
+ * RM fences for presents (nvkmd_rm_rmfence.c; guest/windows/docs/
+ * rm-fence-marker.md, dxvk-on-nvk S4).
+ *
+ * The device keeps a "present timeline" per presenting queue: a 64-bit
+ * semaphore, one entry of an RM NV_SEMAPHORE_SURFACE (RM-allocated system
+ * memory), imported on the host render node as a nvidia-drm
+ * semaphore-surface fence context.  A
+ * present signals the timeline's next value on its queue, after all the work
+ * submitted so far (rmfence_sync + vk_queue_signal_sync), and turns that value
+ * into a fence: a backend handle that fires one host EventReady when the GPU
+ * gets there.  Either the KMD takes the fence over with the flip
+ * (SCANOUT_PRESENT with the RM fence flag, KMD capability bit 32) and sends
+ * the flip itself when it fires, or, with an older KMD, a flip thread of this
+ * device waits on it and sends a plain SCANOUT_PRESENT.  The presenting
+ * thread never waits for the GPU.
+ */
+struct nvkmd_rm_rmfence;
+
+/* The present timeline of queue_key (a vk_queue) and its next value, or NULL
+ * when RM fences cannot be had here (no DRM fences on the host, an old
