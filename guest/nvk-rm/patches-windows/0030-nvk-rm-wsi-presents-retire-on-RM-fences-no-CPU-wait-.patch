+#include "util/u_debug.h"
+#include "vk_queue.h"
 
 /* Conduit's Helios adapter: swapchain images are shown by a host scanout
  * flip of the VRAM they live in (nvkmd_rm_win.c), no copy to a window.
@@ -37,6 +39,58 @@ nvk_wsi_scanout_flip(VkDevice _device, VkDeviceMemory _mem,
                                     flip->fourcc, flip->modifier);
 }
 
+VkResult
+nvk_queue_rm_fence(struct nvk_device *dev, struct vk_queue *queue,
+                   int *fence_out, uint64_t *value_out)
+{
+   uint64_t value = 0;
+
+   *fence_out = -1;
+   struct vk_sync *sync = nvkmd_rm_rmfence_sync(dev->nvkmd, &dev->vk.base,
+                                                queue, &value);
+   if (sync == NULL)
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+
+   /* In submission order on this queue, so after the frame's work on the
+    * GPU too (one channel per queue).
+    */
+   VkResult result = vk_queue_signal_sync(queue, sync, value);
+   if (result != VK_SUCCESS)
+      return result;
+
+   result = nvkmd_rm_rmfence_create(dev->nvkmd, &dev->vk.base, sync, value,
+                                    fence_out);
+   if (result != VK_SUCCESS)
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+   if (value_out != NULL)
+      *value_out = value;
+   return VK_SUCCESS;
+}
+
+/* The present without a CPU wait: the flip goes when the GPU has finished
+ * everything submitted to the present queue so far (nvkmd_rm_rmfence.c).
+ */
+static VkResult
+nvk_wsi_scanout_flip_fenced(VkDevice _device, VkQueue _queue,
+                            VkDeviceMemory _mem,
+                            const struct wsi_win32_scanout_flip *flip)
+{
+   VK_FROM_HANDLE(nvk_device, dev, _device);
+   VK_FROM_HANDLE(vk_queue, queue, _queue);
+   VK_FROM_HANDLE(nvk_device_memory, mem, _mem);
+
+   int fence;
+   VkResult result = nvk_queue_rm_fence(dev, queue, &fence, NULL);
+   if (result != VK_SUCCESS)
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+
+   return nvkmd_rm_mem_scanout_flip_fenced(mem->mem, &dev->vk.base,
+                                           flip->width, flip->height,
+                                           flip->stride, flip->offset,
+                                           flip->fourcc, flip->modifier,
+                                           fence);
+}
+
 static void
 nvk_wsi_scanout_release(VkDevice _device)
 {
@@ -90,6 +144,9 @@ nvk_init_wsi(struct nvk_physical_device *pdev)
    if (nvkmd_rm_scanout_supported(pdev->nvkmd)) {
       pdev->wsi_device.win32.scanout_export = nvk_wsi_scanout_export;
       pdev->wsi_device.win32.scanout_flip = nvk_wsi_scanout_flip;
+      pdev->wsi_device.win32.scanout_flip_fenced =
+         debug_get_bool_option("NVK_RM_FENCE", true) ?
+         nvk_wsi_scanout_flip_fenced : NULL;
       pdev->wsi_device.win32.scanout_release = nvk_wsi_scanout_release;
    }
 #endif
