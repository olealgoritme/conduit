 #include "helios_icd_interface.h"
 #include "drm-uapi/drm_fourcc.h"
@@ -192,6 +195,71 @@ helios_scanout_present(VkDevice _device, VkDeviceMemory _mem, VkImage _image)
                                     fl.fourcc, fl.modifier);
 }
 
+/* RM fences (helios_icd_interface.h version 3; dxvk-on-nvk S4) */
+static VkResult
+helios_queue_rm_fence(VkDevice _device, VkQueue _queue, uint32_t *fence_handle,
+                      uint64_t *value)
+{
+   VK_FROM_HANDLE(nvk_device, dev, _device);
+   VK_FROM_HANDLE(vk_queue, queue, _queue);
+
+   *fence_handle = 0;
+   if (dev == NULL || queue == NULL)
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+
+   int fence = -1;
+   VkResult result = nvk_queue_rm_fence(dev, queue, &fence, value);
+   if (result != VK_SUCCESS)
+      return result;
+   *fence_handle = (uint32_t)fence;
+   return VK_SUCCESS;
+}
+
+static VkResult
+helios_rm_fence_wait(VkDevice _device, uint32_t fence_handle,
+                     uint64_t timeout_ns)
+{
+   VK_FROM_HANDLE(nvk_device, dev, _device);
+
+   return nvkmd_rm_rmfence_wait(dev->nvkmd, (int)fence_handle, timeout_ns);
+}
+
+static void
+helios_rm_fence_close(VkDevice _device, uint32_t fence_handle)
+{
+   VK_FROM_HANDLE(nvk_device, dev, _device);
+
+   nvkmd_rm_rmfence_close(dev->nvkmd, (int)fence_handle);
+}
+
+static VkResult
+helios_scanout_present_fenced(VkDevice _device, VkDeviceMemory _mem,
+                              VkImage _image, uint32_t fence_handle)
+{
+   VK_FROM_HANDLE(nvk_device, dev, _device);
+   VK_FROM_HANDLE(nvk_device_memory, mem, _mem);
+   VK_FROM_HANDLE(nvk_image, image, _image);
+   const int fence = (int)fence_handle;
+
+   VkResult result = VK_ERROR_FORMAT_NOT_SUPPORTED;
+   struct nvkmd_rm_foreign_layout fl;
+   uint8_t pte_kind;
+   uint16_t tile_mode;
+   if (mem != NULL && image != NULL && mem->dedicated_image == image &&
+       !image->is_compressed)
+      result = helios_image_layout(image, &fl, &pte_kind, &tile_mode);
+   if (result != VK_SUCCESS) {
+      /* Takes the fence in every case: nothing will wait on it now */
+      nvkmd_rm_rmfence_close(dev->nvkmd, fence);
+      return result;
+   }
+   nvkmd_rm_mem_set_export_layout(mem->mem, pte_kind, tile_mode);
+
+   return nvkmd_rm_mem_scanout_flip_fenced(mem->mem, &dev->vk.base, fl.width,
+                                           fl.height, fl.stride, fl.offset,
+                                           fl.fourcc, fl.modifier, fence);
+}
+
 static void
 helios_scanout_release(VkDevice _device)
 {
@@ -221,6 +289,21 @@ helios_icd_interface_v2(uint32_t version, struct helios_icd_api *out)
       if (nvkmd_rm_win_rm_import_served())
          caps |= HELIOS_ICD_CAP_RES_ID;
    }
+   uint64_t ops = 0;
+   uint32_t features = 0;
+   if (lib != NULL && lib->win_caps != NULL &&
+       lib->win_semsurf_ctx_create != NULL &&
+       lib->win_semsurf_fence_create != NULL && lib->win_fence_wait != NULL &&
+       debug_get_bool_option("NVK_RM_FENCE", true) &&
+       lib->win_caps(&ops, &features) == 0 && (features & (1u << 11))) {
+      caps |= HELIOS_ICD_CAP_RM_FENCE;
+      /* QueryCaps.supported_ops bits 32 / 33 (helios_nvrm_escape.h) */
+      if ((ops & (1ull << 32)) && lib->win_scanout_present_fenced != NULL &&
+          debug_get_bool_option("NVK_RM_FENCE_KMD", true))
+         caps |= HELIOS_ICD_CAP_SCANOUT_FENCE_KMD;
+      if (ops & (1ull << 33))
+         caps |= HELIOS_ICD_CAP_PRESENT_FENCE_KMD;
+   }
 
    struct helios_icd_api api = {
       .version = HELIOS_ICD_INTERFACE_VERSION,
@@ -234,6 +317,10 @@ helios_icd_interface_v2(uint32_t version, struct helios_icd_api *out)
       .scanout_present = helios_scanout_present,
       .scanout_release = helios_scanout_release,
       .producer = NULL,
+      .queue_rm_fence = helios_queue_rm_fence,
+      .rm_fence_wait = helios_rm_fence_wait,
+      .rm_fence_close = helios_rm_fence_close,
+      .scanout_present_fenced = helios_scanout_present_fenced,
    };
    memcpy(out, &api, cap);
    return VK_SUCCESS;
