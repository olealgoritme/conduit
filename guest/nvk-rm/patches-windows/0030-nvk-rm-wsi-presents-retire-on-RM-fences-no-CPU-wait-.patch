@@ -100,6 +100,20 @@ struct nvkmd_rm_lib {
    int (*win_foreign_caps)(uint32_t *caps_flags);
    int (*win_import_rm)(const struct nvrm_crm_foreign_import *in,
                         uint32_t *resource_id, uint32_t *host_errno);
+   /* RM fences (KMD 22.22.311+, guest/windows/docs/rm-fence-marker.md):
+    * nvidia-drm semaphore-surface fences on the host render node, waits on
+    * them through the KMD, and SCANOUT_PRESENT that takes one over.
