diff --git a/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_rmfence.c b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_rmfence.c
new file mode 100644
index 0000000..2e28402
--- /dev/null
+++ b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_rmfence.c
@@ -0,0 +1,582 @@
+/*
+ * Copyright © 2026 Conduit contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * RM fences for presents on Windows (guest/windows/docs/rm-fence-marker.md,
+ * dxvk-on-nvk S4).  See nvkmd_rm.h.
+ *
+ * Before this, every present waited on the CPU for the frame's GPU work and
+ * then flipped.  Now a present signals a "present timeline" on its queue,
+ * after the frame's work, and turns the value into an RM fence: nvidia-drm's
+ * semaphore-surface fence on the host render node, a backend handle that
+ * fires one host EventReady when the GPU writes the value.  The fence goes
+ * with the flip to the KMD (SCANOUT_PRESENT with the RM fence flag, KMD
+ * capability bit 32), which sends the flip when it fires.  With a KMD that
+ * cannot, a flip thread of the device waits on the fence (EVENT_REGISTER, no
+ * polling) and sends a plain SCANOUT_PRESENT.  Either way the presenting
+ * thread returns at once.
+ *
+ * The timelines live in one 4 KiB RM system-memory allocation (an
+ * NV_SEMAPHORE_SURFACE wants memory RM can map itself: OS-descriptor memory
+ * is refused with NV_ERR_NOT_SUPPORTED), one surface entry (32 bytes on GB20x,
+ * the 64-bit value at offset 0) per queue that presents, so the values on a
+ * timeline only grow.  Each entry has its own nvidia-drm fence context.  A
+ * context binds its channel to the surface before its first release into it
+ * (nvkmd_rm_ctx.c), so RM checks the waiters on that channel's non-stall
+ * interrupts.
+ *
+ *   NVK_RM_FENCE=0      no RM fences: CPU wait before every flip (S3)
+ *   NVK_RM_FENCE_KMD=0  never hand fences to the KMD: the flip thread waits
+ */
+
+#include "nvkmd_rm.h"
+
+#include "c11/threads.h"
+#include "util/log.h"
+#include "util/os_time.h"
+#include "util/u_atomic.h"
+#include "util/u_debug.h"
+#include "vk_log.h"
+
+#include <errno.h>
+#include <inttypes.h>
+#include <stdio.h>
+#include <string.h>
+
+#define NVKMD_RM_RMFENCE_MEM_SIZE   4096u
+#define NVKMD_RM_RMFENCE_TIMELINES  8u
+#define NVKMD_RM_RMFENCE_TIMEOUT_MS 5000u /* nvidia-drm's own cap */
+#define NVKMD_RM_FLIPQ_DEPTH        8u    /* as the KMD's per-source queue */
+/* QueryCaps.supported_ops bit 32 (helios_nvrm_escape.h) */
+#define NVKMD_RM_CAP_SCANOUT_FENCE  (1ull << 32)
+/* QueryCaps.device_features: NVGPU_CFG_DRM_FENCES */
+#define NVKMD_RM_CFG_DRM_FENCES     (1u << 11)
+
+struct nvkmd_rm_rmfence_tl {
+   const void *key;          /* the queue */
+   struct nvkmd_rm_sync sync;
+   uint32_t fence_ctx;       /* GEM handle of the fence context */
+   uint64_t next_value;
+};
+
+struct nvkmd_rm_flip_item {
+   struct nvkmd_mem *mem;    /* a reference */
+   uint32_t width, height, stride, offset, fourcc;
+   uint64_t modifier;
+   int fence;
+};
+
+struct nvkmd_rm_rmfence {
+   struct nvkmd_mem *mem;
+   uint32_t h_semsurf;
+   uint64_t entry_size_B;
+   uint32_t tl_count;        /* under rmfence_mutex */
+   struct nvkmd_rm_rmfence_tl tl[NVKMD_RM_RMFENCE_TIMELINES];
+
+   /* The KMD takes fences with SCANOUT_PRESENT */
+   bool kmd_flip;
+
+   uint64_t fences, kmd_flips, kmd_queue_full, thread_flips;
+   uint64_t fence_timeouts, cpu_flips;
+
+   /* Flip thread, for a KMD without the capability */
+   mtx_t q_mutex;
+   cnd_t q_cond;
+   thrd_t thread;
+   bool thread_started, thread_failed, stop;
+   bool busy;
+   uint32_t q_head, q_count;
+   struct nvkmd_rm_flip_item q[NVKMD_RM_FLIPQ_DEPTH];
+};
+
+static void
+rmfence_free(struct nvkmd_rm_dev *dev, struct nvkmd_rm_rmfence *rf)
+{
+   if (rf->h_semsurf != 0)
+      dev->lib->free(dev->client, dev->h_subdevice, rf->h_semsurf);
+   if (rf->mem != NULL)
+      nvkmd_mem_unref(rf->mem);
+   FREE(rf);
+}
+
+static struct nvkmd_rm_rmfence *
+rmfence_init(struct nvkmd_rm_dev *dev, struct vk_object_base *log_obj)
+{
+   const struct nvkmd_rm_lib *lib = dev->lib;
+
+   if (!debug_get_bool_option("NVK_RM_FENCE", true))
+      return NULL;
+   if (lib->win_caps == NULL || lib->win_semsurf_ctx_create == NULL ||
+       lib->win_semsurf_fence_create == NULL || lib->win_fence_wait == NULL ||
+       lib->win_close_device == NULL) {
+      mesa_logi("NVK: librmclient has no RM fences, CPU waits before flips");
+      return NULL;
+   }
+
+   uint64_t ops = 0;
+   uint32_t features = 0;
+   if (lib->win_caps(&ops, &features) != 0 ||
+       !(features & NVKMD_RM_CFG_DRM_FENCES)) {
+      mesa_logi("NVK: the host has no DRM fences (features 0x%x), CPU waits "
+                "before flips", features);
+      return NULL;
+   }
+
+   int drm_fd;
+   if (nvkmd_rm_win_drm_fd(dev, log_obj, &drm_fd) != VK_SUCCESS)
+      return NULL;
+
+   NV2080_CTRL_FB_GET_SEMAPHORE_SURFACE_LAYOUT_PARAMS layout;
+   memset(&layout, 0, sizeof(layout));
+   int ret = lib->control(dev->client, dev->h_subdevice,
+                          NV2080_CTRL_CMD_FB_GET_SEMAPHORE_SURFACE_LAYOUT,
+                          &layout, sizeof(layout));
+   if (ret != 0 || layout.size < 8 || layout.size > 256 ||
+       !(layout.caps &
+         NV2080_CTRL_FB_GET_SEMAPHORE_SURFACE_LAYOUT_CAPS_64BIT_SEMAPHORES_SUPPORTED)) {
+      mesa_logw("NVK: no 64-bit semaphore surfaces (%d, entry %" PRIu64
+                " B, caps 0x%x), CPU waits before flips", ret,
+                (uint64_t)layout.size, layout.caps);
+      return NULL;
+   }
+
+   struct nvkmd_rm_rmfence *rf = CALLOC_STRUCT(nvkmd_rm_rmfence);
+   if (rf == NULL)
+      return NULL;
+   rf->entry_size_B = layout.size;
+
+   VkResult result =
+      nvkmd_dev_alloc_mapped_mem(&dev->base, log_obj,
+                                 NVKMD_RM_RMFENCE_MEM_SIZE, 0,
+                                 NVKMD_MEM_GART | NVKMD_RM_MEM_RM_SYSMEM,
+                                 NVKMD_MEM_MAP_RDWR, &rf->mem);
+   if (result != VK_SUCCESS)
+      goto fail;
+   memset(rf->mem->map, 0, NVKMD_RM_RMFENCE_MEM_SIZE);
+
+   NV_SEMAPHORE_SURFACE_ALLOC_PARAMETERS sa = {
+      .hSemaphoreMem = nvkmd_rm_mem(rf->mem)->h_memory,
+   };
+   ret = lib->alloc(dev->client, dev->h_subdevice, &rf->h_semsurf,
+                    NV_SEMAPHORE_SURFACE, &sa, sizeof(sa));
+   if (ret != 0) {
+      rf->h_semsurf = 0;
+      mesa_logw("NVK: NV_SEMAPHORE_SURFACE: %s, CPU waits before flips",
+                lib->status_name(ret));
+      goto fail;
+   }
+
+   rf->kmd_flip = (ops & NVKMD_RM_CAP_SCANOUT_FENCE) != 0 &&
+                  lib->win_scanout_present_fenced != NULL &&
+                  debug_get_bool_option("NVK_RM_FENCE_KMD", true);
+
+   if (mtx_init(&rf->q_mutex, mtx_plain) != thrd_success)
+      goto fail;
+   if (cnd_init(&rf->q_cond) != thrd_success) {
+      mtx_destroy(&rf->q_mutex);
+      goto fail;
+   }
+
+   mesa_logi("NVK: presents retire on RM fences (%s; semaphore surface 0x%x, "
+             "entry %" PRIu64 " B)", rf->kmd_flip ?
+             "the KMD flips when they fire" : "a flip thread waits for them",
+             rf->h_semsurf, rf->entry_size_B);
+   return rf;
+
+fail:
+   rmfence_free(dev, rf);
+   return NULL;
+}
+
+static struct nvkmd_rm_rmfence *
+rmfence_get(struct nvkmd_rm_dev *dev, struct vk_object_base *log_obj)
+{
+   simple_mtx_lock(&dev->rmfence_mutex);
+   if (dev->rmfence == NULL && !dev->rmfence_failed) {
+      dev->rmfence = rmfence_init(dev, log_obj);
+      dev->rmfence_failed = dev->rmfence == NULL;
+   }
+   struct nvkmd_rm_rmfence *rf = dev->rmfence;
+   simple_mtx_unlock(&dev->rmfence_mutex);
+   return rf;
+}
+
+/* The timeline of `key` (a queue), made on first use; under rmfence_mutex */
+static struct nvkmd_rm_rmfence_tl *
+rmfence_tl_locked(struct nvkmd_rm_dev *dev, struct nvkmd_rm_rmfence *rf,
+                  const void *key)
+{
+   for (uint32_t i = 0; i < rf->tl_count; i++) {
+      if (rf->tl[i].key == key)
+         return &rf->tl[i];
+   }
+
+   const uint32_t index = rf->tl_count;
+   if (index >= NVKMD_RM_RMFENCE_TIMELINES ||
+       (index + 1) * rf->entry_size_B > NVKMD_RM_RMFENCE_MEM_SIZE)
+      return NULL;
+
+   uint32_t ctx = 0;
+   int ret = dev->lib->win_semsurf_ctx_create(dev->drm_fd,
+                                              dev->lib->root(dev->client),
+                                              rf->h_semsurf,
+                                              NVKMD_RM_RMFENCE_MEM_SIZE,
+                                              index, &ctx);
+   if (ret != 0 || ctx == 0) {
+      mesa_logw("NVK: SEMSURF_FENCE_CTX_CREATE (entry %u): %d (%s)", index,
+                ret, ret < 0 ? strerror(-ret) : "?");
+      return NULL;
+   }
+
+   struct nvkmd_rm_pdev *pdev = nvkmd_rm_pdev(dev->base.pdev);
+   struct nvkmd_rm_rmfence_tl *tl = &rf->tl[index];
+   const uint64_t offset_B = index * rf->entry_size_B;
+   memset(tl, 0, sizeof(*tl));
+   tl->key = key;
+   tl->fence_ctx = ctx;
+   tl->sync.base.type = &pdev->sync_type;
+   tl->sync.base.flags = VK_SYNC_IS_TIMELINE;
+   tl->sync.dev = dev;
+   tl->sync.slot = UINT32_MAX;
+   tl->sync.value = (volatile uint64_t *)((uint8_t *)rf->mem->map + offset_B);
+   tl->sync.gpu_va = rf->mem->va->addr + offset_B;
+   tl->sync.h_semsurf = rf->h_semsurf;
+   rf->tl_count = index + 1;
+
+   if (dev->base.pdev->debug_flags & NVK_DEBUG_VM) {
+      fprintf(stderr, "NVK: present timeline %u for queue %p: semaphore "
+              "surface 0x%x entry %u (GPU VA 0x%" PRIx64 "), fence context "
+              "%u\n", index, key, rf->h_semsurf, index, tl->sync.gpu_va, ctx);
+   }
+   return tl;
+}
+
+struct vk_sync *
+nvkmd_rm_rmfence_sync(struct nvkmd_dev *_dev, struct vk_object_base *log_obj,
+                      const void *queue_key, uint64_t *value_out)
+{
+   struct nvkmd_rm_dev *dev = nvkmd_rm_dev(_dev);
+   struct nvkmd_rm_rmfence *rf = rmfence_get(dev, log_obj);
+   if (rf == NULL)
+      return NULL;
+
+   simple_mtx_lock(&dev->rmfence_mutex);
+   struct nvkmd_rm_rmfence_tl *tl = rmfence_tl_locked(dev, rf, queue_key);
+   struct vk_sync *sync = NULL;
+   if (tl != NULL) {
+      *value_out = ++tl->next_value;
+      sync = &tl->sync.base;
+   }
+   simple_mtx_unlock(&dev->rmfence_mutex);
+   return sync;
+}
+
+VkResult
+nvkmd_rm_rmfence_create(struct nvkmd_dev *_dev, struct vk_object_base *log_obj,
+                        struct vk_sync *sync, uint64_t value, int *fence_out)
+{
+   struct nvkmd_rm_dev *dev = nvkmd_rm_dev(_dev);
+   struct nvkmd_rm_rmfence *rf = dev->rmfence;
+
+   *fence_out = -1;
+   if (rf == NULL)
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+
+   uint32_t ctx = 0;
+   simple_mtx_lock(&dev->rmfence_mutex);
+   for (uint32_t i = 0; i < rf->tl_count; i++) {
+      if (&rf->tl[i].sync.base == sync)
+         ctx = rf->tl[i].fence_ctx;
+   }
+   simple_mtx_unlock(&dev->rmfence_mutex);
+   if (ctx == 0)
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+
+   int fence = -1;
+   int ret = dev->lib->win_semsurf_fence_create(dev->drm_fd, ctx, value,
+                                                NVKMD_RM_RMFENCE_TIMEOUT_MS,
+                                                &fence);
+   if (ret != 0 || fence <= 0) {
+      return vk_errorf(log_obj, VK_ERROR_OUT_OF_HOST_MEMORY,
+                       "SEMSURF_FENCE_CREATE(%" PRIu64 "): %d (%s)", value,
+                       ret, ret < 0 ? strerror(-ret) : "?");
+   }
+   p_atomic_inc(&rf->fences);
+   *fence_out = fence;
+   return VK_SUCCESS;
+}
+
+VkResult
+nvkmd_rm_rmfence_wait(struct nvkmd_dev *_dev, int fence, uint64_t timeout_ns)
+{
+   struct nvkmd_rm_dev *dev = nvkmd_rm_dev(_dev);
+
+   if (fence <= 0 || dev->lib->win_fence_wait == NULL)
+      return VK_ERROR_UNKNOWN;
+   uint32_t ms = UINT32_MAX;
+   if (timeout_ns != UINT64_MAX)
+      ms = (uint32_t)MIN2(DIV_ROUND_UP(timeout_ns, 1000000), UINT32_MAX - 1);
+   const int ret = dev->lib->win_fence_wait(fence, ms);
+   return ret == 1 ? VK_SUCCESS : ret == 0 ? VK_TIMEOUT : VK_ERROR_UNKNOWN;
+}
+
+void
+nvkmd_rm_rmfence_close(struct nvkmd_dev *_dev, int fence)
+{
+   struct nvkmd_rm_dev *dev = nvkmd_rm_dev(_dev);
+
+   if (fence > 0 && dev->lib->win_close_device != NULL)
+      dev->lib->win_close_device(fence);
+}
+
+bool
+nvkmd_rm_rmfence_kmd_flip(struct nvkmd_dev *_dev)
+{
+   struct nvkmd_rm_dev *dev = nvkmd_rm_dev(_dev);
+   return dev->rmfence != NULL && dev->rmfence->kmd_flip;
+}
+
+/* SCANOUT_PRESENT with the fence (the KMD takes it on success), the source
+ * set as for a plain present.  -EAGAIN when the KMD's queue is full; any error
+ * leaves the fence ours.
+ */
+static int
+kmd_source_present_fenced(struct nvkmd_rm_dev *dev,
+                          const struct nvrm_crm_scanout_flip *flip, int fence)
+{
+   const struct nvkmd_rm_lib *lib = dev->lib;
+   int ret;
+
+   simple_mtx_lock(&dev->drm_mutex);
+   const bool same_layout = dev->source_live &&
+      dev->source.handle == flip->owner_handle &&
+      dev->source.width == flip->width &&
+      dev->source.height == flip->height &&
+      dev->source.stride == flip->stride &&
+      dev->source.offset == flip->offset &&
+      dev->source.fourcc == flip->fourcc &&
+      dev->source.modifier == flip->modifier;
+   if (!same_layout) {
+      ret = nvkmd_rm_win_source_set_locked(dev, flip);
+      if (ret != 0)
+         goto out;
+   }
+
+   ret = lib->win_scanout_present_fenced(flip->owner_handle, flip->host_handle,
+                                         fence, NULL);
+   if (ret == -ENOENT) {
+      /* The source lapsed (or the KMD reset): register it again */
+      dev->source_live = false;
+      ret = nvkmd_rm_win_source_set_locked(dev, flip);
+      if (ret == 0)
+         ret = lib->win_scanout_present_fenced(flip->owner_handle,
+                                               flip->host_handle, fence, NULL);
+   }
+
+out:
+   simple_mtx_unlock(&dev->drm_mutex);
+   return ret;
+}
+
+static int
+flip_thread(void *arg)
+{
+   struct nvkmd_rm_dev *dev = arg;
+   struct nvkmd_rm_rmfence *rf = dev->rmfence;
+
+   mtx_lock(&rf->q_mutex);
+   while (true) {
+      while (rf->q_count == 0 && !rf->stop)
+         cnd_wait(&rf->q_cond, &rf->q_mutex);
+      if (rf->q_count == 0)
+         break;
+
+      struct nvkmd_rm_flip_item it = rf->q[rf->q_head];
+      rf->q_head = (rf->q_head + 1) % NVKMD_RM_FLIPQ_DEPTH;
+      rf->q_count--;
+      rf->busy = true;
+      cnd_broadcast(&rf->q_cond);
+      mtx_unlock(&rf->q_mutex);
+
+      /* The host fires every fence within 5 s (with an error then); the
+       * extra second only covers a lost wake.
+       */
+      const int fired =
+         dev->lib->win_fence_wait(it.fence, NVKMD_RM_RMFENCE_TIMEOUT_MS + 1000);
+      if (fired != 1) {
+         const uint64_t n = p_atomic_inc_return(&rf->fence_timeouts);
+         if (n <= 4 || n % 600 == 0)
+            mesa_logw("NVK: present fence %d did not fire (%d), flipping "
+                      "anyway (%" PRIu64 " so far)", it.fence, fired, n);
+      }
+      dev->lib->win_close_device(it.fence);
+      nvkmd_rm_mem_scanout_flip(it.mem, NULL, it.width, it.height, it.stride,
+                                it.offset, it.fourcc, it.modifier);
+      p_atomic_inc(&rf->thread_flips);
+      nvkmd_mem_unref(it.mem);
+
+      mtx_lock(&rf->q_mutex);
+      rf->busy = false;
+      cnd_broadcast(&rf->q_cond);
+   }
+   mtx_unlock(&rf->q_mutex);
+   return 0;
+}
+
+/* Queues a flip for the flip thread (started on first use).  False if there
+ * is no thread; the caller then waits itself.
+ */
+static bool
+flip_thread_queue(struct nvkmd_rm_dev *dev, struct nvkmd_rm_rmfence *rf,
+                  struct nvkmd_mem *mem, const struct nvrm_crm_scanout_flip *f,
+                  int fence)
+{
+   mtx_lock(&rf->q_mutex);
+   if (!rf->thread_started && !rf->thread_failed) {
+      if (thrd_create(&rf->thread, flip_thread, dev) == thrd_success) {
+         rf->thread_started = true;
+      } else {
+         rf->thread_failed = true;
+         mesa_logw("NVK: no flip thread, CPU waits before flips");
+      }
+   }
+   if (!rf->thread_started || rf->stop) {
+      mtx_unlock(&rf->q_mutex);
+      return false;
+   }
+
+   /* Back-pressure: at most NVKMD_RM_FLIPQ_DEPTH frames wait */
+   while (rf->q_count == NVKMD_RM_FLIPQ_DEPTH)
+      cnd_wait(&rf->q_cond, &rf->q_mutex);
+
+   nvkmd_mem_ref(mem);
+   rf->q[(rf->q_head + rf->q_count) % NVKMD_RM_FLIPQ_DEPTH] =
+      (struct nvkmd_rm_flip_item) {
+         .mem = mem,
+         .width = f->width,
+         .height = f->height,
+         .stride = f->stride,
+         .offset = f->offset,
+         .fourcc = f->fourcc,
+         .modifier = f->modifier,
+         .fence = fence,
+      };
+   rf->q_count++;
+   cnd_broadcast(&rf->q_cond);
+   mtx_unlock(&rf->q_mutex);
+   return true;
+}
+
+void
+nvkmd_rm_rmfence_drain(struct nvkmd_rm_dev *dev)
+{
+   struct nvkmd_rm_rmfence *rf = dev->rmfence;
+   if (rf == NULL || !rf->thread_started)
+      return;
+
+   mtx_lock(&rf->q_mutex);
+   while (rf->q_count != 0 || rf->busy)
+      cnd_wait(&rf->q_cond, &rf->q_mutex);
+   mtx_unlock(&rf->q_mutex);
+}
+
+VkResult
+nvkmd_rm_mem_scanout_flip_fenced(struct nvkmd_mem *_mem,
+                                 struct vk_object_base *log_obj,
+                                 uint32_t width, uint32_t height,
+                                 uint32_t stride, uint32_t offset,
+                                 uint32_t fourcc, uint64_t modifier,
+                                 int fence)
+{
+   struct nvkmd_rm_mem *mem = nvkmd_rm_mem(_mem);
+   struct nvkmd_rm_dev *dev = nvkmd_rm_dev(_mem->dev);
+   struct nvkmd_rm_rmfence *rf = dev->rmfence;
+
+   VkResult result = nvkmd_rm_mem_export_scanout(_mem, log_obj);
+   if (result != VK_SUCCESS || rf == NULL) {
+      /* Nothing will wait on it: the work is done before the caller learns */
+      nvkmd_rm_rmfence_wait(&dev->base, fence, UINT64_MAX);
+      nvkmd_rm_rmfence_close(&dev->base, fence);
+      return result != VK_SUCCESS ? result : VK_ERROR_FEATURE_NOT_PRESENT;
+   }
+
+   const struct nvrm_crm_scanout_flip flip = {
+      .scanout = 0,
+      .owner_handle = (uint32_t)dev->drm_fd,
+      .host_handle = mem->gem_handle,
+      .width = width,
+      .height = height,
+      .stride = stride,
+      .offset = offset,
+      .fourcc = fourcc,
+      .modifier = modifier,
+   };
+
+   if (rf->kmd_flip) {
+      int ret = kmd_source_present_fenced(dev, &flip, fence);
+      /* QUEUE_FULL: eight frames already wait in the KMD.  Ours fires after
+       * theirs (one timeline), so once it has fired they are all ready and
+       * the next try is taken (and coalesced).  A plain flip here could
+       * overtake them.
+       */
+      for (uint32_t i = 0; ret == -EAGAIN && i < 8; i++) {
+         p_atomic_inc(&rf->kmd_queue_full);
+         dev->lib->win_fence_wait(fence, NVKMD_RM_RMFENCE_TIMEOUT_MS);
+         if (i > 0)
+            os_time_sleep(1000);
+         ret = kmd_source_present_fenced(dev, &flip, fence);
+      }
+      if (ret == 0) {
+         /* The KMD owns the fence now and flips when it fires */
+         p_atomic_inc(&dev->flips_ok);
+         p_atomic_inc(&rf->kmd_flips);
+         return VK_SUCCESS;
+      }
+      if (ret != -EAGAIN) {
+         mesa_logw("NVK: the KMD refused a fenced present (%d, %s); the flip "
+                   "thread waits from now on", ret,
+                   ret < 0 ? strerror(-ret) : "?");
+         rf->kmd_flip = false;
+      }
+   }
+
+   if (flip_thread_queue(dev, rf, _mem, &flip, fence))
+      return VK_SUCCESS;
+
+   /* No thread: the S3 behaviour, a CPU wait (on our own fence) */
+   dev->lib->win_fence_wait(fence, NVKMD_RM_RMFENCE_TIMEOUT_MS + 1000);
+   dev->lib->win_close_device(fence);
+   p_atomic_inc(&rf->cpu_flips);
+   return nvkmd_rm_mem_scanout_flip(_mem, log_obj, width, height, stride,
+                                    offset, fourcc, modifier);
+}
+
+void
+nvkmd_rm_rmfence_finish(struct nvkmd_rm_dev *dev)
+{
+   struct nvkmd_rm_rmfence *rf = dev->rmfence;
+   if (rf == NULL)
+      return;
+
+   if (rf->thread_started) {
+      mtx_lock(&rf->q_mutex);
+      rf->stop = true;
+      cnd_broadcast(&rf->q_cond);
+      mtx_unlock(&rf->q_mutex);
+      thrd_join(rf->thread, NULL);
+   }
+   mtx_destroy(&rf->q_mutex);
+   cnd_destroy(&rf->q_cond);
+
+   if (rf->fences != 0) {
+      mesa_logi("NVK: %" PRIu64 " present fences: %" PRIu64 " flipped by the "
+                "KMD (queue full %" PRIu64 "x), %" PRIu64 " by the flip thread "
+                "(%" PRIu64 " did not fire), %" PRIu64 " after a CPU wait",
+                rf->fences, rf->kmd_flips, rf->kmd_queue_full,
+                rf->thread_flips, rf->fence_timeouts, rf->cpu_flips);
+   }
+
+   /* The fence contexts are GEM handles of the render node: they go with it */
+   dev->rmfence = NULL;
+   rmfence_free(dev, rf);
+}
