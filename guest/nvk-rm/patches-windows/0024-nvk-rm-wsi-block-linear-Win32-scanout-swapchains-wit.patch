          if (dev->base.pdev->debug_flags & NVK_DEBUG_VM)
@@ -350,7 +382,7 @@ nvkmd_rm_mem_scanout_flip(struct nvkmd_mem *_mem,
    struct nvkmd_rm_mem *mem = nvkmd_rm_mem(_mem);
    struct nvkmd_rm_dev *dev = nvkmd_rm_dev(_mem->dev);
 
-   VkResult result = nvkmd_rm_mem_export_scanout(_mem, log_obj);
+   VkResult result = nvkmd_rm_mem_export_scanout(_mem, log_obj, modifier);
    if (result != VK_SUCCESS)
       return result;
 
@@ -366,11 +398,20 @@ nvkmd_rm_mem_scanout_flip(struct nvkmd_mem *_mem,
       .modifier = modifier,
       .seq = p_atomic_inc_return(&dev->flip_seq),
    };
-   int ret = kmd_source_present(dev, &flip);
+   bool layout_rejected = false;
+   int ret = kmd_source_present(dev, &flip, &layout_rejected);
    if (ret == -ENOSYS)
       ret = dev->lib->win_scanout_flip(&flip);
    if (ret == 0) {
       p_atomic_inc(&dev->flips_ok);
+   } else if (layout_rejected && modifier != DRM_FORMAT_MOD_LINEAR) {
+      /* The KMD refused the layout, and LINEAR is the one it surely takes:
+       * the WSI goes linear (wsi_device::win32.scanout_flip).
+       */
+      p_atomic_inc(&dev->flips_failed);
+      result = vk_errorf(log_obj, VK_ERROR_FORMAT_NOT_SUPPORTED,
+                         "SCANOUT_SET of modifier 0x%016" PRIx64 ": %d (%s)",
+                         modifier, ret, strerror(-ret));
    } else {
       p_atomic_inc(&dev->flips_failed);
       result = vk_errorf(log_obj, VK_ERROR_SURFACE_LOST_KHR,
diff --git a/src/vulkan/wsi/wsi_common.c b/src/vulkan/wsi/wsi_common.c
