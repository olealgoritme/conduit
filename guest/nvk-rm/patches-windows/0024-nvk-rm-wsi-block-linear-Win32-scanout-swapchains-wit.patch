- * images are linear images in dedicated device memory that the driver makes
- * presentable once (scanout_export) and names in every present
- * (scanout_flip).  Nothing is copied to a window.
+ * images live in dedicated device memory that the driver makes presentable
+ * once (scanout_export) and names in every present (scanout_flip).  Nothing
+ * is copied to a window.  They have the driver's own tiling where a DRM
+ * format modifier names it (NVIDIA block-linear; the display reads it as
+ * such), else they are linear.
  */
 
 #define WSI_DRM_FORMAT_XRGB8888 0x34325258u /* 'XR24' */
@@ -624,7 +629,10 @@ wsi_win32_create_scanout_image_mem(const struct wsi_swapchain *chain,
    wsi->GetImageMemoryRequirements(chain->device, image->image, &reqs);
 
    VkImageSubresource subresource = {};
-   subresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+   subresource.aspectMask = info->create.tiling ==
+                            VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT ?
+                            VK_IMAGE_ASPECT_MEMORY_PLANE_0_BIT_EXT :
+                            VK_IMAGE_ASPECT_COLOR_BIT;
    VkSubresourceLayout layout;
    wsi->GetImageSubresourceLayout(chain->device, image->image,
                                   &subresource, &layout);
@@ -649,8 +657,130 @@ wsi_win32_create_scanout_image_mem(const struct wsi_swapchain *chain,
    image->sizes[0] = reqs.size;
    image->row_pitches[0] = layout.rowPitch;
    image->offsets[0] = layout.offset;
+   /* The driver names the modifier the image ended up with
+    * (wsi_image::drm_modifier is not there on Windows)
+    */
+   struct wsi_win32_image *win32_image =
+      container_of(image, struct wsi_win32_image, base);
+   win32_image->scanout_modifier = 0; /* DRM_FORMAT_MOD_LINEAR */
+   return wsi->win32.scanout_export(chain->device, image->image,
+                                    image->memory,
+                                    &win32_image->scanout_modifier);
+}
+
+/* fourcc_mod_code(NVIDIA, ...) with the block-linear 2D bit (drm_fourcc.h's
+ * DRM_FORMAT_MOD_NVIDIA_BLOCK_LINEAR_2D) and its compression field.
+ */
+#define WSI_MOD_VENDOR_NVIDIA     0x03ull
+#define WSI_MOD_NVIDIA_BL_2D      0x10ull
+#define WSI_MOD_NVIDIA_COMPRESSION(m) (((m) >> 23) & 0x7)
+
+static bool
+wsi_win32_scanout_modifier_ok(uint64_t mod)
+{
+   return (mod >> 56) == WSI_MOD_VENDOR_NVIDIA &&
+          (mod & WSI_MOD_NVIDIA_BL_2D) &&
+          WSI_MOD_NVIDIA_COMPRESSION(mod) == 0;
+}
+
+/* The driver's uncompressed block-linear modifiers for the swapchain's
+ * format and usage (filtered as wsi_common_drm.c does), for the driver to
+ * pick from.  None: *count_out = 0.
+ */
+static void
+wsi_win32_scanout_modifiers(const struct wsi_swapchain *chain,
+                            const VkSwapchainCreateInfoKHR *pCreateInfo,
+                            const struct wsi_image_info *info,
+                            uint32_t *count_out, uint64_t **mods_out)
+{
+   const struct wsi_device *wsi = chain->wsi;
+
+   *count_out = 0;
+   *mods_out = NULL;
+   if (wsi->GetPhysicalDeviceFormatProperties2 == NULL ||
+       wsi->GetPhysicalDeviceImageFormatProperties2 == NULL)
+      return;
+
+   VkDrmFormatModifierPropertiesListEXT list = {};
+   list.sType = VK_STRUCTURE_TYPE_DRM_FORMAT_MODIFIER_PROPERTIES_LIST_EXT;
+   VkFormatProperties2 props = {};
+   props.sType = VK_STRUCTURE_TYPE_FORMAT_PROPERTIES_2;
+   props.pNext = &list;
+   wsi->GetPhysicalDeviceFormatProperties2(wsi->pdevice,
+                                           pCreateInfo->imageFormat, &props);
+   if (list.drmFormatModifierCount == 0)
+      return;
+
+   VkDrmFormatModifierPropertiesEXT *mod_props =
+      (VkDrmFormatModifierPropertiesEXT *)
+      vk_alloc(&chain->alloc, sizeof(*mod_props) * list.drmFormatModifierCount,
+               8, VK_SYSTEM_ALLOCATION_SCOPE_COMMAND);
+   uint64_t *mods = (uint64_t *)
+      vk_alloc(&chain->alloc, sizeof(*mods) * list.drmFormatModifierCount,
+               8, VK_SYSTEM_ALLOCATION_SCOPE_OBJECT);
+   if (mod_props == NULL || mods == NULL) {
+      vk_free(&chain->alloc, mod_props);
+      vk_free(&chain->alloc, mods);
+      return;
+   }
+   list.pDrmFormatModifierProperties = mod_props;
+   wsi->GetPhysicalDeviceFormatProperties2(wsi->pdevice,
+                                           pCreateInfo->imageFormat, &props);
+
+   const VkImageUsageFlags2KHR usage = vk_swapchain_usage_flags(pCreateInfo);
+   uint32_t n = 0;
+   for (uint32_t i = 0; i < list.drmFormatModifierCount; i++) {
+      const uint64_t mod = mod_props[i].drmFormatModifier;
+      if (!wsi_win32_scanout_modifier_ok(mod) ||
+          mod_props[i].drmFormatModifierPlaneCount != 1)
+         continue;
+
+      VkPhysicalDeviceImageDrmFormatModifierInfoEXT mod_info = {};
+      mod_info.sType =
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_IMAGE_DRM_FORMAT_MODIFIER_INFO_EXT;
+      mod_info.drmFormatModifier = mod;
+      mod_info.sharingMode = pCreateInfo->imageSharingMode;
+      mod_info.queueFamilyIndexCount = pCreateInfo->queueFamilyIndexCount;
+      mod_info.pQueueFamilyIndices = pCreateInfo->pQueueFamilyIndices;
+
+      VkImageUsageFlags2CreateInfoKHR usage2 = {};
+      usage2.sType = VK_STRUCTURE_TYPE_IMAGE_USAGE_FLAGS_2_CREATE_INFO_KHR;
+      usage2.usage = usage;
+
+      VkPhysicalDeviceImageFormatInfo2 format_info = {};
+      format_info.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_IMAGE_FORMAT_INFO_2;
+      format_info.format = pCreateInfo->imageFormat;
+      format_info.type = VK_IMAGE_TYPE_2D;
+      format_info.tiling = VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT;
+      format_info.usage = (VkImageUsageFlags)usage;
+      format_info.flags = info->create.flags;
+      __vk_append_struct(&format_info, &usage2);
+      __vk_append_struct(&format_info, &mod_info);
+
+      VkImageFormatListCreateInfo format_list;
+      if (info->create.flags & VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT) {
+         format_list = info->format_list;
+         format_list.pNext = NULL;
+         __vk_append_struct(&format_info, &format_list);
+      }
 
-   return wsi->win32.scanout_export(chain->device, image->memory);
+      VkImageFormatProperties2 format_props = {};
+      format_props.sType = VK_STRUCTURE_TYPE_IMAGE_FORMAT_PROPERTIES_2;
+      VkResult result =
+         wsi->GetPhysicalDeviceImageFormatProperties2(wsi->pdevice,
+                                                      &format_info,
+                                                      &format_props);
+      if (result == VK_SUCCESS &&
+          pCreateInfo->imageExtent.width <=
+             format_props.imageFormatProperties.maxExtent.width &&
+          pCreateInfo->imageExtent.height <=
+             format_props.imageFormatProperties.maxExtent.height)
+         mods[n++] = mod;
+   }
+   vk_free(&chain->alloc, mod_props);
+
+   *count_out = n;
+   *mods_out = mods;
 }
 
 VkResult
@@ -662,11 +792,33 @@ wsi_win32_scanout_configure_image(const struct wsi_swapchain *chain,
    if (result != VK_SUCCESS)
       return result;
 
-   /* What the display takes without knowing the driver's tilings */
-   info->create.tiling = VK_IMAGE_TILING_LINEAR;
    info->select_image_memory_type = wsi_select_device_memory_type;
    info->create_mem = wsi_win32_create_scanout_image_mem;
 
+   /* The driver's own tiling, named by a DRM format modifier the display
+    * understands (NVIDIA block-linear): the image is rendered where it is
+    * shown, with no linear copy.  LINEAR when the driver asks for it
+    * (win32.scanout_linear) or has no such modifier for the format.
+    */
+   uint32_t mod_count = 0;
+   uint64_t *mods = NULL;
+   if (!chain->wsi->win32.scanout_linear)
+      wsi_win32_scanout_modifiers(chain, pCreateInfo, info, &mod_count, &mods);
+
+   if (mod_count > 0) {
+      info->create.tiling = VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT;
