+/* Does the layout the memory was allocated with (what NVKMS is told on
+ * import) match the modifier it is presented as?  Block-linear 2D: a
+ * generic kind and the same block height (log2 GOBs, tile_mode bits 4..7).
+ */
+static bool
+layout_matches_modifier(const struct nvkmd_rm_mem *mem, uint64_t modifier)
+{
+   if (modifier == DRM_FORMAT_MOD_LINEAR)
+      return mem->pte_kind == 0;
+
+   if (!fourcc_mod_is_vendor(modifier, NVIDIA) || !(modifier & 0x10))
+      return false;
+
+   const uint32_t h = modifier & 0xf;
+   const uint32_t kind = (modifier >> 12) & 0xff;
+   return mem->pte_kind != 0 && kind == mem->pte_kind &&
+          ((mem->tile_mode >> 4) & 0xf) == h &&
+          ((mem->tile_mode >> 8) & 0xf) == 0;
+}
+
 VkResult
 nvkmd_rm_mem_export_scanout(struct nvkmd_mem *_mem,
-                            struct vk_object_base *log_obj)
+                            struct vk_object_base *log_obj,
+                            uint64_t modifier)
 {
    struct nvkmd_rm_mem *mem = nvkmd_rm_mem(_mem);
    struct nvkmd_rm_dev *dev = nvkmd_rm_dev(_mem->dev);
@@ -220,6 +242,13 @@ nvkmd_rm_mem_export_scanout(struct nvkmd_mem *_mem,
    if (!nvkmd_rm_scanout_supported(dev->base.pdev))
       return vk_error(log_obj, VK_ERROR_FEATURE_NOT_PRESENT);
 
+   if (!layout_matches_modifier(mem, modifier)) {
+      return vk_errorf(log_obj, VK_ERROR_FEATURE_NOT_PRESENT,
+                       "RM: memory 0x%x (kind 0x%x, tile 0x%x) cannot be "
+                       "shown as modifier 0x%016" PRIx64, mem->h_memory,
+                       mem->pte_kind, mem->tile_mode, modifier);
+   }
+
    bool exported = false;
    simple_mtx_lock(&mem->export_mutex);
    if (mem->gem_handle == 0) {
@@ -274,7 +303,8 @@ kmd_source_set_locked(struct nvkmd_rm_dev *dev,
  */
 static int
 kmd_source_present(struct nvkmd_rm_dev *dev,
-                   const struct nvrm_crm_scanout_flip *flip)
+                   const struct nvrm_crm_scanout_flip *flip,
+                   bool *layout_rejected)
 {
    const struct nvkmd_rm_lib *lib = dev->lib;
    int ret;
@@ -299,6 +329,8 @@ kmd_source_present(struct nvkmd_rm_dev *dev,
       dev->source.modifier == flip->modifier;
