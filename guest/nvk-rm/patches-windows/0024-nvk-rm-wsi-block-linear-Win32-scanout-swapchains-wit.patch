 /* Conduit's Helios adapter: swapchain images are shown by a host scanout
  * flip of the VRAM they live in (nvkmd_rm_win.c), no copy to a window.
  */
 static VkResult
-nvk_wsi_scanout_export(VkDevice _device, VkDeviceMemory _mem)
+nvk_wsi_scanout_export(VkDevice _device, VkImage _image, VkDeviceMemory _mem,
+                       uint64_t *modifier)
 {
    VK_FROM_HANDLE(nvk_device, dev, _device);
+   VK_FROM_HANDLE(nvk_image, image, _image);
    VK_FROM_HANDLE(nvk_device_memory, mem, _mem);
 
-   return nvkmd_rm_mem_export_scanout(mem->mem, &dev->vk.base);
+   /* Block-linear: the dedicated allocation took the image's PTE kind and
+    * tile mode (nvk_AllocateMemory), which the export hands to NVKMS.
+    */
+   *modifier = image->vk.tiling == VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT ?
+               image->vk.drm_format_mod : DRM_FORMAT_MOD_LINEAR;
+
+   return nvkmd_rm_mem_export_scanout(mem->mem, &dev->vk.base, *modifier);
 }
 
 static VkResult
@@ -91,6 +102,12 @@ nvk_init_wsi(struct nvk_physical_device *pdev)
       pdev->wsi_device.win32.scanout_export = nvk_wsi_scanout_export;
       pdev->wsi_device.win32.scanout_flip = nvk_wsi_scanout_flip;
       pdev->wsi_device.win32.scanout_release = nvk_wsi_scanout_release;
+      /* Block-linear swapchain images with NVIDIA's DRM modifier unless
+       * NVK_HELIOS_WSI_LINEAR=1 (linear: NVK renders through a tiled
+       * shadow and copies into the image every frame).
+       */
+      pdev->wsi_device.win32.scanout_linear =
+         debug_get_bool_option("NVK_HELIOS_WSI_LINEAR", false);
    }
 #endif
 
