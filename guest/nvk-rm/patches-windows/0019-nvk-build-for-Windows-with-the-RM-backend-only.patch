diff --git a/src/nouveau/compat/win32/sys/ioccom.h b/src/nouveau/compat/win32/sys/ioccom.h
new file mode 100644
index 0000000..261124e
--- /dev/null
+++ b/src/nouveau/compat/win32/sys/ioccom.h
@@ -0,0 +1,13 @@
+/*
+ * Copyright © 2026 Conduit contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * NIL and NVK use the DRM format modifier definitions from
+ * drm-uapi/drm_fourcc.h, which pulls in drm-uapi/drm.h, which wants the BSD
+ * ioctl header on anything that is not Linux.  Nothing on Windows issues DRM
+ * ioctls; drm.h only needs this header to exist (its _IO* users are macros
+ * that are never expanded there).
+ */
+#ifndef NOUVEAU_COMPAT_WIN32_SYS_IOCCOM_H
+#define NOUVEAU_COMPAT_WIN32_SYS_IOCCOM_H
+#endif
