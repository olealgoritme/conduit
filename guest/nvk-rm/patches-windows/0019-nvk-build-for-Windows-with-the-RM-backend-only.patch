diff --git a/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_drm.c b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_drm.c
new file mode 100644
index 0000000..2ef480a
--- /dev/null
+++ b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_drm.c
@@ -0,0 +1,447 @@
+/*
+ * Copyright © 2026 Conduit contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * The DRM side of the RM backend (Linux only): finding the GPU's nvidia-drm
+ * node, and RM memory to and from dma-bufs through it.  Windows builds leave
+ * this file out; nvkmd_rm.h has the stubs (no dma-bufs, no DRM modifiers).
+ */
+
+#include "nvkmd_rm.h"
+
+#include "util/log.h"
+#include "util/u_debug.h"
+#include "util/u_math.h"
+#include "vk_log.h"
+
+#include <fcntl.h>
+#include <inttypes.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <xf86drm.h>
+
+int
+nvkmd_rm_open_drm(const char *path)
+{
+   return open(path, O_RDWR | O_CLOEXEC);
+}
+
+void
+nvkmd_rm_close_drm(int fd)
+{
+   if (fd >= 0)
+      close(fd);
+}
+
+void
+nvkmd_rm_close_gem(struct nvkmd_rm_dev *dev, uint32_t gem_handle)
+{
+   struct drm_gem_close gem_close = { .handle = gem_handle };
+   drmIoctl(dev->drm_fd, DRM_IOCTL_GEM_CLOSE, &gem_close);
+}
+
+/* Opens path and checks that it is an nvidia-drm node.  Fills info. */
+static int
+open_nvidia_drm(const char *path,
+                struct nvrm_drm_nvidia_get_dev_info_params *info)
+{
+   int fd = open(path, O_RDWR | O_CLOEXEC);
+   if (fd < 0)
+      return -1;
+
+   drmVersionPtr ver = drmGetVersion(fd);
+   const bool is_nvidia = ver != NULL && ver->name != NULL &&
+                          strcmp(ver->name, "nvidia-drm") == 0;
+   drmFreeVersion(ver);
+
+   memset(info, 0, sizeof(*info));
+   if (!is_nvidia ||
+       drmIoctl(fd, DRM_IOWR(DRM_COMMAND_BASE + NVRM_DRM_NVIDIA_GET_DEV_INFO,
+                             struct nvrm_drm_nvidia_get_dev_info_params),
+                info) != 0) {
+      close(fd);
+      return -1;
+   }
+
+   return fd;
+}
+
+/*
+ * Finds the nvidia-drm node of this GPU: the DRM device at the same PCI
+ * address (under Conduit, the guest's PCI mirror of the host GPU, which is
+ * also what RM reports) whose driver calls itself nvidia-drm.  Its GEM
+ * import of RM memory is what turns our memory into dma-bufs.
+ */
+void
+nvkmd_rm_find_drm_node(struct nvkmd_rm_pdev *pdev, enum nvk_debug debug_flags)
+{
+   const struct nv_device_info *info = &pdev->base.dev_info;
+
+   if (!debug_get_bool_option("NVK_RM_DMABUF", true))
+      return;
+
+   drmDevicePtr devices[16];
+   int count = drmGetDevices2(0, devices, ARRAY_SIZE(devices));
+   if (count <= 0)
+      return;
+
+   for (int i = 0; i < count && pdev->drm_path[0] == '\0'; i++) {
+      drmDevicePtr d = devices[i];
+      if (d->bustype != DRM_BUS_PCI ||
+          d->businfo.pci->domain != info->pci.domain ||
+          d->businfo.pci->bus != info->pci.bus ||
+          d->businfo.pci->dev != info->pci.dev ||
+          d->businfo.pci->func != info->pci.func)
+         continue;
+
+      /* Prefer the render node: no DRM master, no authentication */
+      static const int node_types[] = { DRM_NODE_RENDER, DRM_NODE_PRIMARY };
+      for (unsigned n = 0; n < ARRAY_SIZE(node_types); n++) {
+         if (!(d->available_nodes & (1 << node_types[n])))
+            continue;
+
+         const char *path = d->nodes[node_types[n]];
+         struct nvrm_drm_nvidia_get_dev_info_params drm_info;
+         int fd = open_nvidia_drm(path, &drm_info);
+         if (fd < 0)
+            continue;
+         close(fd);
+
+         if (drm_info.gpu_id != pdev->gpu_id) {
+            mesa_logw("NVK: %s is gpu_id 0x%x, RM says 0x%x; using it anyway",
+                      path, drm_info.gpu_id, pdev->gpu_id);
+         }
+
+         snprintf(pdev->drm_path, sizeof(pdev->drm_path), "%s", path);
+
+         struct stat st;
+         if ((d->available_nodes & (1 << DRM_NODE_RENDER)) &&
+             stat(d->nodes[DRM_NODE_RENDER], &st) == 0)
+            pdev->base.drm.render_dev = st.st_rdev;
+         if ((d->available_nodes & (1 << DRM_NODE_PRIMARY)) &&
+             stat(d->nodes[DRM_NODE_PRIMARY], &st) == 0)
+            pdev->base.drm.primary_dev = st.st_rdev;
+
+         if (debug_flags & NVK_DEBUG_VM) {
+            fprintf(stderr, "NVK: RM GPU %u: dma-bufs through %s (gpu_id "
+                    "0x%x, generic kind 0x%x, kind generation %u, sector "
+                    "layout %u)\n", pdev->gpu_id, path, drm_info.gpu_id,
+                    drm_info.generic_page_kind,
+                    drm_info.page_kind_generation, drm_info.sector_layout);
+         }
+         break;
+      }
+   }
+
+   drmFreeDevices(devices, count);
+}
+
+/*
+ * dma-bufs
+ *
+ * RM memory reaches DRM the way NVIDIA's own userspace sends it: the memory
+ * object is exported to a fresh /dev/nvidiactl descriptor
+ * (NV0000_CTRL_CMD_OS_UNIX_EXPORT_OBJECT_TO_FD) and nvidia-drm imports that
+ * descriptor as a GEM object (DRM_NVIDIA_GEM_IMPORT_NVKMS_MEMORY), which PRIME
+ * turns into a dma-buf.  The other way round, nvidia-drm exports the memory
+ * behind a GEM object to a descriptor (DRM_NVIDIA_GEM_EXPORT_NVKMS_MEMORY) and
+ * we import it into our client (NV0000_CTRL_CMD_OS_UNIX_IMPORT_OBJECT_FROM_FD).
+ *
+ * Under Conduit the DRM node is the guest's nvidia-drm stand-in, which
+ * forwards both ioctls (descriptors swapped for the backend's) to the host's
+ * nvidia-drm and keeps a guest GEM object in front of the host's.  The
+ * memory never moves: a compositor in the guest, and Conduit's scanout to
+ * the host viewer, see the very VRAM NVK rendered into.
+ */
+
+static int
+open_export_fd(void)
+{
+   return open("/dev/nvidiactl", O_RDWR | O_CLOEXEC);
+}
+
+static VkResult
+export_to_gem(struct nvkmd_rm_dev *dev, struct nvkmd_rm_mem *mem,
+              struct vk_object_base *log_obj, uint32_t *gem_handle_out)
+{
+   const struct nvkmd_rm_lib *lib = dev->lib;
+   VkResult result;
+
+   if (mem->os_pages != NULL) {
+      return vk_errorf(log_obj, VK_ERROR_FEATURE_NOT_PRESENT,
+                       "RM: memory backed by our own pages cannot be "
+                       "exported");
+   }
+
+   int ctl_fd = open_export_fd();
+   if (ctl_fd < 0) {
+      return vk_errorf(log_obj, VK_ERROR_OUT_OF_HOST_MEMORY,
+                       "open /dev/nvidiactl: %m");
+   }
+
+   NV0000_CTRL_OS_UNIX_EXPORT_OBJECT_TO_FD_PARAMS ex = {
+      .object = {
+         .type = NV0000_CTRL_OS_UNIX_EXPORT_OBJECT_TYPE_RM,
+         .rmObject = {
+            .hDevice = dev->h_device,
+            .hParent = dev->h_device,
+            .hObject = mem->h_memory,
+         },
+      },
+      .fd = ctl_fd,
+   };
+   result = NVKMD_RM_CHECK(lib, log_obj, VK_ERROR_OUT_OF_HOST_MEMORY,
+                           lib->control(dev->client, lib->root(dev->client),
+                                        NV0000_CTRL_CMD_OS_UNIX_EXPORT_OBJECT_TO_FD,
+                                        &ex, sizeof(ex)),
+                           "OS_UNIX_EXPORT_OBJECT_TO_FD");
+   if (result != VK_SUCCESS)
+      goto out;
+
+   /* NVKMS keeps the layout for scanout through nvidia-drm's own KMS; a
+    * dma-buf importer uses the DRM format modifier instead.
+    */
+   struct nvrm_nvkms_kapi_priv_import_memory_params nvkms = {
+      .memFd = ctl_fd,
+      .surfaceParams = {
+         .layout = mem->pte_kind != 0 ?
+                   NVRM_NVKMS_SURFACE_MEMORY_LAYOUT_BLOCK_LINEAR :
+                   NVRM_NVKMS_SURFACE_MEMORY_LAYOUT_PITCH,
+         .blockLinear = {
+            .log2GobsPerBlock = {
+               .x = 0,
+               .y = (mem->tile_mode >> 4) & 0xf,
+               .z = (mem->tile_mode >> 8) & 0xf,
+            },
+            .pitchInBlocks = 0,
+            .genericMemory = mem->pte_kind != 0,
+         },
+      },
+   };
+   struct nvrm_drm_nvidia_gem_import_nvkms_memory_params imp = {
+      .mem_size = mem->base.size_B,
+      .nvkms_params_ptr = (uint64_t)(uintptr_t)&nvkms,
+      .nvkms_params_size = sizeof(nvkms),
+   };
+   if (drmIoctl(dev->drm_fd,
+                DRM_IOWR(DRM_COMMAND_BASE +
+                         NVRM_DRM_NVIDIA_GEM_IMPORT_NVKMS_MEMORY,
+                         struct nvrm_drm_nvidia_gem_import_nvkms_memory_params),
+                &imp) != 0) {
+      result = vk_errorf(log_obj, VK_ERROR_OUT_OF_HOST_MEMORY,
+                         "DRM_NVIDIA_GEM_IMPORT_NVKMS_MEMORY: %m");
+      goto out;
+   }
+
+   *gem_handle_out = imp.handle;
+
+out:
+   /* nvidia-drm has its own reference now; the descriptor was only the
+    * envelope.
+    */
+   close(ctl_fd);
+
+   return result;
+}
+
+static bool
+query_is_vram(struct nvkmd_rm_dev *dev, uint32_t h_memory)
+{
+   NV0041_CTRL_SURFACE_INFO info = {
+      .index = NV0041_CTRL_SURFACE_INFO_INDEX_ADDR_SPACE_TYPE,
+   };
+   NV0041_CTRL_GET_SURFACE_INFO_PARAMS params = {
+      .surfaceInfoListSize = 1,
+      .surfaceInfoList = (uint64_t)(uintptr_t)&info,
+   };
+   if (dev->lib->control(dev->client, h_memory,
+                         NV0041_CTRL_CMD_GET_SURFACE_INFO,
+                         &params, sizeof(params)) != 0)
+      return true; /* what a dma-buf from nvidia-drm on a dGPU usually is */
+
+   return info.data != NV0000_CTRL_CMD_CLIENT_GET_ADDR_SPACE_TYPE_SYSMEM;
+}
+
+VkResult
+nvkmd_rm_import_dma_buf(struct nvkmd_dev *_dev,
+                        struct vk_object_base *log_obj,
+                        int fd, struct nvkmd_mem **mem_out)
+{
+   struct nvkmd_rm_dev *dev = nvkmd_rm_dev(_dev);
+   const struct nvkmd_rm_lib *lib = dev->lib;
+   VkResult result;
+   int ret;
+
+   if (dev->drm_fd < 0 || lib->new_handle == NULL)
+      return vk_error(log_obj, VK_ERROR_INVALID_EXTERNAL_HANDLE);
+
+   const off_t size = lseek(fd, 0, SEEK_END);
+   if (size <= 0)
+      return vk_errorf(log_obj, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "dma-buf size: %m");
+   lseek(fd, 0, SEEK_SET);
+
+   /* A dma-buf from another driver is not something nvidia-drm can name
+    * by RM memory; GEM_EXPORT_NVKMS_MEMORY fails for it.
+    */
+   uint32_t gem_handle;
+   if (drmPrimeFDToHandle(dev->drm_fd, fd, &gem_handle) != 0)
+      return vk_errorf(log_obj, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "PRIME_FD_TO_HANDLE: %m");
+
+   int ctl_fd = open_export_fd();
+   if (ctl_fd < 0) {
+      result = vk_errorf(log_obj, VK_ERROR_OUT_OF_HOST_MEMORY,
+                         "open /dev/nvidiactl: %m");
+      goto fail_gem;
+   }
+
+   struct nvrm_nvkms_kapi_priv_export_memory_params nvkms = {
+      .memFd = ctl_fd,
+   };
+   struct nvrm_drm_nvidia_gem_export_nvkms_memory_params exp = {
+      .handle = gem_handle,
+      .nvkms_params_ptr = (uint64_t)(uintptr_t)&nvkms,
+      .nvkms_params_size = sizeof(nvkms),
+   };
+   if (drmIoctl(dev->drm_fd,
+                DRM_IOWR(DRM_COMMAND_BASE +
+                         NVRM_DRM_NVIDIA_GEM_EXPORT_NVKMS_MEMORY,
+                         struct nvrm_drm_nvidia_gem_export_nvkms_memory_params),
+                &exp) != 0) {
+      result = vk_errorf(log_obj, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                         "DRM_NVIDIA_GEM_EXPORT_NVKMS_MEMORY: %m");
+      goto fail_ctl;
+   }
+
+   const uint32_t h_memory = lib->new_handle(dev->client);
+   NV0000_CTRL_OS_UNIX_IMPORT_OBJECT_FROM_FD_PARAMS im = {
+      .fd = ctl_fd,
+      .object = {
+         .type = NV0000_CTRL_OS_UNIX_EXPORT_OBJECT_TYPE_RM,
+         .rmObject = {
+            .hDevice = dev->h_device,
+            .hParent = dev->h_device,
+            .hObject = h_memory,
+         },
+      },
+   };
+   ret = lib->control(dev->client, lib->root(dev->client),
+                      NV0000_CTRL_CMD_OS_UNIX_IMPORT_OBJECT_FROM_FD,
+                      &im, sizeof(im));
+   if (ret != 0) {
+      if (lib->release_handle != NULL)
+         lib->release_handle(dev->client, h_memory);
+      result = NVKMD_RM_CHECK(lib, log_obj, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                              ret, "OS_UNIX_IMPORT_OBJECT_FROM_FD");
+      goto fail_ctl;
+   }
+   close(ctl_fd);
+
+   /* The GEM handle is per file and shared by every import of the same
+    * dma-buf, so it is not ours to keep.  A later export of this memory
+    * goes through GEM_IMPORT_NVKMS_MEMORY like any other.
+    */
+   struct drm_gem_close gem_close = { .handle = gem_handle };
+   drmIoctl(dev->drm_fd, DRM_IOCTL_GEM_CLOSE, &gem_close);
+
+   struct nvkmd_rm_mem *mem = CALLOC_STRUCT(nvkmd_rm_mem);
+   if (mem == NULL) {
+      nvkmd_rm_free_memory(dev, h_memory);
+      if (lib->release_handle != NULL)
+         lib->release_handle(dev->client, h_memory);
+      return vk_error(log_obj, VK_ERROR_OUT_OF_HOST_MEMORY);
+   }
+
+   mem->h_memory = h_memory;
+   mem->imported = true;
+   mem->vram = query_is_vram(dev, h_memory);
+   simple_mtx_init(&mem->export_mutex, mtx_plain);
+
+   /* As nouveau: LOCAL for anything shared, we do not pick the placement */
+   enum nvkmd_mem_flags flags = NVKMD_MEM_SHARED | NVKMD_MEM_LOCAL |
+                                NVKMD_MEM_COHERENT;
+   if (!mem->vram)
+      flags |= NVKMD_MEM_CAN_MAP;
+
+   const uint32_t page_size_B = mem->vram ? NVKMD_RM_BIG_PAGE_SIZE
+                                          : NVKMD_RM_SYSMEM_PAGE_SIZE;
+   const uint64_t size_B = align64(size, page_size_B);
+   nvkmd_mem_init(&dev->base, &mem->base, &nvkmd_rm_mem_ops,
+                  flags, size_B, page_size_B);
+
+   enum nvkmd_va_flags va_flags = mem->vram ? 0 : NVKMD_VA_GART;
+   result = nvkmd_dev_alloc_va(&dev->base, log_obj, va_flags, 0 /* kind */,
+                               size_B, page_size_B, 0 /* fixed_addr */,
+                               &mem->base.va);
+   if (result != VK_SUCCESS)
+      goto fail_mem;
+
+   result = nvkmd_va_bind_mem(mem->base.va, log_obj, 0, &mem->base,
+                              0, size_B);
+   if (result != VK_SUCCESS)
+      goto fail_va;
+
+   *mem_out = &mem->base;
+
+   return VK_SUCCESS;
+
+fail_va:
+   nvkmd_va_free(mem->base.va);
+fail_mem:
+   simple_mtx_destroy(&mem->export_mutex);
+   nvkmd_rm_free_memory(dev, h_memory);
+   if (lib->release_handle != NULL)
+      lib->release_handle(dev->client, h_memory);
+   FREE(mem);
+   return result;
+
+fail_ctl:
+   close(ctl_fd);
+fail_gem: {
+   struct drm_gem_close gc = { .handle = gem_handle };
+   drmIoctl(dev->drm_fd, DRM_IOCTL_GEM_CLOSE, &gc);
+}
+   return result;
+}
+
+VkResult
+nvkmd_rm_mem_export_dma_buf(struct nvkmd_mem *_mem,
+                            struct vk_object_base *log_obj,
+                            int *fd_out)
+{
+   struct nvkmd_rm_mem *mem = nvkmd_rm_mem(_mem);
+   struct nvkmd_rm_dev *dev = nvkmd_rm_dev(_mem->dev);
+   VkResult result = VK_SUCCESS;
+
+   if (dev->drm_fd < 0)
+      return vk_error(log_obj, VK_ERROR_FEATURE_NOT_PRESENT);
+
+   /* One GEM object per memory: every export is then the same dma-buf, as
+    * with a nouveau BO.
+    */
+   simple_mtx_lock(&mem->export_mutex);
+   if (mem->gem_handle == 0)
+      result = export_to_gem(dev, mem, log_obj, &mem->gem_handle);
+   const uint32_t gem_handle = mem->gem_handle;
+   simple_mtx_unlock(&mem->export_mutex);
+   if (result != VK_SUCCESS)
+      return result;
+
+   if (drmPrimeHandleToFD(dev->drm_fd, gem_handle, DRM_CLOEXEC | DRM_RDWR,
+                          fd_out) != 0) {
+      return vk_errorf(log_obj, VK_ERROR_TOO_MANY_OBJECTS,
+                       "PRIME_HANDLE_TO_FD: %m");
+   }
+
+   if (dev->base.pdev->debug_flags & NVK_DEBUG_VM) {
+      fprintf(stderr, "NVK: RM memory 0x%x (%" PRIu64 " B, kind 0x%x, "
+              "tile 0x%x) exported as GEM %u, dma-buf fd %d\n",
+              mem->h_memory, mem->base.size_B, mem->pte_kind,
+              mem->tile_mode, gem_handle, *fd_out);
+   }
+
+   return VK_SUCCESS;
+}
