index de6d458..6cfdae3 100644
--- a/src/nouveau/meson.build
+++ b/src/nouveau/meson.build
@@ -1,6 +1,19 @@
 # Copyright © 2021 Ilia Mirkin
 # SPDX-License-Identifier: MIT
 
+# nouveau's DRM interface (winsys, nvkmd/nouveau, drm-shim).  Windows has
+# no DRM: NVK is built there with the RM backend only.
+with_nouveau_drm = not with_platform_windows
+
+# drm-uapi/drm.h (for drm_fourcc.h's modifiers) wants <sys/ioccom.h> off
+# Linux; give nouveau's targets an empty one on Windows.
+inc_nouveau_compat = []
+if with_platform_windows
+  inc_nouveau_compat += include_directories('compat/win32')
+endif
+_inc_include_outside_nouveau = inc_include
+inc_include = [inc_include, inc_nouveau_compat]
+
 subdir('headers')
 subdir('drm')
 subdir('winsys')
@@ -18,3 +31,5 @@ if with_nouveau_vk
   subdir('mme')
   subdir('vulkan')
 endif
+
+inc_include = _inc_include_outside_nouveau
