+ * Copyright © 2022 Collabora Ltd. and Red Hat Inc.
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef NOUVEAU_DEVICE_LIMITS
+#define NOUVEAU_DEVICE_LIMITS 1
+
+#include "nv_device_info.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Fills the SM version and the per-SM limits (warps, blocks, shared memory
+ * configurations) that are derived from nv_device_info::chipset.  Used by
+ * kernel interfaces other than nouveau which only know the chipset.  No
+ * DRM involved, so this part of the winsys builds without libdrm.
+ */
+void nouveau_ws_device_info_init_limits(struct nv_device_info *info);
+
+#ifdef __cplusplus
+}
+#endif
