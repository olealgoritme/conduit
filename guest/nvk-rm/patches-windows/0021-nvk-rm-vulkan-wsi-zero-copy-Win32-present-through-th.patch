 src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_dev.c  |  11 +
 src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_lib.c  |   5 +
 src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_win.c  | 279 ++++++++++++++++++++
 src/nouveau/vulkan/nvkmd/rm/nvrm/nvrm_api.h |  17 ++
 src/vulkan/wsi/wsi_common.c                 |   5 +
 src/vulkan/wsi/wsi_common.h                 |  25 ++
 src/vulkan/wsi/wsi_common_private.h         |   6 +
