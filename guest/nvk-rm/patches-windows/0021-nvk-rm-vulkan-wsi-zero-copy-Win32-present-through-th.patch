diff --git a/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_win.c b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_win.c
new file mode 100644
index 0000000..9679e68
--- /dev/null
+++ b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_win.c
@@ -0,0 +1,279 @@
+/*
+ * Copyright © 2026 Conduit contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * Scanout presentation on Windows through Conduit's Helios KMD.
+ *
+ * A Windows guest has no nvidia-drm, but librmclient's Windows transport
+ * reaches the host's: it opens one of the host's DRM render nodes
+ * (crm_win_open_device), sends ioctls there (crm_win_ioctl) and names a GEM
+ * object of that node in a ScanoutFlip (crm_win_scanout_flip), which the host
+ * turns into a dma-buf for the display.  So RM memory is presented the way
+ * nvkmd_rm_drm.c turns it into a dma-buf on Linux: exported to a fresh
+ * control channel (NV0000_CTRL_CMD_OS_UNIX_EXPORT_OBJECT_TO_FD), imported on
+ * the render node as a GEM object (DRM_NVIDIA_GEM_IMPORT_NVKMS_MEMORY), once
+ * per memory.  Every present is then one ScanoutFlip of that GEM object; the
+ * VRAM NVK rendered into is what the viewer shows.
+ *
+ *   NVK_HELIOS_WSI=0   off (the Win32 WSI then copies through GDI)
+ *   NVK_HELIOS_DRI=n   host render node n (default 0)
+ */
+
+#include "nvkmd_rm.h"
+
+#include "util/log.h"
+#include "util/u_atomic.h"
+#include "util/u_debug.h"
+#include "vk_log.h"
+
+#include <errno.h>
+#include <inttypes.h>
+#include <stdio.h>
+#include <string.h>
+
+/* What crm_win_open_device takes (rmclient_transport.h) */
+#define NVKMD_RM_WIN_DEV_CTL      255u
+#define NVKMD_RM_WIN_DEV_DRI_BASE 512u
+
+/* Full Linux ioctl numbers, as the host sees them: there is no <drm.h> here.
+ * DRM_IOWR(DRM_COMMAND_BASE + 0x01, 32 bytes) and DRM_IOW(0x09, 8 bytes).
+ */
+#define NVKMD_RM_WIN_IOCTL_GEM_IMPORT_NVKMS_MEMORY 0xc0206441u
+#define NVKMD_RM_WIN_IOCTL_GEM_CLOSE               0x40086409u
+
+static_assert(sizeof(struct nvrm_drm_nvidia_gem_import_nvkms_memory_params) == 32,
+              "GEM_IMPORT_NVKMS_MEMORY size is in the ioctl number");
+
+bool
+nvkmd_rm_scanout_supported(struct nvkmd_pdev *pdev)
+{
+   const struct nvkmd_rm_lib *lib = nvkmd_rm_lib_get();
+
+   if (!debug_get_bool_option("NVK_HELIOS_WSI", true))
+      return false;
+
+   return lib != NULL &&
+          lib->win_open_device != NULL && lib->win_close_device != NULL &&
+          lib->win_ioctl != NULL && lib->win_scanout_flip != NULL;
+}
+
+void
+nvkmd_rm_close_drm(int fd)
+{
+   const struct nvkmd_rm_lib *lib = nvkmd_rm_lib_get();
+
+   if (fd >= 0 && lib != NULL && lib->win_close_device != NULL)
+      lib->win_close_device(fd);
+}
+
+void
+nvkmd_rm_close_gem(struct nvkmd_rm_dev *dev, uint32_t gem_handle)
+{
+   struct {
+      uint32_t handle;
+      uint32_t pad;
+   } gem_close = { .handle = gem_handle };
+
+   if (dev->drm_fd >= 0 && dev->lib->win_ioctl != NULL) {
+      dev->lib->win_ioctl(dev->drm_fd, NVKMD_RM_WIN_IOCTL_GEM_CLOSE,
+                          &gem_close, sizeof(gem_close), NULL, 0);
+   }
+}
+
+/* The render node, opened on first use */
+static VkResult
+get_drm_fd(struct nvkmd_rm_dev *dev, struct vk_object_base *log_obj,
+           int *fd_out)
+{
+   const struct nvkmd_rm_lib *lib = dev->lib;
+   VkResult result = VK_SUCCESS;
+
+   simple_mtx_lock(&dev->drm_mutex);
+   if (dev->drm_fd < 0 && !dev->drm_open_failed) {
+      const uint32_t dri = debug_get_num_option("NVK_HELIOS_DRI", 0);
+      int fd = -1;
+      int ret = lib->win_open_device(NVKMD_RM_WIN_DEV_DRI_BASE + dri, &fd);
+      if (ret != 0 || fd < 0) {
+         dev->drm_open_failed = true;
+         mesa_logw("NVK: cannot open host render node %u (%d), "
+                   "no scanout presentation", dri, ret);
+      } else {
+         dev->drm_fd = fd;
+         if (dev->base.pdev->debug_flags & NVK_DEBUG_VM)
+            fprintf(stderr, "NVK: host render node %u is handle %d\n",
+                    dri, fd);
+      }
+   }
+   if (dev->drm_fd < 0)
+      result = vk_error(log_obj, VK_ERROR_FEATURE_NOT_PRESENT);
+   *fd_out = dev->drm_fd;
+   simple_mtx_unlock(&dev->drm_mutex);
+
+   return result;
+}
+
+static VkResult
+export_to_gem(struct nvkmd_rm_dev *dev, struct nvkmd_rm_mem *mem,
+              struct vk_object_base *log_obj, uint32_t *gem_handle_out)
+{
+   const struct nvkmd_rm_lib *lib = dev->lib;
+   VkResult result;
+   int ret;
+
+   if (mem->os_pages != NULL) {
+      return vk_errorf(log_obj, VK_ERROR_FEATURE_NOT_PRESENT,
+                       "RM: memory backed by our own pages cannot be "
+                       "exported");
+   }
+
+   int drm_fd;
+   result = get_drm_fd(dev, log_obj, &drm_fd);
+   if (result != VK_SUCCESS)
+      return result;
+
+   /* A fresh control channel is the envelope, as /dev/nvidiactl on Linux */
+   int ctl_fd = -1;
+   ret = lib->win_open_device(NVKMD_RM_WIN_DEV_CTL, &ctl_fd);
+   if (ret != 0 || ctl_fd < 0) {
+      return vk_errorf(log_obj, VK_ERROR_OUT_OF_HOST_MEMORY,
+                       "RM: open a control channel for export: %d", ret);
+   }
+
+   NV0000_CTRL_OS_UNIX_EXPORT_OBJECT_TO_FD_PARAMS ex = {
+      .object = {
+         .type = NV0000_CTRL_OS_UNIX_EXPORT_OBJECT_TYPE_RM,
+         .rmObject = {
+            .hDevice = dev->h_device,
+            .hParent = dev->h_device,
+            .hObject = mem->h_memory,
+         },
+      },
+      .fd = ctl_fd,
+   };
+   result = NVKMD_RM_CHECK(lib, log_obj, VK_ERROR_OUT_OF_HOST_MEMORY,
+                           lib->control(dev->client, lib->root(dev->client),
+                                        NV0000_CTRL_CMD_OS_UNIX_EXPORT_OBJECT_TO_FD,
+                                        &ex, sizeof(ex)),
+                           "OS_UNIX_EXPORT_OBJECT_TO_FD");
+   if (result != VK_SUCCESS)
+      goto out;
+
+   struct nvrm_nvkms_kapi_priv_import_memory_params nvkms = {
+      .memFd = ctl_fd,
+      .surfaceParams = {
+         .layout = mem->pte_kind != 0 ?
+                   NVRM_NVKMS_SURFACE_MEMORY_LAYOUT_BLOCK_LINEAR :
+                   NVRM_NVKMS_SURFACE_MEMORY_LAYOUT_PITCH,
+         .blockLinear = {
+            .log2GobsPerBlock = {
+               .x = 0,
+               .y = (mem->tile_mode >> 4) & 0xf,
+               .z = (mem->tile_mode >> 8) & 0xf,
+            },
+            .pitchInBlocks = 0,
+            .genericMemory = mem->pte_kind != 0,
+         },
+      },
+   };
+   struct nvrm_drm_nvidia_gem_import_nvkms_memory_params imp = {
+      .mem_size = mem->base.size_B,
+      .nvkms_params_ptr = (uint64_t)(uintptr_t)&nvkms,
+      .nvkms_params_size = sizeof(nvkms),
+   };
+   /* The transport sends the NVKMS block after the struct and puts the
+    * host's descriptor for memFd in it.
+    */
+   ret = lib->win_ioctl(drm_fd, NVKMD_RM_WIN_IOCTL_GEM_IMPORT_NVKMS_MEMORY,
+                        &imp, sizeof(imp), &nvkms, sizeof(nvkms));
+   if (ret != 0 || imp.handle == 0) {
+      result = vk_errorf(log_obj, VK_ERROR_OUT_OF_HOST_MEMORY,
+                         "DRM_NVIDIA_GEM_IMPORT_NVKMS_MEMORY: %d (%s)", ret,
+                         ret < 0 ? strerror(-ret) : "no handle");
+      goto out;
+   }
+
+   *gem_handle_out = imp.handle;
+
+out:
+   /* nvidia-drm has its own reference now */
+   lib->win_close_device(ctl_fd);
+
+   return result;
+}
+
+VkResult
+nvkmd_rm_mem_export_scanout(struct nvkmd_mem *_mem,
+                            struct vk_object_base *log_obj)
+{
+   struct nvkmd_rm_mem *mem = nvkmd_rm_mem(_mem);
+   struct nvkmd_rm_dev *dev = nvkmd_rm_dev(_mem->dev);
+   VkResult result = VK_SUCCESS;
+
+   if (!nvkmd_rm_scanout_supported(dev->base.pdev))
+      return vk_error(log_obj, VK_ERROR_FEATURE_NOT_PRESENT);
+
+   simple_mtx_lock(&mem->export_mutex);
+   if (mem->gem_handle == 0)
+      result = export_to_gem(dev, mem, log_obj, &mem->gem_handle);
+   const uint32_t gem_handle = mem->gem_handle;
+   simple_mtx_unlock(&mem->export_mutex);
+
+   if (result == VK_SUCCESS && (dev->base.pdev->debug_flags & NVK_DEBUG_VM)) {
+      fprintf(stderr, "NVK: RM memory 0x%x (%" PRIu64 " B, kind 0x%x, "
+              "tile 0x%x) is scanout GEM %u on handle %d\n",
+              mem->h_memory, mem->base.size_B, mem->pte_kind,
+              mem->tile_mode, gem_handle, dev->drm_fd);
+   }
+
+   return result;
+}
+
+VkResult
+nvkmd_rm_mem_scanout_flip(struct nvkmd_mem *_mem,
+                          struct vk_object_base *log_obj,
+                          uint32_t width, uint32_t height,
+                          uint32_t stride, uint32_t offset,
+                          uint32_t fourcc, uint64_t modifier)
+{
+   struct nvkmd_rm_mem *mem = nvkmd_rm_mem(_mem);
+   struct nvkmd_rm_dev *dev = nvkmd_rm_dev(_mem->dev);
+
+   VkResult result = nvkmd_rm_mem_export_scanout(_mem, log_obj);
+   if (result != VK_SUCCESS)
+      return result;
+
+   const struct nvrm_crm_scanout_flip flip = {
+      .scanout = 0,
+      .owner_handle = (uint32_t)dev->drm_fd,
+      .host_handle = mem->gem_handle,
+      .width = width,
+      .height = height,
+      .stride = stride,
+      .offset = offset,
+      .fourcc = fourcc,
+      .modifier = modifier,
+      .seq = p_atomic_inc_return(&dev->flip_seq),
+   };
+   int ret = dev->lib->win_scanout_flip(&flip);
+   if (ret == 0) {
+      p_atomic_inc(&dev->flips_ok);
+   } else {
+      p_atomic_inc(&dev->flips_failed);
+      result = vk_errorf(log_obj, VK_ERROR_SURFACE_LOST_KHR,
+                         "ScanoutFlip of GEM %u: %d (%s)", mem->gem_handle,
+                         ret, ret < 0 ? strerror(-ret) : "?");
+   }
+
+   if (dev->base.pdev->debug_flags & NVK_DEBUG_VM) {
+      const uint64_t n = dev->flips_ok + dev->flips_failed;
+      if (n == 1 || n % 600 == 0) {
+         fprintf(stderr, "NVK: flip %" PRIu64 ": GEM %u %ux%u stride %u "
+                 "fourcc 0x%08x modifier 0x%" PRIx64 ", %" PRIu64 " ok, %"
+                 PRIu64 " failed\n", flip.seq, flip.host_handle, width,
+                 height, stride, fourcc, modifier, dev->flips_ok,
+                 dev->flips_failed);
+      }
+   }
+
+   return result;
+}
