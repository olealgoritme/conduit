diff --git a/src/nouveau/vulkan/nvk_wsi.c b/src/nouveau/vulkan/nvk_wsi.c
index 8a6f7da..4eb718d 100644
--- a/src/nouveau/vulkan/nvk_wsi.c
+++ b/src/nouveau/vulkan/nvk_wsi.c
@@ -7,6 +7,37 @@
 #include "nvkmd/nvkmd.h"
 #include "wsi_common.h"
 
+#ifdef _WIN32
+#include "nvk_device.h"
+#include "nvk_device_memory.h"
+#include "nvkmd/rm/nvkmd_rm.h"
+
+/* Conduit's Helios adapter: swapchain images are shown by a host scanout
+ * flip of the VRAM they live in (nvkmd_rm_win.c), no copy to a window.
+ */
+static VkResult
+nvk_wsi_scanout_export(VkDevice _device, VkDeviceMemory _mem)
+{
+   VK_FROM_HANDLE(nvk_device, dev, _device);
+   VK_FROM_HANDLE(nvk_device_memory, mem, _mem);
+
+   return nvkmd_rm_mem_export_scanout(mem->mem, &dev->vk.base);
+}
+
+static VkResult
+nvk_wsi_scanout_flip(VkDevice _device, VkDeviceMemory _mem,
+                     const struct wsi_win32_scanout_flip *flip)
+{
+   VK_FROM_HANDLE(nvk_device, dev, _device);
+   VK_FROM_HANDLE(nvk_device_memory, mem, _mem);
+
+   return nvkmd_rm_mem_scanout_flip(mem->mem, &dev->vk.base,
+                                    flip->width, flip->height,
+                                    flip->stride, flip->offset,
+                                    flip->fourcc, flip->modifier);
+}
+#endif
+
 static VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL
 nvk_wsi_proc_addr(VkPhysicalDevice physicalDevice, const char *pName)
 {
@@ -47,6 +78,13 @@ nvk_init_wsi(struct nvk_physical_device *pdev)
       pdev->nvkmd->kmd_info.has_dma_buf &&
       pdev->nvkmd->sync_types[0]->export_sync_file == NULL;
 
+#ifdef _WIN32
+   if (nvkmd_rm_scanout_supported(pdev->nvkmd)) {
+      pdev->wsi_device.win32.scanout_export = nvk_wsi_scanout_export;
+      pdev->wsi_device.win32.scanout_flip = nvk_wsi_scanout_flip;
+   }
+#endif
+
    pdev->vk.wsi_device = &pdev->wsi_device;
 
    return result;
