+/*
+ * Scanout presentation
+ *
+ * The driver shows device memory on the display itself (under Conduit, a
+ * host scanout flip of the GPU memory the image lives in), so the swapchain
+ * images are linear images in dedicated device memory that the driver makes
+ * presentable once (scanout_export) and names in every present
+ * (scanout_flip).  Nothing is copied to a window.
+ */
+
+#define WSI_DRM_FORMAT_XRGB8888 0x34325258u /* 'XR24' */
+#define WSI_DRM_FORMAT_XBGR8888 0x34324258u /* 'XB24' */
+
+static uint32_t
+wsi_win32_scanout_fourcc(VkFormat format)
+{
+   switch (format) {
+   case VK_FORMAT_B8G8R8A8_UNORM:
+   case VK_FORMAT_B8G8R8A8_SRGB:
+      return WSI_DRM_FORMAT_XRGB8888;
+   case VK_FORMAT_R8G8B8A8_UNORM:
+   case VK_FORMAT_R8G8B8A8_SRGB:
+      return WSI_DRM_FORMAT_XBGR8888;
+   default:
+      return 0;
+   }
+}
+
+static VkResult
+wsi_win32_create_scanout_image_mem(const struct wsi_swapchain *chain,
+                                   const struct wsi_image_info *info,
+                                   struct wsi_image *image)
+{
+   const struct wsi_device *wsi = chain->wsi;
+   VkResult result;
+
+   VkMemoryRequirements reqs;
+   wsi->GetImageMemoryRequirements(chain->device, image->image, &reqs);
+
+   VkImageSubresource subresource = {};
+   subresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+   VkSubresourceLayout layout;
+   wsi->GetImageSubresourceLayout(chain->device, image->image,
+                                  &subresource, &layout);
+
+   VkMemoryDedicatedAllocateInfo dedicated = {};
+   dedicated.sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO;
+   dedicated.image = image->image;
+
+   VkMemoryAllocateInfo memory_info = {};
+   memory_info.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO;
+   memory_info.pNext = &dedicated;
+   memory_info.allocationSize = reqs.size;
+   memory_info.memoryTypeIndex =
+      info->select_image_memory_type(wsi, reqs.memoryTypeBits);
+
+   result = wsi->AllocateMemory(chain->device, &memory_info,
+                                &chain->alloc, &image->memory);
+   if (result != VK_SUCCESS)
+      return result;
+
+   image->num_planes = 1;
+   image->sizes[0] = reqs.size;
+   image->row_pitches[0] = layout.rowPitch;
+   image->offsets[0] = layout.offset;
+
+   return wsi->win32.scanout_export(chain->device, image->memory);
+}
+
+VkResult
+wsi_win32_scanout_configure_image(const struct wsi_swapchain *chain,
+                                  const VkSwapchainCreateInfoKHR *pCreateInfo,
+                                  struct wsi_image_info *info)
+{
+   VkResult result = wsi_configure_image(chain, pCreateInfo, 0, info);
+   if (result != VK_SUCCESS)
+      return result;
+
+   /* What the display takes without knowing the driver's tilings */
+   info->create.tiling = VK_IMAGE_TILING_LINEAR;
+   info->select_image_memory_type = wsi_select_device_memory_type;
+   info->create_mem = wsi_win32_create_scanout_image_mem;
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+wsi_win32_queue_present_scanout(struct wsi_win32_swapchain *chain,
+                                struct wsi_win32_image *image)
+{
+   const struct wsi_device *wsi = chain->wsi->wsi;
+
+   /* FIFO without a vblank to wait for: do not outrun the display */
+   if (chain->scanout.period_ns != 0) {
+      const uint64_t now = os_time_get_nano();
+      if (now < chain->scanout.next_flip_ns) {
+         const uint64_t wait_ns = chain->scanout.next_flip_ns - now;
+         LARGE_INTEGER due;
+         due.QuadPart = -(LONGLONG)(wait_ns / 100); /* relative, 100 ns */
+         if (chain->scanout.timer &&
+             SetWaitableTimer(chain->scanout.timer, &due, 0, NULL, NULL, FALSE))
+            WaitForSingleObject(chain->scanout.timer, INFINITE);
+         else
+            os_time_sleep(wait_ns / 1000);
+         chain->scanout.next_flip_ns += chain->scanout.period_ns;
+      } else if (now - chain->scanout.next_flip_ns <
+                 chain->scanout.period_ns) {
+         /* A little late: keep the schedule, catch up next frame */
+         chain->scanout.next_flip_ns += chain->scanout.period_ns;
+      } else {
+         /* Far behind (or the first frame): restart the schedule */
+         chain->scanout.next_flip_ns = now + chain->scanout.period_ns;
+      }
+   }
+
+   struct wsi_win32_scanout_flip flip = {};
+   flip.width = chain->extent.width;
+   flip.height = chain->extent.height;
+   flip.stride = image->base.row_pitches[0];
+   flip.offset = image->base.offsets[0];
+   flip.fourcc = chain->scanout.fourcc;
+   flip.modifier = 0; /* DRM_FORMAT_MOD_LINEAR: the images are linear */
+
+   VkResult result = wsi->win32.scanout_flip(chain->base.device,
+                                             image->base.memory, &flip);
+
+   /* A lost frame is not a lost surface: report it once and go on */
+   if (result != VK_SUCCESS && !chain->scanout.flip_failed) {
+      chain->scanout.flip_failed = true;
+      fprintf(stderr, "MESA-WSI: scanout flip failed (%d), frames dropped\n",
+              result);
+   }
+
+   mtx_lock(&chain->acquire_mutex);
+   image->state = WSI_IMAGE_QUEUED;
+   for (uint32_t i = 0; i < chain->base.image_count; i++) {
+      struct wsi_win32_image *other = &chain->images[i];
+      if (other->state == WSI_IMAGE_QUEUED &&
+          other->base.present_serial + chain->scanout.hold <=
+          chain->base.present_serial)
+         other->state = WSI_IMAGE_IDLE;
+   }
+   u_cnd_monotonic_broadcast(&chain->acquire_cond);
+   mtx_unlock(&chain->acquire_mutex);
+
+   return VK_SUCCESS;
+}
