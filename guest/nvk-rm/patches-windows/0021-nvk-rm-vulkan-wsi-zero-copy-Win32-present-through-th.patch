index f1936b5..83b0835 100644
--- a/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm.h
+++ b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm.h
@@ -78,6 +78,16 @@ struct nvkmd_rm_lib {
    int (*event_wait)(crm_client *c, int event_fd, uint32_t timeout_ms);
    int (*alloc_pages)(crm_client *c, uint64_t size, void **addr);
    int (*free_pages)(crm_client *c, void *addr, uint64_t size);
+
+   /* Windows transport extras (Conduit's Helios KMD): host DRM render
+    * nodes, ioctls on them, and ScanoutFlip, for presenting RM memory with
+    * no copy (nvkmd_rm_win.c).  NULL elsewhere or with an older library.
+    */
+   int (*win_open_device)(uint32_t device_type, int *fd);
+   void (*win_close_device)(int fd);
+   int (*win_ioctl)(int fd, uint32_t cmd, void *arg, uint32_t size,
+                    void *nested, uint32_t nested_len);
+   int (*win_scanout_flip)(const struct nvrm_crm_scanout_flip *flip);
 };
 
 /* Returns NULL if librmclient cannot be loaded */
@@ -176,8 +186,17 @@ struct nvkmd_rm_dev {
    /* Set once draining the event failed: poll() is useless then */
    bool nonstall_undrainable;
 
-   /* Open nvidia-drm node for dma-buf export/import, -1 if none */
+   /* Open nvidia-drm node for dma-buf export/import, -1 if none.  On
+    * Windows: the host render node scanout memory is imported on, opened on
+    * first use (nvkmd_rm_win.c) under drm_mutex.
+    */
    int drm_fd;
+#ifdef _WIN32
+   simple_mtx_t drm_mutex;
+   bool drm_open_failed;
+   uint64_t flip_seq;
+   uint64_t flips_ok, flips_failed;
+#endif
 
    simple_mtx_t heap_mutex;
    struct util_vma_heap heap;
@@ -288,6 +307,11 @@ nvkmd_rm_open_drm(const char *path)
    return -1;
 }
 
+#ifdef _WIN32
+/* nvkmd_rm_win.c: a host render node through the Helios KMD */
+void nvkmd_rm_close_drm(int fd);
+void nvkmd_rm_close_gem(struct nvkmd_rm_dev *dev, uint32_t gem_handle);
+#else
 static inline void
 nvkmd_rm_close_drm(int fd)
 {
@@ -297,6 +321,7 @@ static inline void
 nvkmd_rm_close_gem(struct nvkmd_rm_dev *dev, uint32_t gem_handle)
 {
 }
+#endif
 
 static inline VkResult
 nvkmd_rm_import_dma_buf(struct nvkmd_dev *dev, struct vk_object_base *log_obj,
@@ -313,6 +338,23 @@ nvkmd_rm_mem_export_dma_buf(struct nvkmd_mem *mem,
 }
 #endif
 
+#ifdef _WIN32
+/*
+ * Scanout presentation on Windows (nvkmd_rm_win.c): RM memory imported on a
+ * host DRM render node as a GEM object, once, and shown with ScanoutFlip
+ * through the Helios KMD.  The Win32 WSI uses this when the library has the
+ * Windows extras (nvkmd_rm_scanout_supported).
+ */
+bool nvkmd_rm_scanout_supported(struct nvkmd_pdev *pdev);
+VkResult nvkmd_rm_mem_export_scanout(struct nvkmd_mem *mem,
+                                     struct vk_object_base *log_obj);
+VkResult nvkmd_rm_mem_scanout_flip(struct nvkmd_mem *mem,
+                                   struct vk_object_base *log_obj,
+                                   uint32_t width, uint32_t height,
+                                   uint32_t stride, uint32_t offset,
+                                   uint32_t fourcc, uint64_t modifier);
+#endif
+
 /*
  * GPU virtual address ranges
  */
