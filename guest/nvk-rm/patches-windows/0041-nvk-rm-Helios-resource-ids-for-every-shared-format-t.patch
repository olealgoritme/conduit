+{
+   const struct nvkmd_rm_lib *lib = nvkmd_rm_lib_get();
+   uint32_t caps = 0;
+
+   if (!debug_get_bool_option("NVK_HELIOS_FORMATS", true))
+      return false;
+   if (lib == NULL || lib->win_foreign_caps == NULL ||
+       lib->win_import_rm_planes == NULL)
