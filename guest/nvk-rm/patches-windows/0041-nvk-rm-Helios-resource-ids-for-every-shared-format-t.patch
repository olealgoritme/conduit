+   if (lib->win_foreign_caps(&caps) != 0)
+      return false;
+   /* HELIOS_FOREIGN_CAP_RM_IMPORT | HELIOS_FOREIGN_CAP_LAYOUT_FORMATS */
+   return (caps & 1u) != 0 && (caps & (1u << 3)) != 0;
+}
