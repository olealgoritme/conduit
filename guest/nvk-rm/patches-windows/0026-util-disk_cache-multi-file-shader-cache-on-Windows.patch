@@ -451,6 +581,44 @@ make_cache_file_directory(struct disk_cache *cache, const cache_key key)
    free(dir);
 }
 
+#if DETECT_OS_WINDOWS
+/* Evict least recently used cache items: from a random two-character
+ * subdirectory, or the next one that has files.
+ */
+void
+disk_cache_evict_lru_item(struct disk_cache *cache)
+{
+   uint64_t rand64 = rand_xorshift128plus(cache->seed_xorshift128plus);
+
+   for (unsigned i = 0; i < 256; i++) {
+      char *dir_path;
+      if (asprintf(&dir_path, "%s/%02x", cache->path,
+                   (unsigned)((rand64 + i) & 0xff)) < 0)
+         return;
+
+      uint64_t size = unlink_lru_file_from_directory(dir_path);
+      free(dir_path);
+
+      if (size) {
+         p_atomic_add(&cache->size->value, - (uint64_t)size);
+         return;
+      }
+   }
+}
+
+void
+disk_cache_evict_item(struct disk_cache *cache, char *filename)
+{
+   WIN32_FILE_ATTRIBUTE_DATA data;
+   if (GetFileAttributesExA(filename, GetFileExInfoStandard, &data) &&
+       DeleteFileA(filename)) {
+      uint64_t size = ((uint64_t)data.nFileSizeHigh << 32) |
+                      data.nFileSizeLow;
+      p_atomic_add(&cache->size->value, - win32_disk_usage(size));
+   }
+   free(filename);
+}
+#else
 static ssize_t
 read_all(int fd, void *buf, size_t count)
 {
@@ -546,6 +714,7 @@ disk_cache_evict_item(struct disk_cache *cache, char *filename)
    if (sb.st_blocks)
       p_atomic_add(&cache->size->value, - (uint64_t)sb.st_blocks * 512);
 }
+#endif
 
 static void *
 parse_and_validate_cache_item(struct disk_cache *cache, void *cache_item,
@@ -629,6 +798,47 @@ parse_and_validate_cache_item(struct disk_cache *cache, void *cache_item,
    return NULL;
 }
 
+#if DETECT_OS_WINDOWS
+void *
+disk_cache_load_item(struct disk_cache *cache, char *filename, size_t *size)
+{
+   uint8_t *data = NULL;
+   uint8_t *uncompressed_data = NULL;
+
+   /* FILE_SHARE_DELETE: eviction may delete the file while it is read. */
+   HANDLE file = CreateFileA(filename, GENERIC_READ,
+                             FILE_SHARE_READ | FILE_SHARE_DELETE, NULL,
+                             OPEN_EXISTING, FILE_FLAG_SEQUENTIAL_SCAN, NULL);
+   free(filename);
+   if (file == INVALID_HANDLE_VALUE)
+      return NULL;
+
+   LARGE_INTEGER file_size;
+   if (!GetFileSizeEx(file, &file_size) || file_size.QuadPart == 0 ||
+       file_size.QuadPart > UINT32_MAX)
+      goto done;
+
+   DWORD len = (DWORD)file_size.QuadPart, done = 0;
+   data = malloc(len);
+   if (data == NULL)
+      goto done;
+
+   while (done < len) {
+      DWORD n;
+      if (!ReadFile(file, data + done, len - done, &n, NULL) || n == 0)
+         goto done;
+      done += n;
+   }
+
+   uncompressed_data = parse_and_validate_cache_item(cache, data, len, size);
+
+ done:
+   free(data);
+   CloseHandle(file);
+
+   return uncompressed_data;
+}
+#else
 void *
 disk_cache_load_item(struct disk_cache *cache, char *filename, size_t *size)
 {
@@ -670,6 +880,7 @@ disk_cache_load_item(struct disk_cache *cache, char *filename, size_t *size)
 
    return NULL;
 }
+#endif
 
 /* Return a filename within the cache's directory corresponding to 'key'.
  *
@@ -768,6 +979,103 @@ create_cache_item_header_and_blob(struct disk_cache_put_job *dc_job,
    return false;
 }
 
+#if DETECT_OS_WINDOWS
+/* Rename (or, with path NULL, delete on close) the file behind handle. */
+static bool
+win32_rename_or_delete_open_file(HANDLE handle, const char *path)
+{
+   if (!path) {
+      FILE_DISPOSITION_INFO disposition = { .DeleteFile = TRUE };
+      return SetFileInformationByHandle(handle, FileDispositionInfo,
+                                        &disposition, sizeof(disposition));
+   }
+
+   int wlen = MultiByteToWideChar(CP_ACP, 0, path, -1, NULL, 0);
+   if (wlen <= 0)
+      return false;
+
+   size_t info_size = sizeof(FILE_RENAME_INFO) + wlen * sizeof(WCHAR);
+   FILE_RENAME_INFO *info = calloc(1, info_size);
+   if (!info)
+      return false;
+
+   /* Like rename() after the POSIX flock: never replace an entry another
+    * process put in place meanwhile.
+    */
+   info->ReplaceIfExists = FALSE;
+   info->RootDirectory = NULL;
+   info->FileNameLength = (wlen - 1) * sizeof(WCHAR);
+   MultiByteToWideChar(CP_ACP, 0, path, -1, info->FileName, wlen);
+
+   bool ok = SetFileInformationByHandle(handle, FileRenameInfo, info,
+                                        info_size);
+   free(info);
+   return ok;
+}
+
+void
+disk_cache_write_item_to_disk(struct disk_cache_put_job *dc_job,
+                              char *filename)
+{
+   HANDLE file = INVALID_HANDLE_VALUE;
+   struct blob cache_blob;
+   blob_init(&cache_blob);
+
+   /* Write to a temporary file, then rename it to the final name while it
+    * is still open, so that readers never see a partial entry. The handle
+    * shares nothing: while one process writes the temporary file, another
+    * one fails to open it and leaves the entry to the first, as the POSIX
+    * code does with flock().
+    */
+   char *filename_tmp = NULL;
+   if (asprintf(&filename_tmp, "%s.tmp", filename) == -1)
+      goto done;
+
+   for (int attempt = 0; attempt < 2; attempt++) {
+      file = CreateFileA(filename_tmp, GENERIC_WRITE | DELETE, 0, NULL,
+                         CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+      if (file != INVALID_HANDLE_VALUE ||
+          GetLastError() != ERROR_PATH_NOT_FOUND)
+         break;
+
+      /* Make the two-character subdirectory within the cache as needed. */
+      make_cache_file_directory(dc_job->cache, dc_job->key);
+   }
+   if (file == INVALID_HANDLE_VALUE)
+      goto done;
+
+   /* Another process won the race between when we saw that the file didn't
+    * exist and now: leave it be, (to keep the size accounting right).
+    */
+   if (GetFileAttributesA(filename) != INVALID_FILE_ATTRIBUTES) {
+      win32_rename_or_delete_open_file(file, NULL);
+      goto done;
+   }
+
+   if (!create_cache_item_header_and_blob(dc_job, &cache_blob) ||
+       cache_blob.size > UINT32_MAX) {
+      win32_rename_or_delete_open_file(file, NULL);
+      goto done;
+   }
+
+   DWORD written;
+   if (!WriteFile(file, cache_blob.data, (DWORD)cache_blob.size, &written,
+                  NULL) || written != cache_blob.size ||
+       !win32_rename_or_delete_open_file(file, filename)) {
+      win32_rename_or_delete_open_file(file, NULL);
+      goto done;
+   }
+
+   p_atomic_add(&dc_job->cache->size->value,
+                win32_disk_usage(cache_blob.size));
+
+ done:
+   if (file != INVALID_HANDLE_VALUE)
+      CloseHandle(file);
+   free(filename_tmp);
+   blob_finish(&cache_blob);
+}
+#else
 void
 disk_cache_write_item_to_disk(struct disk_cache_put_job *dc_job,
                               char *filename)
@@ -874,6 +1182,7 @@ disk_cache_write_item_to_disk(struct disk_cache_put_job *dc_job,
    free(filename_tmp);
    blob_finish(&cache_blob);
 }
+#endif
 
