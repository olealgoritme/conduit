+#if DETECT_OS_WINDOWS
+struct win32_lru_file {
+   uint64_t atime;
+   uint64_t size;
+   char name[MAX_PATH];
+};
+
+static int
+win32_lru_file_compare(const void *a, const void *b)
+{
+   const struct win32_lru_file *fa = a, *fb = b;
+   return fa->atime < fb->atime ? -1 : fa->atime > fb->atime;
+}
+
+/* Delete the least recently used tenth (at least one) of the cache files in
+ * dir_path, skipping ".tmp" files being written.
+ *
+ * Returns: the disk space freed, (0 if nothing was deleted).
+ */
+static uint64_t
+unlink_lru_file_from_directory(const char *dir_path)
+{
+   char *pattern;
+   if (asprintf(&pattern, "%s/*", dir_path) == -1)
+      return 0;
+
+   WIN32_FIND_DATAA fd;
+   HANDLE find = FindFirstFileA(pattern, &fd);
+   free(pattern);
+   if (find == INVALID_HANDLE_VALUE)
+      return 0;
+
+   struct util_dynarray files;
+   util_dynarray_init(&files, NULL);
+   do {
+      if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)
+         continue;
+
+      size_t len = strlen(fd.cFileName);
+      if (len >= 4 && strcmp(&fd.cFileName[len - 4], ".tmp") == 0)
+         continue;
+
+      struct win32_lru_file *f =
+         util_dynarray_grow(&files, struct win32_lru_file, 1);
+      if (!f)
+         break;
+      f->atime = ((uint64_t)fd.ftLastAccessTime.dwHighDateTime << 32) |
+                 fd.ftLastAccessTime.dwLowDateTime;
+      f->size = ((uint64_t)fd.nFileSizeHigh << 32) | fd.nFileSizeLow;
+      snprintf(f->name, sizeof(f->name), "%s", fd.cFileName);
+   } while (FindNextFileA(find, &fd));
+   FindClose(find);
+
+   unsigned count =
+      util_dynarray_num_elements(&files, struct win32_lru_file);
+   uint64_t freed = 0;
+   if (count) {
+      qsort(files.data, count, sizeof(struct win32_lru_file),
+            win32_lru_file_compare);
+
+      unsigned lru_count = count > 10 ? count / 10 : 1;
+      for (unsigned i = 0; i < lru_count; i++) {
+         struct win32_lru_file *f =
+            util_dynarray_element(&files, struct win32_lru_file, i);
+         char *filename;
+         if (asprintf(&filename, "%s/%s", dir_path, f->name) == -1)
+            continue;
+         if (DeleteFileA(filename))
+            freed += win32_disk_usage(f->size);
+         free(filename);
+      }
+   }
+   util_dynarray_fini(&files);
+
+   return freed;
+}
+#else
 struct lru_file {
    struct list_head node;
    char *lru_name;
@@ -431,6 +560,7 @@ is_two_character_sub_directory(const char *path, const struct stat *sb,
 
    return true;
 }
+#endif
 
