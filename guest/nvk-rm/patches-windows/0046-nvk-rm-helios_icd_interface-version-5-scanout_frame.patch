From ffb0cfbfe276eda264e9d132a510c45ef7af7ca4 Mon Sep 17 00:00:00 2001
From: Ole Algoritme <olealgoritme@gmail.com>
Date: Tue, 6 Oct 2026 15:20:57 +0200
Subject: [PATCH] nvk/rm: helios_icd_interface version 5, scanout_frame (the
 KMD's seq and generation of a scanout frame)

The D3D UMD's already-on-scanout present tag (helios_onscanout.h,
docs/zero-copy-present.md section 15) must name the frame by the out_seq
SCANOUT_PRESENT returned for it and the out_generation of the live user
source. NVK already records both (nvkmd_rm_mem::scanout_seq,
nvkmd_rm_dev::source); scanout_frame hands them out for a memory, or
VK_NOT_READY when no live KMD source minted a frame of it.
---
 src/nouveau/vulkan/helios_icd_interface.h  | 13 ++++++++++-
 src/nouveau/vulkan/nvk_helios.c            | 26 ++++++++++++++++++++++
 src/nouveau/vulkan/nvkmd/rm/nvkmd_rm.h     | 10 +++++++++
 src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_win.c | 26 ++++++++++++++++++++++
 4 files changed, 74 insertions(+), 1 deletion(-)

diff --git a/src/nouveau/vulkan/helios_icd_interface.h b/src/nouveau/vulkan/helios_icd_interface.h
index 6b4b338..06fb02f 100644
--- a/src/nouveau/vulkan/helios_icd_interface.h
+++ b/src/nouveau/vulkan/helios_icd_interface.h
@@ -41,7 +41,7 @@ extern "C" {
 #define HELIOS_ICD_INTERFACE_EXPORT "helios_icd_interface_v2"
 /* The export keeps its name; version 3 only appends entries (and caps 4..6),
  * version 4 appends memory_res_plane1 (and cap 8). */
-#define HELIOS_ICD_INTERFACE_VERSION 4u
+#define HELIOS_ICD_INTERFACE_VERSION 5u
 
 enum helios_icd_backend {
    HELIOS_ICD_BACKEND_VENUS = 1,
@@ -238,6 +238,17 @@ struct helios_icd_api {
     * single-plane one (nothing to add to the version-1 trailer). */
    VkResult (*memory_res_plane1)(VkDevice device, VkImage image,
                                  struct helios_icd_plane *plane1);
+
+   /* ---- version 5 (size covers it; NULL = not supported) ----------------
+    * The KMD's names for the frame `memory` was last put on scanout with:
+    * *sequence = the out_seq SCANOUT_PRESENT returned for it, *generation =
+    * the out_generation SCANOUT_SET returned for the live user source
+    * (helios_nvrm_escape.h). For the already-on-scanout present tag
+    * (helios_onscanout.h, docs/zero-copy-present.md section 15). VK_SUCCESS
+    * with both nonzero; VK_NOT_READY (both 0) when no frame of this memory
+    * was minted by a live KMD source. */
+   VkResult (*scanout_frame)(VkDevice device, VkDeviceMemory memory,
+                             uint64_t *sequence, uint32_t *generation);
 };
 
 typedef VkResult (*PFN_helios_icd_interface_v2)(uint32_t version, struct helios_icd_api *out);
diff --git a/src/nouveau/vulkan/nvk_helios.c b/src/nouveau/vulkan/nvk_helios.c
index 11b0469..6c4ce03 100644
--- a/src/nouveau/vulkan/nvk_helios.c
+++ b/src/nouveau/vulkan/nvk_helios.c
@@ -463,6 +463,31 @@ helios_memory_res_plane1(VkDevice _device, VkImage _image,
    return VK_SUCCESS;
 }
 
+/* helios_icd_interface.h version 5 */
+static VkResult
+helios_scanout_frame(VkDevice _device, VkDeviceMemory _mem, uint64_t *sequence,
+                     uint32_t *generation)
+{
+   VK_FROM_HANDLE(nvk_device, dev, _device);
+   VK_FROM_HANDLE(nvk_device_memory, mem, _mem);
+
+   if (sequence != NULL)
+      *sequence = 0;
+   if (generation != NULL)
+      *generation = 0;
+   if (dev == NULL || mem == NULL || sequence == NULL || generation == NULL)
+      return VK_NOT_READY;
+
+   uint64_t seq = 0;
+   uint32_t gen = 0;
+   if (!nvkmd_rm_mem_scanout_frame(mem->mem, &seq, &gen) || seq == 0 ||
+       gen == 0)
+      return VK_NOT_READY;
+   *sequence = seq;
+   *generation = gen;
+   return VK_SUCCESS;
+}
+
 static void
 helios_scanout_release(VkDevice _device)
 {
@@ -530,6 +555,7 @@ helios_icd_interface_v2(uint32_t version, struct helios_icd_api *out)
       .rm_fence_close = helios_rm_fence_close,
       .scanout_present_fenced = helios_scanout_present_fenced,
       .memory_res_plane1 = helios_memory_res_plane1,
+      .scanout_frame = helios_scanout_frame,
    };
    memcpy(out, &api, cap);
    return VK_SUCCESS;
diff --git a/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm.h b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm.h
index 5a96fb5..5af9d15 100644
--- a/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm.h
+++ b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm.h
@@ -264,6 +264,10 @@ struct nvkmd_rm_dev {
    bool no_kmd_source;
    bool source_live;
    struct nvrm_crm_scanout_source source;
+   /* source.generation while source_live (the KMD source), else 0; written
+    * under drm_mutex, read lock-free (nvkmd_rm_mem_scanout_frame).
+    */
+   uint32_t source_gen_live;
 
    /* RM fences for presents (nvkmd_rm_rmfence.c, dxvk-on-nvk S4), made on
     * first use under rmfence_mutex.
@@ -506,6 +510,12 @@ VkResult nvkmd_rm_mem_scanout_flip(struct nvkmd_mem *mem,
                                    uint32_t fourcc, uint64_t modifier);
 /* Gives scanout 0 back to the desktop (no-op without a live source) */
 void nvkmd_rm_dev_scanout_release(struct nvkmd_dev *dev);
+/* The KMD's seq of `mem`'s latest flip through the live user source and that
+ * source's generation; false (both 0) without a live KMD source or a minted
+ * seq (helios_icd_interface.h scanout_frame).
+ */
+bool nvkmd_rm_mem_scanout_frame(struct nvkmd_mem *mem, uint64_t *seq,
+                                uint32_t *generation);
 
 /*
  * RM fences for presents (nvkmd_rm_rmfence.c; guest/windows/docs/
diff --git a/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_win.c b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_win.c
index d3c8dd1..99af8f0 100644
--- a/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_win.c
+++ b/src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_win.c
@@ -287,6 +287,7 @@ nvkmd_rm_win_source_set_locked(struct nvkmd_rm_dev *dev,
    if (ret == 0) {
       dev->source = src;
       dev->source_live = true;
+      p_atomic_set(&dev->source_gen_live, src.generation);
       if (dev->base.pdev->debug_flags & NVK_DEBUG_VM) {
          fprintf(stderr, "NVK: scanout source %u: %ux%u stride %u fourcc "
                  "0x%08x modifier 0x%" PRIx64 ", lapse %u ms\n",
@@ -345,6 +346,7 @@ kmd_source_present(struct nvkmd_rm_dev *dev,
    if (ret == -ENOENT) {
       /* The source lapsed (or the KMD reset): register it again */
       dev->source_live = false;
+      p_atomic_set(&dev->source_gen_live, 0);
       ret = nvkmd_rm_win_source_set_locked(dev, flip);
       if (ret == 0)
          ret = lib->win_scanout_present(flip->owner_handle,
@@ -372,9 +374,33 @@ nvkmd_rm_dev_scanout_release(struct nvkmd_dev *_dev)
                  dev->source.generation, ret);
    }
    dev->source_live = false;
+   p_atomic_set(&dev->source_gen_live, 0);
    simple_mtx_unlock(&dev->drm_mutex);
 }
 
+bool
+nvkmd_rm_mem_scanout_frame(struct nvkmd_mem *_mem, uint64_t *seq,
+                           uint32_t *generation)
+{
+   struct nvkmd_rm_mem *mem = nvkmd_rm_mem(_mem);
+   struct nvkmd_rm_dev *dev = nvkmd_rm_dev(_mem->dev);
+
+   *seq = 0;
+   *generation = 0;
+   /* Lock-free: drm_mutex is held across the flip escapes, and this runs
+    * on the presenting thread for every composed frame.
+    */
+   const uint32_t gen = p_atomic_read(&dev->source_gen_live);
+   if (gen == 0)
+      return false;
+   const uint64_t s = p_atomic_read(&mem->scanout_seq);
+   if (s == 0)
+      return false;
+   *seq = s;
+   *generation = gen;
+   return true;
+}
+
 VkResult
 nvkmd_rm_mem_scanout_flip(struct nvkmd_mem *_mem,
                           struct vk_object_base *log_obj,
-- 
2.43.0

