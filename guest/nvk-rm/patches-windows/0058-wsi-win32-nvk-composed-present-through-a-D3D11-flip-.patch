+/*
+ * Composed present for the Win32 WSI (Conduit's Helios adapter,
+ * wsi_device::win32.compose_import, NVK_HELIOS_WSI_COMPOSE=1).
+ *
+ * A window's frames reach DWM the way a D3D11 application's do: the WSI
+ * creates a D3D11 device on the Helios adapter (the Helios D3D11 driver,
+ * itself on NVK) and a DXGI flip-model swap chain for the window.  Every
+ * Vulkan swapchain image is a D3D11 shared texture: the WSI opens it once
+ * through D3DKMT to read what the Helios KMD records for an allocation
+ * (its resource id, size and layout, HeliosWddmOpenIdentity and
+ * HeliosWddmAllocLayout), and the Vulkan driver imports that resource id
+ * into the application's device (compose_import), so the application
+ * renders straight into the texture.  A present copies the texture into the
+ * swap chain's back buffer on the D3D11 device and calls Present; the
+ * Helios D3D11 driver's composed present does the rest.
+ *
+ * Kept in a file of its own because d3d11.h and the DirectX-Headers'
+ * d3d12.h that wsi_common_win32.cpp includes do not mix.
+ */
+
+#include "wsi_common_private.h"
+
+#include <windows.h>
+#include <d3d11.h>
+#include <dxgi1_2.h>
+#include <stdio.h>
+#include <string.h>
+#include <wchar.h>
+
+#include "util/log.h"
+#include "util/u_debug.h"
+
+/* ---- D3DKMT, the subset this needs (d3dkmthk.h is not in MinGW) ------- */
+
+typedef UINT WSI_D3DKMT_HANDLE;
+typedef LONG WSI_NTSTATUS;
+
+struct wsi_kmt_open_adapter_from_luid {
+   LUID AdapterLuid;
+   WSI_D3DKMT_HANDLE hAdapter;
+};
+struct wsi_kmt_create_device {
+   union { WSI_D3DKMT_HANDLE hAdapter; VOID *pAdapter; };
+   UINT Flags;
+   WSI_D3DKMT_HANDLE hDevice;
+   VOID *pCommandBuffer;
+   UINT CommandBufferSize;
+   VOID *pAllocationList;
+   UINT AllocationListSize;
+   VOID *pPatchLocationList;
+   UINT PatchLocationListSize;
+};
+struct wsi_kmt_query_resource_info {
+   WSI_D3DKMT_HANDLE hDevice;
+   WSI_D3DKMT_HANDLE hGlobalShare;
+   VOID *pPrivateRuntimeData;
+   UINT PrivateRuntimeDataSize;
+   UINT TotalPrivateDriverDataSize;
+   UINT ResourcePrivateDriverDataSize;
+   UINT NumAllocations;
+};
+struct wsi_kmt_open_allocation_info {
+   WSI_D3DKMT_HANDLE hAllocation;
+   CONST VOID *pPrivateDriverData;
+   UINT PrivateDriverDataSize;
+};
+struct wsi_kmt_open_resource {
+   WSI_D3DKMT_HANDLE hDevice;
+   WSI_D3DKMT_HANDLE hGlobalShare;
+   UINT NumAllocations;
+   struct wsi_kmt_open_allocation_info *pOpenAllocationInfo;
+   VOID *pPrivateRuntimeData;
+   UINT PrivateRuntimeDataSize;
+   VOID *pResourcePrivateDriverData;
+   UINT ResourcePrivateDriverDataSize;
+   VOID *pTotalPrivateDriverDataBuffer;
+   UINT TotalPrivateDriverDataBufferSize;
+   WSI_D3DKMT_HANDLE hResource;
+};
+struct wsi_kmt_destroy_allocation {
+   WSI_D3DKMT_HANDLE hDevice;
+   WSI_D3DKMT_HANDLE hResource;
+   CONST WSI_D3DKMT_HANDLE *phAllocationList;
+   UINT AllocationCount;
+};
+struct wsi_kmt_destroy_device {
+   WSI_D3DKMT_HANDLE hDevice;
+};
+struct wsi_kmt_close_adapter {
+   WSI_D3DKMT_HANDLE hAdapter;
+};
+
+typedef WSI_NTSTATUS (APIENTRY *PFN_kmt_open_adapter_from_luid)(struct wsi_kmt_open_adapter_from_luid *);
+typedef WSI_NTSTATUS (APIENTRY *PFN_kmt_create_device)(struct wsi_kmt_create_device *);
+typedef WSI_NTSTATUS (APIENTRY *PFN_kmt_query_resource_info)(struct wsi_kmt_query_resource_info *);
+typedef WSI_NTSTATUS (APIENTRY *PFN_kmt_open_resource)(struct wsi_kmt_open_resource *);
+typedef WSI_NTSTATUS (APIENTRY *PFN_kmt_destroy_allocation)(const struct wsi_kmt_destroy_allocation *);
+typedef WSI_NTSTATUS (APIENTRY *PFN_kmt_destroy_device)(const struct wsi_kmt_destroy_device *);
+typedef WSI_NTSTATUS (APIENTRY *PFN_kmt_close_adapter)(const struct wsi_kmt_close_adapter *);
+
+/* ---- What the Helios KMD writes into an open's allocation data --------
+ * Conduit guest/windows/protocol/src/wddm.rs, docs/shared-foreign-surfaces.md
+ * section 2: bytes 0..48 HeliosWddmOpenIdentity, 48..96 HeliosWddmAllocMeta,
+ * 96..128 HeliosWddmAllocLayout.
+ */
+struct wsi_helios_open_identity {
+   uint64_t venus_alloc_size;
+   uint64_t blob_size;
+   uint32_t magic;            /* 'HIDN' */
+   uint32_t version;          /* >= 2 */
+   uint32_t resource_id;
+   uint32_t memory_type_index;
+   uint32_t ctx_id;
+   uint32_t kind;             /* 1: device memory */
+   uint32_t reserved[2];      /* [0] bit 0: foreign (RM) resource, [1] 0 */
+};
+struct wsi_helios_alloc_layout {
+   uint64_t modifier;
+   uint32_t magic;            /* 'HFLY' */
+   uint32_t version;          /* 1 */
+   uint32_t fourcc;
+   uint32_t stride;
+   uint32_t plane_offset;
+   uint32_t reserved;
+};
+static_assert(sizeof(struct wsi_helios_open_identity) == 48, "identity");
+static_assert(sizeof(struct wsi_helios_alloc_layout) == 32, "layout");
+#define WSI_HELIOS_IDENTITY_MAGIC 0x4849444Eu
+#define WSI_HELIOS_LAYOUT_MAGIC   0x594C4648u
+#define WSI_HELIOS_LAYOUT_OFFSET  96u
+#define WSI_HELIOS_PRIVATE_BYTES  128u
+
+/* ---- State ------------------------------------------------------------ */
+
+struct wsi_win32_compose {
+   HWND hwnd;
+   ID3D11Device *device;
+   ID3D11DeviceContext *context;
+   IDXGISwapChain1 *swapchain;
+   DXGI_FORMAT format;
+   UINT buffers;
+   LUID luid;
+   WSI_D3DKMT_HANDLE kmt_adapter;
+   WSI_D3DKMT_HANDLE kmt_device;
+   bool first_present_logged;
+   uint32_t present_failures;
+};
+
+static struct {
+   bool loaded;
+   PFN_D3D11_CREATE_DEVICE create_device;
+   HRESULT (WINAPI *create_factory1)(REFIID, void **);
+   PFN_kmt_open_adapter_from_luid open_adapter_from_luid;
+   PFN_kmt_create_device kmt_create_device;
+   PFN_kmt_query_resource_info query_resource_info;
+   PFN_kmt_open_resource open_resource;
+   PFN_kmt_destroy_allocation destroy_allocation;
+   PFN_kmt_destroy_device destroy_device;
+   PFN_kmt_close_adapter close_adapter;
+} fn;
+
+#define LOGI(...) mesa_logi("MESA-WSI: compose: " __VA_ARGS__)
+#define LOGE(...) mesa_loge("MESA-WSI: compose: " __VA_ARGS__)
+
+static bool
+compose_load(void)
+{
+   if (fn.loaded)
+      return fn.create_device != NULL;
+   fn.loaded = true;
+
+   HMODULE d3d11 = LoadLibraryA("d3d11.dll");
+   HMODULE dxgi = LoadLibraryA("dxgi.dll");
+   HMODULE gdi = LoadLibraryA("gdi32.dll");
+   if (!d3d11 || !dxgi || !gdi) {
+      LOGE("d3d11.dll, dxgi.dll or gdi32.dll did not load");
+      return false;
+   }
+#define GET(mod, field, name) \
+   fn.field = (decltype(fn.field))(void *)GetProcAddress(mod, name)
+   GET(d3d11, create_device, "D3D11CreateDevice");
+   GET(dxgi, create_factory1, "CreateDXGIFactory1");
+   GET(gdi, open_adapter_from_luid, "D3DKMTOpenAdapterFromLuid");
+   GET(gdi, kmt_create_device, "D3DKMTCreateDevice");
+   GET(gdi, query_resource_info, "D3DKMTQueryResourceInfo");
+   GET(gdi, open_resource, "D3DKMTOpenResource");
+   GET(gdi, destroy_allocation, "D3DKMTDestroyAllocation");
+   GET(gdi, destroy_device, "D3DKMTDestroyDevice");
+   GET(gdi, close_adapter, "D3DKMTCloseAdapter");
+#undef GET
+   if (!fn.create_device || !fn.create_factory1 || !fn.open_adapter_from_luid ||
+       !fn.kmt_create_device || !fn.query_resource_info || !fn.open_resource ||
+       !fn.destroy_allocation || !fn.destroy_device || !fn.close_adapter) {
+      LOGE("a D3D11, DXGI or D3DKMT entry point is missing");
+      fn.create_device = NULL;
+      return false;
+   }
+   return true;
+}
+
+static DXGI_FORMAT
+compose_format(VkFormat format)
+{
+   switch (format) {
+   case VK_FORMAT_B8G8R8A8_UNORM:
+   case VK_FORMAT_B8G8R8A8_SRGB:
+      return DXGI_FORMAT_B8G8R8A8_UNORM;
+   case VK_FORMAT_R8G8B8A8_UNORM:
+   case VK_FORMAT_R8G8B8A8_SRGB:
+      return DXGI_FORMAT_R8G8B8A8_UNORM;
+   default:
+      return DXGI_FORMAT_UNKNOWN;
+   }
+}
+
+bool
+wsi_win32_compose_format_supported(VkFormat format)
+{
+   return compose_format(format) != DXGI_FORMAT_UNKNOWN;
+}
+
+/* The Helios adapter: MESA_WSI_COMPOSE_ADAPTER=<index> or the first whose
+ * description names Helios. */
+static IDXGIAdapter1 *
+compose_adapter(void)
+{
+   IDXGIFactory1 *factory = NULL;
+   if (FAILED(fn.create_factory1(__uuidof(IDXGIFactory1), (void **)&factory)))
+      return NULL;
+   const int forced = (int)debug_get_num_option("MESA_WSI_COMPOSE_ADAPTER", -1);
+   IDXGIAdapter1 *found = NULL;
+   IDXGIAdapter1 *adapter = NULL;
+   for (UINT i = 0; factory->EnumAdapters1(i, &adapter) != DXGI_ERROR_NOT_FOUND; i++) {
+      DXGI_ADAPTER_DESC1 desc;
+      adapter->GetDesc1(&desc);
+      const bool pick = forced >= 0 ? (int)i == forced :
+                        wcsstr(desc.Description, L"Helios") != NULL;
+      if (pick && !found) {
+         found = adapter;
+         continue;
+      }
+      adapter->Release();
+   }
+   factory->Release();
+   return found;
+}
+
+static void
+compose_release_device(struct wsi_win32_compose *c)
+{
+   if (c->swapchain) {
+      c->swapchain->Release();
+      c->swapchain = NULL;
+   }
+   if (c->context) {
+      c->context->ClearState();
+      c->context->Flush();
+      c->context->Release();
+      c->context = NULL;
+   }
+   if (c->device) {
+      c->device->Release();
+      c->device = NULL;
+   }
+   if (c->kmt_device) {
+      struct wsi_kmt_destroy_device d = { c->kmt_device };
+      fn.destroy_device(&d);
+      c->kmt_device = 0;
+   }
+   if (c->kmt_adapter) {
+      struct wsi_kmt_close_adapter a = { c->kmt_adapter };
+      fn.close_adapter(&a);
+      c->kmt_adapter = 0;
+   }
+}
+
+VkResult
+wsi_win32_compose_open(struct wsi_win32_compose **inout, void *window,
+                       uint32_t width, uint32_t height, VkFormat vk_format,
+                       uint32_t buffers)
+{
+   HWND hwnd = (HWND)window;
+   const DXGI_FORMAT format = compose_format(vk_format);
+   if (format == DXGI_FORMAT_UNKNOWN) {
+      LOGE("format %d has no composed path", (int)vk_format);
+      return VK_ERROR_FORMAT_NOT_SUPPORTED;
+   }
+   if (!compose_load())
+      return VK_ERROR_INITIALIZATION_FAILED;
+
+   buffers = buffers < 2 ? 2 : buffers > 3 ? 3 : buffers;
+   struct wsi_win32_compose *c = *inout;
+   if (c && c->hwnd == hwnd && c->swapchain) {
+      /* A new Vulkan swapchain on the same window (resize, format): the
+       * DXGI swap chain stays, with new buffers. */
+      c->context->ClearState();
+      c->context->Flush();
+      HRESULT hr = c->swapchain->ResizeBuffers(buffers, width, height, format, 0);
+      if (FAILED(hr)) {
+         LOGE("ResizeBuffers(%u, %ux%u, format %d) failed: 0x%08lx",
+              buffers, width, height, (int)format, (unsigned long)hr);
+         return VK_ERROR_INITIALIZATION_FAILED;
+      }
+      c->format = format;
+      c->buffers = buffers;
+      LOGI("DXGI swap chain resized: %ux%u, format %d, %u buffers",
+           width, height, (int)format, buffers);
+      return VK_SUCCESS;
+   }
+
+   if (!c) {
+      c = (struct wsi_win32_compose *)calloc(1, sizeof(*c));
+      if (!c)
+         return VK_ERROR_OUT_OF_HOST_MEMORY;
+      *inout = c;
+   }
+   compose_release_device(c);
+   c->hwnd = hwnd;
+
+   IDXGIAdapter1 *adapter = compose_adapter();
+   if (!adapter) {
+      LOGE("no Helios DXGI adapter (MESA_WSI_COMPOSE_ADAPTER picks one by index)");
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+   DXGI_ADAPTER_DESC1 adesc;
+   adapter->GetDesc1(&adesc);
+   c->luid = adesc.AdapterLuid;
+
+   static const D3D_FEATURE_LEVEL levels[] = {
+      D3D_FEATURE_LEVEL_11_1, D3D_FEATURE_LEVEL_11_0,
+   };
+   D3D_FEATURE_LEVEL got;
+   HRESULT hr = fn.create_device(adapter, D3D_DRIVER_TYPE_UNKNOWN, NULL,
+                                 D3D11_CREATE_DEVICE_BGRA_SUPPORT,
+                                 levels, 2, D3D11_SDK_VERSION,
+                                 &c->device, &got, &c->context);
+   if (FAILED(hr)) {
+      adapter->Release();
+      LOGE("D3D11CreateDevice on %ls failed: 0x%08lx", adesc.Description,
+           (unsigned long)hr);
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+
+   IDXGIFactory2 *factory = NULL;
+   hr = adapter->GetParent(__uuidof(IDXGIFactory2), (void **)&factory);
+   adapter->Release();
+   if (FAILED(hr)) {
+      LOGE("no IDXGIFactory2: 0x%08lx", (unsigned long)hr);
+      compose_release_device(c);
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+
+   DXGI_SWAP_CHAIN_DESC1 desc = {};
+   desc.Width = width;
+   desc.Height = height;
+   desc.Format = format;
+   desc.SampleDesc.Count = 1;
+   desc.BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT;
+   desc.BufferCount = buffers;
+   desc.Scaling = DXGI_SCALING_STRETCH;
+   desc.SwapEffect = DXGI_SWAP_EFFECT_FLIP_DISCARD;
+   desc.AlphaMode = DXGI_ALPHA_MODE_IGNORE;
+   hr = factory->CreateSwapChainForHwnd(c->device, hwnd, &desc, NULL, NULL,
+                                        &c->swapchain);
+   if (SUCCEEDED(hr))
+      factory->MakeWindowAssociation(hwnd, DXGI_MWA_NO_WINDOW_CHANGES |
+                                           DXGI_MWA_NO_ALT_ENTER);
+   factory->Release();
+   if (FAILED(hr)) {
+      LOGE("CreateSwapChainForHwnd(%ux%u, format %d) failed: 0x%08lx",
+           width, height, (int)format, (unsigned long)hr);
+      compose_release_device(c);
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+
+   struct wsi_kmt_open_adapter_from_luid oa = {};
+   oa.AdapterLuid = c->luid;
+   WSI_NTSTATUS st = fn.open_adapter_from_luid(&oa);
+   if (st < 0) {
+      LOGE("D3DKMTOpenAdapterFromLuid failed: 0x%08lx", (unsigned long)st);
+      compose_release_device(c);
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+   c->kmt_adapter = oa.hAdapter;
+   struct wsi_kmt_create_device cd = {};
+   cd.hAdapter = c->kmt_adapter;
+   st = fn.kmt_create_device(&cd);
+   if (st < 0) {
+      LOGE("D3DKMTCreateDevice failed: 0x%08lx", (unsigned long)st);
+      compose_release_device(c);
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+   c->kmt_device = cd.hDevice;
+   c->format = format;
+   c->buffers = buffers;
+
+   LOGI("D3D11 device (feature level 0x%x) and DXGI flip swap chain created "
+        "on %ls: %ux%u, format %d, %u buffers",
+        (unsigned)got, adesc.Description, width, height, (int)format, buffers);
+   return VK_SUCCESS;
+}
+
+void
+wsi_win32_compose_destroy(struct wsi_win32_compose *c)
+{
+   if (!c)
+      return;
+   compose_release_device(c);
+   free(c);
+}
+
+/* Reads the Helios KMD's record of a shared allocation by opening it */
+static VkResult
+compose_read_record(struct wsi_win32_compose *c, HANDLE share,
+                    struct wsi_win32_compose_image *img,
+                    struct wsi_win32_compose_import *imp)
+{
+   struct wsi_kmt_query_resource_info q = {};
+   q.hDevice = c->kmt_device;
+   q.hGlobalShare = (WSI_D3DKMT_HANDLE)(uintptr_t)share;
+   WSI_NTSTATUS st = fn.query_resource_info(&q);
+   if (st < 0 || q.NumAllocations == 0) {
+      LOGE("D3DKMTQueryResourceInfo(0x%x) failed: 0x%08lx, %u allocations",
+           q.hGlobalShare, (unsigned long)st, q.NumAllocations);
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+
+   void *runtime = calloc(1, q.PrivateRuntimeDataSize ? q.PrivateRuntimeDataSize : 1);
+   void *resdata = calloc(1, q.ResourcePrivateDriverDataSize ? q.ResourcePrivateDriverDataSize : 1);
+   void *total = calloc(1, q.TotalPrivateDriverDataSize ? q.TotalPrivateDriverDataSize : 1);
+   struct wsi_kmt_open_allocation_info *allocs =
+      (struct wsi_kmt_open_allocation_info *)calloc(q.NumAllocations, sizeof(*allocs));
+   VkResult result = VK_ERROR_INITIALIZATION_FAILED;
+   if (!runtime || !resdata || !total || !allocs)
+      goto out;
+
+   {
+      struct wsi_kmt_open_resource o = {};
+      o.hDevice = c->kmt_device;
+      o.hGlobalShare = q.hGlobalShare;
+      o.NumAllocations = q.NumAllocations;
+      o.pOpenAllocationInfo = allocs;
+      o.pPrivateRuntimeData = runtime;
+      o.PrivateRuntimeDataSize = q.PrivateRuntimeDataSize;
+      o.pResourcePrivateDriverData = resdata;
+      o.ResourcePrivateDriverDataSize = q.ResourcePrivateDriverDataSize;
+      o.pTotalPrivateDriverDataBuffer = total;
+      o.TotalPrivateDriverDataBufferSize = q.TotalPrivateDriverDataSize;
+      st = fn.open_resource(&o);
+      if (st < 0) {
+         LOGE("D3DKMTOpenResource(0x%x) failed: 0x%08lx", q.hGlobalShare,
+              (unsigned long)st);
+         goto out;
+      }
+      img->kmt_resource = o.hResource;
+
+      const struct wsi_kmt_open_allocation_info *a = &allocs[0];
+      if (a->pPrivateDriverData == NULL ||
+          a->PrivateDriverDataSize < WSI_HELIOS_PRIVATE_BYTES) {
+         LOGE("allocation data of %u bytes: not a Helios record with a layout",
+              a->PrivateDriverDataSize);
+         goto out;
+      }
+      struct wsi_helios_open_identity id;
+      struct wsi_helios_alloc_layout lay;
+      memcpy(&id, a->pPrivateDriverData, sizeof(id));
+      memcpy(&lay, (const uint8_t *)a->pPrivateDriverData + WSI_HELIOS_LAYOUT_OFFSET,
+             sizeof(lay));
+      const bool foreign = id.reserved[0] & 1 && id.reserved[1] == 0;
+      if (id.magic != WSI_HELIOS_IDENTITY_MAGIC || id.version < 2 ||
+          id.resource_id == 0 || id.kind != 1 || !foreign) {
+         LOGE("open identity magic 0x%08x version %u resource %u kind %u "
+              "flags 0x%x/0x%x: not an NVK (RM) resource; is the D3D11 driver "
+              "on Venus?", id.magic, id.version, id.resource_id, id.kind,
+              id.reserved[0], id.reserved[1]);
+         goto out;
+      }
+      if (lay.magic != WSI_HELIOS_LAYOUT_MAGIC || lay.version != 1) {
+         LOGE("layout trailer magic 0x%08x version %u: none recorded",
+              lay.magic, lay.version);
+         goto out;
+      }
+      imp->resource_id = id.resource_id;
+      imp->size = id.blob_size;
+      imp->modifier = lay.modifier;
+      imp->stride = lay.stride;
+      imp->offset = lay.plane_offset;
+      result = VK_SUCCESS;
+   }
+
+out:
+   free(runtime);
+   free(resdata);
+   free(total);
+   free(allocs);
+   return result;
+}
+
+VkResult
+wsi_win32_compose_image_create(struct wsi_win32_compose *c, uint32_t width,
+                               uint32_t height,
+                               struct wsi_win32_compose_image *img,
+                               struct wsi_win32_compose_import *imp)
+{
+   memset(img, 0, sizeof(*img));
+   D3D11_TEXTURE2D_DESC td = {};
+   td.Width = width;
+   td.Height = height;
+   td.MipLevels = 1;
+   td.ArraySize = 1;
+   td.Format = c->format;
+   td.SampleDesc.Count = 1;
+   td.Usage = D3D11_USAGE_DEFAULT;
+   td.BindFlags = D3D11_BIND_RENDER_TARGET | D3D11_BIND_SHADER_RESOURCE;
+   td.MiscFlags = D3D11_RESOURCE_MISC_SHARED;
+   ID3D11Texture2D *tex = NULL;
+   HRESULT hr = c->device->CreateTexture2D(&td, NULL, &tex);
+   if (FAILED(hr)) {
+      LOGE("CreateTexture2D(%ux%u shared) failed: 0x%08lx", width, height,
+           (unsigned long)hr);
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   }
+   img->texture = tex;
+
+   IDXGIResource *res = NULL;
+   HANDLE share = NULL;
+   hr = tex->QueryInterface(__uuidof(IDXGIResource), (void **)&res);
+   if (SUCCEEDED(hr)) {
+      hr = res->GetSharedHandle(&share);
+      res->Release();
+   }
+   if (FAILED(hr) || share == NULL) {
+      LOGE("no shared handle for the texture: 0x%08lx", (unsigned long)hr);
+      wsi_win32_compose_image_destroy(c, img);
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+
+   VkResult result = compose_read_record(c, share, img, imp);
+   if (result != VK_SUCCESS) {
+      wsi_win32_compose_image_destroy(c, img);
+      return result;
+   }
+
+   D3D11_QUERY_DESC qd = { D3D11_QUERY_EVENT, 0 };
+   ID3D11Query *query = NULL;
+   if (SUCCEEDED(c->device->CreateQuery(&qd, &query)))
+      img->query = query;
+
+   LOGI("shared texture %ux%u: resource id %u, %llu bytes, modifier 0x%016llx, "
+        "stride %u, offset %u", width, height, imp->resource_id,
+        (unsigned long long)imp->size, (unsigned long long)imp->modifier,
+        imp->stride, imp->offset);
+   return VK_SUCCESS;
+}
+
+void
+wsi_win32_compose_image_destroy(struct wsi_win32_compose *c,
+                                struct wsi_win32_compose_image *img)
+{
+   if (img->query)
+      ((ID3D11Query *)img->query)->Release();
+   if (img->texture)
+      ((ID3D11Texture2D *)img->texture)->Release();
+   if (img->kmt_resource && c && c->kmt_device) {
+      struct wsi_kmt_destroy_allocation d = {};
+      d.hDevice = c->kmt_device;
+      d.hResource = img->kmt_resource;
+      fn.destroy_allocation(&d);
+   }
+   memset(img, 0, sizeof(*img));
+}
+
+VkResult
+wsi_win32_compose_present(struct wsi_win32_compose *c,
+                          struct wsi_win32_compose_image *img,
+                          uint32_t sync_interval)
+{
+   ID3D11Texture2D *back = NULL;
+   HRESULT hr = c->swapchain->GetBuffer(0, __uuidof(ID3D11Texture2D), (void **)&back);
+   if (FAILED(hr)) {
+      if (c->present_failures++ < 8)
+         LOGE("GetBuffer failed: 0x%08lx", (unsigned long)hr);
+      return hr == DXGI_ERROR_DEVICE_REMOVED ? VK_ERROR_DEVICE_LOST :
+                                               VK_ERROR_OUT_OF_DATE_KHR;
+   }
+   c->context->CopyResource(back, (ID3D11Texture2D *)img->texture);
+   back->Release();
+
+   hr = c->swapchain->Present(sync_interval, 0);
+   if (FAILED(hr)) {
+      if (c->present_failures++ < 8)
+         LOGE("Present(%u) failed: 0x%08lx", sync_interval, (unsigned long)hr);
+      if (hr == DXGI_ERROR_DEVICE_REMOVED || hr == DXGI_ERROR_DEVICE_RESET)
+         return VK_ERROR_DEVICE_LOST;
+      return VK_ERROR_OUT_OF_DATE_KHR;
+   }
+
+   /* The application may draw into the image again once acquire hands it
+    * back: wait for the copy out of it first. */
+   if (img->query) {
+      ID3D11Query *q = (ID3D11Query *)img->query;
+      c->context->End(q);
+      c->context->Flush();
+      const ULONGLONG deadline = GetTickCount64() + 2000;
+      BOOL done = FALSE;
+      while ((hr = c->context->GetData(q, &done, sizeof(done), 0)) == S_FALSE ||
+             (hr == S_OK && !done)) {
+         if (GetTickCount64() > deadline) {
+            if (c->present_failures++ < 8)
+               LOGE("the copy into the back buffer did not finish in 2 s");
+            break;
+         }
+         SwitchToThread();
+      }
+   }
+
+   if (!c->first_present_logged) {
+      c->first_present_logged = true;
+      LOGI("first composed present done (sync interval %u)", sync_interval);
+   }
+   return VK_SUCCESS;
+}
