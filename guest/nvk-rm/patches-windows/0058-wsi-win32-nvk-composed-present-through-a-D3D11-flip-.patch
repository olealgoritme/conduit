+/* What a composed present's swapchain image is (wsi_device::win32.
+ * compose_import): the Helios resource id of a D3D11 shared texture, the
+ * object's size and the layout the image must have.
+ */
+struct wsi_win32_compose_import {
+   uint32_t resource_id;
+   uint64_t size;
+   uint64_t modifier;
+   uint32_t stride;
+   uint32_t offset;
+};
+
 /* What wsi_device::win32.scanout_flip shows: plane 0 of the memory */
 struct wsi_win32_scanout_flip {
    uint32_t width, height;
@@ -201,6 +213,19 @@ struct wsi_device {
                                         uint64_t timeout_ns);
       void (*scanout_release)(VkDevice device);
       bool scanout_linear;
+
+      /* Composed presentation (Conduit Helios, opt-in): window swapchains
+       * present through a DXGI flip swap chain of a D3D11 device on the
+       * same adapter, so DWM composes them like a D3D11 application's
+       * frames.  Each swapchain image is a D3D11 shared texture; the WSI
+       * reads its resource id and layout and the driver imports it as the
+       * image's (dedicated) memory here, so the application renders into
+       * the texture itself.  NULL: no composed path.  A failure anywhere
+       * makes the swapchain fall back to scanout or GDI.
+       */
+      VkResult (*compose_import)(VkDevice device, VkImage image,
+                                 const struct wsi_win32_compose_import *import,
+                                 VkDeviceMemory *memory);
    } win32;
 
    struct {
diff --git a/src/vulkan/wsi/wsi_common_private.h b/src/vulkan/wsi/wsi_common_private.h
