 create mode 100644 src/vulkan/wsi/wsi_common_win32_compose.cpp

diff --git a/src/nouveau/vulkan/nvk_wsi.c b/src/nouveau/vulkan/nvk_wsi.c
index b9d73808..689b03f4 100644
--- a/src/nouveau/vulkan/nvk_wsi.c
+++ b/src/nouveau/vulkan/nvk_wsi.c
@@ -10,8 +10,10 @@
 #ifdef _WIN32
 #include "nvk_device.h"
 #include "nvk_device_memory.h"
+#include "nvk_entrypoints.h"
 #include "nvk_image.h"
 #include "nvkmd/rm/nvkmd_rm.h"
+#include "helios_icd_interface.h"
 #include "drm-uapi/drm_fourcc.h"
 #include "util/u_debug.h"
 #include "vk_queue.h"
@@ -130,6 +132,61 @@ nvk_wsi_scanout_wait_released(VkDevice _device, VkDeviceMemory _mem,
    return nvkmd_rm_mem_scanout_wait_released(mem->mem, timeout_ns);
 }
 
+/* Composed present (NVK_HELIOS_WSI_COMPOSE=1): the swapchain image's memory
+ * is the D3D11 shared texture the WSI made, imported by its Helios resource
+ * id (patch 0031's shared-surface import) */
+static VkResult
+nvk_wsi_compose_import(VkDevice _device, VkImage _image,
+                       const struct wsi_win32_compose_import *import,
+                       VkDeviceMemory *memory)
+{
+   VK_FROM_HANDLE(nvk_device, dev, _device);
+   const struct nvk_physical_device *pdev = nvk_device_physical(dev);
+
+   const VkImageMemoryRequirementsInfo2 req_info = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_REQUIREMENTS_INFO_2,
+      .image = _image,
+   };
+   VkMemoryRequirements2 reqs2 = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_REQUIREMENTS_2,
+   };
+   nvk_GetImageMemoryRequirements2(_device, &req_info, &reqs2);
+   const VkMemoryRequirements reqs = reqs2.memoryRequirements;
+
+   uint32_t type_index = UINT32_MAX;
+   for (uint32_t i = 0; i < pdev->mem_type_count; i++) {
+      if ((reqs.memoryTypeBits & BITFIELD_BIT(i)) &&
+          (pdev->mem_types[i].propertyFlags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT)) {
+         type_index = i;
+         break;
+      }
+   }
+   if (type_index == UINT32_MAX)
+      return vk_errorf(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY,
+                       "compose: no device-local memory type for the image");
+
+   const struct helios_import_memory_resource_info helios = {
+      .sType = HELIOS_STRUCTURE_TYPE_IMPORT_MEMORY_RESOURCE_INFO,
+      .resource_id = import->resource_id,
+      .size = import->size,
+      .modifier = import->modifier,
+      .stride = import->stride,
+      .offset = import->offset,
+   };
+   const VkMemoryDedicatedAllocateInfo dedicated = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO,
+      .pNext = &helios,
+      .image = _image,
+   };
+   const VkMemoryAllocateInfo info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .pNext = &dedicated,
+      .allocationSize = reqs.size,
+      .memoryTypeIndex = type_index,
+   };
+   return nvk_AllocateMemory(_device, &info, &dev->vk.alloc, memory);
+}
+
 static void
 nvk_wsi_scanout_release(VkDevice _device)
 {
@@ -190,6 +247,20 @@ nvk_init_wsi(struct nvk_physical_device *pdev)
       !debug_get_bool_option("NVK_HELIOS_WSI_SCANOUT", false);
    if (dwm_composes)
       mesa_logi("NVK: DWM on NVK composes this desktop: no scanout swap chains");
+
+   /* Opt-in: window swapchains present through a D3D11 flip swap chain on
+    * the Helios adapter, their images D3D11 shared textures imported by
+    * resource id, so DWM composes them (before scanout and GDI) */
+   if (debug_get_bool_option("NVK_HELIOS_WSI_COMPOSE", false)) {
+      if (nvkmd_rm_win_shared_import_supported()) {
+         pdev->wsi_device.win32.compose_import = nvk_wsi_compose_import;
+         mesa_logi("NVK: NVK_HELIOS_WSI_COMPOSE=1: window swap chains present "
+                   "through a D3D11 flip swap chain");
+      } else {
+         mesa_loge("NVK: NVK_HELIOS_WSI_COMPOSE=1, but the KMD or librmclient "
+                   "has no shared-surface import: not composing");
+      }
+   }
    if (!dwm_composes && nvkmd_rm_scanout_supported(pdev->nvkmd)) {
       pdev->wsi_device.win32.scanout_export = nvk_wsi_scanout_export;
       pdev->wsi_device.win32.scanout_flip = nvk_wsi_scanout_flip;
