@@ -841,6 +857,92 @@ wsi_win32_scanout_configure_image(const struct wsi_swapchain *chain,
    return VK_SUCCESS;
 }
 
+/*
+ * Composed presentation (Conduit Helios, wsi_device::win32.compose_import)
+ *
+ * The images are D3D11 shared textures of the window's D3D11 device
+ * (wsi_common_win32_compose.cpp), imported by resource id: the application
+ * renders into them, and a present copies one into the DXGI swap chain's
+ * back buffer and presents it, so DWM composes the window as it does a
+ * D3D11 application's.
+ */
+static VkResult
+wsi_win32_create_compose_image_mem(const struct wsi_swapchain *drv_chain,
+                                   const struct wsi_image_info *info,
+                                   struct wsi_image *image)
+{
+   struct wsi_win32_swapchain *chain =
+      (struct wsi_win32_swapchain *)drv_chain;
+   struct wsi_win32_image *win32_image =
+      container_of(image, struct wsi_win32_image, base);
+   const struct wsi_device *wsi = drv_chain->wsi;
+
+   struct wsi_win32_compose_import imp = {};
+   VkResult result =
+      wsi_win32_compose_image_create(chain->surface->compose,
+                                     info->create.extent.width,
+                                     info->create.extent.height,
+                                     &win32_image->compose, &imp);
+   if (result != VK_SUCCESS)
+      return result;
+
+   result = wsi->win32.compose_import(drv_chain->device, image->image, &imp,
+                                      &image->memory);
+   if (result != VK_SUCCESS) {
+      mesa_loge("MESA-WSI: compose: importing resource %u into the Vulkan "
+                "device failed (%d)", imp.resource_id, (int)result);
+      wsi_win32_compose_image_destroy(chain->surface->compose,
+                                      &win32_image->compose);
+      return result;
+   }
+   mesa_logi("MESA-WSI: compose: resource %u imported as swapchain image %u",
+             imp.resource_id, (unsigned)(win32_image - chain->images));
+
+   image->num_planes = 1;
+   image->sizes[0] = imp.size;
+   image->row_pitches[0] = imp.stride;
+   image->offsets[0] = imp.offset;
+   return VK_SUCCESS;
+}
+
+VkResult
+wsi_win32_compose_configure_image(const struct wsi_swapchain *chain,
+                                  const VkSwapchainCreateInfoKHR *pCreateInfo,
+                                  struct wsi_image_info *info)
+{
+   VkResult result = wsi_configure_image(chain, pCreateInfo, 0, info);
+   if (result != VK_SUCCESS)
+      return result;
+
+   /* The layout the D3D11 driver gives the same texture: OPTIMAL, one
+    * level, one layer (the import checks it against the KMD's record) */
+   info->create.tiling = VK_IMAGE_TILING_OPTIMAL;
+   info->select_image_memory_type = wsi_select_device_memory_type;
+   info->create_mem = wsi_win32_create_compose_image_mem;
+   return VK_SUCCESS;
+}
+
+static VkResult
+wsi_win32_queue_present_compose(struct wsi_win32_swapchain *chain,
+                                struct wsi_win32_image *image)
+{
+   /* The rendering has finished (the common present waits for it: the
+    * driver is a software WSI device) */
+   /* A retired swapchain whose window gave up its D3D11 swap chain */
+   VkResult result = chain->surface->compose == NULL ? VK_ERROR_OUT_OF_DATE_KHR :
+      wsi_win32_compose_present(chain->surface->compose, &image->compose,
+                                chain->compose.sync_interval);
+   chain->compose.presented = true;
+   if (result != VK_SUCCESS)
+      chain->status = result;
+
+   mtx_lock(&chain->acquire_mutex);
+   image->state = WSI_IMAGE_IDLE;
+   u_cnd_monotonic_broadcast(&chain->acquire_cond);
+   mtx_unlock(&chain->acquire_mutex);
+   return result;
+}
+
 static VkResult
 wsi_win32_queue_present_scanout(struct wsi_win32_swapchain *chain,
                                 struct wsi_win32_image *image)
@@ -964,7 +1066,7 @@ wsi_win32_image_init(VkDevice device_h,
    chain->wnd = win32_surface->hwnd;
    image->chain = chain;
 
-   if (chain->dxgi || chain->scanout.enabled)
+   if (chain->dxgi || chain->scanout.enabled || chain->compose.enabled)
       return VK_SUCCESS;
 
    chain->chain_dc = GetDC(chain->wnd);
@@ -1000,6 +1102,9 @@ wsi_win32_image_finish(struct wsi_win32_swapchain *chain,
 {
    if (image->dxgi.swapchain_res)
       image->dxgi.swapchain_res->Release();
+   if (image->compose.texture || image->compose.kmt_resource)
+      wsi_win32_compose_image_destroy(chain->surface ? chain->surface->compose : NULL,
+                                      &image->compose);
 
    if (image->sw.dc)
       DeleteDC(image->sw.dc);
@@ -1295,6 +1400,9 @@ wsi_win32_queue_present(struct wsi_swapchain *drv_chain,
    if (chain->dxgi)
       return wsi_win32_queue_present_dxgi(chain, image, damage);
 
+   if (chain->compose.enabled)
+      return wsi_win32_queue_present_compose(chain, image);
+
    if (chain->scanout.enabled)
       return wsi_win32_queue_present_scanout(chain, image);
 
@@ -1441,6 +1549,10 @@ wsi_win32_surface_create_swapchain(
       WSI_IMAGE_TYPE_WIN32_SCANOUT,
    };
 
+   struct wsi_base_image_params compose_image_params = {
+      WSI_IMAGE_TYPE_WIN32_COMPOSE,
+   };
+
    bool supports_dxgi = wsi->dxgi.factory &&
                         wsi->dxgi.dcomp &&
                         wsi->wsi->win32.get_d3d12_command_queue;
@@ -1455,11 +1567,41 @@ wsi_win32_surface_create_swapchain(
                             create_info->imageArrayLayers == 1;
    if (try_scanout)
       image_params = &scanout_image_params;
+   struct wsi_base_image_params *fallback_params = image_params;
+
+   /* Composed presentation first when the driver offers it: the window's
+    * D3D11 device and DXGI swap chain must exist before the images */
+   if (wsi_device->win32.compose_import != NULL &&
+       create_info->imageArrayLayers == 1 &&
+       wsi_win32_compose_format_supported(create_info->imageFormat)) {
+      VkResult cr = wsi_win32_compose_open(&surface->compose,
+                                           (void *)surface->base.hwnd,
+                                           create_info->imageExtent.width,
+                                           create_info->imageExtent.height,
+                                           create_info->imageFormat,
+                                           num_images);
+      if (cr == VK_SUCCESS)
+         image_params = &compose_image_params;
+      else
+         mesa_loge("MESA-WSI: compose: no D3D11 swap chain for the window "
+                   "(%d), presenting by %s", (int)cr,
+                   try_scanout ? "Helios scanout" : "GDI");
+   } else if (wsi_device->win32.compose_import != NULL) {
+      mesa_loge("MESA-WSI: compose: format %d / %u layers has no composed "
+                "path, presenting by %s", (int)create_info->imageFormat,
+                create_info->imageArrayLayers,
+                try_scanout ? "Helios scanout" : "GDI");
+   }
 
    VkResult result;
 retry:
    result = wsi_swapchain_init(wsi_device, &chain->base, device,
                                create_info, image_params, allocator);
+   if (result != VK_SUCCESS && image_params == &compose_image_params) {
+      mesa_loge("MESA-WSI: compose: swapchain init failed (%d)", (int)result);
+      image_params = fallback_params;
+      goto retry;
+   }
    if (result != VK_SUCCESS && image_params == &scanout_image_params) {
       image_params = &cpu_image_params.base;
       goto retry;
@@ -1484,6 +1626,13 @@ retry:
 
    chain->surface = surface;
 
+   if (image_params->image_type == WSI_IMAGE_TYPE_WIN32_COMPOSE) {
+      chain->compose.enabled = true;
+      chain->compose.sync_interval =
+         chain->base.present_mode == VK_PRESENT_MODE_FIFO_KHR ||
+         chain->base.present_mode == VK_PRESENT_MODE_FIFO_RELAXED_KHR ? 1 : 0;
+   }
+
    if (image_params->image_type == WSI_IMAGE_TYPE_WIN32_SCANOUT) {
       chain->scanout.enabled = true;
       chain->scanout.fourcc = scanout_fourcc;
