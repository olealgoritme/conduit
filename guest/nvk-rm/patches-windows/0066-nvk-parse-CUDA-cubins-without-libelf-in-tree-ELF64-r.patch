From e94a73f7f32ae9df9735dd7e03913843931950f8 Mon Sep 17 00:00:00 2001
From: Ole Algoritme <olealgoritme@gmail.com>
Date: Mon, 12 Oct 2026 23:42:26 +0200
Subject: [PATCH 64/65] nvk: parse CUDA cubins without libelf (in-tree ELF64
 reader)

The Windows build has no libelf, and nv_cubin_nolibelf.c rejected every
CUDA module, so VK_NVX_binary_import (DLSS) could not work there.

nv_cubin_elf.c is nv_cubin.c on top of a small ELF64 reader: the ELF
header (little-endian ELF64, EM_CUDA), section headers with the
SHN_XINDEX escapes, section data, string tables and the symbol table,
with every offset, size and index checked against the image.  .nv.info
records are bounds-checked too, and a symbol table whose entsize is not
an Elf64_Sym is refused (nv_cubin.c divides by it).  The module keeps a
copy of the image, so kernel names and code do not point into the
application's pCreateInfo->pData after vkCreateCuModuleNVX returns.

Builds with libelf keep nv_cubin.c.  tests/nv_cubin_elf_test.c (meson
test nv_cubin_elf) checks a synthetic cubin with two kernels, its old-ABI
and extended-numbering variants, an unaligned buffer, every truncation of
it and twelve broken images that must be refused; with libelf it runs
nv_cubin.c on the same input and compares.  Given files, it parses every
CUDA ELF embedded in them: the 1490 cubins in nvngx_dlss.dll 3.5.10 and
310.9.1, nvngx_dlssd.dll and nvngx_dlssg.dll 310.9.1 (sm_75 to sm_120)
parse identically to libelf.
---
 src/nouveau/cubin/meson.build               |  34 +-
 src/nouveau/cubin/nv_cubin_elf.c            | 620 ++++++++++++++++++
 src/nouveau/cubin/nv_cubin_nolibelf.c       |  40 --
 src/nouveau/cubin/tests/nv_cubin_elf_test.c | 657 ++++++++++++++++++++
 4 files changed, 1309 insertions(+), 42 deletions(-)
 create mode 100644 src/nouveau/cubin/nv_cubin_elf.c
 delete mode 100644 src/nouveau/cubin/nv_cubin_nolibelf.c
 create mode 100644 src/nouveau/cubin/tests/nv_cubin_elf_test.c

diff --git a/src/nouveau/cubin/meson.build b/src/nouveau/cubin/meson.build
index 2d3a33b..c80bc7a 100644
--- a/src/nouveau/cubin/meson.build
+++ b/src/nouveau/cubin/meson.build
@@ -7,8 +7,8 @@ libnouveau_cubin_files = files(
 if dep_elf.found()
   libnouveau_cubin_files += files('nv_cubin.c')
 else
-  # Without libelf (Windows) CUDA modules cannot be parsed
-  libnouveau_cubin_files += files('nv_cubin_nolibelf.c')
+  # Without libelf (Windows) cubins are parsed by an in-tree ELF64 reader
+  libnouveau_cubin_files += files('nv_cubin_elf.c')
 endif
 
 _libnouveau_cubin = static_library(
@@ -26,3 +26,33 @@ idep_nouveau_cubin = declare_dependency(
   include_directories : include_directories('.'),
   link_with : _libnouveau_cubin,
 )
+
+if with_tests
+  # nv_cubin_elf.c with its entry points renamed nv_cubin_elf_*, so that the
+  # test can run it next to libelf's nv_cubin.c and compare the two.
+  _libnouveau_cubin_elf_test = static_library(
+    'nouveau_cubin_elf_test',
+    files('nv_cubin_elf.c'),
+    include_directories : [inc_include, inc_src],
+    c_args : [
+      '-Dnv_cubin_module_init=nv_cubin_elf_module_init',
+      '-Dnv_cubin_module_fini=nv_cubin_elf_module_fini',
+      '-Dnv_cubin_module_find_function=nv_cubin_elf_module_find_function',
+      '-Dnv_cubin_function_get_param_info=nv_cubin_elf_function_get_param_info',
+    ],
+    dependencies : [idep_mesautil],
+  )
+
+  test(
+    'nv_cubin_elf',
+    executable(
+      'nv_cubin_elf_test',
+      files('tests/nv_cubin_elf_test.c'),
+      include_directories : [inc_include, inc_src, include_directories('.')],
+      c_args : dep_elf.found() ? ['-DUSE_LIBELF'] : [],
+      link_with : [_libnouveau_cubin_elf_test, _libnouveau_cubin],
+      dependencies : [dep_elf],
+    ),
+    suite : ['nouveau'],
+  )
+endif
diff --git a/src/nouveau/cubin/nv_cubin_elf.c b/src/nouveau/cubin/nv_cubin_elf.c
new file mode 100644
index 0000000..4840dee
--- /dev/null
+++ b/src/nouveau/cubin/nv_cubin_elf.c
@@ -0,0 +1,620 @@
+/*
+ * Copyright © 2025 Autumn Ashton
+ * Copyright © 2026 Conduit contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * nv_cubin without libelf: the same cubin parsing as nv_cubin.c on top of a
+ * small in-tree ELF64 reader, for builds that have no libelf (Windows).
+ *
+ * Only what nv_cubin.c asks libelf for is implemented: the ELF header, the
+ * section headers (with the SHN_XINDEX escapes), section data, string
+ * tables and the symbol table.  Cubins are little-endian ELF64
+ * (e_machine EM_CUDA); anything else is refused.  Every offset, size and
+ * index is checked against the image, and the image is copied, so the
+ * module does not point into the caller's buffer (VK_NVX_binary_import
+ * only guarantees pData during vkCreateCuModuleNVX).
+ */
+#include "nv_cubin.h"
+
+#include "nv_cubin_defs.h"
+
+#include "util/log.h"
+#include "util/macros.h"
+
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* ELF64 as in the System V gABI; no <elf.h> on Windows. */
+#define NV_EI_NIDENT     16
+#define NV_EI_CLASS      4
+#define NV_EI_DATA       5
+#define NV_EI_OSABI      7
+#define NV_ELFCLASS64    2
+#define NV_ELFDATA2LSB   1
+#define NV_EM_CUDA       190
+
+#define NV_SHN_UNDEF     0
+#define NV_SHN_LORESERVE 0xff00
+#define NV_SHN_XINDEX    0xffff
+
+#define NV_SHT_SYMTAB    2
+#define NV_SHT_STRTAB    3
+#define NV_SHT_NOBITS    8
+
+#define NV_STB_GLOBAL    1
+#define NV_STT_FUNC      2
+#define NV_STV_DEFAULT   0
+
+typedef struct {
+   uint8_t e_ident[NV_EI_NIDENT];
+   uint16_t e_type;
+   uint16_t e_machine;
+   uint32_t e_version;
+   uint64_t e_entry;
+   uint64_t e_phoff;
+   uint64_t e_shoff;
+   uint32_t e_flags;
+   uint16_t e_ehsize;
+   uint16_t e_phentsize;
+   uint16_t e_phnum;
+   uint16_t e_shentsize;
+   uint16_t e_shnum;
+   uint16_t e_shstrndx;
+} nv_elf64_ehdr;
+
+typedef struct {
+   uint32_t sh_name;
+   uint32_t sh_type;
+   uint64_t sh_flags;
+   uint64_t sh_addr;
+   uint64_t sh_offset;
+   uint64_t sh_size;
+   uint32_t sh_link;
+   uint32_t sh_info;
+   uint64_t sh_addralign;
+   uint64_t sh_entsize;
+} nv_elf64_shdr;
+
+typedef struct {
+   uint32_t st_name;
+   uint8_t st_info;
+   uint8_t st_other;
+   uint16_t st_shndx;
+   uint64_t st_value;
+   uint64_t st_size;
+} nv_elf64_sym;
+
+static_assert(sizeof(nv_elf64_ehdr) == 64, "ELF64 header");
+static_assert(sizeof(nv_elf64_shdr) == 64, "ELF64 section header");
+static_assert(sizeof(nv_elf64_sym) == 24, "ELF64 symbol");
+
+/* The module's private ELF state (struct Elf is opaque in nv_cubin.h). */
+struct Elf {
+   uint8_t *image; /* owned copy of the cubin */
+   size_t size;
+   nv_elf64_shdr *shdrs; /* aligned copies of the section headers */
+   size_t shnum;
+};
+
+struct nv_elf_data {
+   uint8_t *buf; /* NULL for SHT_NOBITS */
+   size_t size;
+};
+
+static bool
+nv_cubin_error(const char *what)
+{
+   mesa_loge("nvk cubin elf error: %s\n", what);
+   return false;
+}
+
+static bool
+nv_elf_range_ok(const struct Elf *elf, uint64_t offset, uint64_t size)
+{
+   return offset <= elf->size && size <= elf->size - offset;
+}
+
+static bool
+nv_elf_open(struct Elf *elf, const void *data, size_t size, size_t *shstrndx,
+            nv_elf64_ehdr *ehdr_out)
+{
+   memset(elf, 0, sizeof(*elf));
+
+   nv_elf64_ehdr ehdr;
+   if (data == NULL || size < sizeof(ehdr))
+      return nv_cubin_error("Cubin was not an elf");
+   memcpy(&ehdr, data, sizeof(ehdr));
+
+   if (memcmp(ehdr.e_ident, "\x7f" "ELF", 4) != 0)
+      return nv_cubin_error("Cubin was not an elf");
+   if (ehdr.e_ident[NV_EI_CLASS] != NV_ELFCLASS64)
+      return nv_cubin_error("Failed to get elf header (not ELF64)");
+   if (ehdr.e_ident[NV_EI_DATA] != NV_ELFDATA2LSB)
+      return nv_cubin_error("Failed to get elf header (not little-endian)");
+
+   elf->image = malloc(size);
+   if (elf->image == NULL)
+      return nv_cubin_error("Out of memory");
+   memcpy(elf->image, data, size);
+   elf->size = size;
+
+   if (ehdr.e_shoff == 0)
+      return nv_cubin_error("No section headers");
+   if (ehdr.e_shentsize != sizeof(nv_elf64_shdr))
+      return nv_cubin_error("Unexpected section header size");
+   if (!nv_elf_range_ok(elf, ehdr.e_shoff, sizeof(nv_elf64_shdr)))
+      return nv_cubin_error("Section headers beyond the end of the elf");
+
+   /* Section 0 holds the real count and string table index when they do
+    * not fit in the ELF header. */
+   nv_elf64_shdr shdr0;
+   memcpy(&shdr0, elf->image + ehdr.e_shoff, sizeof(shdr0));
+
+   uint64_t shnum = ehdr.e_shnum;
+   if (shnum == 0)
+      shnum = shdr0.sh_size;
+   if (shnum == 0 || shnum > (elf->size / sizeof(nv_elf64_shdr)) ||
+       !nv_elf_range_ok(elf, ehdr.e_shoff, shnum * sizeof(nv_elf64_shdr)))
+      return nv_cubin_error("Section headers beyond the end of the elf");
+
+   uint64_t strndx = ehdr.e_shstrndx;
+   if (strndx == NV_SHN_XINDEX)
+      strndx = shdr0.sh_link;
+   if (strndx >= shnum)
+      return nv_cubin_error("Couldn't get section header string table index");
+
+   elf->shdrs = malloc(shnum * sizeof(nv_elf64_shdr));
+   if (elf->shdrs == NULL)
+      return nv_cubin_error("Out of memory");
+   memcpy(elf->shdrs, elf->image + ehdr.e_shoff,
+          shnum * sizeof(nv_elf64_shdr));
+   elf->shnum = shnum;
+
+   *shstrndx = strndx;
+   *ehdr_out = ehdr;
+   return true;
+}
+
+static void
+nv_elf_close(struct Elf *elf)
+{
+   free(elf->shdrs);
+   free(elf->image);
+   memset(elf, 0, sizeof(*elf));
+}
+
+static const nv_elf64_shdr *
+nv_elf_shdr(const struct Elf *elf, size_t index)
+{
+   return index < elf->shnum ? &elf->shdrs[index] : NULL;
+}
+
+static bool
+nv_elf_section_data(const struct Elf *elf, const nv_elf64_shdr *shdr,
+                    struct nv_elf_data *out)
+{
+   if (shdr->sh_type == NV_SHT_NOBITS) {
+      out->buf = NULL;
+      out->size = shdr->sh_size;
+      return true;
+   }
+   if (!nv_elf_range_ok(elf, shdr->sh_offset, shdr->sh_size))
+      return false;
+   out->buf = elf->image + shdr->sh_offset;
+   out->size = shdr->sh_size;
+   return true;
+}
+
+/* A NUL-terminated string at offset in string table section index. */
+static const char *
+nv_elf_strptr(const struct Elf *elf, size_t index, uint64_t offset)
+{
+   const nv_elf64_shdr *shdr = nv_elf_shdr(elf, index);
+   struct nv_elf_data data;
+   if (shdr == NULL || shdr->sh_type != NV_SHT_STRTAB ||
+       !nv_elf_section_data(elf, shdr, &data) || offset >= data.size)
+      return NULL;
+
+   const char *str = (const char *)data.buf + offset;
+   if (memchr(str, 0, data.size - offset) == NULL)
+      return NULL;
+   return str;
+}
+
+static const nv_elf64_shdr *
+nv_cubin_module_get_section(const struct nv_cubin_module *module,
+                            const char *lookup_name)
+{
+   for (size_t i = 1; i < module->elf->shnum; i++) {
+      const nv_elf64_shdr *header = &module->elf->shdrs[i];
+      const char *section_name =
+         nv_elf_strptr(module->elf, module->shstrndx, header->sh_name);
+      if (!section_name || !*section_name)
+         continue;
+
+      if (!strcmp(section_name, lookup_name))
+         return header;
+   }
+
+   return NULL;
+}
+
+static uint32_t
+nv_cubin_module_get_static_smem_size(const struct nv_cubin_module *module,
+                                     const char *name)
+{
+   char section_name[2048];
+   snprintf(section_name, sizeof(section_name), ".nv.shared.%s", name);
+
+   const nv_elf64_shdr *section =
+      nv_cubin_module_get_section(module, section_name);
+   if (!section)
+      return 0;
+
+   struct nv_elf_data data;
+   if (!nv_elf_section_data(module->elf, section, &data))
+      return 0;
+
+   /* Assume this is all zero'ed. */
+   return (uint32_t)data.size;
+}
+
+/* One .nv.info attribute: the 4-byte header, then for EIFMT_SVAL
+ * sval.size bytes of payload.  Returns false when the record runs past the
+ * section.
+ */
+static bool
+nv_cubin_next_attribute(const uint8_t **ptr, const uint8_t *end,
+                        struct nvinfo_attribute_header_t *header,
+                        const uint8_t **payload, size_t *payload_size)
+{
+   if ((size_t)(end - *ptr) < sizeof(*header))
+      return false;
+   memcpy(header, *ptr, sizeof(*header));
+   *ptr += sizeof(*header);
+   *payload = *ptr;
+   *payload_size = 0;
+
+   if (header->format == NVINFO_EIFMT_SVAL) {
+      if ((size_t)(end - *ptr) < header->sval.size)
+         return false;
+      *payload_size = header->sval.size;
+      *ptr += header->sval.size;
+   }
+   return true;
+}
+
+#define NV_ATTR_PAYLOAD(type, var, payload, size)                            \
+   type var;                                                                 \
+   if ((size) < sizeof(type))                                                \
+      return nv_cubin_error("Short .nv.info attribute");                    \
+   memcpy(&var, (payload), sizeof(type))
+
+static bool
+nv_cubin_function_parse_base_nvinfo(struct nv_cubin_module *module,
+                                    struct nv_cubin_function *function)
+{
+   const nv_elf64_shdr *section =
+      nv_cubin_module_get_section(module, ".nv.info");
+   if (!section)
+      return nv_cubin_error("No .nv.info section");
+
+   struct nv_elf_data data;
+   if (!nv_elf_section_data(module->elf, section, &data) || !data.buf)
+      return nv_cubin_error("No .nv.info section data");
+
+   const uint8_t *ptr = data.buf;
+   const uint8_t *end = ptr + data.size;
+   while (ptr < end) {
+      struct nvinfo_attribute_header_t attr_header;
+      const uint8_t *payload;
+      size_t payload_size;
+      if (!nv_cubin_next_attribute(&ptr, end, &attr_header, &payload,
+                                   &payload_size))
+         return nv_cubin_error("Truncated .nv.info attribute");
+
+      switch (attr_header.attribute) {
+      case NVINFO_EIATTR_MIN_STACK_SIZE: {
+         if (attr_header.format != NVINFO_EIFMT_SVAL)
+            return nv_cubin_error("Unexpected header format");
+         NV_ATTR_PAYLOAD(struct nvinfo_attr_min_stack_size_t, attr, payload,
+                         payload_size);
+         if (attr.symbol_index == function->symbol_index)
+            function->slm_size = attr.size;
+         break;
+      }
+      case NVINFO_EIATTR_REGCOUNT: {
+         if (attr_header.format != NVINFO_EIFMT_SVAL)
+            return nv_cubin_error("Unexpected header format");
+         NV_ATTR_PAYLOAD(struct nvinfo_attr_regcount_t, attr, payload,
+                         payload_size);
+         if (attr.symbol_index == function->symbol_index)
+            function->gpr_count = attr.count;
+         break;
+      }
+      default:
+         break;
+      }
+   }
+
+   return true;
+}
+
+static bool
+nv_cubin_function_parse_extended_nvinfo(struct nv_cubin_module *module,
+                                        struct nv_cubin_function *function)
+{
+   char nvinfo_name[2048];
+   snprintf(nvinfo_name, sizeof(nvinfo_name), ".nv.info.%s", function->name);
+
+   const nv_elf64_shdr *section =
+      nv_cubin_module_get_section(module, nvinfo_name);
+   if (!section)
+      return nv_cubin_error("No .nv.info section");
+
+   struct nv_elf_data data;
+   if (!nv_elf_section_data(module->elf, section, &data) || !data.buf)
+      return nv_cubin_error("No .nv.info section data");
+
+   const uint8_t *ptr = data.buf;
+   const uint8_t *end = ptr + data.size;
+   while (ptr < end) {
+      struct nvinfo_attribute_header_t attr_header;
+      const uint8_t *payload;
+      size_t payload_size;
+      if (!nv_cubin_next_attribute(&ptr, end, &attr_header, &payload,
+                                   &payload_size))
+         return nv_cubin_error("Truncated .nv.info attribute");
+
+      switch (attr_header.attribute) {
+      case NVINFO_EIATTR_PARAM_CBANK: {
+         if (attr_header.format != NVINFO_EIFMT_SVAL)
+            return nv_cubin_error("Unexpected header format");
+         NV_ATTR_PAYLOAD(struct nvinfo_param_cbank_t, attr, payload,
+                         payload_size);
+         function->params_offset = attr.params_offset;
+         function->params_size = attr.params_size;
+         break;
+      }
+      case NVINFO_EIATTR_KPARAM_INFO: {
+         if (attr_header.format != NVINFO_EIFMT_SVAL)
+            return nv_cubin_error("Unexpected header format");
+         NV_ATTR_PAYLOAD(struct nvinfo_kparam_info_t, attr, payload,
+                         payload_size);
+
+         struct nv_cubin_function_param_info *infos =
+            realloc(function->param_infos,
+                    sizeof(*infos) * (function->param_info_count + 1));
+         if (infos == NULL)
+            return nv_cubin_error("Out of memory");
+         function->param_infos = infos;
+
+         struct nv_cubin_function_param_info *func_param =
+            &infos[function->param_info_count++];
+         func_param->index = attr.index;
+         func_param->ordinal = attr.ordinal;
+         func_param->offset = attr.offset;
+         func_param->size = (attr.packed >> 18) & 0x3fff;
+         break;
+      }
+      case NVINFO_EIATTR_CRS_STACK_SIZE: {
+         if (attr_header.format != NVINFO_EIFMT_SVAL)
+            return nv_cubin_error("Unexpected header format");
+         NV_ATTR_PAYLOAD(struct nvinfo_crs_stack_size_t, attr, payload,
+                         payload_size);
+         function->crs_size = attr.size;
+         break;
+      }
+      case NVINFO_EIATTR_NUM_BARRIERS: {
+         /* new version has NUM_BARRIERS as an attribute. */
+         if (attr_header.format != NVINFO_EIFMT_BVAL)
+            return nv_cubin_error("Unexpected header format");
+         function->num_control_barriers = attr_header.bval.value;
+         break;
+      }
+      default:
+         break;
+      }
+   }
+
+   return true;
+}
+
+static bool
+nv_cubin_function_init(struct nv_cubin_module *module,
+                       struct nv_cubin_function *function,
+                       uint32_t symbol_index, const char *symbol_name,
+                       const nv_elf64_sym *symbol)
+{
+   memset(function, 0, sizeof(*function));
+
+   if (symbol->st_size == 0)
+      return nv_cubin_error("Function with no size!");
+
+   size_t code_section_index = symbol->st_shndx;
+   if (code_section_index == NV_SHN_UNDEF)
+      return nv_cubin_error("Function with no code section!");
+   if (code_section_index >= NV_SHN_LORESERVE)
+      return nv_cubin_error("Function with invalid code section!");
+
+   const nv_elf64_shdr *code_section_header =
+      nv_elf_shdr(module->elf, code_section_index);
+   if (!code_section_header)
+      return nv_cubin_error("Function with invalid code section!");
+
+   struct nv_elf_data code_section_data;
+   if (!nv_elf_section_data(module->elf, code_section_header,
+                            &code_section_data) ||
+       !code_section_data.buf)
+      return nv_cubin_error("Couldn't get code section data");
+
+   if (symbol->st_value < code_section_header->sh_addr)
+      return nv_cubin_error("Function extends beyond section bounds");
+   uint64_t offset_in_section =
+      symbol->st_value - code_section_header->sh_addr;
+   if (offset_in_section > code_section_data.size ||
+       symbol->st_size > code_section_data.size - offset_in_section)
+      return nv_cubin_error("Function extends beyond section bounds");
+
+   function->symbol_index = symbol_index;
+   function->name = symbol_name;
+
+   function->code_ptr = code_section_data.buf;
+   function->code_size = code_section_data.size;
+   function->func_offset = offset_in_section;
+
+   function->static_smem_size =
+      nv_cubin_module_get_static_smem_size(module, symbol_name);
+
+   if (module->abi < NV_ELF_OSABI_41) {
+      /* old version has SHF_BARRIERS in .sectionheader */
+      const uint8_t shf_barriers = (code_section_header->sh_flags >> 20) & 0xf;
+      function->num_control_barriers = shf_barriers;
+   }
+
+   if (!nv_cubin_function_parse_base_nvinfo(module, function))
+      return nv_cubin_error("Couldn't parse base .nv.info");
+
+   if (!nv_cubin_function_parse_extended_nvinfo(module, function))
+      return nv_cubin_error("Couldn't parse extended .nv.info");
+
+   return true;
+}
+
+static void
+nv_cubin_function_fini(struct nv_cubin_function *function)
+{
+   free(function->param_infos);
+   function->param_infos = NULL;
+}
+
+static bool
+nv_cubin_module_parse_functions(struct nv_cubin_module *module)
+{
+   /* Iterate over the symbol table and extract the data about each function. */
+   for (size_t s = 1; s < module->elf->shnum; s++) {
+      const nv_elf64_shdr *symtab_section_header = &module->elf->shdrs[s];
+
+      /* We only care about symbol tables. */
+      if (symtab_section_header->sh_type != NV_SHT_SYMTAB)
+         continue;
+
+      struct nv_elf_data symtab_data;
+      if (!nv_elf_section_data(module->elf, symtab_section_header,
+                               &symtab_data) ||
+          !symtab_data.buf)
+         return nv_cubin_error("Couldn't get .symtab section data");
+
+      if (symtab_section_header->sh_entsize != sizeof(nv_elf64_sym))
+         return nv_cubin_error("Unexpected symbol size");
+
+      size_t num_symbols = symtab_data.size / sizeof(nv_elf64_sym);
+      for (size_t i = 0; i < num_symbols; i++) {
+         nv_elf64_sym symbol;
+         memcpy(&symbol, symtab_data.buf + i * sizeof(symbol), sizeof(symbol));
+
+         const char *symbol_name = nv_elf_strptr(
+            module->elf, symtab_section_header->sh_link, symbol.st_name);
+         /* We don't care about any unnamed functions. */
+         if (!symbol_name || symbol_name[0] == '\0')
+            continue;
+
+         if ((symbol.st_info & 0xf) != NV_STT_FUNC ||
+             (symbol.st_info >> 4) != NV_STB_GLOBAL ||
+             (symbol.st_other & 0x3) != NV_STV_DEFAULT)
+            continue;
+
+         struct nv_cubin_function *functions =
+            realloc(module->functions,
+                    sizeof(*functions) * (module->function_count + 1));
+         if (functions == NULL)
+            return nv_cubin_error("Out of memory");
+         module->functions = functions;
+
+         /* Counted before init so that fini frees a half-parsed one. */
+         struct nv_cubin_function *function =
+            &functions[module->function_count++];
+         if (!nv_cubin_function_init(module, function, (uint32_t)i,
+                                     symbol_name, &symbol))
+            return nv_cubin_error("Couldn't init function");
+      }
+   }
+
+   return true;
+}
+
+/* public interface */
+
+bool
+nv_cubin_module_init(struct nv_cubin_module *module, const void *data,
+                     size_t size)
+{
+   memset(module, 0, sizeof(*module));
+
+   module->elf = calloc(1, sizeof(struct Elf));
+   if (module->elf == NULL)
+      return nv_cubin_error("Out of memory");
+
+   nv_elf64_ehdr ehdr;
+   if (!nv_elf_open(module->elf, data, size, &module->shstrndx, &ehdr))
+      return nv_cubin_error("Couldn't load elf");
+
+   if (ehdr.e_machine != NV_EM_CUDA)
+      return nv_cubin_error("ELF is not targeting Cuda");
+
+   module->abi = ehdr.e_ident[NV_EI_OSABI];
+
+   /* new version encodes e_flags differently... */
+   if (module->abi >= NV_ELF_OSABI_41)
+      module->sm = (ehdr.e_flags >> 8) & 0xFF;
+   else
+      module->sm = (ehdr.e_flags >> 16) & 0xFF;
+
+   if (!nv_cubin_module_parse_functions(module))
+      return nv_cubin_error("Couldn't parse functions");
+
+   return true;
+}
+
+void
+nv_cubin_module_fini(struct nv_cubin_module *module)
+{
+   for (uint32_t i = 0; i < module->function_count; i++)
+      nv_cubin_function_fini(&module->functions[i]);
+   module->function_count = 0;
+
+   free(module->functions);
+   module->functions = NULL;
+
+   if (module->elf) {
+      nv_elf_close(module->elf);
+      free(module->elf);
+      module->elf = NULL;
+   }
+}
+
+const struct nv_cubin_function *
+nv_cubin_module_find_function(const struct nv_cubin_module *module,
+                              const char *name)
+{
+   for (uint32_t i = 0; i < module->function_count; i++) {
+      const struct nv_cubin_function *function = &module->functions[i];
+      if (!strcmp(function->name, name))
+         return function;
+   }
+
+   return NULL;
+}
+
+const struct nv_cubin_function_param_info *
+nv_cubin_function_get_param_info(const struct nv_cubin_function *function,
+                                 uint32_t index)
+{
+   for (uint32_t i = 0; i < function->param_info_count; i++) {
+      if (function->param_infos[i].ordinal == index)
+         return &function->param_infos[i];
+   }
+   return NULL;
+}
