diff --git a/src/nouveau/cubin/tests/nv_cubin_elf_test.c b/src/nouveau/cubin/tests/nv_cubin_elf_test.c
new file mode 100644
index 0000000..34f51e0
--- /dev/null
+++ b/src/nouveau/cubin/tests/nv_cubin_elf_test.c
@@ -0,0 +1,657 @@
+/*
+ * Copyright © 2026 Conduit contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * Tests for nv_cubin_elf.c, the libelf-free cubin parser.  It is built here
+ * with its public functions renamed nv_cubin_elf_*, so that with libelf the
+ * same program also runs nv_cubin.c and compares the two.
+ *
+ *   nv_cubin_elf_test              synthetic cubins: a valid one, its
+ *                                  variants (old ABI, extended section
+ *                                  numbering, unaligned buffer) and broken
+ *                                  ones that must be refused
+ *   nv_cubin_elf_test FILE...      also every CUDA ELF found in FILE (a
+ *                                  cubin, a fatbin or a DLL that embeds
+ *                                  them, e.g. nvngx_dlss.dll); with libelf
+ *                                  both parsers must agree on each
+ */
+#include "nv_cubin.h"
+#include "nv_cubin_defs.h"
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+bool nv_cubin_elf_module_init(struct nv_cubin_module *module, const void *data,
+                              size_t size);
+void nv_cubin_elf_module_fini(struct nv_cubin_module *module);
+const struct nv_cubin_function *
+nv_cubin_elf_module_find_function(const struct nv_cubin_module *module,
+                                  const char *name);
+const struct nv_cubin_function_param_info *
+nv_cubin_elf_function_get_param_info(const struct nv_cubin_function *function,
+                                     uint32_t index);
+
+static int failures;
+static bool quiet_errors;
+
+#define CHECK(cond, ...)                                                       \
+   do {                                                                        \
+      if (!(cond)) {                                                           \
+         failures++;                                                           \
+         fprintf(stderr, "FAIL %s:%d: %s: ", __FILE__, __LINE__, #cond);       \
+         fprintf(stderr, __VA_ARGS__);                                         \
+         fprintf(stderr, "\n");                                                \
+      }                                                                        \
+   } while (0)
+
+/* --- a small ELF64 writer for the synthetic cubins --- */
+
+struct buf {
+   uint8_t *data;
+   size_t size, cap;
+};
+
+static size_t
+buf_put(struct buf *b, const void *data, size_t size, size_t align)
+{
+   size_t off = (b->size + align - 1) & ~(align - 1);
+   if (off + size > b->cap) {
+      b->cap = (off + size) * 2 + 256;
+      b->data = realloc(b->data, b->cap);
+   }
+   memset(b->data + b->size, 0, off - b->size);
+   if (data)
+      memcpy(b->data + off, data, size);
+   else
+      memset(b->data + off, 0, size);
+   b->size = off + size;
+   return off;
+}
+
+static uint32_t
+strtab_add(struct buf *b, const char *s)
+{
+   if (b->size == 0)
+      buf_put(b, "", 1, 1);
+   return (uint32_t)buf_put(b, s, strlen(s) + 1, 1);
+}
+
+struct shdr {
+   uint32_t name, type;
+   uint64_t flags, addr, offset, size;
+   uint32_t link, info;
+   uint64_t addralign, entsize;
+};
+
+struct sym {
+   uint32_t name;
+   uint8_t info, other;
+   uint16_t shndx;
+   uint64_t value, size;
+};
+
+struct ehdr {
+   uint8_t ident[16];
+   uint16_t type, machine;
+   uint32_t version;
+   uint64_t entry, phoff, shoff;
+   uint32_t flags;
+   uint16_t ehsize, phentsize, phnum, shentsize, shnum, shstrndx;
+};
+
+static void
+nvinfo_sval(struct buf *b, uint8_t attr, const void *payload, uint16_t size)
+{
+   uint8_t hdr[4] = { NVINFO_EIFMT_SVAL, attr, size & 0xff, size >> 8 };
+   buf_put(b, hdr, 4, 1);
+   buf_put(b, payload, size, 1);
+}
+
+static void
+nvinfo_bval(struct buf *b, uint8_t attr, uint8_t value)
+{
+   uint8_t hdr[4] = { NVINFO_EIFMT_BVAL, attr, value, 0 };
+   buf_put(b, hdr, 4, 1);
+}
+
+enum variant {
+   V_OK,
+   V_OLD_ABI,         /* OSABI < 0x41: sm in e_flags >> 16, barriers in sh_flags */
+   V_XINDEX,          /* e_shnum = 0 and e_shstrndx = SHN_XINDEX */
+   V_BAD_MAGIC,
+   V_ELF32,
+   V_BIG_ENDIAN,
+   V_NOT_CUDA,
+   V_SHOFF_PAST_END,
+   V_SHSTRNDX_RANGE,
+   V_SECTION_PAST_END,
+   V_SYM_PAST_SECTION,
+   V_SYM_BAD_SHNDX,
+   V_NVINFO_TRUNCATED,
+   V_NO_EXT_NVINFO,
+   V_ENTSIZE_ZERO,
+   V_STRTAB_UNTERMINATED,
+};
+
+#define SM 120
+#define REGS 40
+#define STACK 0x30
+#define CRS 0x20
+#define BARRIERS 3
+#define PARAMS_OFF 0x210
+#define PARAMS_SIZE 24
+#define SMEM 0x400
+
+/* A cubin with two kernels in one .text section ("k_main" at 0x0 and
+ * "k_second" at 0x100), a local function and a data object that must be
+ * skipped, .nv.info with per-symbol REGCOUNT/MIN_STACK_SIZE and
+ * .nv.info.<kernel> with PARAM_CBANK, two KPARAM_INFO, CRS_STACK_SIZE and
+ * NUM_BARRIERS, and a NOBITS .nv.shared.k_main.
+ */
+static uint8_t *
+make_cubin(enum variant v, size_t *size_out)
+{
+   struct buf shstr = { 0 }, str = { 0 }, out = { 0 };
+   struct shdr sh[16];
+   unsigned n = 1;
+   memset(sh, 0, sizeof(sh));
+
+   uint8_t code[0x200];
+   for (unsigned i = 0; i < sizeof(code); i++)
+      code[i] = (uint8_t)(i * 7 + 1);
+
+   const unsigned s_text = n++;
+   const unsigned s_info = n++;
+   const unsigned s_info_k = n++;
+   const unsigned s_info_k2 = n++;
+   const unsigned s_shared = n++;
+   const unsigned s_symtab = n++;
+   const unsigned s_strtab = n++;
+   const unsigned s_shstrtab = n++;
+
+   sh[s_text].name = strtab_add(&shstr, ".text.k_main");
+   sh[s_info].name = strtab_add(&shstr, ".nv.info");
+   sh[s_info_k].name = strtab_add(&shstr, v == V_NO_EXT_NVINFO ?
+                                  ".nv.info.k_other" : ".nv.info.k_main");
+   sh[s_info_k2].name = strtab_add(&shstr, ".nv.info.k_second");
+   sh[s_shared].name = strtab_add(&shstr, ".nv.shared.k_main");
+   sh[s_symtab].name = strtab_add(&shstr, ".symtab");
+   sh[s_strtab].name = strtab_add(&shstr, ".strtab");
+   sh[s_shstrtab].name = strtab_add(&shstr, ".shstrtab");
+
+   uint32_t n_main = strtab_add(&str, "k_main");
+   uint32_t n_second = strtab_add(&str, "k_second");
+   uint32_t n_local = strtab_add(&str, "local_fn");
+   uint32_t n_obj = strtab_add(&str, "some_data");
+
+   struct sym syms[5];
+   memset(syms, 0, sizeof(syms));
+   /* 1: k_main, GLOBAL FUNC */
+   syms[1] = (struct sym){ n_main, (1 << 4) | 2, 0, s_text, 0x1000, 0x100 };
+   /* 2: k_second, GLOBAL FUNC */
+   syms[2] = (struct sym){ n_second, (1 << 4) | 2, 0, s_text, 0x1100, 0x100 };
+   /* 3: local function: skipped */
+   syms[3] = (struct sym){ n_local, (0 << 4) | 2, 0, s_text, 0x1000, 0x10 };
+   /* 4: global object: skipped */
+   syms[4] = (struct sym){ n_obj, (1 << 4) | 1, 0, s_text, 0x1000, 0x10 };
+   if (v == V_SYM_PAST_SECTION)
+      syms[2].size = 0x101;
+   if (v == V_SYM_BAD_SHNDX)
+      syms[1].shndx = 0x40;
+
+   struct buf info = { 0 };
+   for (uint32_t s = 1; s <= 2; s++) {
+      uint32_t regcount[2] = { s, REGS + s };
+      uint32_t stack[2] = { s, STACK + s };
+      nvinfo_sval(&info, NVINFO_EIATTR_REGCOUNT, regcount, sizeof(regcount));
+      nvinfo_sval(&info, NVINFO_EIATTR_MIN_STACK_SIZE, stack, sizeof(stack));
+   }
+   nvinfo_bval(&info, 0x55, 9); /* an unknown BVAL is skipped */
+   if (v == V_NVINFO_TRUNCATED) {
+      uint8_t hdr[4] = { NVINFO_EIFMT_SVAL, NVINFO_EIATTR_REGCOUNT, 8, 0 };
+      buf_put(&info, hdr, 4, 1);
+      buf_put(&info, "\1\0\0", 3, 1); /* 3 of the promised 8 bytes */
+   }
+
+   struct buf info_k[2] = { { 0 }, { 0 } };
+   for (unsigned k = 0; k < 2; k++) {
+      struct buf *b = &info_k[k];
+      struct nvinfo_param_cbank_t cbank = { 0x123, PARAMS_OFF + k, PARAMS_SIZE };
+      nvinfo_sval(b, NVINFO_EIATTR_PARAM_CBANK, &cbank, sizeof(cbank));
+      /* KPARAM_INFO for ordinal 1 (offset 8, 16 bytes) then ordinal 0
+       * (offset 0, 8 bytes): size is bits 18..31 of packed. */
+      struct nvinfo_kparam_info_t p1 = { 0, 1, 8, 16u << 18 };
+      struct nvinfo_kparam_info_t p0 = { 0, 0, 0, 8u << 18 };
+      nvinfo_sval(b, NVINFO_EIATTR_KPARAM_INFO, &p1, sizeof(p1));
+      nvinfo_sval(b, NVINFO_EIATTR_KPARAM_INFO, &p0, sizeof(p0));
+      uint32_t crs = CRS + k;
+      nvinfo_sval(b, NVINFO_EIATTR_CRS_STACK_SIZE, &crs, sizeof(crs));
+      if (v != V_OLD_ABI)
+         nvinfo_bval(b, NVINFO_EIATTR_NUM_BARRIERS, BARRIERS + k);
+   }
+
+   /* Layout: ELF header, then section contents, then the headers. */
+   buf_put(&out, NULL, sizeof(struct ehdr), 8);
+
+   sh[s_text].type = 1; /* PROGBITS */
+   sh[s_text].addr = 0x1000;
+   sh[s_text].flags = 0x6 | (v == V_OLD_ABI ? (uint64_t)BARRIERS << 20 : 0);
+   sh[s_text].offset = buf_put(&out, code, sizeof(code), 128);
+   sh[s_text].size = sizeof(code);
+   if (v == V_SECTION_PAST_END)
+      sh[s_text].size = 0x100000;
+
+   sh[s_info].type = 0x70000000;
+   sh[s_info].offset = buf_put(&out, info.data, info.size, 4);
+   sh[s_info].size = info.size;
+
+   sh[s_info_k].type = 0x70000000;
+   sh[s_info_k].offset = buf_put(&out, info_k[0].data, info_k[0].size, 4);
+   sh[s_info_k].size = info_k[0].size;
+
+   sh[s_info_k2].type = 0x70000000;
+   sh[s_info_k2].offset = buf_put(&out, info_k[1].data, info_k[1].size, 4);
+   sh[s_info_k2].size = info_k[1].size;
+
+   sh[s_shared].type = 8; /* NOBITS */
+   sh[s_shared].size = SMEM;
+   sh[s_shared].offset = 0x7fffffff; /* ignored for NOBITS */
+
+   sh[s_symtab].type = 2;
+   sh[s_symtab].link = s_strtab;
+   sh[s_symtab].entsize = v == V_ENTSIZE_ZERO ? 0 : sizeof(struct sym);
+   sh[s_symtab].offset = buf_put(&out, syms, sizeof(syms), 8);
+   sh[s_symtab].size = sizeof(syms);
+
+   sh[s_strtab].type = 3;
+   sh[s_strtab].offset = buf_put(&out, str.data, str.size, 1);
+   sh[s_strtab].size = str.size;
+   if (v == V_STRTAB_UNTERMINATED) {
+      /* "some_data" without its NUL at the end of the section */
+      sh[s_strtab].size -= 1;
+   }
+
+   sh[s_shstrtab].type = 3;
+   sh[s_shstrtab].offset = buf_put(&out, shstr.data, shstr.size, 1);
+   sh[s_shstrtab].size = shstr.size;
+
+   if (v == V_XINDEX) {
+      sh[0].size = n;
+      sh[0].link = s_shstrtab;
+   }
+   size_t shoff = buf_put(&out, sh, n * sizeof(struct shdr), 8);
+
+   struct ehdr eh;
+   memset(&eh, 0, sizeof(eh));
+   memcpy(eh.ident, "\x7f" "ELF", 4);
+   eh.ident[4] = v == V_ELF32 ? 1 : 2;
+   eh.ident[5] = v == V_BIG_ENDIAN ? 2 : 1;
+   eh.ident[6] = 1;
+   eh.ident[7] = v == V_OLD_ABI ? 0x33 : NV_ELF_OSABI_41;
+   eh.type = 2;
+   eh.machine = v == V_NOT_CUDA ? 62 : 190;
+   eh.version = 1;
+   eh.shoff = v == V_SHOFF_PAST_END ? out.size + 64 : shoff;
+   eh.flags = v == V_OLD_ABI ? (SM << 16) | SM : (SM << 8) | 0x8;
+   eh.ehsize = sizeof(eh);
+   eh.shentsize = sizeof(struct shdr);
+   eh.shnum = v == V_XINDEX ? 0 : n;
+   eh.shstrndx = v == V_XINDEX ? 0xffff :
+                 v == V_SHSTRNDX_RANGE ? n + 3 : s_shstrtab;
+   if (v == V_BAD_MAGIC)
+      eh.ident[1] = 'X';
+   memcpy(out.data, &eh, sizeof(eh));
+
+   free(shstr.data);
+   free(str.data);
+   free(info.data);
+   free(info_k[0].data);
+   free(info_k[1].data);
+   *size_out = out.size;
+   return out.data;
+}
+
+static void
+check_valid(enum variant v, const struct nv_cubin_module *m,
+            const uint8_t *image, size_t size)
+{
+   CHECK(m->sm == SM, "sm %u", m->sm);
+   CHECK(m->abi == (v == V_OLD_ABI ? 0x33u : 0x41u), "abi 0x%x", m->abi);
+   CHECK(m->function_count == 2, "function_count %u", m->function_count);
+
+   const char *names[2] = { "k_main", "k_second" };
+   for (unsigned k = 0; k < 2; k++) {
+      const struct nv_cubin_function *f =
+         nv_cubin_elf_module_find_function(m, names[k]);
+      CHECK(f != NULL, "%s not found", names[k]);
+      if (!f)
+         continue;
+      CHECK(f->symbol_index == k + 1, "%s symbol_index %u", names[k],
+            f->symbol_index);
+      CHECK(f->func_offset == 0x100 * k, "%s func_offset 0x%zx", names[k],
+            f->func_offset);
+      CHECK(f->code_size == 0x200, "%s code_size 0x%zx", names[k],
+            f->code_size);
+      CHECK(f->code_ptr && f->code_ptr[0] == 1 && f->code_ptr[1] == 8,
+            "%s code bytes", names[k]);
+      /* The module keeps its own copy of the image */
+      CHECK(f->code_ptr && (f->code_ptr < image ||
+                            f->code_ptr >= image + size),
+            "%s code points into the caller's buffer", names[k]);
+      CHECK(f->gpr_count == REGS + k + 1, "%s gpr_count %u", names[k],
+            f->gpr_count);
+      CHECK(f->slm_size == STACK + k + 1, "%s slm_size %u", names[k],
+            f->slm_size);
+      CHECK(f->crs_size == CRS + k, "%s crs_size %u", names[k], f->crs_size);
+      CHECK(f->num_control_barriers == BARRIERS + (v == V_OLD_ABI ? 0 : k),
+            "%s barriers %u", names[k], f->num_control_barriers);
+      CHECK(f->params_offset == PARAMS_OFF + k, "%s params_offset 0x%x",
+            names[k], f->params_offset);
+      CHECK(f->params_size == PARAMS_SIZE, "%s params_size %u", names[k],
+            f->params_size);
+      CHECK(f->static_smem_size == (k == 0 ? SMEM : 0),
+            "%s static_smem_size 0x%x", names[k], f->static_smem_size);
+      CHECK(f->param_info_count == 2, "%s param_info_count %u", names[k],
+            f->param_info_count);
+      const struct nv_cubin_function_param_info *p0 =
+         nv_cubin_elf_function_get_param_info(f, 0);
+      const struct nv_cubin_function_param_info *p1 =
+         nv_cubin_elf_function_get_param_info(f, 1);
+      CHECK(p0 && p0->offset == 0 && p0->size == 8, "%s param 0", names[k]);
+      CHECK(p1 && p1->offset == 8 && p1->size == 16, "%s param 1", names[k]);
+      CHECK(nv_cubin_elf_function_get_param_info(f, 2) == NULL,
+            "%s param 2 exists", names[k]);
+   }
+   CHECK(nv_cubin_elf_module_find_function(m, "local_fn") == NULL,
+         "local function listed");
+   CHECK(nv_cubin_elf_module_find_function(m, "some_data") == NULL,
+         "data object listed");
+}
+
+#ifdef USE_LIBELF
+static void compare_parsers(const char *what, const void *data, size_t size);
+#endif
+
+static void
+run_synthetic(void)
+{
+   static const struct {
+      enum variant v;
+      const char *name;
+      bool valid;
+   } cases[] = {
+      { V_OK, "valid", true },
+      { V_OLD_ABI, "old ABI", true },
+      { V_XINDEX, "extended section numbering", true },
+      { V_BAD_MAGIC, "bad magic", false },
+      { V_ELF32, "ELF32", false },
+      { V_BIG_ENDIAN, "big-endian", false },
+      { V_NOT_CUDA, "not EM_CUDA", false },
+      { V_SHOFF_PAST_END, "section headers past the end", false },
+      { V_SHSTRNDX_RANGE, "e_shstrndx out of range", false },
+      { V_SECTION_PAST_END, "section data past the end", false },
+      { V_SYM_PAST_SECTION, "function past its section", false },
+      { V_SYM_BAD_SHNDX, "function in a missing section", false },
+      { V_NVINFO_TRUNCATED, "truncated .nv.info attribute", false },
+      { V_NO_EXT_NVINFO, "no .nv.info.<kernel>", false },
+      { V_ENTSIZE_ZERO, "symbol table entsize 0", false },
+      { V_STRTAB_UNTERMINATED, "unterminated string table", true },
+   };
+
+   for (unsigned i = 0; i < sizeof(cases) / sizeof(cases[0]); i++) {
+      size_t size;
+      uint8_t *image = make_cubin(cases[i].v, &size);
+      struct nv_cubin_module m;
+      int before = failures;
+
+      quiet_errors = !cases[i].valid;
+      bool ok = nv_cubin_elf_module_init(&m, image, size);
+      quiet_errors = false;
+      CHECK(ok == cases[i].valid, "%s: init returned %d", cases[i].name, ok);
+      if (ok && cases[i].valid) {
+         /* Scribble over the input: the module must not depend on it */
+         uint8_t *copy = malloc(size);
+         memcpy(copy, image, size);
+         memset(image, 0xcd, size);
+         check_valid(cases[i].v, &m, image, size);
+         memcpy(image, copy, size);
+         free(copy);
+      }
+      nv_cubin_elf_module_fini(&m);
+
+      /* Every proper prefix of a valid cubin must be refused or parsed
+       * without reading past it (run under ASan/valgrind to see the
+       * difference). */
+      if (cases[i].v == V_OK) {
+         for (size_t cut = 0; cut < size; cut += (cut < 128 ? 1 : 61)) {
+            uint8_t *prefix = malloc(cut ? cut : 1);
+            memcpy(prefix, image, cut);
+            quiet_errors = true;
+            if (nv_cubin_elf_module_init(&m, prefix, cut))
+               CHECK(m.function_count <= 2, "prefix %zu", cut);
+            quiet_errors = false;
+            nv_cubin_elf_module_fini(&m);
+            free(prefix);
+         }
+
+         /* Unaligned input buffer */
+         uint8_t *odd = malloc(size + 3);
+         memcpy(odd + 3, image, size);
+         ok = nv_cubin_elf_module_init(&m, odd + 3, size);
+         CHECK(ok, "unaligned buffer refused");
+         if (ok)
+            check_valid(V_OK, &m, odd + 3, size);
+         nv_cubin_elf_module_fini(&m);
+         free(odd);
+      }
+
+#ifdef USE_LIBELF
+      if (cases[i].valid && cases[i].v != V_STRTAB_UNTERMINATED)
+         compare_parsers(cases[i].name, image, size);
+#endif
+      printf("%s %s\n", failures == before ? "ok  " : "FAIL", cases[i].name);
+      free(image);
+   }
+}
+
+/* --- real cubins --- */
+
+static uint8_t *
+read_file(const char *path, size_t *size)
+{
+   FILE *f = fopen(path, "rb");
+   if (!f)
+      return NULL;
+   fseek(f, 0, SEEK_END);
+   long len = ftell(f);
+   fseek(f, 0, SEEK_SET);
+   uint8_t *data = malloc(len > 0 ? len : 1);
+   *size = fread(data, 1, len, f);
+   fclose(f);
+   return data;
+}
+
+/* The extent of an ELF64 image at p: the end of its section headers or of
+ * its furthest section, whichever is later. */
+static size_t
+elf_extent(const uint8_t *p, size_t avail)
+{
+   struct ehdr eh;
+   if (avail < sizeof(eh))
+      return 0;
+   memcpy(&eh, p, sizeof(eh));
+   if (eh.shentsize != sizeof(struct shdr) || eh.shnum == 0)
+      return 0;
+   size_t end = eh.shoff + (size_t)eh.shnum * sizeof(struct shdr);
+   if (eh.shoff > avail || end > avail)
+      return 0;
+   for (unsigned i = 0; i < eh.shnum; i++) {
+      struct shdr sh;
+      memcpy(&sh, p + eh.shoff + i * sizeof(sh), sizeof(sh));
+      if (sh.type != 8 && sh.offset + sh.size > end &&
+          sh.offset + sh.size <= avail)
+         end = sh.offset + sh.size;
+   }
+   return end;
+}
+
+static void
+dump_module(FILE *out, const struct nv_cubin_module *m,
+            const struct nv_cubin_function *(*find)(const struct nv_cubin_module *, const char *),
+            const struct nv_cubin_function_param_info *(*param)(const struct nv_cubin_function *, uint32_t))
+{
+   fprintf(out, "sm %u abi 0x%x functions %u\n", m->sm, m->abi,
+           m->function_count);
+   for (uint32_t i = 0; i < m->function_count; i++) {
+      const struct nv_cubin_function *f = &m->functions[i];
+      fprintf(out, " %s sym %u off 0x%zx code 0x%zx gpr %u slm %u crs %u "
+              "bar %u smem %u params 0x%x+%u nparams %u\n",
+              f->name, f->symbol_index, f->func_offset, f->code_size,
+              f->gpr_count, f->slm_size, f->crs_size,
+              f->num_control_barriers, f->static_smem_size, f->params_offset,
+              f->params_size, f->param_info_count);
+      for (uint32_t p = 0; p < f->param_info_count; p++) {
+         const struct nv_cubin_function_param_info *pi = param(f, p);
+         if (pi)
+            fprintf(out, "  param %u: index %u offset %u size %u\n", p,
+                    pi->index, pi->offset, pi->size);
+      }
+      if (find(m, f->name) == NULL)
+         fprintf(out, "  (not found by name)\n");
+   }
+}
+
+#ifdef USE_LIBELF
+static char *
+dump_to_string(const struct nv_cubin_module *m, bool elf_variant)
+{
+   char *s = NULL;
+   size_t len = 0;
+   FILE *f = open_memstream(&s, &len);
+   if (elf_variant)
+      dump_module(f, m, nv_cubin_elf_module_find_function,
+                  nv_cubin_elf_function_get_param_info);
+   else
+      dump_module(f, m, nv_cubin_module_find_function,
+                  nv_cubin_function_get_param_info);
+   fclose(f);
+   return s;
+}
+
+static bool
+same_code(const struct nv_cubin_module *a, const struct nv_cubin_module *b)
+{
+   for (uint32_t i = 0; i < a->function_count && i < b->function_count; i++) {
+      if (a->functions[i].code_size != b->functions[i].code_size ||
+          memcmp(a->functions[i].code_ptr, b->functions[i].code_ptr,
+                 a->functions[i].code_size))
+         return false;
+   }
+   return true;
+}
+
+static void
+compare_parsers(const char *what, const void *data, size_t size)
+{
+   struct nv_cubin_module a, b;
+   memset(&b, 0, sizeof(b));
+   bool ok_a = nv_cubin_elf_module_init(&a, data, size);
+   bool ok_b = nv_cubin_module_init(&b, data, size);
+   CHECK(ok_a == ok_b, "%s: in-tree %d, libelf %d", what, ok_a, ok_b);
+   if (ok_a && ok_b) {
+      char *da = dump_to_string(&a, true);
+      char *db = dump_to_string(&b, false);
+      CHECK(strcmp(da, db) == 0, "%s: parsers differ\nin-tree:\n%slibelf:\n%s",
+            what, da, db);
+      CHECK(same_code(&a, &b), "%s: code bytes differ", what);
+      free(da);
+      free(db);
+   }
+   nv_cubin_elf_module_fini(&a);
+   nv_cubin_module_fini(&b);
+}
+#endif
+
+static void
+run_file(const char *path, bool verbose)
+{
+   size_t size;
+   uint8_t *data = read_file(path, &size);
+   if (!data) {
+      CHECK(false, "cannot read %s", path);
+      return;
+   }
+
+   unsigned found = 0, parsed = 0, functions = 0;
+   unsigned by_sm[256] = { 0 };
+   for (size_t off = 0; off + 64 <= size; off++) {
+      if (memcmp(data + off, "\x7f" "ELF\x02\x01", 6) != 0 ||
+          data[off + 18] != 190 || data[off + 19] != 0)
+         continue;
+      size_t len = elf_extent(data + off, size - off);
+      if (len == 0)
+         continue;
+      found++;
+
+      struct nv_cubin_module m;
+      if (nv_cubin_elf_module_init(&m, data + off, len)) {
+         parsed++;
+         functions += m.function_count;
+         by_sm[m.sm & 0xff]++;
+         if (verbose) {
+            printf("%s+0x%zx:\n", path, off);
+            dump_module(stdout, &m, nv_cubin_elf_module_find_function,
+                        nv_cubin_elf_function_get_param_info);
+         }
+      } else {
+         CHECK(false, "%s+0x%zx: in-tree parser refused it", path, off);
+      }
+      nv_cubin_elf_module_fini(&m);
+
+#ifdef USE_LIBELF
+      char what[512];
+      snprintf(what, sizeof(what), "%s+0x%zx", path, off);
+      compare_parsers(what, data + off, len);
+#endif
+      off += len - 1;
+   }
+
+   printf("%s: %u CUDA ELFs, %u parsed, %u kernels; by sm:", path, found,
+          parsed, functions);
+   for (unsigned sm = 0; sm < 256; sm++)
+      if (by_sm[sm])
+         printf(" sm_%u x%u", sm, by_sm[sm]);
+   printf("\n");
+   free(data);
+}
+
+/* mesa_log for the parsers (util/log.c is not linked) */
+void
+mesa_log(int level, const char *tag, const char *format, ...)
+{
+   if (quiet_errors && !getenv("NV_CUBIN_TEST_VERBOSE"))
+      return;
+   va_list va;
+   va_start(va, format);
+   fprintf(stderr, "%s: ", tag);
+   vfprintf(stderr, format, va);
+   va_end(va);
+}
+
+int
+main(int argc, char **argv)
+{
+   bool verbose = getenv("NV_CUBIN_TEST_VERBOSE") != NULL;
+
+   run_synthetic();
+   for (int i = 1; i < argc; i++)
+      run_file(argv[i], verbose);
+
+#ifdef USE_LIBELF
+   printf("compared against libelf's nv_cubin.c\n");
+#endif
+   printf("%s (%d failures)\n", failures ? "FAILED" : "PASSED", failures);
+   return failures ? 1 : 0;
+}
