+
+/*
+ * Opt-in per-present frame-time log for the Win32 WSI (HELIOS_VK_FRAMETIME=1).
+ *
+ * A present through the Helios scanout path is a driver escape and a GDI
+ * present is a StretchBlt: neither raises the DXGI or DxgKrnl present events
+ * PresentMon builds its frames from, so PresentMon sees no frames from a
+ * native Vulkan application.  This log gives those frames back: one row per
+ * swapchain per vkQueuePresentKHR in
+ * %ProgramData%\Helios\vkframes-<pid>.csv (HELIOS_VK_FRAMETIME_DIR
+ * overrides the folder), with PresentMon v1 column names:
+ *
+ *   Application,ProcessID,SwapChainAddress,Runtime,TimeInSeconds,
+ *   MsBetweenPresents,MsInPresentAPI,Result
+ *
+ * The present thread only reads QPC twice and stores one ring entry.  A
+ * background thread turns the ring into CSV lines about once a second; the
+ * rest is written at swapchain destruction and at process exit.
+ */
+
+#include "wsi_common_private.h"
+
+#include <windows.h>
+#include <stdatomic.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define FT_RING_SIZE (1u << 16) /* power of two; ~65 s at 1000 presents/s */
+#define FT_MAX_CHAINS 16
+
+struct ft_entry {
+   _Atomic uint64_t seq; /* index + 1 once the entry is complete */
+   uint64_t swapchain;
+   int64_t start;        /* QPC at vkQueuePresentKHR entry */
+   int64_t end;          /* QPC at its return */
+   int32_t result;
+};
+
+static struct {
+   bool enabled;
+   _Atomic uint64_t write;
+   uint64_t read;        /* under lock */
+   uint64_t dropped;     /* under lock */
+   struct ft_entry *ring;
+   double ms_per_tick;
+   int64_t t0;
+   FILE *file;
+   char app[MAX_PATH];
+   CRITICAL_SECTION lock;
+   HANDLE thread;
+   struct {
+      uint64_t swapchain;
+      int64_t last_start;
+   } chains[FT_MAX_CHAINS];
+   unsigned next_chain;
+} ft;
+
+static INIT_ONCE ft_once = INIT_ONCE_STATIC_INIT;
+
+static void ft_flush(bool at_exit);
+
+static DWORD WINAPI
+ft_thread(LPVOID arg)
+{
+   (void)arg;
+   for (;;) {
+      Sleep(1000);
+      ft_flush(false);
+   }
+   return 0;
+}
+
+static void
+ft_atexit(void)
+{
+   ft_flush(true);
+}
+
+static FILE *
+ft_open(void)
+{
+   char dir[MAX_PATH];
+   const char *env = getenv("HELIOS_VK_FRAMETIME_DIR");
+   if (env && env[0]) {
+      snprintf(dir, sizeof(dir), "%s", env);
+   } else {
+      const char *pd = getenv("ProgramData");
+      snprintf(dir, sizeof(dir), "%s\\Helios", pd && pd[0] ? pd : "C:\\ProgramData");
+   }
+   CreateDirectoryA(dir, NULL);
+
+   char path[MAX_PATH];
+   snprintf(path, sizeof(path), "%s\\vkframes-%lu.csv", dir,
+            (unsigned long)GetCurrentProcessId());
+   FILE *f = fopen(path, "w");
+   if (!f) {
+      fprintf(stderr, "MESA-WSI: HELIOS_VK_FRAMETIME: cannot write %s\n", path);
+      return NULL;
+   }
+   fputs("Application,ProcessID,SwapChainAddress,Runtime,TimeInSeconds,"
+         "MsBetweenPresents,MsInPresentAPI,Result\n", f);
+   fflush(f);
+   return f;
+}
+
+static BOOL CALLBACK
+ft_init(PINIT_ONCE once, PVOID param, PVOID *ctx)
+{
+   (void)once; (void)param; (void)ctx;
+   const char *env = getenv("HELIOS_VK_FRAMETIME");
+   if (!env || !env[0] || env[0] == '0')
+      return TRUE;
+
+   ft.ring = calloc(FT_RING_SIZE, sizeof(*ft.ring));
+   if (!ft.ring)
+      return TRUE;
+   ft.file = ft_open();
+   if (!ft.file) {
+      free(ft.ring);
+      ft.ring = NULL;
+      return TRUE;
+   }
+
+   LARGE_INTEGER freq, now;
+   QueryPerformanceFrequency(&freq);
+   QueryPerformanceCounter(&now);
+   ft.ms_per_tick = 1000.0 / (double)freq.QuadPart;
+   ft.t0 = now.QuadPart;
+
+   char exe[MAX_PATH] = "";
+   GetModuleFileNameA(NULL, exe, sizeof(exe));
+   const char *base = strrchr(exe, '\\');
+   snprintf(ft.app, sizeof(ft.app), "%s", base ? base + 1 : exe);
+   for (char *c = ft.app; *c; c++) {
+      if (*c == ',')
+         *c = '_';
+   }
+
+   InitializeCriticalSection(&ft.lock);
+
+   /* The flush thread runs code of this DLL until the process ends: pin the
+    * module so the loader's FreeLibrary at vkDestroyInstance cannot unload it
+    * under the thread.  The exit flush then runs at DLL_PROCESS_DETACH.
+    */
+   HMODULE self;
+   GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                      GET_MODULE_HANDLE_EX_FLAG_PIN,
+                      (LPCSTR)(void *)ft_thread, &self);
+   ft.thread = CreateThread(NULL, 0, ft_thread, NULL, 0, NULL);
+   atexit(ft_atexit);
+
+   ft.enabled = true;
+   fprintf(stderr, "MESA-WSI: HELIOS_VK_FRAMETIME: logging presents of %s\n",
+           ft.app);
+   return TRUE;
+}
+
+bool
+wsi_win32_frametime_begin(int64_t *start)
+{
+   InitOnceExecuteOnce(&ft_once, ft_init, NULL, NULL);
+   if (!ft.enabled)
+      return false;
+   LARGE_INTEGER t;
+   QueryPerformanceCounter(&t);
+   *start = t.QuadPart;
+   return true;
+}
+
+void
+wsi_win32_frametime_end(int64_t start, const VkPresentInfoKHR *info,
+                        VkResult result)
+{
+   LARGE_INTEGER t;
+   QueryPerformanceCounter(&t);
+   for (uint32_t i = 0; i < info->swapchainCount; i++) {
+      const uint64_t idx = atomic_fetch_add_explicit(&ft.write, 1,
+                                                     memory_order_relaxed);
+      struct ft_entry *e = &ft.ring[idx & (FT_RING_SIZE - 1)];
+      atomic_store_explicit(&e->seq, 0, memory_order_relaxed);
+      atomic_thread_fence(memory_order_release);
+      e->swapchain = (uint64_t)info->pSwapchains[i];
+      e->start = start;
+      e->end = t.QuadPart;
+      e->result = info->pResults ? (int32_t)info->pResults[i] : (int32_t)result;
+      atomic_store_explicit(&e->seq, idx + 1, memory_order_release);
+   }
+}
+
+/* Under ft.lock: the previous present start of this swapchain (0: none) */
+static int64_t
+ft_chain_last(uint64_t swapchain, int64_t start)
+{
+   for (unsigned i = 0; i < FT_MAX_CHAINS; i++) {
+      if (ft.chains[i].swapchain == swapchain) {
+         const int64_t last = ft.chains[i].last_start;
+         ft.chains[i].last_start = start;
+         return last;
+      }
+   }
+   const unsigned i = ft.next_chain++ % FT_MAX_CHAINS;
+   ft.chains[i].swapchain = swapchain;
+   ft.chains[i].last_start = start;
+   return 0;
+}
+
+static void
+ft_flush(bool at_exit)
+{
+   if (!ft.enabled)
+      return;
+
+   /* At process exit the flush thread is gone, possibly while it held the
+    * lock: write without it then.
+    */
+   bool locked;
+   if (at_exit)
+      locked = TryEnterCriticalSection(&ft.lock);
+   else {
+      EnterCriticalSection(&ft.lock);
+      locked = true;
+   }
+
+   const uint64_t write = atomic_load_explicit(&ft.write, memory_order_acquire);
+   if (write - ft.read > FT_RING_SIZE) {
+      /* The writers lapped the reader: those entries are gone */
+      ft.dropped += write - ft.read - FT_RING_SIZE;
+      ft.read = write - FT_RING_SIZE;
+   }
+   while (ft.read < write) {
+      struct ft_entry *e = &ft.ring[ft.read & (FT_RING_SIZE - 1)];
+      const uint64_t seq = atomic_load_explicit(&e->seq, memory_order_acquire);
+      if (seq < ft.read + 1)
+         break; /* claimed, not yet written: next flush */
+      if (seq > ft.read + 1) {
+         ft.dropped++; /* overwritten by a later lap */
+         ft.read++;
+         continue;
+      }
+      const uint64_t sc = e->swapchain;
+      const int64_t start = e->start, end = e->end;
+      const int32_t res = e->result;
+      atomic_thread_fence(memory_order_acquire);
+      if (atomic_load_explicit(&e->seq, memory_order_relaxed) != seq) {
+         ft.dropped++;
+         ft.read++;
+         continue;
+      }
+      const int64_t last = ft_chain_last(sc, start);
+      char between[32] = "NA";
+      if (last != 0)
+         snprintf(between, sizeof(between), "%.4f", (double)(start - last) * ft.ms_per_tick);
+      fprintf(ft.file, "%s,%lu,0x%016llX,Vulkan,%.6f,%s,%.4f,%d\n",
+              ft.app, (unsigned long)GetCurrentProcessId(),
+              (unsigned long long)sc,
+              (double)(start - ft.t0) * ft.ms_per_tick / 1000.0, between,
+              (double)(end - start) * ft.ms_per_tick, res);
+      ft.read++;
+   }
+   fflush(ft.file);
+
+   if (at_exit && ft.dropped)
+      fprintf(stderr, "MESA-WSI: HELIOS_VK_FRAMETIME: %llu presents dropped\n",
+              (unsigned long long)ft.dropped);
+   if (locked)
+      LeaveCriticalSection(&ft.lock);
+}
+
+void
+wsi_win32_frametime_flush(void)
+{
+   if (ft.enabled)
+      ft_flush(false);
+}
-- 
