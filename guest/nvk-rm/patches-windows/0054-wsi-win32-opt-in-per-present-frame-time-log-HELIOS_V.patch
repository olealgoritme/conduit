From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ole Algoritme <olealgoritme@gmail.com>
Date: Thu, 8 Oct 2026 11:48:29 +0200
Subject: [PATCH] wsi/win32: opt-in per-present frame-time log
 (HELIOS_VK_FRAMETIME=1)

A Win32 present through the Helios scanout path is a driver escape and
a GDI present is a StretchBlt: neither raises the DXGI or DxgKrnl
present events PresentMon builds its frames from, so PresentMon shows no
frames for a native Vulkan application on NVK.

With HELIOS_VK_FRAMETIME=1 every vkQueuePresentKHR stores two QPC reads
per swapchain in a lock-free ring; a background thread writes them about
once a second to %ProgramData%\Helios\vkframes-<pid>.csv
(HELIOS_VK_FRAMETIME_DIR overrides the folder), with PresentMon v1
column names: Application, ProcessID, SwapChainAddress, Runtime,
TimeInSeconds, MsBetweenPresents (per swapchain, NA for its first
present), MsInPresentAPI (time inside vkQueuePresentKHR) and Result.
The rest is written when a swapchain is destroyed and at process exit.
The module is pinned while the thread runs, so the loader's FreeLibrary
cannot unload it. Off by default; Windows builds only.
---
 src/vulkan/wsi/meson.build                  |   2 +-
 src/vulkan/wsi/wsi_common.c                 |  11 +
 src/vulkan/wsi/wsi_common_private.h         |   8 +
 src/vulkan/wsi/wsi_common_win32_frametime.c | 299 ++++++++++++++++++++
 4 files changed, 319 insertions(+), 1 deletion(-)
 create mode 100644 src/vulkan/wsi/wsi_common_win32_frametime.c

diff --git a/src/vulkan/wsi/meson.build b/src/vulkan/wsi/meson.build
index 80925d14..7b839b2d 100644
--- a/src/vulkan/wsi/meson.build
+++ b/src/vulkan/wsi/meson.build
@@ -28,7 +28,7 @@ if with_platform_wayland
 endif
 
 if with_platform_windows
-  files_vulkan_wsi += files('wsi_common_win32.cpp')
+  files_vulkan_wsi += files('wsi_common_win32.cpp', 'wsi_common_win32_frametime.c')
   platform_deps += dep_dxheaders
 else
   files_vulkan_wsi += files('wsi_common_headless.c')
diff --git a/src/vulkan/wsi/wsi_common.c b/src/vulkan/wsi/wsi_common.c
index ef8eaf2c..9a2d261d 100644
--- a/src/vulkan/wsi/wsi_common.c
+++ b/src/vulkan/wsi/wsi_common.c
@@ -667,6 +667,9 @@ wsi_swapchain_get_present_mode(struct wsi_device *wsi,
 void
 wsi_swapchain_finish(struct wsi_swapchain *chain)
 {
+#ifdef _WIN32
+   wsi_win32_frametime_flush();
+#endif
    wsi_destroy_image_info(chain, &chain->image_info);
 
    if (chain->fences) {
@@ -2448,6 +2451,10 @@ wsi_common_queue_present(const struct wsi_device *wsi,
                          struct vk_queue *queue,
                          const VkPresentInfoKHR *pPresentInfo)
 {
+#ifdef _WIN32
+   int64_t ft_start = 0;
+   const bool ft_on = wsi_win32_frametime_begin(&ft_start);
+#endif
    struct vk_device *dev = queue->base.device;
    uint32_t current_frame = p_atomic_fetch_add(&dev->current_frame, 1);
    VkResult final_result = handle_trace(queue, dev, current_frame);
@@ -2931,6 +2938,10 @@ wsi_common_queue_present(const struct wsi_device *wsi,
    STACK_ARRAY_FINISH(semaphore_wait_infos);
    STACK_ARRAY_FINISH(results);
 
+#ifdef _WIN32
+   if (ft_on)
+      wsi_win32_frametime_end(ft_start, pPresentInfo, final_result);
+#endif
    return final_result;
 }
 
diff --git a/src/vulkan/wsi/wsi_common_private.h b/src/vulkan/wsi/wsi_common_private.h
index 89ebc867..ba65be82 100644
--- a/src/vulkan/wsi/wsi_common_private.h
+++ b/src/vulkan/wsi/wsi_common_private.h
@@ -629,6 +629,14 @@ wsi_metal_configure_image(const struct wsi_swapchain *chain,
                           struct wsi_image_info *info);
 #endif /* defined(VK_USE_PLATFORM_METAL_EXT) */
 
+#ifdef _WIN32
+/* Opt-in present log (HELIOS_VK_FRAMETIME=1), wsi_common_win32_frametime.c */
+bool wsi_win32_frametime_begin(int64_t *start);
+void wsi_win32_frametime_end(int64_t start, const VkPresentInfoKHR *info,
+                             VkResult result);
+void wsi_win32_frametime_flush(void);
+#endif
+
 #ifdef __cplusplus
 }
 #endif
diff --git a/src/vulkan/wsi/wsi_common_win32_frametime.c b/src/vulkan/wsi/wsi_common_win32_frametime.c
new file mode 100644
index 00000000..3e2110fe
--- /dev/null
+++ b/src/vulkan/wsi/wsi_common_win32_frametime.c
@@ -0,0 +1,299 @@
