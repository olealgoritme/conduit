@@ -488,6 +510,21 @@ void nvkmd_rm_rmfence_finish(struct nvkmd_rm_dev *dev);
 /* Waits until the flip thread has sent every flip queued so far */
 void nvkmd_rm_rmfence_drain(struct nvkmd_rm_dev *dev);
 
+/*
+ * Scanout buffer release (KMD 22.22.315+, QueryCaps bit 35,
+ * guest/windows/docs/foreign-scanout.md "Buffer release"): the host says
+ * when it is done reading a flipped image.
+ */
+/* Whether the KMD tracks releases (asked once per device) */
