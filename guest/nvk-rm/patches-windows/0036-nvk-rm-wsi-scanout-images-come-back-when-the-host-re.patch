    if (ret == 0) {
       p_atomic_inc(&dev->flips_ok);
    } else {
diff --git a/src/vulkan/wsi/wsi_common.h b/src/vulkan/wsi/wsi_common.h
index cf99648..32c041c 100644
--- a/src/vulkan/wsi/wsi_common.h
+++ b/src/vulkan/wsi/wsi_common.h
@@ -181,6 +181,15 @@ struct wsi_device {
       VkResult (*scanout_flip_fenced)(VkDevice device, VkQueue queue,
                                       VkDeviceMemory memory,
                                       const struct wsi_win32_scanout_flip *flip);
+      /* Optional: the display tells when it is done with a shown image.
+       * Waits (at most timeout_ns) until the display no longer reads
+       * `memory` (an image never shown is done): VK_SUCCESS, VK_TIMEOUT.
+       * memory == VK_NULL_HANDLE asks whether this works on `device` at all:
+       * VK_SUCCESS or VK_ERROR_FEATURE_NOT_PRESENT.  Without it an image comes
+       * back a fixed number of presents after it was shown.
+       */
+      VkResult (*scanout_wait_released)(VkDevice device, VkDeviceMemory memory,
+                                        uint64_t timeout_ns);
       void (*scanout_release)(VkDevice device);
    } win32;
 
