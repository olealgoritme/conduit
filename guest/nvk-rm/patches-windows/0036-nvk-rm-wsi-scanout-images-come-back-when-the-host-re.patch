 src/nouveau/vulkan/nvkmd/rm/nvkmd_rm.h        |  37 +++++
 src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_dev.c    |   6 +-
 src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_lib.c    |   2 +
 .../vulkan/nvkmd/rm/nvkmd_rm_rmfence.c        | 130 +++++++++++++++++-
 src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_win.c    |  11 +-
 src/vulkan/wsi/wsi_common.h                   |   9 ++
 src/vulkan/wsi/wsi_common_win32.cpp           |  86 +++++++++++-
 8 files changed, 284 insertions(+), 16 deletions(-)

diff --git a/src/nouveau/vulkan/nvk_wsi.c b/src/nouveau/vulkan/nvk_wsi.c
index 1de0f26..769ff85 100644
--- a/src/nouveau/vulkan/nvk_wsi.c
+++ b/src/nouveau/vulkan/nvk_wsi.c
@@ -91,6 +91,23 @@ nvk_wsi_scanout_flip_fenced(VkDevice _device, VkQueue _queue,
                                            fence);
 }
 
+/* Buffer release (KMD 22.22.315+): the host says when it no longer reads an
+ * image, so the WSI hands it back exactly then.
+ */
+static VkResult
+nvk_wsi_scanout_wait_released(VkDevice _device, VkDeviceMemory _mem,
+                              uint64_t timeout_ns)
+{
+   VK_FROM_HANDLE(nvk_device, dev, _device);
+   VK_FROM_HANDLE(nvk_device_memory, mem, _mem);
+
+   if (mem == NULL) {
+      return nvkmd_rm_dev_scanout_release_tracked(dev->nvkmd) ?
+             VK_SUCCESS : VK_ERROR_FEATURE_NOT_PRESENT;
+   }
+   return nvkmd_rm_mem_scanout_wait_released(mem->mem, timeout_ns);
+}
+
 static void
 nvk_wsi_scanout_release(VkDevice _device)
 {
@@ -144,6 +161,8 @@ nvk_init_wsi(struct nvk_physical_device *pdev)
    if (nvkmd_rm_scanout_supported(pdev->nvkmd)) {
       pdev->wsi_device.win32.scanout_export = nvk_wsi_scanout_export;
       pdev->wsi_device.win32.scanout_flip = nvk_wsi_scanout_flip;
+      pdev->wsi_device.win32.scanout_wait_released =
+         nvk_wsi_scanout_wait_released;
       pdev->wsi_device.win32.scanout_flip_fenced =
          debug_get_bool_option("NVK_RM_FENCE", true) ?
          nvk_wsi_scanout_flip_fenced : NULL;
