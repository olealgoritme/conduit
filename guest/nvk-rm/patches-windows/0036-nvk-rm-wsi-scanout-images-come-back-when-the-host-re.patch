 }
+
+/*
+ * Scanout buffer release (KMD 22.22.315+, guest/windows/docs/foreign-scanout.md
+ * "Buffer release").  An image whose latest present returned seq P may be
+ * written again once SCANOUT_STATUS's released floor for our DRM handle is
+ * >= P; the KMD's SCANOUT_RELEASED event wakes the wait.
+ */
+
+/* Past the host's own forced release (500 ms) */
+#define NVKMD_RM_RELEASE_MAX_WAIT_MS 1000u
+
+bool
+nvkmd_rm_dev_scanout_release_tracked(struct nvkmd_dev *_dev)
+{
+   struct nvkmd_rm_dev *dev = nvkmd_rm_dev(_dev);
+   const struct nvkmd_rm_lib *lib = dev->lib;
+
+   if (p_atomic_read(&dev->release_tracked) != 0)
+      return dev->release_tracked > 0;
+
+   uint64_t ops = 0;
+   const bool tracked =
+      debug_get_bool_option("NVK_SCANOUT_RELEASE", true) &&
+      lib->win_caps != NULL && lib->win_scanout_status != NULL &&
+      lib->win_scanout_wait_released != NULL &&
+      lib->win_caps(&ops, NULL) == 0 && (ops & (1ull << 35)) != 0;
+   p_atomic_set(&dev->release_tracked, tracked ? 1 : -1);
+   if (dev->base.pdev->debug_flags & NVK_DEBUG_VM) {
+      fprintf(stderr, "NVK: scanout buffer release %s\n",
+              tracked ? "tracked by the KMD" : "not tracked (older KMD or host)");
+   }
+   return tracked;
+}
+
+VkResult
+nvkmd_rm_mem_scanout_wait_released(struct nvkmd_mem *_mem, uint64_t timeout_ns)
+{
+   struct nvkmd_rm_mem *mem = nvkmd_rm_mem(_mem);
+   struct nvkmd_rm_dev *dev = nvkmd_rm_dev(_mem->dev);
+   struct nvkmd_rm_rmfence *rf = dev->rmfence;
+
+   if (!nvkmd_rm_dev_scanout_release_tracked(&dev->base))
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+
+   const uint64_t abs_timeout = os_time_get_absolute_timeout(timeout_ns);
+
+   /* A flip of it still in the flip thread has no seq yet: the thread sends
+    * them in order, so wait for it to go first.
+    */
+   if (rf != NULL && rf->thread_started) {
+      mtx_lock(&rf->q_mutex);
+      while (p_atomic_read(&mem->scanout_pending) != 0) {
+         if (timeout_ns == 0) {
+            mtx_unlock(&rf->q_mutex);
+            return VK_TIMEOUT;
+         }
+         struct timespec ts;
+         timespec_from_nsec(&ts, abs_timeout);
+         if (cnd_timedwait(&rf->q_cond, &rf->q_mutex, &ts) == thrd_timedout &&
+             p_atomic_read(&mem->scanout_pending) != 0) {
+            mtx_unlock(&rf->q_mutex);
+            return VK_TIMEOUT;
+         }
+      }
+      mtx_unlock(&rf->q_mutex);
+   }
+
+   const uint64_t seq = p_atomic_read(&mem->scanout_seq);
+   if (seq == 0 || dev->drm_fd < 0)
+      return VK_SUCCESS;
+
+   const uint64_t now = os_time_get_nano();
+   uint64_t left_ms = abs_timeout > now ?
+                      DIV_ROUND_UP(abs_timeout - now, 1000000) : 0;
+   if (left_ms > NVKMD_RM_RELEASE_MAX_WAIT_MS)
+      left_ms = NVKMD_RM_RELEASE_MAX_WAIT_MS;
+
+   uint64_t released = 0;
+   p_atomic_inc(&dev->release_waits);
+   const int ret = dev->lib->win_scanout_wait_released((uint32_t)dev->drm_fd,
+                                                       seq, (uint32_t)left_ms,
+                                                       &released);
+   if (ret == 1)
+      return VK_SUCCESS;
+   if (ret == 0) {
+      /* Within the caller's timeout: report it.  Past the host's forced
+       * release with the transport up: the host stopped answering; write
+       * the image anyway (it may tear) rather than stall the app.
+       */
+      if (left_ms < NVKMD_RM_RELEASE_MAX_WAIT_MS)
+         return VK_TIMEOUT;
+      const uint64_t n = p_atomic_inc_return(&dev->release_timeouts);
+      if (n <= 4 || n % 600 == 0)
+         mesa_logw("NVK: scanout image (seq %" PRIu64 ") not released after "
+                   "%u ms (floor %" PRIu64 "), reusing it (%" PRIu64 " so far)",
+                   seq, NVKMD_RM_RELEASE_MAX_WAIT_MS, released, n);
+      return VK_SUCCESS;
+   }
+   if (ret == -ENOSYS) {
+      /* The capability went away (a device reset onto another host) */
+      p_atomic_set(&dev->release_tracked, -1);
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+   }
+   /* The transport went away: nothing reads the image any more */
+   return VK_SUCCESS;
+}
