+
+/*
+ * Helios resource ids for RM memory (guest/windows/docs/dxvk-on-nvk.md, S3).
+ *
+ * The Helios D3D11 UMD running DXVK on NVK needs a KMD resource id for every
+ * image that becomes a WDDM allocation (swapchain buffers, shared surfaces),
+ * so that the allocation can adopt it and DWM, on Venus, can compose it.  The
+ * KMD mints one with HELIOS_ESCAPE_FOREIGN_RESOURCE IMPORT_RM from a GEM object
+ * of a host render node this process opened (the same export the scanout path
+ * makes) and attaches it to a Venus "holder" context of this process.  The
+ * host imports the object as a dma-buf; the layout travels with the request
+ * because nothing downstream can query it.
+ *
+ * One holder context per process: librmclient's transport is one D3DKMT
+ * device per process, and IMPORT_RM requires the context and the DRM file to
+ * belong to the same device.
+ */
+
+static simple_mtx_t helios_ctx_mutex = SIMPLE_MTX_INITIALIZER;
+static uint32_t helios_holder_ctx;
+static bool helios_holder_failed;
+
+bool
+nvkmd_rm_win_adapter_luid(uint8_t luid[8])
+{
+   const struct nvkmd_rm_lib *lib = nvkmd_rm_lib_get();
+   uint32_t low = 0;
+   int32_t high = 0;
+
+   if (lib == NULL || lib->win_adapter_luid == NULL ||
+       lib->win_adapter_luid(&low, &high) != 0)
+      return false;
+   if (low == 0 && high == 0)
+      return false;
+
+   memcpy(luid, &low, 4);
+   memcpy(luid + 4, &high, 4);
+   return true;
+}
+
+bool
+nvkmd_rm_win_rm_import_served(void)
+{
+   const struct nvkmd_rm_lib *lib = nvkmd_rm_lib_get();
+   uint32_t caps = 0;
+
+   if (!debug_get_bool_option("NVK_HELIOS_RESID", true))
+      return false;
+   if (lib == NULL || lib->win_foreign_caps == NULL ||
+       lib->win_import_rm == NULL || lib->win_venus_ctx_create == NULL)
+      return false;
+   /* Asked every time: the KMD opens the gate when the host feature bit is
+    * there, which can change across a device reset.  One escape, called once
+    * per resource id at most.
+    */
+   if (lib->win_foreign_caps(&caps) != 0)
+      return false;
+   return (caps & 1u) != 0;
+}
+
+uint32_t
+nvkmd_rm_win_holder_ctx(void)
+{
+   simple_mtx_lock(&helios_ctx_mutex);
+   const uint32_t ctx = helios_holder_ctx;
+   simple_mtx_unlock(&helios_ctx_mutex);
+   return ctx;
+}
+
+static uint32_t
+get_holder_ctx(const struct nvkmd_rm_lib *lib)
+{
+   simple_mtx_lock(&helios_ctx_mutex);
+   if (helios_holder_ctx == 0 && !helios_holder_failed) {
+      uint32_t ctx = 0;
+      int ret = lib->win_venus_ctx_create(&ctx);
+      if (ret != 0 || ctx == 0) {
+         helios_holder_failed = true;
+         mesa_logw("NVK: no Helios holder context (%d), no resource ids", ret);
+      } else {
+         helios_holder_ctx = ctx;
+      }
+   }
+   const uint32_t ctx = helios_holder_ctx;
+   simple_mtx_unlock(&helios_ctx_mutex);
+   return ctx;
+}
+
+void
+nvkmd_rm_mem_set_export_layout(struct nvkmd_mem *_mem, uint8_t pte_kind,
+                               uint16_t tile_mode)
+{
+   struct nvkmd_rm_mem *mem = nvkmd_rm_mem(_mem);
+
+   simple_mtx_lock(&mem->export_mutex);
+   /* Only before the first export: the GEM object keeps the layout it was
+    * imported with.
+    */
+   if (mem->gem_handle == 0) {
+      mem->pte_kind = pte_kind;
+      mem->tile_mode = tile_mode;
+   }
+   simple_mtx_unlock(&mem->export_mutex);
+}
+
+VkResult
+nvkmd_rm_mem_helios_res_id(struct nvkmd_mem *_mem,
+                           struct vk_object_base *log_obj,
+                           const struct nvkmd_rm_foreign_layout *layout,
+                           uint32_t *res_id_out)
+{
+   struct nvkmd_rm_mem *mem = nvkmd_rm_mem(_mem);
+   struct nvkmd_rm_dev *dev = nvkmd_rm_dev(_mem->dev);
+   const struct nvkmd_rm_lib *lib = dev->lib;
+   VkResult result = VK_SUCCESS;
+
+   *res_id_out = 0;
+   if (!nvkmd_rm_scanout_supported(dev->base.pdev) ||
+       !nvkmd_rm_win_rm_import_served())
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+
+   const uint32_t ctx = get_holder_ctx(lib);
+   if (ctx == 0)
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+
+   simple_mtx_lock(&mem->export_mutex);
+   if (mem->helios_res_id != 0) {
+      *res_id_out = mem->helios_res_id;
+      simple_mtx_unlock(&mem->export_mutex);
+      return VK_SUCCESS;
+   }
+   if (mem->gem_handle == 0)
+      result = export_to_gem(dev, mem, log_obj, &mem->gem_handle);
+   if (result == VK_SUCCESS) {
+      const struct nvrm_crm_foreign_import imp = {
+         .ctx_id = ctx,
+         .rm_handle = (uint32_t)dev->drm_fd,
+         .gem_handle = mem->gem_handle,
+         .fourcc = layout->fourcc,
+         .size = mem->base.size_B,
+         .modifier = layout->modifier,
+         .width = layout->width,
+         .height = layout->height,
+         .stride = layout->stride,
+         .offset = layout->offset,
+      };
+      uint32_t res_id = 0, host_errno = 0;
+      int ret = lib->win_import_rm(&imp, &res_id, &host_errno);
+      if (ret == 0 && res_id != 0) {
+         mem->helios_res_id = res_id;
+         mem->helios_res_ctx = ctx;
+         *res_id_out = res_id;
+      } else {
+         result = vk_errorf(log_obj, ret == -ENOSYS ?
+                            VK_ERROR_FEATURE_NOT_PRESENT :
+                            VK_ERROR_OUT_OF_DEVICE_MEMORY,
+                            "Helios IMPORT_RM of GEM %u (%ux%u stride %u "
+                            "fourcc 0x%08x modifier 0x%" PRIx64 ", %" PRIu64
+                            " B): %d, host errno %u", mem->gem_handle,
+                            layout->width, layout->height, layout->stride,
+                            layout->fourcc, layout->modifier,
+                            mem->base.size_B, ret, host_errno);
+      }
+   }
+   simple_mtx_unlock(&mem->export_mutex);
+
+   if (result == VK_SUCCESS && (dev->base.pdev->debug_flags & NVK_DEBUG_VM)) {
+      fprintf(stderr, "NVK: RM memory 0x%x is Helios resource %u (ctx %u, "
+              "GEM %u, %ux%u stride %u modifier 0x%" PRIx64 ")\n",
+              mem->h_memory, *res_id_out, ctx, mem->gem_handle,
+              layout->width, layout->height, layout->stride,
+              layout->modifier);
+   }
+   return result;
+}
+
+uint32_t
+nvkmd_rm_mem_helios_res_adopt(struct nvkmd_mem *_mem)
+{
+   struct nvkmd_rm_mem *mem = nvkmd_rm_mem(_mem);
+
+   simple_mtx_lock(&mem->export_mutex);
+   const uint32_t res_id = mem->helios_res_id;
+   if (res_id != 0)
+      mem->helios_res_adopted = true;
+   simple_mtx_unlock(&mem->export_mutex);
+   return res_id;
+}
+
+void
+nvkmd_rm_mem_helios_res_release(struct nvkmd_rm_mem *mem)
+{
+   const struct nvkmd_rm_lib *lib = nvkmd_rm_lib_get();
+
+   if (mem->helios_res_id == 0 || mem->helios_res_adopted)
+      return;
+   /* No allocation took it: the KMD would hold it (and the host its
+    * dma-buf) until the device goes away.
+    */
+   if (lib != NULL && lib->win_release_blob != NULL)
+      lib->win_release_blob(mem->helios_res_ctx, mem->helios_res_id);
+   mem->helios_res_id = 0;
+}
