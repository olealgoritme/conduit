+
 #include "nvk_device.h"
 #include "nvk_entrypoints.h"
 #include "nvk_image.h"
@@ -157,7 +161,22 @@ nvk_AllocateMemory(VkDevice device,
    if (fd_info != NULL)
       handle_types |= fd_info->handleType;
 
-   const bool not_shared = handle_types == 0;
+#ifdef _WIN32
+   /* The Helios UMD will make a KMD resource id of this memory
+    * (helios_icd_interface.h): standalone, shared, uncompressed, with the
+    * image's layout recorded for the export.
+    */
+   bool helios_export = false;
+   vk_foreach_struct_const(stype, ext, pAllocateInfo->pNext) {
+      (void)ext;
+      if (stype == HELIOS_STRUCTURE_TYPE_EXPORT_MEMORY_RESOURCE_INFO)
+         helios_export = true;
+   }
+#else
+   const bool helios_export = false;
+#endif
+
+   const bool not_shared = handle_types == 0 && !helios_export;
    bool pinned_to_vram = false;
 
    /* Align to os page size (typically 4K) as a start as this works for
@@ -200,6 +219,12 @@ nvk_AllocateMemory(VkDevice device,
             alignment = (1ULL << 21);
          else
             alignment = (1ULL << 16);
+      } else if (helios_export && image->plane_count == 1 &&
+                 image->planes[0].nil.pte_kind != 0) {
+         /* Uncompressed block-linear: the layout an importer can read */
+         alignment = MAX2(alignment, image->planes[0].nil.align_B);
+         pte_kind = image->planes[0].nil.pte_kind;
+         tile_mode = image->planes[0].nil.tile_mode;
       }
    }
 
@@ -209,8 +234,10 @@ nvk_AllocateMemory(VkDevice device,
        (type->propertyFlags & bar_type_flags) == bar_type_flags)
       pinned_to_vram = true;
 
-   const enum nvkmd_mem_flags flags =
+   enum nvkmd_mem_flags flags =
       nvk_memory_type_flags(type, handle_types, pinned_to_vram);
+   if (helios_export)
+      flags |= NVKMD_MEM_SHARED;
 
    const uint64_t aligned_size =
       align64(pAllocateInfo->allocationSize, alignment);
diff --git a/src/nouveau/vulkan/nvk_helios.c b/src/nouveau/vulkan/nvk_helios.c
new file mode 100644
index 0000000..d49d13b
--- /dev/null
+++ b/src/nouveau/vulkan/nvk_helios.c
@@ -0,0 +1,240 @@
+/*
+ * Copyright © 2026 Conduit contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * helios_icd_interface_v2: what Conduit's Helios D3D UMDs need from the
+ * Vulkan ICD they run DXVK / vkd3d-proton on, beyond Vulkan
+ * (helios_icd_interface.h; guest/windows/docs/dxvk-on-nvk.md, section 3.2).
+ *
+ * The UMD loads vulkan_nouveau.dll itself (no loader) and calls these with
+ * handles of the instance and device it created through
+ * vk_icdGetInstanceProcAddr.  Resource ids come from the Helios KMD's
+ * IMPORT_RM (nvkmd_rm_win.c); the layout reported with them is what DWM's
+ * Venus import and the scanout use, since the host cannot be asked.
+ */
+#include "nvk_device.h"
+#include "nvk_device_memory.h"
+#include "nvk_image.h"
+#include "nvk_physical_device.h"
+#include "nvkmd/rm/nvkmd_rm.h"
+
+#include "helios_icd_interface.h"
+#include "drm-uapi/drm_fourcc.h"
+
+#include <string.h>
+
+static uint32_t
+helios_fourcc(VkFormat format)
+{
+   switch (format) {
+   case VK_FORMAT_B8G8R8A8_UNORM:
+   case VK_FORMAT_B8G8R8A8_SRGB:
+      return DRM_FORMAT_ARGB8888;
+   case VK_FORMAT_R8G8B8A8_UNORM:
+   case VK_FORMAT_R8G8B8A8_SRGB:
+      return DRM_FORMAT_ABGR8888;
+   default:
+      return 0;
+   }
+}
+
+/* The layout of `image` at offset 0 of its dedicated memory, in the terms of
+ * HELIOS_ESCAPE_FOREIGN_RESOURCE (protocol/src/foreign.rs): plane 0, 32 bpp,
+ * pitch-linear or 2D block-linear with NVIDIA's GB20x DRM modifier.
+ */
+static VkResult
+helios_image_layout(const struct nvk_image *image,
+                    struct nvkmd_rm_foreign_layout *out,
+                    uint8_t *pte_kind, uint16_t *tile_mode)
+{
+   if (image->plane_count != 1 || image->vk.image_type != VK_IMAGE_TYPE_2D ||
+       image->vk.samples != VK_SAMPLE_COUNT_1_BIT ||
+       image->vk.array_layers != 1)
+      return VK_ERROR_FORMAT_NOT_SUPPORTED;
+
+   const uint32_t fourcc = helios_fourcc(image->vk.format);
+   if (fourcc == 0)
+      return VK_ERROR_FORMAT_NOT_SUPPORTED;
+
+   const struct nvk_image_plane *plane = &image->planes[0];
+   const struct nil_image_level *level = &plane->nil.levels[0];
+
+   uint64_t modifier;
+   if (level->tiling.gob_type == NIL_GOB_TYPE_LINEAR) {
+      modifier = DRM_FORMAT_MOD_LINEAR;
+   } else if (level->tiling.gob_type == NIL_GOB_TYPE_TURING_COLOR2_D &&
+              level->tiling.x_log2 == 0 && level->tiling.z_log2 == 0 &&
+              level->tiling.y_log2 <= 5) {
+      modifier = HELIOS_DRM_FORMAT_MOD_NVIDIA_BL_GB20X | level->tiling.y_log2;
+   } else {
+      return VK_ERROR_FORMAT_NOT_SUPPORTED;
+   }
+
+   const uint64_t offset = plane->plane_offset_B + level->offset_B;
+   if (offset > UINT32_MAX)
+      return VK_ERROR_FORMAT_NOT_SUPPORTED;
+
+   *out = (struct nvkmd_rm_foreign_layout) {
+      .width = image->vk.extent.width,
+      .height = image->vk.extent.height,
+      .stride = level->row_stride_B,
+      .offset = (uint32_t)offset,
+      .fourcc = fourcc,
+      .modifier = modifier,
+   };
+   *pte_kind = plane->nil.pte_kind;
+   *tile_mode = plane->nil.tile_mode;
+   return VK_SUCCESS;
+}
+
+static uint32_t
+helios_ctx_id(VkInstance instance)
+{
+   (void)instance;
+   return nvkmd_rm_win_holder_ctx();
+}
+
+static VkResult
+helios_memory_res_id(VkDevice _device, VkDeviceMemory _mem, VkImage _image,
+                     uint32_t *res_id, struct helios_icd_layout *layout)
+{
+   VK_FROM_HANDLE(nvk_device, dev, _device);
+   VK_FROM_HANDLE(nvk_device_memory, mem, _mem);
+   VK_FROM_HANDLE(nvk_image, image, _image);
+
+   *res_id = 0;
+   if (layout != NULL)
+      memset(layout, 0, sizeof(*layout));
+   if (mem == NULL || image == NULL)
+      return VK_ERROR_FORMAT_NOT_SUPPORTED;
+
+   struct nvkmd_rm_foreign_layout fl;
+   uint8_t pte_kind;
+   uint16_t tile_mode;
+   VkResult result = helios_image_layout(image, &fl, &pte_kind, &tile_mode);
+   if (result != VK_SUCCESS)
+      return result;
+
+   /* The image must own the whole memory object: the KMD names objects */
+   if (mem->dedicated_image != image)
+      return VK_ERROR_FORMAT_NOT_SUPPORTED;
+
+   /* A memory allocated without the Helios export request has no recorded
+    * layout and may be compressed; only uncompressed kinds export.
+    */
+   if (image->is_compressed)
+      return VK_ERROR_FORMAT_NOT_SUPPORTED;
+   nvkmd_rm_mem_set_export_layout(mem->mem, pte_kind, tile_mode);
+
+   result = nvkmd_rm_mem_helios_res_id(mem->mem, &dev->vk.base, &fl, res_id);
+   if (result != VK_SUCCESS)
+      return result;
+
+   if (layout != NULL) {
+      *layout = (struct helios_icd_layout) {
+         .size = mem->mem->size_B,
+         .modifier = fl.modifier,
+         .width = fl.width,
+         .height = fl.height,
+         .stride = fl.stride,
+         .offset = fl.offset,
+         .fourcc = fl.fourcc,
+         .memory_type_index = mem->vk.memory_type_index,
+      };
+   }
+   return VK_SUCCESS;
+}
+
+static VkBool32
+helios_memory_alloc_info(VkDeviceMemory _mem, uint64_t *alloc_size,
+                         uint32_t *memory_type_index)
+{
+   VK_FROM_HANDLE(nvk_device_memory, mem, _mem);
+
+   if (mem == NULL)
+      return VK_FALSE;
+   if (alloc_size != NULL)
+      *alloc_size = mem->mem->size_B;
+   if (memory_type_index != NULL)
+      *memory_type_index = mem->vk.memory_type_index;
+   return VK_TRUE;
+}
+
+static uint32_t
+helios_transfer_ownership(VkDeviceMemory _mem)
+{
+   VK_FROM_HANDLE(nvk_device_memory, mem, _mem);
+
+   return mem != NULL ? nvkmd_rm_mem_helios_res_adopt(mem->mem) : 0;
+}
+
+static VkResult
+helios_scanout_present(VkDevice _device, VkDeviceMemory _mem, VkImage _image)
+{
+   VK_FROM_HANDLE(nvk_device, dev, _device);
+   VK_FROM_HANDLE(nvk_device_memory, mem, _mem);
+   VK_FROM_HANDLE(nvk_image, image, _image);
+
+   if (mem == NULL || image == NULL || mem->dedicated_image != image ||
+       image->is_compressed)
+      return VK_ERROR_FORMAT_NOT_SUPPORTED;
+
+   struct nvkmd_rm_foreign_layout fl;
+   uint8_t pte_kind;
+   uint16_t tile_mode;
+   VkResult result = helios_image_layout(image, &fl, &pte_kind, &tile_mode);
+   if (result != VK_SUCCESS)
+      return result;
+   nvkmd_rm_mem_set_export_layout(mem->mem, pte_kind, tile_mode);
+
+   return nvkmd_rm_mem_scanout_flip(mem->mem, &dev->vk.base, fl.width,
+                                    fl.height, fl.stride, fl.offset,
+                                    fl.fourcc, fl.modifier);
+}
+
+static void
+helios_scanout_release(VkDevice _device)
+{
+   VK_FROM_HANDLE(nvk_device, dev, _device);
+
+   if (dev != NULL)
+      nvkmd_rm_dev_scanout_release(dev->nvkmd);
+}
+
+__declspec(dllexport) VkResult
+helios_icd_interface_v2(uint32_t version, struct helios_icd_api *out);
+
+__declspec(dllexport) VkResult
+helios_icd_interface_v2(uint32_t version, struct helios_icd_api *out)
+{
+   if (out == NULL || version < 2)
+      return VK_ERROR_INCOMPATIBLE_DRIVER;
+
+   const uint32_t cap = out->size != 0 && out->size < sizeof(*out) ?
+                        out->size : (uint32_t)sizeof(*out);
+
+   const struct nvkmd_rm_lib *lib = nvkmd_rm_lib_get();
+   uint32_t caps = HELIOS_ICD_CAP_LAYOUT;
+   if (lib != NULL && lib->win_open_device != NULL &&
+       lib->win_scanout_set != NULL) {
+      caps |= HELIOS_ICD_CAP_SCANOUT;
+      if (nvkmd_rm_win_rm_import_served())
+         caps |= HELIOS_ICD_CAP_RES_ID;
+   }
+
+   struct helios_icd_api api = {
+      .version = HELIOS_ICD_INTERFACE_VERSION,
+      .size = cap,
+      .backend = HELIOS_ICD_BACKEND_NVK_RM,
+      .caps = caps,
+      .ctx_id = helios_ctx_id,
+      .memory_res_id = helios_memory_res_id,
+      .memory_alloc_info = helios_memory_alloc_info,
+      .transfer_ownership = helios_transfer_ownership,
+      .scanout_present = helios_scanout_present,
