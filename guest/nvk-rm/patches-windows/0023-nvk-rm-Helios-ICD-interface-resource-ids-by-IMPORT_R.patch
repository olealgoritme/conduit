 src/nouveau/vulkan/nvkmd/rm/nvkmd_rm.h      |  44 ++++
 src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_lib.c  |   6 +
 src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_mem.c  |   3 +
 src/nouveau/vulkan/nvkmd/rm/nvkmd_rm_win.c  | 209 ++++++++++++++++-
