# VK_LAYER_CONDUIT_pass_profile: GPU time per render pass / operation run /
# command buffer on any Vulkan driver (the NVIDIA side of NVK_PASS_PROFILE).
#   make
#   VK_LAYER_PATH=$PWD VK_INSTANCE_LAYERS=VK_LAYER_CONDUIT_pass_profile \
#     CONDUIT_PASS_PROFILE_FILE=/some/dir/nv ./app
# Then: ./compare_pass_profiles.py --nvidia nv.<pid> --nvk nvk-pass-<pid>.txt
CC ?= cc
VULKAN_CORE ?= /usr/include/vulkan/vulkan_core.h
LAYER = libVkLayer_conduit_pass_profile.so

all: $(LAYER) VkLayer_conduit_pass_profile.json

# VkFormat names from the installed Vulkan headers, ascending by value
fmt_names.h: $(VULKAN_CORE)
	awk '/^[ \t]*VK_FORMAT_[A-Za-z0-9_]+ = [0-9]+,/ { n = $$1; sub(/^VK_FORMAT_/, "", n); print $$3 + 0, n }' $< | \
	  sort -n -u -k1,1 | \
	  awk 'BEGIN { print "/* generated by the Makefile from vulkan_core.h */"; print "static const struct { uint32_t v; const char *n; } fmt_names[] = {" } { printf "   { %s, \"%s\" },\n", $$1, $$2 } END { print "};" }' > $@

$(LAYER): vk_pass_layer.c fmt_names.h
	$(CC) -O2 -g -Wall -Wextra -Wno-unused-parameter -fPIC -shared -fvisibility=hidden \
	  -o $@ vk_pass_layer.c -lpthread

VkLayer_conduit_pass_profile.json: VkLayer_conduit_pass_profile.json.in
	sed 's|@LIBRARY@|$(CURDIR)/$(LAYER)|' $< > $@

clean:
	rm -f $(LAYER) fmt_names.h VkLayer_conduit_pass_profile.json
