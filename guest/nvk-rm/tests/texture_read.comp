#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2DArray tex;
layout(std430, set = 0, binding = 1) buffer Out { vec4 v[]; } o;
layout(push_constant) uniform PC { uint base; uint lod; uint w; uint h; uint layer; uint mode; } pc;
void main() {
   uvec2 g = gl_GlobalInvocationID.xy;   /* 32x32 sample grid */
   uint x = (g.x * pc.w) / 32u, y = (g.y * pc.h) / 32u;
   if (g.x >= min(32u, pc.w) || g.y >= min(32u, pc.h)) return;
   vec4 c;
   if (pc.mode == 0u)
      c = texelFetch(tex, ivec3(x, y, pc.layer), int(pc.lod));
   else
      c = textureLod(tex, vec3((vec2(x, y) + 0.5) / vec2(pc.w, pc.h), float(pc.layer)), float(pc.lod));
   o.v[pc.base + g.y * 32u + g.x] = c;
}
