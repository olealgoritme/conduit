#version 460
// Atomics on a uniform address (one per subgroup), on per-lane addresses,
// and through shared memory.
#extension GL_KHR_shader_subgroup_arithmetic : require
layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) buffer Counters { uint total; uint hist[256]; float fsum; };
layout(set = 0, binding = 1, std430) readonly buffer In { uint v[]; };
shared uint local_hist[64];
void main() {
  uint i = gl_GlobalInvocationID.x;
  uint l = gl_LocalInvocationIndex;
  if (l < 64u)
    local_hist[l] = 0u;
  barrier();
  uint x = v[i];
  atomicAdd(total, 1u);
  atomicAdd(local_hist[x & 63u], 1u);
  atomicMax(hist[x & 255u], x >> 8);
  uint sg = subgroupAdd(x & 0xffu);
  if (subgroupElect())
    atomicAdd(hist[0], sg);
  barrier();
  if (l < 64u)
    atomicAdd(hist[l], local_hist[l]);
}
