#version 460
// Loops with a known trip count (unrolled), with and without continue, and
// one with a data-dependent exit.
layout(local_size_x = 128) in;
layout(set = 0, binding = 0, std430) readonly buffer In { float x[]; };
layout(set = 0, binding = 1, std430) buffer Out { float y[]; };
layout(push_constant) uniform PC { uint n; uint stride; };
void main() {
  uint i = gl_GlobalInvocationID.x;
  float s = 0.0;
  for (int k = 0; k < 16; k++)
    s += x[i + uint(k) * stride] * float(k + 1);
  for (uint k = 0u; k < n; k++) {
    float v = x[(i + k) % 4096u];
    if (v < 0.0)
      continue;
    s += sqrt(v);
  }
  uint j = i;
  while (s < 1000.0 && j < n * 64u) {
    s = s * 1.5 + x[j];
    j += 32u;
  }
  y[i] = s;
}
